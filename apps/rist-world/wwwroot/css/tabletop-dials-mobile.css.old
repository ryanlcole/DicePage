/* RIST tabletop rails: physical horizontal dial behavior without distorting items. */
.circular-rail{display:flex!important;flex-flow:row nowrap!important;align-items:stretch!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch;overscroll-behavior-inline:none;scrollbar-width:none;scroll-snap-type:none!important;padding-inline:0!important;gap:0!important;width:100%!important;max-width:100vw!important}
.circular-rail::-webkit-scrollbar{display:none}
.circular-set{display:flex!important;flex-flow:row nowrap!important;align-items:center!important;gap:8px!important;flex:0 0 max-content!important;width:max-content!important;min-width:max-content!important;max-width:none!important;padding:8px!important;white-space:nowrap!important}
.header-circular-set,.dice-footer .circular-set,.hand-rail .circular-set{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;width:max-content!important;min-width:max-content!important}
.header-circular-set{align-items:end!important}
.dice-footer .circular-set{align-items:stretch!important}
.hand-rail .circular-set{align-items:stretch!important;padding:6px!important;gap:8px!important}
.circular-set>*{flex:0 0 auto!important;scroll-snap-align:none!important;min-width:0}
.circular-set>.control{display:grid!important;grid-auto-flow:row!important;width:auto!important;min-width:max-content!important}
.circular-set>.control select,.circular-set>.control input{width:auto!important;min-width:max-content!important;max-width:none!important}
.circular-rail.is-circular-ready{scroll-behavior:auto}
.hand-circular-set{min-width:max-content!important}

/* Keep each rail physically thin: content travels sideways, never downward. */
.topbar,.footer,.hand-rail{min-height:0!important;height:auto!important}
.footer .die-button,.footer .character-footer-button,.footer .die-control,.footer .sum,.footer .clear-dice,.footer .card{flex:0 0 auto!important}
.dice-footer .die-button,.dice-footer .character-footer-button,.dice-footer .die-control,.dice-footer .sum,.dice-footer .clear-dice,.dice-footer .card,.hand-rail .hand-card{scroll-snap-stop:always}

/* Character window: landscape keeps the mixing-board layout; portrait becomes a wrapped sheet. */
@media (orientation:portrait) and (max-width:800px){
 .mixer-modal{padding:5px;place-items:start center}
 .character-mixer{width:calc(100vw - 10px);max-height:calc(100dvh - 10px);padding:8px;border-radius:14px;overflow-x:hidden}
 .console-identity{grid-template-columns:82px 1fr 1fr!important;min-width:0!important}
 .console-identity .character-portrait{grid-row:span 2;min-height:86px}
 .console-identity label{min-width:0}.console-identity input{width:100%;min-width:0}
 .pool-strip,.skill-strip{max-width:100%;overflow-x:auto}
 .notebook-tabs{display:flex;flex-wrap:wrap;overflow:visible;gap:5px}
 .notebook-tabs button{flex:1 1 30%;min-width:max-content}
 .console-builder{max-width:none;width:100%;margin-bottom:10px}
 .console-builder input{width:100%}
 .topbar .circular-set,.footer .circular-set,.hand-rail .circular-set{flex-direction:row!important;flex-wrap:nowrap!important;width:max-content!important;min-width:max-content!important}

 /* Keyboard/focus mode: keep the console alive and devote visible viewport to search. */
 .character-console:has(.console-builder input:focus) .console-identity,
 .character-console:has(.console-builder input:focus) .console-bank,
 .character-console:has(.console-builder input:focus) .console-notebook{display:none}
 .character-console:has(.console-builder input:focus){padding-top:42px;min-height:calc(100dvh - 10px)}
 .character-console:has(.console-builder input:focus) .console-builder{position:sticky;top:0;z-index:40;background:#0b0e0ff8;padding:8px;margin:0;width:100%}
 .character-console:has(.console-builder input:focus) .field-suggestions{position:static!important;margin-top:5px;max-height:38dvh;overflow:auto;border-radius:7px}
}

@media (orientation:portrait) and (max-width:440px){
 .console-identity{grid-template-columns:72px 1fr!important}
 .console-identity .character-portrait{grid-row:span 4}
 .notebook-tabs button{font-size:11px}
}
