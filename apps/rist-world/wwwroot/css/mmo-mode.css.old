.header-mmo-button{background:#050708!important;color:#d7d7d7!important;border-color:#3b4145!important;font:800 8px/1 system-ui!important;letter-spacing:.04em!important}
.header-mmo-button.active{background:#0b5d2a!important;color:#dfffe9!important;border-color:#35b96a!important;box-shadow:inset 0 0 12px #123,0 0 7px #24a85e66!important}
.rist-mmo-shaelvien:not(.rist-mmo-owned-zone) .tile-browser,.rist-mmo-shaelvien:not(.rist-mmo-owned-zone) .pallet .tray-item,.rist-mmo-shaelvien:not(.rist-mmo-owned-zone) .zone-editor{filter:grayscale(.75) brightness(.55);pointer-events:none!important}
.rist-mmo-shaelvien:not(.rist-mmo-owned-zone) .tile-cell,.rist-mmo-shaelvien:not(.rist-mmo-owned-zone) .piece:not(.pin){pointer-events:none!important}
.mmo-build-overlay{position:fixed;z-index:2147482600;inset:0;display:grid;place-items:center;padding:12px;background:#02070bbc;backdrop-filter:blur(3px)}
.mmo-build-overlay[hidden]{display:none!important}
.mmo-build-panel{box-sizing:border-box;width:min(520px,94vw);padding:18px;border:1px solid #88703c;border-radius:14px;background:#071118ee;color:#eee6d3;box-shadow:0 18px 70px #000c;text-align:center}
.mmo-build-panel h2{margin:0 0 16px;color:#dfc77f;font:800 18px/1.1 system-ui}
.mmo-build-panel p{font:500 12px/1.45 system-ui;color:#d7d0c0}
.mmo-choice-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.mmo-choice-row button,.mmo-build-panel>button{min-height:44px;border:1px solid #715d31;border-radius:8px;background:#151e26;color:#f0e5c7;font-weight:800}
.mmo-close{width:100%;margin-top:12px;color:#f0caca!important;border-color:#815050!important}
@media(max-width:520px){.mmo-choice-row{grid-template-columns:1fr}}
