.login-door-first{order:-100}.door-button.login-pulse{animation:rist-login-pulse 2.6s ease-in-out infinite;will-change:box-shadow,filter;box-shadow:0 0 0 1px rgba(88,101,242,.45),0 0 10px rgba(88,101,242,.55),0 0 22px rgba(88,101,242,.28)!important;filter:drop-shadow(0 0 4px rgba(88,101,242,.55))}@keyframes rist-login-pulse{0%,100%{box-shadow:0 0 0 1px rgba(88,101,242,.35),0 0 7px rgba(88,101,242,.45),0 0 15px rgba(88,101,242,.2);filter:drop-shadow(0 0 3px rgba(88,101,242,.4))}50%{box-shadow:0 0 0 2px rgba(123,137,255,.9),0 0 15px rgba(88,101,242,.95),0 0 34px rgba(88,101,242,.58);filter:drop-shadow(0 0 8px rgba(123,137,255,.92))}}@media(prefers-reduced-motion:reduce){.door-button.login-pulse{animation:none;box-shadow:0 0 0 1px rgba(88,101,242,.65),0 0 12px rgba(88,101,242,.7),0 0 24px rgba(88,101,242,.35)!important;filter:drop-shadow(0 0 5px rgba(88,101,242,.65))}}.discord-login-overlay{position:fixed;inset:0;z-index:2147482500;display:grid;place-items:center;padding:20px;background:rgba(3,8,12,.76);backdrop-filter:blur(5px)}.discord-login-card{position:relative;width:min(92vw,430px);padding:30px 24px 24px;border:1px solid #a8873e;border-radius:24px;background:#101820;color:#f4e8c7;text-align:center;box-shadow:0 24px 70px rgba(0,0,0,.58)}.discord-login-close{position:absolute;right:14px;top:12px;width:42px;height:42px;border:1px solid #8b723a;border-radius:50%;background:#17222b;color:#ead59b;font-size:29px;line-height:1}.discord-brand-mark{width:82px;height:82px;margin:4px auto 16px;display:grid;place-items:center;border-radius:24px;background:#5865f2;box-shadow:0 0 0 1px rgba(255,255,255,.12),0 10px 28px rgba(88,101,242,.28)}.discord-brand-mark svg{width:56px;height:46px;fill:#fff}.discord-login-card h2{margin:0 0 12px;font-size:clamp(22px,6vw,30px);color:#fff}.discord-login-card p{margin:0 auto 22px;max-width:340px;line-height:1.45;color:#d4d8df}.discord-login-primary,.discord-login-cancel{width:100%;min-height:52px;border-radius:14px;font:700 16px/1 system-ui,-apple-system,sans-serif}.discord-login-primary{border:0;background:#5865f2;color:#fff}.discord-login-cancel{margin-top:10px;border:1px solid #806c40;background:#17222b;color:#e8d8ae}.discord-login-primary:active,.discord-login-cancel:active{transform:translateY(1px)}