/* Cursor roles. The image data is sliced from the supplied cursor sheet at runtime. */
@media (hover:hover) and (pointer:fine){
 html.shaelvien-cursors-ready,html.shaelvien-cursors-ready body{cursor:var(--rist-cursor-sword,auto)}
 html.shaelvien-cursors-ready a,
 html.shaelvien-cursors-ready button,
 html.shaelvien-cursors-ready [role="button"],
 html.shaelvien-cursors-ready label,
 html.shaelvien-cursors-ready select{cursor:var(--rist-cursor-pointer,pointer)}
 html.shaelvien-cursors-ready input[type="text"],
 html.shaelvien-cursors-ready input[type="search"],
 html.shaelvien-cursors-ready input[type="email"],
 html.shaelvien-cursors-ready input[type="url"],
 html.shaelvien-cursors-ready input[type="number"],
 html.shaelvien-cursors-ready textarea,
 html.shaelvien-cursors-ready [contenteditable="true"]{cursor:var(--rist-cursor-text,text)}
 html.shaelvien-cursors-ready input[type="range"]{cursor:var(--rist-cursor-select,pointer)}
 html.shaelvien-cursors-ready input[type="color"],
 html.shaelvien-cursors-ready [data-tool="color"],
 html.shaelvien-cursors-ready [aria-label*="color" i]{cursor:var(--rist-cursor-colorPicker,pointer)}
 html.shaelvien-cursors-ready [draggable="true"],
 html.shaelvien-cursors-ready .draggable,
 html.shaelvien-cursors-ready .tile-item,
 html.shaelvien-cursors-ready .token-item,
 html.shaelvien-cursors-ready .library-playing-card{cursor:var(--rist-cursor-grab,grab)}
 html.shaelvien-cursors-ready [draggable="true"]:active,
 html.shaelvien-cursors-ready .draggable:active,
 html.shaelvien-cursors-ready .tile-item:active,
 html.shaelvien-cursors-ready .token-item:active,
 html.shaelvien-cursors-ready .library-playing-card:active{cursor:var(--rist-cursor-grabPinch,grabbing)}
 html.shaelvien-cursors-ready .map,
 html.shaelvien-cursors-ready .world-map,
 html.shaelvien-cursors-ready .map-surface,
 html.shaelvien-cursors-ready .board,
 html.shaelvien-cursors-ready [data-pan-surface]{cursor:var(--rist-cursor-moveRing,move)}
 html.shaelvien-cursors-ready .map:active,
 html.shaelvien-cursors-ready .world-map:active,
 html.shaelvien-cursors-ready .map-surface:active,
 html.shaelvien-cursors-ready .board:active,
 html.shaelvien-cursors-ready [data-pan-surface]:active{cursor:var(--rist-cursor-grabPinch,grabbing)}
 html.shaelvien-cursors-ready [data-tool="select"],html.shaelvien-cursors-ready [aria-label*="select" i]{cursor:var(--rist-cursor-select,pointer)}
 html.shaelvien-cursors-ready [data-tool="pen"],html.shaelvien-cursors-ready [aria-label*="pen" i]{cursor:var(--rist-cursor-pen,pointer)}
 html.shaelvien-cursors-ready [data-tool="brush"],html.shaelvien-cursors-ready [aria-label*="brush" i]{cursor:var(--rist-cursor-text,pointer)}
 html.shaelvien-cursors-ready [data-tool="paint"],html.shaelvien-cursors-ready [data-tool="spray"],html.shaelvien-cursors-ready [aria-label*="paint" i]{cursor:var(--rist-cursor-paint,pointer)}
 html.shaelvien-cursors-ready [data-tool="fill"],html.shaelvien-cursors-ready [aria-label*="fill" i]{cursor:var(--rist-cursor-fill,pointer)}
 html.shaelvien-cursors-ready [data-tool="erase"],html.shaelvien-cursors-ready [aria-label*="erase" i]{cursor:var(--rist-cursor-erase,pointer)}
 html.shaelvien-cursors-ready [aria-label*="zoom in" i]{cursor:var(--rist-cursor-zoomIn,zoom-in)}
 html.shaelvien-cursors-ready [aria-label*="zoom out" i]{cursor:var(--rist-cursor-zoomOut,zoom-out)}
 html.shaelvien-cursors-ready [aria-label*="rotate" i]{cursor:var(--rist-cursor-rotate,pointer)}
 html.shaelvien-cursors-ready [aria-label*="link" i]{cursor:var(--rist-cursor-link,pointer)}
 html.shaelvien-cursors-ready [aria-label*="card" i]{cursor:var(--rist-cursor-cards,pointer)}
 html.shaelvien-cursors-ready [aria-label*="help" i],html.shaelvien-cursors-ready .help{cursor:var(--rist-cursor-help,help)}
 html.shaelvien-cursors-ready [aria-busy="true"],html.shaelvien-cursors-ready .loading{cursor:var(--rist-cursor-wait,wait)!important}
 html.shaelvien-cursors-ready [disabled],html.shaelvien-cursors-ready [aria-disabled="true"],html.shaelvien-cursors-ready .disabled{cursor:var(--rist-cursor-forbidden,not-allowed)!important}
}
@media (hover:none),(pointer:coarse){html,body,*{cursor:auto!important}}