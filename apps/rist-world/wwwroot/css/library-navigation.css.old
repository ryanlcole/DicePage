/* RIST libraries behave like decks spread across a tabletop. */
.library-deck-toolbar{display:flex;align-items:center;gap:.45rem;padding:.35rem .45rem;border-top:1px solid rgba(216,195,138,.18);border-bottom:1px solid rgba(216,195,138,.18);background:rgba(4,12,17,.84);overflow-x:auto;scrollbar-width:thin}
.library-deck-toolbar label{display:flex;align-items:center;gap:.3rem;color:#b8b08d;font:700 .62rem/1 system-ui,-apple-system,sans-serif;white-space:nowrap}
.library-deck-toolbar select,.library-deck-toolbar input{min-height:30px;border:1px solid rgba(216,195,138,.3);border-radius:6px;background:#0d181d;color:#ead9aa;padding:.25rem .42rem}
.library-deck-toolbar button{min-height:30px;border:1px solid rgba(216,195,138,.34);border-radius:6px;background:#172429;color:#ead9aa;padding:.3rem .58rem}
.library-deck-rail{display:flex;align-items:stretch;gap:.55rem;padding:.55rem;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x proximity;scrollbar-width:thin;min-height:120px;background:linear-gradient(180deg,rgba(4,11,15,.7),rgba(8,17,22,.92))}
.library-deck-rail>*{flex:0 0 auto;scroll-snap-align:start}
.library-deck-folder{appearance:none;position:relative;width:82px;min-height:112px;border:0;background:transparent;padding:0;color:#ead9aa;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:.28rem;text-align:center;cursor:pointer}
.library-deck-folder .deck-stack{position:relative;width:62px;height:86px;display:block;filter:drop-shadow(0 4px 4px rgba(0,0,0,.48))}
.library-deck-folder .deck-stack::before,.library-deck-folder .deck-stack::after{content:"";position:absolute;inset:0;border-radius:7px;border:1px solid rgba(216,195,138,.42);background:#111d21}
.library-deck-folder .deck-stack::before{transform:translate(5px,-3px);opacity:.72}
.library-deck-folder .deck-stack::after{transform:translate(2px,-1px);opacity:.88}
.library-deck-folder .hand-toggle-card-back{position:absolute;inset:0;z-index:2;width:62px;height:86px;border-radius:7px;background-size:cover;background-position:center;box-shadow:inset 0 0 0 1px rgba(216,195,138,.42)}
.library-deck-folder strong{max-width:82px;font:700 .65rem/1.05 Georgia,'Times New Roman',serif;overflow-wrap:anywhere;text-shadow:0 1px 2px #000}
.library-deck-folder small{color:#819295;font:600 .52rem/1 system-ui,-apple-system,sans-serif;text-transform:uppercase;letter-spacing:.07em}
.library-deck-folder.active .deck-stack{filter:drop-shadow(0 0 7px rgba(216,195,138,.28)) drop-shadow(0 4px 4px rgba(0,0,0,.48))}
.library-deck-folder.active strong{color:#fff0c3}
.library-deck-divider{width:1px;min-height:96px;background:linear-gradient(transparent,rgba(216,195,138,.32),transparent);margin:0 .05rem}
.library-deck-rail .library-playing-card{margin:0}
.library-deck-rail .library-tile{width:98px;min-width:98px}
.library-deck-page{appearance:none;width:72px;min-height:108px;border:1px dashed rgba(216,195,138,.42);border-radius:8px;background:rgba(20,30,34,.76);color:#ead9aa;font:700 .68rem/1.1 Georgia,'Times New Roman',serif}
.library-deck-empty{align-self:center;color:#8fa0a2;font:600 .7rem/1.3 system-ui,-apple-system,sans-serif;padding:1rem}
.unified-card-library .card-path-bar{display:none!important}
.unified-card-library .card-library-results{display:block!important;overflow:visible!important;padding:0!important}
.unified-card-library .card-library-workspace{display:block!important}
.unified-card-library .character-spellbook-drop{margin:.45rem .55rem .55rem}
.tile-browser.library-deck-browser .tile-browser-path{display:none!important}
.tile-browser.library-deck-browser .tile-browser-slider{display:block!important;min-height:118px}
.tile-browser.library-deck-browser .tile-browser-grid{display:block!important;padding:0!important}
@media(max-width:800px){.library-deck-toolbar{padding-left:max(.35rem,env(safe-area-inset-left));padding-right:max(.35rem,env(safe-area-inset-right))}.library-deck-rail{gap:.42rem;padding:.45rem;min-height:112px}.library-deck-folder{width:74px;min-height:104px}.library-deck-folder .deck-stack,.library-deck-folder .hand-toggle-card-back{width:56px;height:78px}.library-deck-folder strong{max-width:74px;font-size:.61rem}.library-deck-rail .library-tile{width:90px;min-width:90px}}
