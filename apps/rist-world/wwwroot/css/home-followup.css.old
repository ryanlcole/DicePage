/* Follow-up tabletop geometry: keep header, hand and dice rails equal height while preserving chat beneath dice. */
@media(orientation:portrait){
  .rist{
    grid-template-rows:54px 52px minmax(0,1fr) 54px 116px!important;
    grid-template-areas:"header" "cards" "map" "hand" "footer"!important;
  }
  .home-footer-stack{grid-template-rows:54px 58px!important;height:116px!important;min-height:116px!important;max-height:116px!important}
  .home-footer-stack #footer-slider{height:54px!important;min-height:54px!important;max-height:54px!important}
  .topbar,.header-circular-set,.dice-footer>.circular-set{height:54px!important;min-height:54px!important;max-height:54px!important}
}
@media(orientation:landscape){
  .rist{
    grid-template-rows:48px minmax(0,1fr) 48px 106px!important;
    grid-template-areas:"header" "map" "hand" "footer"!important;
  }
  .home-footer-stack{grid-template-rows:48px 54px!important;height:106px!important;min-height:106px!important;max-height:106px!important}
  .home-footer-stack #footer-slider{height:48px!important;min-height:48px!important;max-height:48px!important}
  .topbar,.header-circular-set,.dice-footer>.circular-set{height:48px!important;min-height:48px!important;max-height:48px!important}
}

/* Chat composer is always visible directly below dice. Only transcript expands upward. */
.home-inline-chat{display:grid!important;visibility:visible!important;opacity:1!important;overflow:visible!important}
.home-chat-text-region,.home-chat-compose,.home-chat-compose textarea{min-width:0!important}
.home-chat-transcript{z-index:120!important}
@media(orientation:portrait){.home-inline-chat.expanded .home-chat-transcript{max-height:calc(100dvh - 54px - 52px - 54px - 116px - 18px)!important}}
@media(orientation:landscape){.home-inline-chat.expanded .home-chat-transcript{max-height:calc(100dvh - 48px - 48px - 106px - 18px)!important}}
