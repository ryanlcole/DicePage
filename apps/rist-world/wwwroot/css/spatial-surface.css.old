/*
 * Recursive map surfaces are asset-backed. An unpopulated spatial address must
 * stay neutral until a real terrain asset is placed or loaded for that address.
 * This intentionally overrides the legacy procedural .ocean-world paint.
 */
.world-stage > .ocean-world {
    background: #0b0f13 !important;
    background-image: none !important;
    box-shadow: none !important;
}
