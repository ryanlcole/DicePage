/* Profile page is composed from reusable Shaelvien tiles instead of one flat reference image.
   The control atlas is 1536x921; each sprite crop is scaled to its owning code box. */
.profile-reference-art{
  background-image:url('../assets/cards/fronts/card_front_06_minimal.png')!important;
  background-size:100% 100%!important;
  background-position:center!important;
  background-repeat:no-repeat!important;
}
.profile-reference-art::after{opacity:.05!important}

/* Sprite crop helper: x/y/w/h describe the source rectangle in controls-atlas.jpeg. */
.profile-reference-art .reference-portrait,
.profile-reference-art .profile-name,
.profile-reference-art .profile-concept,
.profile-reference-art .profile-description,
.profile-reference-art .reference-tracker,
.profile-reference-art .reference-bottom-nav button{
  background-image:url('../assets/ui/character-sheet/controls-atlas.jpeg')!important;
  background-repeat:no-repeat!important;
}

/* Portrait: large circular frame x=78 y=206 w=221 h=215. */
.profile-reference-art .reference-portrait{
  left:25.2%!important;top:2.45%!important;width:49.6%!important;height:auto!important;aspect-ratio:221/215!important;
  background-size:695.02% 428.37%!important;
  background-position:5.93% 29.18%!important;
  border-radius:0!important;overflow:visible!important;
}
.profile-reference-art .reference-portrait img{
  position:absolute!important;left:14%!important;top:11%!important;width:72%!important;height:74%!important;
  object-fit:cover!important;border-radius:50%!important;z-index:1!important;
}
.profile-reference-art .reference-portrait .portrait-pencil{
  right:10%!important;bottom:8%!important;width:12%!important;z-index:3!important;
}

/* Name: long ornate plate x=19 y=31 w=450 h=158. */
.profile-reference-art .profile-name{
  left:18.2%!important;top:26.0%!important;width:63.6%!important;height:auto!important;aspect-ratio:450/158!important;
  background-size:341.33% 582.91%!important;
  background-position:1.75% 4.06%!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
  padding:1% 8%!important;font-size:clamp(13px,3.45vw,24px)!important;
}

/* Concept: medium plate x=492 y=48 w=268 h=138. */
.profile-reference-art .profile-concept{
  left:31.0%!important;top:34.15%!important;width:38.0%!important;height:auto!important;aspect-ratio:268/138!important;
  background-size:573.13% 667.39%!important;
  background-position:38.80% 6.13%!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
  white-space:nowrap!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none!important;
  padding:0 8%!important;line-height:1!important;
}
.profile-reference-art .profile-concept::-webkit-scrollbar{display:none!important}

/* Values are real code cards. The six provided Shaelvien card fronts are used as the actual card skins. */
.profile-reference-art .profile-value-tiles{
  left:4.2%!important;top:43.0%!important;width:91.6%!important;height:30.6%!important;
  display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;grid-template-rows:repeat(2,minmax(0,1fr))!important;
  gap:2.0% 2.3%!important;
}
.profile-reference-art .reference-value-tile{
  position:relative!important;display:grid!important;grid-template-rows:23% 1fr 23%!important;place-items:center!important;
  min-width:0!important;min-height:0!important;overflow:hidden!important;
  background-size:100% 100%!important;background-repeat:no-repeat!important;background-position:center!important;
  padding:9% 8% 10%!important;box-sizing:border-box!important;
  border:0!important;
}
.profile-reference-art .reference-value-tile:nth-child(1){background-image:url('../assets/cards/fronts/card_front_01_three_roses.png')!important}
.profile-reference-art .reference-value-tile:nth-child(2){background-image:url('../assets/cards/fronts/card_front_02_two_roses.png')!important}
.profile-reference-art .reference-value-tile:nth-child(3){background-image:url('../assets/cards/fronts/card_front_03_four_roses.png')!important}
.profile-reference-art .reference-value-tile:nth-child(4){background-image:url('../assets/cards/fronts/card_front_04_single_rose.png')!important}
.profile-reference-art .reference-value-tile:nth-child(5){background-image:url('../assets/cards/fronts/card_front_05_two_low_roses.png')!important}
.profile-reference-art .reference-value-tile:nth-child(6){background-image:url('../assets/cards/fronts/card_front_06_minimal.png')!important}
.profile-reference-art .reference-value-tile .tile-label{
  position:static!important;width:100%!important;height:100%!important;min-width:0!important;
  display:block!important;align-self:center!important;text-align:center!important;
  white-space:nowrap!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none!important;
  font:700 clamp(8px,2.15vw,15px)/1 Georgia,serif!important;padding:0 4%!important;
}
.profile-reference-art .reference-value-tile .tile-label::-webkit-scrollbar{display:none!important}
.profile-reference-art .reference-value-tile .tile-number{
  position:static!important;align-self:center!important;width:64%!important;height:64%!important;aspect-ratio:auto!important;
  display:flex!important;align-items:center!important;justify-content:center!important;text-align:center!important;
  font:800 clamp(18px,5.3vw,34px)/1 Georgia,serif!important;
}
.profile-reference-art .reference-value-tile .tile-circle-row{
  position:static!important;width:100%!important;height:100%!important;display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:8%!important;align-items:center!important;justify-items:center!important;
}
.profile-reference-art .reference-value-tile .tile-circle-text{
  position:static!important;width:100%!important;height:100%!important;min-width:0!important;
  border:0!important;background:transparent!important;box-shadow:none!important;text-align:center!important;
  font:700 clamp(7px,1.9vw,12px)/1 Georgia,serif!important;padding:0!important;color:var(--character-font)!important;
}

/* Description: wide rectangular tile x=778 y=34 w=289 h=167. */
.profile-reference-art .profile-description{
  left:23.5%!important;top:74.2%!important;width:53%!important;height:auto!important;aspect-ratio:289/167!important;
  background-size:531.49% 551.50%!important;
  background-position:62.39% 4.51%!important;
  padding:7% 8%!important;box-sizing:border-box!important;
  overflow:auto!important;scrollbar-width:none!important;
  font-size:clamp(8px,2.1vw,14px)!important;
}
.profile-reference-art .profile-description::-webkit-scrollbar{display:none!important}

/* Tracker bars: x=358 y=624 w=318 h=84. */
.profile-reference-art .profile-trackers{
  left:7.1%!important;top:84.25%!important;width:85.8%!important;height:7.5%!important;
  display:grid!important;grid-template-rows:1fr 1fr!important;gap:8%!important;
}
.profile-reference-art .reference-tracker{
  background-size:483.02% 1096.43%!important;
  background-position:29.39% 74.57%!important;
  grid-template-columns:15% 1fr 15%!important;gap:1%!important;
  padding:0 1%!important;box-sizing:border-box!important;
}
.profile-reference-art .reference-tracker .tracker-center{
  height:100%!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;align-items:center!important;gap:4%!important;padding:0 3%!important;
}
.profile-reference-art .reference-tracker .tracker-name{
  white-space:nowrap!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none!important;
}
.profile-reference-art .reference-tracker .tracker-name::-webkit-scrollbar{display:none!important}

/* Bottom navigation: five atlas buttons x=117/395/682/954/1221, y~=744, w~=152, h~=146. */
.profile-reference-art .reference-bottom-nav{
  left:7.5%!important;bottom:1.1%!important;width:85%!important;height:7.4%!important;
  display:grid!important;grid-template-columns:repeat(5,1fr)!important;gap:2.7%!important;
}
.profile-reference-art .reference-bottom-nav button{position:relative!important;width:100%!important;height:100%!important;border-radius:0!important;background-color:transparent!important}
.profile-reference-art .reference-bottom-nav button:nth-child(1){background-size:1010.53% 630.82%!important;background-position:8.45% 96.00%!important}
.profile-reference-art .reference-bottom-nav button:nth-child(2){background-size:1010.53% 626.53%!important;background-position:28.53% 95.86%!important}
.profile-reference-art .reference-bottom-nav button:nth-child(3){background-size:1010.53% 626.53%!important;background-position:49.28% 95.86%!important}
.profile-reference-art .reference-bottom-nav button:nth-child(4){background-size:1017.22% 635.17%!important;background-position:68.86% 95.97%!important}
.profile-reference-art .reference-bottom-nav button:nth-child(5){background-size:1017.22% 635.17%!important;background-position:88.15% 95.97%!important}
.profile-reference-art .reference-bottom-nav button.active::after{
  inset:18%!important;border:2px solid #6fbfff!important;border-radius:50%!important;background:transparent!important;box-shadow:none!important;
}

/* Keep close/appearance controls above composed tiles. */
.profile-reference-art .reference-sheet-controls{z-index:20!important}

@media(max-width:560px){
  .profile-reference-art .profile-name{top:26.2%!important}
  .profile-reference-art .profile-concept{top:34.5%!important}
  .profile-reference-art .profile-value-tiles{top:43.2%!important;height:30.3%!important}
  .profile-reference-art .profile-description{top:74.4%!important}
}
