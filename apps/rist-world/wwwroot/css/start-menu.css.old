/* Shaelvien start/settings overlay. Transparent shade preserves tabletop context while pausing animated play. */
body.rist-start-open{overflow:hidden}
body.rist-start-open .rist .piece,body.rist-start-open .rist .tile-cell,body.rist-start-open .rist .world-stage *{animation-play-state:paused!important}
.rist-start-overlay{position:fixed;z-index:2147482500;inset:0;display:grid;place-items:center;padding:max(12px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left));background:#02070bb8;backdrop-filter:blur(3px) brightness(.55)}
.rist-start-overlay[hidden]{display:none!important}.rist-start-panel{box-sizing:border-box;width:min(720px,96vw);max-height:92dvh;overflow:auto;padding:14px;border:1px solid #9b7d3d;border-radius:14px;background:#071118dc;box-shadow:0 20px 70px #000b;color:#eee6d3}
.rist-start-title{margin:0 0 12px;color:#e2c77f;text-align:center;font:800 18px/1.1 system-ui;letter-spacing:.12em}.rist-start-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.rist-start-button,.rist-start-back,.rist-start-exit{min-height:48px;border:1px solid #725d30;border-radius:9px;background:#151e26;color:#f0e4c5;font:700 13px/1.1 system-ui}.rist-start-button:active,.rist-start-back:active,.rist-start-exit:active{transform:translateY(1px)}.rist-start-exit{width:100%;margin-top:12px;color:#f0c9c9;border-color:#8d4949}.rist-start-sub{display:grid;gap:10px}.rist-start-sub h2{margin:0;color:#d9bd78;font-size:16px}.rist-setting-row{display:grid;grid-template-columns:minmax(90px,.7fr) minmax(0,1fr);align-items:center;gap:8px;padding:7px;border:1px solid #5f512f;border-radius:8px;background:#0d171dcc}.rist-setting-row input[type=range],.rist-setting-row select{width:100%;min-width:0}.rist-setting-row button{min-height:36px}.rist-account-profile{display:grid;grid-template-columns:72px 1fr;gap:10px;align-items:center}.rist-account-avatar{width:68px;height:68px;border-radius:50%;border:1px solid #8c743d;background:#111c24;object-fit:cover}.rist-start-note{font-size:11px;color:#b9b09b}.rist-start-settings-button{position:fixed;z-index:2147482000;right:calc(7px + env(safe-area-inset-right));top:calc(7px + env(safe-area-inset-top));width:36px;height:36px;border:1px solid #8d743b;border-radius:50%;background:#0a151dcc;color:#e5ce8e;font-size:20px;line-height:1;box-shadow:0 2px 8px #0008}
@media(max-width:520px){.rist-start-panel{width:96vw;padding:10px}.rist-start-grid{grid-template-columns:1fr}.rist-start-button{min-height:42px}.rist-setting-row{grid-template-columns:90px 1fr}.rist-start-settings-button{width:32px;height:32px;font-size:18px}}
