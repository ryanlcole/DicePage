/* Home screen v2: no pallet, map takes the reclaimed row, chat lives below dice. */
#pallet-slider{display:none!important}
.table-workspace{grid-template-rows:minmax(0,1fr)!important;gap:0!important}
.table-workspace:has(#initiative-slider){grid-template-rows:52px minmax(0,1fr)!important;gap:5px!important}
.map-shell{padding-top:0!important;margin-top:0!important}
.home-footer-stack{grid-area:footer;position:relative;z-index:40;min-width:0;display:grid;grid-template-rows:64px 58px;gap:4px;background:#071017}
.home-footer-stack #footer-slider{grid-area:auto!important;margin:0!important;height:64px!important;min-height:64px!important;max-height:64px!important;padding-top:4px!important;padding-bottom:4px!important}
.home-inline-chat{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;align-items:stretch;min-width:0;height:58px;padding:5px 7px;border-top:1px solid #745b2b;border-bottom:1px solid #745b2b;background:#0d141a;color:#eee5d2;box-sizing:border-box}
.home-chat-text-region{position:relative;min-width:0;height:100%}.home-chat-compose{height:100%;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:7px}.home-chat-compose>span{max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#d9bd78;font:700 10px/1 system-ui}.home-chat-compose textarea{box-sizing:border-box;width:100%;height:46px;min-height:46px;max-height:46px;resize:none;border:1px solid #745b2b;border-radius:10px;background:#151f27;color:#f6eedb;padding:8px 10px;font:500 13px/1.2 system-ui;outline:none}.home-chat-compose textarea:focus{border-color:#d0a74d;box-shadow:0 0 0 2px #c79b4638}
.home-chat-send,.home-chat-collapse{border:1px solid #8c6b2e;border-radius:10px;background:#1a2630;color:#f0d58c;font:700 11px/1 system-ui;padding:0 12px}.home-chat-send:disabled{opacity:.45}.home-chat-collapse{position:absolute;right:72px;top:-28px;width:34px;height:26px;padding:0;background:#0f171e}
.home-chat-transcript{position:absolute;z-index:70;left:-7px;right:-72px;bottom:calc(100% + 5px);max-height:min(42dvh,360px);overflow:auto;-webkit-overflow-scrolling:touch;padding:8px;background:#0b1319f5;border:1px solid #7f642f;border-radius:12px 12px 5px 5px;box-shadow:0 -12px 30px #000a;backdrop-filter:blur(8px)}
.home-chat-transcript article{display:grid;gap:2px;padding:7px 8px;border-bottom:1px solid #66522d66}.home-chat-transcript article:last-child{border-bottom:0}.home-chat-transcript strong{color:#dfc174;font:700 10px/1 system-ui}.home-chat-transcript p{margin:0;color:#eee5d2;font:500 12px/1.3 system-ui;white-space:pre-wrap}
/* The transcript may grow upward over the play surface, but never into the header. */
.home-inline-chat.expanded .home-chat-transcript{max-height:calc(100dvh - 64px - 52px - 54px - 132px - 12px)}
.rist{grid-template-areas:"header" "cards" "map" "hand" "footer"!important;grid-template-rows:64px 52px minmax(0,1fr) 54px 126px!important;gap:5px!important;padding-bottom:max(2px,env(safe-area-inset-bottom))!important}
@media(orientation:landscape){.rist{grid-template-rows:58px minmax(0,1fr) 48px 116px!important;grid-template-areas:"header" "map" "hand" "footer"!important}.home-footer-stack{grid-template-rows:58px 54px}.home-footer-stack #footer-slider{height:58px!important;min-height:58px!important;max-height:58px!important}.home-inline-chat{height:54px}.home-chat-compose textarea{height:42px;min-height:42px;max-height:42px}.home-inline-chat.expanded .home-chat-transcript{max-height:calc(100dvh - 58px - 48px - 116px - 12px)}}
@media(max-width:430px){.home-chat-compose{grid-template-columns:1fr}.home-chat-compose>span{display:none}.home-chat-send{padding-inline:10px}.home-chat-transcript{right:-58px}.home-chat-collapse{right:58px}}
