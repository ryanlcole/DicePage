.coin-token-source,.character-token-source{position:relative!important;overflow:hidden!important}.coin-choice,.character-front-token{width:46px!important;height:46px!important;margin:auto!important}.coin-choice{position:relative!important;border:0!important;border-radius:0!important;background:transparent!important;color:transparent!important}.coin-choice::before,.coin-choice::after,.coin-choice{filter:drop-shadow(0 2px 2px #0008)}.coin-choice::before,.coin-choice::after{content:"";position:absolute;border-radius:50%;background-image:url("https://d2d6rnm6fnsp89.cloudfront.net/assets/spritesheets/magic-coins.webp?v=20260829-aws-1");background-repeat:no-repeat;background-size:600% 1500%;background-position:0 0}.coin-choice::before{width:32px;height:32px;left:4px;top:10px}.coin-choice::after{width:29px;height:29px;right:1px;top:3px}.coin-token-source::after{content:"";position:absolute;width:25px;height:25px;left:21px;top:28px;border-radius:50%;background-image:url("https://d2d6rnm6fnsp89.cloudfront.net/assets/spritesheets/magic-coins.webp?v=20260829-aws-1");background-repeat:no-repeat;background-size:600% 1500%;background-position:0 0;filter:drop-shadow(0 2px 3px #0009);pointer-events:none}.character-front-token{display:block!important;border:2px solid #d7ab35!important;border-radius:10px!important;background:#111820 center/cover no-repeat!important;color:transparent!important;box-shadow:inset 0 0 0 1px #74c8e055}.character-front-token.has-character-token{background-position:center!important;background-size:cover!important}.character-front-token.no-character-token{background-image:radial-gradient(circle,#d9b95333,#10171d 70%)!important}.character-front-token.no-character-token::after{content:"♟";display:grid;place-items:center;width:100%;height:100%;color:#f2dfac;font-size:25px}.calforth-token-button{flex:0 0 64px!important;width:64px!important;height:64px!important}.rist.auth-visitor .calforth-token-button{pointer-events:auto!important;filter:none!important;opacity:1!important}

/* AWS is the runtime artwork authority. Repository files under wwwroot/assets are deployment sources only. */
.header-mmo-button .mmo-toggle-art.mmo-toggle-image{
 display:grid!important;place-items:center!important;width:100%!important;height:100%!important;
 background:url("https://d2d6rnm6fnsp89.cloudfront.net/assets/ui/sandbox-toggle.webp?v=20260829-aws-1") center/contain no-repeat!important;
 overflow:hidden!important
}
.header-mmo-button.mmo-art-active .mmo-toggle-art.mmo-toggle-image{
 background-image:url("https://d2d6rnm6fnsp89.cloudfront.net/assets/ui/mmo-toggle.webp?v=20260829-aws-1")!important
}
.header-mmo-button .mmo-toggle-image img{display:none!important}

/* The shared pin artwork is an AWS-synced SVG, not a CSS-drawn fallback. */
.icon-pin.map-pin-icon,.map-pin-icon{
 display:block!important;box-sizing:border-box!important;width:34px!important;height:34px!important;
 min-width:34px!important;min-height:34px!important;border:0!important;border-radius:0!important;box-shadow:none!important;
 transform:none!important;background-color:transparent!important;
 background-image:url("https://d2d6rnm6fnsp89.cloudfront.net/assets/ui/map-pin.svg?v=20260829-aws-1")!important;
 background-position:center!important;background-repeat:no-repeat!important;background-size:contain!important
}
.icon-pin.map-pin-icon::before,.icon-pin.map-pin-icon::after,.map-pin-icon::before,.map-pin-icon::after{content:none!important}
.piece.pin .map-pin-icon{width:100%!important;height:100%!important;min-width:0!important;min-height:0!important}

/* WORLD miniatures use the AWS magic-coin sheet. Hide the obsolete missing PNG element. */
.token-preview:has(>img[src*="main-world-coin"]),.piece.mini:has(>img[src*="main-world-coin"]){
 position:relative!important;overflow:visible!important;background-color:transparent!important;border:0!important;box-shadow:none!important;
 background-image:url("https://d2d6rnm6fnsp89.cloudfront.net/assets/spritesheets/magic-coins.webp?v=20260829-aws-1")!important;
 background-repeat:no-repeat!important;background-size:600% 1500%!important;background-position:0 0!important
}
.token-preview>img[src*="main-world-coin"],.piece.mini>img[src*="main-world-coin"]{display:none!important}
.token-preview:has(>img[src*="main-world-coin"])::before,.token-preview:has(>img[src*="main-world-coin"])::after,.piece.mini:has(>img[src*="main-world-coin"])::before,.piece.mini:has(>img[src*="main-world-coin"])::after{content:none!important}

/* Non-world miniature fallback uses the AWS humanoid direction sheet until the selected character token is available. */
.token-preview:has(>img[src*="main-token"]),.piece.mini:has(>img[src*="main-token"]){
 position:relative!important;background-color:transparent!important;border:0!important;
 background-image:url("https://d2d6rnm6fnsp89.cloudfront.net/assets/spritesheets/directional-humanoids.webp?v=20260829-aws-1")!important;
 background-repeat:no-repeat!important;background-size:800% auto!important;background-position:0 0!important
}
.token-preview>img[src*="main-token"],.piece.mini>img[src*="main-token"]{display:none!important}
.token-preview:has(>img[src*="main-token"])::before,.token-preview:has(>img[src*="main-token"])::after,.piece.mini:has(>img[src*="main-token"])::before,.piece.mini:has(>img[src*="main-token"])::after{content:none!important}

/* Private rail geometry: keep the pin artwork transparent and fully inside a themed button. */
.private-assets-rail .token-pin-source{
 box-sizing:border-box!important;flex:0 0 54px!important;width:54px!important;height:58px!important;min-width:54px!important;min-height:58px!important;
 display:grid!important;place-items:center!important;padding:6px!important;overflow:hidden!important;
 border:1px solid #725d30!important;border-radius:9px!important;background:transparent!important;box-shadow:none!important
}
.private-assets-rail .token-pin-source .map-pin-icon{
 width:34px!important;height:42px!important;min-width:34px!important;min-height:42px!important;
 background-color:transparent!important;background-size:contain!important;background-position:center!important
}

/* Private cards need a wider frame so the full card artwork reads at phone scale. */
.private-assets-rail .private-assets-items .compact-hand-card,
.private-assets-rail .private-assets-items .hand-card-wrap{
 flex:0 0 52px!important;width:52px!important;min-width:52px!important
}
.private-assets-rail .private-assets-items .compact-hand-card{
 height:58px!important;min-height:58px!important;padding:3px!important;border:1px solid #725d30!important;border-radius:8px!important;background-color:#111920!important
}
.private-assets-rail .private-assets-items .compact-hand-card img,
.private-assets-rail .private-assets-items .hand-toggle-card-back{
 max-width:100%!important;max-height:100%!important;object-fit:contain!important
}
