/* Footer dice use optimized 256x256 source frames.
   Keep every source frame square and scale both axes together. */
.dice-footer .die-button{
 display:grid!important;
 grid-template-rows:1fr!important;
 place-items:center!important;
 overflow:hidden;
}
.dice-footer .die-sprite{
 width:44px!important;
 height:44px!important;
 min-width:44px!important;
 min-height:44px!important;
 aspect-ratio:1/1!important;
 background-repeat:no-repeat;
 background-color:transparent!important;
 background-origin:border-box;
 background-clip:border-box;
 justify-self:center;
 align-self:center;
 flex:none;
 transform:none!important;
}

/* Ordinary dice are square and exactly as tall as a footer card. */
.dice-footer .circular-set>.die-button{
 flex:0 0 var(--footer-slot-h)!important;
 width:var(--footer-slot-h)!important;
 min-width:var(--footer-slot-h)!important;
 height:var(--footer-slot-h)!important;
 min-height:var(--footer-slot-h)!important;
 max-height:var(--footer-slot-h)!important;
 padding:6px!important;
}

/* Clear Dice shares the card height but is intentionally rectangular. */
.dice-footer .clear-dice{
 flex:0 0 calc(var(--footer-slot-h) + 18px)!important;
 width:calc(var(--footer-slot-h) + 18px)!important;
 min-width:calc(var(--footer-slot-h) + 18px)!important;
 height:var(--footer-slot-h)!important;
 min-height:var(--footer-slot-h)!important;
 max-height:var(--footer-slot-h)!important;
 align-self:stretch!important;
 white-space:normal!important;
 line-height:1.1!important;
 text-align:center;
 padding:8px 12px!important;
}

/* Each D5 is a square die with a short horizontal value bar below it.
   The square plus the bar equals the card height. */
.dice-footer .d5-control{
 --d5-value-h:24px;
 --d5-square:calc(var(--footer-slot-h) - var(--d5-value-h));
 position:relative!important;
 flex:0 0 var(--d5-square)!important;
 width:var(--d5-square)!important;
 min-width:var(--d5-square)!important;
 height:var(--footer-slot-h)!important;
 min-height:var(--footer-slot-h)!important;
 max-height:var(--footer-slot-h)!important;
 display:grid!important;
 grid-template-columns:var(--d5-square)!important;
 grid-template-rows:var(--d5-square) var(--d5-value-h)!important;
 gap:0!important;
 align-items:stretch!important;
}
.dice-footer .d5-control .die-button{
 grid-column:1!important;
 grid-row:1!important;
 width:var(--d5-square)!important;
 min-width:var(--d5-square)!important;
 max-width:var(--d5-square)!important;
 height:var(--d5-square)!important;
 min-height:var(--d5-square)!important;
 max-height:var(--d5-square)!important;
 padding:4px!important;
 border-radius:10px 10px 0 0!important;
}
.dice-footer .d5-control select{
 position:static!important;
 grid-column:1!important;
 grid-row:2!important;
 z-index:2;
 display:block!important;
 width:var(--d5-square)!important;
 min-width:var(--d5-square)!important;
 max-width:var(--d5-square)!important;
 height:var(--d5-value-h)!important;
 min-height:var(--d5-value-h)!important;
 max-height:var(--d5-value-h)!important;
 padding:1px 18px 1px 6px!important;
 margin:0!important;
 border-radius:0 0 7px 7px!important;
 text-align:center;
 text-align-last:center;
}
.dice-footer .d5-control .die-sprite{
 width:34px!important;
 height:34px!important;
 min-width:34px!important;
 min-height:34px!important;
}

.rolled-die{
 width:50px!important;
 height:50px!important;
 aspect-ratio:1/1!important;
 background-repeat:no-repeat;
 background-color:transparent!important;
 background-origin:border-box;
 background-clip:border-box;
 transform:translate(-50%,-50%) translate(var(--collision-x,0px),var(--collision-y,0px))!important;
}

.character-footer-button{flex:0 0 54px!important;width:54px!important;height:52px!important;padding:7px!important;display:grid!important;place-items:center!important;background:#1d2630!important;border:1px solid #725d30!important;border-radius:9px!important;color:#f4ead1!important;touch-action:manipulation;cursor:pointer}
.character-footer-button svg{width:31px;height:31px;display:block;fill:currentColor;pointer-events:none}
.character-footer-button:active{transform:translateY(1px);background:#2b3743!important}

@media(max-width:800px){
 .dice-footer .die-sprite{width:42px!important;height:42px!important;min-width:42px!important;min-height:42px!important}
 .dice-footer .d5-control{--d5-value-h:23px}
 .dice-footer .d5-control .die-sprite{width:32px!important;height:32px!important;min-width:32px!important;min-height:32px!important}
 .rolled-die{width:44px!important;height:44px!important}
 .character-footer-button{flex-basis:50px!important;width:50px!important;height:48px!important;padding:6px!important}
 .character-footer-button svg{width:29px;height:29px}
}
