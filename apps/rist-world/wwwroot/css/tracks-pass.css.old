.tracks-bank .tracks-title{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:end}.tracks-bank .tracks-title span{font-size:11px;line-height:1.3;color:#bca97e;white-space:normal}.track-channel{grid-template-rows:1fr auto auto auto auto!important;min-width:var(--control-width)!important}.track-values{grid-column:1/3;display:grid;grid-template-columns:1fr 1fr;gap:6px}.track-values label{display:grid;gap:2px;place-items:center;border:1px solid #806124;background:#090b0b;color:#f0cf69;padding:6px}.track-values small{font-size:8px;letter-spacing:.08em;color:#aa9872}.track-values strong{font-size:18px}.track-values input{width:100%;min-width:0;background:#121617;color:#f2d77b;border:1px solid #806124;text-align:center;font-weight:900;padding:5px}.track-card-button{grid-column:1/3;width:100%;margin-top:3px}.map-track-card{grid-template-rows:auto 1fr auto auto!important}.map-track-live{display:grid;gap:8px;align-content:center;padding:10px;border:1px solid #70551f;background:#0d100f}.map-track-readout{display:flex;justify-content:center;align-items:baseline;gap:6px}.map-track-readout strong{font-size:30px;color:#efc85a}.map-track-readout span{font-size:15px;color:#c3b183}.map-track-live input[type=range]{width:100%;accent-color:#c79a39}.map-track-card .map-card-value{font-size:14px;min-width:70px}.map-track-card .map-card-image{display:none}
@media(max-width:650px){.tracks-bank .tracks-title{grid-template-columns:1fr}.tracks-bank .tracks-title span{font-size:10px}.track-channel{min-width:max(150px,var(--control-width))!important}.track-values strong{font-size:16px}.map-track-readout strong{font-size:26px}}
