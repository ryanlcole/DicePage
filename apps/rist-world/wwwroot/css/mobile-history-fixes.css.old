/* Mobile interaction pass: preserve tuned dice geometry while fixing reachability. */
.header-mmo-button{padding:3px!important;overflow:hidden!important}
.header-mmo-button .mmo-toggle-art{display:block;width:100%;height:100%;background:url('../assets/ui/sandbox-toggle.webp') center/contain no-repeat}
.header-mmo-button.active .mmo-toggle-art{background-image:url('../assets/ui/mmo-toggle.webp')}
.header-settings-button>span{display:grid!important;place-items:center!important;width:100%!important;height:100%!important;color:#e3bd55!important;font-size:34px!important;line-height:1!important;text-shadow:0 0 9px #d5a42f88!important}

/* The footer frame stays fixed. The inner dice strip owns horizontal movement,
   which lets the final history/clear/card controls travel fully clear of the arrows. */
.dice-footer{overflow:hidden!important}
.dice-footer .dice-circular-set{box-sizing:border-box!important;flex:1 1 auto!important;width:100%!important;min-width:0!important;max-width:none!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch!important;scrollbar-width:none!important;touch-action:pan-x!important;scroll-padding-inline:10px 74px!important;padding-left:10px!important;padding-right:74px!important}
.dice-footer .dice-circular-set::-webkit-scrollbar{display:none!important}

.history-scroll-button{box-sizing:border-box;display:grid;place-items:center;flex:0 0 42px;width:42px;min-width:42px;height:var(--footer-slot-h,58px);padding:0;border:1px solid #8d6a28;border-radius:10px;background:#111a21;color:#e2c36f;font-size:22px;line-height:1}
.roll-history-toggle{height:var(--footer-slot-h,58px)!important}

/* Chat remains one fixed row. 16px prevents Safari/Chrome on iPhone from
   zooming the viewport when the composer receives focus. */
.home-inline-chat{position:relative!important;display:grid!important;grid-template-columns:42px minmax(0,1fr) 72px!important;gap:6px!important;height:58px!important;min-height:58px!important;max-height:58px!important;padding:5px 7px!important;overflow:hidden!important;align-items:stretch!important}
.home-inline-chat .chat-history-toggle{width:42px!important;min-width:42px!important;height:46px!important;align-self:center!important}
.home-chat-compose{display:block!important;min-width:0!important;width:100%!important;height:46px!important;margin:0!important}
.home-chat-compose>span{display:none!important}
.home-chat-compose textarea{box-sizing:border-box!important;width:100%!important;min-width:0!important;height:46px!important;min-height:46px!important;max-height:46px!important;margin:0!important;padding:8px 10px!important;resize:none!important;font-size:16px!important;line-height:1.2!important}
.home-chat-send{box-sizing:border-box!important;width:72px!important;min-width:72px!important;height:46px!important;align-self:center!important;padding:0 8px!important}

/* History is a separate parchment scroll, never an expanding home-screen row. */
.history-scroll-scrim{position:fixed;z-index:2147482500;inset:0;display:grid;place-items:center;padding:18px;background:#02070bd9;backdrop-filter:blur(5px)}
.history-scroll-sheet{box-sizing:border-box;width:min(540px,94vw);height:min(70dvh,640px);display:grid;grid-template-rows:52px minmax(0,1fr);overflow:hidden;border:2px solid #a77d2f;border-radius:18px;background:linear-gradient(#f7edcf,#e8d4a6);color:#4c3821;box-shadow:0 22px 60px #000d}
.history-scroll-sheet>header{display:grid;grid-template-columns:minmax(0,1fr) 42px;align-items:center;padding:6px 8px 6px 18px;border-bottom:1px solid #a77d2f;background:#f2e2ba}
.history-scroll-sheet>header strong{font:700 18px/1.1 Georgia,serif;text-align:center}
.history-scroll-sheet>header button{width:38px;height:38px;border:1px solid #a77d2f;border-radius:50%;background:#fff7df;color:#5a4023;font-size:24px}
.history-scroll-body{min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:12px 15px 28px;overscroll-behavior:contain}
.chat-history-entry,.roll-history-entry{padding:10px 3px;border-bottom:1px solid #9d7e4659}
.chat-history-entry strong,.roll-history-entry strong{display:block;color:#5a4023;font:700 14px/1.2 Georgia,serif}
.chat-history-entry p,.roll-history-entry p{margin:5px 0 0;white-space:pre-wrap;font:500 14px/1.35 system-ui}
.roll-history-entry small{display:block;margin-top:3px;color:#735d38;font:600 11px/1.25 system-ui}
.roll-history-entry p{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.history-empty{text-align:center;color:#7c6844;margin-top:35px}

@media(max-width:430px){
 .home-inline-chat{grid-template-columns:40px minmax(0,1fr) 66px!important;padding-inline:5px!important;gap:4px!important}
 .home-inline-chat .chat-history-toggle{width:40px!important;min-width:40px!important}
 .home-chat-send{width:66px!important;min-width:66px!important}
}
