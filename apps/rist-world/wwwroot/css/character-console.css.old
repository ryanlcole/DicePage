.character-console{position:relative;width:min(1020px,96vw);padding:18px 18px 210px;border:4px ridge #8f6b27;border-radius:24px;background:linear-gradient(#0c0d0de8,#17130def),url('../assets/ui/mixer_sprite_atlas.png') center/cover;color:#ead9b4;box-shadow:0 20px 70px #000,inset 0 0 0 3px #1b1307,inset 0 0 35px #000}.character-console-tools{position:sticky;top:0;z-index:30;display:flex;justify-content:flex-end;gap:8px;margin-bottom:8px}.character-console-tools button{border:1px solid #9d772c;background:#17130d;color:#ead9b4;border-radius:9px;padding:7px 12px}.console-close{font-size:20px}.console-identity{display:grid;grid-template-columns:150px 1.35fr 1fr .75fr 1fr;gap:10px;align-items:stretch;padding:12px;border:2px solid #8c6928;background:#111311e8}.console-identity .character-portrait{width:auto;height:auto;min-height:104px;border:3px ridge #a17b31;border-radius:50%;background:#121516}.console-identity label{display:grid;grid-template-rows:auto 1fr;text-align:center;font:700 12px Georgia,serif;letter-spacing:.05em}.console-identity input{min-width:0;width:100%;background:#101416;border:2px ridge #8f6b27;color:#f3e5c6;text-align:center;padding:8px}.console-bank{margin-top:10px;border:2px solid #765820;background:#111311e8;padding:10px}.bank-title{display:flex;justify-content:space-between;align-items:center;padding:0 4px 8px;font-family:Georgia,serif}.bank-title strong{font-size:20px}.bank-title span{font-size:10px;color:#a99570}.character-circular-rail{width:100%;min-height:180px}.character-control-set{align-items:stretch!important}.pool-channel,.dial-channel{position:relative;flex:0 0 auto;border:1px solid #72551f;background:#151717;box-shadow:inset 0 0 16px #000;padding:8px}.pool-channel{width:96px;height:350px;display:grid;grid-template-columns:24px 1fr;grid-template-rows:1fr 34px 30px 36px auto;gap:3px}.pool-scale{grid-row:1;display:flex;flex-direction:column;justify-content:space-between;align-items:end;font-size:9px;color:#dbc68f}.pool-slider{grid-row:1;grid-column:2;writing-mode:vertical-lr;direction:rtl;width:30px;height:205px;align-self:center;justify-self:center}.field-value-box,.field-max-box{grid-column:1/3;text-align:center;border:1px solid #805e22;background:#090b0c;color:#e4b75a;font-weight:900;padding:5px}.name-plate{grid-column:1/3;border:1px solid #8c6928;background:#d9c08a;color:#261b10;min-height:34px;display:grid;place-items:center;padding:3px}.name-plate input{width:100%;min-width:0;border:0;background:transparent;text-align:center;color:#261b10;font-weight:800}.remove-field{position:absolute;right:2px;top:0;z-index:3;background:transparent;border:0;color:#c8a96b;font-size:18px}.console-add{flex:0 0 78px;min-height:120px;align-self:center;border:2px ridge #98752e;background:#2a2114;color:#e7c66f;font-size:38px;border-radius:14px}.round-add{width:120px;height:120px;border-radius:50%}.dial-channel{width:155px;display:grid;justify-items:center;gap:6px}.max-crown{font-size:10px;color:#d8c08b;border:1px solid #77591f;background:#0a0c0d;padding:3px 8px}.rotary-dial{position:relative;width:118px;height:118px;border-radius:50%;border:7px double #9a742b;background:repeating-conic-gradient(#9a742b 0 3deg,#181818 3deg 12deg);display:grid;place-items:center;box-shadow:inset 0 0 0 12px #16191a,inset 0 0 0 15px #5e471e}.dial-center{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#121515;color:#e3bb55;font-size:25px;font-weight:900;z-index:2}.dial-center input{width:48px;border:0;background:transparent;color:inherit;text-align:center;font:inherit}.dial-step{position:absolute;width:32px;height:32px;border-radius:50%;border:1px solid #8e6a27;background:#211a10;color:#f0d172;font-size:20px;z-index:3}.dial-minus{left:-8px;bottom:4px}.dial-plus{right:-8px;bottom:4px}.show-hand{width:100%;background:#272117;color:#d7bd82;border:1px solid #715625;border-radius:7px;padding:5px;font-size:10px}.color-swatches{grid-column:1/3;display:flex;justify-content:center;gap:3px}.swatch{width:15px;height:15px;border-radius:50%;border:1px solid #d5bf8c!important;padding:0!important}.swatch.active{outline:2px solid #fff6d2}.swatch-red{background:#b83932!important}.swatch-orange{background:#d97824!important}.swatch-gold{background:#d1a52b!important}.swatch-green{background:#4fa151!important}.swatch-teal{background:#31a0a0!important}.swatch-blue{background:#3b69be!important}.swatch-purple{background:#8646b4!important}.color-red .rotary-dial,.color-red .pool-slider{accent-color:#b83932}.color-orange .rotary-dial,.color-orange .pool-slider{accent-color:#d97824}.color-gold .rotary-dial,.color-gold .pool-slider{accent-color:#d1a52b}.color-green .rotary-dial,.color-green .pool-slider{accent-color:#4fa151}.color-teal .rotary-dial,.color-teal .pool-slider{accent-color:#31a0a0}.color-blue .rotary-dial,.color-blue .pool-slider{accent-color:#3b69be}.color-purple .rotary-dial,.color-purple .pool-slider{accent-color:#8646b4}.console-notebook{margin-top:10px;border:2px solid #765820;background:#17130fe8;padding:10px}.notebook-tabs{display:flex;gap:5px;justify-content:center}.notebook-tabs button{flex:1;max-width:260px;border:1px solid #846324;background:#cbb27a;color:#231a0e;padding:7px;font:700 12px Georgia,serif;text-transform:uppercase}.notebook-tabs button.active{background:#f0dba7}.console-notebook textarea{width:100%;min-height:170px;margin-top:8px;padding:12px;background:#261b12cc;color:#f1dfbd;border:2px ridge #7e5d23;resize:vertical}.dial-hand-card{min-width:150px;position:relative;display:grid;grid-template-columns:1fr 44px;grid-template-rows:92px auto auto;gap:5px;padding:8px}.hand-card-dial{grid-column:1/3;justify-self:center;width:82px;height:82px;border-radius:50%;display:grid;place-items:center;border:6px double #9a742b;background:repeating-conic-gradient(#9a742b 0 3deg,#181818 3deg 12deg);box-shadow:inset 0 0 0 10px #16191a}.hand-card-dial span{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#111;color:#e7c25c;font-size:20px;font-weight:900}.hand-card-plate{grid-column:1/2;border:1px solid #8c6928;background:#d9c08a;color:#261b10;padding:4px;text-align:center}.hand-card-plate small{display:block;font-size:8px}.dicebag-button{grid-column:2;width:42px!important;height:42px!important;padding:2px!important;align-self:center}.dicebag-button img{width:100%;height:100%;object-fit:contain}.dicebag-modal.sheet-bag-modal{z-index:95;background:#0008;padding-bottom:160px}.bag-drop-zone{outline:2px dashed #b58a38}.bag-die-chip{cursor:grab}.drag-hint{font-size:9px;color:#ad9870}body:has(.mixer-modal) .hand-rail{position:fixed!important;left:0;right:0;bottom:82px;z-index:90;background:#10161d;border-top:1px solid #6e592c}body:has(.mixer-modal) .dice-footer{position:fixed!important;left:0;right:0;bottom:0;z-index:91;background:#121820;border-top:1px solid #6e592c}.mixer-modal{align-items:start;padding-bottom:180px}
@media(max-width:650px) and (orientation:portrait){.character-console{width:96vw;padding:8px 8px 210px;border-radius:16px}.console-identity{grid-template-columns:88px 1fr 1fr}.console-identity .character-portrait{grid-row:span 2;min-height:88px}.console-bank{padding:6px}.pool-channel{width:84px;height:310px}.pool-slider{height:165px}.dial-channel{width:132px}.rotary-dial{width:96px;height:96px}.round-add{width:96px;height:96px}.bank-title span{display:none}.console-notebook textarea{min-height:140px}body:has(.mixer-modal) .hand-rail{bottom:72px}body:has(.mixer-modal) .dice-footer{height:72px}}
@media(max-height:520px) and (orientation:landscape){.character-console{width:98vw;max-height:calc(100dvh - 8px);padding:8px 8px 170px}.console-identity{grid-template-columns:90px 1.35fr 1fr .7fr 1fr}.pool-channel{height:240px}.pool-slider{height:115px}.rotary-dial{width:82px;height:82px}.dial-channel{width:118px}.round-add{width:82px;height:82px}body:has(.mixer-modal) .hand-rail{bottom:64px}body:has(.mixer-modal) .dice-footer{height:64px}}
