/* Portrait/profile geometry only. Home/map width is owned by home-viewport.css. */
.portrait-editor-modal{box-sizing:border-box!important;place-items:center!important;padding:max(8px,env(safe-area-inset-top,0px)) 10px max(8px,env(safe-area-inset-bottom,0px))!important;overflow:hidden!important}
.portrait-editor{box-sizing:border-box!important;width:min(420px,calc(100dvw - 20px))!important;max-width:calc(100dvw - 20px)!important;max-height:calc(100dvh - max(20px,env(safe-area-inset-top,0px) + env(safe-area-inset-bottom,0px)))!important;display:flex!important;flex-direction:column!important;overflow:hidden!important}
.portrait-editor>header{box-sizing:border-box!important;flex:0 0 auto!important;min-height:58px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;padding:12px 14px!important}
.portrait-editor>header strong{min-width:0!important;line-height:1.1!important}
.portrait-editor>header button{box-sizing:border-box!important;flex:0 0 36px!important;width:36px!important;min-width:36px!important;max-width:36px!important;height:36px!important;min-height:36px!important;margin:0!important;padding:0!important;display:grid!important;place-items:center!important;border:1.5px solid #b68e44!important;border-radius:50%!important;background:#fff8ea!important;color:#5b4932!important;font:700 22px/1 system-ui!important;overflow:hidden!important}
.portrait-upload-area{box-sizing:border-box!important;flex:0 0 auto!important;min-width:0!important;width:100%!important;padding:8px 16px 4px!important;gap:8px!important;overflow:hidden!important}
.portrait-icon-actions{display:flex!important;align-items:center!important;justify-content:center!important;gap:12px!important}
.portrait-icon-actions input[type="file"]{position:absolute!important;width:1px!important;height:1px!important;opacity:0!important;pointer-events:none!important}
.portrait-attachment-icon,.portrait-paint-icon{box-sizing:border-box!important;width:44px!important;min-width:44px!important;max-width:44px!important;height:44px!important;min-height:44px!important;padding:0!important;margin:0!important;display:grid!important;place-items:center!important;border:1.5px solid #b68e44!important;border-radius:50%!important;background:#17242e!important;color:#ffe5a6!important;font:700 21px/1 system-ui!important;cursor:pointer!important}
.portrait-attachment-icon span,.portrait-paint-icon span{display:block!important;line-height:1!important}
.portrait-draw{width:44px!important;max-width:44px!important}
.portrait-editor-controls{box-sizing:border-box!important;flex:1 1 auto!important;min-height:0!important;width:100%!important;padding:0 16px 10px!important;overflow-x:hidden!important;overflow-y:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch!important}
.portrait-editor-controls .portrait-crop{box-sizing:border-box!important;width:min(58dvw,220px,29dvh)!important;max-width:100%!important;height:auto!important;aspect-ratio:1!important;margin:-4px auto 0!important}
.portrait-adjustments{width:100%!important;min-width:0!important;gap:7px!important;margin-top:4px!important}
.portrait-adjustments label{min-width:0!important;display:grid!important;grid-template-columns:82px minmax(0,1fr)!important;align-items:center!important;gap:8px!important;font-size:12px!important}
.portrait-adjustments input[type="range"]{width:100%!important;min-width:0!important}
.portrait-editor>footer{box-sizing:border-box!important;flex:0 0 auto!important;width:100%!important;min-width:0!important;display:flex!important;justify-content:flex-end!important;align-items:center!important;gap:7px!important;padding:9px 14px 12px!important;overflow:hidden!important}
.portrait-editor>footer button{box-sizing:border-box!important;flex:0 0 auto!important;width:auto!important;min-width:82px!important;max-width:46%!important;margin:0!important;line-height:1!important}
.profile-name,.profile-concept,.reference-value-tile input{box-sizing:border-box!important;padding-top:0!important;padding-bottom:0!important;line-height:normal!important}
.profile-concept{display:block!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
.reference-value-tile{position:relative!important;display:block!important;overflow:visible!important}
.reference-value-tile .tile-label{position:absolute!important;left:7%!important;top:4%!important;width:86%!important;height:23%!important;margin:0!important;padding-inline:5%!important;text-overflow:ellipsis!important}
.reference-value-tile .tile-number{position:absolute!important;left:28.5%!important;top:31%!important;width:43%!important;height:43%!important;aspect-ratio:auto!important;margin:0!important;text-align:center!important}
.reference-value-tile .tile-circle-row{position:absolute!important;left:16%!important;right:16%!important;bottom:4.5%!important;height:17%!important;display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;align-items:center!important;gap:9%!important}
.reference-value-tile .tile-circle-text{box-sizing:border-box!important;width:100%!important;height:100%!important;min-width:0!important;margin:0!important;padding:0!important;border:0!important;border-radius:50%!important;background:transparent!important;box-shadow:none!important;outline:0!important;color:var(--character-font)!important;text-align:center!important;font:700 clamp(6px,1.7vw,11px)/normal Georgia,serif!important;overflow:hidden!important}
.reference-value-tile input::placeholder{color:#7b6a52!important;opacity:.55!important}
