@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<div class="worldbuilder-studio">
 <header class="studio-header" aria-label="World Builder header">
  <button type="button" class="studio-home" @onclick="GoHomeAsync" aria-label="Home">⌂</button>
  <div class="studio-ticker" aria-label="World Building ticker">
   <div class="studio-ticker-track">
    @for(var i=0;i<6;i++)
    {
     <span aria-hidden="@(i>0)"><strong>WORLD BUILDING</strong></span>
    }
   </div>
  </div>
  <button type="button" class="studio-profile" aria-label="Account profile">
   @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl))
   {
    <img src="@Session.CharacterPortraitDataUrl" alt="Profile" />
   }
   else
   {
    <span aria-hidden="true">●</span>
   }
  </button>
 </header>

 <section class="studio-workbench" aria-label="World Builder quick tools">
  <div class="studio-top-slider">
   @if(_toolsOpen)
   {
    <button type="button" class="slider-back" @onclick="()=>_toolsOpen=false" aria-label="Back">‹</button>
   }
   <button type="button" class="tools-button @(_toolsOpen?"active":"")" @onclick="()=>_toolsOpen=!_toolsOpen" aria-label="@_toolMode toolset. Tap for more toolsets.">
    <strong>@_toolMode</strong>
    <small>Toolset</small>
    <span>More…</span>
   </button>
   @if(_toolsOpen)
   {
    @foreach(var mode in Modes)
    {
     <button type="button" class="tool-choice @(_toolMode==mode?"active":"")" @onclick="()=>SelectTool(mode)">@mode</button>
    }
   }
   else
   {
    @foreach(var tile in _quickTiles)
    {
     <button type="button" class="quick-slot filled" draggable="true" @ondragstart="()=>Session.StageTile(tile)" @ondblclick="()=>RemoveQuickTile(tile)" title="Drag to map; double click to remove">
      <img src="@tile.Image" alt="" draggable="false" /><span>@tile.Name</span>
     </button>
    }
    @for(var i=_quickTiles.Count;i<QuickSlotCount;i++)
    {
     <span class="quick-slot empty" aria-label="Empty quick asset slot"></span>
    }
   }
  </div>
 </section>

 <main class="studio-viewer" aria-label="World map viewer">
  <div class="studio-viewer-canvas" @ref="_viewerElement">
   <WorldMap />
   <div class="studio-viewer-grid @(_viewerGrid?"on":"off")" aria-hidden="true"></div>
   <div class="studio-viewer-overlays"><AssetLibrary /></div>
  </div>
 </main>

 <section class="studio-tile-slider" aria-label="World building asset navigation">
  <WorldAssetFolderRail />
 </section>
</div>

<style>
 .worldbuilder-studio{box-sizing:border-box;height:100%;min-height:0;width:100%;display:grid;grid-template-rows:48px 62px minmax(0,1fr) 68px;overflow:hidden;background:#03080c;color:#e8dec5;font-family:Inter,system-ui,-apple-system,sans-serif}
 .studio-header{min-width:0;display:grid;grid-template-columns:8% 84% 8%;align-items:stretch;border-bottom:1px solid #715b2d;background:#081017;overflow:hidden}.studio-home,.studio-profile{min-width:0;border:0;background:#0c151d;color:#e4c97d;font-size:22px;font-weight:900;display:grid;place-items:center;padding:0}.studio-home{border-right:1px solid #715b2d}.studio-profile{border-left:1px solid #715b2d;overflow:hidden}.studio-profile img{width:100%;height:100%;object-fit:cover;display:block}.studio-profile span{font-size:16px;color:#7ca5bf}.studio-ticker{min-width:0;overflow:hidden;display:flex;align-items:center}.studio-ticker-track{width:max-content;display:flex;align-items:center;gap:80px;white-space:nowrap;animation:worldTicker 16s linear infinite}.studio-ticker-track span{min-width:190px;text-align:center}.studio-ticker-track strong{color:#e4c97d;font-size:12px;letter-spacing:.16em}@@keyframes worldTicker{from{transform:translateX(0)}to{transform:translateX(-270px)}}
 .studio-workbench{min-width:0;overflow:hidden;border-bottom:1px solid #715b2d;background:linear-gradient(180deg,#101820,#091117);padding:6px}.studio-top-slider{height:100%;display:flex;align-items:center;gap:6px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}.studio-top-slider::-webkit-scrollbar{display:none}.studio-top-slider button,.quick-slot{box-sizing:border-box;flex:0 0 auto;height:48px;min-width:72px;border:1px solid #4b5f69;border-radius:9px;background:#0d171e;color:#d4dde1;font:800 10px/1 system-ui;touch-action:manipulation}.studio-top-slider button.active{border-color:#d0aa56;color:#f4d98d;background:#202015}.slider-back{width:48px;min-width:48px!important;font-size:25px!important}.tools-button{min-width:92px!important;padding:4px 10px!important;display:grid!important;grid-template-rows:auto auto auto!important;place-items:center!important;gap:1px!important;line-height:1!important;white-space:normal!important}.tools-button>strong{font:900 13px/1 system-ui!important;color:#f2dfac!important}.tools-button>small{font:800 7px/1 system-ui!important;letter-spacing:.08em!important;text-transform:uppercase!important;color:#94a7b2!important}.tools-button>span{font:800 8px/1 system-ui!important;color:#63aef1!important}.quick-slot.empty{display:block;width:64px;min-width:64px;border-style:dashed;opacity:.45}.quick-slot.filled{position:relative;overflow:hidden;padding:0}.quick-slot.filled img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.quick-slot.filled span{position:absolute;z-index:2;inset:auto 0 0;padding:4px;background:#000b;color:#fff1bd;font-size:8px;overflow:hidden;text-overflow:ellipsis}.tool-choice{min-width:96px!important}
 .studio-viewer{box-sizing:border-box;min-width:0;min-height:0;overflow:hidden;background:#020609;padding:0}.studio-viewer-canvas{position:relative;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden;background:#03090d;touch-action:none}.studio-viewer-canvas>.table-workspace,.studio-viewer-canvas>.map-shell{width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;max-width:none!important;max-height:none!important;overflow:hidden!important}.studio-viewer-canvas .table-workspace{position:absolute!important;inset:0!important}.studio-viewer-canvas .table-workspace>.staging-tray,.studio-viewer-canvas .table-workspace>.tile-browser,.studio-viewer-canvas .table-workspace>.card-browser{display:none!important}.studio-viewer-canvas .map-shell{position:absolute!important;inset:0!important;display:block!important}.studio-viewer-canvas .map{position:absolute!important;inset:0!important;left:0!important;top:0!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;max-width:none!important;max-height:none!important;aspect-ratio:auto!important;transform:none!important;margin:0!important}.studio-viewer-canvas .world-stage{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;transform:none!important}.studio-viewer-canvas .world-stage>.grid{display:none!important;background:none!important}.studio-viewer-canvas .base.ocean-world{background-size:calc(100% / 30) calc(100% / 30)!important;background-repeat:repeat!important;background-position:0 0!important}.studio-viewer-canvas .status,.studio-viewer-canvas .coordinate-system,.studio-viewer-canvas .grid-coordinates{display:none!important}.studio-viewer-grid{position:absolute;inset:0;z-index:30;pointer-events:none;background-image:linear-gradient(to right,rgba(215,199,145,.52) 1px,transparent 1px),linear-gradient(to bottom,rgba(215,199,145,.52) 1px,transparent 1px);background-size:calc(100% / 30) calc(100% / 30);background-position:0 0}.studio-viewer-grid.off{display:none}.studio-viewer-overlays{position:absolute;inset:0;z-index:40;pointer-events:none}.studio-viewer-overlays>*{pointer-events:auto}
 .studio-tile-slider{min-width:0;display:block;padding:0;overflow:hidden;border-top:1px solid #715b2d;background:#0a1117}
 @@media(max-width:760px){.worldbuilder-studio{grid-template-rows:44px 58px minmax(0,1fr) 60px}.studio-header{grid-template-columns:10% 80% 10%}.studio-top-slider button,.quick-slot{height:44px}.studio-ticker-track{gap:55px}}
</style>

@code{
 static readonly string[] Modes={"Tiles","Cartography","Lightboard","Image","Draw"};
 const int QuickSlotCount=8;
 readonly List<AtlasTile> _quickTiles=[];
 ElementReference _viewerElement;
 IJSObjectReference? _zModule;
 IJSObjectReference? _zBinding;
 DotNetObjectReference<WorldBuilderStudio>? _self;
 string _toolMode="Tiles";
 bool _toolsOpen;
 bool _viewerGrid=true;
 void SelectTool(string mode){_toolMode=mode;_toolsOpen=false;}
 void RemoveQuickTile(AtlasTile tile)=>_quickTiles.Remove(tile);
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _self=DotNetObjectReference.Create(this);
  _zModule=await JS.InvokeAsync<IJSObjectReference>("import","./worldbuilder-z-axis.js");
  _zBinding=await _zModule.InvokeAsync<IJSObjectReference>("attach",_viewerElement,_self);
 }
 [JSInvokable] public Task StepZ(int delta){Session.MoveLayer(Math.Sign(delta));return InvokeAsync(StateHasChanged);}
 async Task GoHomeAsync()=>await JS.InvokeVoidAsync("location.assign","./index.html");
 public async ValueTask DisposeAsync(){if(_zBinding is not null)try{await _zBinding.InvokeVoidAsync("dispose");}catch{} if(_zBinding is not null)await _zBinding.DisposeAsync();if(_zModule is not null)await _zModule.DisposeAsync();_self?.Dispose();}
}
