 .studio-workbench{min-width:0;overflow:hidden;border-bottom:1px solid #715b2d;background:linear-gradient(180deg,#101820,#091117);padding:6px}.studio-top-slider{height:100%;display:flex;align-items:center;gap:6px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}.studio-top-slider::-webkit-scrollbar{display:none}.studio-top-slider button,.quick-slot{box-sizing:border-box;flex:0 0 auto;height:48px;min-width:72px;border:1px solid #4b5f69;border-radius:9px;background:#0d171e;color:#d4dde1;font:800 10px/1 system-ui;touch-action:manipulation}.studio-top-slider button.active{border-color:#d0aa56;color:#f4d98d;background:#202015}.slider-back{width:48px;min-width:48px!important;font-size:25px!important}.tools-button{min-width:92px!important;padding:4px 10px!important;display:grid!important;grid-template-rows:auto auto auto!important;place-items:center!important;gap:1px!important;line-height:1!important;white-space:normal!important}.tools-button>strong{font:900 13px/1 system-ui!important;color:#f2dfac!important}.tools-button>small{font:800 7px/1 system-ui!important;letter-spacing:.08em!important;text-transform:uppercase!important;color:#94a7b2!important}.tools-button>span{font:800 8px/1 system-ui!important;color:#63aef1!important}.quick-slot.empty{display:block;width:64px;min-width:64px;border-style:dashed;opacity:.45}.quick-slot.filled{position:relative;overflow:hidden;padding:0}.quick-slot.filled img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.quick-slot.filled span{position:absolute;z-index:2;inset:auto 0 0;padding:4px;background:#000b;color:#fff1bd;font-size:8px;overflow:hidden;text-overflow:ellipsis}.tool-choice{min-width:96px!important}
 .studio-viewer{box-sizing:border-box;min-width:0;min-height:0;overflow:auto;background:#020609;padding:0}.studio-viewer-canvas{position:relative;height:100%;min-height:0;aspect-ratio:1/1;margin:0 auto;overflow:hidden;background:#03090d;touch-action:none}.studio-viewer-canvas>.table-workspace,.studio-viewer-canvas>.map-shell{width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;max-width:none!important;max-height:none!important;overflow:hidden!important}.studio-viewer-canvas .table-workspace{position:absolute!important;inset:0!important}.studio-viewer-canvas .table-workspace>.staging-tray,.studio-viewer-canvas .table-workspace>.tile-browser,.studio-viewer-canvas .table-workspace>.card-browser{display:none!important}.studio-viewer-canvas .map-shell{position:absolute!important;inset:0!important;display:block!important}.studio-viewer-canvas .map{position:absolute!important;inset:0!important;left:0!important;top:0!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;max-width:none!important;max-height:none!important;aspect-ratio:1/1!important;transform:none!important;margin:0!important}.studio-viewer-canvas .world-stage{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;aspect-ratio:1/1!important;transform:none!important}.studio-viewer-canvas .world-stage>.grid{display:none!important;background:none!important}.studio-viewer-canvas .base.ocean-world{background-size:calc(100% / 30) calc(100% / 30)!important;background-repeat:repeat!important;background-position:0 0!important}.studio-viewer-canvas .status,.studio-viewer-canvas .coordinate-system,.studio-viewer-canvas .grid-coordinates{display:none!important}.studio-viewer-grid{position:absolute;inset:0;z-index:30;pointer-events:none;background-image:linear-gradient(to right,rgba(215,199,145,.52) 1px,transparent 1px),linear-gradient(to bottom,rgba(215,199,145,.52) 1px,transparent 1px);background-size:calc(100% / 30) calc(100% / 30);background-position:0 0}.studio-viewer-grid.off{display:none}.studio-viewer-overlays{position:absolute;inset:0;z-index:40;pointer-events:none}.studio-viewer-overlays>*{pointer-events:auto}.studio-viewer-canvas .map-asset-filter-toggle,.studio-viewer-canvas .map-asset-filters{display:none!important}.studio-viewer-canvas .map-asset-toolbar{grid-template-columns:auto minmax(110px,1fr) auto 36px!important}
 .studio-command-slider{min-width:0;overflow:hidden;border-top:1px solid #715b2d;background:#0a1117;padding:6px}.studio-command-rail{height:100%;display:flex;align-items:center;gap:6px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}.studio-command-rail::-webkit-scrollbar{display:none}.studio-command-rail button{box-sizing:border-box;flex:0 0 auto;height:48px;min-width:104px;padding:4px 12px;display:grid;place-items:center;gap:2px;border:1px solid #4b5f69;border-radius:9px;background:#0d171e;color:#d4dde1;touch-action:manipulation}.studio-command-rail button strong{font:900 12px/1 system-ui;color:#f0ddb0}.studio-command-rail button small{font:800 7px/1 system-ui;letter-spacing:.06em;text-transform:uppercase;color:#8fa5b0}.studio-command-rail button.active{border-color:#d0aa56;background:#201b10}.studio-command-rail button.publish{border-color:#806a39}
 .studio-load-panel{position:absolute;left:10px;right:10px;bottom:10px;z-index:70;display:grid;gap:7px;padding:10px;border:1px solid #8d6a28;border-radius:12px;background:#071015f5;box-shadow:0 8px 28px #000b}.studio-load-panel header{display:flex;align-items:center;justify-content:space-between;color:#e1c77f}.studio-load-panel header button{width:32px;height:32px;border:1px solid #725d30;border-radius:7px;background:#111920;color:#e1c77f;font-size:20px}.studio-load-panel>button{min-height:48px;display:grid;gap:3px;text-align:left;padding:8px 10px;border:1px solid #4b5f69;border-radius:8px;background:#0d171e;color:#eee6d2}.studio-load-panel>button small{color:#8fa5b0}.studio-load-panel>button:disabled{opacity:.45}.studio-mini-panel{position:absolute;left:50%;bottom:10px;z-index:65;transform:translateX(-50%);display:flex;align-items:center;gap:8px;padding:8px;border:1px solid #8d6a28;border-radius:10px;background:#071015f5}.studio-mini-panel button{height:38px;border:1px solid #4b5f69;border-radius:7px;background:#0d171e;color:#e7d29a}.studio-mini-panel span{white-space:nowrap;font:800 10px/1 system-ui;color:#e7d29a}.studio-publish-banner{position:absolute;left:10px;right:10px;top:10px;z-index:65;padding:8px 10px;border:1px solid #8d6a28;border-radius:8px;background:#211c10ee;color:#f2dda3;font:800 9px/1.25 system-ui;text-align:center}
 @@media(min-aspect-ratio:1/1){.studio-viewer-canvas{height:100%;width:auto;min-width:100%;max-width:none}}
 @@media(max-aspect-ratio:1/1){.studio-viewer-canvas{width:100%;height:auto;min-height:100%;max-height:none}}
 @@media(max-width:760px){.worldbuilder-studio{height:100%;padding-bottom:34px;grid-template-rows:18px 58px minmax(0,1fr) 58px}.studio-header{grid-template-columns:24px minmax(0,1fr) 24px}.studio-context-strip button,.studio-context-strip>span{height:17px;line-height:17px;padding:0 5px;font-size:6.5px}.studio-top-slider button,.quick-slot{height:44px}.studio-viewer-canvas .map-asset-toolbar{grid-template-columns:auto minmax(90px,1fr) 34px 34px!important}.studio-command-slider{padding:5px}.studio-command-rail button{height:44px;min-width:94px;padding:4px 9px}}
</style>

@code{
 [Parameter] public EventCallback OnStartMenu { get; set; }
 static readonly string[] Modes={"Tiles","Cartography","Lightboard","Image","Draw"};
 const int QuickSlotCount=8;
 readonly List<AtlasTile> _quickTiles=[];
 ElementReference _viewerElement;
 IJSObjectReference? _zModule;
 IJSObjectReference? _zBinding;
 DotNetObjectReference<WorldBuilderStudio>? _self;
 string _toolMode="Tiles";
 bool _toolsOpen;
 bool _viewerGrid=true;
 bool _loadOpen;
 bool _layerOpen;
 bool _tierOpen;
 bool _publishMode;
 void SelectTool(string mode){_toolMode=mode;_toolsOpen=false;}
 void RemoveQuickTile(AtlasTile tile)=>_quickTiles.Remove(tile);
 Task OpenStartMenu()=>OnStartMenu.InvokeAsync();
 void ToggleLibrary()=>Session.ToggleTileBrowser();
 void OpenEdit(){_toolsOpen=true;_loadOpen=false;_layerOpen=false;_tierOpen=false;}
 void ToggleLayers(){_layerOpen=!_layerOpen;_tierOpen=false;_loadOpen=false;}
 void ToggleTiers(){_tierOpen=!_tierOpen;_layerOpen=false;_loadOpen=false;}
 void ToggleView()=>_viewerGrid=!_viewerGrid;
 void ToggleLoad(){_loadOpen=!_loadOpen;_layerOpen=false;_tierOpen=false;}
 void TogglePublish(){_publishMode=!_publishMode;_loadOpen=false;_layerOpen=false;_tierOpen=false;}
 async Task SaveAsync(){if(Session.IsLoggedIn)await Session.SaveRistAsync();else await Session.SaveAsync();}
 async Task LoadLocalAsync(){await Session.LoadAsync();_loadOpen=false;}
 async Task LoadPrivateAsync(){await Session.LoadPrivateCheckpointAsync();_loadOpen=false;}
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _self=DotNetObjectReference.Create(this);
  _zModule=await JS.InvokeAsync<IJSObjectReference>("import","./worldbuilder-z-axis.js");
  _zBinding=await _zModule.InvokeAsync<IJSObjectReference>("attach",_viewerElement,_self);
 }
 [JSInvokable] public Task StepZ(int delta){Session.MoveLayer(Math.Sign(delta));return InvokeAsync(StateHasChanged);}
 public async ValueTask DisposeAsync(){if(_zBinding is not null)try{await _zBinding.InvokeVoidAsync("dispose");}catch{} if(_zBinding is not null)await _zBinding.DisposeAsync();if(_zModule is not null)await _zModule.DisposeAsync();_self?.Dispose();}
}
