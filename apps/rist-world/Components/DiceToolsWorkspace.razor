@implements IDisposable
@inject WorldSession Session

<div class="rist dice-tools-workspace" aria-label="Dice and Tools">
 <header class="dice-tools-header">
  <div>
   <p>DICE &amp; TOOLS</p>
   <h1>Universal Toolbench</h1>
  </div>
  <span>NO WORLD REQUIRED</span>
 </header>

 <main class="dice-tools-main">
  <section class="dice-tools-summary" aria-label="Dice status">
   <article><small>ROLLS</small><strong>@Session.Rolls.Count</strong></article>
   <article><small>TOTAL</small><strong>@Session.Total</strong></article>
   <article><small>VISIBILITY</small><strong>@Session.RollVisibilityLabel</strong></article>
  </section>

  <section class="dice-tools-copy">
   <p class="eyebrow">GLOBAL RIST TOOLSET</p>
   <h2>Dice, cards and utility controls belong to the player session — not to a world.</h2>
   <p>A world may use these tools, but selecting or creating a world is never required to open them.</p>
   <div class="dice-tools-actions">
    <button type="button" @onclick="Session.OpenMixer">CHARACTER TOOLS</button>
    <button type="button" @onclick="Session.CycleRollVisibility">CHANGE VISIBILITY</button>
    <button type="button" @onclick="Session.ClearRollsWithHistory" disabled="@(Session.Rolls.Count==0)">CLEAR DICE</button>
   </div>
  </section>
 </main>

 <section class="release-footer-region dice-tools-dock" aria-label="Dice and card controls">
  <WorldFooter />
 </section>
</div>

<style>
 .dice-tools-workspace{box-sizing:border-box;height:100%;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr) 141px;overflow:hidden;background:#03080c;color:#e8dec5;font-family:Inter,system-ui,-apple-system,sans-serif}
 .dice-tools-header{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 16px;border-bottom:1px solid #725d30;background:linear-gradient(90deg,#0b151d,#151108)}
 .dice-tools-header p{margin:0;color:#86a8bd;font-size:9px;font-weight:900;letter-spacing:.18em}.dice-tools-header h1{margin:3px 0 0;color:#ecd48f;font:600 22px/1 Georgia,serif}.dice-tools-header>span{padding:6px 9px;border:1px solid #5c7180;border-radius:999px;background:#0d171e;color:#a9c4d4;font-size:8px;font-weight:900;letter-spacing:.1em;white-space:nowrap}
 .dice-tools-main{box-sizing:border-box;min-height:0;display:grid;grid-template-columns:minmax(0,1fr);align-content:start;gap:14px;padding:16px;overflow:auto;background:radial-gradient(circle at 50% 10%,#10202a 0,#071016 46%,#03080c 100%)}
 .dice-tools-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.dice-tools-summary article{display:grid;gap:5px;padding:12px;border:1px solid #405766;border-radius:10px;background:#0b151d}.dice-tools-summary small{color:#829aa8;font-size:8px;font-weight:900;letter-spacing:.12em}.dice-tools-summary strong{color:#f1d991;font-size:20px;overflow:hidden;text-overflow:ellipsis}
 .dice-tools-copy{max-width:760px;padding:16px;border:1px solid #4d5f68;border-radius:12px;background:#0a131a}.dice-tools-copy .eyebrow{margin:0;color:#87a7ba;font-size:8px;font-weight:900;letter-spacing:.14em}.dice-tools-copy h2{margin:7px 0 9px;color:#ead8a5;font:600 19px/1.3 Georgia,serif}.dice-tools-copy>p:last-of-type{margin:0;color:#9fadb5;font-size:11px;line-height:1.5}.dice-tools-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}.dice-tools-actions button{min-height:38px;padding:0 12px;border:1px solid #725d30;border-radius:8px;background:#101920;color:#e8d49a;font-size:9px;font-weight:900;letter-spacing:.06em;touch-action:manipulation}.dice-tools-actions button:disabled{opacity:.35}
 .dice-tools-dock{height:141px!important;min-height:141px!important;max-height:141px!important;overflow:hidden!important;border-top:1px solid #725d30!important}
 @@media(max-width:560px){.dice-tools-header{padding:10px 12px}.dice-tools-header h1{font-size:18px}.dice-tools-main{padding:11px}.dice-tools-summary{gap:5px}.dice-tools-summary article{padding:9px}.dice-tools-summary strong{font-size:17px}.dice-tools-copy{padding:12px}.dice-tools-copy h2{font-size:16px}}
</style>

@code {
 protected override async Task OnInitializedAsync()
 {
  Session.Changed+=SessionChanged;
  await Session.EnsureGlobalToolsAsync();
 }
 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose()=>Session.Changed-=SessionChanged;
}
