@implements IDisposable
@inject WorldSession Session

<div class="studio-coordinate-nav" aria-label="World coordinates and navigation">
 <span class="coordinate-readout" title="@Session.WorldCoordinateLabel"><small>COORD</small><strong>@Session.CubeX,@Session.CubeY,@Session.CubeZ</strong></span>
 <span class="axis-control" role="group" aria-label="X coordinate navigation"><button type="button" disabled="@(!Session.IsLoggedIn)" @onclick="()=>MoveCube(-1,0,0)" aria-label="Move X left">←</button><b>X</b><button type="button" disabled="@(!Session.IsLoggedIn)" @onclick="()=>MoveCube(1,0,0)" aria-label="Move X right">→</button></span>
 <span class="axis-control" role="group" aria-label="Y coordinate navigation"><button type="button" disabled="@(!Session.IsLoggedIn)" @onclick="()=>MoveCube(0,1,0)" aria-label="Move Y up">↑</button><b>Y</b><button type="button" disabled="@(!Session.IsLoggedIn)" @onclick="()=>MoveCube(0,-1,0)" aria-label="Move Y down">↓</button></span>
 <span class="axis-control" role="group" aria-label="Z coordinate navigation"><button type="button" disabled="@(!Session.IsLoggedIn)" @onclick="()=>MoveCube(0,0,1)" aria-label="Move Z up">↑</button><b>Z</b><button type="button" disabled="@(!Session.IsLoggedIn)" @onclick="()=>MoveCube(0,0,-1)" aria-label="Move Z down">↓</button></span>
 <span class="height-readout" title="Tier @Session.TierIndex · Layer @Session.LayerOffset · Scene Z @Session.SceneZ"><small>HEIGHT</small><strong>@HeightLabel</strong></span>
</div>

<style>
 .studio-coordinate-nav{box-sizing:border-box;width:100%;height:100%;min-width:0;display:flex;align-items:stretch;justify-content:center;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;background:#081017;color:#b9c5ca;font:800 9px/1 system-ui,-apple-system,sans-serif;white-space:nowrap;touch-action:pan-x}.studio-coordinate-nav::-webkit-scrollbar{display:none}.coordinate-readout,.height-readout,.axis-control{box-sizing:border-box;flex:0 0 auto;min-height:34px;border-left:1px solid #25353d;display:flex;align-items:center;justify-content:center}.coordinate-readout,.height-readout{display:grid;grid-template-rows:auto auto;place-content:center;gap:2px;text-align:center}.coordinate-readout small,.height-readout small{font:800 6px/1 system-ui;letter-spacing:.07em;color:#8197a2}.coordinate-readout strong,.height-readout strong{font:900 9px/1 system-ui}.coordinate-readout{min-width:94px;padding:0 8px;border-left:0;color:#e4c97d;letter-spacing:.035em}.height-readout{min-width:92px;padding:0 8px;color:#d6c188}.axis-control{min-width:74px}.axis-control b{width:18px;text-align:center;color:#9db4c0;font-size:9px}.axis-control button{appearance:none;-webkit-appearance:none;box-sizing:border-box;width:28px;min-width:28px;height:100%;min-height:34px;padding:0;border:0;background:transparent;color:#e7d49a;font:900 15px/1 system-ui;cursor:pointer;touch-action:manipulation}.axis-control button:active{background:#1b2830}.axis-control button:focus-visible{outline:2px solid #d9bd70;outline-offset:-2px}.axis-control button:disabled{opacity:.35;cursor:default}
 @@media(max-width:760px){.studio-coordinate-nav{display:grid;grid-template-columns:minmax(52px,1.1fr) repeat(3,minmax(0,.9fr)) minmax(54px,1.1fr);align-items:stretch;justify-content:stretch;overflow:hidden;touch-action:manipulation}.coordinate-readout,.height-readout{box-sizing:border-box;min-width:0;width:auto;padding:0 2px;overflow:hidden}.coordinate-readout small,.height-readout small{font-size:5px}.coordinate-readout strong,.height-readout strong{min-width:0;max-width:100%;overflow:hidden;text-overflow:clip;font-size:8px;letter-spacing:0}.axis-control{box-sizing:border-box;min-width:0;width:auto;display:grid;grid-template-columns:minmax(0,1fr) 12px minmax(0,1fr);align-items:stretch;overflow:hidden}.axis-control b{width:auto;min-width:0;display:grid;place-items:center;font-size:7px}.axis-control button{width:100%;min-width:0;height:100%;min-height:44px;padding:0;font-size:13px;line-height:1}.studio-header>.studio-home,.studio-header>.studio-profile{box-sizing:border-box;width:36px;height:36px;min-width:36px;place-self:center;border:1px solid #314752;border-radius:7px;font-size:15px;overflow:hidden}}
 @@media(max-width:340px){.studio-coordinate-nav{grid-template-columns:minmax(46px,1fr) repeat(3,minmax(0,.85fr)) minmax(48px,1fr)}.coordinate-readout small,.height-readout small{display:none}.coordinate-readout strong,.height-readout strong{font-size:7px}.axis-control b{font-size:6px}.axis-control button{font-size:12px}.studio-header>.studio-home,.studio-header>.studio-profile{width:34px;height:34px;min-width:34px}}
</style>

@code {
 string HeightLabel=>Session.SceneZ switch{0=>"SEA LEVEL",>0=>$"+{Session.SceneZ} ABOVE SEA",_=>$"{Math.Abs(Session.SceneZ)} BELOW SEA"};
 void MoveCube(int x,int y,int z)=>Session.SetWorldCube(checked(Session.CubeX+x),checked(Session.CubeY+y),checked(Session.CubeZ+z),Session.CubeRole);
 protected override void OnInitialized()=>Session.Changed+=Refresh;
 void Refresh()=>InvokeAsync(StateHasChanged);
 public void Dispose()=>Session.Changed-=Refresh;
}
