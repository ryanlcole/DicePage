@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<div class="local-definer-host"
     data-world-id="@Session.WorldId"
     data-region-id="@Session.ActiveRegion?.RegionId"
     aria-label="Local Definer">
 <iframe
  @ref="_frame"
  class="local-definer-frame"
  src="@BuilderSrc"
  title="Local Definer"
  loading="eager"
  allow="fullscreen"
 ></iframe>
</div>

<style>
 .local-definer-host{box-sizing:border-box;position:absolute;inset:0;z-index:2147481000;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden;background:#05090c;contain:layout size}
 .local-definer-frame{display:block;width:100%;height:100%;border:0;margin:0;padding:0;background:#05090c}
</style>

@code {
 ElementReference _frame;
 IJSObjectReference? _module;
 DotNetObjectReference<LocalDefinerWorkspace>? _self;
 bool _bridgeAttached;
 string _initialRegionId="";
 string _initialLocalId="";

 [Parameter] public EventCallback OnStartMenu { get; set; }
 [Parameter] public EventCallback OnHome { get; set; }

 WorldRegion? Region => Session.IsDefinedRegion(Session.ActiveRegion) ? Session.ActiveRegion : null;
 IReadOnlyList<WorldRegion> LocalRegions => Session.DefinedRegions
  .Where(Session.IsRegionInActiveWorld)
  .OrderBy(region=>region.Name,StringComparer.OrdinalIgnoreCase)
  .ToList();

 string BuilderSrc
 {
  get
  {
   var worldId=Uri.EscapeDataString(Session.WorldId??"");
   var worldName=Uri.EscapeDataString(Session.WorldDisplayName??"");
   var regionId=Uri.EscapeDataString(_initialRegionId);
   var localId=Uri.EscapeDataString(_initialLocalId);
   var seed=Session.IsGeonaphWorld?"geonaph":"empty";
   var initialRegion=FindLocalRegion(_initialRegionId);
   var access=(initialRegion is not null?Session.CanEditRegion(initialRegion):LocalRegions.Any(Session.CanEditRegion))?"edit":"view";
   var activeWorld=Session.ActiveMmoWorld;
   var surfacePixels=activeWorld?.PixelWidth>0
    ?activeWorld.PixelWidth
    :Session.SurfaceWorldPixelLimit??WorldSession.IncludedSurfaceWorldPixels;
   var maxHeight=activeWorld?.MaxHeight>0
    ?activeWorld.MaxHeight
    :Session.IsGeonaphWorld?WorldSession.MmoParcelMaxHeight:WorldSession.LayersPerTier;
   return $"/Game/prototype/index.html?live-worldbuilder=1&mode=localdefiner&worldId={worldId}&worldName={worldName}&seed={seed}&surfacePixels={surfacePixels}&maxHeight={maxHeight}&surfacePolicy=local-anchor&access={access}&regionFlow=existing&regionId={regionId}&localId={localId}&renderer=20260924-local-region-selector-v8";
  }
 }

 protected override async Task OnInitializedAsync()
 {
  try
  {
   if(Session.IsGeonaphWorld)await Session.RefreshMmoLandAsync();
   await Session.LoadRegionsAsync();
   await Session.LoadLocalsAsync();
   if(Session.ActiveLocal is { } local
      &&string.Equals(local.WorldId,Session.WorldId,StringComparison.Ordinal))
   {
    _initialLocalId=local.LocalId;
    _initialRegionId=local.RegionId;
    Session.SetActiveRegion(local.RegionId);
   }
   else
   {
    _initialLocalId="";
    _initialRegionId="";
   }
  }
  catch{}
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_bridgeAttached)return;
  _module=await JS.InvokeAsync<IJSObjectReference>("import","./region-definer-host.js?v=20260924-local-region-selector-v8");
  _self=DotNetObjectReference.Create(this);
  await _module.InvokeVoidAsync("attach",_frame,_self);
  _bridgeAttached=true;
  try{await _module.InvokeVoidAsync("refresh",_frame,_self);}catch{}
 }

 [JSInvokable]
 public async Task RequestHomeFromPrototypeAsync()
 {
  if(OnHome.HasDelegate)await OnHome.InvokeAsync();
 }

 WorldRegion? FindLocalRegion(string regionId)
 {
  regionId=(regionId??"").Trim();
  return LocalRegions.FirstOrDefault(region=>string.Equals(region.RegionId,regionId,StringComparison.Ordinal));
 }

 object DescribeRegion(WorldRegion region)=>new
 {
  id=region.RegionId,
  name=region.Name,
  tierIndex=region.TierIndex,
  minColumn=region.MinColumn,
  minRow=region.MinRow,
  maxColumn=region.MaxColumn,
  maxRow=region.MaxRow,
  selectedCells=region.SelectedCells,
  sourceLayerOffsets=region.SourceLayerOffsets,
  gridShape=region.GridShape,
  ownerUserId=region.OwnerUserId,
  updatedAtUtc=region.UpdatedAtUtc,
  canEdit=Session.CanEditRegion(region),
  localCount=Session.DefinedLocals.Count(local=>string.Equals(local.RegionId,region.RegionId,StringComparison.Ordinal))
 };

 async Task<object> RegionSourceEnvelopeAsync(WorldRegion region)
 {
  var source=await Session.LoadRegionSourceAsync(region.RegionId);
  return new
  {
   worldId=source?.WorldId??Session.WorldId,
   regionId=region.RegionId,
   worldName=Session.WorldDisplayName,
   state=source?.State,
   updatedAtUtc=source?.UpdatedAtUtc??"",
   activeRegionId=region.RegionId,
   source="database"
  };
 }

 [JSInvokable]
 public async Task<object> GetRegionSourceForPrototypeAsync(string regionId)
 {
  var region=FindLocalRegion(regionId)
   ??throw new InvalidOperationException("Choose a Region inside Local Definer.");
  Session.SetActiveRegion(region.RegionId);
  return await RegionSourceEnvelopeAsync(region);
 }

 [JSInvokable]
 public object GetRegionCatalogForPrototype()
  =>LocalRegions.Select(DescribeRegion).ToList();

 [JSInvokable]
 public async Task<object> OpenLocalRegionForPrototypeAsync(string regionId)
 {
  var region=FindLocalRegion(regionId)
   ??throw new InvalidOperationException("The selected Region is not available in this world.");
  Session.SetActiveRegion(region.RegionId);
  Session.SetActiveLocal("");
  var worldSource=await RegionSourceEnvelopeAsync(region);
  var locals=GetLocalCatalogForPrototype();
  return new
  {
   region=DescribeRegion(region),
   worldSource,
   locals,
   canEdit=Session.CanEditRegion(region)
  };
 }

 [JSInvokable]
 public object GetLocalCatalogForPrototype()
 {
  var regionId=Region?.RegionId??"";
  return Session.DefinedLocals
   .Where(local=>string.Equals(local.RegionId,regionId,StringComparison.Ordinal))
   .Select(local=>new
   {
    id=local.LocalId,
    name=local.Name,
    regionId=local.RegionId,
    anchorObjectId=local.AnchorObjectId,
    anchorAssetId=local.AnchorAssetId,
    anchorName=local.AnchorName,
    anchorKind=local.AnchorKind,
    x=local.X,
    y=local.Y,
    width=local.Width,
    height=local.Height,
    tier=local.Tier,
    layer=local.Layer,
    worldTier=local.WorldTier,
    worldLayer=local.WorldLayer,
    regionTier=local.RegionTier,
    regionLayer=local.RegionLayer,
    localTier=local.LocalTier,
    localLayer=local.LocalLayer,
    instanceTier=local.InstanceTier,
    instanceLayer=local.InstanceLayer,
    z100=local.Z100,
    rotation=local.Rotation,
    updatedAtUtc=local.UpdatedAtUtc
   }).ToList();
 }

 [JSInvokable]
 public async Task<object?> GetLocalSourceForPrototypeAsync(string localId)
 {
  localId=(localId??"").Trim();
  if(localId.Length==0)return null;
  var local=Session.DefinedLocals.FirstOrDefault(item=>string.Equals(item.LocalId,localId,StringComparison.Ordinal));
  if(local is null||!string.Equals(local.RegionId,Region?.RegionId,StringComparison.Ordinal))
   throw new InvalidOperationException("The requested Local does not belong to the active Region.");
  Session.SetActiveLocal(local.LocalId);
  var source=await Session.LoadLocalMapAsync(local.LocalId);
  return new
  {
   worldId=Session.WorldId,
   regionId=local.RegionId,
   localId=local.LocalId,
   anchorObjectId=local.AnchorObjectId,
   state=source?.State,
   updatedAtUtc=source?.UpdatedAtUtc.ToString("O")??"",
   source=source is null?"empty":"database"
  };
 }

 [JSInvokable]
 public async Task<object> SaveLocalMapLayersFromPrototypeAsync(string localId,System.Text.Json.JsonElement layers)
 {
  localId=(localId??"").Trim();
  var local=Session.DefinedLocals.FirstOrDefault(item=>string.Equals(item.LocalId,localId,StringComparison.Ordinal))
   ??throw new InvalidOperationException("Choose a Local before saving Local content.");
  if(!string.Equals(local.RegionId,Region?.RegionId,StringComparison.Ordinal))
   throw new InvalidOperationException("The Local parent Region does not match the active Region.");

  var userLayers=new List<System.Text.Json.JsonElement>();
  if(layers.ValueKind==System.Text.Json.JsonValueKind.Array)
  {
   foreach(var layer in layers.EnumerateArray())userLayers.Add(layer.Clone());
  }

  var state=System.Text.Json.JsonSerializer.SerializeToElement(new
  {
   format="RIST_LOCAL_MAP_V2",
   worldId=Session.WorldId,
   regionId=local.RegionId,
   localId=local.LocalId,
   coordinateSpace="canonical-world-xy+hierarchical-depth-v1",
   anchor=new
   {
    id=local.AnchorObjectId,
    assetId=local.AnchorAssetId,
    name=local.AnchorName,
    kind=local.AnchorKind,
    x=local.X,
    y=local.Y,
    width=local.Width,
    height=local.Height,
    worldTier=local.WorldTier,
    worldLayer=local.WorldLayer,
    regionTier=local.RegionTier,
    regionLayer=local.RegionLayer,
    rotation=local.Rotation,
    coordinateSpace="canonical-world-xy+region-depth-v1"
   },
   hierarchy=new
   {
    worldTier=local.WorldTier,
    worldLayer=local.WorldLayer,
    regionTier=local.RegionTier,
    regionLayer=local.RegionLayer,
    localTier=local.LocalTier,
    localLayer=local.LocalLayer,
    instanceTier=local.InstanceTier,
    instanceLayer=local.InstanceLayer
   },
   userLayers
  });
  var saved=await Session.SaveLocalMapAsync(local.LocalId,state);
  return new{success=true,localId=local.LocalId,savedLayerCount=userLayers.Count,updatedAtUtc=saved.UpdatedAtUtc.ToString("O")};
 }

 [JSInvokable]
 public async Task<object> CreateLocalFromPrototypeAsync(string name,System.Text.Json.JsonElement anchor)
 {
  var region=Region??throw new InvalidOperationException("Choose a Region before defining a Local.");
  string Text(string property,string fallback="")
   =>anchor.TryGetProperty(property,out var value)&&value.ValueKind==System.Text.Json.JsonValueKind.String
    ?value.GetString()??fallback:fallback;
  double Number(string property,double fallback=0)
   =>anchor.TryGetProperty(property,out var value)&&value.TryGetDouble(out var parsed)?parsed:fallback;
  int Integer(string property,int fallback=0)
   =>anchor.TryGetProperty(property,out var value)&&value.TryGetInt32(out var parsed)?parsed:fallback;

  var local=await Session.CreateLocalAsync(
   name,
   region.RegionId,
   Text("id"),
   Text("assetId"),
   Text("name"),
   Text("kind"),
   Number("x"),
   Number("y"),
   Number("width",.12),
   Number("height",.12),
   Integer("worldTier",Integer("tier")),
   Integer("worldLayer",Integer("layer")),
   Integer("regionLayer",1),
   Integer("z100"),
   Number("rotation"),
   regionTier:Integer("regionTier"),
   localTier:Integer("localTier"),
   localLayer:Integer("localLayer"),
   instanceTier:Integer("instanceTier"),
   instanceLayer:Integer("instanceLayer"));

  return new
  {
   id=local.LocalId,
   name=local.Name,
   regionId=local.RegionId,
   anchorObjectId=local.AnchorObjectId,
   anchorAssetId=local.AnchorAssetId,
   anchorName=local.AnchorName,
   anchorKind=local.AnchorKind,
   x=local.X,
   y=local.Y,
   width=local.Width,
   height=local.Height,
   tier=local.Tier,
   layer=local.Layer,
   worldTier=local.WorldTier,
   worldLayer=local.WorldLayer,
   regionTier=local.RegionTier,
   regionLayer=local.RegionLayer,
   localTier=local.LocalTier,
   localLayer=local.LocalLayer,
   instanceTier=local.InstanceTier,
   instanceLayer=local.InstanceLayer,
   z100=local.Z100,
   rotation=local.Rotation,
   updatedAtUtc=local.UpdatedAtUtc
  };
 }

 public async ValueTask DisposeAsync()
 {
  if(_module is not null)
  {
   try{await _module.InvokeVoidAsync("detach",_frame);}catch{}
   await _module.DisposeAsync();
  }
  _self?.Dispose();
 }
}
