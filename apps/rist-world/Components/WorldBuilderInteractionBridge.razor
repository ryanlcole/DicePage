@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<span class="worldbuilder-bridge-state" hidden
      data-tool="@Session.WorldBuilderTool"
      data-selected-tile="@Session.SelectedTile"
      data-base-tile="@Session.BaseTerrainOverrideTileId"
      data-map-locked="@Session.MapLocked.ToString().ToLowerInvariant()"></span>

@code {
    IJSObjectReference? _module;
    DotNetObjectReference<WorldBuilderInteractionBridge>? _self;
    bool _initialized;

    protected override void OnInitialized()
    {
        Session.Changed += SessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./worldbuilder-tools.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _self);
            _initialized = true;
        }

        if (_module is not null)
        {
            var tile = Session.BaseTerrainOverrideTile;
            if (tile is null)
                await _module.InvokeVoidAsync("syncBaseTerrain", null);
            else
                await _module.InvokeVoidAsync("syncBaseTerrain", new
                {
                    tile.Id,
                    tile.Image,
                    tile.SourceWidth,
                    tile.SourceHeight,
                    tile.CropX,
                    tile.CropY,
                    tile.CropWidth,
                    tile.CropHeight
                });
        }
    }

    void SessionChanged() => _ = InvokeAsync(StateHasChanged);

    [JSInvokable]
    public Task ApplyAt(double x, double y)
    {
        Session.ApplyWorldBuilderTool(x, y);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task ChooseTool(string tool)
    {
        Session.SetWorldBuilderTool(tool);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task ChooseTile(string name, string image)
    {
        var tile = Session.AtlasTiles.FirstOrDefault(x =>
            string.Equals(x.Name, name, StringComparison.Ordinal) &&
            (string.IsNullOrWhiteSpace(image) || string.Equals(x.Image, image, StringComparison.Ordinal)))
            ?? Session.AtlasTiles.FirstOrDefault(x => string.Equals(x.Name, name, StringComparison.Ordinal));
        if (tile is not null) Session.SelectWorldBuilderTile(tile);
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= SessionChanged;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach"); } catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
        }
        _self?.Dispose();
    }
}
