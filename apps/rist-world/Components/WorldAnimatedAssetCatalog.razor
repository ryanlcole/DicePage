@using System.Net.Http.Json
@inject WorldSession Session
@inject HttpClient Http

@code {
    protected override async Task OnInitializedAsync()
    {
        // A sprite is motion, not a second name for a static terrain image.
        // Retire the legacy prototype entries that labelled static Pangea art as sprites.
        Session.AtlasTiles.RemoveAll(asset =>
            asset.AssetKind.Equals("sprite", StringComparison.OrdinalIgnoreCase) &&
            (asset.FrameCount <= 1 || asset.FramesPerSecond <= 0));

        try
        {
            var catalog = await Http.GetFromJsonAsync<List<AtlasTile>>("assets/sprites/catalog.json?v=20260913-animated-assets-1");
            if (catalog is not null)
            {
                foreach (var asset in catalog.Where(asset =>
                    asset.AssetKind.Equals("sprite", StringComparison.OrdinalIgnoreCase) &&
                    asset.FrameCount > 1 && asset.FramesPerSecond > 0))
                {
                    var existing = Session.AtlasTiles.FindIndex(x => string.Equals(x.Id, asset.Id, StringComparison.Ordinal));
                    if (existing >= 0) Session.AtlasTiles[existing] = asset;
                    else Session.AtlasTiles.Add(asset);
                }
            }
        }
        catch
        {
            // Static assets remain available even if the animated catalog is unavailable.
        }

        Session.Notify();
    }
}
