@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<div class="region-definer-host"
     data-world-id="@Session.WorldId"
     data-world-name="@Session.WorldDisplayName"
     aria-label="Region Definer">
 <iframe
  @ref="_frame"
  class="region-definer-frame"
  src="@BuilderSrc"
  title="Region Definer"
  loading="eager"
  allow="fullscreen"
 ></iframe>
</div>

<style>
 .region-definer-host{
  position:fixed;
  inset:0;
  z-index:2147481000;
  width:100dvw;
  height:100dvh;
  min-width:0;
  min-height:0;
  overflow:hidden;
  background:#05090c;
 }
 .region-definer-frame{
  display:block;
  width:100%;
  height:100%;
  border:0;
  margin:0;
  padding:0;
  background:#05090c;
 }
</style>

@code {
 ElementReference _frame;
 IJSObjectReference? _module;
 DotNetObjectReference<RegionDefinerWorkspace>? _self;
 bool _bridgeAttached;

 [Parameter] public EventCallback OnStartMenu { get; set; }

 string BuilderSrc
 {
  get
  {
   var worldId=Uri.EscapeDataString(Session.WorldId??"");
   var worldName=Uri.EscapeDataString(Session.WorldDisplayName??"");
   // Region Definer is another viewer over the exact same world map as World Builder.
   // The seed chooses the shared base-map loader; database WORLDSOURCE adds the same
   // authored layers. Perspective/crop and permissions are the only differences.
   var seed=Session.IsGeonaphWorld?"geonaph":"empty";
   var activeRegion=Session.ActiveRegion;
   var surfacePixels=activeRegion?.ParcelPixelWidth>0
    ? activeRegion.ParcelPixelWidth
    : Session.SurfaceWorldPixelLimit ?? WorldSession.IncludedSurfaceWorldPixels;
   var maxHeight=activeRegion?.MaxHeight>0
    ? activeRegion.MaxHeight
    : Session.IsGeonaphWorld?WorldSession.MmoParcelMaxHeight:WorldSession.LayersPerTier;
   var surfacePolicy=!string.IsNullOrWhiteSpace(activeRegion?.ParcelId)
    ?"mmo-parcel"
    : Session.IsGeonaphWorld&&Session.HasPlatformCommercialOverride?"developer-controlled":"entitled";
   var access=(Session.HasTrustedWorldBuilderAuthority||Session.CanEditRegion(activeRegion))?"edit":Session.CanRequestWorldClaim?"claim":"view";
   var regionFlow=activeRegion is null?"new":"existing";
   var regionId=Uri.EscapeDataString(activeRegion?.RegionId??"");
   return $"/Game/prototype/index.html?live-worldbuilder=1&mode=regiondefiner&worldId={worldId}&worldName={worldName}&seed={seed}&surfacePixels={surfacePixels}&maxHeight={maxHeight}&surfacePolicy={surfacePolicy}&access={access}&regionFlow={regionFlow}&regionId={regionId}&renderer=20260918-region-layers-6";
  }
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_bridgeAttached)return;

  // Attach the canonical-map bridge before loading region/claim metadata.
  // Viewer rendering must never wait on permission metadata or MMO claim refresh.
  _module=await JS.InvokeAsync<IJSObjectReference>("import","./region-definer-host.js?v=20260918-region-layers-6");
  _self=DotNetObjectReference.Create(this);
  await _module.InvokeVoidAsync("attach",_frame,_self);
  _bridgeAttached=true;

  try
  {
   if(Session.IsGeonaphWorld)await Session.RefreshMmoLandAsync();
   await Session.LoadRegionsAsync();
   await _module.InvokeVoidAsync("refresh",_frame,_self);
  }
  catch
  {
   // The map stays visible; a later interaction can retry metadata loading.
  }
 }

 [JSInvokable]
 public async Task<object> GetWorldSourceForPrototype()
 {
  var databaseSource=await Session.LoadWorldBuilderSourceAsync();
  return new
  {
   worldId=Session.WorldId,
   worldName=Session.WorldDisplayName,
   gridColumns=WorldSession.GridColumns,
   gridRows=WorldSession.GridRows,
   gridStyle=Session.GridStyle,
   planeIndex=Session.PlaneIndex,
   source="database",
   updatedAtUtc=databaseSource?.UpdatedAtUtc??"",
   state=databaseSource?.State,
   activeRegionId=Session.ActiveRegion?.RegionId??"",
   parcelId=Session.ActiveRegion?.ParcelId??"",
   parcelPixelWidth=Session.ActiveRegion?.ParcelPixelWidth??0,
   parcelPixelHeight=Session.ActiveRegion?.ParcelPixelHeight??0,
   maxHeight=Session.ActiveRegion?.MaxHeight??0,
   canPromoteWorldSource=Session.HasTrustedWorldBuilderAuthority
  };
 }

 [JSInvokable]
 public async Task<object> SaveRegionMapLayersFromPrototypeAsync(string regionId,System.Text.Json.JsonElement userLayers)
 {
  var saved=await Session.SaveRegionMapLayersAsync(regionId,userLayers);
  return new
  {
   success=saved is not null,
   worldId=saved?.WorldId??Session.WorldId,
   regionId,
   updatedAtUtc=saved?.UpdatedAtUtc??""
  };
 }

 [JSInvokable]
 public async Task<object> PromoteWorldSourceFromPrototypeAsync(System.Text.Json.JsonElement state)
 {
  if(!Session.HasTrustedWorldBuilderAuthority)
   return new { success=false, worldId=Session.WorldId, updatedAtUtc="" };

  var saved=await Session.SaveWorldBuilderSourceAsync(state);
  return new
  {
   success=saved is not null,
   worldId=saved?.WorldId??Session.WorldId,
   updatedAtUtc=saved?.UpdatedAtUtc??""
  };
 }

 [JSInvokable]
 public object GetRegionCatalogForPrototype()
 {
  return Session.Regions.Select(region=>new
  {
   id=region.RegionId,
   name=region.Name,
   tierIndex=region.TierIndex,
   minColumn=region.MinColumn,
   minRow=region.MinRow,
   maxColumn=region.MaxColumn,
   maxRow=region.MaxRow,
   selectedCells=region.SelectedCells,
   sourceLayerOffsets=region.SourceLayerOffsets,
   gridShape=region.GridShape,
   ownerUserId=region.OwnerUserId,
   parcelId=region.ParcelId,
   parcelPixelWidth=region.ParcelPixelWidth,
   parcelPixelHeight=region.ParcelPixelHeight,
   maxHeight=region.MaxHeight,
   updatedAtUtc=region.UpdatedAtUtc
  }).ToList();
 }

 [JSInvokable]
 public async Task<object> SubmitRegionClaimRequestFromPrototypeAsync(string name,int[] cells,int tierIndex,int[] sourceLayerOffsets,string gridShape)
 {
  var result=await Session.SubmitWorldClaimRequestAsync(
   "regiondefiner",
   tierIndex,
   cells??Array.Empty<int>(),
   sourceLayerOffsets??Array.Empty<int>(),
   gridShape,
   requestedName:name);
  return new
  {
   success=result.Success,
   message=result.Message,
   requestId=result.Request?.RequestId??"",
   status=result.Request?.Status??""
  };
 }

 [JSInvokable]
 public async Task<object> CreateRegionFromPrototypeAsync(string name,int[] cells,int tierIndex,int[] sourceLayerOffsets,string gridShape)
 {
  var region=await Session.CreateRegionAsync(name,cells??Array.Empty<int>(),tierIndex,sourceLayerOffsets??Array.Empty<int>(),gridShape);
  return new
  {
   id=region.RegionId,
   name=region.Name,
   tierIndex=region.TierIndex,
   minColumn=region.MinColumn,
   minRow=region.MinRow,
   maxColumn=region.MaxColumn,
   maxRow=region.MaxRow,
   selectedCells=region.SelectedCells,
   sourceLayerOffsets=region.SourceLayerOffsets,
   gridShape=region.GridShape,
   updatedAtUtc=region.UpdatedAtUtc
  };
 }

 public async ValueTask DisposeAsync()
 {
  if(_module is not null)
  {
   try{await _module.InvokeVoidAsync("detach",_frame);}catch{}
   await _module.DisposeAsync();
  }
  _self?.Dispose();
 }
}
