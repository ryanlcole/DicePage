@using System.Globalization
@using System.Net.Http.Json
@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS
@inject HttpClient Http

<section class="region-definer" aria-label="Region Definer">
 <header class="region-definer-header">
  <button type="button" class="region-home" @onclick="OpenStartMenu" aria-label="Start menu">⌂</button>
  <span class="region-source-label"><small>SOURCE WORLD · LOCKED</small><strong>@(Session.HasActiveWorld?Session.WorldDisplayName:"NO WORLD SELECTED")</strong></span>
  <span class="region-angle-label">5° REGIONAL VIEW</span>
 </header>

 <section class="region-filter-rail" aria-label="Region filters and assets">
  <button type="button" class="region-filter-main" @onclick="()=>_filtersOpen=!_filtersOpen"><strong>@_filter</strong><small>Region Filter</small><span>More…</span></button>
  @if(_filtersOpen)
  {
   @foreach(var mode in FilterModes)
   {
    <button type="button" class="region-filter-choice @(_filter==mode?"active":"")" @onclick="()=>SelectFilter(mode)">@mode</button>
   }
  }
  else if(_filter=="Regions")
  {
   @if(Session.Regions.Count==0){<span class="region-empty-rail">No regions yet</span>}
   @foreach(var region in Session.Regions)
   {
    <button type="button" class="region-card @(Session.ActiveRegion?.RegionId==region.RegionId?"active":"")" @onclick="()=>SelectRegion(region)"><strong>@region.Name</strong><small>@region.Width×@region.Height world tiles</small></button>
   }
  }
  else
  {
   @foreach(var asset in VisibleAssets)
   {
    <button type="button" class="region-asset @(_armedAsset?.Id==asset.Id?"armed":"")" draggable="true" @ondragstart="()=>BeginAssetDrag(asset)" @ondragend="EndAssetDrag" @onclick="()=>ArmAsset(asset)" title="Tap, then tap the regional map; or drag onto the map"><img src="@asset.Image" alt="" draggable="false"/><span>@asset.Name</span></button>
   }
   @if(!VisibleAssets.Any()){<span class="region-empty-rail">No matching regional assets</span>}
  }
 </section>

 <main class="region-viewer" aria-label="Regional map viewer">
  @if(!Session.HasActiveWorld)
  {
   <div class="region-message"><strong>Choose a world first.</strong><span>RegionDefiner always derives from the selected world.</span></div>
  }
  else
  {
   <div class="region-view-plane" @ref="_dropSurface" @ondragover:preventDefault="true" @ondrop="DropAssetAsync" @onclick="PlaceArmedAssetAsync">
    @if(Session.ActiveRegion is null)
    {
     <div class="region-live-world region-live-full" aria-label="Non-editable selected world"><WorldMap /></div>
     <div class="region-select-grid" style="@SelectionGridStyle" aria-label="Select world tiles for a region">
      @for(var index=0;index<WorldSession.GridColumns*WorldSession.GridRows;index++)
      {
       var cell=index;
       <button type="button" class="@(_selectedCells.Contains(cell)?"selected":"")" @onclick="()=>ToggleWorldCell(cell)" @onclick:stopPropagation="true" aria-pressed="@_selectedCells.Contains(cell)" aria-label="World tile @(cell%WorldSession.GridColumns),@(cell/WorldSession.GridColumns)"></button>
      }
     </div>
     <div class="region-selection-note">SELECT WORLD TILES · @_selectedCells.Count SELECTED</div>
    }
    else
    {
     var region=Session.ActiveRegion;
     <div class="region-live-world region-live-crop" style="@WorldCropStyle(region)" aria-label="@region.Name source-world crop"><WorldMap /></div>
     <div class="region-grid" style="@RegionGridStyle(region)" aria-hidden="true"></div>
     <div class="region-mask" style="@RegionGridStyle(region)" aria-hidden="true">
      @for(var row=0;row<region.Height;row++)
      {
       @for(var column=0;column<region.Width;column++)
       {
        var original=(region.MinRow+row)*WorldSession.GridColumns+(region.MinColumn+column);
        if(!region.SelectedCells.Contains(original))
        {
         <span style="grid-column:@(column+1);grid-row:@(row+1)"></span>
        }
       }
      }
     </div>
     <div class="region-overlay-layer" aria-label="Editable regional tiles">
      @foreach(var tile in region.OverlayTiles)
      {
       <button type="button" class="region-overlay-tile" style="@OverlayStyle(tile,region)" @ondblclick="()=>RemoveOverlayAsync(tile)" @onclick:stopPropagation="true" title="@tile.Name · double click to remove"><span class="region-image-crop"><img src="@tile.Image" style="@CropStyle(tile.SourceWidth,tile.SourceHeight,tile.CropX,tile.CropY,tile.CropWidth,tile.CropHeight)" alt="@tile.Name" draggable="false"/></span></button>
      }
     </div>
     <div class="region-nameplate"><small>@Session.WorldDisplayName · NON-EDITABLE WORLD SOURCE</small><strong>@region.Name</strong><span>@region.Width×@region.Height world-tile crop · regional overlays editable</span></div>
    }
   </div>
  }
 </main>

 <section class="region-command-rail" aria-label="Region commands">
  @if(Session.ActiveRegion is null)
  {
   <button type="button" class="primary" disabled="@(_selectedCells.Count==0||!Session.HasActiveWorld)" @onclick="OpenNameDialog"><strong>Create Region</strong><small>Crop Selected Tiles</small></button>
   <button type="button" disabled="@(_selectedCells.Count==0)" @onclick="ClearSelection"><strong>Clear</strong><small>Selection</small></button>
  }
  else
  {
   <button type="button" class="primary" @onclick="BeginNewRegion"><strong>New Region</strong><small>Select World Tiles</small></button>
   <button type="button" @onclick="CycleFootprint"><strong>@_tileFootprint<sup>2</sup></strong><small>Regional Tile Size</small></button>
   <button type="button" @onclick="ShowRegions"><strong>Regions</strong><small>@Session.Regions.Count Saved</small></button>
   <button type="button" @onclick="SaveRegionsAsync"><strong>Save</strong><small>Region Definitions</small></button>
  }
  <span class="region-command-status">@StatusText</span>
 </section>

 @if(_nameDialogOpen)
 {
  <section class="region-name-backdrop" role="presentation" @onclick="CloseNameDialog">
   <div class="region-name-dialog" role="dialog" aria-modal="true" aria-label="Name region" @onclick:stopPropagation="true">
    <header><strong>CREATE REGION</strong><button type="button" @onclick="CloseNameDialog">×</button></header>
    <label>REGION NAME<input maxlength="80" @bind="_pendingRegionName" @bind:event="oninput" placeholder="Name this region" /></label>
    <p>@SelectionBoundsText</p>
    <button type="button" class="primary" disabled="@string.IsNullOrWhiteSpace(_pendingRegionName)" @onclick="CreateRegionAsync">CREATE REGION</button>
    <button type="button" @onclick="CloseNameDialog">CANCEL</button>
   </div>
  </section>
 }
</section>

<style>
 .region-definer{box-sizing:border-box;height:100%;min-height:0;width:100%;display:grid;grid-template-rows:30px 62px minmax(0,1fr) 62px;overflow:hidden;background:#03080c;color:#e8dec5;font-family:Inter,system-ui,-apple-system,sans-serif}.region-definer-header{display:grid;grid-template-columns:34px minmax(0,1fr) auto;align-items:stretch;border-bottom:1px solid #715b2d;background:#081017}.region-home{border:0;border-right:1px solid #715b2d;background:#0c151d;color:#e4c97d;font-size:15px}.region-source-label{min-width:0;display:grid;align-content:center;padding:0 9px}.region-source-label small{color:#7798aa;font-size:7px;font-weight:900;letter-spacing:.11em}.region-source-label strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#ead493;font:700 11px Georgia,serif}.region-angle-label{display:grid;place-items:center;padding:0 10px;border-left:1px solid #715b2d;color:#8fb2c7;font-size:7px;font-weight:900;letter-spacing:.1em}
