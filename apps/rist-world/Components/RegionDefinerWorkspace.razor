-grid button.selected{background:rgba(221,178,67,.34);box-shadow:inset 0 0 0 1px rgba(255,224,133,.9)}.region-grid{z-index:18;pointer-events:none;background-image:linear-gradient(to right,rgba(226,211,156,.40) 1px,transparent 1px),linear-gradient(to bottom,rgba(226,211,156,.40) 1px,transparent 1px);background-size:var(--region-cell-x) var(--region-cell-y)}.region-mask{z-index:19;pointer-events:none}.region-mask span{background:#020609e8}.region-selection-note{position:absolute;z-index:40;left:50%;top:8px;transform:translateX(-50%);padding:5px 9px;border:1px solid #816b3a;border-radius:999px;background:#071017dd;color:#f0d795;font-size:8px;font-weight:900;letter-spacing:.06em;pointer-events:none}.region-overlay-layer{position:absolute;inset:0;z-index:24;pointer-events:none}.region-overlay-tile{position:absolute;padding:0;border:1px solid transparent;background:transparent;overflow:hidden;pointer-events:auto}.region-overlay-tile:hover{border-color:#f0c55e}.region-image-crop{position:absolute;inset:0;overflow:hidden;display:block}.region-image-crop img{position:absolute;display:block}.region-nameplate{position:absolute;z-index:40;left:10px;bottom:10px;max-width:min(72%,430px);display:grid;gap:2px;padding:7px 10px;border:1px solid #735f35;border-radius:8px;background:#061017df;pointer-events:none}.region-nameplate small{color:#7898aa;font-size:6px;font-weight:900;letter-spacing:.1em}.region-nameplate strong{color:#f1d995;font:700 15px Georgia,serif}.region-nameplate span{color:#9aabb3;font-size:7px}.region-message{display:grid;place-items:center;gap:6px;text-align:center;color:#d8c383}.region-message span{color:#8398a3;font-size:10px}
 .region-command-rail{min-width:0;display:flex;align-items:center;gap:6px;padding:6px;border-top:1px solid #715b2d;background:#0a1117;overflow-x:auto}.region-command-rail button{box-sizing:border-box;flex:0 0 auto;height:48px;min-width:112px;padding:4px 12px;display:grid;place-items:center;gap:2px;border:1px solid #4b5f69;border-radius:9px;background:#0d171e;color:#d4dde1}.region-command-rail button.primary{border-color:#967b3d;background:#211b0f}.region-command-rail button strong{color:#f0ddb0;font-size:11px}.region-command-rail button small{color:#8fa5b0;font-size:7px;text-transform:uppercase}.region-command-rail button:disabled{opacity:.35}.region-command-status{min-width:180px;color:#c9b57d;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .region-name-backdrop{position:fixed;inset:20px 0 0;z-index:2147482600;display:grid;place-items:center;padding:16px;background:#020609d9;backdrop-filter:blur(5px)}.region-name-dialog{box-sizing:border-box;width:min(92vw,440px);display:grid;gap:12px;padding:16px;border:1px solid #8a6d32;border-radius:12px;background:#081117;color:#e8dec5;box-shadow:0 22px 70px #000d}.region-name-dialog header{display:flex;align-items:center;justify-content:space-between}.region-name-dialog header strong{color:#ecd48f;letter-spacing:.08em}.region-name-dialog header button{width:36px;height:36px;border:1px solid #52636c;border-radius:7px;background:#101a20;color:#e8dec5;font-size:22px}.region-name-dialog label{display:grid;gap:5px;color:#84a8bd;font-size:8px;font-weight:900;letter-spacing:.1em}.region-name-dialog input{height:44px;padding:0 10px;border:1px solid #596d76;border-radius:7px;background:#0d171e;color:#fff0bd;font-size:15px}.region-name-dialog p{margin:0;color:#93a5ad;font-size:9px}.region-name-dialog>button{min-height:44px;border:1px solid #536771;border-radius:7px;background:#0e1a21;color:#e7d39a;font-weight:900}.region-name-dialog>button.primary{border-color:#9b7a34;background:#261f10}
 @@media(max-width:760px){.region-definer{grid-template-rows:28px 58px minmax(0,1fr) 58px}.region-angle-label{display:none}.region-definer-header{grid-template-columns:32px minmax(0,1fr)}.region-filter-rail{padding:5px}.region-filter-rail button{height:44px}.region-command-rail{padding:5px}.region-command-rail button{height:44px;min-width:102px}.region-view-plane{width:calc(100% - 12px);height:calc(100% - 10px)}}
</style>

@code {
 static readonly string[] FilterModes=["Regions","Terrain","Water","Roads","Settlements","Landmarks","Borders","Uploads"];
 readonly HashSet<int> _selectedCells=[];
 bool _filtersOpen;
 bool _nameDialogOpen;
 string _filter="Regions";
 string _pendingRegionName="";
 string _status="Select world tiles, then create a region.";
 int _tileFootprint=1;
 AtlasTile? _draggingAsset;
 AtlasTile? _armedAsset;
 ElementReference _dropSurface;
 IJSObjectReference? _module;
 [Parameter] public EventCallback OnStartMenu{get;set;}

 string StatusText=>_armedAsset is not null&&Session.ActiveRegion is not null?$"{_armedAsset.Name} armed · tap the regional map to place":_status;
 string SelectionGridStyle=>$"grid-template-columns:repeat({WorldSession.GridColumns},minmax(0,1fr));grid-template-rows:repeat({WorldSession.GridRows},minmax(0,1fr))";
 string SelectionBoundsText
 {
  get
  {
   if(_selectedCells.Count==0)return "No world tiles selected.";
   var cols=_selectedCells.Select(x=>x%WorldSession.GridColumns);var rows=_selectedCells.Select(x=>x/WorldSession.GridColumns);
   return $"World crop: X {cols.Min()}–{cols.Max()} · Y {rows.Min()}–{rows.Max()} · {_selectedCells.Count} selected tile{(_selectedCells.Count==1?"":"s")}.";
  }
 }
 IEnumerable<AtlasTile> AllAssets=>Session.UserAssetTiles.Concat(Session.AtlasTiles).GroupBy(x=>x.Id,StringComparer.Ordinal).Select(x=>x.First());
 IReadOnlyList<AtlasTile> VisibleAssets=>AllAssets.Where(AssetMatchesFilter).Take(48).ToList();

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _module=await JS.InvokeAsync<IJSObjectReference>("import","./region-definer.js?v=20260910-region-1");
  await EnsureAssetsAsync();
  await Session.LoadRegionsAsync();
  await InvokeAsync(StateHasChanged);
 }
 async Task EnsureAssetsAsync()
 {
  if(Session.AtlasTiles.Any(x=>!x.Id.StartsWith("naeja-map-",StringComparison.OrdinalIgnoreCase)))return;
  try
  {
   var catalog=await Http.GetFromJsonAsync<List<AtlasTile>>("assets/drive-tiles/catalog.json?v=20260909-worldbuilder-atlas-4");
   if(catalog is null)return;
   foreach(var tile in catalog)if(Session.AtlasTiles.All(x=>!string.Equals(x.Id,tile.Id,StringComparison.Ordinal)))Session.AtlasTiles.Add(tile);
   Session.Notify();
  }
  catch{}
 }
 void OpenStartMenu()=>OnStartMenu.InvokeAsync();
 void SelectFilter(string mode){_filter=FilterModes.Contains(mode,StringComparer.Ordinal)?mode:"Regions";_filtersOpen=false;_armedAsset=null;}
 void ShowRegions()=>SelectFilter("Regions");
 void SelectRegion(WorldRegion region){Session.SetActiveRegion(region.RegionId);_filter="Regions";_selectedCells.Clear();_status=$"{region.Name} loaded. World source is locked; regional overlays are editable.";}
 void ToggleWorldCell(int cell){if(Session.ActiveRegion is not null)return;if(!_selectedCells.Add(cell))_selectedCells.Remove(cell);_status=$"{_selectedCells.Count} world tile{(_selectedCells.Count==1?"":"s")} selected.";}
 void ClearSelection(){_selectedCells.Clear();_status="Selection cleared.";}
 void OpenNameDialog(){if(_selectedCells.Count==0)return;_pendingRegionName="";_nameDialogOpen=true;}
 void CloseNameDialog()=>_nameDialogOpen=false;
 async Task CreateRegionAsync()
 {
  if(string.IsNullOrWhiteSpace(_pendingRegionName)||_selectedCells.Count==0)return;
  try
  {
   var region=await Session.CreateRegionAsync(_pendingRegionName,_selectedCells);
   _nameDialogOpen=false;_selectedCells.Clear();_filter="Terrain";_status=$"{region.Name} created from the selected world tiles. Add regional tiles on top.";
  }
  catch(Exception ex){_status=ex.Message;}
 }
 void BeginNewRegion(){_selectedCells.Clear();_armedAsset=null;_filter="Regions";Session.SetActiveRegion("");_status="Select world tiles, then create a region.";}
 void CycleFootprint()=>_tileFootprint=_tileFootprint switch{1=>2,2=>4,4=>8,8=>16,_=>1};
 void BeginAssetDrag(AtlasTile asset){_draggingAsset=asset;_armedAsset=asset;}
 void EndAssetDrag()=>_draggingAsset=null;
 void ArmAsset(AtlasTile asset){_armedAsset=asset;_status=$"{asset.Name} armed. Tap the regional map to place it.";}
 async Task DropAssetAsync(DragEventArgs e)
 {
  var asset=_draggingAsset??_armedAsset;_draggingAsset=null;
  if(asset is null)return;
  await PlaceAssetAtAsync(asset,e.ClientX,e.ClientY);
 }
 async Task PlaceArmedAssetAsync(MouseEventArgs e)
 {
  if(_armedAsset is null||Session.ActiveRegion is null)return;
  await PlaceAssetAtAsync(_armedAsset,e.ClientX,e.ClientY);
 }
 async Task PlaceAssetAtAsync(AtlasTile asset,double clientX,double clientY)
 {
  var region=Session.ActiveRegion;if(region is null||_module is null)return;
  try
  {
   var point=await _module.InvokeAsync<double[]>("point",_dropSurface,clientX,clientY);
   if(point.Length<2)return;
   var placed=await Session.AddRegionOverlayTileAsync(region.RegionId,asset,point[0],point[1],_tileFootprint);
   _status=placed?$"{asset.Name} placed on {region.Name}.":"That footprint crosses outside the selected world tiles.";
  }
  catch{_status="The regional placement point could not be resolved.";}
 }
 async Task RemoveOverlayAsync(RegionOverlayTile tile){var region=Session.ActiveRegion;if(region is null)return;await Session.RemoveRegionOverlayTileAsync(region.RegionId,tile.Id);_status=$"{tile.Name} removed from {region.Name}.";}
 async Task SaveRegionsAsync(){try{await Session.SaveRegionsAsync();_status="Regions saved.";}catch(Exception ex){_status="Region save failed: "+ex.Message;}}

 bool AssetMatchesFilter(AtlasTile asset)
 {
  if(_filter=="Uploads")return asset.Id.StartsWith("private:",StringComparison.Ordinal);
  if(asset.Id.StartsWith("private:",StringComparison.Ordinal))return false;
  var text=$"{asset.Directory} {asset.Folder} {asset.Name}".ToLowerInvariant();
  return _filter switch
  {
   "Terrain"=>text.Contains("terrain")||text.Contains("forest")||text.Contains("mountain")||text.Contains("hill")||text.Contains("plains")||text.Contains("grass")||text.Contains("desert")||text.Contains("snow")||text.Contains("ice"),
   "Water"=>text.Contains("water")||text.Contains("ocean")||text.Contains("sea")||text.Contains("river")||text.Contains("lake")||text.Contains("coast")||text.Contains("shore")||text.Contains("swamp"),
   "Roads"=>text.Contains("road")||text.Contains("path")||text.Contains("bridge")||text.Contains("rail")||text.Contains("track"),
   "Settlements"=>text.Contains("city")||text.Contains("town")||text.Contains("village")||text.Contains("building")||text.Contains("farm")||text.Contains("house"),
   "Landmarks"=>text.Contains("landmark")||text.Contains("ruin")||text.Contains("tower")||text.Contains("castle")||text.Contains("shrine")||text.Contains("monument"),
   "Borders"=>text.Contains("border")||text.Contains("wall")||text.Contains("fence")||text.Contains("gate")||text.Contains("boundary"),
   _=>false
  };
 }
 static string WorldCropStyle(WorldRegion region)
 {
  var inv=CultureInfo.InvariantCulture;
  var width=3000.0/region.Width;var height=3000.0/region.Height;
  var left=-100.0*region.MinColumn/region.Width;var top=-100.0*region.MinRow/region.Height;
  return $"width:{width.ToString("0.###",inv)}%;height:{height.ToString("0.###",inv)}%;left:{left.ToString("0.###",inv)}%;top:{top.ToString("0.###",inv)}%";
 }
 static string RegionGridStyle(WorldRegion region)
 {
  var inv=CultureInfo.InvariantCulture;
  return $"grid-template-columns:repeat({region.Width},minmax(0,1fr));grid-template-rows:repeat({region.Height},minmax(0,1fr));--region-cell-x:{(100.0/region.Width).ToString("0.###",inv)}%;--region-cell-y:{(100.0/region.Height).ToString("0.###",inv)}%";
 }
 static string OverlayStyle(RegionOverlayTile tile,WorldRegion region)
 {
  var inv=CultureInfo.InvariantCulture;
  return $"left:{(tile.X*100).ToString("0.###",inv)}%;top:{(tile.Y*100).ToString("0.###",inv)}%;width:{(tile.Footprint*100.0/region.Width).ToString("0.###",inv)}%;height:{(tile.Footprint*100.0/region.Height).ToString("0.###",inv)}%";
 }
 static string CropStyle(int sourceWidth,int sourceHeight,int cropX,int cropY,int cropWidth,int cropHeight)
 {
  if(sourceWidth<=0||sourceHeight<=0||cropWidth<=0||cropHeight<=0)return "width:100%;height:100%;object-fit:cover";
  var inv=CultureInfo.InvariantCulture;
  return $"width:{(sourceWidth*100.0/cropWidth).ToString("0.###",inv)}%;height:{(sourceHeight*100.0/cropHeight).ToString("0.###",inv)}%;left:{(-cropX*100.0/cropWidth).ToString("0.###",inv)}%;top:{(-cropY*100.0/cropHeight).ToString("0.###",inv)}%;max-width:none;max-height:none";
 }
 public async ValueTask DisposeAsync(){if(_module is not null)await _module.DisposeAsync();}
}
