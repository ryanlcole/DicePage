@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<div class="region-definer-host"
     data-world-id="@Session.WorldId"
     data-world-name="@Session.WorldDisplayName"
     aria-label="Region Definer">
 <iframe
  @ref="_frame"
  class="region-definer-frame"
  src="@BuilderSrc"
  title="Region Definer"
  loading="eager"
  allow="fullscreen"
 ></iframe>
</div>

<style>
 .region-definer-host{
  position:fixed;
  inset:0;
  z-index:2147481000;
  width:100dvw;
  height:100dvh;
  min-width:0;
  min-height:0;
  overflow:hidden;
  background:#05090c;
 }
 .region-definer-frame{
  display:block;
  width:100%;
  height:100%;
  border:0;
  margin:0;
  padding:0;
  background:#05090c;
 }
</style>

@code {
 ElementReference _frame;
 IJSObjectReference? _module;
 bool _bridgeAttached;

 [Parameter] public EventCallback OnStartMenu { get; set; }

 string BuilderSrc
 {
  get
  {
   var worldId=Uri.EscapeDataString(Session.WorldId??"");
   var worldName=Uri.EscapeDataString(Session.WorldDisplayName??"");
   var seed=Session.IsGeonaphWorld?"geonaph":"empty";
   var surfacePixels=Session.SurfaceWorldPixelLimit ?? WorldSession.IncludedSurfaceWorldPixels;
   var surfacePolicy=Session.IsGeonaphWorld&&Session.HasPlatformCommercialOverride?"developer-controlled":"entitled";
   var access=Session.HasTrustedWorldBuilderAuthority?"edit":"view";
   return $"/Game/prototype/index.html?live-worldbuilder=1&mode=regiondefiner&worldId={worldId}&worldName={worldName}&seed={seed}&surfacePixels={surfacePixels}&surfacePolicy={surfacePolicy}&access={access}";
  }
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_bridgeAttached)return;
  await Session.LoadRegionsAsync();
  _module=await JS.InvokeAsync<IJSObjectReference>("import","./region-definer-host.js?v=20260918-region-copy-1");
  await _module.InvokeVoidAsync("attach",_frame,DotNetObjectReference.Create(this));
  _bridgeAttached=true;
 }

 [JSInvokable]
 public object GetRegionCatalogForPrototype()
 {
  return Session.Regions.Select(region=>new
  {
   id=region.RegionId,
   name=region.Name,
   tierIndex=region.TierIndex,
   minColumn=region.MinColumn,
   minRow=region.MinRow,
   maxColumn=region.MaxColumn,
   maxRow=region.MaxRow,
   selectedCells=region.SelectedCells,
   updatedAtUtc=region.UpdatedAtUtc
  }).ToList();
 }

 [JSInvokable]
 public async Task<object> CreateRegionFromPrototypeAsync(string name,int[] cells,int tierIndex)
 {
  var region=await Session.CreateRegionAsync(name,cells??[],tierIndex);
  return new
  {
   id=region.RegionId,
   name=region.Name,
   tierIndex=region.TierIndex,
   minColumn=region.MinColumn,
   minRow=region.MinRow,
   maxColumn=region.MaxColumn,
   maxRow=region.MaxRow,
   selectedCells=region.SelectedCells,
   updatedAtUtc=region.UpdatedAtUtc
  };
 }

 public async ValueTask DisposeAsync()
 {
  if(_module is not null)
  {
   try{await _module.InvokeVoidAsync("detach",_frame);}catch{}
   await _module.DisposeAsync();
  }
 }
}
