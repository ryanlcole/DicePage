@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorldSession Session

<div class="character-card-designer" @ref="_root" aria-label="Character Card Designer">
 <header class="ccd-header">
  <div>
   <small>@(IsGameMaster?"GAMEMASTER · REQUIRED CHARACTER TEMPLATE":"ROLEPLAY · CHARACTER CARD LAYOUT")</small>
   <h2>CHARACTER CARD DESIGNER</h2>
   <p>@(IsGameMaster?"Choose required fields and name them. Players may arrange them, but cannot remove or redefine them.":"Arrange your character cards and optional fields. GM-required fields remain mandatory.")</p>
  </div>
  <div class="ccd-actions">
   <button type="button" @onclick="AddCard">+ CARD</button>
   <button type="button" @onclick="SaveAsync">@(_saved?"SAVED":"SAVE")</button>
  </div>
 </header>

 <div class="ccd-workspace">
  <aside class="ccd-library" aria-label="Character asset library">
   <strong>CHARACTER ASSETS</strong>
   @if(IsGameMaster)
   {
    <section class="ccd-requirements" aria-label="GameMaster required character fields">
     <header><b>REQUIRED FIELDS</b><small>CHECK → NAME → PLAYER MUST KEEP</small></header>
     @foreach(var option in Catalog)
     {
      var enabled=IsRequirementEnabled(option);
      <div class="ccd-requirement-row">
       <input type="checkbox"
              checked="@enabled"
              @onchange="e=>ToggleRequirement(option,e)"
              aria-label="Require @option.Name" />
       <span>@FriendlyKind(option.Kind)</span>
       <input type="text"
              maxlength="64"
              disabled="@(!enabled)"
              value="@RequirementName(option)"
              @onchange="e=>RenameRequirement(option,e)"
              aria-label="Required field name for @option.Name" />
      </div>
     }
    </section>
   }
   <label class="ccd-search">
    <span>SEARCH FOR A FIELD</span>
    <input value="@_search" @oninput="SearchChanged" placeholder="Strength, health, equipment, language…" autocomplete="off" />
   </label>
   <div class="ccd-search-results">
    @foreach(var option in SearchResults)
    {
     <button type="button" @onclick="()=>BeginField(option)"><b>@option.Name</b><small>@option.Group · @FriendlyKind(option.Kind)</small></button>
    }
   </div>
   <button type="button" class="ccd-custom-field" @onclick="BeginCustomField">+ CUSTOM FIELD</button>

   <div class="ccd-deck-heading"><span>CARDS</span><small>@_cards.Count</small></div>
   <div class="ccd-deck">
    @for(var i=0;i<_cards.Count;i++)
    {
     var index=i;
     <button type="button" class="@(index==_selectedCard?"selected":"")" @onclick="()=>SelectCard(index)">
      <span>@(index+1)</span><b>@_cards[index].Title</b><small>@_cards[index].Fields.Count field@(_cards[index].Fields.Count==1?"":"s")</small>
     </button>
    }
   </div>
  </aside>

  <main class="ccd-preview-area">
   @if(SelectedCard is { } card)
   {
    <section class="ccd-card-canvas" style="@PreviewStyle" data-ccd-card aria-label="@card.Title character card">
     <header class="ccd-card-title">
      <small>@(IsGameMaster?"GM TEMPLATE CARD":"CHARACTER CARD") · @(_selectedCard+1) / @_cards.Count</small>
      <input maxlength="48" value="@card.Title" @oninput="RenameCard" aria-label="Card title" />
     </header>
     <div class="ccd-field-surface">
      @foreach(var field in card.Fields)
      {
       var value=ValueFor(field.Id);
       <article class="ccd-field-node @AssetClass(field) @(field.Id==_selectedFieldId?"selected":"")"
                data-ccd-field="@field.Id"
                data-x="@field.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                data-y="@field.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                data-w="@field.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                data-h="@field.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                style="@FieldStyle(field)"
                @onclick="()=>SelectField(field.Id)">
        @if(!string.IsNullOrWhiteSpace(field.AssetDataUrl))
        {
         <img src="@field.AssetDataUrl" alt="" draggable="false" />
        }
        <div class="ccd-field-content">
         <small>@field.Name</small>
         @if(field.Required){<em>REQUIRED</em>}
         <strong>@DisplayValue(field,value)</strong>
        </div>
        @if(field.Id==_selectedFieldId)
        {
         <button type="button" class="ccd-resize-handle nw" data-ccd-resize="nw" aria-label="Resize from top left"></button>
         <button type="button" class="ccd-resize-handle ne" data-ccd-resize="ne" aria-label="Resize from top right"></button>
         <button type="button" class="ccd-resize-handle sw" data-ccd-resize="sw" aria-label="Resize from bottom left"></button>
         <button type="button" class="ccd-resize-handle se" data-ccd-resize="se" aria-label="Resize from bottom right"></button>
        }
       </article>
      }
     </div>
    </section>
   }
  </main>

  <aside class="ccd-inspector" aria-label="Selected character field">
   <label>
    <span>SELECT · CHARACTER FIELDS</span>
    <select value="@_selectedFieldId" @onchange="SelectFieldChanged">
     <option value="">Select field…</option>
     @if(SelectedCard is { } selectedCard)
     {
      @foreach(var field in selectedCard.Fields)
      {
       <option value="@field.Id">@field.Name · @FriendlyKind(field.Kind)</option>
      }
     }
    </select>
   </label>

   @if(SelectedField is { } selected)
   {
    <div class="ccd-selected-summary">
     <b>@selected.Name</b><small>@FriendlyKind(selected.Kind) · @selected.AssetName</small>
     <span>GM REQUIRED</span>
    </div>

    <div class="ccd-step-grid">
     <button type="button" @onclick="()=>NudgeSize(-1)">SIZE −</button>
     <button type="button" @onclick="()=>NudgeSize(1)">SIZE +</button>
    </div>

    <div class="ccd-number-grid">
     <label><span>X %</span><input type="number" min="0" max="100" step="0.1" value="@F(selected.X)" @onchange="e=>SetNumber(e,0)" /></label>
     <label><span>Y %</span><input type="number" min="0" max="100" step="0.1" value="@F(selected.Y)" @onchange="e=>SetNumber(e,1)" /></label>
     <label><span>WIDTH %</span><input type="number" min="5" max="100" step="0.1" value="@F(selected.Width)" @onchange="e=>SetNumber(e,2)" /></label>
     <label><span>HEIGHT %</span><input type="number" min="5" max="100" step="0.1" value="@F(selected.Height)" @onchange="e=>SetNumber(e,3)" /></label>
    </div>

    <label>
     <span>FINE WIDTH</span>
     <input type="range" min="5" max="100" step="0.1" value="@F(selected.Width)" @oninput="SetWidthRange" />
    </label>
    <label>
     <span>FINE HEIGHT</span>
     <input type="range" min="5" max="100" step="0.1" value="@F(selected.Height)" @oninput="SetHeightRange" />
    </label>

    <section class="ccd-runtime-preview">
     <strong>CHARACTER VALUE · SEPARATE FROM GRAPHIC</strong>
     @RenderRuntimeEditor(selected)
    </section>

    <section class="ccd-modifier-editor">
     <header><b>JOINED EFFECTS</b><small>@selected.Modifiers.Count</small></header>
     <p>Link this field to a shared GM field and apply its difference without changing either graphic.</p>

     @if(_requirements.Count>0)
     {
      <div class="ccd-modifier-grid">
       <label><span>TARGET JOIN</span><select @bind="_modifierTargetJoin"><option value="">Choose…</option>@foreach(var rule in _requirements){<option value="@rule.SharedJoin">@rule.Name</option>}</select></label>
       <label><span>APPLY TO</span><select @bind="_modifierTargetSlot"><option value="CURRENT">Current</option><option value="BASE">Base</option><option value="MAX">Max</option></select></label>
       <label><span>OPERATION</span><select @bind="_modifierOperation"><option value="ADD">+ Add</option><option value="SUBTRACT">− Subtract</option><option value="MULTIPLY">× Multiply</option><option value="SET">= Set</option></select></label>
       <label><span>AMOUNT</span><input type="number" step="0.1" @bind="_modifierAmount" /></label>
      </div>
      <button type="button" class="ccd-add-modifier" disabled="@string.IsNullOrWhiteSpace(_modifierTargetJoin)" @onclick="AddModifier">+ ADD JOIN</button>
     }
     else
     {
      <small>No shared GM fields exist yet. The GM must check and name required fields first.</small>
     }

     @foreach(var modifier in selected.Modifiers)
     {
      <div class="ccd-modifier-row">
       <span><b>@DisplayJoin(modifier.TargetJoin)</b><small>@ModifierLabel(modifier)</small></span>
       <button type="button" @onclick="()=>RemoveModifier(modifier.Id)" aria-label="Remove modifier">×</button>
      </div>
     }

     @if(selected.Modifiers.Count>0)
     {
      <label class="ccd-activation-check">
       <input type="checkbox" checked="@selected.RequiresActivation" @onchange="e=>SetRequiresActivation(selected,e)" />
       <span>Requires activation</span>
      </label>

      @if(selected.RequiresActivation)
      {
       var state=ValueFor(selected.Id);
       <div class="ccd-activation-grid">
        <button type="button" class="@(state.Active?"active":"")" @onclick="()=>ToggleFieldActivation(selected)">@((state.Active?"ACTIVE · TURN OFF":"INACTIVE · ACTIVATE"))</button>
        <label><span>DURATION</span><input type="number" min="0" step="1" value="@selected.Duration" @onchange="e=>SetDuration(selected,e)" /></label>
        <label><span>UNIT</span><select value="@selected.DurationUnit" @onchange="e=>SetDurationUnit(selected,e)"><option>Rounds</option><option>Turns</option><option>Minutes</option><option>Hours</option><option>Scenes</option><option>Until Rest</option></select></label>
        <label><span>REMAINING</span><input type="number" min="0" step="1" value="@state.RemainingDuration" @onchange="e=>SetRemainingDuration(selected,e)" /></label>
       </div>
      }
     }
    </section>

    <button type="button" class="ccd-delete" disabled="@IsProtectedRequired(selected)" @onclick="DeleteSelectedField">@(IsProtectedRequired(selected)?"GM REQUIRED · CANNOT DELETE":"DELETE FIELD")</button>
   }
   else
   {
    <p class="ccd-help">Search for a character field, choose its type and matching asset, enter its initial value, then Save & Place.</p>
   }

   <label>
    <span>CARD SIZE</span>
    <select value="@_cardSize" @onchange="ChangeCardSize">
     <option value="poker">Poker · 2.5 × 3.5</option>
     <option value="tarot">Tarot · 2.75 × 4.75</option>
     <option value="index">Index · 3 × 5</option>
    </select>
   </label>
  </aside>
 </div>

 @if(_wizardOpen)
 {
  <div class="ccd-modal-backdrop" @onclick="CloseWizard">
   <section class="ccd-field-wizard" role="dialog" aria-modal="true" aria-label="Add character field" @onclick:stopPropagation="true">
    <header><div><small>SEARCH → TYPE → ASSET → VALUE → PLACE</small><strong>@_wizardName</strong></div><button type="button" @onclick="CloseWizard" aria-label="Close">×</button></header>

    <label>
     <span>FIELD NAME</span>
     <input maxlength="64" @bind="_wizardName" />
    </label>

    <fieldset>
     <legend>FIELD TYPE</legend>
     <div class="ccd-type-grid">
      @foreach(var type in FieldTypes)
      {
       <button type="button" class="@(type.Kind==_wizardKind?"selected":"")" @onclick="()=>ChooseType(type)"><b>@type.Label</b><small>@type.Group</small></button>
      }
     </div>
    </fieldset>

    <fieldset>
     <legend>MATCHING CHARACTER ASSET</legend>
     <div class="ccd-asset-grid">
      @foreach(var asset in MatchingAssets)
      {
       <button type="button" class="ccd-asset-choice @asset.CssClass @(asset.Id==_wizardAssetId?"selected":"")" @onclick="()=>ChooseAsset(asset)"><span></span><b>@asset.Label</b></button>
      }
      <label class="ccd-upload-asset"><span>CREATE YOUR OWN</span><InputFile OnChange="LoadWizardAsset" accept="image/png,image/jpeg,image/webp" /></label>
     </div>
     @if(!string.IsNullOrWhiteSpace(_wizardAssetDataUrl))
     {
      <div class="ccd-custom-preview"><img src="@_wizardAssetDataUrl" alt="Custom field asset preview" /></div>
     }
    </fieldset>

    <fieldset>
     <legend>INITIAL CHARACTER VALUE</legend>
     <div class="ccd-value-grid">
      @if(_wizardKind=="ATTRIBUTE")
      {
       <label><span>BASE</span><input type="number" @bind="_wizardBase" /></label>
       <label><span>CURRENT</span><input type="number" @bind="_wizardCurrent" /></label>
       <label><span>MAX</span><input type="number" @bind="_wizardMax" /></label>
      }
      else if(_wizardKind is "TRACKER" or "LIMIT" or "VALUE")
      {
       <label><span>CURRENT</span><input type="number" @bind="_wizardCurrent" /></label>
       <label><span>MAX</span><input type="number" @bind="_wizardMax" /></label>
      }
      else if(_wizardKind=="LANGUAGE")
      {
       <label><span>PROFICIENCY %</span><input type="number" min="0" max="100" @bind="_wizardProficiency" /></label>
      }
      else if(_wizardKind=="PORTRAIT")
      {
       <span class="ccd-value-note">Portrait value is supplied by the character. The frame graphic remains GM-defined.</span>
      }
      else
      {
       <label class="wide"><span>VALUE / TEXT</span><textarea rows="3" @bind="_wizardText"></textarea></label>
      }
     </div>
    </fieldset>

    <footer><button type="button" @onclick="CloseWizard">CANCEL</button><button type="button" class="primary" disabled="@(!CanPlaceWizard)" @onclick="SaveAndPlace">SAVE &amp; PLACE</button></footer>
   </section>
  </div>
 }
</div>

