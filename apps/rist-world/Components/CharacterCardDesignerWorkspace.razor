 string _modifierTargetJoin="",_modifierTargetSlot="CURRENT",_modifierOperation="ADD";
 double _modifierAmount=1;
 int _wizardBase=10,_wizardCurrent,_wizardMax=10,_wizardProficiency=100;

 static readonly FieldOption[] Catalog=[
  new("Name","TEXT","Identity"),new("Portrait","PORTRAIT","Identity"),new("Concept","TEXT","Identity"),
  new("Attribute","ATTRIBUTE","Attributes"),new("Health","TRACKER","Trackers"),new("Resource","TRACKER","Trackers"),
  new("Limit","LIMIT","Limits"),new("Skill","VALUE","Skills"),new("Ability","FLARE","Flare"),new("Feat","FLARE","Feats"),
  new("Description","LONGTEXT","Profile"),new("Background","LONGTEXT","Profile"),new("Equipment","EQUIPMENT","Equipment"),
  new("Inventory","EQUIPMENT","Equipment"),new("Anatomy","LONGTEXT","Equipment"),new("Conditions","CONDITIONS","Status"),
  new("Language","LANGUAGE","Languages"),new("Notes","LONGTEXT","Notes"),new("Linked Reference","LINKED","Linked"),new("Dice Bag","DICE","Dice")
 ];
 static readonly FieldTypeOption[] FieldTypes=[
  new("ATTRIBUTE","Attribute","Attributes"),new("TRACKER","Tracker / Pool","Trackers"),new("LIMIT","Limit","Limits"),new("VALUE","Skill / Value","Skills"),
  new("FLARE","Flare / Ability","Flare"),new("TEXT","Text","Identity"),new("LONGTEXT","Long Text","Notes"),new("PORTRAIT","Portrait","Identity"),
  new("EQUIPMENT","Equipment / Inventory","Equipment"),new("CONDITIONS","Conditions","Status"),new("LANGUAGE","Language / Proficiency","Languages"),new("LINKED","Linked Reference","Linked"),new("DICE","Dice Bag","Dice")
 ];
 static readonly FieldAssetOption[] Assets=[
  new("blank","Blank Field","asset-blank",["*"]),new("numeric-plate","Numeric Plate","asset-numeric",["ATTRIBUTE","VALUE","LIMIT"]),
  new("slider","Equalizer Slider","asset-slider",["ATTRIBUTE","VALUE","TRACKER","LIMIT"]),new("meter","Resource Meter","asset-meter",["TRACKER","LIMIT"]),
  new("dial","Resource Dial","asset-dial",["TRACKER","LIMIT"]),new("text-panel","Writing Panel","asset-text-panel",["TEXT","LONGTEXT","FLARE","EQUIPMENT","CONDITIONS","LANGUAGE","LINKED","DICE"]),
  new("portrait-frame","Portrait Frame","asset-portrait-frame",["PORTRAIT"])
 ];

 readonly List<CardDraft> _cards=[];
 readonly List<RequiredFieldRule> _requirements=[];
 readonly Dictionary<string,CharacterValueDraft> _values=new();

 bool IsGameMaster=>string.Equals(Session.Role,"GM",StringComparison.OrdinalIgnoreCase);
 string RequirementStorageKey=>$"rist.character-card-requirements.v1.{Session.WorldId}";
 string LayoutStorageKey=>$"rist.character-card-layout.v1.{Session.WorldId}.{Session.ActiveCharacterNumber}";
 string LegacyTemplateStorageKey=>$"rist.character-card-template.v2.{Session.WorldId}";
 string ValueStorageKey=>$"rist.character-card-values.v1.{Session.WorldId}.{Session.ActiveCharacterNumber}";
 string ReportRowStorageKey=>$"rist.character-report-row.v1.{Session.WorldId}.{NormalizeStorageToken(Session.DiscordDisplayName)}.{Session.ActiveCharacterNumber}";
 CardDraft? SelectedCard=>_cards.Count==0?null:_cards[Math.Clamp(_selectedCard,0,_cards.Count-1)];
 FieldDefinition? SelectedField=>SelectedCard?.Fields.FirstOrDefault(x=>x.Id==_selectedFieldId);
 IEnumerable<FieldOption> SearchResults
 {
  get
  {
   var term=(_search??"").Trim();
   return Catalog.Where(x=>term.Length==0||x.Name.Contains(term,StringComparison.OrdinalIgnoreCase)||x.Group.Contains(term,StringComparison.OrdinalIgnoreCase)||FriendlyKind(x.Kind).Contains(term,StringComparison.OrdinalIgnoreCase)).Take(term.Length==0?6:12);
  }
 }
 IEnumerable<FieldAssetOption> MatchingAssets=>Assets.Where(x=>x.Kinds.Contains("*")||x.Kinds.Contains(_wizardKind));
 bool CanPlaceWizard=>!string.IsNullOrWhiteSpace(_wizardName)&&(MatchingAssets.Any(x=>x.Id==_wizardAssetId)||!string.IsNullOrWhiteSpace(_wizardAssetDataUrl));
 string PreviewStyle=>_cardSize switch{"tarot"=>"--card-ratio:2.75/4.75","index"=>"--card-ratio:3/5",_=>"--card-ratio:2.5/3.5"};

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_loaded)return;
  _loaded=true;
  await LoadAsync();
  _module=await JS.InvokeAsync<IJSObjectReference>("import","./character-card-designer.js?v=20260924-character-cards-2");
  _self=DotNetObjectReference.Create(this);
  await _module.InvokeVoidAsync("attach",_root,_self);
  await InvokeAsync(StateHasChanged);
 }

 async Task LoadAsync()
 {
  try
  {
   var requiredRaw=await JS.InvokeAsync<string?>("localStorage.getItem",RequirementStorageKey);
   if(!string.IsNullOrWhiteSpace(requiredRaw))
   {
    var requirements=JsonSerializer.Deserialize<List<RequiredFieldRule>>(requiredRaw);
    if(requirements is not null){_requirements.Clear();_requirements.AddRange(requirements);}
   }

   var layoutRaw=await JS.InvokeAsync<string?>("localStorage.getItem",LayoutStorageKey);
   if(string.IsNullOrWhiteSpace(layoutRaw))
    layoutRaw=await JS.InvokeAsync<string?>("localStorage.getItem",LegacyTemplateStorageKey);
   if(!string.IsNullOrWhiteSpace(layoutRaw))
   {
    var state=JsonSerializer.Deserialize<DesignerState>(layoutRaw);
    if(state?.Cards is {Count:>0}){_cards.Clear();_cards.AddRange(state.Cards);_cardSize=state.CardSize??"poker";}
   }

   var valuesRaw=await JS.InvokeAsync<string?>("localStorage.getItem",ValueStorageKey);
   if(!string.IsNullOrWhiteSpace(valuesRaw))
   {
    var values=JsonSerializer.Deserialize<Dictionary<string,CharacterValueDraft>>(valuesRaw);
    if(values is not null)foreach(var pair in values)_values[pair.Key]=pair.Value;
   }
  }
  catch{}
  if(_cards.Count==0)SeedStarterDeck();
  EnsureRequiredFields();
 }

 void SeedStarterDeck()
 {
  _cards.Clear();
  _cards.Add(new(){Title="Identity"});
  _cards.Add(new(){Title="Attributes"});
  _cards.Add(new(){Title="Status"});
  _cards.Add(new(){Title="Equipment"});
  _cards.Add(new(){Title="Notes"});
  _selectedCard=0;
 }

 string RequirementKey(FieldOption option)=>$"{option.Kind}:{option.Group}:{option.Name}";
 static string NormalizeJoin(string value)
 {
  var chars=(value??"").Trim().ToUpperInvariant().Where(ch=>char.IsLetterOrDigit(ch)||ch==' '||ch=='_'||ch=='-').ToArray();
  return string.Join("_",new string(chars).Split(' ',StringSplitOptions.RemoveEmptyEntries));
 }
 static string NormalizeStorageToken(string value)
 {
  var token=NormalizeJoin(value);
  return string.IsNullOrWhiteSpace(token)?"LOCAL_USER":token;
 }
 RequiredFieldRule? RequirementFor(FieldOption option)=>_requirements.FirstOrDefault(x=>x.Key==RequirementKey(option));
 bool IsRequirementEnabled(FieldOption option)=>RequirementFor(option) is not null;
 string RequirementName(FieldOption option)=>RequirementFor(option)?.Name??option.Name;
 bool IsProtectedRequired(FieldDefinition field)=>field.Required&&string.Equals(field.Authority,"GM",StringComparison.OrdinalIgnoreCase);

 void ToggleRequirement(FieldOption option,ChangeEventArgs e)
 {
  if(!IsGameMaster)return;
  var enabled=e.Value is bool value&&value;
  var key=RequirementKey(option);
  var existing=_requirements.FirstOrDefault(x=>x.Key==key);
  if(enabled)
  {
   if(existing is null)
   {
    var name=UniqueRequirementName(option.Name,key);
    _requirements.Add(new(){Key=key,Name=name,SharedJoin=NormalizeJoin(name),Kind=option.Kind,Group=option.Group});
   }
   EnsureRequiredFields();
  }
  else
  {
   if(existing is not null)_requirements.Remove(existing);
   foreach(var field in _cards.SelectMany(card=>card.Fields).Where(field=>field.RequirementId==key))
   {
    field.Required=false;field.Authority="PLAYER";field.RequirementId="";field.SharedJoin="";
   }
  }
  _saved=false;
 }

 string UniqueRequirementName(string proposed,string exceptKey)
 {
  var baseName=string.IsNullOrWhiteSpace(proposed)?"Field":proposed.Trim();
  var candidate=baseName;
  var suffix=2;
  while(_requirements.Any(x=>x.Key!=exceptKey&&string.Equals(x.SharedJoin,NormalizeJoin(candidate),StringComparison.OrdinalIgnoreCase)))
   candidate=$"{baseName} {suffix++}";
  return candidate;
 }

 void RenameRequirement(FieldOption option,ChangeEventArgs e)
 {
  if(!IsGameMaster)return;
  var rule=RequirementFor(option);if(rule is null)return;
  var name=UniqueRequirementName((e.Value?.ToString()??"").Trim(),rule.Key);
  if(name.Length==0)name=UniqueRequirementName(option.Name,rule.Key);
  rule.Name=name;
  rule.SharedJoin=NormalizeJoin(name);
  foreach(var field in _cards.SelectMany(card=>card.Fields).Where(field=>field.RequirementId==rule.Key))
  {
   field.Name=name;field.SharedJoin=rule.SharedJoin;
  }
  _saved=false;
 }

 void EnsureRequiredFields()
 {
  foreach(var rule in _requirements)
  {
   if(string.IsNullOrWhiteSpace(rule.SharedJoin))rule.SharedJoin=NormalizeJoin(rule.Name);
   var field=_cards.SelectMany(card=>card.Fields).FirstOrDefault(x=>x.RequirementId==rule.Key);
   if(field is null)
   {
    var target=CardForRequirement(rule);
    var asset=DefaultAssetForKind(rule.Kind);
    field=new(){
     Name=rule.Name,Kind=rule.Kind,Group=rule.Group,Required=true,Authority="GM",RequirementId=rule.Key,SharedJoin=rule.SharedJoin,
     AssetId=asset.Id,AssetName=asset.Label,X=50,Y=50,Width=DefaultWidth(rule.Kind),Height=DefaultHeight(rule.Kind)
    };
    target.Fields.Add(field);
    _values.TryAdd(field.Id,DefaultValueForKind(rule.Kind));
   }
   else
   {
    field.Name=rule.Name;field.Kind=rule.Kind;field.Group=rule.Group;field.Required=true;field.Authority="GM";field.SharedJoin=rule.SharedJoin;
   }
  }
 }

 CardDraft CardForRequirement(RequiredFieldRule rule)
 {
  string targetTitle=rule.Group switch{
   "Identity" or "Profile"=>"Identity",
   "Attributes" or "Skills" or "Limits" or "Trackers"=>"Attributes",
   "Status"=>"Status",
   "Equipment"=>"Equipment",
   _=>"Notes"
  };
  return _cards.FirstOrDefault(card=>string.Equals(card.Title,targetTitle,StringComparison.OrdinalIgnoreCase))??_cards[0];
 }
 FieldAssetOption DefaultAssetForKind(string kind)=>Assets.FirstOrDefault(x=>x.Id!="blank"&&(x.Kinds.Contains("*")||x.Kinds.Contains(kind)))??Assets[0];
 static double DefaultWidth(string kind)=>kind=="PORTRAIT"?30:kind is "LONGTEXT" or "EQUIPMENT" or "CONDITIONS"?52:36;
 static double DefaultHeight(string kind)=>kind=="PORTRAIT"?32:kind is "LONGTEXT" or "EQUIPMENT" or "CONDITIONS"?24:15;
 static CharacterValueDraft DefaultValueForKind(string kind)=>new(){BaseValue=kind=="ATTRIBUTE"?10:0,Current=0,Max=kind=="TRACKER"?100:kind is "ATTRIBUTE" or "LIMIT"?10:999,Proficiency=100};

 void SearchChanged(ChangeEventArgs e){_search=e.Value?.ToString()??"";}
 void BeginField(FieldOption option){_wizardName=option.Name;_wizardKind=option.Kind;_wizardGroup=option.Group;ResetWizardValues();ChooseDefaultAsset();_wizardOpen=true;}
 void BeginCustomField(){_wizardName=_search.Trim();if(_wizardName.Length==0)_wizardName="Custom Field";_wizardKind="TEXT";_wizardGroup="Custom";ResetWizardValues();ChooseDefaultAsset();_wizardOpen=true;}
 void CloseWizard(){_wizardOpen=false;_wizardAssetDataUrl="";}
 void ChooseType(FieldTypeOption type){_wizardKind=type.Kind;_wizardGroup=type.Group;ResetWizardValues();ChooseDefaultAsset();}
 void ChooseDefaultAsset(){var asset=MatchingAssets.FirstOrDefault(x=>x.Id!="blank")??Assets[0];_wizardAssetId=asset.Id;_wizardAssetName=asset.Label;_wizardAssetDataUrl="";}
 void ChooseAsset(FieldAssetOption asset){_wizardAssetId=asset.Id;_wizardAssetName=asset.Label;_wizardAssetDataUrl="";}
 void ResetWizardValues(){_wizardBase=_wizardKind=="ATTRIBUTE"?10:0;_wizardCurrent=0;_wizardMax=_wizardKind=="TRACKER"?100:_wizardKind is "ATTRIBUTE" or "LIMIT"?10:999;_wizardProficiency=100;_wizardText="";}

 async Task LoadWizardAsset(InputFileChangeEventArgs e)
 {
  var file=e.File;if(file is null)return;
  await using var stream=file.OpenReadStream(8*1024*1024);using var memory=new MemoryStream();await stream.CopyToAsync(memory);
  _wizardAssetDataUrl=$"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
  _wizardAssetId="custom";_wizardAssetName=file.Name;
 }

 void SaveAndPlace()
 {
  if(SelectedCard is not { } card||string.IsNullOrWhiteSpace(_wizardName))return;
  var field=new FieldDefinition{
   Name=_wizardName.Trim(),Kind=_wizardKind,Group=_wizardGroup,Required=false,Authority=IsGameMaster?"GM":"PLAYER",SharedJoin="",AssetId=_wizardAssetId,AssetName=_wizardAssetName,AssetDataUrl=_wizardAssetDataUrl,
   X=50,Y=50,Width=DefaultWidth(_wizardKind),Height=DefaultHeight(_wizardKind)
  };
  card.Fields.Add(field);
  _values[field.Id]=new(){Text=_wizardText,BaseValue=_wizardBase,Current=_wizardCurrent,Max=_wizardMax,Proficiency=_wizardProficiency};
  _selectedFieldId=field.Id;_wizardOpen=false;_wizardAssetDataUrl="";_search="";_saved=false;
 }

 CharacterValueDraft ValueFor(string id){if(!_values.TryGetValue(id,out var value)){value=new();_values[id]=value;}return value;}
 RenderFragment RenderRuntimeEditor(FieldDefinition field)=>builder=>{
  var value=ValueFor(field.Id);var seq=0;
  if(field.Kind=="ATTRIBUTE"){
   builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class","ccd-value-inline");
   NumberInput(builder,ref seq,"BASE",value.BaseValue,v=>value.BaseValue=v);
   NumberInput(builder,ref seq,"CURRENT",value.Current,v=>value.Current=v);
   NumberInput(builder,ref seq,"MAX",value.Max,v=>value.Max=v);
   builder.CloseElement();
  }else if(field.Kind is "TRACKER" or "LIMIT" or "VALUE"){
   builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class","ccd-value-inline");
   NumberInput(builder,ref seq,"CURRENT",value.Current,v=>value.Current=v);
   NumberInput(builder,ref seq,"MAX",value.Max,v=>value.Max=v);
   builder.CloseElement();
  }else if(field.Kind=="LANGUAGE"){
   NumberInput(builder,ref seq,"PROFICIENCY %",value.Proficiency,v=>value.Proficiency=Math.Clamp(v,0,100));
  }else if(field.Kind=="PORTRAIT"){
   builder.OpenElement(seq++,"small");builder.AddContent(seq++,"Portrait data changes the character value only; the GM frame stays fixed.");builder.CloseElement();
  }else{
   builder.OpenElement(seq++,"textarea");builder.AddAttribute(seq++,"value",value.Text);builder.AddAttribute(seq++,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>{value.Text=e.Value?.ToString()??"";_saved=false;}));builder.CloseElement();
  }
 };
 void NumberInput(RenderTreeBuilder builder,ref int seq,string label,int value,Action<int> set){
  builder.OpenElement(seq++,"label");builder.OpenElement(seq++,"span");builder.AddContent(seq++,label);builder.CloseElement();builder.OpenElement(seq++,"input");builder.AddAttribute(seq++,"type","number");builder.AddAttribute(seq++,"value",value);builder.AddAttribute(seq++,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>{if(int.TryParse(e.Value?.ToString(),out var v)){set(v);_saved=false;}}));builder.CloseElement();builder.CloseElement();
 }

 string DisplayJoin(string sharedJoin)=>_requirements.FirstOrDefault(x=>x.SharedJoin==sharedJoin)?.Name??sharedJoin;
 string ModifierLabel(FieldModifier modifier)
 {
  var op=modifier.Operation switch{"ADD"=>"+","SUBTRACT"=>"−","MULTIPLY"=>"×","SET"=>"=",_=>modifier.Operation};
  return $"{modifier.TargetSlot} {op} {modifier.Amount:0.##}";
 }
 void AddModifier()
 {
  if(SelectedField is not { } source||string.IsNullOrWhiteSpace(_modifierTargetJoin))return;
  source.Modifiers.Add(new(){TargetJoin=_modifierTargetJoin,TargetSlot=_modifierTargetSlot,Operation=_modifierOperation,Amount=_modifierAmount});
  _saved=false;
 }
 void RemoveModifier(string id){if(SelectedField is not { } source)return;source.Modifiers.RemoveAll(x=>x.Id==id);_saved=false;}
 void SetRequiresActivation(FieldDefinition field,ChangeEventArgs e){field.RequiresActivation=e.Value is bool value&&value;if(!field.RequiresActivation){var state=ValueFor(field.Id);state.Active=true;state.RemainingDuration=0;}_saved=false;}
 void ToggleFieldActivation(FieldDefinition field){var state=ValueFor(field.Id);state.Active=!state.Active;state.RemainingDuration=state.Active?Math.Max(0,field.Duration):0;_saved=false;}
 void SetDuration(FieldDefinition field,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var value))field.Duration=Math.Max(0,value);_saved=false;}
 void SetDurationUnit(FieldDefinition field,ChangeEventArgs e){field.DurationUnit=e.Value?.ToString()??"Rounds";_saved=false;}
 void SetRemainingDuration(FieldDefinition field,ChangeEventArgs e){var state=ValueFor(field.Id);if(int.TryParse(e.Value?.ToString(),out var value))state.RemainingDuration=Math.Max(0,value);if(field.Duration>0&&state.RemainingDuration==0)state.Active=false;_saved=false;}

 bool ModifierIsActive(FieldDefinition source)
 {
  if(!source.RequiresActivation)return true;
  var state=ValueFor(source.Id);
  if(!state.Active)return false;
  return source.Duration<=0||state.RemainingDuration>0;
 }
 double ApplyModifier(double current,FieldModifier modifier)=>modifier.Operation switch{
  "SUBTRACT"=>current-modifier.Amount,
  "MULTIPLY"=>current*modifier.Amount,
  "SET"=>modifier.Amount,
  _=>current+modifier.Amount
 };
 double EffectiveNumeric(FieldDefinition target,CharacterValueDraft value,string slot)
 {
  double current=slot switch{"BASE"=>value.BaseValue,"MAX"=>value.Max,_=>value.Current};
  if(string.IsNullOrWhiteSpace(target.SharedJoin))return current;
  foreach(var source in _cards.SelectMany(card=>card.Fields))
  {
   if(!ModifierIsActive(source))continue;
   foreach(var modifier in source.Modifiers.Where(x=>string.Equals(x.TargetJoin,target.SharedJoin,StringComparison.OrdinalIgnoreCase)&&string.Equals(x.TargetSlot,slot,StringComparison.OrdinalIgnoreCase)))
    current=ApplyModifier(current,modifier);
  }
  return current;
 }

 string DisplayValue(FieldDefinition field,CharacterValueDraft value)=>field.Kind switch{
