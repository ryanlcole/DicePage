  "TRACKER" or "LIMIT" or "VALUE"=>$"{EffectiveNumeric(field,value,"CURRENT"):0.##} / {EffectiveNumeric(field,value,"MAX"):0.##}",
  "LANGUAGE"=>$"{value.Proficiency}%",
  "PORTRAIT"=>"PORTRAIT",
  _=>string.IsNullOrWhiteSpace(value.Text)?"—":value.Text
 };
