@using System.Text.Json
@inject IJSRuntime JS

<div class="character-card-designer" aria-label="Character Card Designer">
 <header class="ccd-header">
  <div>
   <small>GAMEMASTER · CHARACTER SYSTEM</small>
   <h2>CHARACTER CARD DESIGNER</h2>
   <p>Build a character sheet as an ordered deck of cards.</p>
  </div>
  <div class="ccd-actions">
   <button type="button" @onclick="AddCard">+ CARD</button>
   <button type="button" @onclick="SaveAsync">@(_saved?"SAVED":"SAVE DRAFT")</button>
  </div>
 </header>

 <div class="ccd-workspace">
  <aside class="ccd-deck" aria-label="Character card deck">
   <strong>DECK</strong>
   @for(var i=0;i<_cards.Count;i++)
   {
    var index=i;
    var card=_cards[index];
    <button type="button"
            class="@(index==_selected?"selected":"")"
            aria-pressed="@(index==_selected)"
            @onclick="()=>SelectCard(index)">
     <span>@(index+1)</span>
     <b>@card.Title</b>
     <small>@card.Fields.Count field@(card.Fields.Count==1?"":"s")</small>
    </button>
   }
  </aside>

  <main class="ccd-preview-area">
   @if(SelectedCard is { } card)
   {
    <section class="ccd-card-preview" style="@PreviewStyle" aria-label="Selected character card preview">
     <header>
      <small>CARD @(_selected+1) / @_cards.Count</small>
      <strong>@card.Title</strong>
     </header>
     <div class="ccd-card-fields">
      @foreach(var field in card.Fields)
      {
       <div>
        <span>@field</span>
        <i></i>
       </div>
      }
      @if(card.Fields.Count==0)
      {
       <p>ADD FIELDS TO THIS CARD</p>
      }
     </div>
    </section>
   }
  </main>

  <aside class="ccd-inspector" aria-label="Character card inspector">
   @if(SelectedCard is { } selected)
   {
    <label>
     <span>CARD TITLE</span>
     <input maxlength="48" value="@selected.Title" @oninput="RenameSelected" />
    </label>
    <label>
     <span>CARD SIZE</span>
     <select value="@_cardSize" @onchange="ChangeCardSize">
      <option value="poker">Poker · 2.5 × 3.5</option>
      <option value="tarot">Tarot · 2.75 × 4.75</option>
      <option value="index">Index · 3 × 5</option>
     </select>
    </label>

    <div class="ccd-reorder">
     <button type="button" disabled="@(_selected<=0)" @onclick="MoveLeft">← EARLIER</button>
     <button type="button" disabled="@(_selected>=_cards.Count-1)" @onclick="MoveRight">LATER →</button>
    </div>

    <section class="ccd-field-editor">
     <strong>FIELDS</strong>
     @for(var i=0;i<selected.Fields.Count;i++)
     {
      var fieldIndex=i;
      <div>
       <span>@selected.Fields[fieldIndex]</span>
       <button type="button" aria-label="Remove @selected.Fields[fieldIndex]" @onclick="()=>RemoveField(fieldIndex)">×</button>
      </div>
     }
    </section>

    <label>
     <span>ADD FIELD</span>
     <select @bind="_fieldToAdd">
      @foreach(var field in FieldChoices)
      {
       <option value="@field">@field</option>
      }
     </select>
    </label>
    <button type="button" class="ccd-add-field" @onclick="AddField">+ ADD FIELD</button>
    <button type="button" class="ccd-delete" disabled="@(_cards.Count<=1)" @onclick="DeleteSelected">DELETE CARD</button>
   }
  </aside>
 </div>
</div>

<style>
 .character-card-designer{box-sizing:border-box;width:100%;height:100%;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);background:radial-gradient(circle at 50% 0,#132432 0,transparent 34%),#050a0e;color:#e8dfca;font-family:Inter,system-ui,-apple-system,sans-serif;overflow:hidden}
 .ccd-header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 16px;border-bottom:1px solid #765f31;background:linear-gradient(90deg,#08121a,#151109)}.ccd-header small{color:#7fa5b8;font-size:8px;font-weight:900;letter-spacing:.14em}.ccd-header h2{margin:2px 0;color:#efd493;font:600 20px/1.1 Georgia,serif;letter-spacing:.05em}.ccd-header p{margin:4px 0 0;color:#9dafb7;font-size:10px}.ccd-actions{display:flex;gap:7px}.ccd-actions button,.ccd-reorder button,.ccd-add-field,.ccd-delete{min-height:36px;padding:0 10px;border:1px solid #586d78;border-radius:7px;background:#0c1820;color:#e7dcbf;font:900 9px/1 system-ui;letter-spacing:.05em;touch-action:manipulation}.ccd-actions button:last-child{border-color:#9b7b39;color:#ffe3a0}
 .ccd-workspace{min-height:0;display:grid;grid-template-columns:190px minmax(0,1fr) 250px}.ccd-deck,.ccd-inspector{min-height:0;overflow:auto;padding:10px;background:#081117}.ccd-deck{border-right:1px solid #344b58}.ccd-inspector{border-left:1px solid #344b58}.ccd-deck>strong,.ccd-field-editor>strong{display:block;margin:0 0 8px;color:#8ea4af;font-size:8px;letter-spacing:.13em}.ccd-deck>button{width:100%;min-height:54px;margin-bottom:7px;padding:7px;border:1px solid #394e59;border-radius:7px;background:#0d1820;color:#dce2df;display:grid;grid-template-columns:24px 1fr;grid-template-rows:auto auto;text-align:left;touch-action:manipulation}.ccd-deck>button>span{grid-row:1/3;align-self:center;color:#d6b65d;font:700 16px Georgia,serif}.ccd-deck b{font:700 10px system-ui}.ccd-deck small{color:#81949e;font-size:8px}.ccd-deck button.selected{border-color:#d0aa55;background:#19180f;box-shadow:0 0 0 1px #d0aa5544}
 .ccd-preview-area{min-width:0;min-height:0;display:grid;place-items:center;padding:18px;overflow:auto;background:radial-gradient(circle,#13212a 0,#071016 65%,#04090d 100%)}.ccd-card-preview{box-sizing:border-box;width:min(62vw,390px);aspect-ratio:var(--card-ratio);display:grid;grid-template-rows:auto 1fr;padding:16px;border:2px solid #b18a3e;border-radius:16px;background:linear-gradient(155deg,#182632,#0c141a 62%,#171109);box-shadow:0 22px 54px #000b,0 0 0 1px #f0ce7440 inset}.ccd-card-preview header{padding-bottom:10px;border-bottom:1px solid #64522e}.ccd-card-preview header small{display:block;color:#779bab;font-size:7px;font-weight:900;letter-spacing:.12em}.ccd-card-preview header strong{display:block;margin-top:3px;color:#f0d79a;font:600 clamp(17px,3vw,28px)/1.1 Georgia,serif}.ccd-card-fields{display:grid;align-content:start;gap:10px;padding-top:13px}.ccd-card-fields>div{display:grid;grid-template-columns:minmax(90px,.42fr) 1fr;align-items:center;gap:10px}.ccd-card-fields span{color:#d8c99f;font-size:9px;font-weight:900;letter-spacing:.06em}.ccd-card-fields i{height:1px;background:linear-gradient(90deg,#617580,#2f3d44)}.ccd-card-fields p{margin:auto;color:#607681;font-size:9px;font-weight:900;letter-spacing:.12em}
 .ccd-inspector{display:grid;align-content:start;gap:10px}.ccd-inspector label{display:grid;gap:4px}.ccd-inspector label>span{color:#829aa6;font-size:8px;font-weight:900;letter-spacing:.1em}.ccd-inspector input,.ccd-inspector select{box-sizing:border-box;width:100%;min-height:36px;border:1px solid #4a606b;border-radius:7px;background:#0d1820;color:#ecdfbd;padding:6px 8px;font:800 10px system-ui}.ccd-reorder{display:grid;grid-template-columns:1fr 1fr;gap:6px}.ccd-reorder button:disabled,.ccd-delete:disabled{opacity:.35}.ccd-field-editor{padding:9px;border:1px solid #324752;border-radius:8px;background:#0a151c}.ccd-field-editor>div{display:grid;grid-template-columns:1fr 28px;align-items:center;gap:4px;min-height:31px;border-bottom:1px solid #273b45;color:#d7d8cf;font-size:9px}.ccd-field-editor>div:last-child{border-bottom:0}.ccd-field-editor button{width:27px;height:27px;border:1px solid #664f47;border-radius:5px;background:#1a1110;color:#e6b4a6}.ccd-add-field{border-color:#4e796a;color:#c8eadc}.ccd-delete{margin-top:5px;border-color:#71483f;color:#e8b1a4;background:#1c100e}
 @media(max-width:760px){.ccd-header{padding:8px 10px}.ccd-header h2{font-size:15px}.ccd-header p{display:none}.ccd-workspace{grid-template-columns:92px minmax(0,1fr);grid-template-rows:minmax(0,1fr) auto}.ccd-deck{grid-row:1/3;padding:6px}.ccd-deck>button{grid-template-columns:1fr;min-height:44px;padding:5px}.ccd-deck>button>span{display:none}.ccd-deck b{font-size:8px}.ccd-inspector{grid-column:2;grid-row:2;max-height:33dvh;border-left:0;border-top:1px solid #344b58;padding:7px;grid-template-columns:1fr 1fr}.ccd-inspector label,.ccd-field-editor{min-width:0}.ccd-field-editor{grid-row:span 2}.ccd-preview-area{padding:8px}.ccd-card-preview{width:min(70vw,320px);padding:10px}.ccd-actions button{min-height:32px;padding:0 7px;font-size:8px}}
</style>

@code {
 const string StorageKey="rist.character-card-designer.v1";
 static readonly string[] FieldChoices=["Name","Portrait","Concept","Attributes","Skills","Health","Conditions","Equipment","Inventory","Abilities","Languages","Notes","Custom"];
 readonly List<CardDraft> _cards=[];
 int _selected;
 string _fieldToAdd="Attributes";
 string _cardSize="poker";
 bool _loaded;
 bool _saved;

 CardDraft? SelectedCard=>_cards.Count==0?null:_cards[Math.Clamp(_selected,0,_cards.Count-1)];
 string PreviewStyle=>_cardSize switch
 {
  "tarot"=>"--card-ratio:2.75/4.75",
  "index"=>"--card-ratio:3/5",
  _=>"--card-ratio:2.5/3.5"
 };

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_loaded)return;
  _loaded=true;
  try
  {
   var raw=await JS.InvokeAsync<string?>("localStorage.getItem",StorageKey);
   if(!string.IsNullOrWhiteSpace(raw))
   {
    var saved=JsonSerializer.Deserialize<DesignerState>(raw);
    if(saved?.Cards is {Count:>0})
    {
     _cards.Clear();
     _cards.AddRange(saved.Cards);
     _cardSize=string.IsNullOrWhiteSpace(saved.CardSize)?"poker":saved.CardSize;
    }
   }
  }
  catch{}
  if(_cards.Count==0)SeedStarterDeck();
  await InvokeAsync(StateHasChanged);
 }

 void SeedStarterDeck()
 {
  _cards.Clear();
  _cards.Add(new("Identity",["Name","Portrait","Concept"]));
  _cards.Add(new("Attributes",["Attributes","Skills"]));
  _cards.Add(new("Status",["Health","Conditions"]));
  _cards.Add(new("Equipment",["Equipment","Inventory"]));
  _cards.Add(new("Notes",["Languages","Notes"]));
  _selected=0;
 }

 void SelectCard(int index){_selected=Math.Clamp(index,0,Math.Max(0,_cards.Count-1));_saved=false;}
 void AddCard(){_cards.Add(new($"Card {_cards.Count+1}",[]));_selected=_cards.Count-1;_saved=false;}
 void DeleteSelected(){if(_cards.Count<=1)return;_cards.RemoveAt(_selected);_selected=Math.Clamp(_selected,0,_cards.Count-1);_saved=false;}
 void MoveLeft(){if(_selected<=0)return;(_cards[_selected-1],_cards[_selected])=(_cards[_selected],_cards[_selected-1]);_selected--;_saved=false;}
 void MoveRight(){if(_selected>=_cards.Count-1)return;(_cards[_selected+1],_cards[_selected])=(_cards[_selected],_cards[_selected+1]);_selected++;_saved=false;}
 void RenameSelected(ChangeEventArgs e){if(SelectedCard is not { } card)return;card.Title=(e.Value?.ToString()??"").TrimStart();_saved=false;}
 void ChangeCardSize(ChangeEventArgs e){_cardSize=e.Value?.ToString()??"poker";_saved=false;}
 void AddField(){if(SelectedCard is not { } card||string.IsNullOrWhiteSpace(_fieldToAdd))return;card.Fields.Add(_fieldToAdd);_saved=false;}
 void RemoveField(int index){if(SelectedCard is not { } card||index<0||index>=card.Fields.Count)return;card.Fields.RemoveAt(index);_saved=false;}

 async Task SaveAsync()
 {
  try
  {
   var state=new DesignerState{CardSize=_cardSize,Cards=_cards};
   await JS.InvokeVoidAsync("localStorage.setItem",StorageKey,JsonSerializer.Serialize(state));
   _saved=true;
  }
  catch{_saved=false;}
 }

 sealed class CardDraft
 {
  public CardDraft(){}
  public CardDraft(string title,List<string> fields){Title=title;Fields=fields;}
  public string Title{get;set;}="";
  public List<string> Fields{get;set;}=[];
 }
 sealed class DesignerState
 {
  public string CardSize{get;set;}="poker";
  public List<CardDraft> Cards{get;set;}=[];
 }
}
