 static string AssetClass(FieldDefinition field)=>field.AssetId=="custom"?"asset-custom":Assets.FirstOrDefault(x=>x.Id==field.AssetId)?.CssClass??"asset-blank";
 static string F(double value)=>value.ToString("0.0",System.Globalization.CultureInfo.InvariantCulture);
 static double Clamp(double value,double min,double max)=>Math.Max(min,Math.Min(max,value));
 string FieldStyle(FieldDefinition field)=>$"left:{F(field.X)}%;top:{F(field.Y)}%;width:{F(field.Width)}%;height:{F(field.Height)}%;transform:translate(-50%,-50%);";

