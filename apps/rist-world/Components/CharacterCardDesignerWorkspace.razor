 CharacterReportRow BuildReportRow()
 {
  var row=new CharacterReportRow{
   RowId=$"{NormalizeStorageToken(Session.DiscordDisplayName)}:{Session.ActiveCharacterNumber}",
   SourceType="Character",
   Player=string.IsNullOrWhiteSpace(Session.DiscordDisplayName)?"Local User":Session.DiscordDisplayName,
   Character=string.IsNullOrWhiteSpace(Session.CharacterName)?$"Character {Session.ActiveCharacterNumber}":Session.CharacterName
  };
  foreach(var field in _cards.SelectMany(card=>card.Fields).Where(field=>field.Required&&!string.IsNullOrWhiteSpace(field.SharedJoin)))
  {
   var value=ValueFor(field.Id);
   row.Values[field.SharedJoin]=ReportCellFrom(field,value);
  }
  return row;
 }
 ReportCell ReportCellFrom(FieldDefinition field,CharacterValueDraft value)
 {
  if(field.Kind=="LANGUAGE")return new(){Kind=field.Kind,Text=$"{value.Proficiency}%",Number=value.Proficiency,Effective=value.Proficiency};
  if(field.Kind is "ATTRIBUTE" or "TRACKER" or "LIMIT" or "VALUE")
  {
   var effective=EffectiveNumeric(field,value,"CURRENT");
   return new(){
    Kind=field.Kind,Text=effective.ToString("0.##"),Number=effective,Effective=effective,
    Base=EffectiveNumeric(field,value,"BASE"),Current=value.Current,Max=EffectiveNumeric(field,value,"MAX"),
    ModifierCount=_cards.SelectMany(card=>card.Fields).Where(ModifierIsActive).Sum(source=>source.Modifiers.Count(mod=>string.Equals(mod.TargetJoin,field.SharedJoin,StringComparison.OrdinalIgnoreCase)))
   };
  }
  return new(){Kind=field.Kind,Text=value.Text??""};
 }

 async Task SaveAsync()
 {
  try{
   if(IsGameMaster)await JS.InvokeVoidAsync("localStorage.setItem",RequirementStorageKey,JsonSerializer.Serialize(_requirements));
   await JS.InvokeVoidAsync("localStorage.setItem",LayoutStorageKey,JsonSerializer.Serialize(new DesignerState{CardSize=_cardSize,Cards=_cards}));
   await JS.InvokeVoidAsync("localStorage.setItem",ValueStorageKey,JsonSerializer.Serialize(_values));
   await JS.InvokeVoidAsync("localStorage.setItem",ReportRowStorageKey,JsonSerializer.Serialize(BuildReportRow()));
   _saved=true;
  }catch{_saved=false;}
 }

