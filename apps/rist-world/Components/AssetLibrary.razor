!important;padding:6px 7px!important;border-bottom:1px solid #40371f!important;background:#0c151c!important}.map-asset-filters select,.map-asset-filters button{min-width:0!important;height:32px!important;padding:0 8px!important;border:1px solid #554a31!important;border-radius:7px!important;background:#111920!important;color:#ddd3bb!important;font-size:11px!important}.map-asset-status{padding:5px 8px!important;border-bottom:1px solid #40371f!important;color:#cdbb8c!important;background:#0c151c!important;font-size:10px!important}.map-asset-grid{box-sizing:border-box!important;min-height:0!important;display:grid!important;grid-template-columns:repeat(auto-fill,minmax(112px,1fr))!important;gap:7px!important;padding:7px!important;overflow:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch!important}.map-asset-card{box-sizing:border-box!important;min-width:0!important;height:132px!important;display:grid!important;grid-template-rows:minmax(0,1fr) 27px!important;gap:0!important;padding:0!important;overflow:hidden!important;border:1px solid #4e432b!important;border-radius:9px!important;background:#0d171e!important;color:#e8dcc0!important;text-align:left!important}.map-asset-card:active,.map-asset-card:focus-visible{border-color:#d0a63f!important;box-shadow:inset 0 0 0 1px #d0a63f55!important}.map-asset-card.private{border-color:#526879!important}.map-asset-preview{position:relative!important;display:block!important;width:100%!important;height:100%!important;min-height:0!important;overflow:hidden!important;background:#050b0f!important}.map-asset-preview img{position:absolute!important}.map-asset-card strong{box-sizing:border-box!important;display:block!important;width:100%!important;padding:7px!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;color:#e1c77f!important;font:700 9px/1 system-ui!important}.map-asset-empty{grid-column:1/-1!important;align-self:start!important;padding:30px!important;