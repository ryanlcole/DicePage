</style>

@code {
 const long MaxAssetBytes=20*1024*1024;
 readonly List<AtlasTile> _privateTiles=[];
 readonly Dictionary<string,AssetRatingClient.AssetRating> _ratings=new(StringComparer.Ordinal);
 readonly HashSet<string> _providerDescriptors=new(StringComparer.Ordinal);
 readonly HashSet<string> _reportDescriptors=new(StringComparer.Ordinal);
 string _query="";
 string _source="all";
 string _category="all";
 string _folder="all";
 string _status="";
 bool _filtersOpen;
 bool _uploading;
 bool _loadingPrivate;
 bool _privateLoaded;
 bool _uploadRatingOpen;
 bool _providerGeneral;
 AtlasTile? _reportTile;
 AssetRatingClient.AssetRating? _reportRating;
 bool _reportGeneral;
 bool _reporting;

 IEnumerable<AtlasTile> PublicTiles=>Session.AtlasTiles.Where(x=>!x.Id.StartsWith("naeja-map-",StringComparison.Ordinal));
 IEnumerable<AtlasTile> AllTiles=>PublicTiles.Concat(_privateTiles);
 List<AtlasTile> FilteredTiles=>AllTiles
  .Where(ContentAllowed)
  .Where(SourceMatch)
  .Where(x=>_category=="all"||CategoryFor(x)==_category)
  .Where(x=>_folder=="all"||FolderFor(x)==_folder)
  .Where(SearchMatch)
  .OrderBy(x=>IsPrivate(x)?0:1)
  .ThenBy(x=>x.Name,StringComparer.OrdinalIgnoreCase)
  .ToList();
 List<string> CategoryChoices=>AllTiles.Select(CategoryFor).Distinct().OrderBy(x=>x).ToList();
 List<string> FolderChoices=>AllTiles.Where(x=>_category=="all"||CategoryFor(x)==_category).Select(FolderFor).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x).ToList();
 bool CanUploadRated=>_providerGeneral||_providerDescriptors.Count>0;
 bool CanReport=>_reportGeneral||_reportDescriptors.Count>0;

 protected override void OnInitialized(){Session.Changed+=Changed;if(Session.IsLoggedIn)_=LoadPrivateAssetsAsync();}
 void Changed(){if(Session.IsLoggedIn&&Session.TileBrowserOpen&&!_privateLoaded&&!_loadingPrivate)_=LoadPrivateAssetsAsync();_ = InvokeAsync(StateHasChanged);}
 public void Dispose()=>Session.Changed-=Changed;

 void Close(){if(Session.TileBrowserOpen)Session.ToggleTileBrowser();}
 void Choose(AtlasTile tile){Session.StageTile(tile);}
 void ClearFilters(){_source="all";_category="all";_folder="all";_query="";}
 bool SourceMatch(AtlasTile tile)=>_source switch{"mine"=>IsPrivate(tile),"public"=>!IsPrivate(tile),_=>true};
 bool SearchMatch(AtlasTile tile)=>string.IsNullOrWhiteSpace(_query)||$"{tile.Name} {tile.Directory} {tile.Folder} {CategoryFor(tile)}".Contains(_query.Trim(),StringComparison.OrdinalIgnoreCase);
 static bool IsPrivate(AtlasTile tile)=>tile.Id.StartsWith("private:",StringComparison.Ordinal);
 string AssetId(AtlasTile tile)=>IsPrivate(tile)?tile.Id["private:".Length..]:tile.Id;
 AssetRatingClient.AssetRating? RatingFor(AtlasTile tile)=>_ratings.TryGetValue(AssetId(tile),out var rating)?rating:null;
 bool ContentAllowed(AtlasTile tile)
 {
  var rating=RatingFor(tile);
  return rating is null||rating.EffectiveDescriptors.Length==0||Auth.CampaignContentAllowed(rating.EffectiveDescriptors);
 }
 string RatingLabel(AssetRatingClient.AssetRating? rating)=>rating is null?"Legacy · General":rating.EffectiveDescriptors.Length==0?"General":$"Rated · {rating.EffectiveDescriptors.Length}";
 string RatingReasons(IEnumerable<string> ids)
 {
  var labels=ids.Select(id=>ContentAllowancePolicy.Descriptors.FirstOrDefault(x=>x.Id==id)?.Label).Where(x=>!string.IsNullOrWhiteSpace(x)).ToArray();
  return labels.Length==0?"General / none":string.Join(", ",labels!);
 }

 void OpenUploadRating(){_providerDescriptors.Clear();_providerGeneral=false;_uploadRatingOpen=true;}
 void CloseUploadRating(){if(!_uploading)_uploadRatingOpen=false;}
 void SetProviderGeneral(bool value){_providerGeneral=value;if(value)_providerDescriptors.Clear();}
 void ToggleProviderDescriptor(string id,bool value){_providerGeneral=false;if(value)_providerDescriptors.Add(id);else _providerDescriptors.Remove(id);}

 async Task UploadAssets(InputFileChangeEventArgs e)
 {
  if(!Session.IsLoggedIn){_status="Log in to upload private assets.";return;}
  if(!CanUploadRated){_status="Choose a content rating before uploading.";return;}
  _uploading=true;_status="Uploading rated assets to your private AWS storage…";
  try
  {
   var uploaded=0;
   foreach(var file in e.GetMultipleFiles(24))
   {
    var contentType=NormalizeImageType(file.ContentType,file.Name);
    if(contentType is null){_status=$"Skipped {file.Name}: unsupported image type.";continue;}
    if(file.Size>MaxAssetBytes){_status=$"Skipped {file.Name}: maximum size is 20 MB.";continue;}
    await using var stream=file.OpenReadStream(MaxAssetBytes);
    using var memory=new MemoryStream();
    await stream.CopyToAsync(memory);
    var safe=SafeFileName(file.Name);
    var key=$"assets/{DateTime.UtcNow:yyyy/MM}/{Guid.NewGuid():N}-{safe}";
    await Auth.UploadBytesAsync(key,memory.ToArray(),contentType);
    var rating=await Ratings.RegisterAsync(key,_providerDescriptors,_providerGeneral);
    if(rating is null)throw new InvalidOperationException($"{file.Name} uploaded but its required content rating could not be registered.");
    _ratings[key]=rating;
    uploaded++;
   }
   _privateLoaded=false;
   await LoadPrivateAssetsAsync(force:true);
   _source="mine";
   _uploadRatingOpen=false;
   _status=$"{uploaded} rated asset{(uploaded==1?"":"s")} added to your library.";
  }
  catch(Exception ex){_status="Upload failed: "+ex.Message;}
  finally{_uploading=false;await InvokeAsync(StateHasChanged);}
 }

 async Task LoadPrivateAssetsAsync(bool force=false)
 {
  if(!Session.IsLoggedIn||(_privateLoaded&&!force)||_loadingPrivate)return;
  _loadingPrivate=true;
  try
  {
   var listing=await Auth.ListAsync("assets/");
   var files=listing?.Items?.Where(x=>IsImageKey(x.Key)).OrderByDescending(x=>x.LastModified).Take(300).ToList()??[];
   var loaded=new List<AtlasTile>();
   var unrated=0;
   foreach(var item in files)
   {
    var rating=await Ratings.GetAsync(item.Key);
    if(rating is null){unrated++;continue;}
    _ratings[item.Key]=rating;
    var url=await Auth.DownloadUrlAsync(item.Key);
    if(string.IsNullOrWhiteSpace(url))continue;
    var file=Path.GetFileName(item.Key);
    var dash=file.IndexOf('-');
    var display=dash>=0&&dash<file.Length-1?file[(dash+1)..]:file;
    display=Path.GetFileNameWithoutExtension(display).Replace('_',' ').Replace('-',' ');
    loaded.Add(new AtlasTile("private:"+item.Key,display,url,"PRIVATE","Uploads","My Assets","You"));
   }
   _privateTiles.Clear();_privateTiles.AddRange(loaded);_privateLoaded=true;
   if(unrated>0)_status=$"{unrated} older upload{(unrated==1?" is":"s are")} hidden until a provider content rating is assigned.";
  }
  catch(Exception ex){_status="Your private assets could not be loaded: "+ex.Message;}
  finally{_loadingPrivate=false;await InvokeAsync(StateHasChanged);}
 }

 void OpenReport(AtlasTile tile,AssetRatingClient.AssetRating rating)
 {
  _reportTile=tile;_reportRating=rating;_reportGeneral=false;_reportDescriptors.Clear();
  foreach(var id in rating.EffectiveDescriptors)_reportDescriptors.Add(id);
 }
 void CloseReport(){if(!_reporting){_reportTile=null;_reportRating=null;_reportDescriptors.Clear();_reportGeneral=false;}}
 void SetReportGeneral(bool value){_reportGeneral=value;if(value)_reportDescriptors.Clear();}
 void ToggleReportDescriptor(string id,bool value){_reportGeneral=false;if(value)_reportDescriptors.Add(id);else _reportDescriptors.Remove(id);}
 async Task SubmitReportAsync()
 {
  if(_reporting||_reportTile is null||_reportRating is null||!CanReport)return;
  _reporting=true;
  try
  {
   var result=await Ratings.ReportAsync(AssetId(_reportTile),_reportDescriptors,_reportGeneral);
   if(result is null)throw new InvalidOperationException("The report could not be recorded.");
   var old=_reportRating;
   var updated=new AssetRatingClient.AssetRating(old.AssetId,old.ProviderDescriptors,result.EffectiveDescriptors,result.UniqueReportCount,result.ManualReviewRequired,result.AutoRestricted,old.RatingVersion);
   _ratings[old.AssetId]=updated;
   _status=result.RestrictionChanged
    ?$"Report recorded. {result.UniqueReportCount} different accounts have reported this asset; restrictions were automatically tightened and the uploader was alerted. Manual review remains queued."
    :$"Report recorded for manual review ({result.UniqueReportCount} different signed-in reporter{(result.UniqueReportCount==1?"":"s")}).";
   CloseReport();
  }
  catch(Exception ex){_status="Rating report failed: "+ex.Message;}
  finally{_reporting=false;await InvokeAsync(StateHasChanged);}
 }

 static string? NormalizeImageType(string? type,string name)
 {
  var value=(type??"").ToLowerInvariant();
  if(value is "image/png" or "image/webp" or "image/jpeg" or "image/gif")return value;
  return Path.GetExtension(name).ToLowerInvariant() switch{".png"=>"image/png",".webp"=>"image/webp",".jpg" or ".jpeg"=>"image/jpeg",".gif"=>"image/gif",_=>null};
 }
 static bool IsImageKey(string key)=>Path.GetExtension(key).ToLowerInvariant() is ".png" or ".webp" or ".jpg" or ".jpeg" or ".gif";
 static string SafeFileName(string name)
 {
  var file=Path.GetFileName(name);
  var cleaned=new string(file.Select(c=>char.IsLetterOrDigit(c)||c is '.' or '-' or '_'?c:'-').ToArray()).Trim('-');
  return string.IsNullOrWhiteSpace(cleaned)?"asset.png":cleaned;
 }
 static string CategoryFor(AtlasTile asset)
 {
  if(IsPrivate(asset))return "My Uploads";
  var text=$"{asset.Directory} {asset.Folder} {asset.Name}".ToLowerInvariant();
  if(text.Contains("mini"))return "Miniatures";
  if(text.Contains("rolling stock")||text.Contains("locomotive")||text.Contains("train"))return "Rolling Stock";
  if(text.Contains("pawn")||text.Contains("meeple"))return "Pawns & Meeples";
  if(text.Contains("token")||text.Contains("chit")||text.Contains("marker")||text.Contains("pin"))return "Tokens & Chits";
  if(text.Contains("scenery")||text.Contains("terrain")||text.Contains("building")||text.Contains("tree"))return "Scenery & Terrain";
  if(text.Contains("bit"))return "Bits";
  return "Tiles";
 }
 static string FolderFor(AtlasTile asset)=>string.IsNullOrWhiteSpace(asset.Folder)?(string.IsNullOrWhiteSpace(asset.Directory)?asset.Author:asset.Directory):asset.Folder;
 static string CropStyle(AtlasTile tile)=>tile.SourceWidth>0&&tile.SourceHeight>0&&tile.CropWidth>0&&tile.CropHeight>0
  ? $"width:{tile.SourceWidth*100.0/tile.CropWidth:0.###}%;height:{tile.SourceHeight*100.0/tile.CropHeight:0.###}%;left:{-tile.CropX*100.0/tile.CropWidth:0.###}%;top:{-tile.CropY*100.0/tile.CropHeight:0.###}%;max-width:none;"
  : "width:100%;height:100%;object-fit:contain;left:0;top:0;";
}
