@implements IDisposable
@inject WorldSession Session

@if(Session.TileBrowserOpen)
{
<section class="asset-slider-stack" aria-label="Tabletop assets">
 <div class="asset-main-rail desktop-arrow-slider" id="asset-main-rail" aria-label="Asset categories">
  <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#asset-main-rail',-1)" aria-label="Scroll asset categories left">‹</button>
  <div class="asset-horizontal-rail asset-category-rail">
   @foreach(var category in Categories)
   {
    <button type="button" class="asset-category-button @(_openCategory==category?"active":"")" @onclick="()=>ToggleCategory(category)" aria-expanded="@(_openCategory==category)">
     <span class="asset-category-art">
      @if(CategoryHero(category) is { } hero)
      {
       <span class="asset-category-image tile-image-crop"><img src="@hero.Image" style="@CropStyle(hero)" alt="" draggable="false" /></span>
      }
      else
      {
       <span class="asset-family-fallback" aria-hidden="true">@FamilyGlyph(category)</span>
      }
     </span>
     <strong>@category</strong>
    </button>
   }
  </div>
  <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#asset-main-rail',1)" aria-label="Scroll asset categories right">›</button>
 </div>

 @if(!string.IsNullOrWhiteSpace(_openCategory))
 {
  <div class="asset-child-rail" aria-label="@_openCategory folders">
   <button type="button" class="asset-collapse-left" @onclick="Collapse" aria-label="Collapse @_openCategory">‹</button>
   <span class="asset-rail-label">@_openCategory</span>
   <div class="asset-horizontal-rail">
    @foreach(var folder in _folderChoices)
    {
     <button type="button" class="asset-folder-button @(_folderKey==folder.Key?"active":"")" @onclick="()=>SelectFolder(folder.Key)">@folder.Label</button>
    }
   </div>
  </div>
  <div class="asset-child-rail asset-items-row" aria-label="@_openCategory assets">
   <span class="asset-rail-label">Assets</span>
   <div class="asset-horizontal-rail asset-item-rail">
    @foreach(var tile in _currentTiles)
    {
     <button type="button" class="asset-item-button" @onclick="()=>Session.StageTile(tile)" title="@tile.Name — @tile.Author">
      <span class="asset-item-image tile-image-crop"><img src="@tile.Image" style="@CropStyle(tile)" alt="" draggable="false" /></span>
      <strong>@tile.Name</strong>
     </button>
    }
    @if(_currentTiles.Count==0){<span class="asset-empty">No assets in this folder.</span>}
   </div>
  </div>
 }
</section>
}

<style>
.table-workspace>.tile-browser:not(.card-browser){display:none!important}
.map-viewer-overlays>.asset-slider-stack,.asset-slider-stack{position:absolute!important;left:8px!important;right:8px!important;top:8px!important;bottom:auto!important;z-index:42!important;box-sizing:border-box!important;display:grid!important;grid-template-rows:auto auto auto!important;gap:3px!important;width:auto!important;height:auto!important;min-height:0!important;max-height:190px!important;padding:3px 5px!important;margin:0!important;border:1px solid #8d6a28!important;border-radius:10px!important;background:#0b141bf2!important;color:#e8dcc0!important;overflow:hidden!important;pointer-events:none!important;box-shadow:0 6px 18px #0008!important}
.asset-slider-stack::before,.asset-slider-stack::after{content:none!important;display:none!important}
.asset-slider-stack button,.asset-slider-stack .asset-horizontal-rail{pointer-events:auto!important}
.asset-main-rail{position:relative!important;display:grid!important;grid-template-columns:30px minmax(0,1fr) 30px!important;align-items:stretch!important;gap:3px!important;min-width:0!important;height:64px!important;min-height:64px!important;overflow:hidden!important;background:transparent!important}
.asset-horizontal-rail{display:flex!important;gap:6px!important;min-width:0!important;overflow-x:auto!important;overflow-y:hidden!important;overscroll-behavior-inline:contain!important;scroll-snap-type:x proximity!important;-webkit-overflow-scrolling:touch!important;scrollbar-width:none!important;background:transparent!important}.asset-horizontal-rail::-webkit-scrollbar{display:none!important}.asset-horizontal-rail>*{flex:0 0 auto!important;scroll-snap-align:start!important}
.asset-category-rail{padding:1px 0!important}.asset-category-button{box-sizing:border-box!important;width:84px!important;height:60px!important;display:grid!important;grid-template-columns:38px 1fr!important;align-items:center!important;gap:4px!important;padding:4px!important;border:1px solid #675427!important;border-radius:8px!important;background:#101920!important;color:#d8c79d!important;text-align:left!important}.asset-category-button.active{border-color:#d0a63f!important;box-shadow:0 0 0 1px #d0a63f66,inset 0 0 14px #b8872030!important}.asset-category-art{position:relative!important;display:block!important;overflow:hidden!important;width:38px!important;height:50px!important;border-radius:6px!important;background:#071015!important}.asset-category-image{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;display:block!important}.asset-category-image img,.asset-item-image img{position:absolute!important}.asset-category-button strong{font:700 9px/1.05 system-ui!important;color:#e6d29d!important;overflow-wrap:anywhere!important}.asset-family-fallback{position:absolute!important;inset:0!important;display:grid!important;place-items:center!important;font:700 22px/1 Georgia,serif!important;color:#d7bb70!important;background:radial-gradient(circle,#263743,#091117 70%)!important}
.asset-child-rail{box-sizing:border-box!important;display:grid!important;grid-template-columns:auto auto minmax(0,1fr)!important;align-items:center!important;gap:5px!important;min-width:0!important;min-height:34px!important;max-height:34px!important;border-top:1px solid #4a402b!important;padding-top:3px!important;overflow:hidden!important;background:transparent!important}.asset-items-row{grid-template-columns:auto minmax(0,1fr)!important;min-height:76px!important;max-height:76px!important}.asset-collapse-left{width:28px!important;height:28px!important;border:1px solid #8d6a28!important;border-radius:7px!important;background:#101920!important;color:#d6b765!important;font-size:20px!important}.asset-rail-label{max-width:76px!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;color:#c5aa69!important;font:700 8px/1 system-ui!important;text-transform:uppercase!important;letter-spacing:.06em!important}.asset-folder-button{height:28px!important;min-width:76px!important;max-width:150px!important;padding:0 9px!important;border:1px solid #554a31!important;border-radius:7px!important;background:#111a21!important;color:#d9ceb3!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}.asset-folder-button.active{border-color:#c59b3b!important;background:#18232b!important;color:#f3dfaa!important}
.asset-item-rail{min-height:70px!important;max-height:70px!important}.asset-item-button{box-sizing:border-box!important;width:64px!important;height:66px!important;display:grid!important;grid-template-rows:48px auto!important;gap:2px!important;padding:3px!important;overflow:hidden!important;border:1px solid #4c432f!important;border-radius:7px!important;background:#0e171e!important;color:#ded3ba!important;text-align:left!important}.asset-item-image{position:relative!important;display:block!important;overflow:hidden!important;width:100%!important;height:48px!important;border-radius:4px!important;background:#080d11!important}.asset-item-button strong{overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;font-size:7px!important}.asset-empty{align-self:center!important;padding:8px 12px!important;color:#9b927f!important;font-size:10px!important;white-space:nowrap!important}
@@media(max-width:800px){.map-viewer-overlays>.asset-slider-stack,.asset-slider-stack{left:6px!important;right:6px!important;top:6px!important;max-height:186px!important;padding-inline:3px!important}.asset-main-rail{grid-template-columns:26px minmax(0,1fr) 26px!important}.asset-category-button{width:78px!important;height:58px!important;grid-template-columns:36px 1fr!important}.asset-category-art{width:36px!important;height:48px!important}.asset-rail-label{max-width:62px!important}.asset-folder-button{min-width:72px!important}.asset-item-button{width:62px!important}}
</style>

@code {
 static readonly string[] Categories=["Miniatures","Rolling Stock & Locomotives","Pawns & Meeples","Tokens & Chits","Tiles","Scenery & Terrain","Bits"];
 string _openCategory="";
 string _folderKey="";
 List<(string Key,string Label)> _folderChoices=[];
 List<AtlasTile> _currentTiles=[];
 IEnumerable<AtlasTile> AvailableTiles=>Session.AtlasTiles.Where(x=>!x.Id.StartsWith("naeja-map-",StringComparison.Ordinal));
 protected override void OnInitialized(){Session.Changed+=Changed;Refresh();}
 void Changed(){Refresh();_ = InvokeAsync(StateHasChanged);}
 public void Dispose()=>Session.Changed-=Changed;
 void ToggleCategory(string category){if(_openCategory==category){Collapse();return;}_openCategory=category;_folderKey="";RefreshFolders();}
 void Collapse(){_openCategory="";_folderKey="";_folderChoices.Clear();_currentTiles.Clear();}
 void SelectFolder(string key){_folderKey=key;RefreshTiles();}
 void Refresh(){if(string.IsNullOrWhiteSpace(_openCategory))return;RefreshFolders();}
 void RefreshFolders(){var items=AvailableTiles.Where(x=>CategoryFor(x)==_openCategory).ToList();_folderChoices=items.Select(x=>(Key:FolderFor(x),Label:FolderFor(x))).Distinct().OrderBy(x=>x.Label).ToList();if(_folderChoices.Count>0){if(!_folderChoices.Any(x=>x.Key==_folderKey))_folderKey=_folderChoices[0].Key;RefreshTiles();}else _currentTiles.Clear();}
 void RefreshTiles()=>_currentTiles=AvailableTiles.Where(x=>CategoryFor(x)==_openCategory&&FolderFor(x)==_folderKey).ToList();
 AtlasTile? CategoryHero(string category)=>AvailableTiles.FirstOrDefault(x=>CategoryFor(x)==category);
 static string CategoryFor(AtlasTile asset)
 {
  var text=$"{asset.Directory} {asset.Folder} {asset.Name}".ToLowerInvariant();
  if(text.Contains("mini"))return "Miniatures";
  if(text.Contains("rolling stock")||text.Contains("locomotive")||text.Contains("train"))return "Rolling Stock & Locomotives";
  if(text.Contains("pawn")||text.Contains("meeple"))return "Pawns & Meeples";
  if(text.Contains("token")||text.Contains("chit")||text.Contains("marker")||text.Contains("pin"))return "Tokens & Chits";
  if(text.Contains("scenery")||text.Contains("terrain")||text.Contains("building")||text.Contains("tree"))return "Scenery & Terrain";
  if(text.Contains("bit"))return "Bits";
  return "Tiles";
 }
 static string FolderFor(AtlasTile asset)=>string.IsNullOrWhiteSpace(asset.Folder)?(string.IsNullOrWhiteSpace(asset.Directory)?asset.Author:asset.Directory):asset.Folder;
 static string FamilyGlyph(string category)=>category switch{"Miniatures"=>"♟","Rolling Stock & Locomotives"=>"▰","Pawns & Meeples"=>"♙","Tokens & Chits"=>"●","Tiles"=>"◇","Scenery & Terrain"=>"▲","Bits"=>"◆",_=>"•"};
 static string CropStyle(AtlasTile tile)=>tile.SourceWidth>0&&tile.SourceHeight>0&&tile.CropWidth>0&&tile.CropHeight>0
  ? $"width:{tile.SourceWidth*100.0/tile.CropWidth:0.###}%;height:{tile.SourceHeight*100.0/tile.CropHeight:0.###}%;left:{-tile.CropX*100.0/tile.CropWidth:0.###}%;top:{-tile.CropY*100.0/tile.CropHeight:0.###}%;max-width:none;"
  : "width:100%;height:100%;object-fit:contain;left:0;top:0;";
}
