@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth
@inject AssetRatingClient Ratings

@if(Session.TileBrowserOpen)
{
<section class="map-asset-inventory" aria-label="Asset library">
 <header class="map-asset-toolbar">
  <div class="map-asset-title"><strong>Assets</strong><span>@FilteredTiles.Count asset@(FilteredTiles.Count==1?"":"s")</span></div>
  <input class="map-asset-search" type="search" placeholder="Search assets…" @bind="_query" @bind:event="oninput" aria-label="Search assets" />
  <button type="button" class="map-asset-filter-toggle @(_filtersOpen?"active":"")" @onclick="()=>_filtersOpen=!_filtersOpen" aria-expanded="@_filtersOpen">Filters</button>
  <button type="button" class="map-asset-upload @(!Session.IsLoggedIn?"disabled":"")" disabled="@(!Session.IsLoggedIn||_uploading)" @onclick="OpenUploadRating" title="@(Session.IsLoggedIn?"Rate and upload assets":"Log in to upload assets")">+ Upload</button>
  <button type="button" class="map-asset-close" @onclick="Close" aria-label="Close asset library">×</button>
 </header>

 @if(_filtersOpen)
 {
  <div class="map-asset-filters" aria-label="Asset filters">
   <select @bind="_source"><option value="all">All assets</option><option value="public">Shaelvien</option>@if(Session.IsLoggedIn){<option value="mine">My uploads</option>}</select>
   <select @bind="_category"><option value="all">All categories</option>@foreach(var item in CategoryChoices){<option value="@item">@item</option>}</select>
   <select @bind="_folder"><option value="all">All folders</option>@foreach(var item in FolderChoices){<option value="@item">@item</option>}</select>
   <button type="button" @onclick="ClearFilters">Clear</button>
  </div>
 }

 @if(!string.IsNullOrWhiteSpace(_status))
 {
  <div class="map-asset-status" role="status">@_status</div>
 }

 <div class="map-asset-grid">
  @foreach(var tile in FilteredTiles)
  {
   var rating=RatingFor(tile);
   <article class="map-asset-card @((IsPrivate(tile)?"private":"public"))">
    <button type="button" class="map-asset-choose" @onclick="()=>Choose(tile)" title="@tile.Name">
     <span class="map-asset-preview tile-image-crop"><img src="@tile.Image" style="@CropStyle(tile)" alt="" loading="lazy" draggable="false" /></span>
     <strong>@tile.Name</strong>
    </button>
    <div class="asset-rating-row">
     <span>@RatingLabel(rating)</span>
     @if(Session.IsLoggedIn && rating is not null)
     {
      <button type="button" @onclick="()=>OpenReport(tile,rating)">Report rating</button>
     }
    </div>
   </article>
  }
  @if(FilteredTiles.Count==0)
  {
   <div class="map-asset-empty">@(_loadingPrivate?"Loading your assets…":"No matching assets are allowed by your content settings.")</div>
  }
 </div>
</section>
}

@if(_uploadRatingOpen)
{
 <section class="asset-rating-modal" role="dialog" aria-modal="true" aria-label="Rate uploaded assets">
  <div class="asset-rating-dialog">
   <header><strong>Rate assets before upload</strong><button type="button" @onclick="CloseUploadRating">×</button></header>
   <p>The provider must describe the content before an asset enters the library. Choose <strong>General</strong> only when none of the mature-content reasons apply.</p>
   <label class="rating-choice general"><input type="checkbox" checked="@_providerGeneral" @onchange="e=>SetProviderGeneral(e.Value as bool?==true)" /><span><strong>General / none of these</strong><small>No mature-content descriptor applies.</small></span></label>
   <div class="rating-choices">
    @foreach(var descriptor in ContentAllowancePolicy.Descriptors)
    {
     <label class="rating-choice"><input type="checkbox" checked="@_providerDescriptors.Contains(descriptor.Id)" @onchange="e=>ToggleProviderDescriptor(descriptor.Id,e.Value as bool?==true)" /><span><strong>@descriptor.Label</strong><small>@descriptor.Reason</small></span></label>
    }
   </div>
   <div class="rating-upload-action @(!CanUploadRated?"disabled":"")">
    <span>@(CanUploadRated?"Choose images to add":"Choose a rating first")</span>
    <InputFile OnChange="UploadAssets" accept="image/png,image/webp,image/jpeg,image/gif" multiple disabled="@(!CanUploadRated||_uploading)" />
   </div>
   <small>These provider-selected reasons become the asset's initial restrictions. Users may report an incorrect rating.</small>
  </div>
 </section>
}

@if(_reportTile is not null && _reportRating is not null)
{
 <section class="asset-rating-modal" role="dialog" aria-modal="true" aria-label="Report asset rating">
  <div class="asset-rating-dialog">
   <header><strong>Suggest rating correction</strong><button type="button" @onclick="CloseReport">×</button></header>
   <p><strong>@_reportTile.Name</strong> is currently restricted for: <strong>@RatingReasons(_reportRating.EffectiveDescriptors)</strong>.</p>
   <p>Select what you believe the rating should say. Reports are queued for manual review. More than five different signed-in users reporting the asset automatically <strong>tightens</strong> restrictions while review is pending; reports can never automatically lower restrictions.</p>
   <label class="rating-choice general"><input type="checkbox" checked="@_reportGeneral" @onchange="e=>SetReportGeneral(e.Value as bool?==true)" /><span><strong>General / none of these</strong><small>I believe no mature-content descriptor applies.</small></span></label>
   <div class="rating-choices">
    @foreach(var descriptor in ContentAllowancePolicy.Descriptors)
    {
     <label class="rating-choice"><input type="checkbox" checked="@_reportDescriptors.Contains(descriptor.Id)" @onchange="e=>ToggleReportDescriptor(descriptor.Id,e.Value as bool?==true)" /><span><strong>@descriptor.Label</strong><small>@descriptor.Reason</small></span></label>
    }
   </div>
   <button type="button" class="rating-submit" disabled="@(!CanReport||_reporting)" @onclick="SubmitReportAsync">@(_reporting?"Sending…":"Submit rating report")</button>
  </div>
 </section>
}

