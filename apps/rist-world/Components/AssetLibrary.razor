@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth

@if(Session.TileBrowserOpen)
{
<section class="map-asset-inventory" aria-label="Asset library">
 <header class="map-asset-toolbar">
  <div class="map-asset-title"><strong>Assets</strong><span>@FilteredTiles.Count asset@(FilteredTiles.Count==1?"":"s")</span></div>
  <input class="map-asset-search" type="search" placeholder="Search assets…" @bind="_query" @bind:event="oninput" aria-label="Search assets" />
  <button type="button" class="map-asset-filter-toggle @(_filtersOpen?"active":"")" @onclick="()=>_filtersOpen=!_filtersOpen" aria-expanded="@_filtersOpen">Filters</button>
  <label class="map-asset-upload @(!Session.IsLoggedIn?"disabled":"")" title="@(Session.IsLoggedIn?"Upload to your private AWS asset storage":"Log in to upload assets")">
   <span>+ Upload</span>
   <InputFile OnChange="UploadAssets" accept="image/png,image/webp,image/jpeg,image/gif" multiple disabled="@(!Session.IsLoggedIn||_uploading)" />
  </label>
  <button type="button" class="map-asset-close" @onclick="Close" aria-label="Close asset library">×</button>
 </header>

 @if(_filtersOpen)
 {
  <div class="map-asset-filters" aria-label="Asset filters">
   <select @bind="_source"><option value="all">All assets</option><option value="public">Shaelvien</option>@if(Session.IsLoggedIn){<option value="mine">My uploads</option>}</select>
   <select @bind="_category"><option value="all">All categories</option>@foreach(var item in CategoryChoices){<option value="@item">@item</option>}</select>
   <select @bind="_folder"><option value="all">All folders</option>@foreach(var item in FolderChoices){<option value="@item">@item</option>}</select>
   <button type="button" @onclick="ClearFilters">Clear</button>
  </div>
 }

 @if(!string.IsNullOrWhiteSpace(_status))
 {
  <div class="map-asset-status" role="status">@_status</div>
 }

 <div class="map-asset-grid">
  @foreach(var tile in FilteredTiles)
  {
   <button type="button" class="map-asset-card @((IsPrivate(tile)?"private":"public"))" @onclick="()=>Choose(tile)" title="@tile.Name">
    <span class="map-asset-preview tile-image-crop"><img src="@tile.Image" style="@CropStyle(tile)" alt="" loading="lazy" draggable="false" /></span>
    <strong>@tile.Name</strong>
   </button>
  }
  @if(FilteredTiles.Count==0)
  {
   <div class="map-asset-empty">@(_loadingPrivate?"Loading your assets…":"No matching assets.")</div>
  }
 </div>
</section>
}

<style>
