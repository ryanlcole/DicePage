@inject WorldSession Session

@code {
    bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;

        try
        {
            await Session.ApplyLauncherStartupAsync();
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("Geonaph owner authority", StringComparison.OrdinalIgnoreCase))
        {
            // Do not crash startup for ordinary authenticated players when the
            // configured developer account is the only identity allowed to mutate
            // Geonaph. The launcher should still open normally; Geonaph edit authority
            // remains enforced at the action boundary.
        }
    }
}
