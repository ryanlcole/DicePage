@inject WorldSession Session

@code {
    bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;

        try
        {
            await Session.ApplyLauncherStartupAsync();
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("Geonaph owner authority", StringComparison.OrdinalIgnoreCase))
        {
            // Geonaph mutation authority is enforced where edits occur. A player who
            // is not the configured developer account must still be able to enter the
            // launcher and view the world instead of receiving a startup-wide failure.
        }
    }
}
