@implements IDisposable
@inject WorldSession Session

@code {
 bool _armed = true;
 bool _subscribed;

 protected override void OnInitialized()
 {
  Session.Changed += SessionChanged;
  _subscribed = true;
 }

 void SessionChanged()
 {
  if (!_armed || !Session.IsLoggedIn) return;
  _armed = false;
  _ = InvokeAsync(ApplyAsync);
 }

 async Task ApplyAsync()
 {
  try
  {
   await Session.ApplyLauncherStartupAsync();
  }
  finally
  {
   Unsubscribe();
  }
 }

 void Unsubscribe()
 {
  if (!_subscribed) return;
  Session.Changed -= SessionChanged;
  _subscribed = false;
 }

 public void Dispose() => Unsubscribe();
}
