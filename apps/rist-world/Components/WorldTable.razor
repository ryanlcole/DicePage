@implements IDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<style>
 /* Authoritative app shell: ticker -> public rail -> flexible map -> private Home slider.
    Legacy WorldHeader/HandRail/WorldFooter are intentionally not rendered on Home. */
 .world-context-strip{
  box-sizing:border-box!important;
  height:42px!important;min-height:42px!important;max-height:42px!important;
  margin:0!important;padding:0 4px!important;overflow:hidden!important;
  display:block!important;background:#071015!important;border-bottom:1px solid #725d30!important;
 }
 .world-context-track{
  box-sizing:border-box!important;width:100%!important;height:100%!important;min-width:0!important;
  display:flex!important;align-items:center!important;gap:12px!important;overflow:hidden!important;
 }
 .rist.release-world{
  --rist-public-h:84px;
  --rist-home-slider-h:58px;
  --rist-map-frame-h:42px;
  box-sizing:border-box!important;width:100%!important;
  height:calc(100dvh - 42px - 14px)!important;min-height:0!important;max-height:calc(100dvh - 42px - 14px)!important;
  overflow:hidden!important;background:#071015!important;
 }
 .rist.release-world>.release-world-shell{
  box-sizing:border-box!important;width:100%!important;height:100%!important;min-height:0!important;
  display:grid!important;grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:var(--rist-public-h) minmax(0,1fr) var(--rist-home-slider-h)!important;
  gap:0!important;overflow:hidden!important;
 }
 .rist.release-world .release-region{box-sizing:border-box!important;min-width:0!important;min-height:0!important;margin:0!important;padding:0!important;overflow:hidden!important}
 .rist.release-world .release-public-region{grid-row:1!important;width:100%!important;height:100%!important;min-height:0!important;overflow:hidden!important}
 .rist.release-world .release-public-region>.public-assets-rail{width:100%!important;height:100%!important;min-height:0!important;max-height:100%!important;overflow:hidden!important}
 .rist.release-world .release-map-region{grid-row:2!important;width:100%!important;height:100%!important;min-height:0!important;max-height:100%!important;overflow:hidden!important}
 .rist.release-world .release-map-region>.table-workspace{box-sizing:border-box!important;position:relative!important;width:100%!important;height:100%!important;min-width:0!important;min-height:0!important;max-width:100%!important;max-height:100%!important;display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,1fr)!important;margin:0!important;padding:0!important;overflow:hidden!important}
 .rist.release-world .release-map-region>.table-workspace>.staging-tray.pallet{display:none!important}
 .rist.release-world .release-map-region>.table-workspace>.map-shell{box-sizing:border-box!important;position:relative!important;grid-column:1!important;grid-row:1!important;width:100%!important;height:100%!important;min-width:0!important;min-height:0!important;max-width:100%!important;max-height:100%!important;display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:var(--rist-map-frame-h) minmax(0,1fr) var(--rist-map-frame-h)!important;margin:0!important;padding:0!important;overflow:hidden!important;background:#071015!important}
 .rist.release-world .release-map-region>.table-workspace>.map-shell>.map{box-sizing:border-box!important;position:relative!important;grid-column:1!important;grid-row:2!important;width:100%!important;height:100%!important;min-width:0!important;min-height:0!important;max-width:none!important;max-height:none!important;aspect-ratio:auto!important;margin:0!important;overflow:hidden!important}
 .rist.release-world .release-map-region>.table-workspace:has(>.encounter-control-rail){grid-template-rows:auto minmax(0,1fr)!important}
 .rist.release-world .release-map-region>.table-workspace:has(>.encounter-control-rail)>.map-shell{grid-row:2!important}
 .rist.release-world .release-private-region{grid-row:3!important;position:relative!important;box-sizing:border-box!important;display:block!important;width:100%!important;height:var(--rist-home-slider-h)!important;min-height:var(--rist-home-slider-h)!important;max-height:var(--rist-home-slider-h)!important;overflow:hidden!important;background:#0b1117!important;border-top:1px solid #725d30!important}
 .rist-app-home-slider{position:absolute!important;inset:0!important;z-index:50!important;box-sizing:border-box!important;display:flex!important;align-items:center!important;gap:8px!important;width:100%!important;height:100%!important;padding:5px 8px!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none!important;-webkit-overflow-scrolling:touch!important;touch-action:pan-x!important;background:#0b1117!important}
 .rist-app-home-slider::-webkit-scrollbar{display:none!important}
 .rist-app-slider-button{box-sizing:border-box!important;flex:0 0 auto!important;min-width:104px!important;height:46px!important;min-height:46px!important;padding:0 16px!important;border:1px solid #725d30!important;border-radius:12px!important;background:#111920!important;color:#e0c781!important;font:800 18px/1 system-ui,-apple-system,sans-serif!important;letter-spacing:.02em!important;white-space:nowrap!important;touch-action:manipulation!important}
 .rist-app-slider-button:active{transform:translateY(1px)!important;background:#172229!important}
</style>

<section class="world-context-strip" aria-label="World context">
 <div class="world-context-track" aria-label="World context ticker">
  <button type="button" class="world-context-action" data-context="stars"><strong>Stars:</strong> <span>EDIT</span></button>
  <button type="button" class="world-context-action" data-context="sky"><strong>Sky:</strong> <span>EDIT</span></button>
  <button type="button" class="world-context-action" data-context="cal"><strong>Cal:</strong> <span>EDIT</span></button>
  <button type="button" class="world-context-action" data-context="ugc"><strong>UGC:</strong> <span>EDIT</span></button>
  <span class="world-context-readout world-context-date"><strong>Date:</strong> <time>--</time></span>
  <span class="world-context-readout world-context-utc" data-context="utc"><strong>UTC:</strong> <time>--:--:--</time></span>
 </div>
</section>

<div class="rist release-world @(Session.IsLoggedIn?"auth-ready":"auth-visitor") public-assets-@Session.PublicAssetType">
 <span id="active-character-token-source" hidden data-front-token="@Session.CharacterFrontTokenDataUrl" data-character="@Session.CharacterName"></span>
 <main class="release-world-shell" aria-label="RIST world table">
  <section class="release-region release-public-region" aria-label="Public assets"><PublicCardRail /></section>
  <section class="release-region release-map-region map-viewer-region" aria-label="Recursive world map and menu viewer">
   <WorldMap />
   <div class="map-viewer-overlays" aria-live="polite">
    <CardLibraryViewerNav />
    <AccountAccessViewer />
    <AssetLibrary />
    <RecursionCockpit />
    <CharacterMixer />
    <MmoZoneActions />
    <RistWelcomeTutorial />
   </div>
  </section>
  <section class="release-region release-private-region" aria-label="Private Home slider">
   <nav id="rist-app-home-slider" class="rist-app-home-slider" aria-label="Private Home slider">
    <button type="button" class="rist-app-slider-button" data-slider-target="chat">Chat</button>
    <button type="button" class="rist-app-slider-button" data-slider-target="dice">Dice</button>
    <button type="button" class="rist-app-slider-button" data-slider-target="actors">Actors</button>
    <button type="button" class="rist-app-slider-button" data-slider-target="custom">Custom</button>
   </nav>
  </section>
 </main>
</div>

@code{
 readonly CancellationTokenSource _autosaveCts=new();
 protected override async Task OnInitializedAsync()
 {
  Session.Changed+=SessionChanged;
  IJSObjectReference? policy=null;
  try
  {
   policy=await JS.InvokeAsync<IJSObjectReference>("import","./session-policy.js");
   await policy.InvokeVoidAsync("restorePersistentSession");
  }
  catch(JSException){}
  await Session.InitializeAsync();
  if(policy is not null)
  {
   try{await policy.InvokeVoidAsync("applyEightHourSessionPolicy");}catch(JSException){}
   await policy.DisposeAsync();
  }
  await Session.LoadPrivateCheckpointAsync();
  _=AutosaveLoopAsync(_autosaveCts.Token);
 }
 async Task AutosaveLoopAsync(CancellationToken token)
 {
  try
  {
   using var timer=new PeriodicTimer(TimeSpan.FromSeconds(30));
   while(await timer.WaitForNextTickAsync(token))await Session.AutoSavePrivateAsync();
  }
  catch(OperationCanceledException){}
 }
 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose(){_autosaveCts.Cancel();_autosaveCts.Dispose();Session.Changed-=SessionChanged;}
}
