@implements IDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<section class="world-ticker" aria-label="World and real-time context">
 <div class="world-ticker-track">
  <span class="ticker-item" data-context="stars"><strong>Stars</strong><b>-</b></span>
  <span class="ticker-item" data-context="sky"><strong>Sky</strong><b>-</b></span>
  <span class="ticker-item" data-context="game-time"><strong>Game Time</strong><b>-</b></span>
  <span class="ticker-item" data-context="game-calendar"><strong>Game Calendar</strong><b>-</b></span>
  <span class="ticker-item world-context-utc" data-context="utc"><strong>UTC</strong><time>-</time></span>
  <span class="ticker-item world-context-date" data-context="date"><strong>Date</strong><time>-</time></span>
 </div>
</section>

<div class="rist release-world @(Session.IsLoggedIn?"auth-ready":"auth-visitor")">
 <span id="active-character-token-source" hidden data-front-token="@Session.CharacterFrontTokenDataUrl" data-character="@Session.CharacterName"></span>
 <main class="release-world-shell" aria-label="RIST world table">
  <section class="release-region release-map-region map-viewer-region" aria-label="Recursive world viewer">
   <div class="viewer-frame">
    <header class="viewer-frame-top" aria-label="Viewer identity">
     <span class="viewer-mode" data-world-mode="mmo">MMO</span>
     <strong class="viewer-world-name">@(string.IsNullOrWhiteSpace(Session.MapAlias)?"World":Session.MapAlias)</strong>
     <span class="viewer-role">@(Session.Role=="GM"?"GameMaster":"Roleplayer")</span>
    </header>
    <aside class="viewer-ruler viewer-ruler-y" aria-label="Y axis"><span>30</span><span>20</span><span>10</span><span>0</span></aside>
    <div class="viewer-map"><WorldMap /></div>
    <aside class="viewer-ruler viewer-ruler-z" aria-label="Z axis"><span>3</span><span>2</span><span>1</span><span>0</span></aside>
    <footer class="viewer-ruler viewer-ruler-x" aria-label="X axis"><span>0</span><span>10</span><span>20</span><span>30</span></footer>
   </div>
   <div class="map-viewer-overlays" aria-live="polite">
    <CardLibraryViewerNav />
    <AccountAccessViewer />
    <AssetLibrary />
    <RecursionCockpit />
    <CharacterMixer />
    <MmoZoneActions />
    <RistWelcomeTutorial />
   </div>
  </section>
  <section class="release-region release-footer-region" aria-label="Game tools and chat"><WorldDock /></section>
 </main>
</div>

@code{
 readonly CancellationTokenSource _autosaveCts=new();

 protected override async Task OnInitializedAsync()
 {
  Session.Changed+=SessionChanged;
  IJSObjectReference? policy=null;
  try
  {
   policy=await JS.InvokeAsync<IJSObjectReference>("import","./session-policy.js");
   await policy.InvokeVoidAsync("restorePersistentSession");
  }
  catch(JSException){}

  await Session.InitializeAsync();

  if(policy is not null)
  {
   try{await policy.InvokeVoidAsync("applyEightHourSessionPolicy");}
   catch(JSException){}
   await policy.DisposeAsync();
  }

  await Session.LoadPrivateCheckpointAsync();
  _=AutosaveLoopAsync(_autosaveCts.Token);
 }

 async Task AutosaveLoopAsync(CancellationToken token)
 {
  try
  {
   using var timer=new PeriodicTimer(TimeSpan.FromSeconds(30));
   while(await timer.WaitForNextTickAsync(token))await Session.AutoSavePrivateAsync();
  }
  catch(OperationCanceledException){}
 }

 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose(){_autosaveCts.Cancel();_autosaveCts.Dispose();Session.Changed-=SessionChanged;}
}
