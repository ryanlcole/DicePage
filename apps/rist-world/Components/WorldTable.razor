@implements IDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<style>
 /* Canonical vertical rhythm.
    One n is exactly the Stars/context row height. The map is the only p/flexible row. */
 .world-context-strip{
  box-sizing:border-box!important;
  height:42px!important;
  min-height:42px!important;
  max-height:42px!important;
  margin:0!important;
  display:grid!important;
  grid-template-columns:auto minmax(0,1fr) auto!important;
  align-items:stretch!important;
  gap:4px!important;
  padding:0 4px!important;
  overflow:hidden!important;
 }
 .world-context-track{
  box-sizing:border-box!important;
  min-width:0!important;
  height:100%!important;
  display:flex!important;
  align-items:stretch!important;
  gap:4px!important;
  overflow-x:auto!important;
  overflow-y:hidden!important;
  scrollbar-width:none!important;
  -webkit-overflow-scrolling:touch!important;
  touch-action:pan-x!important;
 }
 .world-context-track::-webkit-scrollbar{display:none!important}
 .world-context-menu,
 .world-context-login{
  box-sizing:border-box!important;
  align-self:center!important;
  flex:0 0 auto!important;
  height:22px!important;
  min-height:22px!important;
  max-height:22px!important;
  margin:0!important;
  padding:0 9px!important;
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  border:1px solid #725d30!important;
  border-radius:7px!important;
  background:#111920!important;
  color:#d7be80!important;
  font:800 10px/20px system-ui,-apple-system,sans-serif!important;
  white-space:nowrap!important;
 }
 .world-context-menu.active{border-color:#b6964e!important;background:#172229!important}
 .world-context-login{justify-self:end!important}
 /* Login now lives at the right edge of the Stars row. Keep the original
    Blazor button alive only as the account command source. */
 #header-slider .release-root-track>.door-button{display:none!important}

 .rist.release-world{
  --rist-n:42px!important;
  --rist-menu-h:calc(var(--rist-n) * 2)!important;
  --rist-assets-menu-h:var(--rist-n)!important;
  --rist-assets-slider-h:calc(var(--rist-n) * 2)!important;
  --rist-assets-h:calc(var(--rist-assets-menu-h) + var(--rist-assets-slider-h))!important;
  --rist-map-frame-h:var(--rist-n)!important;
  --rist-roleplay-h:calc(var(--rist-n) * 2)!important;
  --rist-chat-menu-h:var(--rist-n)!important;
  --rist-chat-compose-h:var(--rist-n)!important;
  --rist-legal-h:14px!important;
  --rist-footer-h:calc(var(--rist-roleplay-h) + var(--rist-chat-menu-h) + var(--rist-chat-compose-h) + var(--rist-legal-h))!important;
  --rist-rule:#725d30;
  box-sizing:border-box!important;
  width:100%!important;
  height:calc(100dvh - var(--rist-n))!important;
  min-height:0!important;
  max-height:calc(100dvh - var(--rist-n))!important;
  overflow:hidden!important;
 }
 .rist.release-world>.release-world-shell{
  box-sizing:border-box!important;
  width:100%!important;
  height:100%!important;
  min-height:0!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:var(--rist-menu-h) var(--rist-assets-h) minmax(0,1fr) var(--rist-assets-h) var(--rist-footer-h)!important;
  gap:0!important;
  overflow:hidden!important;
 }
 .rist.release-world .release-region{box-sizing:border-box!important;min-width:0!important;min-height:0!important;margin:0!important;padding:0!important;overflow:hidden!important}

 /* Menu = 2n. */
 .rist.release-world .release-menu-region,
 .rist.release-world .release-menu-region>#header-slider,
 .rist.release-world #header-slider .release-root-track{
  box-sizing:border-box!important;
  width:100%!important;
  height:var(--rist-menu-h)!important;
  min-height:var(--rist-menu-h)!important;
  max-height:var(--rist-menu-h)!important;
 }
 .rist.release-world #header-slider{position:relative!important;inset:auto!important;margin:0!important;overflow:hidden!important}
 .rist.release-world #header-slider .release-root-track{
  display:flex!important;
  align-items:center!important;
  overflow-x:auto!important;
  overflow-y:hidden!important;
  scrollbar-width:none!important;
  -webkit-overflow-scrolling:touch!important;
  touch-action:pan-x!important;
 }
 .rist.release-world #header-slider .release-root-track::-webkit-scrollbar{display:none!important}
 .rist.release-world #header-slider .release-root-track>.root-menu-button,
 .rist.release-world #header-slider .header-icon-button,
 .rist.release-world #header-slider .control,
 .rist.release-world #header-slider .scale-stack{
  box-sizing:border-box!important;
  flex:0 0 auto!important;
 }

 /* Public assets = menu n + slider 2n. */
 .rist.release-world .release-public-region,
 .rist.release-world .release-public-region>.public-assets-rail{
  box-sizing:border-box!important;
  width:100%!important;
  height:var(--rist-assets-h)!important;
  min-height:var(--rist-assets-h)!important;
  max-height:var(--rist-assets-h)!important;
 }
 .rist.release-world .release-public-region>.public-assets-rail{
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:var(--rist-assets-menu-h) var(--rist-assets-slider-h)!important;
 }
 .rist.release-world .release-public-region .asset-rail-header{
  box-sizing:border-box!important;
  grid-column:1!important;
  grid-row:1!important;
  width:100%!important;
  height:var(--rist-assets-menu-h)!important;
  min-height:var(--rist-assets-menu-h)!important;
  max-height:var(--rist-assets-menu-h)!important;
 }
 .rist.release-world .release-public-region .public-assets-strip{
  box-sizing:border-box!important;
  grid-column:1!important;
  grid-row:2!important;
  width:100%!important;
  height:var(--rist-assets-slider-h)!important;
  min-height:var(--rist-assets-slider-h)!important;
  max-height:var(--rist-assets-slider-h)!important;
 }

 /* Private assets = menu n + slider 2n. */
 .rist.release-world .release-private-region,
 .rist.release-world .release-private-region>.private-assets-rail{
  box-sizing:border-box!important;
  width:100%!important;
  height:var(--rist-assets-h)!important;
  min-height:var(--rist-assets-h)!important;
  max-height:var(--rist-assets-h)!important;
 }
 .rist.release-world .release-private-region>.private-assets-rail{
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:var(--rist-assets-menu-h) var(--rist-assets-slider-h)!important;
 }
 .rist.release-world .release-private-region .asset-rail-header{
  box-sizing:border-box!important;
  grid-column:1!important;
  grid-row:1!important;
  width:100%!important;
  height:var(--rist-assets-menu-h)!important;
  min-height:var(--rist-assets-menu-h)!important;
  max-height:var(--rist-assets-menu-h)!important;
 }
 .rist.release-world .release-private-region .private-assets-strip{
  box-sizing:border-box!important;
  grid-column:1!important;
  grid-row:2!important;
  width:100%!important;
  height:var(--rist-assets-slider-h)!important;
  min-height:var(--rist-assets-slider-h)!important;
  max-height:var(--rist-assets-slider-h)!important;
 }

 /* Map is the p row: it owns every pixel left after fixed rows. */
 .rist.release-world .release-map-region{
  box-sizing:border-box!important;
  width:100%!important;
  height:100%!important;
  min-height:0!important;
  max-height:none!important;
  overflow:hidden!important;
 }
 .rist.release-world .release-map-region>.table-workspace{
  box-sizing:border-box!important;
  position:relative!important;
  width:100%!important;
  height:100%!important;
  min-width:0!important;
  min-height:0!important;
  max-width:100%!important;
  max-height:100%!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:minmax(0,1fr)!important;
  gap:0!important;
  margin:0!important;
  padding:0!important;
  overflow:hidden!important;
 }
 .rist.release-world .release-map-region>.table-workspace>.staging-tray.pallet{display:none!important}
 .rist.release-world .release-map-region>.table-workspace>.map-shell{
  box-sizing:border-box!important;
  position:relative!important;
  inset:auto!important;
  grid-column:1!important;
  grid-row:1!important;
  width:100%!important;
  height:100%!important;
  min-width:0!important;
  min-height:0!important;
  max-width:100%!important;
  max-height:100%!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:var(--rist-map-frame-h) minmax(0,1fr) var(--rist-map-frame-h)!important;
  padding:0!important;
  margin:0!important;
  overflow:hidden!important;
  background:#071015!important;
 }
 .rist.release-world .release-map-region>.table-workspace>.map-shell>.map{
  box-sizing:border-box!important;
  position:relative!important;
  inset:auto!important;
  grid-column:1!important;
  grid-row:2!important;
  width:100%!important;
  height:100%!important;
  min-width:0!important;
  min-height:0!important;
  max-width:none!important;
  max-height:none!important;
  aspect-ratio:auto!important;
  margin:0!important;
  overflow:hidden!important;
 }
 .rist.release-world .release-map-region>.table-workspace:has(>.encounter-control-rail){grid-template-rows:auto minmax(0,1fr)!important}
 .rist.release-world .release-map-region>.table-workspace:has(>.encounter-control-rail)>.map-shell{grid-row:2!important}

 /* Footer = roleplay 2n / chat menu 1n / chat 1n / copyright. */
 .rist.release-world .release-footer-region,
 .rist.release-world .release-footer-region>.release-footer-stack{
  box-sizing:border-box!important;
  width:100%!important;
  height:var(--rist-footer-h)!important;
  min-height:var(--rist-footer-h)!important;
  max-height:var(--rist-footer-h)!important;
  margin:0!important;
  overflow:hidden!important;
 }
 .rist.release-world .release-footer-region>.release-footer-stack{
  position:relative!important;
  inset:auto!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:var(--rist-roleplay-h) calc(var(--rist-chat-menu-h) + var(--rist-chat-compose-h)) var(--rist-legal-h)!important;
 }
 .rist.release-world .release-footer-stack>.inline-chat-output{
  box-sizing:border-box!important;
  grid-column:1!important;
  grid-row:1!important;
  width:100%!important;
  height:var(--rist-roleplay-h)!important;
  min-height:var(--rist-roleplay-h)!important;
  max-height:var(--rist-roleplay-h)!important;
  padding:8px 12px!important;
  overflow:hidden!important;
 }
 .rist.release-world .release-footer-stack>.footer-dock,
 .rist.release-world .release-footer-stack .home-inline-chat{
  box-sizing:border-box!important;
  grid-column:1!important;
  grid-row:2!important;
  width:100%!important;
  height:calc(var(--rist-chat-menu-h) + var(--rist-chat-compose-h))!important;
  min-height:calc(var(--rist-chat-menu-h) + var(--rist-chat-compose-h))!important;
  max-height:calc(var(--rist-chat-menu-h) + var(--rist-chat-compose-h))!important;
 }
 .rist.release-world .release-footer-stack .home-inline-chat{
  position:relative!important;
  inset:auto!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:var(--rist-chat-menu-h) var(--rist-chat-compose-h)!important;
 }
 .rist.release-world .release-footer-stack .chat-mode-rail{
  box-sizing:border-box!important;
  grid-row:1!important;
  width:100%!important;
  height:var(--rist-chat-menu-h)!important;
  min-height:var(--rist-chat-menu-h)!important;
  max-height:var(--rist-chat-menu-h)!important;
 }
 .rist.release-world .release-footer-stack .chat-compose-rail{
  box-sizing:border-box!important;
  grid-row:2!important;
  width:100%!important;
  height:var(--rist-chat-compose-h)!important;
  min-height:var(--rist-chat-compose-h)!important;
  max-height:var(--rist-chat-compose-h)!important;
 }
 .rist.release-world .release-footer-stack>.site-copyright-notice{
  box-sizing:border-box!important;
  grid-column:1!important;
  grid-row:3!important;
  width:100%!important;
  height:var(--rist-legal-h)!important;
  min-height:var(--rist-legal-h)!important;
  max-height:var(--rist-legal-h)!important;
  margin:0!important;
  border-bottom:0!important;
 }
</style>

<section class="world-context-strip" aria-label="World context">
 <button type="button" class="world-context-menu @(_contextMenuOpen?"active":"")" aria-pressed="@_contextMenuOpen" @onclick="ToggleContextMenu"><strong>Menu</strong></button>
 <div class="world-context-track" aria-label="World context slider">
  <button type="button" class="world-context-action" data-context="stars" onclick="window.RistWorldContext?.edit?.('stars')"><strong>Stars:</strong> <span>EDIT</span></button>
  <button type="button" class="world-context-action" data-context="sky" onclick="window.RistWorldContext?.edit?.('sky')"><strong>Sky:</strong> <span>EDIT</span></button>
  <button type="button" class="world-context-action" data-context="cal" onclick="window.RistWorldContext?.edit?.('cal')"><strong>Cal:</strong> <span>EDIT</span></button>
  <button type="button" class="world-context-action" data-context="ugc" onclick="window.RistWorldContext?.edit?.('ugc')"><strong>UGC:</strong> <span>EDIT</span></button>
  <span class="world-context-readout world-context-date"><strong>Date:</strong> <time>--</time></span>
  <button type="button" class="world-context-readout world-context-utc" data-context="utc" onclick="window.RistWorldContext?.openClock?.()"><strong>UTC:</strong> <time>--:--:--</time></button>
 </div>
 <button type="button" class="world-context-login" @onclick="ContextLoginClicked"><strong>@(Session.IsLoggedIn?"Log Out":"Login")</strong></button>
</section>

<div class="rist release-world @(Session.IsLoggedIn?"auth-ready":"auth-visitor") public-assets-@Session.PublicAssetType">
 <span id="active-character-token-source" hidden data-front-token="@Session.CharacterFrontTokenDataUrl" data-character="@Session.CharacterName"></span>

 <main class="release-world-shell" aria-label="RIST world table">
  <section class="release-region release-menu-region" aria-label="Main menu"><WorldHeader /></section>
  <section class="release-region release-public-region" aria-label="Public assets"><PublicCardRail /></section>
  <section class="release-region release-map-region map-viewer-region" aria-label="Recursive world map and menu viewer">
   <WorldMap />
   <div class="map-viewer-overlays" aria-live="polite">
    <CardLibraryViewerNav />
    <AccountAccessViewer />
    <AssetLibrary />
    <RecursionCockpit />
    <CharacterMixer />
    <MmoZoneActions />
    <RistWelcomeTutorial />
   </div>
  </section>
  <section class="release-region release-private-region" aria-label="Private assets"><HandRail /></section>
  <section class="release-region release-footer-region" aria-label="Character dice and chat"><WorldFooter /></section>
 </main>
</div>

@code{
 readonly CancellationTokenSource _autosaveCts=new();
 bool _contextMenuOpen;
 protected override async Task OnInitializedAsync()
 {
  Session.Changed+=SessionChanged;
  IJSObjectReference? policy=null;
  try
  {
   policy=await JS.InvokeAsync<IJSObjectReference>("import","./session-policy.js");
   await policy.InvokeVoidAsync("restorePersistentSession");
  }
  catch(JSException){}

  await Session.InitializeAsync();

  if(policy is not null)
  {
   try{await policy.InvokeVoidAsync("applyEightHourSessionPolicy");}
   catch(JSException){}
   await policy.DisposeAsync();
  }

  await Session.LoadPrivateCheckpointAsync();
  _=AutosaveLoopAsync(_autosaveCts.Token);
 }

 void ToggleContextMenu()=>_contextMenuOpen=!_contextMenuOpen;
 async Task ContextLoginClicked()
 {
  await JS.InvokeVoidAsync("eval","document.querySelector('#header-slider .door-button')?.click()");
 }

 async Task AutosaveLoopAsync(CancellationToken token)
 {
  try
  {
   using var timer=new PeriodicTimer(TimeSpan.FromSeconds(30));
   while(await timer.WaitForNextTickAsync(token))await Session.AutoSavePrivateAsync();
  }
  catch(OperationCanceledException){}
 }

 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose(){_autosaveCts.Cancel();_autosaveCts.Dispose();Session.Changed-=SessionChanged;}
}