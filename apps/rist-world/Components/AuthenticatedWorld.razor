@inject DiscordAuthClient Auth
@inject NavigationManager Navigation

@* Single-authority boundary: /Play owns account entry and profile creation.
   /Game only validates an existing session and mounts the protected runtime. *@
@if (!_ready)
{
 <main class="rist-auth-shell" aria-busy="true">
  <section class="rist-auth-card">
   <p class="rist-auth-kicker">SHAELVIEN</p>
   <h1>RIST MMO / Sandbox</h1>
   <p>Checking your session…</p>
  </section>
 </main>
}
else if (_authenticated)
{
 <LauncherStartupBridge />
 <WorldTable />
}
else
{
 <main class="rist-auth-shell" aria-busy="true">
  <section class="rist-auth-card">
   <p class="rist-auth-kicker">SHAELVIEN</p>
   <h1>RIST MMO / Sandbox</h1>
   <p>Returning to account entry…</p>
  </section>
 </main>
}

<style>
 .rist-auth-shell{
  box-sizing:border-box;
  min-height:100dvh;
  display:grid;
  place-items:center;
  padding:24px;
  background:#05090c;
  color:#e7edf0;
  font-family:system-ui,-apple-system,sans-serif;
 }
 .rist-auth-card{
  box-sizing:border-box;
  width:min(92vw,520px);
  padding:28px;
  border:1px solid #725d30;
  border-radius:14px;
  background:rgba(10,17,22,.94);
  box-shadow:0 18px 50px rgba(0,0,0,.45);
  text-align:center;
 }
 .rist-auth-kicker{margin:0;color:#d7be80;font-weight:900;letter-spacing:.18em}
 .rist-auth-card h1{margin:8px 0 22px;color:#d7be80;font-size:clamp(22px,5vw,34px)}
 .rist-auth-card p:last-child{margin:0;color:#cbd5da}
</style>

@code {
 bool _ready;
 bool _authenticated;
 bool _authStarted;

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if (!firstRender || _authStarted) return;
  _authStarted = true;

  var profile = await Auth.InitializeAsync();
  _authenticated = profile is not null;
  _ready = true;
  await InvokeAsync(StateHasChanged);

  if (!_authenticated)
   Navigation.NavigateTo("/Play/", forceLoad: true);
 }
}
