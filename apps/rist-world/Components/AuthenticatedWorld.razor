@using System.Text.Json
@inject DiscordAuthClient Auth
@inject WorldSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!_ready)
{
 <main class="rist-auth-shell" aria-busy="true" aria-live="polite">
  <section class="rist-auth-card">
   <p class="rist-auth-kicker">SHAELVIEN</p>
   <h1>RIST MMO / Sandbox</h1>
   <p>Checking your session…</p>
  </section>
 </main>
}
else if (_canEnter)
{
 @if(!_launchStarted)
 {
  <section class="rist-auth-start" aria-label="Shaelvien start screen">
   <img class="rist-auth-start-art" src="assets/branding/shaelvien-dragon-creation-startup-screen.png" alt="" aria-hidden="true" />
   <div class="rist-auth-start-shade" aria-hidden="true"></div>
   <div class="rist-auth-start-controls">
    @if(string.IsNullOrWhiteSpace(_privacyChoice))
    {
     <section class="rist-auth-privacy" aria-label="Cookies and storage choice">
      <strong>COOKIES &amp; STORAGE</strong>
      <p>Essential storage is required for sign-in, security and core game state. Optional storage remembers nonessential preferences. Shaelvien does not currently use advertising or analytics tracking.</p>
      <a href="privacy.html" target="_blank" rel="noopener">Privacy Policy</a>
      <div>
       <button type="button" @onclick="SetEssentialPrivacyAsync">ESSENTIAL ONLY</button>
       <button type="button" @onclick="SetOptionalPrivacyAsync">ALLOW OPTIONAL</button>
      </div>
     </section>
    }
    <button type="button" class="rist-auth-press-start" disabled="@string.IsNullOrWhiteSpace(_privacyChoice)" @onclick="BeginAuthenticatedLaunchAsync">PRESS START</button>
   </div>
  </section>
 }
 else if(!_launchWorldChosen)
 {
  <main class="rist-world-choice-root" aria-label="Choose a world">
   <div class="rist-world-choice-underlay" aria-hidden="true">
    <p class="rist-auth-kicker">SHAELVIEN</p>
    <h1>Choose a World</h1>
   </div>
   <WorldGate Open="true" RequireSelection="true" OnClose="CompleteWorldChoiceAsync" />
  </main>
 }
 else
 {
  <div class="rist-authenticated-root">
   <SiteTicker Context="SHAELVIEN" OnStartMenu="OpenStartMenu" />
   <div class="rist-authenticated-body">
    <PublicAlphaShell @ref="_alphaShell" />
   </div>
  </div>
 }

 @if (_termsRequired)
 {
  <section class="rist-terms-gate" role="dialog" aria-modal="true" aria-label="Terms agreement">
   <form class="rist-terms-card" @onsubmit="AcceptTermsAsync">
    <h1>Before You Play</h1>
    <p>Please review the policies that govern your Shaelvien account before agreeing.</p>
    <nav class="rist-terms-documents" aria-label="Required legal policies">
     <a href="/Game/terms.html" target="_blank" rel="noopener">
      <strong>READ TERMS OF SERVICE</strong>
      <span>Account use, alpha service, your content, prohibited use, security and other terms.</span>
     </a>
     <a href="/Game/privacy.html" target="_blank" rel="noopener">
      <strong>READ PRIVACY POLICY</strong>
      <span>What information is used, Discord authentication, storage, retention, security and your choices.</span>
     </a>
    </nav>
    <p class="rist-terms-hint">Each policy opens in a new tab so you can return here without losing your sign-in.</p>
    <label class="rist-terms-agree"><input type="checkbox" @bind="_termsChecked" required /> <span>I have reviewed and agree to the Terms of Service and Privacy Policy.</span></label>
    @if (!string.IsNullOrWhiteSpace(_termsError))
    {
     <p class="rist-terms-error">@_termsError</p>
    }
    <button type="submit" disabled="@(!_termsChecked || _savingTerms)">@(_savingTerms ? "Saving…" : "Agree & Continue")</button>
   </form>
  </section>
 }
}
else
{
 <main class="rist-auth-shell" aria-busy="true" aria-live="polite">
  <section class="rist-auth-card">
   <p class="rist-auth-kicker">SHAELVIEN</p>
   <h1>RIST MMO / Sandbox</h1>
   <p>Returning to the login provider…</p>
  </section>
 </main>
}

<style>
 .rist-authenticated-root{position:fixed;inset:0;display:flex;flex-direction:column;overflow:hidden;background:#05090c}
 .rist-auth-start{position:fixed;inset:0;z-index:2147483500;display:flex;align-items:flex-end;justify-content:center;box-sizing:border-box;overflow:hidden;padding:0 24px max(8vh,38px);isolation:isolate;background:#03050a;color:#f7e8b7}
 .rist-auth-start-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-3;transform:scale(1.04)}
 .rist-auth-start-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(180deg,transparent 0 48%,rgba(1,3,8,.10) 68%,rgba(1,3,8,.68) 100%);pointer-events:none}
 .rist-auth-start-controls{width:min(520px,92vw);display:grid;gap:10px;place-items:center;margin:0 0 2vh}
 .rist-auth-privacy{box-sizing:border-box;width:100%;display:grid;gap:9px;padding:12px 14px;border:1px solid rgba(183,150,75,.65);border-radius:12px;background:rgba(4,10,14,.80);backdrop-filter:blur(5px);color:#e9dfc4;text-align:center}
 .rist-auth-privacy strong{color:#f0d68e;font:900 10px/1 system-ui;letter-spacing:.12em}
 .rist-auth-privacy p{margin:0;color:#bcc7ca;font:600 10px/1.45 system-ui}.rist-auth-privacy a{width:max-content;justify-self:center;color:#f0d68e;font:800 9px/1 system-ui}
 .rist-auth-privacy div{display:grid;grid-template-columns:1fr 1fr;gap:8px}
 .rist-auth-privacy button{min-height:38px;border:1px solid #7b6739;border-radius:8px;background:rgba(11,22,29,.88);color:#efd99d;font:900 9px/1 system-ui;letter-spacing:.06em;touch-action:manipulation}
 .rist-auth-press-start{appearance:none;width:100%;min-height:48px;padding:0;border:0;background:transparent;color:#fff0b6;font:900 20px/1.1 ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;letter-spacing:.08em;text-align:center;text-shadow:0 3px 8px #000,0 0 12px #000;animation:rist-auth-start-pulse 1.45s steps(2,end) infinite;touch-action:manipulation}
 .rist-auth-press-start:disabled{opacity:.36;animation:none}
 .rist-auth-press-start:focus-visible,.rist-auth-privacy button:focus-visible{outline:2px dashed rgba(255,241,183,.9);outline-offset:4px}
 @@keyframes rist-auth-start-pulse{50%{opacity:.42}}
 @@media(prefers-reduced-motion:reduce){.rist-auth-press-start{animation:none}.rist-auth-start-art{transform:none}}
 .rist-authenticated-body{position:relative;flex:1 1 auto;min-width:0;min-height:0;overflow:hidden}
 .rist-authenticated-body .launcher-hub{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;min-height:0!important}
 .rist-authenticated-body .alpha-world-stage{height:100%!important;min-height:0!important}
 .rist-world-choice-root{position:fixed;inset:0;min-height:100dvh;background:radial-gradient(circle at 50% 18%,#102633 0,#071118 42%,#020609 100%);color:#e7edf0;font-family:system-ui,-apple-system,sans-serif}
 .rist-world-choice-underlay{position:absolute;inset:0;display:grid;place-content:center;text-align:center;opacity:.42}
 .rist-world-choice-underlay h1{margin:8px 0 0;color:#d7be80;font:600 clamp(28px,7vw,56px)/1 Georgia,serif}
 .rist-auth-shell{box-sizing:border-box;min-height:100dvh;display:grid;place-items:center;padding:24px;background:#05090c;color:#e7edf0;font-family:system-ui,-apple-system,sans-serif}
 .rist-auth-card{box-sizing:border-box;width:min(92vw,520px);padding:28px;border:1px solid #725d30;border-radius:14px;background:rgba(10,17,22,.94);box-shadow:0 18px 50px rgba(0,0,0,.45);text-align:center}
 .rist-auth-kicker{margin:0;color:#d7be80;font-weight:900;letter-spacing:.18em}
 .rist-auth-card h1{margin:8px 0 22px;color:#d7be80;font-size:clamp(22px,5vw,34px)}
 .rist-auth-card p:last-child{margin:0;color:#cbd5da}
 .rist-terms-gate{position:fixed;inset:0;z-index:2147483600;display:grid;place-items:center;padding:20px;background:rgba(3,7,12,.78);backdrop-filter:blur(5px)}
 .rist-terms-card{box-sizing:border-box;width:min(92vw,520px);padding:24px;border:1px solid #8d7440;border-radius:14px;background:#081016;color:#eee6d2;box-shadow:0 18px 55px #000b;font-family:system-ui,-apple-system,sans-serif}
 .rist-terms-card h1{margin:0 0 8px;color:#e5c878}
 .rist-terms-card p{color:#b8b09e;line-height:1.45}
 .rist-terms-documents{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0 10px}
 .rist-terms-documents a{display:grid;gap:7px;min-height:106px;padding:14px;border:1px solid #8d7440;border-radius:10px;background:#111d24;color:#ffe2a0;text-decoration:none;touch-action:manipulation}
 .rist-terms-documents a:focus-visible{outline:3px solid #ffe9ad;outline-offset:2px}
 .rist-terms-documents strong{font:900 13px/1.2 system-ui;letter-spacing:.04em}
 .rist-terms-documents span{color:#c5c1b5;font:600 11px/1.4 system-ui}
 .rist-terms-hint{margin:0 0 4px!important;color:#98a6aa!important;font-size:11px;line-height:1.4!important}
 .rist-terms-card .rist-terms-agree{display:flex;align-items:flex-start;gap:10px;margin:16px 0;color:#d7c58f;font-weight:800}
 .rist-terms-card input{width:22px;height:22px;flex:0 0 auto;margin-top:1px}
 .rist-terms-card button{width:100%;min-height:48px;margin-top:8px;border:1px solid #a68a4b;border-radius:8px;background:#17242b;color:#ffe9ad;font-weight:900}
 .rist-terms-card button:disabled{opacity:.48}
 .rist-terms-error{color:#ffb3a6!important;font-weight:700}
 @@media(max-width:520px){.rist-terms-card{padding:20px}.rist-terms-documents{grid-template-columns:1fr}.rist-terms-documents a{min-height:0;padding:12px}}
</style>

@code {
 PublicAlphaShell? _alphaShell;
 bool _ready;
 bool _canEnter;
 bool _authStarted;
 bool _launchStarted;
 bool _launchWorldChosen;
 string _privacyChoice="";
 bool _termsRequired;
 bool _termsChecked;
 bool _savingTerms;
 string _termsError="";

 void OpenStartMenu()=>_alphaShell?.OpenStartMenu();

 Task SetEssentialPrivacyAsync()=>SetPrivacyAsync("essential");
 Task SetOptionalPrivacyAsync()=>SetPrivacyAsync("optional");

 async Task SetPrivacyAsync(string choice)
 {
  try{_privacyChoice=await JS.InvokeAsync<string>("ristPrivacy.set",choice);}catch{_privacyChoice=choice=="optional"?"optional":"essential";}
  await InvokeAsync(StateHasChanged);
 }

 async Task BeginAuthenticatedLaunchAsync()
 {
  if(_termsRequired||string.IsNullOrWhiteSpace(_privacyChoice))return;
  try{await JS.InvokeAsync<bool[]>("ristLaunch.pressStart",string.Equals(_privacyChoice,"optional",StringComparison.Ordinal));}catch{}
  _launchStarted=true;
  await InvokeAsync(StateHasChanged);
 }

 async Task CompleteWorldChoiceAsync()
 {
  if(!Session.HasActiveWorld)return;
  // Resolve trusted world authority before exposing the launcher so authorized
  // GMs/owners do not see creation controls briefly rendered as inaccessible.
  await Session.RefreshTrustedWorldAuthorityAsync();
  _launchWorldChosen=true;
  await InvokeAsync(StateHasChanged);
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_authStarted)return;
  _authStarted=true;

  var profile=await Auth.InitializeAsync();
  Session.AdoptAuthentication(profile);
  _canEnter=profile is not null;
  if(_canEnter && Auth.Account is not null)
   await Session.RefreshMmoLandAsync(loadParcels:false);
  _termsRequired=_canEnter&&Auth.Account is not null&&Auth.Account.TermsAcceptedAtUtc==DateTimeOffset.MinValue;
  if(_canEnter)
  {
   try{await JS.InvokeVoidAsync("ristLaunch.clearLegacyStartState");}catch{}
   try{_privacyChoice=await JS.InvokeAsync<string?>("ristPrivacy.get")??"";}catch{}
  }
  _ready=true;
  await InvokeAsync(StateHasChanged);

  if(!_canEnter)
   Navigation.NavigateTo("/Play/index.html",forceLoad:true);
 }

 async Task AcceptTermsAsync()
 {
  _termsError="";
  if(!_termsChecked){_termsError="You must agree before continuing.";return;}
  if(Auth.Account is null){_termsError="Your account is not ready yet. Please log in again.";return;}

  _savingTerms=true;
  try
  {
   var updated=Auth.Account with
   {
    TermsAcceptedAtUtc=DateTimeOffset.UtcNow,
    TermsVersion="2026-08-30"
   };
   await Auth.UploadTextAsync("account/profile.json",JsonSerializer.Serialize(updated),"application/json");
   _termsRequired=false;
  }
  catch
  {
   _termsError="Your agreement could not be saved. Please try again.";
  }
  finally
  {
   _savingTerms=false;
   await InvokeAsync(StateHasChanged);
  }
 }
}
