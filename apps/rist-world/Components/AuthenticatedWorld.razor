 .rist-policy-complete{display:block!important;width:100%!important;min-height:48px!important;margin:8px 0 4px!important;border:2px solid #8d7440!important;border-radius:8px!important;background:#fff9e8!important;color:#3b2b0f!important;font:900 12px/1.2 system-ui!important;letter-spacing:.05em!important;touch-action:manipulation!important}
 .rist-policy-complete:focus-visible{outline:3px solid #5a3e00!important;outline-offset:2px}
 .rist-policy-status{margin:0!important;color:#d4c49c!important;font-size:11px!important;line-height:1.35!important;text-align:center}
 .rist-terms-card .rist-terms-agree{display:flex;align-items:flex-start;gap:10px;margin:14px 0 8px;color:#d7c58f;font-weight:800}
 .rist-terms-card .rist-terms-agree[aria-disabled="true"]{opacity:.52}
 .rist-terms-card input{width:22px;height:22px;flex:0 0 auto;margin-top:1px}
 .rist-terms-card button{width:100%;min-height:48px;margin-top:8px;border:1px solid #a68a4b;border-radius:8px;background:#17242b;color:#ffe9ad;font-weight:900}
 .rist-terms-card button:disabled{opacity:.42}
 .rist-terms-error{margin:2px 0!important;color:#ffb3a6!important;font-weight:700}
 @@media(max-width:520px){.rist-terms-gate{padding:12px}.rist-terms-card{width:96vw;max-height:94dvh;padding:16px}.rist-policy-scroll{min-height:260px;max-height:54dvh;padding:14px}.rist-policy-scroll h1{font-size:21px}.rist-policy-scroll h2{font-size:15px}}
</style>

@code {
 PublicAlphaShell? _alphaShell;
 bool _ready;
 bool _canEnter;
 bool _authStarted;
 bool _launchStarted;
 bool _launchWorldChosen;
 string _privacyChoice="";
 bool _termsRequired;
 bool _termsChecked;
 bool _savingTerms;
 bool _policyLoaded;
 bool _policiesRead;
 string _policyHtml="";
 string _policyLoadError="";
 string _termsError="";
 string _commerceNotice="";
 ElementReference _policyScroll;
 static readonly DateTimeOffset ExistingAdultConsentGrandfatherCutoffUtc =
  new(2026,9,20,0,25,0,TimeSpan.Zero);

 void OpenStartMenu()=>_alphaShell?.OpenStartMenu();

 static bool IsGrandfatheredAdultConsentAttempt(DiscordAuthClient.AccountProfile account)
  => account.TermsAcceptedAtUtc==DateTimeOffset.MinValue
   && account.AgeAtSignup is >=18
   && account.CreatedAtUtc < ExistingAdultConsentGrandfatherCutoffUtc;

 Task SetEssentialPrivacyAsync()=>SetPrivacyAsync("essential");
 Task SetOptionalPrivacyAsync()=>SetPrivacyAsync("optional");

 async Task SetPrivacyAsync(string choice)
 {
  try{_privacyChoice=await JS.InvokeAsync<string>("ristPrivacy.set",choice);}catch{_privacyChoice=choice=="optional"?"optional":"essential";}
  await InvokeAsync(StateHasChanged);
 }

 async Task BeginAuthenticatedLaunchAsync()
 {
  if(_termsRequired||string.IsNullOrWhiteSpace(_privacyChoice))return;
  try{await JS.InvokeAsync<bool[]>("ristLaunch.pressStart",string.Equals(_privacyChoice,"optional",StringComparison.Ordinal));}catch{}
  _launchStarted=true;
  await InvokeAsync(StateHasChanged);
  await EnterMmoLandingAsync();
 }

 async Task EnterMmoLandingAsync()
 {
  try
  {
   var directory=await Session.LoadWorldDirectoryAsync();
   var mmoWorlds=directory.Worlds.Where(WorldSession.IsMmoWorldReference).ToList();
   var world=mmoWorlds.FirstOrDefault(item=>string.Equals(item.WorldId,directory.ActiveWorldId,StringComparison.Ordinal))
      ??mmoWorlds.FirstOrDefault(item=>string.Equals(item.WorldId,Session.WorldId,StringComparison.Ordinal))
      ??mmoWorlds.FirstOrDefault();

   if(world is null)
   {
    _commerceNotice="No Shaelvien MMO world is currently available.";
    return;
   }

   if(!Session.HasActiveWorld||!string.Equals(Session.WorldId,world.WorldId,StringComparison.Ordinal))
    await Session.LoadWorldAsync(world);

   // Resolve trusted world authority before exposing the launcher so authorized
   // GMs/owners do not see creation controls briefly rendered as inaccessible.
   await Session.RefreshTrustedWorldAuthorityAsync();
   _launchWorldChosen=true;
  }
  catch(Exception ex)
  {
   _commerceNotice="Shaelvien MMO navigation could not be loaded: "+ex.Message;
  }
  await InvokeAsync(StateHasChanged);
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_authStarted)return;
  _authStarted=true;

  var profile=await Auth.InitializeAsync();
  Session.AdoptAuthentication(profile);
  _canEnter=profile is not null;
  if(_canEnter && Auth.Account is not null)
  {
   await Session.RefreshCommercialEntitlementsAsync();
   await RedeemPendingCommerceAccessAsync();
   await Session.RefreshMmoLandAsync(loadParcels:false);
  }
  _termsRequired=_canEnter
   && Auth.Account is not null
   && Auth.Account.TermsAcceptedAtUtc==DateTimeOffset.MinValue
   && !IsGrandfatheredAdultConsentAttempt(Auth.Account);
  if(_termsRequired)
   await LoadPoliciesAsync();
  if(_canEnter)
  {
   try{await JS.InvokeVoidAsync("ristLaunch.clearLegacyStartState");}catch{}
   try{_privacyChoice=await JS.InvokeAsync<string?>("ristPrivacy.get")??"";}catch{}
  }
  _ready=true;
  await InvokeAsync(StateHasChanged);

  if(!_canEnter)
   Navigation.NavigateTo("/Play/index.html",forceLoad:true);
 }


 async Task RedeemPendingCommerceAccessAsync()
 {
  var code=QueryValue(Navigation.Uri,"access");
  if(string.IsNullOrWhiteSpace(code))
  {
   try{code=(await JS.InvokeAsync<string?>("sessionStorage.getItem","rist.commerce.accessCode"))?.Trim()??"";}catch{}
  }
  if(string.IsNullOrWhiteSpace(code))return;

  try
  {
   var authority=new AwsAuthorityClient(Http,Auth);
   await authority.InitializeAsync();
   var result=await authority.RedeemCommerceInviteAsync(code);
   if(result?.Ok==true)
   {
    _commerceNotice=result.AlreadyRedeemed
     ?"Complimentary access is already active on this account."
     :"Complimentary access has been applied to this account.";
    await Session.RefreshCommercialEntitlementsAsync();
    try{await JS.InvokeVoidAsync("sessionStorage.removeItem","rist.commerce.accessCode");}catch{}
   }
   else
   {
    _commerceNotice="The complimentary access link could not be applied.";
   }
  }
  catch(HttpRequestException ex)
  {
   _commerceNotice=ex.Message;
  }
  catch
  {
   _commerceNotice="The complimentary access link could not be verified. Existing account access is unchanged.";
  }
 }

 static string QueryValue(string uri,string key)
 {
  if(!Uri.TryCreate(uri,UriKind.Absolute,out var parsed))return "";
  foreach(var pair in parsed.Query.TrimStart('?').Split('&',StringSplitOptions.RemoveEmptyEntries))
  {
   var parts=pair.Split('=',2);
   if(parts.Length==0||!string.Equals(Uri.UnescapeDataString(parts[0]),key,StringComparison.OrdinalIgnoreCase))continue;
   return parts.Length>1?Uri.UnescapeDataString(parts[1].Replace("+"," ")).Trim():"";
  }
  return "";
 }

 async Task LoadPoliciesAsync()
 {
  _policyLoadError="";
  _policyLoaded=false;
  _policiesRead=false;
  _termsChecked=false;
  try
  {
   var terms=await Http.GetStringAsync("terms.html");
   var privacy=await Http.GetStringAsync("privacy.html");
   _policyHtml=ExtractPolicyBody(terms)+"<hr class=\"rist-policy-separator\" />"+ExtractPolicyBody(privacy);
   _policyLoaded=true;
  }
  catch
  {
   _policyHtml="";
   _policyLoadError="Please check your connection and retry. Agreement remains locked until both policies are available.";
  }
  await InvokeAsync(StateHasChanged);
 }

 static string ExtractPolicyBody(string html)
 {
  if(string.IsNullOrWhiteSpace(html)) return "";
  var bodyStart=html.IndexOf("<body",StringComparison.OrdinalIgnoreCase);
  if(bodyStart>=0)
  {
   bodyStart=html.IndexOf('>',bodyStart);
   if(bodyStart>=0) html=html[(bodyStart+1)..];
  }
  var bodyEnd=html.LastIndexOf("</body>",StringComparison.OrdinalIgnoreCase);
  if(bodyEnd>=0) html=html[..bodyEnd];
  var firstHeading=html.IndexOf("<h1",StringComparison.OrdinalIgnoreCase);
  if(firstHeading>=0) html=html[firstHeading..];
  html=Regex.Replace(html,"<div\\s+class=\\\"legal-nav\\\"[^>]*>.*?</div>","",RegexOptions.IgnoreCase|RegexOptions.Singleline);
  return html.Trim();
 }

 async Task RefreshPolicyReadAsync()
 {
  if(_policiesRead||!_policyLoaded)return;
  try
  {
   if(await JS.InvokeAsync<bool>("ristLegalConsent.atEnd",_policyScroll))
    _policiesRead=true;
  }
  catch{}
 }

 async Task OnPolicyScrollAsync()
 {
  if(_policiesRead||!_policyLoaded)return;
  await RefreshPolicyReadAsync();
  if(_policiesRead)
   await InvokeAsync(StateHasChanged);
 }

 async Task ConfirmPoliciesReadAsync()
 {
  if(!_policyLoaded)return;
  _policiesRead=true;
  _termsError="";
  await InvokeAsync(StateHasChanged);
 }

 async Task OnTermsChangedAsync(ChangeEventArgs e)
 {
  var requested=e.Value is bool b&&b;
  if(!requested)
  {
   _termsChecked=false;
   _termsError="";
   await InvokeAsync(StateHasChanged);
   return;
  }

  await RefreshPolicyReadAsync();
  if(!_policiesRead)
  {
   _termsChecked=false;
   _termsError="Please continue to END OF POLICIES, then check this box.";
  }
  else
  {
   _termsChecked=true;
   _termsError="";
  }
  await InvokeAsync(StateHasChanged);
 }

 async Task AcceptTermsAsync()
 {
  _termsError="";
  if(!_policiesRead){_termsError="Please read both policies through to the end before agreeing.";return;}
  if(!_termsChecked){_termsError="You must agree before continuing.";return;}
  if(Auth.Account is null){_termsError="Your account is not ready yet. Please log in again.";return;}

  _savingTerms=true;
  try
  {
   var updated=Auth.Account with
   {
    TermsAcceptedAtUtc=DateTimeOffset.UtcNow,
    TermsVersion="2026-08-30"
   };
   await Auth.UploadTextAsync("account/profile.json",JsonSerializer.Serialize(updated),"application/json");
   _termsRequired=false;
  }
  catch
  {
   _termsError="Your agreement could not be saved. Please try again.";
  }
  finally
  {
   _savingTerms=false;
   await InvokeAsync(StateHasChanged);
  }
 }
}
