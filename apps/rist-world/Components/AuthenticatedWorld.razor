@using System.Text.Json
@using System.Text.RegularExpressions
@inject DiscordAuthClient Auth
@inject WorldSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http

@if (!_ready)
{
 <main class="rist-auth-shell" aria-busy="true" aria-live="polite">
  <section class="rist-auth-card">
   <p class="rist-auth-kicker">SHAELVIEN</p>
   <h1>RIST MMO / Sandbox</h1>
   <p>Checking your session…</p>
  </section>
 </main>
}
else if (_canEnter)
{
 @if(!_launchStarted)
 {
  <section class="rist-auth-start" aria-label="Shaelvien start screen">
   <img class="rist-auth-start-art" src="assets/branding/shaelvien-dragon-creation-startup-screen.png" alt="" aria-hidden="true" />
   <div class="rist-auth-start-shade" aria-hidden="true"></div>
   <div class="rist-auth-start-controls">
    @if(!string.IsNullOrWhiteSpace(_commerceNotice))
    {
     <p class="rist-auth-commerce-notice" role="status" aria-live="polite">@_commerceNotice</p>
    }
    @if(string.IsNullOrWhiteSpace(_privacyChoice))
    {
     <section class="rist-auth-privacy" aria-label="Cookies and storage choice">
      <strong>COOKIES &amp; STORAGE</strong>
      <p>Essential storage is required for sign-in, security and core game state. Optional storage remembers nonessential preferences. Shaelvien does not currently use advertising or analytics tracking.</p>
      <a href="privacy.html" target="_blank" rel="noopener">Privacy Policy</a>
      <div>
       <button type="button" @onclick="SetEssentialPrivacyAsync">ESSENTIAL ONLY</button>
       <button type="button" @onclick="SetOptionalPrivacyAsync">ALLOW OPTIONAL</button>
      </div>
     </section>
    }
    <button type="button" class="rist-auth-press-start" disabled="@string.IsNullOrWhiteSpace(_privacyChoice)" @onclick="BeginAuthenticatedLaunchAsync">PRESS START</button>
   </div>
  </section>
 }
 else if(!_launchWorldChosen)
 {
  <main class="rist-world-choice-root" aria-busy="true" aria-live="polite">
   <div class="rist-world-choice-underlay">
    <p class="rist-auth-kicker">SHAELVIEN</p>
    <h1>Entering Shaelvien…</h1>
    <p>Loading your MMO world navigation.</p>
   </div>
  </main>
 }
 else
 {
  <div class="rist-authenticated-root">
   <SiteTicker Context="SHAELVIEN" OnStartMenu="OpenStartMenu" />
   <div class="rist-authenticated-body">
    <PublicAlphaShell @ref="_alphaShell" />
   </div>
  </div>
 }

 @if (_termsRequired)
 {
  <section class="rist-terms-gate" role="dialog" aria-modal="true" aria-label="Terms agreement">
   <form class="rist-terms-card" @onsubmit="AcceptTermsAsync">
    <h1>Before You Play</h1>
    <p>Please read the Terms of Service and Privacy Policy below. When you reach the end, you can confirm that you have read and agree to them.</p>
    @if (!string.IsNullOrWhiteSpace(_policyLoadError))
    {
     <div class="rist-policy-load-error" role="alert">
      <strong>Policies could not be loaded.</strong>
      <span>@_policyLoadError</span>
      <button type="button" @onclick="LoadPoliciesAsync">RETRY</button>
     </div>
    }
    else if (!_policyLoaded)
    {
     <div class="rist-policy-loading" role="status" aria-live="polite">Loading policies…</div>
    }
    else
    {
     <div class="rist-policy-scroll" @ref="_policyScroll" @onscroll="OnPolicyScrollAsync" tabindex="0" aria-label="Terms of Service and Privacy Policy. Read the policies and continue to the end.">
      @((MarkupString)_policyHtml)
      <div class="rist-policy-end">END OF POLICIES</div>
      <button type="button" class="rist-policy-complete" @onclick="ConfirmPoliciesReadAsync">I REACHED THE END — UNLOCK AGREEMENT</button>
     </div>
     <p class="rist-policy-status" aria-live="polite">@(_policiesRead ? "✓ Policies complete. You may now agree." : "Continue to END OF POLICIES, then tap UNLOCK AGREEMENT.")</p>
    }
    <label class="rist-terms-agree">
     <input type="checkbox" checked="@_termsChecked" @onchange="OnTermsChangedAsync" required />
     <span>I have read and agree to the Terms of Service and Privacy Policy.</span>
    </label>
    @if (!string.IsNullOrWhiteSpace(_termsError))
    {
     <p class="rist-terms-error">@_termsError</p>
    }
    <button type="submit" disabled="@(!_policiesRead || !_termsChecked || _savingTerms)">@(_savingTerms ? "Saving…" : "Agree & Continue")</button>
   </form>
  </section>
 }
}
else
{
 <main class="rist-auth-shell" aria-busy="true" aria-live="polite">
  <section class="rist-auth-card">
   <p class="rist-auth-kicker">SHAELVIEN</p>
   <h1>RIST MMO / Sandbox</h1>
   <p>Returning to the login provider…</p>
  </section>
 </main>
}

<style>
