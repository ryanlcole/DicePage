@inject WorldSession Session
@inject NavigationManager Navigation

<section class="card-index-workspace" aria-label="Shaelvien Card Index">
 <header class="card-index-header">
  <div>
   <p>SHAELVIEN · RIST</p>
   <h1>CARD INDEX</h1>
   <small>Your recursive card collection, card library, marketplace, and custom card creator.</small>
  </div>
  <span class="card-index-status">@(Session.IsLoggedIn ? "ACCOUNT SYNC" : "LOCAL PREVIEW")</span>
 </header>

 <nav class="card-index-tabs" aria-label="Card Index sections">
  <button type="button" class="@TabClass("cards")" @onclick="OpenCards"><strong>MY CARDS</strong><small>Owned & created</small></button>
  <button type="button" class="@TabClass("library")" @onclick="OpenLibrary"><strong>LIBRARY</strong><small>Browse card types</small></button>
  <button type="button" class="@TabClass("store")" @onclick="OpenStore"><strong>STORE</strong><small>Cards & asset packs</small></button>
  <button type="button" class="@TabClass("create")" @onclick="OpenCreate"><strong>CREATE</strong><small>Custom card</small></button>
 </nav>

 @if(_tab=="cards")
 {
  <section class="card-panel">
   <header><strong>MY CARDS</strong><small>Account-owned cards survive browser history, devices, and sessions once synced.</small></header>
   <div class="owned-card-grid">
    <article class="owned-card active-map-card">
     <div class="card-art-preview"><span>◈</span></div>
     <div class="owned-card-copy">
      <small>WORLD MAP CARD</small>
      <strong>@Session.WorldDisplayName</strong>
      <span>@Session.ActiveMapCardId</span>
      <footer><b>@(Session.ActiveMapCardPublished?"PUBLISHED":"PRIVATE")</b><em>@Session.PlacedTiles.Count tiles</em></footer>
     </div>
    </article>
    <article class="owned-card placeholder"><div class="card-art-preview"><span>＋</span></div><div class="owned-card-copy"><small>CARD SLOT</small><strong>Create or acquire cards</strong><span>Worlds, regions, actors, equipment, spells, lore and more appear here.</span></div></article>
   </div>
  </section>
 }
 else if(_tab=="library")
 {
  <section class="card-panel">
   <header><strong>CARD LIBRARY</strong><small>Canonical Shaelvien card classes. Cards are recursive containers and references, not copies of world truth.</small></header>
   <div class="card-type-grid">
    @foreach(var card in CardTypes)
    {
     <article><span>@card.Glyph</span><div><strong>@card.Name</strong><small>@card.Description</small></div></article>
    }
   </div>
  </section>
 }
 else if(_tab=="create")
 {
  <section class="card-panel creator-panel">
   <header><strong>CUSTOM CARD CREATOR</strong><small>Create original Shaelvien cards. Card identity and reconstruction data are embedded into Shaelvien-owned card data; artwork is never copied from another trading-card design.</small></header>
   <div class="creator-grid">
    <label><span>Card Type</span><select @bind="_draftType">@foreach(var card in CardTypes){<option value="@card.Name">@card.Name</option>}</select></label>
    <label><span>Name</span><input @bind="_draftName" maxlength="80" placeholder="Card name" /></label>
    <label class="creator-wide"><span>Description / Lore</span><textarea @bind="_draftText" maxlength="2000" placeholder="What this card represents..."></textarea></label>
    <label class="creator-wide"><span>Asset References</span><input @bind="_draftAssets" placeholder="Asset IDs, separated by commas" /></label>
   </div>
   <div class="creator-note"><strong>RECURSIVE DATA MARK</strong><span>The card's canonical ID, type, ownership/provenance, referenced object IDs and reconstruction manifest are designed to travel with the card representation. Future physical scanners can resolve that identity back to the authenticated digital object.</span></div>
   <button type="button" class="creator-save" disabled="@(string.IsNullOrWhiteSpace(_draftName))">SAVE DRAFT</button>
  </section>
 }

 <footer class="card-index-footer">
  <strong>RECURSIVE CARD CONTRACT</strong>
  <span>World → Region → Local → Instance → Encounter → Contents</span>
  <small>Published cards expose only the permitted reconstruction data. Account/private cards remain private. Asset packs are referenced by ID so maps and campaigns can be sold or shared without duplicating the underlying assets.</small>
 </footer>
</section>

<style>
 .card-index-workspace{box-sizing:border-box;height:100%;overflow:auto;padding:14px;background:#03080c;color:#dce5e8;font-family:Inter,system-ui,-apple-system,sans-serif}.card-index-header{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;padding:14px 16px;border:1px solid #725e35;border-radius:12px;background:#0a1218}.card-index-header p{margin:0 0 4px;color:#d9bd70;font:900 10px/1 system-ui;letter-spacing:.16em}.card-index-header h1{margin:0;color:#f0ddb0;font-size:24px;letter-spacing:.08em}.card-index-header small{display:block;margin-top:7px;color:#9eafb7}.card-index-status{flex:0 0 auto;padding:6px 9px;border:1px solid #47606d;border-radius:999px;color:#91bdd6;font:900 9px/1 system-ui;letter-spacing:.08em}.card-index-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0}.card-index-tabs button{min-height:54px;border:1px solid #344850;border-radius:9px;background:#09131a;color:#d7e1e4;display:grid;place-items:center;gap:2px}.card-index-tabs button.active{border-color:#d0aa56;background:#201b10}.card-index-tabs strong{font-size:10px;letter-spacing:.08em}.card-index-tabs small{font-size:8px;color:#8fa2ac}.card-panel{padding:12px;border:1px solid #344850;border-radius:10px;background:#071015}.card-panel>header{margin-bottom:10px}.card-panel>header strong,.card-panel>header small{display:block}.card-panel>header strong{color:#e2c77e;font-size:11px;letter-spacing:.1em}.card-panel>header small{margin-top:4px;color:#8fa2ac}.owned-card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}.owned-card{display:grid;grid-template-columns:76px minmax(0,1fr);gap:10px;min-height:108px;padding:9px;border:1px solid #40525b;border-radius:10px;background:#0a141b}.card-art-preview{display:grid;place-items:center;border:1px solid #755f36;border-radius:8px;background:radial-gradient(circle at 50% 42%,#243847,#091117 70%);color:#e5c97c;font-size:28px}.owned-card-copy{min-width:0;display:flex;flex-direction:column}.owned-card-copy small{color:#8fa9b6;font-size:8px;letter-spacing:.09em}.owned-card-copy strong{margin-top:4px;color:#f0ddb0}.owned-card-copy span{margin-top:4px;color:#8fa2ac;font-size:9px;overflow:hidden;text-overflow:ellipsis}.owned-card-copy footer{display:flex;justify-content:space-between;gap:8px;margin-top:auto}.owned-card-copy footer b{color:#d9bd70;font-size:8px}.owned-card-copy footer em{color:#8fa2ac;font-size:8px;font-style:normal}.card-type-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:8px}.card-type-grid article{display:grid;grid-template-columns:34px minmax(0,1fr);gap:8px;align-items:center;min-height:58px;padding:8px;border:1px solid #344850;border-radius:9px;background:#09131a}.card-type-grid article>span{display:grid;place-items:center;width:32px;height:32px;border:1px solid #725e35;border-radius:50%;color:#e2c77e}.card-type-grid strong,.card-type-grid small{display:block}.card-type-grid strong{color:#e8ddb9;font-size:10px;text-transform:uppercase}.card-type-grid small{margin-top:3px;color:#8fa2ac;font-size:8px;line-height:1.3}.creator-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.creator-grid label{display:grid;gap:5px}.creator-grid label>span{color:#9fb0b8;font-size:9px;font-weight:800}.creator-grid input,.creator-grid select,.creator-grid textarea{box-sizing:border-box;width:100%;border:1px solid #40525b;border-radius:7px;background:#0b151c;color:#e6ded0;padding:9px}.creator-grid textarea{min-height:90px;resize:vertical}.creator-wide{grid-column:1/-1}.creator-note{margin-top:10px;padding:10px;border:1px dashed #725e35;border-radius:8px}.creator-note strong,.creator-note span{display:block}.creator-note strong{color:#d9bd70;font-size:9px;letter-spacing:.09em}.creator-note span{margin-top:4px;color:#8fa2ac;font-size:9px;line-height:1.4}.creator-save{margin-top:10px;min-height:42px;padding:0 18px;border:1px solid #846c39;border-radius:8px;background:#171d18;color:#f0ddb0;font-weight:900}.creator-save:disabled{opacity:.4}.card-index-footer{margin-top:10px;padding:11px 13px;border:1px solid #3d4d54;border-radius:9px;background:#071015}.card-index-footer strong,.card-index-footer span,.card-index-footer small{display:block}.card-index-footer strong{color:#d9bd70;font-size:9px;letter-spacing:.12em}.card-index-footer span{margin-top:4px;color:#d6e0e4;font-size:10px}.card-index-footer small{margin-top:4px;color:#8fa2ac;font-size:9px;line-height:1.4}@@media(max-width:760px){.card-index-workspace{padding:8px}.card-index-header{display:block}.card-index-status{display:inline-block;margin-top:8px}.card-index-tabs{grid-template-columns:1fr 1fr}.card-type-grid{grid-template-columns:1fr 1fr}.creator-grid{grid-template-columns:1fr}.creator-wide{grid-column:auto}}
</style>

@code {
 string _tab="cards";
 string _draftType="World";
 string _draftName="";
 string _draftText="";
 string _draftAssets="";
 string TabClass(string tab)=>_tab==tab?"active":"";
 void OpenCards()=>_tab="cards";
 void OpenLibrary()=>_tab="library";
 void OpenCreate()=>_tab="create";
 void OpenStore(){_tab="store";Navigation.NavigateTo("/store/",forceLoad:true);}
 static readonly CardTypeInfo[] CardTypes=
 [
  new("World","◉","A complete world identity and its recursive children."),
  new("Region","▦","A world region with nested local areas."),
  new("Local","⌖","A local-scale place within a region."),
  new("Instance","◇","An instanced playable space."),
  new("Encounter","⚔","An encounter state, participants and replay context."),
  new("NPC","♟","A non-player character identity and state."),
  new("Monster","◆","A monster identity, rules and representations."),
  new("Creature","◈","A creature identity and behavior package."),
  new("Actor","♙","A playable or acting world entity."),
  new("Armor Piece","⬡","A single armor component."),
  new("Armor Set","✦","Ultra-rare recursive set referencing multiple armor pieces."),
  new("Weapon","†","A weapon identity and associated representations."),
  new("Enchantment","✧","An enchantment that can recursively modify other cards."),
  new("Spell","✺","A spell identity, rules and effects."),
  new("Lore","▤","Knowledge, provenance and world interpretation."),
  new("Asset Pack","▱","A sellable collection of referenced visual/audio assets.")
 ];
 sealed record CardTypeInfo(string Name,string Glyph,string Description);
}
