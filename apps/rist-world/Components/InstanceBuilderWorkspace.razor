@inject WorldSession Session
@inject AwsAuthorityClient Authority

<section class="instance-builder" aria-label="Instance Builder">
 <header class="instance-header">
  <div>
   <small>SHAELVIEN · RECURSIVE AUTHORING</small>
   <h1>INSTANCE · 45°</h1>
   <p>Local marker + touched asset → grid → signed elevation → surfaces. Layer = appearance. Tier = depth.</p>
  </div>
  <div class="instance-header-actions">
   @if(OnHome.HasDelegate){<button type="button" @onclick="()=>OnHome.InvokeAsync()">⌂ HOME</button>}
   @if(OnStartMenu.HasDelegate){<button type="button" @onclick="()=>OnStartMenu.InvokeAsync()">☰ MENU</button>}
  </div>
 </header>

 @if(!string.IsNullOrWhiteSpace(_status))
 {
  <div class="instance-status" role="status">@_status</div>
 }

 @if(_loading)
 {
  <div class="instance-empty"><strong>LOADING INSTANCE AUTHORITY…</strong></div>
 }
 else if(Session.DefinedLocals.Count==0)
 {
  <div class="instance-empty">
   <strong>CREATE A LOCAL FIRST</strong>
   <span>Instance Builder starts at a named marker inside a saved Local and an explicit asset that marker touches.</span>
  </div>
 }
 else
 {
  <div class="instance-shell">
   <aside class="instance-directory">
    <section class="instance-local-picker">
     <label>
      <span>LOCAL ROOT</span>
      <select value="@_localId" @onchange="ChangeLocalAsync" disabled="@_busy">
       @foreach(var local in Session.DefinedLocals.OrderBy(x=>x.Name,StringComparer.OrdinalIgnoreCase))
       {
        <option value="@local.LocalId">@local.Name</option>
       }
      </select>
     </label>
     <small>Only stable saved Local assets can become Instance root identities.</small>
    </section>

    <section class="instance-create">
     <header><strong>NEW INSTANCE</strong><small>Explicit root pair</small></header>
     <label><span>NAME</span><input maxlength="80" @bind="_newInstanceName" placeholder="Old Tavern" /></label>
     <label>
      <span>NAMED MARKER</span>
      <select @bind="_markerAssetId">
       <option value="">Choose Local marker…</option>
       @foreach(var item in MarkerReferences)
       {
        <option value="@item.AssetId">@item.Name · @item.Kind</option>
       }
      </select>
     </label>
     <label>
      <span>TOUCHED ASSET</span>
      <select @bind="_touchedAssetId">
       <option value="">Choose touched asset…</option>
       @foreach(var item in TouchedReferences)
       {
        <option value="@item.AssetId">@((item.IsLocalRoot?"ROOT · ":"")+item.Name) · @item.Kind</option>
       }
      </select>
     </label>
     <div class="instance-grid-create">
      <label><span>COLUMNS</span><input type="number" min="2" max="64" @bind="_newColumns" /></label>
      <label><span>ROWS</span><input type="number" min="2" max="64" @bind="_newRows" /></label>
      <label><span>GRID</span><select @bind="_newGridShape"><option value="square">Square</option><option value="hex">Hex</option></select></label>
     </div>
     <button type="button" class="primary" disabled="@(!CanCreateInstance||_busy)" @onclick="CreateInstanceAsync">CREATE INSTANCE</button>
    </section>

    <section class="instance-saved">
     <header><strong>SAVED INSTANCES</strong><small>@LocalInstances.Count</small></header>
     @if(LocalInstances.Count==0)
     {
      <p>No Instances use this Local yet.</p>
     }
     else
     {
      @foreach(var item in LocalInstances)
      {
       <article class="@(Active?.InstanceId==item.InstanceId?"active":"")">
        <button type="button" class="instance-open" disabled="@_busy" @onclick="()=>OpenInstanceAsync(item)">
         <span><strong>@item.Name</strong><small>@item.MarkerName → @item.TouchedAssetName</small></span>
         <b>OPEN</b>
        </button>
        <button type="button" class="instance-delete" disabled="@_busy" @onclick="()=>DeleteInstanceAsync(item)">×</button>
       </article>
      }
     }
    </section>
   </aside>

   <main class="instance-editor">
    @if(Active is null || _map is null)
    {
     <div class="instance-empty editor-empty">
      <strong>CHOOSE OR CREATE AN INSTANCE</strong>
      <span>The Instance root is a stable Local marker + touched asset pair. No parent geometry is copied.</span>
     </div>
    }
    else
    {
     <section class="instance-root-card">
      <div>
       <small>INSTANCE ROOT · RIST_RECURSIVE_SCOPE_V1</small>
       <h2>@Active.Name</h2>
       <p><b>@Active.MarkerName</b> → <b>@Active.TouchedAssetName</b></p>
      </div>
      <div class="root-facts">
       <span>LOCAL <b>@LocalName(Active.LocalId)</b></span>
       <span>VIEW <b>45°</b></span>
       <span>GRID <b>@_map.GridColumns × @_map.GridRows @_map.GridShape.ToUpperInvariant()</b></span>
      </div>
     </section>

     <section class="instance-toolbar">
      <label>
       <span>ELEVATION DISPLAY</span>
       <select @bind="_measurementUnit">
        <option value="ft">Feet</option>
        <option value="m">Meters</option>
        <option value="steps">Steps</option>
       </select>
      </label>
      <label>
       <span>PER STEP</span>
       <input type="number" min=".001" max="100000" step=".001" disabled="@(_measurementUnit=="steps")" @bind="_measurementPerStep" />
      </label>
      <button type="button" disabled="@_busy" @onclick="SaveMeasurementAsync">SAVE DISPLAY</button>
      <div><small>GEOMETRY</small><strong>SIGNED STEPS</strong><span>Every 10 steps = 1 parallax band</span></div>
     </section>

     <div class="instance-work-area">
      <section class="instance-board-shell" aria-label="45 degree Instance grid">
       <div class="instance-board-plane">
        <div class="instance-board @($"shape-{_map.GridShape}")" style="@BoardGridStyle">
         @for(var row=0;row<_map.GridRows;row++)
         {
          @for(var column=0;column<_map.GridColumns;column++)
          {
           var c=column;var r=row;
           var cell=WorldSession.InstanceCellAt(_map,c,r);
           var assetCount=AssetsAtCell(c,r);
           <button type="button"
                   class="@CellClass(c,r,cell)"
                   style="@CellStyle(cell)"
                   aria-label="@CellAria(cell,assetCount)"
                   @onclick="()=>SelectCell(c,r)">
            <span>@c,@r</span>
            <b>@(cell.ElevationSteps>=0?"+":"")@cell.ElevationSteps</b>
            @if(assetCount>0){<i>@assetCount</i>}
           </button>
          }
         }
        </div>
       </div>
      </section>

      <aside class="instance-cell-editor">
       <header>
        <div><small>CELL</small><strong>@_selectedColumn,@_selectedRow</strong></div>
        <div><small>PARALLAX BAND</small><strong>@WorldSession.InstanceElevationParallaxBand(_cellElevation)</strong></div>
       </header>

       <section class="elevation-controls">
        <div><span>ELEVATION</span><strong>@WorldSession.FormatInstanceElevation(_map,_cellElevation)</strong></div>
        <div class="elevation-buttons">
         <button type="button" @onclick="()=>AdjustElevation(-10)">−10</button>
         <button type="button" @onclick="()=>AdjustElevation(-1)">−1</button>
         <button type="button" @onclick="()=>AdjustElevation(1)">+1</button>
         <button type="button" @onclick="()=>AdjustElevation(10)">+10</button>
        </div>
       </section>

       <section class="terrain-editor">
        <label><span>TERRAIN</span><input @bind="_cellTerrain" placeholder="stone floor" /></label>
        <label><span>MOVEMENT COST</span><input type="number" min="0" max="1000" step=".25" @bind="_cellMovementCost" /></label>
        <label class="check"><input type="checkbox" @bind="_cellBlocksMovement" /><span>Blocks movement</span></label>
        <label class="check"><input type="checkbox" @bind="_cellBlocksSight" /><span>Blocks sight</span></label>
        <label><span>TAGS</span><input @bind="_cellTags" placeholder="wet, stairs, cover" /></label>
        <label><span>NOTES</span><textarea rows="3" @bind="_cellNotes"></textarea></label>
        <button type="button" class="primary" disabled="@_busy" @onclick="SaveCellAsync">SAVE CELL RULES</button>
       </section>

       <section class="surface-editor">
        <header><strong>VALID SURFACES</strong><small>@SelectedSurfaces.Count</small></header>
        <div class="surface-list">
         @foreach(var surface in SelectedSurfaces)
         {
          <button type="button" class="@(_selectedSurfaceId==surface.SurfaceId?"selected":"")" @onclick="()=>_selectedSurfaceId=surface.SurfaceId">
           <strong>@surface.Face.ToUpperInvariant()</strong>
           <small>@(surface.IsTop?"stable top":$"exposed step {surface.ElevationStep}")</small>
          </button>
         }
        </div>
       </section>

       <section class="instance-place-asset">
        <header><strong>PLACE ASSET REFERENCE</strong><small>New Instance placement identity</small></header>
        <label>
         <span>SOURCE</span>
         <select @bind="_placementSourceAssetId">
          <option value="">Choose Local asset…</option>
          @foreach(var item in _references)
          {
           <option value="@item.AssetId">@item.Name · @item.Kind</option>
          }
         </select>
        </label>
        <div class="instance-placement-address">
         <label><span>TIER</span><input type="number" min="1" @bind="_placementTier" /></label>
         <label><span>LAYER</span><input type="number" min="1" @bind="_placementLayer" /></label>
        </div>
        <button type="button" disabled="@(!CanPlaceReference||_busy)" @onclick="PlaceReferenceAsync">PLACE ON SELECTED SURFACE</button>
       </section>
      </aside>
     </div>

     <section class="instance-assets" aria-label="Instance asset layer list">
      <header>
       <div><strong>INSTANCE ASSETS · 45°</strong><small>Layer = appearance · Tier = depth</small></div>
       <label>
        <span>PERMISSION FOR</span>
        <select value="@_permissionPrincipal" @onchange="ChangePermissionPrincipal">
         @foreach(var principal in _principals){<option value="@principal.Id">@principal.Label</option>}
        </select>
       </label>
      </header>
      <div class="instance-asset-head"><span>V</span><span>L</span><span>ASSET</span><span>OPACITY</span><span>LAYER</span><span>TIER</span><span>SURFACE</span><span>PERMISSION</span></div>
      <div class="instance-asset-rows">
       @if(_map.Assets.Count==0)
       {
        <p>No Instance-owned placements yet. Place a Local asset reference onto a cell surface above.</p>
       }
       @foreach(var asset in _map.Assets.OrderByDescending(x=>x.Layer).ThenBy(x=>x.PlacementId,StringComparer.Ordinal))
       {
        <div class="instance-asset-row">
         <button type="button" class="icon" aria-pressed="@asset.Visible" @onclick="()=>TogglePlacementVisibleAsync(asset)">@(asset.Visible?"◉":"○")</button>
         <button type="button" class="icon" aria-pressed="@asset.Locked" @onclick="()=>TogglePlacementLockAsync(asset)">@(asset.Locked?"🔒":"🔓")</button>
         <div class="asset-name"><strong>@asset.Name</strong><small>@asset.PlacementId</small></div>
         <label class="asset-opacity"><span>@($"{Math.Round(asset.Opacity*100)}%")</span><input type="range" min="0" max="1" step=".05" value="@asset.Opacity" @onchange="e=>SetPlacementOpacityAsync(asset,e)" /></label>
         <div class="stepper"><button type="button" disabled="@(asset.Layer<=1)" @onclick="()=>MovePlacementLayerAsync(asset,-1)">−</button><span>@asset.Layer</span><button type="button" @onclick="()=>MovePlacementLayerAsync(asset,1)">+</button></div>
         <div class="stepper"><button type="button" disabled="@(asset.Tier<=1)" @onclick="()=>MovePlacementTierAsync(asset,-1)">−</button><span>@asset.Tier</span><button type="button" @onclick="()=>MovePlacementTierAsync(asset,1)">+</button></div>
         <code title="@asset.SurfaceId">@SurfaceShort(asset.SurfaceId)</code>
         <button type="button" class="permission" @onclick="()=>OpenPermissionAsync(asset)">@PermissionCell(asset)</button>
        </div>
       }
      </div>
      @if(PermissionPlacement is { } permissionAsset)
      {
       <footer class="instance-permission-editor">
        <div><strong>@permissionAsset.Name</strong><small>@_permissionPrincipal · @permissionAsset.PermissionResourceId</small></div>
        <select @bind="_permissionGrant">
         <option value="None">Waiting / inherited</option>
         @if(_permissionPrincipal=="EVERYONE"){<option value="Public">Public</option>}
         else{<option value="View">View</option><option value="Edit">Edit</option><option value="Deny">Deny</option>}
        </select>
        <button type="button" disabled="@_permissionBusy" @onclick="SavePermissionAsync">SAVE</button>
        <button type="button" @onclick="ClosePermission">×</button>
        @if(!string.IsNullOrWhiteSpace(_permissionStatus)){<span role="status">@_permissionStatus</span>}
       </footer>
      }
     </section>
    }
   </main>
  </div>
 }
</section>

