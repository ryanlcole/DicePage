 .instance-permission-editor{display:grid;grid-template-columns:minmax(0,1fr) 180px 60px 34px;gap:5px;align-items:center;padding:7px;border-top:1px solid #334952}.instance-permission-editor>div{display:grid;gap:2px;min-width:0}.instance-permission-editor strong,.instance-permission-editor small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.instance-permission-editor select,.instance-permission-editor button{height:32px;border:1px solid #40545e;border-radius:5px;background:#0a171e;color:#e4cf91}.instance-permission-editor>span{grid-column:1/-1;color:#8fb59c;font-size:7px}
 @@media(max-width:900px){.instance-shell{grid-template-columns:1fr;overflow:auto}.instance-directory{border-right:0;border-bottom:1px solid #30434c;max-height:none}.instance-work-area{grid-template-columns:1fr}.instance-board-shell{min-height:420px}.instance-asset-head{display:none}.instance-asset-row{grid-template-columns:32px 32px minmax(0,1fr) 80px;grid-template-areas:"vis lock name permission" "opacity opacity layer tier" "surface surface surface surface"}.instance-asset-row>.icon:first-child{grid-area:vis}.instance-asset-row>.icon:nth-child(2){grid-area:lock}.asset-name{grid-area:name}.asset-opacity{grid-area:opacity}.instance-asset-row>.stepper:nth-of-type(1){grid-area:layer}.instance-asset-row>.stepper:nth-of-type(2){grid-area:tier}.instance-asset-row code{grid-area:surface}.instance-asset-row .permission{grid-area:permission}.instance-permission-editor{grid-template-columns:1fr 34px}.instance-permission-editor>div,.instance-permission-editor select,.instance-permission-editor>button:first-of-type{grid-column:1}.instance-permission-editor>button:last-of-type{grid-column:2;grid-row:1}}
 @@media(max-width:600px){.instance-header{align-items:flex-start}.instance-header p{display:none}.instance-header-actions{flex-direction:column}.instance-editor{padding:5px}.instance-root-card{align-items:flex-start;flex-direction:column}.root-facts{justify-content:flex-start}.instance-board-shell{padding-left:10px;padding-right:10px}.instance-cell{width:40px;height:40px}.instance-assets>header{grid-template-columns:1fr}.instance-toolbar>div{margin-left:0;width:100%}}
</style>

@code {
 [Parameter] public EventCallback OnStartMenu { get; set; }
 [Parameter] public EventCallback OnHome { get; set; }

 bool _loading=true;
 bool _busy;
 string _status="";
 string _localId="";
 List<LocalInstanceAnchorReference> _references=[];
 WorldInstanceMapState? _map;

 string _newInstanceName="";
 string _markerAssetId="";
 string _touchedAssetId="";
 int _newColumns=12;
 int _newRows=12;
 string _newGridShape="square";

 int _selectedColumn;
 int _selectedRow;
 int _cellElevation;
 string _cellTerrain="";
 double _cellMovementCost=1;
 bool _cellBlocksMovement;
 bool _cellBlocksSight;
 string _cellTags="";
 string _cellNotes="";
 string _selectedSurfaceId="";

 string _measurementUnit="ft";
 double _measurementPerStep=5;

 string _placementSourceAssetId="";
 int _placementTier=1;
 int _placementLayer=1;

 readonly List<PermissionPrincipal> _principals=[new("EVERYONE","EVERYONE")];
 readonly Dictionary<string,string> _permissionCache=new(StringComparer.Ordinal);
 string _permissionPrincipal="EVERYONE";
 string _permissionPlacementId="";
 string _permissionGrant="None";
 string _permissionStatus="";
 bool _permissionBusy;

 WorldInstance? Active=>Session.ActiveInstance;
 IReadOnlyList<WorldInstance> LocalInstances=>Session.DefinedInstances
  .Where(item=>string.Equals(item.LocalId,_localId,StringComparison.Ordinal))
  .OrderBy(item=>item.Name,StringComparer.OrdinalIgnoreCase)
  .ToList();
 IEnumerable<LocalInstanceAnchorReference> MarkerReferences=>_references.Where(item=>!item.IsLocalRoot);
 IEnumerable<LocalInstanceAnchorReference> TouchedReferences=>_references.Where(item=>!string.Equals(item.AssetId,_markerAssetId,StringComparison.Ordinal));
 bool CanCreateInstance=>!string.IsNullOrWhiteSpace(_localId)&&!string.IsNullOrWhiteSpace(_newInstanceName)&&!string.IsNullOrWhiteSpace(_markerAssetId)&&!string.IsNullOrWhiteSpace(_touchedAssetId)&&!string.Equals(_markerAssetId,_touchedAssetId,StringComparison.Ordinal);
 IReadOnlyList<WorldInstanceSurface> SelectedSurfaces=>_map is null?[]:WorldSession.InstanceSurfacesForCell(_map,_selectedColumn,_selectedRow);
 bool CanPlaceReference=>_map is not null&&!string.IsNullOrWhiteSpace(_placementSourceAssetId)&&!string.IsNullOrWhiteSpace(_selectedSurfaceId);
 string BoardGridStyle=>_map is null?"":$"grid-template-columns:repeat({_map.GridColumns},46px)";
 WorldInstanceAssetPlacement? PermissionPlacement=>_map?.Assets.FirstOrDefault(item=>string.Equals(item.PlacementId,_permissionPlacementId,StringComparison.Ordinal));

 protected override async Task OnInitializedAsync()
 {
  try
  {
   await Session.LoadRegionsAsync();
   await Session.LoadLocalsAsync();
   await Session.LoadInstancesAsync();
   await LoadPermissionDirectoryAsync();

   if(Session.ActiveInstance is { } active)
   {
    _localId=active.LocalId;
    await LoadLocalReferencesAsync();
    await OpenInstanceAsync(active);
   }
   else
   {
    _localId=Session.ActiveLocal?.LocalId
     ??Session.DefinedLocals.FirstOrDefault()?.LocalId
     ??"";
    await LoadLocalReferencesAsync();
   }
  }
  catch(Exception ex){_status="INSTANCE LOAD ERROR · "+ex.Message;}
  finally{_loading=false;}
 }

 async Task ChangeLocalAsync(ChangeEventArgs e)
 {
  _localId=e.Value?.ToString()?.Trim()??"";
  Session.SetActiveLocal(_localId);
  Session.SetActiveInstance("");
  _map=null;
  _markerAssetId="";
  _touchedAssetId="";
  _placementSourceAssetId="";
  await LoadLocalReferencesAsync();
 }

 async Task LoadLocalReferencesAsync()
 {
  _references=_localId.Length==0
   ?[]
   :(await Session.LoadLocalInstanceReferencesAsync(_localId)).ToList();
  if(_placementSourceAssetId.Length>0&&_references.All(x=>x.AssetId!=_placementSourceAssetId))_placementSourceAssetId="";
 }

 async Task CreateInstanceAsync()
 {
  if(!CanCreateInstance||_busy)return;
  _busy=true;_status="";
  try
  {
   var instance=await Session.CreateInstanceAsync(
    _newInstanceName,_localId,_markerAssetId,_touchedAssetId,_newColumns,_newRows,_newGridShape);
   _newInstanceName="";
   _markerAssetId="";
   _touchedAssetId="";
   await OpenInstanceAsync(instance);
   _status="Instance created from explicit Local root identities.";
  }
  catch(Exception ex){_status="INSTANCE CREATE ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task OpenInstanceAsync(WorldInstance instance)
 {
  _busy=true;_status="";
  try
  {
   _localId=instance.LocalId;
   Session.SetActiveRegion(instance.RegionId);
   Session.SetActiveLocal(instance.LocalId);
   Session.SetActiveInstance(instance.InstanceId);
   await LoadLocalReferencesAsync();
   var source=await Session.LoadInstanceMapAsync(instance.InstanceId);
   _map=source?.State??WorldSession.DefaultInstanceMapState(instance);
   _measurementUnit=_map.MeasurementUnit;
   _measurementPerStep=_map.MeasurementPerStep;
   SelectCell(0,0);
  }
  catch(Exception ex){_status="INSTANCE OPEN ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task DeleteInstanceAsync(WorldInstance instance)
 {
  if(_busy)return;
  _busy=true;
  try
  {
   await Session.DeleteInstanceAsync(instance);
   if(Active is null)_map=null;
  }
  catch(Exception ex){_status="INSTANCE DELETE ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 void SelectCell(int column,int row)
 {
  if(_map is null)return;
  _selectedColumn=Math.Clamp(column,0,_map.GridColumns-1);
  _selectedRow=Math.Clamp(row,0,_map.GridRows-1);
  var cell=WorldSession.InstanceCellAt(_map,_selectedColumn,_selectedRow);
  _cellElevation=cell.ElevationSteps;
  _cellTerrain=cell.TerrainType;
  _cellMovementCost=cell.MovementCost;
  _cellBlocksMovement=cell.BlocksMovement;
  _cellBlocksSight=cell.BlocksSight;
  _cellTags=cell.Tags;
  _cellNotes=cell.Notes;
  _selectedSurfaceId=WorldSession.InstanceSurfaceId(_map.InstanceId,_selectedColumn,_selectedRow,"top",_cellElevation);
  _placementLayer=NextPlacementLayer(_placementTier);
 }

 void AdjustElevation(int delta)
 {
  _cellElevation=Math.Clamp(_cellElevation+delta,-1000,1000);
 }

 async Task SaveCellAsync()
 {
  if(_map is null||Active is null||_busy)return;
  _busy=true;_status="";
  try
  {
   var cell=WorldSession.NormalizeInstanceCell(new(
    _selectedColumn,_selectedRow,_cellElevation,_cellTerrain,_cellMovementCost,
    _cellBlocksMovement,_cellBlocksSight,_cellTags,_cellNotes));
   var cells=_map.Cells.Where(item=>item.Column!=_selectedColumn||item.Row!=_selectedRow).ToList();
   if(!cell.IsDefault)cells.Add(cell);
   _map=_map with{Cells=cells};
   await PersistMapAsync();
   _selectedSurfaceId=WorldSession.InstanceSurfaceId(_map.InstanceId,_selectedColumn,_selectedRow,"top",_cellElevation);
   _status="Cell geometry and terrain rules saved.";
  }
  catch(Exception ex){_status="CELL SAVE ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task SaveMeasurementAsync()
 {
  if(_map is null||Active is null||_busy)return;
  _busy=true;
  try
  {
   _map=_map with{
    MeasurementUnit=WorldSession.NormalizeInstanceMeasurementUnit(_measurementUnit),
    MeasurementPerStep=Math.Clamp(_measurementPerStep,.001,100000)
   };
   await PersistMapAsync();
   _measurementUnit=_map.MeasurementUnit;_measurementPerStep=_map.MeasurementPerStep;
   _status="Display measurement updated. Signed elevation steps were not changed.";
  }
  catch(Exception ex){_status="MEASUREMENT SAVE ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task PlaceReferenceAsync()
 {
  if(!CanPlaceReference||_map is null||Active is null||_busy)return;
  var source=_references.FirstOrDefault(item=>string.Equals(item.AssetId,_placementSourceAssetId,StringComparison.Ordinal));
  if(source is null)return;
  _busy=true;
  try
  {
   var tier=Math.Max(1,_placementTier);
   var layer=Math.Max(1,_placementLayer);
   var placementId=$"instance:{Active.InstanceId}:placement:{Guid.NewGuid():N}";
   var placement=new WorldInstanceAssetPlacement(
    placementId,source.AssetId,source.Name,source.Kind,
    _selectedColumn,_selectedRow,_selectedSurfaceId,tier,layer,
    1,true,false,"",WorldSession.RecursivePermissionResourceId(placementId));
   var assets=_map.Assets.ToList();assets.Add(placement);
   _map=_map with{Assets=assets};
   await PersistMapAsync();
   _placementLayer=NextPlacementLayer(tier);
   _status="Instance placement added to stable cell surface.";
  }
  catch(Exception ex){_status="PLACEMENT ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 int NextPlacementLayer(int tier)
  =>Math.Max(1,(_map?.Assets.Where(item=>item.Visible&&item.Tier==Math.Max(1,tier)).Select(item=>item.Layer).DefaultIfEmpty(0).Max()??0)+1);

 async Task PersistMapAsync()
 {
  if(_map is null||Active is null)return;
  var saved=await Session.SaveInstanceMapAsync(Active.InstanceId,_map);
  _map=saved.State;
 }

 int AssetsAtCell(int column,int row)=>_map?.Assets.Count(item=>item.Visible&&item.Column==column&&item.Row==row)??0;
 string CellClass(int column,int row,WorldInstanceCellState cell)
  =>$"instance-cell {(column==_selectedColumn&&row==_selectedRow?"selected ":"")}{(!cell.IsDefault?"has-rules":"")}";
 string CellStyle(WorldInstanceCellState cell)
  =>$"--elev:{Math.Clamp(cell.ElevationSteps,-40,40)};--rise:{Math.Clamp(Math.Abs(cell.ElevationSteps),0,20)}";
 string CellAria(WorldInstanceCellState cell,int assetCount)
  =>$"Cell {cell.Column}, {cell.Row}. Elevation {cell.ElevationSteps} steps. Parallax band {WorldSession.InstanceElevationParallaxBand(cell.ElevationSteps)}. {assetCount} assets.";
 string LocalName(string localId)=>Session.DefinedLocals.FirstOrDefault(item=>item.LocalId==localId)?.Name??localId;
 static string SurfaceShort(string value)
 {
  value=(value??"").Trim();
  var index=value.IndexOf(":surface:",StringComparison.Ordinal);
  return index>=0?value[(index+9)..]:value;
 }

 async Task TogglePlacementVisibleAsync(WorldInstanceAssetPlacement asset)
  =>await ReplacePlacementAsync(asset,asset with{Visible=!asset.Visible});
 async Task TogglePlacementLockAsync(WorldInstanceAssetPlacement asset)
  =>await ReplacePlacementAsync(asset,asset with{Locked=!asset.Locked});
 async Task MovePlacementLayerAsync(WorldInstanceAssetPlacement asset,int delta)
  =>await ReplacePlacementAsync(asset,asset with{Layer=Math.Max(1,asset.Layer+Math.Sign(delta))});
 async Task MovePlacementTierAsync(WorldInstanceAssetPlacement asset,int delta)
  =>await ReplacePlacementAsync(asset,asset with{Tier=Math.Max(1,asset.Tier+Math.Sign(delta))});
 async Task SetPlacementOpacityAsync(WorldInstanceAssetPlacement asset,ChangeEventArgs e)
 {
  var parsed=double.TryParse(e.Value?.ToString(),out var value)?value:asset.Opacity;
  await ReplacePlacementAsync(asset,asset with{Opacity=Math.Clamp(parsed,0,1)});
 }
 async Task ReplacePlacementAsync(WorldInstanceAssetPlacement current,WorldInstanceAssetPlacement next)
 {
  if(_map is null||Active is null||_busy)return;
  _busy=true;
  try
  {
   var assets=_map.Assets.Select(item=>item.PlacementId==current.PlacementId?next:item).ToList();
   _map=_map with{Assets=assets};
   await PersistMapAsync();
  }
  catch(Exception ex){_status="INSTANCE ASSET ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task LoadPermissionDirectoryAsync()
 {
  if(!Session.IsLoggedIn)return;
  try
  {
   var rows=await Authority.GetConnectionsAsync()??[];
   _principals.Clear();_principals.Add(new("EVERYONE","EVERYONE"));
   _principals.AddRange(rows
    .Where(row=>!string.IsNullOrWhiteSpace(row.LinkedUserId))
    .OrderBy(row=>row.DisplayName,StringComparer.OrdinalIgnoreCase)
    .Select(row=>new PermissionPrincipal(row.LinkedUserId,string.IsNullOrWhiteSpace(row.DisplayName)?row.LinkedUserId:row.DisplayName)));
  }
  catch{}
 }

 void ChangePermissionPrincipal(ChangeEventArgs e)
 {
  _permissionPrincipal=e.Value?.ToString()?.Trim()??"EVERYONE";
  if(!_principals.Any(item=>item.Id==_permissionPrincipal))_permissionPrincipal="EVERYONE";
  _permissionPlacementId="";
  _permissionGrant="None";
  _permissionStatus="";
 }

 string PermissionCell(WorldInstanceAssetPlacement asset)
 {
  var key=PermissionKey(asset.PermissionResourceId);
  return _permissionCache.TryGetValue(key,out var value)?PermissionLabel(value):"SET";
 }
 string PermissionKey(string resourceId)=>resourceId+"\u001f"+_permissionPrincipal;
 static string PermissionLabel(string value)=>value switch{"Public"=>"PUBLIC","View"=>"VIEW","Edit"=>"EDIT","Deny"=>"DENY",_=>"WAITING"};

 async Task OpenPermissionAsync(WorldInstanceAssetPlacement asset)
 {
  if(!Session.IsLoggedIn){_permissionStatus="Sign in to edit permissions.";return;}
  _permissionBusy=true;_permissionPlacementId=asset.PlacementId;_permissionStatus="";
  try
  {
   var rows=await Authority.GetResourcePermissionsAsync(Session.WorldId,asset.PermissionResourceId)??[];
   var current=rows.FirstOrDefault(item=>string.Equals(item.UserId,_permissionPrincipal,StringComparison.Ordinal));
   _permissionGrant=current?.Permission??"None";
   if(_permissionPrincipal=="EVERYONE"&&_permissionGrant!="Public")_permissionGrant="None";
   _permissionCache[PermissionKey(asset.PermissionResourceId)]=_permissionGrant;
  }
  catch(Exception ex){_permissionStatus="PERMISSION LOAD ERROR · "+ex.Message;}
  finally{_permissionBusy=false;}
 }

 async Task SavePermissionAsync()
 {
  var asset=PermissionPlacement;
  if(asset is null||!Session.IsLoggedIn||_permissionBusy)return;
  _permissionBusy=true;
  try
  {
   var grant=_permissionPrincipal=="EVERYONE"
    ?(_permissionGrant=="Public"?"Public":"None")
    :(_permissionGrant is "View" or "Edit" or "Deny"?_permissionGrant:"None");
   var result=await Authority.SetResourcePermissionAsync(Session.WorldId,asset.PermissionResourceId,_permissionPrincipal,grant);
   if(result?.Ok==true)
   {
    _permissionGrant=result.Permission;
    _permissionCache[PermissionKey(asset.PermissionResourceId)]=result.Permission;
    _permissionStatus=result.Permission=="None"?"Explicit grant removed; inherited/default authority applies.":"Permission saved.";
   }
   else _permissionStatus="Permission was not changed.";
  }
  catch(Exception ex){_permissionStatus="PERMISSION SAVE ERROR · "+ex.Message;}
  finally{_permissionBusy=false;}
 }

 void ClosePermission(){_permissionPlacementId="";_permissionStatus="";}

 sealed record PermissionPrincipal(string Id,string Label);
}
