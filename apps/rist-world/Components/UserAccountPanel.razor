@using System.Text.Json
@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth
@inject IJSRuntime JS

<button id="rist-user-account-open-bridge" type="button" style="display:none" @onclick="Open"></button>

@if(_open)
{
 <section class="rist-user-account-viewer @DomainClass" role="dialog" aria-modal="false" aria-label="User account">
  <header>
   <div><strong>User Account</strong><small>@RoleLabel · @DomainLabel</small></div>
   <button type="button" class="rist-user-account-close" @onclick="Close" aria-label="Close user account">×</button>
  </header>

  @if(!Session.IsLoggedIn)
  {
   <div class="rist-user-account-empty"><strong>Login required</strong><span>Your private profile, WorldFold details, plan, tokens, ratings, and notes appear here after login.</span></div>
  }
  else
  {
   <div class="rist-user-account-body">
    <section class="rist-user-account-card identity-card">
     <h3>Session</h3>
     <div class="account-pair"><span>Role</span><strong>@RoleLabel</strong></div>
     <div class="account-pair"><span>Domain</span><strong>@DomainLabel</strong></div>
    </section>

    <section class="rist-user-account-card worldfold-card">
     <h3>WorldFolds</h3>
     <div class="account-pair"><span>Zone ID</span><strong>@ZoneIdLabel</strong></div>
     <div class="account-pair"><span>Current coordinates</span><strong>@WorldFoldCoordinateLabel</strong></div>
     <div class="account-pair private-code-row"><span>Private code</span><strong>@(_showCode ? _privateProfile.WorldFoldPrivateCode : MaskCode(_privateProfile.WorldFoldPrivateCode))</strong></div>
     <button type="button" class="account-small-button" @onclick="()=>_showCode=!_showCode">@(_showCode?"Hide code":"Reveal code")</button>
     <small class="account-help">Zone ID is assigned by the system and cannot be edited. The WorldFold code is private account metadata, not a login credential.</small>
    </section>

    <section class="rist-user-account-card profile-card">
     <h3>Profile</h3>
     <div class="account-pair"><span>Display name</span><strong>@(Auth.Profile?.DisplayName ?? "—")</strong></div>
     <div class="account-pair"><span>Player alias</span><strong>@(Auth.Account?.PlayerAlias ?? "—")</strong></div>
     <div class="account-pair"><span>Member since</span><strong>@(Auth.Account is null ? "—" : Auth.Account.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd"))</strong></div>
    </section>

    <section class="rist-user-account-card economy-card">
     <h3>Account</h3>
     <div class="account-pair"><span>Current payment plan</span><strong>@PlanLabel</strong></div>
     <div class="account-pair"><span>Tokens</span><strong>—</strong></div>
     <small class="account-help">Token authority is not connected to this panel yet, so no balance is invented here.</small>
    </section>

    <section class="rist-user-account-card ratings-card">
     <h3>User Ratings</h3>
     <div class="account-pair"><span>RolePlayer rating</span><strong>Not rated</strong></div>
     <div class="account-pair"><span>GameMaster rating</span><strong>Not rated</strong></div>
     <div class="account-pair"><span>Reliability</span><strong>Not rated</strong></div>
    </section>

    <section class="rist-user-account-card notes-card">
     <h3>Custom Player Notes</h3>
     <textarea maxlength="1200" @bind="_privateProfile.CustomPlayerNotes" placeholder="Private world-specific notes, e.g. Player Points: 12"></textarea>
     <div class="notes-actions"><button type="button" @onclick="SaveNotesAsync" disabled="@_saving">@(_saving?"Saving…":"Save notes")</button><span>@_saveStatus</span></div>
    </section>
   </div>
  }
 </section>
}

<style>
.rist-user-account-selector{box-sizing:border-box;flex:0 0 auto;width:auto;min-width:0;height:30px;min-height:30px;max-height:30px;padding:0 12px;border:1px solid #725d30;border-radius:10px;background:#111920;color:#d7be80;font:800 10px/1 system-ui;letter-spacing:.05em;text-align:center;white-space:nowrap;touch-action:manipulation}
.rist-user-account-selector.mmo{border-color:#1bd66b;color:#75efaa}.rist-user-account-selector.sandbox{border-color:#4198ff;color:#8ac1ff}
.rist-user-account-viewer{position:fixed;left:12px;right:12px;top:calc(env(safe-area-inset-top) + 96px);bottom:160px;z-index:2147482200;display:grid;grid-template-rows:auto minmax(0,1fr);box-sizing:border-box;border:2px solid #725d30;border-radius:12px;background:#071015f5;color:#eee6d2;box-shadow:0 12px 40px #000b;overflow:hidden}
.rist-user-account-viewer.mmo{border-color:#1bd66b}.rist-user-account-viewer.sandbox{border-color:#4198ff}
.rist-user-account-viewer>header{box-sizing:border-box;min-height:48px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 10px;border-bottom:1px solid #725d30;background:#0b141b}.rist-user-account-viewer>header>div{display:grid;gap:2px}.rist-user-account-viewer>header strong{color:#e1c77f;font:900 14px/1.1 system-ui}.rist-user-account-viewer.mmo>header strong{color:#75efaa}.rist-user-account-viewer.sandbox>header strong{color:#8ac1ff}.rist-user-account-viewer>header small{color:#aaa08b;font:700 9px/1.1 system-ui}.rist-user-account-close{width:38px;height:38px;border:1px solid #725d30;border-radius:9px;background:#111920;color:#e8d49a;font:900 24px/1 system-ui}
.rist-user-account-body{box-sizing:border-box;min-height:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:9px;overflow:auto;-webkit-overflow-scrolling:touch}.rist-user-account-card{display:grid;align-content:start;gap:7px;padding:10px;border:1px solid #4f452e;border-radius:9px;background:#0b141b}.rist-user-account-card h3{margin:0 0 2px;color:#e1c77f;font:900 11px/1.1 system-ui;text-transform:uppercase;letter-spacing:.06em}.account-pair{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:start}.account-pair span{color:#9f957f;font:700 10px/1.25 system-ui}.account-pair strong{max-width:58vw;color:#eee6d2;font:800 10px/1.25 system-ui;text-align:right;overflow-wrap:anywhere}.account-small-button,.notes-actions button{justify-self:start;min-height:32px;padding:0 10px;border:1px solid #725d30;border-radius:8px;background:#111920;color:#d7be80;font-weight:800}.account-help{color:#8f8777;font:9px/1.35 system-ui}.notes-card{grid-column:1/-1}.notes-card textarea{box-sizing:border-box;width:100%;min-height:90px;padding:9px;border:1px solid #51462f;border-radius:8px;background:#081017;color:#eee6d2;font:13px/1.35 system-ui;resize:vertical}.notes-actions{display:flex;align-items:center;gap:8px}.notes-actions span{color:#9f957f;font:9px/1.2 system-ui}.rist-user-account-empty{display:grid;place-content:center;gap:8px;padding:24px;text-align:center}.rist-user-account-empty strong{color:#e1c77f}.rist-user-account-empty span{max-width:520px;color:#aaa08b;font-size:12px;line-height:1.4}
@@media(max-width:620px){.rist-user-account-viewer{left:6px;right:6px;top:calc(env(safe-area-inset-top) + 88px);bottom:154px}.rist-user-account-body{grid-template-columns:1fr}.notes-card{grid-column:1}.account-pair strong{max-width:58vw}}
</style>

@code{
 const string PrivateProfileKey="account/user-panel.json";
 const string OwnerMmoZoneId="MMO-00000001";
 bool _open;
 bool _loaded;
 bool _showCode;
 bool _saving;
 string _saveStatus="";
 UserAccountPrivateProfile _privateProfile=new();
 string RoleLabel=>Session.Role=="GM"?"GameMaster":"RolePlayer";
 string DomainLabel=>Session.IsMmoMode?"MMO":"SandBox";
 string DomainClass=>Session.IsMmoMode?"mmo":"sandbox";
 string WorldFoldCoordinateLabel=>Session.IsMmoMode
  ? (Auth.IsOwnerDiscordAccount ? "0,0,0" : (string.IsNullOrWhiteSpace(_privateProfile.MmoWorldFoldCoordinates)?"Not assigned":_privateProfile.MmoWorldFoldCoordinates))
  : (string.IsNullOrWhiteSpace(_privateProfile.SandboxWorldFoldCoordinates)?"Not assigned":_privateProfile.SandboxWorldFoldCoordinates);
 string ZoneIdLabel=>Session.IsMmoMode
  ? (Auth.IsOwnerDiscordAccount ? OwnerMmoZoneId : (string.IsNullOrWhiteSpace(_privateProfile.MmoZoneId)?"Not assigned":_privateProfile.MmoZoneId))
  : (string.IsNullOrWhiteSpace(_privateProfile.SandboxZoneId)?"Not assigned":_privateProfile.SandboxZoneId);
 string PlanLabel=>Auth.Account?.Plan switch{"gm-player"=>"GM + Player","player"=>"Player",null=>"—",var value=>value};

 protected override void OnInitialized()=>Session.Changed+=SessionChanged;
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  await InstallSelectorAsync();
  if(_open&&Session.IsLoggedIn&&!_loaded)await LoadPrivateProfileAsync();
 }
 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 async Task InstallSelectorAsync()
 {
  var domainClass=Session.IsMmoMode?"mmo":"sandbox";
  await JS.InvokeVoidAsync("eval",$"(()=>{{const rail=document.querySelector('.chat-mode-rail');if(!rail)return;let b=document.getElementById('rist-user-account-selector');if(!b){{b=document.createElement('button');b.id='rist-user-account-selector';b.type='button';b.textContent='Account';b.addEventListener('click',()=>document.getElementById('rist-user-account-open-bridge')?.click());rail.prepend(b);}}b.className='rist-user-account-selector {domainClass}';}})()");
 }
 async Task Open()
 {
  _open=true;_saveStatus="";
  if(Session.IsLoggedIn&&!_loaded)await LoadPrivateProfileAsync();
 }
 void Close()=>_open=false;
 async Task LoadPrivateProfileAsync()
 {
  _loaded=true;
  try
  {
   var saved=await Auth.DownloadJsonAsync<UserAccountPrivateProfile>(PrivateProfileKey);
   if(saved is not null)_privateProfile=saved;
   var changed=false;
   if(Auth.IsOwnerDiscordAccount&&!string.Equals(_privateProfile.MmoWorldFoldCoordinates,"0,0,0",StringComparison.Ordinal))
   {
    _privateProfile.MmoWorldFoldCoordinates="0,0,0";
    changed=true;
   }
   if(Auth.IsOwnerDiscordAccount&&!string.Equals(_privateProfile.MmoZoneId,OwnerMmoZoneId,StringComparison.Ordinal))
   {
    _privateProfile.MmoZoneId=OwnerMmoZoneId;
    changed=true;
   }
   if(string.IsNullOrWhiteSpace(_privateProfile.WorldFoldPrivateCode))
   {
    _privateProfile.WorldFoldPrivateCode=Guid.NewGuid().ToString("N")[..10].ToUpperInvariant();
    changed=true;
   }
   if(changed)await SavePrivateProfileAsync(false);
  }
  catch{_saveStatus="Private account details could not be loaded.";}
  await InvokeAsync(StateHasChanged);
 }
 async Task SaveNotesAsync()=>await SavePrivateProfileAsync(true);
 async Task SavePrivateProfileAsync(bool showStatus)
 {
  if(!Session.IsLoggedIn)return;
  _saving=true;if(showStatus)_saveStatus="";await InvokeAsync(StateHasChanged);
  try
  {
   _privateProfile.CustomPlayerNotes=(_privateProfile.CustomPlayerNotes??"").Trim();
   await Auth.UploadTextAsync(PrivateProfileKey,JsonSerializer.Serialize(_privateProfile),"application/json");
   if(showStatus)_saveStatus="Saved privately.";
  }
  catch{if(showStatus)_saveStatus="Could not save notes.";}
  finally{_saving=false;await InvokeAsync(StateHasChanged);}
 }
 static string MaskCode(string? code)=>string.IsNullOrWhiteSpace(code)?"Not assigned":new string('•',Math.Min(10,code.Length));
 public void Dispose()=>Session.Changed-=SessionChanged;
 sealed class UserAccountPrivateProfile
 {
  public string WorldFoldPrivateCode{get;set;}="";
  public string MmoWorldFoldCoordinates{get;set;}="";
  public string SandboxWorldFoldCoordinates{get;set;}="";
  public string MmoZoneId{get;set;}="";
  public string SandboxZoneId{get;set;}="";
  public string CustomPlayerNotes{get;set;}="";
 }
}
