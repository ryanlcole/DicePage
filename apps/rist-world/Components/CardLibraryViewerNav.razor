@inject WorldSession Session

@if(Session.CardBrowserOpen)
{
 <nav class="card-library-viewer-nav" aria-label="Card library navigation">
  <button type="button" class="card-library-nav-back" onclick="document.querySelector('#card-library .library-secondary-tools button:not(.card-filter-toggle)')?.click(); ristWorld.scrollRail('#card-library-content-rail',-1);" aria-label="Back">‹</button>
  <button type="button" class="card-library-nav-forward" onclick="ristWorld.scrollRail('#card-library-content-rail',1)" aria-label="Forward">›</button>
  <button type="button" class="card-library-nav-close" @onclick="Close" aria-label="Close card library">×</button>
 </nav>
}

<style>
.card-library-viewer-nav{position:absolute!important;top:8px!important;right:8px!important;z-index:190!important;display:flex!important;gap:5px!important;align-items:center!important;padding:3px!important;border:1px solid #745c25!important;border-radius:10px!important;background:#081118e8!important;box-shadow:0 2px 10px #0008!important;backdrop-filter:none!important}
.card-library-viewer-nav button{display:grid!important;place-items:center!important;width:38px!important;height:38px!important;min-width:38px!important;padding:0!important;border:1px solid #9a762d!important;border-radius:8px!important;background:#101920!important;color:#f0d58b!important;font:800 26px/1 system-ui!important;touch-action:manipulation!important}
.card-library-viewer-nav .card-library-nav-close{font-size:25px!important}
</style>

@code{
 void Close()
 {
  if(Session.CardBrowserOpen)Session.ToggleCardBrowser();
 }
}
