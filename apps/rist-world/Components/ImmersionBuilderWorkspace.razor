@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<div class="immersion-builder" aria-label="RIST ImmersionBuilder">
 <header class="ib-header">
  <div>
   <small>RIST · REPRESENTATION TRANSITION AUTHORING</small>
   <h1>IMMERSIONBUILDER</h1>
   <p>WorldBuilder owns what exists. ImmersionBuilder defines when the viewer hands off from World → Region → Local representation while zooming.</p>
  </div>
  <div class="ib-state @CurrentRepresentation.ToLowerInvariant()">
   <span>NOW SHOWING</span><strong>@CurrentRepresentation</strong><small>@_zoomRatio.ToString("0.00")× world fit</small>
  </div>
 </header>

 <div class="ib-layout">
  <aside class="ib-controls">
   <section>
    <strong>DESTINATION PATH</strong>
    <label>
     <span>REGION</span>
     <select value="@_regionId" @onchange="ChangeRegionAsync">
      <option value="">Choose Region…</option>
      @foreach(var region in Regions)
      {
       <option value="@region.RegionId">@region.Name</option>
      }
     </select>
    </label>
    <label>
     <span>LOCAL</span>
     <select value="@_localId" @onchange="ChangeLocalAsync" disabled="@string.IsNullOrWhiteSpace(_regionId)">
      <option value="">Region only / choose Local…</option>
      @foreach(var local in LocalsForRegion)
      {
       <option value="@local.LocalId">@local.Name · @local.AnchorName</option>
      }
     </select>
    </label>
   </section>

   <section class="ib-thresholds">
    <strong>HANDOFF THRESHOLDS</strong>
    <article class="@SwitchClass("REGION")">
     <header><span>WORLD → REGION</span><b>@_worldToRegion.ToString("0.00")×</b></header>
     <p>The World remains authoritative below this zoom. At/above it, use the selected Region representation.</p>
     <button type="button" disabled="@(!CanSetRegion)" @onclick="SetRegionSwitch">SET REGION SWITCH HERE</button>
    </article>

    <article class="@SwitchClass("LOCAL")">
     <header><span>REGION → LOCAL</span><b>@_regionToLocal.ToString("0.00")×</b></header>
     <p>The Region remains visible until this zoom. At/above it, use the selected Local representation.</p>
     <button type="button" disabled="@(!CanSetLocal)" @onclick="SetLocalSwitch">SET LOCAL SWITCH HERE</button>
    </article>
   </section>

   <section class="ib-camera-tools">
    <strong>CAMERA</strong>
    <button type="button" @onclick="FitWorldAsync">FIT WORLD</button>
    <button type="button" disabled="@(!CanSetRegion)" @onclick="FocusRegionAsync">FOCUS REGION</button>
    <button type="button" disabled="@(!CanSetLocal)" @onclick="FocusLocalAsync">FOCUS LOCAL</button>
   </section>

   <section class="ib-actions">
    <button type="button" disabled="@(!CanSetRegion)" @onclick="ResetDefaults">RESET DEFAULTS</button>
    <button type="button" class="save" disabled="@(!CanSetRegion||_saving)" @onclick="SaveAsync">@(_saving?"SAVING…":_saved?"SAVED":"SAVE PROFILE")</button>
    @if(!string.IsNullOrWhiteSpace(_status)){<p>@_status</p>}
   </section>
  </aside>

  <main class="ib-preview">
   <div class="ib-preview-hud">
    <span>WORLD</span>
    <i class="@HudClass("REGION")">REGION @(_worldToRegion.ToString("0.0"))×</i>
    <i class="@HudClass("LOCAL")">LOCAL @(_regionToLocal.ToString("0.0"))×</i>
   </div>
   <iframe @ref="_frame"
           class="ib-frame"
           src="@BuilderSrc"
           title="Immersion zoom transition preview"
           loading="eager"
           allow="fullscreen"></iframe>
   <div class="ib-current-cue @CurrentRepresentation.ToLowerInvariant()">
    <strong>@CurrentRepresentation</strong>
    <small>@CurrentPath</small>
   </div>
  </main>
 </div>
</div>

<style>
