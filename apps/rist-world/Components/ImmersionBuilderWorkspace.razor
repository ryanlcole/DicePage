article.active{border-color:#d2aa55;box-shadow:0 0 0 1px #d2aa5533 inset}.ib-thresholds article header{display:flex;justify-content:space-between;gap:8px;color:#dfcc98;font-size:8px}.ib-thresholds article p{margin:5px 0 7px;color:#82979f;font-size:7px;line-height:1.35}.ib-controls button{box-sizing:border-box;width:100%;min-height:34px;margin-top:5px;border:1px solid #4d646e;border-radius:6px;background:#0c1820;color:#e2dbc4;font:900 8px system-ui;letter-spacing:.04em;touch-action:manipulation}.ib-controls button:disabled{opacity:.34}.ib-camera-tools{display:grid;grid-template-columns:1fr 1fr;gap:5px}.ib-camera-tools>strong{grid-column:1/-1}.ib-camera-tools button:first-of-type{grid-column:1/-1}.ib-actions .save{border-color:#98793d;color:#f0d58e;background:#1e190d}.ib-actions p{margin:6px 0 0;color:#8fbba9;font-size:7px;line-height:1.35}.ib-preview{position:relative;min-width:0;min-height:0;overflow:hidden;background:#020609}.ib-frame{display:block;width:100%;height:100%;border:0;background:#020609}.ib-preview-hud{position:absolute;z-index:4;left:10px;top:10px;display:flex;gap:5px;align-items:center;pointer-events:none}.ib-preview-hud span,.ib-preview-hud i{padding:5px 7px;border:1px solid #495f68;border-radius:999px;background:#061016dd;color:#9dafb7;font:900 7px/1 system-ui;font-style:normal}.ib-preview-hud i.active{border-color:#d1a951;color:#f0d690;background:#211a0ddd}.ib-current-cue{position:absolute;z-index:4;right:10px;bottom:10px;min-width:155px;padding:7px 9px;border:1px solid #51656e;border-radius:8px;background:#061016e8;pointer-events:none;display:grid}.ib-current-cue strong{color:#f0d690;font-size:11px}.ib-current-cue small{margin-top:2px;color:#90a2aa;font-size:7px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
