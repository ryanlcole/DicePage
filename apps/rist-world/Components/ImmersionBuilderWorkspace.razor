</style>

@code {
 ElementReference _frame;
 IJSObjectReference? _module;
 DotNetObjectReference<ImmersionBuilderWorkspace>? _self;
 string _regionId="",_localId="",_status="";
 double _zoomRatio=1,_worldToRegion=3,_regionToLocal=8;
 bool _saving,_saved,_loaded;

 IReadOnlyList<WorldRegion> Regions=>Session.DefinedRegions.OrderBy(x=>x.Name,StringComparer.OrdinalIgnoreCase).ToList();
 IReadOnlyList<WorldLocal> LocalsForRegion=>Session.DefinedLocals
  .Where(x=>string.Equals(x.RegionId,_regionId,StringComparison.Ordinal))
  .OrderBy(x=>x.Name,StringComparer.OrdinalIgnoreCase).ToList();
 WorldRegion? SelectedRegion=>Regions.FirstOrDefault(x=>string.Equals(x.RegionId,_regionId,StringComparison.Ordinal));
 WorldLocal? SelectedLocal=>LocalsForRegion.FirstOrDefault(x=>string.Equals(x.LocalId,_localId,StringComparison.Ordinal));
 bool CanSetRegion=>SelectedRegion is not null;
 bool CanSetLocal=>SelectedLocal is not null;
 string CurrentRepresentation=>CanSetLocal&&_zoomRatio>=_regionToLocal?"LOCAL":CanSetRegion&&_zoomRatio>=_worldToRegion?"REGION":"WORLD";
 string CurrentPath=>SelectedLocal is not null?$"{Session.WorldDisplayName} → {SelectedRegion?.Name} → {SelectedLocal.Name}":SelectedRegion is not null?$"{Session.WorldDisplayName} → {SelectedRegion.Name}":Session.WorldDisplayName;
 string BuilderSrc
 {
  get
  {
   var worldId=Uri.EscapeDataString(Session.WorldId??"");
   var worldName=Uri.EscapeDataString(Session.WorldDisplayName??"");
   var seed=Session.IsGeonaphWorld?"geonaph":"empty";
   var activeWorld=Session.ActiveMmoWorld;
   var surfacePixels=activeWorld?.PixelWidth>0?activeWorld.PixelWidth:Session.SurfaceWorldPixelLimit??WorldSession.IncludedSurfaceWorldPixels;
   return $"/Game/prototype/index.html?live-worldbuilder=1&mode=immersion&worldId={worldId}&worldName={worldName}&seed={seed}&surfacePixels={surfacePixels}&surfacePolicy=immersion-profile&access=view&renderer=20260924-immersion-switch-1";
  }
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_loaded)return;
  _loaded=true;
  try
  {
   if(Session.IsGeonaphWorld)await Session.RefreshMmoLandAsync();
   await Session.LoadRegionsAsync();
   await Session.LoadLocalsAsync();
  }
  catch{}

  _regionId=Session.IsDefinedRegion(Session.ActiveRegion)?Session.ActiveRegion!.RegionId:Regions.FirstOrDefault()?.RegionId??"";
  _localId=Session.ActiveLocal is { } active&&string.Equals(active.RegionId,_regionId,StringComparison.Ordinal)?active.LocalId:LocalsForRegion.FirstOrDefault()?.LocalId??"";
  await LoadOrDefaultProfileAsync();

  _module=await JS.InvokeAsync<IJSObjectReference>("import","./immersion-builder-host.js?v=20260924-immersion-switch-1");
  _self=DotNetObjectReference.Create(this);
  await _module.InvokeVoidAsync("attach",_frame,_self);
  await InvokeAsync(StateHasChanged);
 }

 async Task ChangeRegionAsync(ChangeEventArgs e)
 {
  _regionId=e.Value?.ToString()??"";
  _localId=LocalsForRegion.FirstOrDefault()?.LocalId??"";
  _saved=false;
  await LoadOrDefaultProfileAsync();
  await FocusRegionAsync();
 }

 async Task ChangeLocalAsync(ChangeEventArgs e)
 {
  _localId=e.Value?.ToString()??"";
  _saved=false;
  await LoadOrDefaultProfileAsync();
  if(CanSetLocal)await FocusLocalAsync();
 }

 async Task LoadOrDefaultProfileAsync()
 {
  if(!CanSetRegion){_worldToRegion=3;_regionToLocal=8;return;}
  try
  {
   var saved=await Session.LoadImmersionProfileAsync(_regionId,_localId);
   if(saved is not null)
   {
    _worldToRegion=saved.WorldToRegionZoom;
    _regionToLocal=saved.RegionToLocalZoom;
    _status="Loaded saved immersion profile.";
    _saved=true;
    return;
   }
  }
  catch{}
  ResetDefaults();
 }

 void ResetDefaults()
 {
  var region=SelectedRegion;
  if(region is null){_worldToRegion=3;_regionToLocal=8;return;}
  var rw=Math.Clamp((region.MaxColumn-region.MinColumn+1)/30d,.001,1);
  var rh=Math.Clamp((region.MaxRow-region.MinRow+1)/30d,.001,1);
  _worldToRegion=Math.Clamp(.72/Math.Max(rw,rh),1.25,180);
  var local=SelectedLocal;
  _regionToLocal=local is null
   ?Math.Clamp(_worldToRegion*2.5,_worldToRegion+0.25,256)
   :Math.Clamp(.72/Math.Max(Math.Max(local.Width,.0001),Math.Max(local.Height,.0001)),_worldToRegion+0.25,256);
  _saved=false;_status="Default handoffs calculated from the selected Region/Local footprint.";
 }

 void SetRegionSwitch()
 {
  if(!CanSetRegion)return;
  _worldToRegion=Math.Clamp(_zoomRatio,1.01,255.5);
  if(_regionToLocal<=_worldToRegion)_regionToLocal=Math.Min(256,_worldToRegion+Math.Max(.25,_worldToRegion*.35));
  _saved=false;_status=$"World → Region switch set at {_worldToRegion:0.00}×.";
 }

 void SetLocalSwitch()
 {
  if(!CanSetLocal)return;
  if(_zoomRatio<=_worldToRegion)
  {
   _status=$"Zoom beyond the Region switch ({_worldToRegion:0.00}×) before setting Local.";
   return;
  }
  _regionToLocal=Math.Clamp(_zoomRatio,_worldToRegion+.01,256);
  _saved=false;_status=$"Region → Local switch set at {_regionToLocal:0.00}×.";
 }

 async Task FitWorldAsync(){if(_module is not null)await _module.InvokeVoidAsync("fitWorld",_frame);}
 async Task FocusRegionAsync()
 {
  var region=SelectedRegion;if(region is null||_module is null)return;
  var width=Math.Clamp((region.MaxColumn-region.MinColumn+1)/30d,.001,1);
  var height=Math.Clamp((region.MaxRow-region.MinRow+1)/30d,.001,1);
  var x=(region.MinColumn+(region.MaxColumn-region.MinColumn+1)/2d)/30d;
  var y=(region.MinRow+(region.MaxRow-region.MinRow+1)/2d)/30d;
  await _module.InvokeVoidAsync("focusBounds",_frame,x,y,width,height);
 }
 async Task FocusLocalAsync()
 {
  var local=SelectedLocal;if(local is null||_module is null)return;
  await _module.InvokeVoidAsync("focusBounds",_frame,local.X,local.Y,Math.Max(local.Width,.0001),Math.Max(local.Height,.0001));
 }

 async Task SaveAsync()
 {
  var region=SelectedRegion;if(region is null)return;
  _saving=true;_saved=false;_status="";
  try
  {
   var local=SelectedLocal;
   var focus=local is not null?(x:local.X,y:local.Y):RegionCenter(region);
   var existing=await Session.LoadImmersionProfileAsync(region.RegionId,local?.LocalId??"");
   var profile=new WorldImmersionProfile(
    existing?.ProfileId??$"immersion-{Guid.NewGuid():N}",
    Session.WorldId,
    region.RegionId,
    local?.LocalId??"",
    _worldToRegion,
    _regionToLocal,
    focus.x,
    focus.y,
    "zoom-threshold-handoff",
    DateTimeOffset.UtcNow);
   var saved=await Session.SaveImmersionProfileAsync(profile);
   _worldToRegion=saved.WorldToRegionZoom;
   _regionToLocal=saved.RegionToLocalZoom;
   _saved=true;_status="Immersion handoff profile saved to the world database.";
  }
  catch(Exception ex){_status=$"Save failed: {ex.Message}";}
  finally{_saving=false;}
 }

 static (double x,double y) RegionCenter(WorldRegion region)
  =>((region.MinColumn+(region.MaxColumn-region.MinColumn+1)/2d)/30d,(region.MinRow+(region.MaxRow-region.MinRow+1)/2d)/30d);

 string SwitchClass(string level)=>string.Equals(CurrentRepresentation,level,StringComparison.Ordinal)?"active":"";
 string HudClass(string level)=>string.Equals(CurrentRepresentation,level,StringComparison.Ordinal)?"active":"";

 [JSInvokable]
 public Task UpdateCameraFromPrototypeAsync(double zoomRatio)
 {
  _zoomRatio=Math.Clamp(zoomRatio,.000001,256);
  return InvokeAsync(StateHasChanged);
 }

 public async ValueTask DisposeAsync()
 {
  if(_module is not null)
  {
   try{await _module.InvokeVoidAsync("detach",_frame);}catch{}
   await _module.DisposeAsync();
  }
  _self?.Dispose();
 }
}
