@inject WorldSession Session
<footer class="footer dice-footer circular-rail" data-circular-rail aria-label="Dice tray">
 <div class="circular-set dice-circular-set">
   <button class="footer-chat-button @(Session.ChatComposerOpen||Session.DialogueOpen?"active":"")" @onclick="Session.ToggleChatComposer" aria-expanded="@(Session.ChatComposerOpen||Session.DialogueOpen)" aria-label="Open dialogue chat"><span>Chat</span></button>
   @foreach(var die in Session.DiceSet)
   {
    if(die.Key=="d5-bonus")
    {
     <div class="die-control d5-control bonus-d5" draggable="true" @ondragstart="()=>Session.BeginDiceDrag(die.Key)">
      <select @bind="Session.BonusD5Value" aria-label="Bonus D5 value">@for(var i=1;i<=5;i++){<option value="@i">+@i</option>}</select>
      <button class="die-button" title="@(Session.EditingHandCard is null?"Roll selected bonus":"Add selected bonus die to open bag")" aria-label="Roll selected bonus die" @onclick="()=>DieClick(die.Key,Session.BonusD5Value)">
       <span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span>
      </button>
     </div>
    }
    else if(die.Key=="d5-penalty")
    {
     <div class="die-control d5-control penalty-d5" draggable="true" @ondragstart="()=>Session.BeginDiceDrag(die.Key)">
      <select @bind="Session.PenaltyD5Value" aria-label="Penalty D5 value">@for(var i=1;i<=5;i++){<option value="@i">-@i</option>}</select>
      <button class="die-button" title="@(Session.EditingHandCard is null?"Roll selected penalty":"Add selected penalty die to open bag")" aria-label="Roll selected penalty die" @onclick="()=>DieClick(die.Key,Session.PenaltyD5Value)">
       <span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span>
      </button>
     </div>
    }
    else
    {
     <button class="die-button" draggable="true" @ondragstart="()=>Session.BeginDiceDrag(die.Key)" title="@(Session.EditingHandCard is null?$"Roll {die.Label}":$"Add {die.Label} to open bag")" aria-label="Roll @die.Label" @onclick="()=>DieClick(die.Key,null)">
      <span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span>
     </button>
    }
   }
   <div class="sum" aria-label="Dice total"><span>SUM</span><span>@Session.Total</span></div>
   <button class="clear-dice" @onclick="Session.ClearRolls">Clear dice</button>
   @foreach(var c in Session.Cards){<button class="card" @onclick="()=>Session.ShowCard(c)">@c.Name</button>}
 </div>
</footer>
@if(Session.ChatComposerOpen)
{
 <div class="dialogue-scrim" @onclick="Session.CloseChat">
  <section class="dialogue-composer" role="dialog" aria-modal="true" aria-label="Write dialogue" @onclick:stopPropagation="true">
   <div class="dialogue-portrait">
    @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
    else{<span class="dialogue-card-back" aria-hidden="true"></span>}
   </div>
   <label><span>@Session.DialogueSpeaker</span><textarea @bind="Session.ChatDraft" @bind:event="oninput" maxlength="1200" placeholder="What do you say?" autofocus></textarea></label>
   <div class="dialogue-actions"><button @onclick="Session.CloseChat">Cancel</button><button class="primary" @onclick="Session.SendChat" disabled="@string.IsNullOrWhiteSpace(Session.ChatDraft)">Say it</button></div>
  </section>
 </div>
}
@if(Session.DialogueOpen)
{
 <div class="dialogue-scrim dialogue-playback" @onclick="Session.AdvanceDialogue">
  <section class="rpg-dialogue-box" role="dialog" aria-modal="true" aria-live="polite" aria-label="Dialogue from @Session.DialogueSpeaker" @onclick:stopPropagation="true">
   <div class="dialogue-portrait">
    @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
    else{<span class="dialogue-card-back" aria-hidden="true"></span>}
   </div>
   <div class="dialogue-copy"><strong>@Session.DialogueSpeaker</strong><p>@Session.DialogueText</p></div>
   <button class="dialogue-next" @onclick="Session.AdvanceDialogue">Next</button>
  </section>
 </div>
}
@if(Session.OpenCard is not null){<div class="card-modal" @onclick="Session.CloseCard"><article class="card-panel" @onclick:stopPropagation="true"><h2>@Session.OpenCard.Name</h2><p><strong>@Session.OpenCard.Type</strong></p><p>@Session.OpenCard.Text</p><button @onclick="Session.CloseCard">Close</button></article></div>}
@code{
 async Task DieClick(string key,int? magnitude){if(Session.MixerOpen&&Session.CharacterEditMode&&Session.EditingHandCard is not null){Session.AddDiceBagEntry(key);return;}await Session.RollAsync(key,magnitude);}
 static string DieSpriteStyle(DiceSpec die,int frame)
 {
  var col=frame%die.Columns;var row=frame/die.Columns;
  var x=die.Columns<=1?0:col*100.0/(die.Columns-1);
  var y=die.Rows<=1?0:row*100.0/(die.Rows-1);
  return $"--die-aspect:{die.VisualAspect};background-image:url('{die.Image}?v=normalized-3');background-size:{die.Columns*100}% {die.Rows*100}%;background-position:{x:0.###}% {y:0.###}%";
 }
}
