@inject WorldSession Session
<style>
 .rist .release-footer-region{position:relative!important;overflow:visible!important}
 .rist .release-footer-region>.release-footer-stack{position:absolute!important;left:0!important;right:0!important;bottom:0!important;top:auto!important;width:100%!important}
 .rist .release-footer-stack{display:block!important;height:76px!important;min-height:76px!important;max-height:76px!important;overflow:visible!important;background:#0d1319!important}
 .rist .release-footer-stack .footer-dock{position:absolute!important;left:0!important;right:0!important;bottom:18px!important;top:auto!important;height:58px!important;z-index:10!important;box-sizing:border-box!important;background:#0d1319!important}
 .rist .release-footer-stack .home-inline-chat{position:absolute!important;inset:0!important;box-sizing:border-box!important;width:100%!important;height:58px!important;display:grid!important;grid-template-columns:48px minmax(0,1fr) auto 48px!important;align-items:stretch!important;gap:6px!important;padding:4px 6px!important;margin:0!important;background:#0d1319!important;overflow:hidden!important}
 .rist .release-footer-stack .home-inline-chat .home-chat-compose{min-width:0!important;height:50px!important;margin:0!important}
 .rist .release-footer-stack .home-inline-chat .home-chat-compose textarea{box-sizing:border-box!important;height:50px!important;min-height:50px!important;max-height:50px!important}
 .rist .release-footer-stack .home-inline-chat .home-chat-send,.rist .release-footer-stack .home-inline-chat .chat-history-toggle{height:50px!important;min-height:50px!important;align-self:center!important;touch-action:manipulation!important}
 .rist .release-footer-stack .home-inline-chat .chat-history-toggle{width:48px!important;min-width:48px!important;padding:0!important;font:800 9px/1 system-ui!important;letter-spacing:.08em!important;color:#d7be80!important}
 .rist .release-footer-stack #footer-slider{position:absolute!important;left:0!important;right:54px!important;top:0!important;bottom:0!important;width:auto!important;height:58px!important;min-height:58px!important;max-height:58px!important;z-index:20!important;overflow:hidden!important;background:#0d1319!important;border:0!important;box-shadow:none!important;filter:none!important;mix-blend-mode:normal!important;transition:opacity .12s ease,visibility .12s ease!important}
 .rist .release-footer-stack #footer-slider::before,.rist .release-footer-stack #footer-slider::after,.rist .release-footer-stack #footer-slider .release-footer-track::before,.rist .release-footer-stack #footer-slider .release-footer-track::after{content:none!important;display:none!important}
 .rist .release-footer-stack #footer-slider .release-footer-track{box-sizing:border-box!important;width:100%!important;min-width:100%!important;height:58px!important;display:flex!important;align-items:center!important;gap:6px!important;overflow-x:auto!important;overflow-y:hidden!important;padding:4px 6px!important;scrollbar-width:none!important;touch-action:pan-x!important;-webkit-overflow-scrolling:touch!important;background:#0d1319!important;opacity:1!important;filter:none!important;mix-blend-mode:normal!important}
 .rist .release-footer-stack #footer-slider .release-footer-track>*{opacity:1!important;filter:none!important;mix-blend-mode:normal!important}
 .rist .release-footer-stack #footer-slider .release-footer-track::-webkit-scrollbar{display:none!important}.rist .release-footer-stack #footer-slider .rail-scroll-arrow{display:none!important}
 .rist .release-footer-stack #footer-slider .die-button,.rist .release-footer-stack #footer-slider .die-control,.rist .release-footer-stack #footer-slider .clear-dice,.rist .release-footer-stack #footer-slider .roll-history-toggle{pointer-events:auto!important;touch-action:manipulation!important;-webkit-user-select:none!important;user-select:none!important;opacity:1!important;filter:none!important}
 .rist .release-footer-stack.dice-tray-open #footer-slider{opacity:1!important;visibility:visible!important;pointer-events:auto!important}.rist .release-footer-stack:not(.dice-tray-open) #footer-slider{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
 .rist .release-footer-stack .dice-tray-toggle{box-sizing:border-box!important;width:48px!important;height:50px!important;min-width:48px!important;min-height:50px!important;display:grid!important;place-items:center!important;padding:2px!important;margin:0!important;border:1px solid #725d30!important;border-radius:9px!important;background:#111920!important;color:#d7be80!important;box-shadow:none!important;opacity:1!important;visibility:visible!important;pointer-events:auto!important;touch-action:manipulation!important;z-index:30!important;overflow:hidden!important}
 .rist .release-footer-stack .dice-tray-toggle .dice-bag-toggle-art{display:block!important;width:42px!important;height:42px!important;max-width:42px!important;max-height:42px!important;object-fit:contain!important;pointer-events:none!important;opacity:1!important;filter:none!important}
 .rist .release-footer-stack .site-copyright-notice{position:absolute!important;left:0!important;right:0!important;bottom:0!important;z-index:8!important;box-sizing:border-box!important;width:100%!important;height:18px!important;margin:0!important;padding:0 6px!important;border-top:1px solid #4d4023!important;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;white-space:nowrap!important;font-size:8px!important;line-height:18px!important;background:#071015!important;pointer-events:none!important}
 .rist .dialogue-scrim.dialogue-playback{background:transparent!important;background-color:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;filter:none!important;box-shadow:none!important;pointer-events:none!important}
 .rist .dialogue-scrim.dialogue-playback::before,.rist .dialogue-scrim.dialogue-playback::after{content:none!important;display:none!important}
 .rist .dialogue-scrim.dialogue-playback .rpg-dialogue-box{pointer-events:auto!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
</style>
<div class="home-footer-stack release-footer-stack @(_diceTrayOpen?"dice-tray-open":"chat-cover-open")">
 <div class="footer-dock">
  <section class="home-inline-chat" aria-label="Roleplay">
   <button type="button" class="history-scroll-button chat-history-toggle" @onclick="()=>_chatHistoryOpen=true" aria-label="Open roleplay log" title="Roleplay log">LOG</button>
   <label class="home-chat-compose"><span>Roleplay</span><textarea @bind="Session.ChatDraft" @bind:event="oninput" maxlength="1200" placeholder="@ChatPrompt"></textarea></label>
   <button type="button" class="home-chat-send" @onclick="SendInlineChat" disabled="@string.IsNullOrWhiteSpace(Session.ChatDraft)">Send</button>
   <button type="button" class="dice-tray-toggle" @onclick="ToggleDiceTray" aria-expanded="@_diceTrayOpen" aria-controls="footer-slider" aria-label="@(_diceTrayOpen?"Close dice tray":"Open dice tray")" title="@(_diceTrayOpen?"Close dice":"Dice")">
    <img class="dice-bag-toggle-art" src="assets/ui/custom_dicebag.png?v=dicebag-toggle-1" alt="" draggable="false" />
   </button>
  </section>

  <footer id="footer-slider" class="footer dice-footer release-root-rail desktop-arrow-slider" aria-label="Character and dice tray" aria-hidden="@(!_diceTrayOpen)">
   <div class="circular-set dice-circular-set release-footer-track">
    <button type="button" class="footer-character-button" @onclick="Session.OpenMixer" aria-label="Open character sheet">
     @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
     <span><strong>@(string.IsNullOrWhiteSpace(Session.CharacterName)?"Character":Session.CharacterName)</strong><small>Sheet</small></span>
    </button>
    @foreach(var die in Session.DiceSet)
    {
     if(die.Key=="d5-bonus")
     {<div class="die-control d5-control bonus-d5"><select @bind="Session.BonusD5Value" aria-label="Bonus D5 value">@for(var i=1;i<=5;i++){<option value="@i">+@i</option>}</select><button type="button" class="die-button" aria-label="Roll selected bonus die" @onclick="()=>DieClick(die.Key,Session.BonusD5Value)"><span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span></button></div>}
     else if(die.Key=="d5-penalty")
     {<div class="die-control d5-control penalty-d5"><select @bind="Session.PenaltyD5Value" aria-label="Penalty D5 value">@for(var i=1;i<=5;i++){<option value="@i">-@i</option>}</select><button type="button" class="die-button" aria-label="Roll selected penalty die" @onclick="()=>DieClick(die.Key,Session.PenaltyD5Value)"><span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span></button></div>}
     else
     {<button type="button" class="die-button" aria-label="Roll @die.Label" @onclick="()=>DieClick(die.Key,null)"><span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span></button>}
    }
    <div class="sum" aria-label="Dice total"><span>SUM</span><span>@Session.Total</span></div>
    <button type="button" class="history-scroll-button roll-history-toggle" @onclick="()=>_rollHistoryOpen=true" aria-label="Open roll history"><span aria-hidden="true">📜</span></button>
    <button type="button" class="clear-dice" @onclick="Session.ClearRollsWithHistory">Clear</button>
    @foreach(var c in Session.Cards){<button type="button" class="card" @onclick="()=>Session.ShowCard(c)">@c.Name</button>}
   </div>
  </footer>
 </div>
 <div class="site-copyright-notice" aria-label="Copyright notice">© 2026 Ryan L. Cole / ReLiCGameMaster · Shaelvien · RIST · All rights reserved.</div>
</div>

@if(_chatHistoryOpen){<div class="history-scroll-scrim" @onclick="()=>_chatHistoryOpen=false"><section class="history-scroll-sheet" role="dialog" aria-modal="true" aria-label="Roleplay history" @onclick:stopPropagation="true"><header><strong>Roleplay History</strong><button @onclick="()=>_chatHistoryOpen=false" aria-label="Close roleplay history">×</button></header><div class="history-scroll-body">@foreach(var message in _history){<article class="chat-history-entry"><strong>@message.Speaker</strong><p>@message.Text</p></article>}@if(_history.Count==0){<p class="history-empty">No roleplay messages yet.</p>}</div></section></div>}
@if(_rollHistoryOpen){<div class="history-scroll-scrim" @onclick="()=>_rollHistoryOpen=false"><section class="history-scroll-sheet" role="dialog" aria-modal="true" aria-label="Roll history" @onclick:stopPropagation="true"><header><strong>Roll History</strong><button @onclick="()=>_rollHistoryOpen=false" aria-label="Close roll history">×</button></header><div class="history-scroll-body roll-history-body">@foreach(var batch in Session.RollHistoryBatches){<article class="roll-history-entry"><strong>@batch.CharacterName</strong>@if(batch.CardNames.Count>0){<small>Card: @string.Join(", ",batch.CardNames)</small>}<p>@batch.Equation</p></article>}@if(Session.RollHistoryBatches.Count==0){<p class="history-empty">No rolls yet.</p>}</div></section></div>}
@if(Session.DialogueOpen){<div class="dialogue-scrim dialogue-playback" @onclick="Session.AdvanceDialogue"><section class="rpg-dialogue-box" role="dialog" aria-modal="false" aria-live="polite" aria-label="Dialogue from @Session.DialogueSpeaker" @onclick:stopPropagation="true"><div class="dialogue-portrait">@if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}else{<span class="dialogue-card-back" aria-hidden="true"></span>}</div><div class="dialogue-copy"><strong>@Session.DialogueSpeaker</strong><p>@Session.DialogueText</p></div><button class="dialogue-next" @onclick="Session.AdvanceDialogue">Next</button></section></div>}
@if(Session.OpenCard is not null){<div class="card-modal" @onclick="Session.CloseCard"><article class="card-panel" @onclick:stopPropagation="true"><h2>@Session.OpenCard.Name</h2><p><strong>@Session.OpenCard.Type</strong></p><p>@Session.OpenCard.Text</p><button @onclick="Session.CloseCard">Close</button></article></div>}

@code{
 readonly List<(string Speaker,string Text)> _history=[]; bool _chatHistoryOpen; bool _rollHistoryOpen; bool _diceTrayOpen;
 string ChatPrompt=>"Roleplay";
 void ToggleDiceTray()=>_diceTrayOpen=!_diceTrayOpen;
 void SendInlineChat(){var text=Session.ChatDraft?.Trim()??string.Empty;if(text.Length==0)return;_history.Add((Session.DialogueSpeaker,text));Session.SendChat();}
 async Task DieClick(string key,int? magnitude){if(Session.MixerOpen&&Session.CharacterEditMode&&Session.EditingHandCard is not null){Session.AddDiceBagEntry(key);return;}await Session.RollWithHistoryAsync(key,magnitude);}
 static string DieSpriteStyle(DiceSpec die,int frame){var col=frame%die.Columns;var row=frame/die.Columns;var x=die.Columns<=1?0:col*100.0/(die.Columns-1);var y=die.Rows<=1?0:row*100.0/(die.Rows-1);return $"--die-aspect:{die.VisualAspect};background-image:url('{die.Image}?v=release-8');background-size:{die.Columns*100}% {die.Rows*100}%;background-position:{x:0.###}% {y:0.###}%";}
}