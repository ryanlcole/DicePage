@inject WorldSession Session

<style>
 .rist{--rist-dice-h:86px!important;--rist-chat-h:86px!important;--rist-legal-h:14px!important;--rist-footer-h:186px!important}
 .rist .release-footer-region{box-sizing:border-box!important;height:var(--rist-footer-h)!important;min-height:var(--rist-footer-h)!important;max-height:var(--rist-footer-h)!important;overflow:hidden!important;background:#071015!important}
 .rist .release-footer-region>.release-footer-stack{position:relative!important;inset:auto!important;width:100%!important;height:var(--rist-footer-h)!important;min-height:var(--rist-footer-h)!important;max-height:var(--rist-footer-h)!important;display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:86px 86px 14px!important;overflow:hidden!important;background:#071015!important}

 .rist .release-footer-stack .inline-chat-output{box-sizing:border-box!important;grid-column:1!important;grid-row:1!important;width:100%!important;height:86px!important;min-height:86px!important;display:grid!important;grid-template-columns:58px minmax(0,1fr) auto!important;align-items:center!important;gap:8px!important;padding:5px 8px!important;margin:0!important;border-top:1px solid #725d30!important;border-bottom:1px solid #725d30!important;background:#0b141b!important;overflow:hidden!important}
 .rist .release-footer-stack .inline-chat-output.empty{grid-template-columns:minmax(0,1fr)!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-portrait{box-sizing:border-box!important;width:52px!important;height:74px!important;display:grid!important;place-items:center!important;border:1px solid #725d30!important;border-radius:8px!important;background:#111920!important;overflow:hidden!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-portrait img{display:block!important;width:100%!important;height:100%!important;object-fit:cover!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-card-back{display:block!important;width:100%!important;height:100%!important;background:url('assets/cards/shaelvien_card_back.jpg') center/contain no-repeat!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-copy{min-width:0!important;overflow:hidden!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-copy strong{display:block!important;margin:0 0 3px!important;color:#e1c77f!important;font:800 12px/1.1 system-ui!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-copy small{color:#9f957f!important;font:700 9px/1 system-ui!important;margin-left:6px!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-copy p{margin:0!important;color:#eee6d2!important;font:14px/1.25 system-ui!important;display:-webkit-box!important;-webkit-line-clamp:3!important;-webkit-box-orient:vertical!important;overflow:hidden!important}
 .rist .release-footer-stack .inline-chat-output .dialogue-next{box-sizing:border-box!important;height:74px!important;min-width:72px!important;padding:0 14px!important;border:1px solid #a27624!important;border-radius:9px!important;background:#111920!important;color:#e8d49a!important;font-weight:700!important;touch-action:manipulation!important}
 .rist .release-footer-stack .inline-chat-output .chat-output-placeholder{padding:0 10px!important;color:#756f63!important;font:12px/1.2 system-ui!important}

 .rist .release-footer-stack .footer-dock{position:relative!important;inset:auto!important;grid-column:1!important;grid-row:2!important;width:100%!important;height:86px!important;min-height:86px!important;margin:0!important;z-index:10!important;box-sizing:border-box!important;background:#0d1319!important;border-bottom:1px solid #4d4023!important;overflow:hidden!important}
 .rist .release-footer-stack .home-inline-chat{position:absolute!important;inset:0!important;box-sizing:border-box!important;width:100%!important;height:86px!important;display:grid!important;grid-template-columns:62px 78px minmax(0,1fr) 92px 72px!important;align-items:stretch!important;gap:4px!important;padding:4px 0!important;margin:0!important;background:#0d1319!important;overflow:hidden!important}
 .rist .release-footer-stack .home-inline-chat .home-chat-compose{min-width:0!important;height:78px!important;margin:0!important}
 .rist .release-footer-stack .home-inline-chat .home-chat-compose textarea{box-sizing:border-box!important;width:100%!important;height:78px!important;min-height:78px!important;max-height:78px!important;margin:0!important;padding:10px!important;border-radius:7px!important;font-size:16px!important;resize:none!important}
 .rist .release-footer-stack .home-inline-chat .home-chat-send,.rist .release-footer-stack .home-inline-chat .chat-history-toggle,.rist .release-footer-stack .home-inline-chat .roleplay-language-toggle{height:78px!important;min-height:78px!important;align-self:center!important;touch-action:manipulation!important}
 .rist .release-footer-stack .home-inline-chat .chat-history-toggle{width:62px!important;min-width:62px!important;padding:0!important;border-left:0!important;border-radius:0 9px 9px 0!important;font:800 10px/1 system-ui!important;letter-spacing:.08em!important;color:#d7be80!important}
 .rist .release-footer-stack .home-inline-chat .roleplay-language-toggle{box-sizing:border-box!important;width:78px!important;min-width:78px!important;padding:4px!important;border:1px solid #725d30!important;border-radius:9px!important;background:#111920!important;color:#d7be80!important;font:800 10px/1.05 system-ui!important;white-space:normal!important;text-align:center!important}
 .rist .release-footer-stack .home-inline-chat .home-chat-send{border-radius:9px!important}
 .rist .release-footer-stack .dice-tray-toggle{box-sizing:border-box!important;width:72px!important;height:78px!important;min-width:72px!important;min-height:78px!important;display:grid!important;place-items:center!important;padding:3px!important;margin:0!important;border:1px solid #725d30!important;border-right:0!important;border-radius:9px 0 0 9px!important;background:#111920!important;color:#d7be80!important;box-shadow:none!important;opacity:1!important;visibility:visible!important;pointer-events:auto!important;touch-action:manipulation!important;z-index:30!important;overflow:hidden!important}
 .rist .release-footer-stack .dice-tray-toggle .dice-bag-toggle-art{display:block!important;width:66px!important;height:66px!important;max-width:66px!important;max-height:66px!important;object-fit:contain!important;pointer-events:none!important;opacity:1!important;filter:none!important}
 .rist .release-footer-stack .native-language-settings{display:none!important}

 .rist .release-footer-stack #footer-slider{position:absolute!important;left:0!important;right:76px!important;top:0!important;bottom:0!important;width:auto!important;height:86px!important;min-height:86px!important;max-height:86px!important;z-index:20!important;overflow:hidden!important;background:#0b0f13!important;border:0!important;box-shadow:none!important;filter:none!important;mix-blend-mode:normal!important;transition:opacity .12s ease,visibility .12s ease,background .12s ease!important}
 .rist .release-footer-stack #footer-slider::before,.rist .release-footer-stack #footer-slider::after,.rist .release-footer-stack #footer-slider .release-footer-track::before,.rist .release-footer-stack #footer-slider .release-footer-track::after{content:none!important;display:none!important}
 .rist .release-footer-stack #footer-slider .release-footer-track{box-sizing:border-box!important;width:100%!important;min-width:100%!important;height:86px!important;display:flex!important;align-items:center!important;gap:6px!important;overflow-x:auto!important;overflow-y:hidden!important;padding:4px 6px!important;scrollbar-width:none!important;touch-action:pan-x!important;-webkit-overflow-scrolling:touch!important;background:#0b0f13!important;opacity:1!important;filter:none!important;mix-blend-mode:normal!important;transition:background .12s ease!important}
 .rist .release-footer-stack #footer-slider[data-roll-visibility="test"],.rist .release-footer-stack #footer-slider[data-roll-visibility="test"] .release-footer-track{background:#c6a400!important}
 .rist .release-footer-stack #footer-slider[data-roll-visibility="public"],.rist .release-footer-stack #footer-slider[data-roll-visibility="public"] .release-footer-track{background:#0b0f13!important}
 .rist .release-footer-stack #footer-slider[data-roll-visibility="group"],.rist .release-footer-stack #footer-slider[data-roll-visibility="group"] .release-footer-track{background:#0c4c86!important}
 .rist .release-footer-stack #footer-slider[data-roll-visibility="gm"],.rist .release-footer-stack #footer-slider[data-roll-visibility="gm"] .release-footer-track{background:#b85b12!important}
 .rist .release-footer-stack #footer-slider[data-roll-visibility="gm-discrete"],.rist .release-footer-stack #footer-slider[data-roll-visibility="gm-discrete"] .release-footer-track{background:#8d1818!important}
 .rist .release-footer-stack #footer-slider .release-footer-track>*{opacity:1!important;filter:none!important;mix-blend-mode:normal!important}
 .rist .release-footer-stack #footer-slider .release-footer-track::-webkit-scrollbar{display:none!important}
 .rist .release-footer-stack #footer-slider .rail-scroll-arrow{display:none!important}
 .rist .release-footer-stack #footer-slider .die-button,.rist .release-footer-stack #footer-slider .die-control,.rist .release-footer-stack #footer-slider .clear-dice,.rist .release-footer-stack #footer-slider .roll-history-toggle,.rist .release-footer-stack #footer-slider .roll-visibility-toggle{pointer-events:auto!important;touch-action:manipulation!important;-webkit-user-select:none!important;user-select:none!important;opacity:1!important;filter:none!important}
 .rist .release-footer-stack #footer-slider .roll-visibility-toggle{box-sizing:border-box!important;flex:0 0 82px!important;width:82px!important;height:74px!important;min-height:74px!important;padding:0 8px!important;border:1px solid #d2b873!important;border-radius:9px!important;background:#111920!important;color:#f4e2ad!important;font:800 10px/1.15 system-ui!important;text-align:center!important;white-space:normal!important}
 .rist .release-footer-stack #footer-slider .native-sum-toggle{display:none!important}
 .rist .release-footer-stack.dice-tray-open #footer-slider{opacity:1!important;visibility:visible!important;pointer-events:auto!important}
 .rist .release-footer-stack:not(.dice-tray-open) #footer-slider{opacity:0!important;visibility:hidden!important;pointer-events:none!important}

 .rist .release-footer-stack .site-copyright-notice{position:static!important;grid-column:1!important;grid-row:3!important;box-sizing:border-box!important;width:100%!important;height:14px!important;min-height:14px!important;margin:0!important;padding:0 6px!important;border-top:0!important;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;white-space:nowrap!important;font-size:7px!important;line-height:14px!important;background:#071015!important;pointer-events:none!important}
</style>

<div class="home-footer-stack release-footer-stack @(_diceTrayOpen?"dice-tray-open":"chat-cover-open")">
 @if(Session.DialogueOpen)
 {
  <section class="inline-chat-output" aria-live="polite" aria-label="Current roleplay output" data-roleplay-language="@Session.DialogueLanguage">
   <div class="dialogue-portrait">
    @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
    else{<span class="dialogue-card-back" aria-hidden="true"></span>}
   </div>
   <div class="dialogue-copy"><strong>@Session.DialogueSpeaker <small>@Session.DialogueLanguage</small></strong><p data-common-source="@Session.DialogueText">@Session.ResolveRoleplayForViewer(Session.DialogueText,Session.DialogueLanguage)</p></div>
   <button class="dialogue-next" @onclick="Session.AdvanceDialogue">Next</button>
  </section>
 }
 else if(_history.Count>0)
 {
  var last=_history[^1];
  <section class="inline-chat-output" aria-live="polite" aria-label="Latest roleplay output" data-roleplay-language="@last.Language">
   <div class="dialogue-portrait">
    @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
    else{<span class="dialogue-card-back" aria-hidden="true"></span>}
   </div>
   <div class="dialogue-copy"><strong>@last.Speaker <small>@last.Language</small></strong><p data-common-source="@last.Text">@Session.ResolveRoleplayForViewer(last.Text,last.Language)</p></div>
  </section>
 }
 else
 {
  <section class="inline-chat-output empty" aria-label="Roleplay output"><span class="chat-output-placeholder">Roleplay output appears here.</span></section>
 }

 <div class="footer-dock">
  <section class="home-inline-chat" aria-label="Roleplay">
   <button type="button" class="history-scroll-button chat-history-toggle" @onclick="()=>_chatHistoryOpen=true" aria-label="Open roleplay log" title="Roleplay log">LOG</button>
   <button type="button" class="roleplay-language-toggle" @onclick="Session.CycleRoleplayLanguage" aria-label="Speaking in @Session.ActiveRoleplayLanguage. Tap to change language." title="Speaking language">@Session.ActiveRoleplayLanguage</button>
   <label class="home-chat-compose"><span>Roleplay</span><textarea @bind="Session.ChatDraft" @bind:event="oninput" maxlength="1200" placeholder="@ChatPrompt"></textarea></label>
   <button type="button" class="home-chat-send" @onclick="SendInlineChat" disabled="@string.IsNullOrWhiteSpace(Session.ChatDraft)">Send</button>
   <button type="button" class="dice-tray-toggle" @onclick="ToggleDiceTray" aria-expanded="@_diceTrayOpen" aria-controls="footer-slider" aria-label="@(_diceTrayOpen?"Close dice tray":"Open dice tray")" title="@(_diceTrayOpen?"Close dice":"Dice")">
    <img class="dice-bag-toggle-art" src="assets/ui/custom_dicebag.png?v=dicebag-toggle-2" alt="" draggable="false" />
   </button>
  </section>

  <div class="native-language-settings" aria-hidden="true">
   <select data-native-primary-language value="@Session.PrimaryHumanLanguage" @onchange="PrimaryLanguageChanged" tabindex="-1">
    @foreach(var language in HumanLanguages){<option value="@language">@language</option>}
   </select>
   <select data-native-language-mode value="@Session.GmLanguageResolutionMode" @onchange="LanguageModeChanged" tabindex="-1"><option value="system">System mechanics</option><option value="percent">Set percentage</option><option value="manual">GM typed response</option></select>
   <input data-native-language-percent type="range" min="0" max="100" value="@Session.GmLanguageLegibilityPercent" @onchange="LanguagePercentChanged" tabindex="-1" />
   <textarea data-native-language-manual value="@Session.GmManualLanguageResponse" @onchange="LanguageManualChanged" tabindex="-1"></textarea>
  </div>

  <footer id="footer-slider" class="footer dice-footer release-root-rail desktop-arrow-slider @Session.RollVisibilityCssClass" data-roll-visibility="@Session.RollVisibilityMode" data-sum-enabled="@(Session.DiceSumEnabled?"true":"false")" aria-label="Character and dice tray" aria-hidden="@(!_diceTrayOpen)">
   <div class="circular-set dice-circular-set release-footer-track">
    <button type="button" class="roll-visibility-toggle" data-native-roll-mode="true" @onclick="Session.CycleRollVisibility" aria-label="@Session.RollVisibilityLabel. Change roll visibility." title="Tap to change roll visibility">@Session.RollVisibilityLabel</button>
    <button type="button" class="native-sum-toggle" data-native-sum-toggle="true" @onclick="Session.ToggleDiceSum" tabindex="-1" aria-hidden="true">SUM</button>
    <button type="button" class="footer-character-button" @onclick="Session.OpenMixer" aria-label="Open character sheet">
     @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
     <span><strong>@(string.IsNullOrWhiteSpace(Session.CharacterName)?"Character":Session.CharacterName)</strong><small>Sheet</small></span>
    </button>
    @foreach(var die in Session.DiceSet)
    {
     if(die.Key=="d5-bonus")
     {<div class="die-control d5-control bonus-d5"><select @bind="Session.BonusD5Value" aria-label="Bonus D5 value">@for(var i=1;i<=5;i++){<option value="@i">+@i</option>}</select><button type="button" class="die-button" aria-label="Roll selected bonus die" @onclick="()=>DieClick(die.Key,Session.BonusD5Value)"><span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span></button></div>}
     else if(die.Key=="d5-penalty")
     {<div class="die-control d5-control penalty-d5"><select @bind="Session.PenaltyD5Value" aria-label="Penalty D5 value">@for(var i=1;i<=5;i++){<option value="@i">-@i</option>}</select><button type="button" class="die-button" aria-label="Roll selected penalty die" @onclick="()=>DieClick(die.Key,Session.PenaltyD5Value)"><span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span></button></div>}
     else
     {<button type="button" class="die-button" aria-label="Roll @die.Label" @onclick="()=>DieClick(die.Key,null)"><span class="die-sprite die-@die.Key" style="@DieSpriteStyle(die,die.RestFrame)"></span></button>}
    }
    @if(Session.DiceSumVisibleToUser){<div class="sum" aria-label="Dice total"><span>SUM</span><span>@Session.Total</span></div>}
    <button type="button" class="history-scroll-button roll-history-toggle" @onclick="()=>_rollHistoryOpen=true" aria-label="Open roll history"><span aria-hidden="true">📜</span></button>
    <button type="button" class="clear-dice" @onclick="Session.ClearRollsWithHistory">Clear</button>
    @foreach(var c in Session.Cards){<button type="button" class="card" @onclick="()=>Session.ShowCard(c)">@c.Name</button>}
   </div>
  </footer>
 </div>
 <div class="site-copyright-notice" aria-label="Copyright notice">© 2026 Ryan L. Cole / ReLiCGameMaster · Shaelvien · RIST · All rights reserved.</div>
</div>

@if(_chatHistoryOpen){<div class="history-scroll-scrim" @onclick="()=>_chatHistoryOpen=false"><section class="history-scroll-sheet" role="dialog" aria-modal="true" aria-label="Roleplay history" @onclick:stopPropagation="true"><header><strong>Roleplay History</strong><button @onclick="()=>_chatHistoryOpen=false" aria-label="Close roleplay history">×</button></header><div class="history-scroll-body">@foreach(var message in _history){<article class="chat-history-entry"><strong>@message.Speaker · @message.Language</strong><p>@Session.ResolveRoleplayForViewer(message.Text,message.Language)</p></article>}@if(_history.Count==0){<p class="history-empty">No roleplay messages yet.</p>}</div></section></div>}
@if(_rollHistoryOpen){<div class="history-scroll-scrim" @onclick="()=>_rollHistoryOpen=false"><section class="history-scroll-sheet" role="dialog" aria-modal="true" aria-label="Roll history" @onclick:stopPropagation="true"><header><strong>Roll History</strong><button @onclick="()=>_rollHistoryOpen=false" aria-label="Close roll history">×</button></header><div class="history-scroll-body roll-history-body">@foreach(var batch in Session.RollHistoryBatches){<article class="roll-history-entry"><strong>@batch.CharacterName · @batch.VisibilityLabel</strong>@if(batch.CardNames.Count>0){<small>Card: @string.Join(", ",batch.CardNames)</small>}<p>@(Session.Role=="GM"?batch.Equation:batch.PlayerEquation)</p></article>}@if(Session.RollHistoryBatches.Count==0){<p class="history-empty">No rolls yet.</p>}</div></section></div>}
@if(Session.OpenCard is not null){<div class="card-modal" @onclick="Session.CloseCard"><article class="card-panel" @onclick:stopPropagation="true"><h2>@Session.OpenCard.Name</h2><p><strong>@Session.OpenCard.Type</strong></p><p>@Session.OpenCard.Text</p><button @onclick="Session.CloseCard">Close</button></article></div>}

@code{
 static readonly string[] HumanLanguages=["English","Spanish","French","German","Italian","Portuguese","Polish","Dutch","Swedish","Norwegian","Danish","Finnish","Russian","Ukrainian","Arabic","Hebrew","Hindi","Bengali","Urdu","Mandarin Chinese","Cantonese","Japanese","Korean","Vietnamese","Thai","Indonesian","Malay","Filipino","Swahili","Turkish","Greek","Czech","Romanian","Hungarian"];
 readonly List<(string Speaker,string Text,string Language)> _history=[];
 bool _chatHistoryOpen;
 bool _rollHistoryOpen;
 bool _diceTrayOpen;
 string ChatPrompt=>$"Roleplay · {Session.ActiveRoleplayLanguage}";
 void ToggleDiceTray()=>_diceTrayOpen=!_diceTrayOpen;
 void SendInlineChat(){var text=Session.ChatDraft?.Trim()??string.Empty;if(text.Length==0)return;_history.Add((Session.DialogueSpeaker,text,Session.ActiveRoleplayLanguage));Session.SendChat();}
 void PrimaryLanguageChanged(ChangeEventArgs e)=>Session.SetPrimaryHumanLanguage(e.Value?.ToString()??"English");
 void LanguageModeChanged(ChangeEventArgs e)=>Session.SetGmLanguageResolution(e.Value?.ToString()??"system",Session.GmLanguageLegibilityPercent,Session.GmManualLanguageResponse);
 void LanguagePercentChanged(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var value))Session.SetGmLanguageResolution("percent",value,Session.GmManualLanguageResponse);}
 void LanguageManualChanged(ChangeEventArgs e)=>Session.SetGmLanguageResolution("manual",Session.GmLanguageLegibilityPercent,e.Value?.ToString()??"");
 async Task DieClick(string key,int? magnitude){if(Session.MixerOpen&&Session.CharacterEditMode&&Session.EditingHandCard is not null){Session.AddDiceBagEntry(key);return;}await Session.RollWithHistoryAsync(key,magnitude);}
 static string DieSpriteStyle(DiceSpec die,int frame){var col=frame%die.Columns;var row=frame/die.Columns;var x=die.Columns<=1?0:col*100.0/(die.Columns-1);var y=die.Rows<=1?0:row*100.0/(die.Rows-1);return $"--die-aspect:{die.VisualAspect};background-image:url('{die.Image}?v=release-8');background-size:{die.Columns*100}% {die.Rows*100}%;background-position:{x:0.###}% {y:0.###}%";}
}
