@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth
@inject IJSRuntime JS

@if(_manifest is not null)
{
 <section class="legacy-archive-dock @(_open?"open":"minimized") @(_right?"right":"left")" aria-label="Legacy archive">
  <header>
   <button type="button" class="legacy-dock-toggle" @onclick="ToggleOpen" aria-label="@(_open?"Minimize Legacy":"Open Legacy")">▤</button>
   <span><small>LEGACY</small><strong>@_manifest.WorldName</strong></span>
   @if(_open)
   {
    <button type="button" @onclick="ToggleSide" aria-label="Move Legacy dock">@(_right?"←":"→")</button>
    <button type="button" @onclick="ToggleOpen" aria-label="Minimize Legacy">—</button>
   }
  </header>

  @if(_open)
  {
   <nav>
    <button class="@(_view=="binder"?"active":"")" @onclick="OpenBinderAsync">BINDER PDF</button>
    <button class="@(_view=="toc"?"active":"")" @onclick="ShowToc">TOC</button>
   </nav>

   <div class="legacy-dock-body @(_view=="toc"?"toc-visible":"")">
    @if(_view=="toc")
    {
     <aside class="legacy-dock-toc">
      @foreach(var entry in _manifest.Files)
      {
       var depth=Math.Min(8,entry.Path.Count(ch=>ch=='/'));
       <button type="button" class="@(_active?.Id==entry.Id?"active":"")" style="padding-left:@(8+depth*10)px" @onclick="()=>OpenEntryAsync(entry)">
        <span>@entry.Name</span><small>@entry.Category · @entry.SuggestedLocation</small>
       </button>
      }
     </aside>
    }

    <main class="legacy-dock-preview">
     @if(_loading)
     {
      <p role="status">Loading Legacy…</p>
     }
     else if(!string.IsNullOrWhiteSpace(_previewUrl))
     {
      @if(_active is not null&&_active.BrowserViewable&&!string.IsNullOrWhiteSpace(_active.AssetKey))
      {
       <img src="@_previewUrl" alt="@_active.Name" />
      }
      else
      {
       <iframe src="@_previewUrl" title="@(_active?.Name??"Legacy binder")"></iframe>
      }
     }
     else
     {
      <p>Select a Legacy file.</p>
     }
    </main>
   </div>

   <footer>
    <span>@_manifest.FileCount files · @_manifest.ImageCount images · @_manifest.ProgramCount quarantined programs</span>
    @if(_active is not null)
    {
     <button type="button" @onclick="OpenOriginalAsync">ORIGINAL</button>
    }
   </footer>
  }
 </section>
}

<style>
 .legacy-archive-dock{position:fixed;z-index:2147482200;top:54px;bottom:12px;width:min(46vw,660px);display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;border:1px solid #8e7138;border-radius:12px;background:#061016f7;color:#e8dec5;box-shadow:0 20px 65px #000d;overflow:hidden;font-family:system-ui,-apple-system,sans-serif}.legacy-archive-dock.left{left:10px}.legacy-archive-dock.right{right:10px}.legacy-archive-dock.minimized{top:auto;left:auto!important;right:12px!important;bottom:14px;width:54px;height:54px;display:block;border-radius:50%}.legacy-archive-dock.minimized header{height:100%;padding:0;border:0}.legacy-archive-dock.minimized header span,.legacy-archive-dock.minimized header>button:not(.legacy-dock-toggle){display:none}
 .legacy-archive-dock>header{display:flex;align-items:center;gap:7px;padding:8px;border-bottom:1px solid #36454c;background:#09141b}.legacy-archive-dock>header span{min-width:0;flex:1;display:grid;gap:2px}.legacy-archive-dock>header small{color:#75c5ec;font:900 7px/1 system-ui;letter-spacing:.12em}.legacy-archive-dock>header strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#efd58d;font:700 14px/1 Georgia}.legacy-archive-dock>header button{width:38px;height:36px;border:1px solid #53656e;border-radius:8px;background:#101a20;color:#efd58d}.legacy-dock-toggle{font-size:20px!important}
 .legacy-archive-dock>nav{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #304048}.legacy-archive-dock>nav button{min-height:36px;border:0;background:#0b151b;color:#9eb0b7;font:900 8px/1 system-ui;letter-spacing:.08em}.legacy-archive-dock>nav button.active{background:#18210f;color:#efd58d}
 .legacy-dock-body{min-height:0;display:grid;grid-template-columns:1fr}.legacy-dock-body.toc-visible{grid-template-columns:minmax(150px,40%) minmax(0,1fr)}.legacy-dock-toc{min-width:0;overflow:auto;border-right:1px solid #33434b;background:#071118;padding:5px}.legacy-dock-toc button{box-sizing:border-box;width:100%;min-height:40px;display:grid;gap:3px;align-content:center;border:0;border-bottom:1px solid #1d2c33;background:transparent;color:#d9e2e5;text-align:left}.legacy-dock-toc button.active{background:#17241a;color:#fff0b6}.legacy-dock-toc span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9px;font-weight:800}.legacy-dock-toc small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#75b4d5;font-size:6px;font-weight:900}
 .legacy-dock-preview{min-width:0;min-height:0;background:#02070b}.legacy-dock-preview iframe,.legacy-dock-preview img{box-sizing:border-box;width:100%;height:100%;border:0;background:#fff;object-fit:contain}.legacy-dock-preview>p{margin:18px;color:#9dafb7;font-size:10px}
 .legacy-archive-dock>footer{min-height:36px;display:flex;align-items:center;justify-content:space-between;gap:7px;padding:5px 8px;border-top:1px solid #33434b;background:#091219}.legacy-archive-dock>footer span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#8da1aa;font-size:7px}.legacy-archive-dock>footer button{min-height:28px;border:1px solid #806a38;border-radius:6px;background:#211a0c;color:#efd58d;font-size:7px;font-weight:900}
 @media(max-width:700px){.legacy-archive-dock{top:48px;left:7px!important;right:7px!important;bottom:7px;width:auto}.legacy-archive-dock.minimized{left:auto!important;right:10px!important;bottom:10px;width:52px;height:52px}.legacy-dock-body.toc-visible{grid-template-columns:minmax(122px,42%) minmax(0,1fr)}}
</style>

@code {
 LegacyArchiveManifest? _manifest;
 LegacyArchiveEntry? _active;
 IJSObjectReference? _module;
 DotNetObjectReference<LegacyArchiveDock>? _self;
 bool _open;
 bool _right;
 bool _loading;
 string _view="binder";
 string _previewUrl="";
 string _loadedWorldId="";

 protected override void OnInitialized()=>Session.Changed+=SessionChanged;

 void SessionChanged()=>_ = InvokeAsync(LoadAsync);

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(firstRender)
  {
   _self=DotNetObjectReference.Create(this);
   _module=await JS.InvokeAsync<IJSObjectReference>("import","./legacy-archive-dock.js");
   await _module.InvokeVoidAsync("attach",_self);
   await LoadAsync();
  }
 }

 async Task LoadAsync()
 {
  var worldId=Session.WorldId??"";
  if(string.Equals(worldId,_loadedWorldId,StringComparison.Ordinal)&&_manifest is not null)return;
  _loadedWorldId=worldId;
  _manifest=null;
  _active=null;
  _previewUrl="";
  if(string.IsNullOrWhiteSpace(worldId)){await InvokeAsync(StateHasChanged);return;}

  try
  {
   _manifest=await Auth.DownloadJsonAsync<LegacyArchiveManifest>(LegacyArchiveImport.ManifestKey(worldId));
   if(_manifest is null){await InvokeAsync(StateHasChanged);return;}
   _open=true;
   await OpenBinderAsync();
  }
  catch{_manifest=null;}
  await InvokeAsync(StateHasChanged);
 }

 async Task OpenBinderAsync()
 {
  if(_manifest is null)return;
  _loading=true;_view="binder";_active=null;
  await InvokeAsync(StateHasChanged);
  _previewUrl=await Auth.DownloadUrlAsync(_manifest.BinderKey)??"";
  _loading=false;
  await InvokeAsync(StateHasChanged);
 }

 void ShowToc(){_view="toc";}

 async Task OpenEntryAsync(LegacyArchiveEntry entry)
 {
  _active=entry;
  _view="toc";
  _loading=true;
  await InvokeAsync(StateHasChanged);

  var key=entry.BrowserViewable&&!string.IsNullOrWhiteSpace(entry.AssetKey)?entry.AssetKey:entry.HtmlKey;
  _previewUrl=await Auth.DownloadUrlAsync(key)??"";
  _loading=false;
  await InvokeAsync(StateHasChanged);
 }

 [JSInvokable]
 public async Task OpenLegacyEntryFromBinderAsync(string worldId,string entryId)
 {
  if(_manifest is null||!string.Equals(_manifest.WorldId,worldId,StringComparison.Ordinal))return;
  var entry=_manifest.Files.FirstOrDefault(x=>string.Equals(x.Id,entryId,StringComparison.Ordinal));
  if(entry is not null)await OpenEntryAsync(entry);
 }

 async Task OpenOriginalAsync()
 {
  if(_active is null)return;
  var url=await Auth.DownloadUrlAsync(_active.OriginalKey);
  if(!string.IsNullOrWhiteSpace(url))await JS.InvokeVoidAsync("open",url,"_blank");
 }

 void ToggleOpen()=>_open=!_open;
 void ToggleSide()=>_right=!_right;

 public async ValueTask DisposeAsync()
 {
  Session.Changed-=SessionChanged;
  if(_module is not null)
  {
   try{await _module.InvokeVoidAsync("detach");}catch{}
   try{await _module.DisposeAsync();}catch{}
  }
  _self?.Dispose();
 }
}
