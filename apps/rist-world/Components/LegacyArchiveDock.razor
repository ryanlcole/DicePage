@code {
 LegacyArchiveManifest? _manifest;
 LegacyArchiveEntry? _active;
 IJSObjectReference? _module;
 DotNetObjectReference<LegacyArchiveDock>? _self;
 bool _open;
 bool _right;
 bool _loading;
 bool _showRunecore;
 bool _runecoreBusy;
 string _runecoreStatus="";
 string _originMediaKey="";
 string _view="binder";
 string _previewUrl="";
 string _loadedWorldId="";
 const long MaxOriginMediaBytes=100L*1024*1024;

 protected override void OnInitialized()=>Session.Changed+=SessionChanged;

 void SessionChanged()=>_ = InvokeAsync(LoadAsync);

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(firstRender)
  {
   _self=DotNetObjectReference.Create(this);
   _module=await JS.InvokeAsync<IJSObjectReference>("import","./legacy-archive-dock.js");
   await _module.InvokeVoidAsync("attach",_self);
   await LoadAsync();
  }
 }

 async Task LoadAsync()
 {
  var worldId=Session.WorldId??"";
  if(string.Equals(worldId,_loadedWorldId,StringComparison.Ordinal)&&_manifest is not null)return;
  _loadedWorldId=worldId;
  _manifest=null;
  _active=null;
  _previewUrl="";
  _showRunecore=false;
  _runecoreStatus="";
  _originMediaKey="";
  if(string.IsNullOrWhiteSpace(worldId)){await InvokeAsync(StateHasChanged);return;}

  try
  {
   _manifest=await Auth.DownloadJsonAsync<LegacyArchiveManifest>(LegacyArchiveImport.ManifestKey(worldId));
   if(_manifest is null){await InvokeAsync(StateHasChanged);return;}
   _open=true;
   await OpenBinderAsync();
  }
  catch{_manifest=null;}
  await InvokeAsync(StateHasChanged);
 }

 async Task OpenBinderAsync()
 {
  if(_manifest is null)return;
  _loading=true;_view="binder";_active=null;
  _showRunecore=false;
  _runecoreStatus="";
  _originMediaKey="";
  await InvokeAsync(StateHasChanged);
  _previewUrl=await Auth.DownloadUrlAsync(_manifest.BinderKey)??"";
  _loading=false;
  await InvokeAsync(StateHasChanged);
 }

 void ShowToc(){_view="toc";}

 async Task OpenEntryAsync(LegacyArchiveEntry entry)
 {
  _active=entry;
  _view="toc";
  _loading=true;
  _showRunecore=false;
  _runecoreStatus="";
  _originMediaKey="";
  await InvokeAsync(StateHasChanged);

  var key=entry.BrowserViewable&&!string.IsNullOrWhiteSpace(entry.AssetKey)?entry.AssetKey:entry.HtmlKey;
  _previewUrl=await Auth.DownloadUrlAsync(key)??"";
  _loading=false;
  await InvokeAsync(StateHasChanged);
 }

 [JSInvokable]
 public async Task OpenLegacyEntryFromBinderAsync(string worldId,string entryId)
 {
  if(_manifest is null||!string.Equals(_manifest.WorldId,worldId,StringComparison.Ordinal))return;
  var entry=_manifest.Files.FirstOrDefault(x=>string.Equals(x.Id,entryId,StringComparison.Ordinal));
  if(entry is not null)await OpenEntryAsync(entry);
 }

 void ToggleRunecore()
 {
  if(_active is null)return;
  _showRunecore=!_showRunecore;
  _runecoreStatus="";
 }

 async Task AttachOriginMediaAsync(InputFileChangeEventArgs e)
 {
  if(_manifest is null||_active is null||_runecoreBusy)return;
  var file=e.File;
  if(file.Size<=0){_runecoreStatus="Choose a license or origin-media file.";return;}
  if(file.Size>MaxOriginMediaBytes){_runecoreStatus="Origin-media attachment is currently limited to 100 MB in the browser. Preserve larger media separately until the capsule uploader is available.";return;}

  _runecoreBusy=true;
  _runecoreStatus=$"Preserving {file.Name} privately…";
  await InvokeAsync(StateHasChanged);
  try
  {
   await using var stream=file.OpenReadStream(MaxOriginMediaBytes);
   using var buffer=new MemoryStream();
   await stream.CopyToAsync(buffer);
   _originMediaKey=LegacyArchiveImport.OriginMediaKey(_manifest.WorldId,_active.Id,file.Name);
   var contentType=string.IsNullOrWhiteSpace(file.ContentType)?"application/octet-stream":file.ContentType;
   await Auth.UploadBytesAsync(_originMediaKey,buffer.ToArray(),contentType);
   _runecoreStatus="Licensed/origin media attached. It is private and will not be auto-executed.";
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Runecore origin media upload failed: {ex}");
   _runecoreStatus="Origin media could not be attached.";
  }
  finally
  {
   _runecoreBusy=false;
   await InvokeAsync(StateHasChanged);
  }
 }

 async Task PrepareCapsuleAsync()
 {
  if(_manifest is null||_active is null||_runecoreBusy)return;
  _runecoreBusy=true;
  _runecoreStatus="Preparing isolated origin capsule specification…";
  await InvokeAsync(StateHasChanged);
  try
  {
   var request=LegacyArchiveImport.CreateCapsuleRequest(_manifest,_active,_originMediaKey);
   await Auth.UploadTextAsync(
    LegacyArchiveImport.CapsuleRequestKey(_manifest.WorldId,_active.Id),
    JsonSerializer.Serialize(request,new JsonSerializerOptions{WriteIndented=true}),
    "application/json");
   _runecoreStatus=request.Status=="ready-for-isolated-executor"
    ?"Capsule specification is ready. This build does not execute it locally; a Runecore isolated executor can consume the private request."
    :"Capsule specification saved. Add legitimately acquired origin software/media before an isolated executor can run it.";
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Runecore capsule preparation failed: {ex}");
   _runecoreStatus="Capsule specification could not be prepared.";
  }
  finally
  {
   _runecoreBusy=false;
   await InvokeAsync(StateHasChanged);
  }
 }

 async Task OpenOriginalAsync()
 {
  if(_active is null)return;
  var url=await Auth.DownloadUrlAsync(_active.OriginalKey);
  if(!string.IsNullOrWhiteSpace(url))await JS.InvokeVoidAsync("open",url,"_blank");
 }

 void ToggleOpen()=>_open=!_open;
 void ToggleSide()=>_right=!_right;

 public async ValueTask DisposeAsync()
 {
  Session.Changed-=SessionChanged;
  if(_module is not null)
  {
   try{await _module.InvokeVoidAsync("detach");}catch{}
   try{await _module.DisposeAsync();}catch{}
  }
  _self?.Dispose();
 }
}
