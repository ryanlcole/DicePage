 .legacy-archive-dock>nav{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #304048}.legacy-archive-dock>nav button{min-height:36px;border:0;background:#0b151b;color:#9eb0b7;font:900 8px/1 system-ui;letter-spacing:.08em}.legacy-archive-dock>nav button.active{background:#18210f;color:#efd58d}
 .legacy-dock-body{min-height:0;display:grid;grid-template-columns:1fr}.legacy-dock-body.toc-visible{grid-template-columns:minmax(150px,40%) minmax(0,1fr)}.legacy-dock-toc{min-width:0;overflow:auto;border-right:1px solid #33434b;background:#071118;padding:5px}.legacy-dock-toc button{box-sizing:border-box;width:100%;min-height:40px;display:grid;gap:3px;align-content:center;border:0;border-bottom:1px solid #1d2c33;background:transparent;color:#d9e2e5;text-align:left}.legacy-dock-toc button.active{background:#17241a;color:#fff0b6}.legacy-dock-toc span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9px;font-weight:800}.legacy-dock-toc small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#75b4d5;font-size:6px;font-weight:900}
