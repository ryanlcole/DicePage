@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@implements IAsyncDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth
@inject IJSRuntime JS

@if(_manifest is not null)
{
 <section class="legacy-archive-dock @(_open?"open":"minimized") @(_right?"right":"left")" aria-label="Legacy archive">
  <header>
   <button type="button" class="legacy-dock-toggle" @onclick="ToggleOpen" aria-label="@(_open?"Minimize Legacy":"Open Legacy")">▤</button>
   <span><small>LEGACY</small><strong>@_manifest.WorldName</strong></span>
   @if(_open)
   {
    <button type="button" @onclick="ToggleSide" aria-label="Move Legacy dock">@(_right?"←":"→")</button>
    <button type="button" @onclick="ToggleOpen" aria-label="Minimize Legacy">—</button>
   }
  </header>

  @if(_open)
  {
   <nav>
    <button class="@(_view=="binder"?"active":"")" @onclick="OpenBinderAsync">BINDER PDF</button>
    <button class="@(_view=="toc"?"active":"")" @onclick="ShowToc">TOC</button>
   </nav>

   <div class="legacy-dock-body @(_view=="toc"?"toc-visible":"")">
    @if(_view=="toc")
    {
     <aside class="legacy-dock-toc">
      @foreach(var entry in _manifest.Files)
      {
       var depth=Math.Min(8,entry.Path.Count(ch=>ch=='/'));
       <button type="button" class="@(_active?.Id==entry.Id?"active":"")" style="padding-left:@(8+depth*10)px" @onclick="()=>OpenEntryAsync(entry)">
        <span>@entry.Name</span><small>@entry.Category · @entry.SuggestedLocation</small>
       </button>
      }
     </aside>
    }

    <main class="legacy-dock-preview">
     @if(_showRunecore&&_active?.Runecore is not null)
     {
      <section class="legacy-runecore" aria-label="Runecore origin compatibility">
       <header><small>RUNECORE</small><strong>@_active.Runecore.FormatLabel</strong></header>
       <dl>
        <dt>State</dt><dd>@_active.Runecore.State</dd>
        <dt>Origin</dt><dd>@_active.Runecore.OriginApplication</dd>
        <dt>Vendor</dt><dd>@_active.Runecore.OriginVendor</dd>
        <dt>Platform</dt><dd>@_active.Runecore.Platform · @_active.Runecore.Architecture</dd>
        <dt>Era</dt><dd>@_active.Runecore.Era</dd>
        <dt>Confidence</dt><dd>@_active.Runecore.Confidence</dd>
        <dt>Capsule</dt><dd>@_active.Runecore.CapsuleProfile</dd>
       </dl>
       <p>@_active.Runecore.Evidence</p>
       <p class="legacy-runecore-license">@_active.Runecore.LicensePolicy</p>

       @if(_active.Runecore.OriginSoftwareMayBeRequired)
       {
        <label class="legacy-origin-media @(_runecoreBusy?"disabled":"")">
         <strong>LICENSE / ORIGIN MEDIA</strong>
         <small>Attach your legitimately acquired installer, license file, receipt, or other origin media. It stays private and is never auto-run.</small>
         <InputFile OnChange="AttachOriginMediaAsync" disabled="@_runecoreBusy" />
        </label>
       }

       <button type="button" class="legacy-prepare-capsule" disabled="@_runecoreBusy" @onclick="PrepareCapsuleAsync">
        @(_runecoreBusy?"PREPARING…":"PREPARE ORIGIN CAPSULE")
       </button>
       <small class="legacy-runecore-boundary">NO NETWORK · NO HOST CREDENTIALS · READ-ONLY SOURCE · EPHEMERAL WRITABLE SCRATCH</small>
       @if(!string.IsNullOrWhiteSpace(_runecoreStatus))
       {
        <output>@_runecoreStatus</output>
       }
      </section>
     }
     else if(_loading)
     {
      <p role="status">Loading Legacy…</p>
     }
     else if(!string.IsNullOrWhiteSpace(_previewUrl))
     {
      @if(_active is not null&&_active.BrowserViewable&&!string.IsNullOrWhiteSpace(_active.AssetKey))
      {
       <img src="@_previewUrl" alt="@_active.Name" />
      }
      else
      {
       <iframe src="@_previewUrl" title="@(_active?.Name??"Legacy binder")"></iframe>
      }
     }
     else
     {
      <p>Select a Legacy file.</p>
     }
    </main>
   </div>

   <footer>
    <span>@_manifest.FileCount files · @_manifest.ImageCount images · @_manifest.ProgramCount quarantined programs</span>
    @if(_active is not null)
    {
     <span class="legacy-footer-actions">
      <button type="button" class="@(_showRunecore?"active":"")" @onclick="ToggleRunecore">RUNECORE</button>
      <button type="button" @onclick="OpenOriginalAsync">ORIGINAL</button>
     </span>
    }
   </footer>
  }
 </section>
}

