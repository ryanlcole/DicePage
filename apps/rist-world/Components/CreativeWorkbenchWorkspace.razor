@code {
 [Parameter] public EventCallback OnHome { get; set; }
 [Parameter] public EventCallback<string> OnOpenWorkspace { get; set; }

 sealed record MediumChoice(string Id,string Icon,string Label,string Discipline,string Help);
 sealed record MacroStage(string Id,string Icon,string Label);

 static readonly MediumChoice[] Mediums =
 [
  new("idea","✦","IDEA","Story","Capture a rough thought without choosing a medium yet."),
  new("words","¶","WORDS","Story","Narrative, dialogue, lore, scripts, or notes."),
  new("picture","▧","PICTURE","Visual","Sketches, images, composition, or visual references."),
  new("sound","♪","SOUND","Audio","Voice, ambience, music, rhythm, or a sound concept."),
  new("map","⌖","MAP","Visual","Spatial layout, geography, rooms, or tactical composition."),
  new("mechanic","⌘","MECHANIC","Systems","Rules, triggers, conditions, encounters, or responsive logic."),
  new("playable","▶","PLAYABLE","Production","Start from something already close to a playable scene.")
 ];
 static readonly MacroStage[] MacroStages =
 [
  new("ideas","✦","IDEAS"),new("work","✎","WORK"),new("production","◆","PRODUCTION"),new("play","▶","PLAY"),new("shelf","▤","SHELF")
 ];
 static readonly string[] AssistanceModes=["Teach","Help","Suggest","Predict","Quiet"];
 static readonly string[] Pipeline=["Capture","Shape","Compare","Refine","Combine","Produce","Play"];

 CreativeWorkbenchBoard _board=CreativeWorkbenchBoard.CreateDefault("");
 bool _loaded;
 string _view="ideas",_activeMedium="idea",_selectedId="",_titleDraft="",_notesDraft="",_prosDraft="",_consDraft="",_status="";
 readonly HashSet<string> _compareIds=new(StringComparer.Ordinal);

 CreativeWorkItem? Selected=>_board.Items.FirstOrDefault(item=>item.Id==_selectedId);
 List<CreativeWorkItem> CompareItems=>_board.Items.Where(item=>_compareIds.Contains(item.Id)).Take(3).ToList();
 string CurrentDiscipline=>DisciplineFor(Selected?.Medium??_activeMedium);
 CreativeDisciplineProfile CurrentProfile=>_board.Disciplines.FirstOrDefault(p=>p.Discipline==CurrentDiscipline)??new(CurrentDiscipline,0,0,0,"Suggest");
 string CurrentAssistance=>CurrentProfile.AssistanceMode;
 string ViewLabel=>MacroStages.First(x=>x.Id==_view).Label;
 List<CreativeWorkItem> VisibleItems=>_board.Items.Where(IsVisibleInCurrentView).OrderByDescending(x=>x.UpdatedAtUtc).ToList();
 string GuidanceTitle=>CurrentAssistance switch{"Teach"=>"TEACH ME","Help"=>"HELP ME","Suggest"=>"OPTIONAL NEXT STEPS","Predict"=>"LIKELY NEXT MOVE",_=>""};
 string GuidanceText=>GuidanceFor(Selected,CurrentAssistance);
 string BridgeText=>StrengthBridge(Selected);
 string ForwardLabel=>Selected is null?"MOVE FORWARD":Selected.Stage=="Refine"?"IRON IN":Selected.Stage=="Produce"?"READY TO PLAY":Selected.Stage=="Play"?"PLAY READY":"MOVE FORWARD";
 string StudioTarget=>Selected?.Medium switch{"picture"=>"assets","map"=>"world","mechanic"=>"powers","playable"=>"campaign","words"=>"campaign","idea"=>"campaign",_=>""};
 string StudioLabel=>string.IsNullOrWhiteSpace(StudioTarget)?"NO STUDIO YET":"OPEN STUDIO";

 protected override async Task OnInitializedAsync()
 {
  _board=await Session.LoadCreativeWorkbenchAsync();
  _loaded=true;
  _status=_board.Items.Length==0?"Choose what you already have. Rough work is welcome.":"Private workbench loaded.";
 }

 void SetView(string view){_view=view;_selectedId="";_status="";}

 async Task CreateDraftAsync(string medium)
 {
  _activeMedium=medium;
  var choice=Mediums.First(x=>x.Id==medium);
  var stage=medium=="playable"?"Produce":"Capture";
  var now=DateTimeOffset.UtcNow;
  var item=new CreativeWorkItem($"draft-{Guid.NewGuid():N}",$"New {choice.Label.ToLowerInvariant()} draft",medium,stage,"Active","",[],[],false,now,now);
  _board=_board with{Items=[item,.._board.Items],UpdatedAtUtc=now};
  SelectItem(item);
  _view=MacroFor(item);
  _board=await Session.SaveCreativeWorkbenchAsync(_board);
  _status="Draft captured privately.";
 }

 void SelectItem(CreativeWorkItem item)
 {
  _selectedId=item.Id;_activeMedium=item.Medium;
  _titleDraft=item.Title;_notesDraft=item.Notes;
  _prosDraft=string.Join("\n",item.Pros);_consDraft=string.Join("\n",item.Cons);
 }

 async Task SaveEditorAsync()
 {
  if(Selected is null)return;
  ReplaceSelected(item=>item with{
   Title=string.IsNullOrWhiteSpace(_titleDraft)?"Untitled draft":_titleDraft.Trim(),
   Notes=_notesDraft,
   Pros=Lines(_prosDraft),
   Cons=Lines(_consDraft),
   UpdatedAtUtc=DateTimeOffset.UtcNow});
  await SaveBoardAsync("Draft saved.");
 }

 async Task MoveForwardAsync()
 {
  if(Selected is null)return;
  await SaveEditorAsync();
  var item=Selected;if(item is null)return;
  var index=Array.IndexOf(Pipeline,item.Stage);
  if(index<0||index>=Pipeline.Length-1){_status="This work is already at Play.";return;}
  var next=Pipeline[index+1];
  ReplaceSelected(x=>x with{
   Stage=next,
   Disposition=next=="Produce"?"Promoted":x.Disposition=="Promoted"?"Promoted":"Active",
   UpdatedAtUtc=DateTimeOffset.UtcNow});
  _view=MacroFor(Selected!);
  await SaveBoardAsync(next=="Combine"?"Ironed into the working composition.":next=="Produce"?"Moved to production.":next=="Play"?"Ready for play and testing.":$"Moved to {next}.");
 }

 async Task TableSelectedAsync(){if(Selected is null)return;ReplaceSelected(x=>x with{Disposition="Tabled",UpdatedAtUtc=DateTimeOffset.UtcNow});_view="shelf";await SaveBoardAsync("Tabled without deleting it.");}
 async Task DiscardSelectedAsync(){if(Selected is null)return;ReplaceSelected(x=>x with{Disposition="Discarded",UpdatedAtUtc=DateTimeOffset.UtcNow});_view="shelf";await SaveBoardAsync("Discarded from active work. It remains recoverable on the Shelf.");}
 async Task RestoreSelectedAsync(){if(Selected is null)return;ReplaceSelected(x=>x with{Disposition=x.Placeholder?"Placeholder":"Active",UpdatedAtUtc=DateTimeOffset.UtcNow});_view=MacroFor(Selected!);await SaveBoardAsync("Restored to active work.");}
 async Task TogglePlaceholderAsync(){if(Selected is null)return;var next=!Selected.Placeholder;ReplaceSelected(x=>x with{Placeholder=next,Disposition=next?"Placeholder":"Active",UpdatedAtUtc=DateTimeOffset.UtcNow});await SaveBoardAsync(next?"Marked as a legitimate temporary placeholder.":"Marked as authored content.");}

 async Task DeletePermanentlyAsync()
 {
  if(Selected is null)return;
  var id=Selected.Id;
  _board=_board with{Items=_board.Items.Where(x=>x.Id!=id).ToArray(),UpdatedAtUtc=DateTimeOffset.UtcNow};
  _compareIds.Remove(id);_selectedId="";
  await SaveBoardAsync("Permanently deleted from this private workbench.");
 }

 void ToggleCompare(string id)
 {
  if(!_compareIds.Add(id))_compareIds.Remove(id);
  while(_compareIds.Count>3)_compareIds.Remove(_compareIds.First());
  _status=_compareIds.Count<2?"Choose one more draft to compare.":"Comparison ready.";
 }

 async Task SetCurrentAssistanceAsync(string mode)=>await SetAssistanceAsync(CurrentDiscipline,mode);
 async Task ChangeAssistanceAsync(string discipline,ChangeEventArgs e)=>await SetAssistanceAsync(discipline,e.Value?.ToString()??"Suggest");

 async Task SetAssistanceAsync(string discipline,string mode)
 {
  if(!AssistanceModes.Contains(mode,StringComparer.Ordinal))mode="Suggest";
  _board=_board with{Disciplines=_board.Disciplines.Select(p=>p.Discipline==discipline?p with{AssistanceMode=mode}:p).ToArray(),UpdatedAtUtc=DateTimeOffset.UtcNow};
  await SaveBoardAsync($"{discipline} assistance set to {mode}.");
 }

 async Task SetProfileMetricAsync(string discipline,string metric,ChangeEventArgs e)
 {
  var value=int.TryParse(e.Value?.ToString(),out var parsed)?Math.Clamp(parsed,0,4):0;
  _board=_board with{Disciplines=_board.Disciplines.Select(p=>p.Discipline!=discipline?p:metric switch{
   "strength"=>p with{Strength=value},
   "enjoyment"=>p with{Enjoyment=value},
   "growth"=>p with{GrowthInterest=value},
   _=>p}).ToArray(),UpdatedAtUtc=DateTimeOffset.UtcNow};
  await SaveBoardAsync($"{discipline} creative fit updated.");
 }

 async Task OpenStudioAsync()
 {
  if(string.IsNullOrWhiteSpace(StudioTarget))return;
  await SaveEditorAsync();
  await OnOpenWorkspace.InvokeAsync(StudioTarget);
 }

 void ReplaceSelected(Func<CreativeWorkItem,CreativeWorkItem> update)
 {
  if(Selected is null)return;
  var id=Selected.Id;
  _board=_board with{Items=_board.Items.Select(item=>item.Id==id?update(item):item).ToArray(),UpdatedAtUtc=DateTimeOffset.UtcNow};
  var changed=Selected;
  if(changed is not null){_titleDraft=changed.Title;_notesDraft=changed.Notes;_prosDraft=string.Join("\n",changed.Pros);_consDraft=string.Join("\n",changed.Cons);}
 }

 async Task SaveBoardAsync(string status)
 {
  _board=await Session.SaveCreativeWorkbenchAsync(_board);
  _status=status;
 }

 bool IsVisibleInCurrentView(CreativeWorkItem item)
 {
  if(_view=="shelf")return IsShelved(item);
  if(IsShelved(item))return false;
  return _view switch{
   "ideas"=>item.Stage is "Capture" or "Shape" or "Compare",
   "work"=>item.Stage is "Refine" or "Combine",
   "production"=>item.Stage=="Produce",
   "play"=>item.Stage=="Play",
   _=>true};
 }
 static bool IsShelved(CreativeWorkItem item)=>item.Disposition is "Tabled" or "Discarded";
 static string MacroFor(CreativeWorkItem item)=>IsShelved(item)?"shelf":item.Stage switch{"Capture" or "Shape" or "Compare"=>"ideas","Refine" or "Combine"=>"work","Produce"=>"production","Play"=>"play",_=>"ideas"};
 static string[] Lines(string raw)=>raw.Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Trim()).Where(x=>x.Length>0).Take(24).ToArray();
 static string DisciplineFor(string medium)=>medium switch{"picture" or "map"=>"Visual","sound"=>"Audio","mechanic"=>"Systems","playable"=>"Production",_=>"Story"};
 static string MediumLabel(string medium)=>Mediums.FirstOrDefault(x=>x.Id==medium)?.Label??medium.ToUpperInvariant();
 static string MediumIcon(string medium)=>Mediums.FirstOrDefault(x=>x.Id==medium)?.Icon??"✦";

 string GuidanceFor(CreativeWorkItem? item,string mode)
 {
  if(item is null)return "";
  var medium=MediumLabel(item.Medium).ToLowerInvariant();
  return mode switch{
   "Teach"=>$"You are working in {item.Stage}. Keep the {medium} rough enough to change. First state what it must accomplish, then make one version, then test whether the result actually communicates that purpose.",
   "Help"=>$"Work the immediate obstacle only. Save the useful part of this {medium}, name the problem that is blocking you, and use the bottom actions to move, table, compare, or open the specialized studio.",
   "Suggest"=>$"Optional: make one deliberately different alternative before polishing this {medium}. Compare the versions by what each does well, not by which looks most finished.",
   "Predict"=>$"Based on this stage, the likely next useful operation is {ForwardLabel}. It is prepared as a visible action below, but Shaelvien will not perform it until you choose it.",
   _=>""
  };
 }

 string StrengthBridge(CreativeWorkItem? item)
 {
  if(item is null)return "";
  var current=CurrentProfile;
  var strongest=_board.Disciplines.OrderByDescending(p=>p.Strength).ThenByDescending(p=>p.Enjoyment).FirstOrDefault();
  if(strongest is null||strongest.Strength<=current.Strength||strongest.Strength==0||strongest.Discipline==current.Discipline)return "";
  return (strongest.Discipline,current.Discipline) switch{
   ("Visual","Story")=>"Use your visual strength as the bridge: sketch the scene as panels, then describe what changes between panels as story beats.",
   ("Story","Visual")=>"Use your story strength as the bridge: describe foreground, focus, conflict, and consequence, then place visual elements to serve those beats.",
   ("Audio","Story")=>"Use your audio strength as the bridge: map quiet, tension, impact, release, and silence into narrative pacing.",
   ("Systems","Story")=>"Use your systems strength as the bridge: express the scene as state → choice → consequence, then turn those transitions into beats.",
   ("Story","Systems")=>"Use your story strength as the bridge: identify each meaningful choice in the scene, then formalize what changes after it.",
   ("Performance","Story")=>"Use your performance strength as the bridge: speak the scene first, keep the lines that feel alive, then edit the transcript.",
   _=>$"Use your {strongest.Discipline.ToLowerInvariant()} strength as a bridge while developing {current.Discipline.ToLowerInvariant()}."
  };
 }
}
