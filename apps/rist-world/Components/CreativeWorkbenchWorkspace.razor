@inject WorldSession Session

<div class="creative-workbench">
 <header class="cw-header">
  <div class="cw-title">
   <span class="cw-kicker">CREATE · PRIVATE WORKBENCH</span>
   <strong>@Session.WorldDisplayName</strong>
   <small>Capture anything. Nothing becomes production truth until you move it forward.</small>
  </div>
  <nav class="cw-stage-tabs" aria-label="Creative workflow">
   @foreach(var stage in MacroStages)
   {
    <button type="button" class="@(stage.Id==_view?"active":"")" aria-pressed="@(stage.Id==_view)" @onclick="()=>SetView(stage.Id)">
     <span aria-hidden="true">@stage.Icon</span><strong>@stage.Label</strong>
    </button>
   }
  </nav>
  <div class="cw-assist" aria-label="Assistance level">
   @foreach(var mode in AssistanceModes)
   {
    <button type="button" class="@(mode==CurrentAssistance?"active":"")" aria-pressed="@(mode==CurrentAssistance)" @onclick="()=>SetCurrentAssistanceAsync(mode)">@mode</button>
   }
  </div>
 </header>

 <aside class="cw-left" aria-label="Start with what you have">
  <span class="cw-rail-label">START WITH</span>
  @foreach(var medium in Mediums)
  {
   <button type="button" class="@(_activeMedium==medium.Id?"active":"")" title="@medium.Help" aria-label="@medium.Label — @medium.Help" @onclick="()=>CreateDraftAsync(medium.Id)">
    <span aria-hidden="true">@medium.Icon</span><strong>@medium.Label</strong>
   </button>
  }
 </aside>

 <main class="cw-center">
  @if(!_loaded)
  {
   <section class="cw-empty"><strong>Loading your private workbench…</strong></section>
  }
  else if(Selected is null)
  {
   <section class="cw-welcome">
    <p class="cw-eyebrow">WHAT DO YOU HAVE?</p>
    <h1>Start where you think best.</h1>
    <p>A sentence, sketch, sound, map, mechanic, or half-formed idea is enough. Choose an instrument on the left. Shaelvien keeps every medium in the same production path.</p>
    <div class="cw-principles">
     <span>CAPTURE</span><b>→</b><span>SHAPE</span><b>→</b><span>COMPARE</span><b>→</b><span>REFINE</span><b>→</b><span>IRON IN</span><b>→</b><span>PRODUCE</span><b>→</b><span>PLAY</span>
    </div>
    <p class="cw-status">@_status</p>
   </section>
  }
  else
  {
   <section class="cw-editor" aria-label="Creative draft editor">
    <header>
     <div>
      <p class="cw-eyebrow">@MediumLabel(Selected.Medium) · @Selected.Stage</p>
      <input class="cw-title-input" @bind="_titleDraft" @bind:event="oninput" aria-label="Draft title" />
     </div>
     <div class="cw-badges">
      @if(Selected.Placeholder){<span>PLACEHOLDER</span>}
      <span>@Selected.Disposition.ToUpperInvariant()</span>
     </div>
    </header>

    @if(CurrentAssistance!="Quiet")
    {
     <aside class="cw-guidance" aria-live="polite">
      <strong>@GuidanceTitle</strong>
      <p>@GuidanceText</p>
      @if(!string.IsNullOrWhiteSpace(BridgeText)){<small>@BridgeText</small>}
     </aside>
    }

    <label class="cw-field"><span>WORKING NOTES</span><textarea @bind="_notesDraft" @bind:event="oninput" placeholder="Rough is allowed. Capture the useful part first."></textarea></label>

    <div class="cw-evaluation">
     <label class="cw-field"><span>PROS · one per line</span><textarea @bind="_prosDraft" @bind:event="oninput" placeholder="What is working?"></textarea></label>
     <label class="cw-field"><span>CONS · one per line</span><textarea @bind="_consDraft" @bind:event="oninput" placeholder="What needs work?"></textarea></label>
    </div>

    @if(CompareItems.Count>=2)
    {
     <section class="cw-compare" aria-label="Compare drafts">
      <header><strong>COMPARE</strong><span>@CompareItems.Count drafts</span></header>
      <div>
       @foreach(var item in CompareItems)
       {
        <article>
         <strong>@item.Title</strong><small>@MediumLabel(item.Medium) · @item.Stage</small>
         <p>@(string.IsNullOrWhiteSpace(item.Notes)?"No notes yet.":item.Notes)</p>
         <dl><dt>PROS</dt><dd>@(item.Pros.Length==0?"—":string.Join(" · ",item.Pros))</dd><dt>CONS</dt><dd>@(item.Cons.Length==0?"—":string.Join(" · ",item.Cons))</dd></dl>
        </article>
       }
      </div>
     </section>
    }

    <details class="cw-profile">
     <summary>MY CREATIVE FIT · optional</summary>
     <p>Strength, enjoyment, and learning interest are separate. Shaelvien never treats difficulty in one craft as lack of value.</p>
     <div class="cw-profile-grid">
      @foreach(var profile in _board.Disciplines)
      {
       <section>
        <strong>@profile.Discipline</strong>
        <label>Strength <input type="range" min="0" max="4" value="@profile.Strength" @onchange="e=>SetProfileMetricAsync(profile.Discipline,"strength",e)" /></label>
        <label>Enjoyment <input type="range" min="0" max="4" value="@profile.Enjoyment" @onchange="e=>SetProfileMetricAsync(profile.Discipline,"enjoyment",e)" /></label>
        <label>Want to learn <input type="range" min="0" max="4" value="@profile.GrowthInterest" @onchange="e=>SetProfileMetricAsync(profile.Discipline,"growth",e)" /></label>
        <label>Assistance
         <select value="@profile.AssistanceMode" @onchange="e=>ChangeAssistanceAsync(profile.Discipline,e)">
          @foreach(var mode in AssistanceModes){<option value="@mode">@mode</option>}
         </select>
        </label>
       </section>
      }
     </div>
    </details>
    <p class="cw-status" role="status">@_status</p>
   </section>
  }
 </main>

 <aside class="cw-right" aria-label="Draft shelf">
  <header><span class="cw-rail-label">@ViewLabel</span><strong>@VisibleItems.Count</strong></header>
  <div class="cw-drafts">
   @foreach(var item in VisibleItems)
   {
    <article class="@(item.Id==_selectedId?"selected":"") @(item.Disposition.ToLowerInvariant())">
     <button class="cw-draft-main" type="button" @onclick="()=>SelectItem(item)">
      <span aria-hidden="true">@MediumIcon(item.Medium)</span>
      <strong>@item.Title</strong><small>@item.Stage</small>
     </button>
     <button type="button" class="@(_compareIds.Contains(item.Id)?"active":"")" aria-pressed="@_compareIds.Contains(item.Id)" @onclick="()=>ToggleCompare(item.Id)">⇄<span>Compare</span></button>
    </article>
   }
   @if(VisibleItems.Count==0){<p class="cw-none">Nothing here yet.</p>}
  </div>
 </aside>

 <footer class="cw-actions" aria-label="Context actions">
  @if(Selected is null)
  {
   <span>Choose a medium on the left or a draft on the right.</span>
  }
  else if(IsShelved(Selected))
  {
   <button type="button" @onclick="RestoreSelectedAsync">RESTORE</button>
   <button type="button" @onclick="DeletePermanentlyAsync">DELETE PERMANENTLY</button>
  }
  else
  {
   <button type="button" @onclick="SaveEditorAsync">SAVE DRAFT</button>
   <button type="button" class="@(_compareIds.Contains(Selected.Id)?"active":"")" @onclick="()=>ToggleCompare(Selected.Id)">COMPARE</button>
   <button type="button" @onclick="TogglePlaceholderAsync">@(Selected.Placeholder?"REAL CONTENT":"PLACEHOLDER")</button>
   <button type="button" @onclick="TableSelectedAsync">TABLE</button>
   <button type="button" @onclick="DiscardSelectedAsync">DISCARD</button>
   <button type="button" class="primary" @onclick="MoveForwardAsync">@ForwardLabel</button>
   <button type="button" disabled="@string.IsNullOrWhiteSpace(StudioTarget)" @onclick="OpenStudioAsync">@StudioLabel</button>
  }
 </footer>
</div>

