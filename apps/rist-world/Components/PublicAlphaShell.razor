@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject WorldSession Session
@inject DiscordAuthClient Auth

@if (!_workspaceOpen)
{
 <main class="launcher-hub @(_parallaxEnabled?"koi-parallax-on":"")" aria-label="Shaelvien launcher">
  <div class="launcher-depth-scene" aria-hidden="true">
   <span class="launcher-depth-layer launcher-depth-stars"></span>
   <span class="launcher-depth-layer launcher-depth-aura"></span>
   <span class="launcher-depth-layer launcher-depth-orbits"></span>
   <span class="launcher-depth-layer launcher-depth-world"></span>
  </div>
  <div class="launcher-koi-parallax" aria-hidden="true">
   <span class="launcher-koi-track launcher-koi-far"><i class="launcher-koi-body"></i></span>
   <span class="launcher-koi-track launcher-koi-near"><i class="launcher-koi-body"></i></span>
  </div>
  @if(Session.IsGeonaphWorld)
  {
   <section class="launcher-world-selectbar launcher-mmo-selectbar" aria-label="Navigate between MMO worlds inside Shaelvien">
    <label for="landing-mmo-world-select">MMO WORLD</label>
    <select id="landing-mmo-world-select" value="@LandingMmoWorldValue" @onchange="SelectLandingMmoWorldAsync" disabled="@_worldSelectionBusy" aria-label="Navigate between MMO worlds inside Shaelvien">
     <option value="">SHAELVIEN · ENDEMAR</option>
     @foreach(var parcel in AccessibleMmoWorlds)
     {
      <option value="@parcel.ParcelId">@parcel.DisplayName</option>
     }
    </select>
   </section>
  }
  else
  {
   <section class="launcher-world-selectbar" aria-label="Navigate between your sandbox worlds">
    <label for="landing-sandbox-world-select">SANDBOX WORLD</label>
    <select id="landing-sandbox-world-select" value="@LandingSandboxWorldValue" @onchange="SelectLandingSandboxWorldAsync" disabled="@_worldSelectionBusy" aria-label="Navigate between your sandbox worlds">
     <option value="">SELECT SANDBOX WORLD</option>
     @foreach(var world in _sandboxWorlds)
     {
      <option value="@world.WorldId">@world.DisplayName</option>
     }
    </select>
   </section>
  }
  <section class="launcher-hero">
   <div class="launcher-crest" aria-hidden="true">✦</div>
   <p class="launcher-kicker">SHAELVIEN · RIST</p>
   <h1>SHAELVIEN</h1>
   <p class="launcher-subtitle">A LIVING WORLD AWAITS</p>
   <p class="launcher-tagline">BUILD THE WORLD.<br />THEN STEP INSIDE IT.</p>
   @if(WorldReady)
   {
    <p class="launcher-world-loaded">@LandingLoadedLabel</p>
   }
   <button type="button" class="launcher-enter" disabled="@(!WorldReady)" @onclick="OpenRoleplay">@(Session.IsGeonaphWorld?"ENTER SHAELVIEN":"ENTER SANDBOX")</button>
  </section>

  <section class="launcher-primary" aria-label="Shaelvien categories">
   <button type="button" class="launcher-card world" disabled="@(!CanOpenWorldBuilder)" @onclick="OpenWorldbuilding"><span class="card-icon">◈</span><strong>WORLDBUILDER</strong><small>@(!WorldReady?"Select a world above first.":CanBuildWorld?"Build the selected world.":Session.IsGeonaphWorld?"Explore Shaelvien from Endemar, claim a world square, or enter one you can build.":"Build access required for this world.")</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenRegionDefiner"><span class="card-icon">▦</span><strong>REGIONDEFINER</strong><small>@(CanBuildWorld?"Define regions from published world tiles.":"View the RegionDefiner layout as a read-only reference.")</small></button>
   <button type="button" class="launcher-card accessibility-shell-card" @onclick="OpenAccessibilityShell"><span class="card-icon" aria-hidden="true">⌨</span><strong>ACCESSIBILITY SHELL</strong><small>Screen reader, keyboard, switch, speech and coordinate access to the same world.</small></button>
   <button type="button" class="launcher-card rules" @onclick="OpenObserver"><span class="card-icon" aria-hidden="true">⌕</span><strong>RELIC OBSERVER</strong><small>Query project knowledge and your private imported sources with visible evidence and provenance.</small></button>
   <button type="button" class="launcher-card roleplay" disabled="@(!WorldReady)" @onclick="OpenRoleplay"><span class="card-icon">♙</span><strong>ROLEPLAY</strong><small>@(Session.IsGeonaphWorld?"Open the Shaelvien map, choose a zone, join a party and chat.":"Characters, dice, encounters and play.")</small></button>
   <button type="button" class="launcher-card campaign" disabled="@(!CanOpenWorldBuilder)" @onclick="OpenGameMaster"><span class="card-icon">♜</span><strong>GAMEMASTER</strong><small>@(CanBuildWorld?"Build, manage and run campaigns.":Session.IsGeonaphWorld?"View the Endemar GameMaster layout as a read-only reference.":"Build access required for this world.")</small></button>
   @if(WorldReady)
   {
    <button type="button" class="launcher-card world" @onclick="OpenTickerAsync"><span class="card-icon">⋯</span><strong>TICKER</strong><small>Customize this world's automatic top ticker.</small></button>
   }
   <button type="button" class="launcher-card world" disabled="@(!WorldReady||!Session.IsGeonaphWorld)" @onclick="OpenPerceiver"><span class="card-icon">◎</span><strong>PERCEIVER</strong><small>Play the Endemar three-tier movie proof with reactive parallax and device tilt.</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenImmersionBuilder"><span class="card-icon">◫</span><strong>IMMERSIONBUILDER</strong><small>Build parallax, AR, spatial audio, high-resolution assets and haptics.</small></button>
   <button type="button" class="launcher-card campaign coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">♟</span><strong>CAMPAIGNS</strong><small>Plan and organize campaigns for this world.</small></button>
   <button type="button" class="launcher-card campaign coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">▱</span><strong>TABLETOP</strong><small>Arrange the playable tabletop and campaign space.</small></button>
   <button type="button" class="launcher-card roleplay coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">⌖</span><strong>INSTANCE</strong><small>Enter local and encounter-scale instances.</small></button>
   <button type="button" class="launcher-card world coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">☁</span><strong>WEATHER</strong><small>Build and apply weather systems.</small></button>
   <button type="button" class="launcher-card world coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">△</span><strong>GEOLOGICAL EVENTS</strong><small>Shape geological and world-scale events.</small></button>
   <button type="button" class="launcher-card world coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">☿</span><strong>ASTROLOGY</strong><small>Define celestial influence and world interpretation.</small></button>
   <button type="button" class="launcher-card campaign coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">◷</span><strong>HISTORY</strong><small>Record eras, events and world chronology.</small></button>
   <button type="button" class="launcher-card rules" disabled="@(!WorldReady)" @onclick="OpenLore"><span class="card-icon">✦</span><strong>LORE</strong><small>Organize this world's setting knowledge and canon.</small></button>
   <button type="button" class="launcher-card world coming-soon" disabled aria-disabled="true" title="Coming Soon"><span class="card-icon">★</span><strong>ASTRONOMY</strong><small>Define stars, skies and celestial structure.</small></button>
   <button type="button" class="launcher-card rules" @onclick="OpenRulebooks"><span class="card-icon">▤</span><strong>RULEBOOKS</strong><small>Open systems, rules and reference books.</small></button>
   <button type="button" class="launcher-card assets" @onclick="OpenAssets"><span class="card-icon">✥</span><strong>ASSET DESIGNER</strong><small>Create tiles, tokens, sprites and other assets.</small></button>
   <button type="button" class="launcher-card assets card-index-primary" @onclick="OpenCardIndex"><span class="card-icon">▧</span><strong>CARD INDEX</strong><small>Your cards, library, store and custom card creator.</small></button>
   <button type="button" class="launcher-card roleplay" @onclick="OpenDiceTools"><span class="card-icon">◆</span><strong>DICE &amp; TOOLS</strong><small>Open dice, cards and play tools.</small></button>
  </section>

  <section class="launcher-secondary" aria-label="Quick access">
   <button type="button" @onclick="OpenManage"><span>▣</span>SANDBOX WORLDS</button>
   <button type="button" class="coming-soon" disabled aria-disabled="true" title="Coming Soon"><span>♙</span>CHARACTERS</button>
   <button type="button" @onclick="OpenStore"><span>◇</span>STORE</button>
   <button type="button" @onclick="OpenMembership"><span>◉</span>MEMBERSHIP</button>
    <button type="button" @onclick="OpenAiCommerce"><span>⌬</span>AI COMMERCE</button>
   <button type="button" @onclick="OpenKickstarter"><span>★</span>KICKSTARTER</button>
   <button type="button" @onclick="OpenFeedback"><span>···</span>FEEDBACK</button>
   <button type="button" @onclick="OpenSettings"><span>⚙</span>SETTINGS</button>
   @if(Session.HasPlatformCommercialOverride)
   {
    <button type="button" @onclick="OpenCommerceAdmin"><span>⌁</span>ACCESS ADMIN</button>
   }
   @if(Session.IsLoggedIn)
   {
    <button type="button" @onclick="SwitchUserAsync"><span>⇄</span>SWITCH USER</button>
    <button type="button" @onclick="SignOutAsync"><span>⇥</span>SIGN OUT</button>
   }
  </section>

  @if(_cardIndexOpen)
  {
   <section class="card-index-overlay" role="dialog" aria-modal="true" aria-label="Card Index">
    <header><button type="button" @onclick="CloseCardIndex">← BACK</button><strong>CARD INDEX</strong></header>
    <CardIndexWorkspace />
   </section>
  }

  <WorldGate Open="@_worldGateOpen" RequireSelection="false" OnClose="CloseWorldGate" />
  <RegionGate Open="@_regionGateOpen" OnClose="CloseRegionGate" OnNew="OpenNewRegion" OnSelect="OpenSavedRegion" />
  <CommerceAdminPanel Open="@_commerceAdminOpen" OnClose="CloseCommerceAdmin" />

  <footer class="launcher-footer">
   <span>BUILT WITH ReLiC</span>
   <strong>MORE THAN A GAME. A PLACE TO BELONG.</strong>
   <span class="launcher-status">● ONLINE · PUBLIC ALPHA</span>
  </footer>
 </main>
}
else
{
 <div class="alpha-world-stage @(_workspaceMode=="world"?"worldbuilder-stage":"") @(WorkspaceReferenceOnly?"reference-only":"")">
  @if (_workspaceMode != "world")
  {
   <div class="alpha-world-ribbon" aria-label="Shaelvien workspace">
    <button type="button" @onclick="ReturnToHub" aria-label="Home — return to the Shaelvien landing page">⌂ HOME</button>
    <span>@_workspaceLabel</span>
    <span class="alpha-ribbon-path">@_workspaceHint</span>
   </div>
  }
  @if(WorkspaceReferenceOnly){<div class="workspace-reference-banner" role="status">VIEW ONLY · ENDEMAR REFERENCE</div>}
  <TaskWorkspaceRouter Mode="@_workspaceMode" OnStartMenu="OpenStartMenu" OnHome="ReturnToHub" />
 </div>
}


@if(_settingsOpen)
{
 <section class="launcher-settings-backdrop" role="presentation" @onclick="CloseSettings">
  <div class="launcher-settings" role="dialog" aria-modal="true" aria-label="Start menu" @onclick:stopPropagation="true">
   <header><strong>START MENU</strong><button type="button" @onclick="CloseSettings" aria-label="Resume">×</button></header>
   <button type="button" class="launcher-start-home" @onclick="GoHome"><strong>⌂ HOME</strong><small>Return to the Shaelvien landing page.</small></button>
   @if(WorldReady)
   {
    <button type="button" class="launcher-start-home" @onclick="OpenTickerAsync"><strong>⋯ TICKER</strong><small>Customize @Session.WorldDisplayName's automatic top ticker.</small></button>
   }
   <section class="launcher-settings-group" aria-label="Device settings">
    <h2>DEVICE</h2>
    <button type="button" class="launcher-fullscreen" @onclick="RequestMotionAsync" disabled="@(!_motionSupported || _motionStatus=="granted")">
     <strong>MOTION &amp; TILT</strong>
     <small>@MotionStatusText</small>
    </button>
    <button type="button" class="launcher-fullscreen" @onclick="HardRefreshAsync">
     <strong>HARD REFRESH</strong>
     <small>Clear app caches and service workers, then reload the newest build without deleting your account or world data.</small>
    </button>
   </section>
   <section class="launcher-settings-group" aria-label="Graphics settings">
    <h2>GRAPHICS</h2>
    <button type="button" class="launcher-fullscreen" @onclick="ToggleFullscreenAsync">
     <strong>@(_fullscreen?"EXIT FULL SCREEN":"FULL SCREEN")</strong>
     <small>@(_fullscreen?"Return to browser window":"Use the maximum available display area")</small>
    </button>
    <button type="button" class="launcher-fullscreen" @onclick="ToggleParallaxAsync">
     <strong>PARALLAX @(_parallaxEnabled?"ON":"OFF")</strong>
     <small>@(_parallaxEnabled?"Layered motion depth is enabled.":"Layered motion depth is disabled.")</small>
    </button>
    @if(!_fullscreenSupported){<p class="launcher-settings-note">This browser does not expose programmable full screen. Platform/browser display controls may still provide it.</p>}
   </section>
   <section class="launcher-settings-group" aria-label="Media settings">
    <h2>MEDIA</h2>
    <button type="button" class="launcher-fullscreen" @onclick="ToggleAudioAsync">
     <strong>AUDIO @(_audioEnabled?"ON":"OFF")</strong>
     <small>Enable or mute game audio on this device.</small>
    </button>
    <button type="button" class="launcher-fullscreen" @onclick="ToggleVideoAsync">
     <strong>VIDEO @(_videoEnabled?"ON":"OFF")</strong>
     <small>Enable or suppress game video on this device.</small>
    </button>
   </section>
   <button type="button" class="launcher-accessibility" @onclick="OpenAccessibility">ACCESSIBILITY STATEMENT</button>
  </div>
 </section>
}


@if(_tickerOpen)
{
 <section class="ticker-editor-backdrop" role="presentation" @onclick="CloseTicker">
  <form class="ticker-editor" role="dialog" aria-modal="true" aria-label="Ticker buttons" @onclick:stopPropagation="true" @onsubmit="SaveTickerAsync" @onsubmit:preventDefault="true">
   <header><strong>TICKER</strong><button type="button" @onclick="CloseTicker" aria-label="Close ticker editor">×</button></header>
   <p>One button label per line. The ticker scrolls automatically until touched; touching it opens the Start menu.</p>
   <textarea @bind="_tickerEditor" aria-label="Ticker button labels" rows="10"></textarea>
   <footer><button type="button" @onclick="ResetTicker">DEFAULTS</button><button type="submit">SAVE</button></footer>
  </form>
 </section>
}

<style>
 .launcher-card.coming-soon,.launcher-secondary button.coming-soon{position:relative!important;overflow:hidden!important;opacity:.42!important;filter:grayscale(.75) saturate(.35)!important;cursor:not-allowed!important;box-shadow:none!important}\n .launcher-card.coming-soon::after,.launcher-secondary button.coming-soon::after{content:"COMING SOON";position:absolute;z-index:8;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-7deg);width:max-content;max-width:88%;padding:5px 9px;border:1px solid #d8bd79;border-radius:5px;background:rgba(6,10,13,.92);color:#f0d590;font:900 10px/1 system-ui;letter-spacing:.12em;text-align:center;box-shadow:0 4px 14px #000a;pointer-events:none}\n .launcher-settings-backdrop,.ticker-editor-backdrop{position:fixed;inset:0;z-index:2147482500;display:grid;place-items:center;padding:18px;background:rgba(2,6,10,.78);backdrop-filter:blur(5px)}
 .ticker-editor{box-sizing:border-box;width:min(92vw,560px);display:grid;gap:12px;padding:18px;border:1px solid #806a38;border-radius:14px;background:#081117;color:#e8dec5;box-shadow:0 20px 60px #000c;font-family:system-ui,-apple-system,sans-serif}
 .ticker-editor>header{display:flex;align-items:center;justify-content:space-between}.ticker-editor>header strong{color:#e5c878;letter-spacing:.12em}.ticker-editor>header button{width:40px;height:40px;border:1px solid #52636c;border-radius:8px;background:#101a20;color:#e8dec5;font-size:24px}
 .ticker-editor p{margin:0;color:#a8b3b8;font-size:11px;line-height:1.45}.ticker-editor textarea{box-sizing:border-box;width:100%;min-height:220px;resize:vertical;padding:10px;border:1px solid #4d626d;border-radius:8px;background:#050c10;color:#eee6d3;font:700 13px/1.55 system-ui}.ticker-editor>footer{display:flex;justify-content:flex-end;gap:8px}.ticker-editor>footer button{min-width:100px;min-height:42px;border:1px solid #6e5c31;border-radius:8px;background:#111c22;color:#f1ddb0;font-weight:900}
 .launcher-settings{box-sizing:border-box;width:min(92vw,520px);max-height:88dvh;overflow:auto;padding:18px;border:1px solid #806a38;border-radius:14px;background:#081117;color:#e8dec5;box-shadow:0 20px 60px #000c;font-family:system-ui,-apple-system,sans-serif}
 .launcher-settings>header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #3e4e55;padding-bottom:12px}.launcher-settings>header strong{color:#e5c878;letter-spacing:.12em}.launcher-settings>header button{width:40px;height:40px;border:1px solid #52636c;border-radius:8px;background:#101a20;color:#e8dec5;font-size:24px}
 .launcher-start-home{box-sizing:border-box;width:100%;min-height:54px;margin-top:12px;border:1px solid #8e7440;border-radius:9px;background:#111c22;color:#f1ddb0;display:grid;place-items:center;gap:3px;font-weight:900}.launcher-start-home small{color:#9daeb7;font-size:9px;font-weight:700}
 .launcher-settings-group{padding:16px 0}.launcher-settings-group h2{margin:0 0 10px;color:#8fb8d3;font-size:11px;letter-spacing:.14em}.launcher-fullscreen,.launcher-accessibility,.launcher-device-setup{box-sizing:border-box;width:100%;min-height:54px;border:1px solid #6e5c31;border-radius:9px;background:#111c22;color:#f1ddb0;display:grid;place-items:center;gap:4px;font-weight:900}.launcher-fullscreen+.launcher-fullscreen{margin-top:8px}.launcher-fullscreen small,.launcher-device-setup small{color:#9daeb7;font-size:9px;font-weight:700}.launcher-accessibility{margin-top:8px}.launcher-settings-note{margin:10px 0 0;color:#a8b3b8;font-size:11px;line-height:1.4}.launcher-device-setup{width:min(88vw,360px);margin:0 auto 10px;padding:7px 12px;background:#0e1820;border-color:#8e7440}.launcher-device-setup strong{font-size:11px;letter-spacing:.06em}
 .card-index-overlay{position:fixed;inset:0;z-index:2147482400;display:grid;grid-template-rows:34px minmax(0,1fr);background:#03080c}.card-index-overlay>header{display:flex;align-items:center;gap:12px;padding:0 10px;border-bottom:1px solid #715b2d;background:#081017;color:#e8dec5}.card-index-overlay>header button{height:26px;border:1px solid #53636b;border-radius:6px;background:#0d171e;color:#e4c97d;font-weight:900}.card-index-overlay>header strong{font-size:10px;letter-spacing:.12em;color:#e5c878}
 .launcher-world-loaded{width:max-content;max-width:88vw;margin:0 auto 10px;padding:5px 10px;border:1px solid #6c5b35;border-radius:999px;background:#0b161c;color:#d8c17f;font:900 8px/1 system-ui;letter-spacing:.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .launcher-hub{position:relative;isolation:isolate;overflow-x:hidden}
 .launcher-koi-parallax{position:absolute;z-index:0;left:0;right:0;top:0;height:min(46dvh,430px);overflow:hidden;pointer-events:none}
 .launcher-koi-track{position:absolute;display:block;width:190px;height:72px;opacity:.24;will-change:transform}
 .launcher-koi-track .launcher-koi-body{position:absolute;inset:8px 30px 8px 8px;display:block;border-radius:68% 48% 58% 44%;box-shadow:0 12px 28px #0005}
 .launcher-koi-track .launcher-koi-body::before{content:"";position:absolute;right:-35px;top:10px;width:45px;height:38px;clip-path:polygon(0 50%,100% 0,76% 50%,100% 100%);background:inherit;opacity:.88}
 .launcher-koi-track .launcher-koi-body::after{content:"";position:absolute;left:24%;top:20%;width:30%;height:35%;border-radius:50%;background:radial-gradient(circle at 28% 45%,#fff8 0 10%,transparent 12%),radial-gradient(ellipse,#fff5 0 34%,transparent 36%)}
 .launcher-koi-far{left:-52px;top:84px;transform:translate3d(6px,3px,0) scale(.9) rotate(-3deg)}
 .koi-parallax-on .launcher-koi-far{animation:launcher-koi-far-drift 17s ease-in-out infinite alternate}
 .launcher-koi-far .launcher-koi-body{background:linear-gradient(135deg,#0c3658,#245f81 52%,#09243d)}
 .launcher-koi-near{right:-58px;top:122px;transform:translate3d(-8px,-2px,0) scale(1.08) rotate(-2deg)}
 .koi-parallax-on .launcher-koi-near{animation:launcher-koi-near-drift 11s ease-in-out infinite alternate}
 .launcher-koi-near .launcher-koi-body{transform:rotate(180deg);background:linear-gradient(135deg,#8a5b19,#c58b2e 52%,#4c3010)}
 .launcher-world-selectbar,.launcher-hero,.launcher-primary,.launcher-secondary,.launcher-footer{position:relative;z-index:1}
 .launcher-world-selectbar{box-sizing:border-box;width:min(94vw,680px);margin:8px auto 2px;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:8px;padding:5px 8px;border:1px solid #67562f;border-radius:10px;background:rgba(7,16,22,.72);box-shadow:0 5px 18px #0005}
 .launcher-world-selectbar label{color:#d8bf79;font:900 8px/1 system-ui;letter-spacing:.14em}
 .launcher-world-selectbar select{box-sizing:border-box;width:100%;min-width:0;height:34px;padding:0 30px 0 9px;border:1px solid #53666f;border-radius:7px;background:#0d171e;color:#f0ddb0;font:800 11px/1 system-ui}
 .launcher-mmo-selectbar{margin-top:4px;border-color:#3d6476;background:rgba(5,18,26,.78)}.launcher-mmo-selectbar label{color:#8fc4da}
 @@keyframes launcher-koi-far-drift{from{transform:translate3d(-10px,0,0) scale(.88) rotate(-7deg)}to{transform:translate3d(42px,18px,0) scale(.94) rotate(4deg)}}
 @@keyframes launcher-koi-near-drift{from{transform:translate3d(8px,4px,0) scale(1.04) rotate(3deg)}to{transform:translate3d(-52px,-22px,0) scale(1.14) rotate(-5deg)}}
 @@media(prefers-reduced-motion:reduce){.launcher-koi-track{animation:none!important}}
 @@media(max-width:620px){.launcher-world-selectbar{width:calc(100% - 18px);margin-top:6px}.launcher-koi-parallax{height:330px}.launcher-koi-track{width:150px;height:60px;opacity:.19}.launcher-koi-far{top:70px}.launcher-koi-near{top:112px}}
 .launcher-hub{--rist-parallax-far-x:0px;--rist-parallax-far-y:0px;--rist-parallax-mid-x:0px;--rist-parallax-mid-y:0px;--rist-parallax-near-x:0px;--rist-parallax-near-y:0px}
 .launcher-depth-scene{position:absolute;z-index:0;left:0;right:0;top:38px;height:min(58dvh,560px);overflow:hidden;pointer-events:none;perspective:900px;-webkit-mask-image:linear-gradient(180deg,#000 0 72%,transparent 100%);mask-image:linear-gradient(180deg,#000 0 72%,transparent 100%)}
 .launcher-depth-layer{position:absolute;display:block;pointer-events:none;will-change:transform,opacity}
 .launcher-depth-stars{inset:-8%;opacity:.34;background-image:radial-gradient(circle,#d9efff 0 1px,transparent 1.5px),radial-gradient(circle,#ffe3a2 0 1px,transparent 1.6px),radial-gradient(circle,#8bcfff 0 .8px,transparent 1.35px);background-size:83px 79px,137px 121px,59px 67px;background-position:11px 7px,43px 19px,23px 41px;transform:translate3d(var(--rist-parallax-far-x),var(--rist-parallax-far-y),0) scale(1.05)}
