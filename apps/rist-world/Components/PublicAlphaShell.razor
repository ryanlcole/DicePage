@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject WorldSession Session

@if (!_workspaceOpen)
{
 <main class="launcher-hub" aria-label="Shaelvien launcher">
  <section class="launcher-hero">
   <div class="launcher-crest" aria-hidden="true">✦</div>
   <p class="launcher-kicker">SHAELVIEN · RIST</p>
   <h1>SHAELVIEN</h1>
   <p class="launcher-subtitle">A LIVING WORLD AWAITS</p>
   <p class="launcher-tagline">BUILD THE WORLD.<br />THEN STEP INSIDE IT.</p>
   @if(WorldReady)
   {
    <p class="launcher-world-loaded">WORLD LOADED · @Session.WorldDisplayName</p>
   }
   @if(MotionSetupNeeded)
   {
    <button type="button" class="launcher-device-setup" @onclick="RequestMotionAsync"><strong>ENABLE MOTION &amp; TILT</strong><small>@MotionStatusText</small></button>
   }
   <button type="button" class="launcher-enter" disabled="@(!WorldReady)" @onclick="OpenRoleplay">ENTER SHAELVIEN</button>
  </section>

  <section class="launcher-primary" aria-label="Shaelvien categories">
   <button type="button" class="launcher-card roleplay" disabled="@(!WorldReady)" @onclick="OpenRoleplay"><span class="card-icon">♙</span><strong>ROLEPLAY</strong><small>Characters, dice, encounters and play.</small></button>
   <button type="button" class="launcher-card campaign" disabled="@(!WorldReady)" @onclick="OpenGameMaster"><span class="card-icon">♜</span><strong>GAMEMASTER</strong><small>Build, manage and run campaigns.</small></button>
   <button type="button" class="launcher-card world" @onclick="OpenWorldbuilding"><span class="card-icon">◈</span><strong>WORLDBUILDER</strong><small>@(WorldReady?"Build the world map, tiers and layers.":"Choose, create or import a world first.")</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenImmersionBuilder"><span class="card-icon">◫</span><strong>IMMERSIONBUILDER</strong><small>Build parallax, AR, spatial audio, high-resolution assets and haptics.</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenRegionDefiner"><span class="card-icon">▦</span><strong>REGIONDEFINER</strong><small>Define regions from published world tiles.</small></button>
   <button type="button" class="launcher-card campaign" disabled="@(!WorldReady)" @onclick="OpenCampaign"><span class="card-icon">♟</span><strong>CAMPAIGNS</strong><small>Plan and organize campaigns for this world.</small></button>
   <button type="button" class="launcher-card campaign" disabled="@(!WorldReady)" @onclick="OpenTabletop"><span class="card-icon">▱</span><strong>TABLETOP</strong><small>Arrange the playable tabletop and campaign space.</small></button>
   <button type="button" class="launcher-card roleplay" disabled="@(!WorldReady)" @onclick="OpenInstance"><span class="card-icon">⌖</span><strong>INSTANCE</strong><small>Enter local and encounter-scale instances.</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenWeather"><span class="card-icon">☁</span><strong>WEATHER</strong><small>Build and apply weather systems.</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenGeology"><span class="card-icon">△</span><strong>GEOLOGICAL EVENTS</strong><small>Shape geological and world-scale events.</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenAstrology"><span class="card-icon">☿</span><strong>ASTROLOGY</strong><small>Define celestial influence and world interpretation.</small></button>
   <button type="button" class="launcher-card campaign" disabled="@(!WorldReady)" @onclick="OpenHistory"><span class="card-icon">◷</span><strong>HISTORY</strong><small>Record eras, events and world chronology.</small></button>
   <button type="button" class="launcher-card rules" disabled="@(!WorldReady)" @onclick="OpenLore"><span class="card-icon">✦</span><strong>LORE</strong><small>Organize this world's setting knowledge and canon.</small></button>
   <button type="button" class="launcher-card world" disabled="@(!WorldReady)" @onclick="OpenAstronomy"><span class="card-icon">★</span><strong>ASTRONOMY</strong><small>Define stars, skies and celestial structure.</small></button>
   <button type="button" class="launcher-card rules" @onclick="OpenRulebooks"><span class="card-icon">▤</span><strong>RULEBOOKS</strong><small>Open systems, rules and reference books.</small></button>
   <button type="button" class="launcher-card assets" @onclick="OpenAssets"><span class="card-icon">✥</span><strong>ASSET DESIGNER</strong><small>Create tiles, tokens, sprites and other assets.</small></button>
   <button type="button" class="launcher-card assets card-index-primary" @onclick="OpenCardIndex"><span class="card-icon">▧</span><strong>CARD INDEX</strong><small>Your cards, library, store and custom card creator.</small></button>
   <button type="button" class="launcher-card roleplay" @onclick="OpenDiceTools"><span class="card-icon">◆</span><strong>DICE &amp; TOOLS</strong><small>Open dice, cards and play tools.</small></button>
  </section>

  <section class="launcher-secondary" aria-label="Quick access">
   <button type="button" @onclick="OpenCharacters"><span>♙</span>CHARACTERS</button>
   <button type="button" @onclick="OpenStore"><span>◇</span>STORE</button>
   <button type="button" @onclick="OpenFeedback"><span>···</span>FEEDBACK</button>
   <button type="button" @onclick="OpenSettings"><span>⚙</span>SETTINGS</button>
  </section>

  @if(_settingsOpen)
  {
   <section class="launcher-settings-backdrop" role="presentation" @onclick="CloseSettings">
    <div class="launcher-settings" role="dialog" aria-modal="true" aria-label="Start menu settings" @onclick:stopPropagation="true">
     <header><strong>SETTINGS</strong><button type="button" @onclick="CloseSettings" aria-label="Close settings">×</button></header>
     <section class="launcher-settings-group" aria-label="Device settings">
      <h2>DEVICE</h2>
      <button type="button" class="launcher-fullscreen" @onclick="RequestMotionAsync" disabled="@(!_motionSupported || _motionStatus=="granted")">
       <strong>MOTION &amp; TILT</strong>
       <small>@MotionStatusText</small>
      </button>
     </section>
     <section class="launcher-settings-group" aria-label="Graphics settings">
      <h2>GRAPHICS</h2>
      <button type="button" class="launcher-fullscreen" @onclick="ToggleFullscreenAsync">
       <strong>@(_fullscreen?"EXIT FULL SCREEN":"FULL SCREEN")</strong>
       <small>@(_fullscreen?"Return to browser window":"Use the maximum available display area")</small>
      </button>
      @if(!_fullscreenSupported){<p class="launcher-settings-note">This browser does not expose programmable full screen. Platform/browser display controls may still provide it.</p>}
      <button type="button" class="launcher-fullscreen" @onclick="ToggleParallaxAsync" disabled="@(!_parallaxSupported)">
       <strong>PARALLAX @(_parallaxEnabled?"ON":"OFF")</strong>
       <small>@ParallaxStatusText</small>
      </button>
     </section>
     <button type="button" class="launcher-accessibility" @onclick="OpenAccessibility">ACCESSIBILITY SETTINGS</button>
    </div>
   </section>
  }

  @if(_cardIndexOpen)
  {
   <section class="card-index-overlay" role="dialog" aria-modal="true" aria-label="Card Index">
    <header><button type="button" @onclick="CloseCardIndex">← BACK</button><strong>CARD INDEX</strong></header>
    <CardIndexWorkspace />
   </section>
  }

  <WorldGate Open="@_worldGateOpen" OnClose="CloseWorldGate" OnContinue="ContinueWorldbuildingFromGate" />

  <footer class="launcher-footer">
   <span>BUILT WITH ReLiC</span>
   <strong>MORE THAN A GAME. A PLACE TO BELONG.</strong>
   <span class="launcher-status">● ONLINE · PUBLIC ALPHA</span>
  </footer>
 </main>
}
else
{
 <div class="alpha-world-stage @(_workspaceMode=="world"?"worldbuilder-stage":"")">
  @if (_workspaceMode != "world")
  {
   <div class="alpha-world-ribbon" aria-label="Shaelvien workspace">
    <button type="button" @onclick="ReturnToHub" aria-label="Back to Shaelvien hub">← BACK</button>
    <span>@_workspaceLabel</span>
    <span class="alpha-ribbon-path">@_workspaceHint</span>
   </div>
  }
  <TaskWorkspaceRouter Mode="@_workspaceMode" OnStartMenu="ReturnToHub" />
 </div>
}

<style>
 .launcher-settings-backdrop{position:fixed;inset:0;z-index:2147482500;display:grid;place-items:center;padding:18px;background:rgba(2,6,10,.78);backdrop-filter:blur(5px)}
 .launcher-settings{box-sizing:border-box;width:min(92vw,520px);max-height:88dvh;overflow:auto;padding:18px;border:1px solid #806a38;border-radius:14px;background:#081117;color:#e8dec5;box-shadow:0 20px 60px #000c;font-family:system-ui,-apple-system,sans-serif}
 .launcher-settings>header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #3e4e55;padding-bottom:12px}.launcher-settings>header strong{color:#e5c878;letter-spacing:.12em}.launcher-settings>header button{width:40px;height:40px;border:1px solid #52636c;border-radius:8px;background:#101a20;color:#e8dec5;font-size:24px}
 .launcher-settings-group{padding:16px 0}.launcher-settings-group h2{margin:0 0 10px;color:#8fb8d3;font-size:11px;letter-spacing:.14em}.launcher-fullscreen,.launcher-accessibility,.launcher-device-setup{box-sizing:border-box;width:100%;min-height:54px;border:1px solid #6e5c31;border-radius:9px;background:#111c22;color:#f1ddb0;display:grid;place-items:center;gap:4px;font-weight:900}.launcher-fullscreen+.launcher-fullscreen{margin-top:8px}.launcher-fullscreen small,.launcher-device-setup small{color:#9daeb7;font-size:9px;font-weight:700}.launcher-accessibility{margin-top:8px}.launcher-settings-note{margin:10px 0 0;color:#a8b3b8;font-size:11px;line-height:1.4}.launcher-device-setup{width:min(88vw,360px);margin:0 auto 10px;padding:7px 12px;background:#0e1820;border-color:#8e7440}.launcher-device-setup strong{font-size:11px;letter-spacing:.06em}
 .card-index-overlay{position:fixed;inset:0;z-index:2147482400;display:grid;grid-template-rows:34px minmax(0,1fr);background:#03080c}.card-index-overlay>header{display:flex;align-items:center;gap:12px;padding:0 10px;border-bottom:1px solid #715b2d;background:#081017;color:#e8dec5}.card-index-overlay>header button{height:26px;border:1px solid #53636b;border-radius:6px;background:#0d171e;color:#e4c97d;font-weight:900}.card-index-overlay>header strong{font-size:10px;letter-spacing:.12em;color:#e5c878}
 .launcher-world-loaded{width:max-content;max-width:88vw;margin:0 auto 10px;padding:5px 10px;border:1px solid #6c5b35;border-radius:999px;background:#0b161c;color:#d8c17f;font:900 8px/1 system-ui;letter-spacing:.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .launcher-card:disabled,.launcher-secondary button:disabled,.launcher-enter:disabled{opacity:.34!important;filter:grayscale(.8);cursor:not-allowed}.launcher-card:disabled:hover,.launcher-secondary button:disabled:hover{transform:none!important}
 .launcher-hub .rist-card-index-launcher{display:none!important}
</style>

@code {
 const string WorkspaceStorageKey="rist.shell.workspace.v1";
 bool _workspaceOpen;
 bool _workspaceRestored;
 bool _settingsOpen;
 bool _cardIndexOpen;
 bool _worldGateOpen;
 bool _fullscreen;
 bool _fullscreenSupported=true;
 bool _motionSupported=true;
 bool _parallaxEnabled=true;
 bool _parallaxSupported=true;
 string _motionStatus="unknown";
 string _workspaceMode = "world";
 string _workspaceLabel = "WORLDBUILDER";
 string _workspaceHint = "WORLD → TIER → LAYER → CUBE";

 bool WorldReady=>Session.HasActiveWorld;
 bool MotionSetupNeeded => _motionSupported && _motionStatus != "granted";
 string MotionStatusText => _motionStatus switch
 {
  "granted" => "Enabled for this browser session",
  "denied" => "Permission denied — tap to try again",
  "unsupported" => "Not available on this device",
  _ => "Enable device movement for layered world depth"
 };
 string ParallaxStatusText => _parallaxSupported
  ? (_parallaxEnabled?"Device parallax is enabled":"Device parallax is disabled")
  : "Parallax controls are not available in this browser";

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_workspaceRestored)return;
  _workspaceRestored=true;
  await RefreshMotionStateAsync();
  await RefreshParallaxStateAsync();
  await PersistWorkspaceAsync("hub");
 }

 void ApplyWorkspace(string mode)
 {
  switch(mode)
  {
   case "viewer":_workspaceMode="viewer";_workspaceLabel="REGIONDEFINER";_workspaceHint="WORLD → REGION → LOCAL";break;
   case "immersion":_workspaceMode="immersion";_workspaceLabel="IMMERSIONBUILDER";_workspaceHint="WORLD → IMMERSION PROFILE → EXPERIENCE";break;
   case "campaign":_workspaceMode="campaign";_workspaceLabel="GAMEMASTER";_workspaceHint="PLAN → PLACE → RUN → REPLAY";break;
   case "assets":_workspaceMode="assets";_workspaceLabel="ASSET DESIGNER";_workspaceHint="BROWSE → CREATE → PLACE → SAVE";break;
   case "roleplay":_workspaceMode="roleplay";_workspaceLabel="ROLEPLAY";_workspaceHint="CHARACTER → DICE → ENCOUNTER → REPLAY";break;
   case "manage":_workspaceMode="manage";_workspaceLabel="MY WORLDS";_workspaceHint="SAVE → SYNC → SHARE → EXPORT";break;
   case "feedback":_workspaceMode="feedback";_workspaceLabel="FEEDBACK";_workspaceHint="REPORT → CONTEXT → SEND";break;
   default:_workspaceMode="world";_workspaceLabel="WORLDBUILDER";_workspaceHint="WORLD → TIER → LAYER → CUBE";break;
  }
 }

 void OpenWorkspace(string mode,string label,string hint)
 {
  _workspaceMode=mode;
  _workspaceLabel=label;
  _workspaceHint=hint;
  _workspaceOpen=true;
  _settingsOpen=false;
  _cardIndexOpen=false;
  _worldGateOpen=false;
  _=PersistWorkspaceAsync(mode);
 }

 async Task PersistWorkspaceAsync(string mode)
 {
  try{await JS.InvokeVoidAsync("localStorage.setItem",WorkspaceStorageKey,mode);}catch{}
 }

 async Task RefreshMotionStateAsync()
 {
  try
  {
   _motionStatus=await JS.InvokeAsync<string>("ristMotionPermission.state");
   _motionSupported=_motionStatus!="unsupported";
  }
  catch
  {
   _motionStatus="unsupported";
   _motionSupported=false;
  }
  await InvokeAsync(StateHasChanged);
 }

 async Task RequestMotionAsync()
 {
  try
  {
   _motionStatus=await JS.InvokeAsync<string>("ristMotionPermission.request");
   _motionSupported=_motionStatus!="unsupported";
  }
  catch
  {
   _motionStatus="unsupported";
   _motionSupported=false;
  }
  await InvokeAsync(StateHasChanged);
 }

 async Task RefreshParallaxStateAsync()
 {
  try
  {
   _parallaxEnabled=await JS.InvokeAsync<bool>("ristParallax.isEnabled");
   _parallaxSupported=true;
  }
  catch
  {
   _parallaxSupported=false;
  }
  await InvokeAsync(StateHasChanged);
 }

 async Task ToggleParallaxAsync()
 {
  if(!_parallaxSupported)return;
  try
  {
   _parallaxEnabled=await JS.InvokeAsync<bool>("ristParallax.setEnabled",!_parallaxEnabled);
  }
  catch
  {
   _parallaxSupported=false;
  }
  await InvokeAsync(StateHasChanged);
 }

 void OpenSettings(){_cardIndexOpen=false;_worldGateOpen=false;_settingsOpen=true;_=RefreshFullscreenStateAsync();_=RefreshMotionStateAsync();_=RefreshParallaxStateAsync();}
 void CloseSettings()=>_settingsOpen=false;
 void OpenCardIndex(){_settingsOpen=false;_worldGateOpen=false;_cardIndexOpen=true;}
 void CloseCardIndex()=>_cardIndexOpen=false;
 async Task RefreshFullscreenStateAsync(){try{var state=await JS.InvokeAsync<bool[]>("ristFullscreen.state");_fullscreen=state.Length>0&&state[0];_fullscreenSupported=state.Length<2||state[1];await InvokeAsync(StateHasChanged);}catch{_fullscreenSupported=false;await InvokeAsync(StateHasChanged);}}
 async Task ToggleFullscreenAsync(){try{var state=await JS.InvokeAsync<bool[]>("ristFullscreen.toggle");_fullscreen=state.Length>0&&state[0];_fullscreenSupported=state.Length<2||state[1];}catch{_fullscreenSupported=false;}await InvokeAsync(StateHasChanged);}
 void OpenWorldbuilding(){if(!WorldReady){_settingsOpen=false;_cardIndexOpen=false;_worldGateOpen=true;return;}OpenWorkspace("world","WORLDBUILDER","WORLD → TIER → LAYER → CUBE");}
 void ContinueWorldbuildingFromGate()=>OpenWorkspace("world","WORLDBUILDER","WORLD → TIER → LAYER → CUBE");
 void CloseWorldGate()=>_worldGateOpen=false;
 void OpenImmersionBuilder()=>OpenWorkspace("immersion","IMMERSIONBUILDER","WORLD → IMMERSION PROFILE → EXPERIENCE");
 void OpenRegionDefiner()=>OpenWorkspace("viewer","REGIONDEFINER","WORLD TILE → REGION → LOCAL");
 void OpenTabletop()=>OpenWorkspace("campaign","TABLETOP","LOCAL → TABLETOP → PIECES");
 void OpenInstance()=>OpenWorkspace("roleplay","INSTANCE","LOCAL → INSTANCE → ENCOUNTER");
 void OpenWeather()=>OpenWorkspace("world","WEATHER","SKY → WEATHER → WORLD");
 void OpenGeology()=>OpenWorkspace("world","GEOLOGICAL EVENTS","TERRAIN → EVENT → HISTORY");
 void OpenHistory()=>OpenWorkspace("campaign","HISTORY","ERA → EVENT → CHRONOLOGY");
 void OpenLore()=>Navigation.NavigateTo("/relicquery/",forceLoad:true);
 void OpenAstrology()=>OpenWorkspace("world","ASTROLOGY","CELESTIAL → INFLUENCE → WORLD");
 void OpenAstronomy()=>OpenWorkspace("world","ASTRONOMY","STARS → SKY → CELESTIAL STRUCTURE");
 void OpenGameMaster()=>OpenWorkspace("campaign","GAMEMASTER","BUILD → MANAGE → RUN → REPLAY");
 void OpenViewer()=>OpenWorkspace("viewer","REGIONDEFINER","WORLD → REGION → LOCAL");
 void OpenCampaign()=>OpenWorkspace("campaign","CAMPAIGNS","WORLD → CAMPAIGN → SESSION → REPLAY");
 void OpenAssets()=>OpenWorkspace("assets","ASSET DESIGNER","BROWSE → CREATE → PLACE → SAVE");
 void OpenRoleplay()=>OpenWorkspace("roleplay","ROLEPLAY","CHARACTER → DICE → ENCOUNTER → REPLAY");
 void OpenCharacters()=>OpenWorkspace("roleplay","CHARACTERS","CHARACTER → SHEET → EQUIPMENT");
 void OpenDiceTools()=>OpenWorkspace("roleplay","DICE & TOOLS","DICE → CARDS → TOOLS");
 void OpenManage(){_settingsOpen=false;_cardIndexOpen=false;_worldGateOpen=true;}
 void OpenFeedback()=>OpenWorkspace("feedback","FEEDBACK","REPORT → CONTEXT → SEND");
 void OpenStore()=>Navigation.NavigateTo("/store/",forceLoad:true);
 void OpenRulebooks()=>Navigation.NavigateTo("/relicquery/",forceLoad:true);
 void OpenAccessibility()=>Navigation.NavigateTo("accessibility.html",forceLoad:true);
 void ReturnToHub(){_workspaceOpen=false;_settingsOpen=false;_cardIndexOpen=false;_worldGateOpen=false;_=PersistWorkspaceAsync("hub");}
}
