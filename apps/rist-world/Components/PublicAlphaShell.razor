@inject NavigationManager Navigation

@if (!_workspaceOpen)
{
 <main class="launcher-hub" aria-label="Shaelvien launcher">
  <section class="launcher-hero">
   <div class="launcher-crest" aria-hidden="true">✦</div>
   <p class="launcher-kicker">SHAELVIEN · RIST</p>
   <h1>SHAELVIEN</h1>
   <p class="launcher-subtitle">A LIVING WORLD AWAITS</p>
   <p class="launcher-tagline">BUILD THE WORLD.<br />THEN STEP INSIDE IT.</p>
   <button type="button" class="launcher-enter" @onclick="OpenRoleplay">ENTER SHAELVIEN</button>
  </section>

  <nav class="launcher-journey" aria-label="Shaelvien core tasks">
   <button type="button" class="journey-card" @onclick="OpenWorldbuilding"><span>1</span><strong>BUILD YOUR WORLD</strong><small>Paint · place · shape</small></button>
   <button type="button" class="journey-card" @onclick="OpenViewer"><span>2</span><strong>ZOOM BETWEEN SCALES</strong><small>World → region → local</small></button>
   <button type="button" class="journey-card" @onclick="OpenRoleplay"><span>3</span><strong>PLAY YOUR STORY</strong><small>Characters · dice · encounters</small></button>
   <button type="button" class="journey-card" @onclick="OpenManage"><span>4</span><strong>SAVE · SHARE · RETURN</strong><small>Persist · share · export</small></button>
   <button type="button" class="journey-card" @onclick="OpenFeedback"><span>5</span><strong>FEEDBACK</strong><small>Help shape what comes next</small></button>
  </nav>

  <section class="launcher-primary" aria-label="Primary activities">
   <button type="button" class="launcher-card world" @onclick="OpenWorldbuilding"><span class="card-icon">◈</span><strong>WORLD BUILDING</strong><small>Create lands. Shape cultures.<br />Bring your world to life.</small></button>
   <button type="button" class="launcher-card campaign" @onclick="OpenCampaign"><span class="card-icon">⌖</span><strong>CAMPAIGN EDITING</strong><small>Design arcs. Manage sessions.<br />Guide the story.</small></button>
   <button type="button" class="launcher-card assets" @onclick="OpenAssets"><span class="card-icon">✥</span><strong>ASSET CREATION</strong><small>Build tiles, tokens, characters<br />and custom content.</small></button>
   <button type="button" class="launcher-card store" @onclick="OpenStore"><span class="card-icon">◇</span><strong>STORE</strong><small>Browse the invite-only<br />Shaelvien storefront.</small></button>
   <button type="button" class="launcher-card rules" @onclick="OpenRulebooks"><span class="card-icon">▤</span><strong>RULEBOOKS</strong><small>Systems, settings and lore.<br />Everything you need to play.</small></button>
   <button type="button" class="launcher-card roleplay" @onclick="OpenRoleplay"><span class="card-icon">♜</span><strong>ROLEPLAY</strong><small>Step into the world.<br />Play with friends.</small></button>
  </section>

  <section class="launcher-secondary" aria-label="Quick access">
   <button type="button" @onclick="OpenManage"><span>◎</span>MY WORLDS</button>
   <button type="button" @onclick="OpenRoleplay"><span>♙</span>CHARACTERS</button>
   <button type="button" @onclick="OpenViewer"><span>▱</span>MAP VIEWER</button>
   <button type="button" @onclick="OpenRoleplay"><span>◆</span>DICE &amp; TOOLS</button>
   <button type="button" @onclick="OpenCampaign"><span>♟</span>CAMPAIGNS</button>
   <button type="button" @onclick="OpenFeedback"><span>···</span>FEEDBACK</button>
   <button type="button" @onclick="OpenAccessibility"><span>⚙</span>SETTINGS</button>
  </section>

  <footer class="launcher-footer">
   <span>BUILT WITH ReLiC</span>
   <strong>MORE THAN A GAME. A PLACE TO BELONG.</strong>
   <span class="launcher-status">● ONLINE · PUBLIC ALPHA</span>
  </footer>
 </main>
}
else
{
 <div class="alpha-world-stage">
  <div class="alpha-world-ribbon" aria-label="Shaelvien workspace">
   <button type="button" @onclick="ReturnToHub" aria-label="Back to Shaelvien hub">← BACK</button>
   <span>@_workspaceLabel</span>
   <span class="alpha-ribbon-path">@_workspaceHint</span>
  </div>
  <TaskWorkspaceRouter Mode="@_workspaceMode" />
 </div>
}

@code {
 bool _workspaceOpen;
 string _workspaceMode = "world";
 string _workspaceLabel = "WORLD BUILDING";
 string _workspaceHint = "BUILD → ZOOM → PLACE → SAVE";

 void OpenWorkspace(string mode,string label,string hint)
 {
  _workspaceMode=mode;
  _workspaceLabel=label;
  _workspaceHint=hint;
  _workspaceOpen=true;
 }

 void OpenWorldbuilding()=>OpenWorkspace("world","WORLD BUILDING","BUILD → ZOOM → PLACE → SAVE");
 void OpenViewer()=>OpenWorkspace("viewer","MAP VIEWER","WORLD → REGION → LOCAL → SITE → ROOM → TACTICAL");
 void OpenCampaign()=>OpenWorkspace("campaign","CAMPAIGN EDITING","PLAN → PLACE → RUN → REPLAY");
 void OpenAssets()=>OpenWorkspace("assets","ASSET CREATION","BROWSE → CREATE → PLACE → SAVE");
 void OpenRoleplay()=>OpenWorkspace("roleplay","ROLEPLAY","CHARACTER → DICE → ENCOUNTER → REPLAY");
 void OpenManage()=>OpenWorkspace("manage","SAVE · SHARE · RETURN","SAVE → SYNC → SHARE → EXPORT");
 void OpenFeedback()=>OpenWorkspace("feedback","FEEDBACK","REPORT → CONTEXT → SEND");
 void OpenStore()=>Navigation.NavigateTo("/store/",forceLoad:true);
 void OpenRulebooks()=>Navigation.NavigateTo("/relicquery/",forceLoad:true);
 void OpenAccessibility()=>Navigation.NavigateTo("accessibility.html",forceLoad:true);
 void ReturnToHub()=>_workspaceOpen=false;
}
