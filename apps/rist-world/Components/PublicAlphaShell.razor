@code {
 const string WorkspaceStorageKey="rist.shell.workspace.v1";
 static readonly HashSet<string> RestorableWorkspaces=new(StringComparer.Ordinal){"world","accessibility","observer","viewer","perceiver","immersion","campaign","assets","roleplay","tools","manage","feedback"};
 bool _workspaceOpen;
 bool _workspaceRestored;
 bool _settingsOpen;
 bool _commerceAdminOpen;
 bool _tickerOpen;
 bool _cardIndexOpen;
 readonly List<AccountWorldReference> _sandboxWorlds=[];
 bool _worldDirectoryLoaded;
 bool _worldSelectionBusy;
 string _tickerEditor="";
 bool _worldGateOpen;
 bool _regionGateOpen;
 bool _fullscreen;
 bool _fullscreenSupported=true;
 bool _motionSupported=true;
 bool _parallaxEnabled=true;
 bool _audioEnabled=true;
 bool _videoEnabled=true;
 string _motionStatus="unknown";
 string _workspaceMode = "world";
 string _workspaceLabel = "WORLDBUILDER";
 string _workspaceHint = "WORLD → TIER → LAYER → CUBE";

 bool WorldReady=>Session.HasActiveWorld;
 bool CanBuildWorld=>WorldReady&&Session.HasTrustedWorldBuilderAuthority;
 bool CanOpenWorldBuilder=>CanBuildWorld||(WorldReady&&Session.IsGeonaphWorld);
 bool WorkspaceReferenceOnly=>_workspaceOpen&&!CanBuildWorld&&Session.IsGeonaphWorld&&_workspaceMode=="campaign";
 string LandingSandboxWorldValue=>!Session.IsGeonaphWorld&&WorldReady&&_sandboxWorlds.Any(world=>string.Equals(world.WorldId,Session.WorldId,StringComparison.Ordinal))
  ?Session.WorldId
  :"";
 IReadOnlyList<AwsAuthorityClient.MmoParcel> AccessibleMmoWorlds=>Session.MmoParcels
  .Where(Session.CanAccessMmoParcel)
  .OrderBy(parcel=>parcel.DisplayName,StringComparer.OrdinalIgnoreCase)
  .ToList();
 string LandingMmoWorldValue=>Session.IsGeonaphWorld?Session.ActiveRegion?.ParcelId??"":"";
 string LandingLoadedLabel=>Session.IsGeonaphWorld
  ?Session.ActiveRegion is { ParcelId.Length:>0 } region
   ?$"SHAELVIEN · MMO WORLD · {region.Name}"
   :"SHAELVIEN · ENDEMAR"
  :$"SANDBOX · {Session.WorldDisplayName}";
 string TickerStorageKey=>WorldReady?$"rist.worldbuilder.ticker.buttons.v1.{Session.WorldId}":"";
 string DefaultTickerText=>WorldReady?$"{Session.WorldDisplayName.Trim().ToUpperInvariant()}\nBUILD\nUPLOAD\nWEATHER\nMETADATA":"";
 string MotionStatusText => _motionStatus switch
 {
  "granted" => "Enabled for this browser session",
  "denied" => "Permission denied — tap to try again",
  "unsupported" => "Not available on this device",
  _ => "Enable device movement for layered world depth"
 };
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender||_workspaceRestored)return;
  _workspaceRestored=true;
  _workspaceOpen=false;
  _worldGateOpen=false;
  await PersistWorkspaceAsync("hub");
  await RefreshMotionStateAsync();
  await RefreshExperienceStateAsync();
  await RefreshLandingWorldsAsync();
  await InvokeAsync(StateHasChanged);
 }

 void ApplyWorkspace(string mode)
 {
  switch(mode)
  {
   case "accessibility":_workspaceMode="accessibility";_workspaceLabel="ACCESSIBILITY SHELL";_workspaceHint="DESCRIBE → NAVIGATE → ACT → BUILD";break;
   case "observer":_workspaceMode="observer";_workspaceLabel="RELIC OBSERVER";_workspaceHint="QUERY → EVIDENCE → PROVENANCE → OBSERVE";break;
   case "viewer":_workspaceMode="viewer";_workspaceLabel="REGIONDEFINER";_workspaceHint="WORLD → REGION → LOCAL";break;
   case "perceiver":_workspaceMode="perceiver";_workspaceLabel="PERCEIVER";_workspaceHint="TIERED MOVIE → PARALLAX → TILT";break;
   case "immersion":_workspaceMode="immersion";_workspaceLabel="IMMERSIONBUILDER";_workspaceHint="WORLD → IMMERSION PROFILE → EXPERIENCE";break;
   case "campaign":_workspaceMode="campaign";_workspaceLabel="GAMEMASTER";_workspaceHint="PLAN → PLACE → RUN → REPLAY";break;
   case "assets":_workspaceMode="assets";_workspaceLabel="ASSET DESIGNER";_workspaceHint="BROWSE → CREATE → PLACE → SAVE";break;
   case "roleplay":_workspaceMode="roleplay";_workspaceLabel="ROLEPLAY";_workspaceHint="CHARACTER → DICE → ENCOUNTER → REPLAY";break;
   case "tools":_workspaceMode="tools";_workspaceLabel="DICE & TOOLS";_workspaceHint="DICE → CARDS → TOOLS";break;
   case "manage":_workspaceMode="manage";_workspaceLabel="MY WORLDS";_workspaceHint="SAVE → SYNC → SHARE → EXPORT";break;
   case "feedback":_workspaceMode="feedback";_workspaceLabel="FEEDBACK";_workspaceHint="REPORT → CONTEXT → SEND";break;
   default:_workspaceMode="world";_workspaceLabel="WORLDBUILDER";_workspaceHint="WORLD → TIER → LAYER → CUBE";break;
  }
 }

 void OpenWorkspace(string mode,string label,string hint)
 {
  _workspaceMode=mode;
  _workspaceLabel=label;
  _workspaceHint=hint;
  _workspaceOpen=true;
  _settingsOpen=false;
  _tickerOpen=false;
  _cardIndexOpen=false;
  _worldGateOpen=false;
  _regionGateOpen=false;
  _=PersistWorkspaceAsync(mode);
 }

 async Task PersistWorkspaceAsync(string mode)
 {
  try{await JS.InvokeVoidAsync("localStorage.setItem",WorkspaceStorageKey,mode);}catch{}
 }

 async Task RefreshMotionStateAsync()
 {
  try
  {
   _motionStatus=await JS.InvokeAsync<string>("ristMotionPermission.state");
   _motionSupported=_motionStatus!="unsupported";
  }
  catch
  {
   _motionStatus="unsupported";
   _motionSupported=false;
  }
  await InvokeAsync(StateHasChanged);
 }

 async Task RequestMotionAsync()
 {
  try
  {
   _motionStatus=await JS.InvokeAsync<string>("ristMotionPermission.request");
   _motionSupported=_motionStatus!="unsupported";
  }
  catch
  {
   _motionStatus="unsupported";
   _motionSupported=false;
  }
  await InvokeAsync(StateHasChanged);
 }

 async Task RefreshExperienceStateAsync()
 {
  try{_parallaxEnabled=await JS.InvokeAsync<bool>("ristParallax.isEnabled");}catch{}
  try{_audioEnabled=await JS.InvokeAsync<bool>("ristMediaSettings.isAudioEnabled");}catch{}
  try{_videoEnabled=await JS.InvokeAsync<bool>("ristMediaSettings.isVideoEnabled");}catch{}
  await InvokeAsync(StateHasChanged);
 }

 async Task ToggleParallaxAsync()
 {
  try
  {
   _parallaxEnabled=await JS.InvokeAsync<bool>("ristParallax.setEnabled",!_parallaxEnabled);
   await JS.InvokeAsync<bool>("ristParallax.setActive",_parallaxEnabled);
   if(_parallaxEnabled)
   {
    try{_motionStatus=await JS.InvokeAsync<string>("ristMotionPermission.request");_motionSupported=_motionStatus!="unsupported";}catch{}
   }
  }
  catch{}
  await InvokeAsync(StateHasChanged);
 }

 async Task ToggleAudioAsync()
 {
  try{_audioEnabled=await JS.InvokeAsync<bool>("ristMediaSettings.setAudioEnabled",!_audioEnabled);}catch{}
  await InvokeAsync(StateHasChanged);
 }

 async Task ToggleVideoAsync()
 {
  try{_videoEnabled=await JS.InvokeAsync<bool>("ristMediaSettings.setVideoEnabled",!_videoEnabled);}catch{}
  await InvokeAsync(StateHasChanged);
 }

 async Task HardRefreshAsync()
 {
  try{await JS.InvokeVoidAsync("ristLaunch.hardRefresh");}catch{Navigation.NavigateTo(Navigation.Uri,forceLoad:true);}
 }

 async Task RefreshLandingWorldsAsync()
 {
  _worldSelectionBusy=true;
  try
  {
   var directory=await Session.LoadWorldDirectoryAsync();
   _sandboxWorlds.Clear();
   _sandboxWorlds.AddRange(directory.Worlds
    .Where(WorldSession.IsSandboxWorldReference)
    .OrderBy(world=>world.DisplayName,StringComparer.OrdinalIgnoreCase));

   if(Session.IsGeonaphWorld)
   {
    await Session.RefreshMmoLandAsync();
    await Session.LoadRegionsAsync();
   }
   _worldDirectoryLoaded=true;
  }
  catch{}
  finally{_worldSelectionBusy=false;}
  await InvokeAsync(StateHasChanged);
 }

 async Task SelectLandingSandboxWorldAsync(ChangeEventArgs e)
 {
  if(Session.IsGeonaphWorld)return;
  var worldId=e.Value?.ToString()??"";
  if(string.IsNullOrWhiteSpace(worldId)||string.Equals(worldId,Session.WorldId,StringComparison.Ordinal))return;
  var world=_sandboxWorlds.FirstOrDefault(x=>string.Equals(x.WorldId,worldId,StringComparison.Ordinal));
  if(world is null)return;

  _worldSelectionBusy=true;
  try
  {
   Session.SetActiveRegion("");
   await Session.LoadWorldAsync(world);
   await Session.RefreshTrustedWorldAuthorityAsync();
   await RefreshLandingWorldsAsync();
  }
  finally{_worldSelectionBusy=false;}
  await InvokeAsync(StateHasChanged);
 }

 async Task SelectLandingMmoWorldAsync(ChangeEventArgs e)
 {
  if(!Session.IsGeonaphWorld)return;
  var parcelId=e.Value?.ToString()??"";
  _worldSelectionBusy=true;
  try
  {
   await Session.RefreshMmoLandAsync();
   await Session.LoadRegionsAsync();

   if(string.IsNullOrWhiteSpace(parcelId))
   {
    Session.SetActiveRegion("");
   }
   else
   {
    var parcel=AccessibleMmoWorlds.FirstOrDefault(x=>string.Equals(x.ParcelId,parcelId,StringComparison.Ordinal));
    if(parcel is not null)
     Session.SetActiveRegion(parcel.RegionId);
   }
  }
  finally{_worldSelectionBusy=false;}
  await InvokeAsync(StateHasChanged);
 }

 async Task OpenTickerAsync()
 {
  if(!WorldReady)return;
  _settingsOpen=false;_cardIndexOpen=false;_worldGateOpen=false;
  _tickerEditor=DefaultTickerText;
  try
  {
   var raw=await JS.InvokeAsync<string?>("localStorage.getItem",TickerStorageKey);
   if(!string.IsNullOrWhiteSpace(raw))
   {
    var saved=System.Text.Json.JsonSerializer.Deserialize<List<string>>(raw);
    if(saved is {Count:>0})_tickerEditor=string.Join("\n",saved);
   }
  }
  catch{}
  _tickerOpen=true;await InvokeAsync(StateHasChanged);
 }
 void CloseTicker()=>_tickerOpen=false;
 void ResetTicker()=>_tickerEditor=DefaultTickerText;
 async Task SaveTickerAsync()
 {
  var values=_tickerEditor.Split(new[]{'\r','\n'},StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Trim()).Where(x=>x.Length>0).Take(12).ToList();
  if(!WorldReady){_tickerOpen=false;return;}
  if(values.Count==0)values=DefaultTickerText.Split('\n',StringSplitOptions.RemoveEmptyEntries).ToList();
  _tickerEditor=string.Join("\n",values);
  try{await JS.InvokeVoidAsync("localStorage.setItem",TickerStorageKey,System.Text.Json.JsonSerializer.Serialize(values));}catch{}
  _tickerOpen=false;
  Navigation.NavigateTo(Navigation.Uri,forceLoad:true);
 }
 public void OpenStartMenu(){_tickerOpen=false;_cardIndexOpen=false;_worldGateOpen=false;_commerceAdminOpen=false;_settingsOpen=true;_=RefreshFullscreenStateAsync();_=RefreshMotionStateAsync();_=RefreshExperienceStateAsync();}
 void OpenSettings()=>OpenStartMenu();
 void OpenCommerceAdmin(){if(!Session.HasPlatformCommercialOverride)return;_settingsOpen=false;_tickerOpen=false;_cardIndexOpen=false;_worldGateOpen=false;_regionGateOpen=false;_commerceAdminOpen=true;}
 void CloseCommerceAdmin()=>_commerceAdminOpen=false;
 async Task SwitchUserAsync()
 {
  _settingsOpen=false;_tickerOpen=false;_cardIndexOpen=false;_worldGateOpen=false;_regionGateOpen=false;_commerceAdminOpen=false;
  await Auth.LogoutAsync();
  Session.AdoptAuthentication(null);
  Navigation.NavigateTo("/Play/index.html",forceLoad:true);
 }
 async Task SignOutAsync()
 {
  _settingsOpen=false;_tickerOpen=false;_cardIndexOpen=false;_worldGateOpen=false;_regionGateOpen=false;_commerceAdminOpen=false;
  await Auth.LogoutAsync();
  Session.AdoptAuthentication(null);
  Navigation.NavigateTo("/",forceLoad:true);
 }
 void CloseSettings()=>_settingsOpen=false;
 void OpenCardIndex(){_settingsOpen=false;_tickerOpen=false;_worldGateOpen=false;_cardIndexOpen=true;}
 void CloseCardIndex()=>_cardIndexOpen=false;
 async Task RefreshFullscreenStateAsync(){try{var state=await JS.InvokeAsync<bool[]>("ristFullscreen.state");_fullscreen=state.Length>0&&state[0];_fullscreenSupported=state.Length<2||state[1];await InvokeAsync(StateHasChanged);}catch{_fullscreenSupported=false;await InvokeAsync(StateHasChanged);}}
 async Task ToggleFullscreenAsync(){try{var state=await JS.InvokeAsync<bool[]>("ristFullscreen.toggle");_fullscreen=state.Length>0&&state[0];_fullscreenSupported=state.Length<2||state[1];}catch{_fullscreenSupported=false;}await InvokeAsync(StateHasChanged);}
 void OpenAccessibilityShell()=>OpenWorkspace("accessibility","ACCESSIBILITY SHELL","DESCRIBE → NAVIGATE → ACT → BUILD");
 void OpenObserver()=>OpenWorkspace("observer","RELIC OBSERVER","QUERY → EVIDENCE → PROVENANCE → OBSERVE");
 void OpenWorldbuilding(){if(!CanOpenWorldBuilder)return;OpenWorkspace("world","WORLDBUILDER",CanBuildWorld?"WORLD → TIER → LAYER → CUBE":"ENDEMAR → VIEW ONLY → REFERENCE");}
 async Task CloseWorldGate(){
  _worldGateOpen=false;
  if(!Session.HasActiveWorld)
  {
   await InvokeAsync(StateHasChanged);
   return;
  }
  await Session.RefreshTrustedWorldAuthorityAsync();
  await RefreshLandingWorldsAsync();
  if(!Session.IsGeonaphWorld)
  {
   OpenWorkspace("world","WORLDBUILDER","SANDBOX → TIER → LAYER → CUBE");
   await InvokeAsync(StateHasChanged);
   return;
  }
  _workspaceOpen=false;
  await PersistWorkspaceAsync("hub");
  await InvokeAsync(StateHasChanged);
 }
 void OpenPerceiver(){if(!WorldReady||!Session.IsGeonaphWorld)return;OpenWorkspace("perceiver","PERCEIVER","TIERED MOVIE → PARALLAX → TILT");}
 void OpenImmersionBuilder()=>OpenWorkspace("immersion","IMMERSIONBUILDER","WORLD → IMMERSION PROFILE → EXPERIENCE");
 async Task OpenRegionDefiner()
 {
  if(!WorldReady)return;
  _settingsOpen=false;
  _tickerOpen=false;
  _cardIndexOpen=false;
  _worldGateOpen=false;
  _regionGateOpen=true;
  try
  {
   if(Session.IsGeonaphWorld)await Session.RefreshMmoLandAsync();
   await Session.LoadRegionsAsync();
  }
  catch{}
 }
 void CloseRegionGate()=>_regionGateOpen=false;
 void OpenNewRegion()
 {
  Session.SetActiveRegion("");
  OpenWorkspace("viewer","REGIONDEFINER","WORLD → TIER → SELECT → REGION");
 }
 void OpenSavedRegion(WorldRegion region)
 {
  Session.SetActiveRegion(region.RegionId);
  OpenWorkspace("viewer","REGIONDEFINER",$"{region.Name.ToUpperInvariant()} → REGION → LOCAL");
 }
 void OpenTabletop()=>OpenWorkspace("campaign","TABLETOP","LOCAL → TABLETOP → PIECES");
 void OpenInstance()=>OpenWorkspace("roleplay","INSTANCE","LOCAL → INSTANCE → ENCOUNTER");
 void OpenWeather()=>OpenWorkspace("world","WEATHER","SKY → WEATHER → WORLD");
 void OpenGeology()=>OpenWorkspace("world","GEOLOGICAL EVENTS","TERRAIN → EVENT → HISTORY");
 void OpenHistory()=>OpenWorkspace("campaign","HISTORY","ERA → EVENT → CHRONOLOGY");
 void OpenLore()=>Navigation.NavigateTo("/relicquery/",forceLoad:true);
 void OpenAstrology()=>OpenWorkspace("world","ASTROLOGY","CELESTIAL → INFLUENCE → WORLD");
 void OpenAstronomy()=>OpenWorkspace("world","ASTRONOMY","STARS → SKY → CELESTIAL STRUCTURE");
 void OpenGameMaster(){if(!CanOpenWorldBuilder)return;OpenWorkspace("campaign","GAMEMASTER",CanBuildWorld?"BUILD → MANAGE → RUN → REPLAY":"ENDEMAR → VIEW ONLY → REFERENCE");}
 void OpenViewer()=>OpenWorkspace("viewer","REGIONDEFINER","WORLD → REGION → LOCAL");
 void OpenCampaign()=>OpenWorkspace("campaign","CAMPAIGNS","WORLD → CAMPAIGN → SESSION → REPLAY");
 void OpenAssets()=>OpenWorkspace("assets","ASSET DESIGNER","BROWSE → CREATE → PLACE → SAVE");
 void OpenRoleplay()=>OpenWorkspace("roleplay",Session.IsGeonaphWorld?"ENTER SHAELVIEN":"ROLEPLAY",Session.IsGeonaphWorld?"WORLD MAP → ZONE → PARTY → CHAT":"CHARACTER → DICE → ENCOUNTER → REPLAY");
 void OpenCharacters()=>OpenWorkspace("roleplay","CHARACTERS","CHARACTER → SHEET → EQUIPMENT");
 void OpenDiceTools()=>OpenWorkspace("tools","DICE & TOOLS","DICE → CARDS → TOOLS");
 void OpenManage(){_settingsOpen=false;_cardIndexOpen=false;_worldGateOpen=true;}
 void OpenFeedback()=>OpenWorkspace("feedback","FEEDBACK","REPORT → CONTEXT → SEND");
 void OpenStore()=>Navigation.NavigateTo("/store/",forceLoad:true);
 void OpenMembership()=>Navigation.NavigateTo("/store/membership.html",forceLoad:true);
  void OpenAiCommerce()=>Navigation.NavigateTo("/ai-purchase/",forceLoad:true);
 void OpenKickstarter()=>Navigation.NavigateTo("/kickstarter/index.html",forceLoad:true);
 void OpenRulebooks()=>Navigation.NavigateTo("/relicquery/",forceLoad:true);
 void OpenAccessibility()=>Navigation.NavigateTo("accessibility.html",forceLoad:true);
 void GoHome(){_workspaceOpen=false;_settingsOpen=false;_commerceAdminOpen=false;_tickerOpen=false;_cardIndexOpen=false;_worldGateOpen=false;_regionGateOpen=false;_=PersistWorkspaceAsync("hub");}
 void ReturnToHub(){_workspaceOpen=false;_settingsOpen=false;_commerceAdminOpen=false;_tickerOpen=false;_cardIndexOpen=false;_worldGateOpen=false;_regionGateOpen=false;_=PersistWorkspaceAsync("hub");}
}