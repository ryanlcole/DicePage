@inject WorldSession Session
<main class="map-shell"><div class="map" @onclick="Tap"><img class="base" src="assets/naeja.jpg" alt="World of Naeja" /><div class="grid @Session.GridStyle" style="--cell:@($"{Session.GridDiameter}px")"></div>@foreach(var t in Session.PlacedTiles){<img class="tile" src="@t.Image" style="left:@Pct(t.X);top:@Pct(t.Y)" alt="@t.Name" />}@foreach(var p in Session.Pieces){<div class="piece @p.Kind" style="left:@Pct(p.X);top:@Pct(p.Y)">@p.Kind</div>}@foreach(var d in Session.Rolls){<div class="die-result" style="left:@Pct(d.X);top:@Pct(d.Y)">@d.Label @d.Value</div>}@foreach(var g in Session.Gems){<div class="gem" style="left:@Pct(g.X);top:@Pct(g.Y)"><span>@g.Value</span></div>}<div class="status">@Session.Role • @Session.GridStyle • @Session.GridDistance units • @Session.Mode</div></div></main>
@code{void Tap(MouseEventArgs e){Session.MapTap(Math.Clamp(e.OffsetX/961d,0,1),Math.Clamp(e.OffsetY/541d,0,1));}static string Pct(double v)=>$"{v*100:0.###}%";}
