<main class="table-workspace" @onpointermove="DragMove" @onpointerup="DragEnd" @onpointercancel="DragCancel">
 @if(Session.TileBrowserOpen)
 {
  <section class="tile-browser" aria-label="Tile library">
   <header>
    <div class="tile-browser-title"><strong>Tile library</strong><small>Choose a directory, then drag a tile to the pallet.</small></div>
    <label class="tileset-upload" title="Upload and split a tileset" aria-label="Upload tileset">
     <span aria-hidden="true">+</span><InputFile OnChange="ImportTileset" accept="image/png,image/webp,image/jpeg" disabled="@ImportingTileset" />
    </label>
   </header>
   @if(!string.IsNullOrWhiteSpace(ImportStatus)){<div class="tileset-import-status" role="status">@ImportStatus</div>}
   <div class="tile-browser-path">
    <label>Layer<select value="@BrowserLayer" @onchange="LayerChanged">@foreach(var layer in BrowserLayers){<option value="@layer">@Pretty(layer)</option>}</select></label>
    <span aria-hidden="true">›</span>
    <label>Directory<select value="@BrowserDirectory" @onchange="DirectoryChanged">@foreach(var directory in BrowserDirectories){<option value="@directory">@directory</option>}</select></label>
    <span aria-hidden="true">›</span>
    <label>Folder<select value="@BrowserFolder" @onchange="FolderChanged"><option value="">Choose folder</option>@foreach(var folder in BrowserFolders){<option value="@folder">@folder</option>}</select></label>
   </div>
   <div class="tile-filter-tools">
    <label>Saved filters<select value="@SelectedSavedFilter" @onchange="ApplySavedFilter"><option value="">Choose saved filter</option>@foreach(var filter in SavedFilters){<option value="@filter.Key">@filter.Label</option>}</select></label>
    <button @onclick="SaveCurrentFilter" disabled="@string.IsNullOrWhiteSpace(BrowserFolder)">Save filter</button>
   </div>
   <div class="tile-tool-row">
    <label>Tool type
     <select value="@SelectedTileTool" @onchange="TileToolChanged" aria-label="Tile tool type">
      <option value="draw">Draw</option>
      <option value="brush">Brush</option>
      <option value="fill">Fill</option>
      <option value="line">Line</option>
      <option value="square">Square</option>
      <option value="circle">Circle</option>
      <option value="erase">Erase</option>
     </select>
    </label>
   </div>
   <div class="tile-browser-grid" aria-label="Tiles; swipe left or right">
    @foreach(var tile in BrowserTiles)
    {
     <button class="library-tile" title="@tile.Name — @tile.Author. Drag its image to the pallet.">
      <span class="tile-drag-source tile-image-crop" @onpointerdown="e=>BeginAtlasDrag(tile,e)" @onpointerdown:stopPropagation="true"><img src="@tile.Image" style="@CropStyle(tile)" alt="" draggable="false"/></span><span>@tile.Name</span>
     </button>
    }
    @if(string.IsNullOrWhiteSpace(BrowserFolder)){<p>Choose a folder to load its tiles.</p>}
    else if(!BrowserTiles.Any()){<p>No tiles are available in this folder yet.</p>}
   </div>
  </section>
 }
 <aside class="staging-tray pallet" aria-label="Tile pallet">
  @if(Session.StagedAssets.Count==0)
  {
   <div class="tray-hint"><strong>PALLET</strong><span>Drag tiles here.</span></div>
  }
  @foreach(var staged in Session.StagedAssets)
  {
   <button class="tray-item @staged.Kind" title="Drag onto map. Double-click to remove from tray."
           @onpointerdown="e=>BeginTrayDrag(staged,e)" @onpointerdown:stopPropagation="true"
           @ondblclick="()=>Session.RemoveStaged(staged.Key)">
    @if(staged.Kind=="tile")
    {
     <span class="tile-image-crop"><img src="@staged.Image" style="@CropStyle(staged)" alt="@staged.Name" /></span>
    }
    else if(staged.Kind=="pin")
    {
     <span class="gps-pin" aria-hidden="true"></span>
    }
    else
    {
     <span class="token-preview">token</span>
    }
    <small>@staged.Name</small>
   </button>
  }
 </aside>

 <section class="map-shell">
  <div class="map" @ref="MapElement" @onpointerdown="Down" @onpointermove="Move" @onpointerup="Up" @onpointercancel="Cancel" @ondragover:preventDefault="true" @ondrop="DropHeaderPin">
   <div class="world-stage ocean-world" style="transform:@StageTransform" aria-label="Open ocean world map">
    <div class="grid @Session.GridStyle"></div>
    @foreach(var t in Session.PlacedTiles)
    {
     <div class="tile-cell" style="@TileStyle(t)"
          @onpointerdown="e=>BeginTileDrag(t,e)" @onpointerdown:stopPropagation="true">
      <span class="tile-image-crop"><img src="@t.Image" style="@CropStyle(t)" alt="@t.Name" draggable="false" /></span>
     </div>
    }
    @foreach(var roll in Session.Rolls)
    {
     var die=Session.Dice(roll.Key);
     if(die is not null)
     {
      <div class="rolled-die die-@die.Key" style="@RollStyle(roll,die)" title="@roll.Label @(roll.Value==0?"rolling":roll.Value.ToString())"></div>
     }
    }
    @foreach(var p in Session.Pieces)
    {
     @if(p.Kind=="pin")
     {
      <button class="piece pin zoom-pin" style="@PinStyle(p)" aria-label="Map pin"
              @onclick="()=>PinTap(p)" @onclick:stopPropagation="true"
              @onpointerdown="e=>BeginPieceDrag(p,e)" @onpointerdown:stopPropagation="true">
       <span class="gps-pin" aria-hidden="true"></span>
      </button>
     }
     else
     {
      <div class="piece @p.Kind" style="@PieceStyle(p)"
           @onpointerdown="e=>BeginPieceDrag(p,e)" @onpointerdown:stopPropagation="true">@p.Kind</div>
     }
    }
    @if(Session.SelectedPin is not null)
    {
     <aside class="pin-callout" style="left:@Pct(Session.SelectedPin.X);top:@Pct(Session.SelectedPin.Y)"><strong>Location detail</strong><small>Tap pin again to recurse.</small></aside>
    }
   </div>
   <div class="status">@StatusText • drag • pinch • @($"{G.Zoom:0.0}x")</div>
  </div>
 </section>

 @if(Dragging)
 {
  <div class="drag-ghost" style="@DragPreviewStyle">
   @if(AtlasDragging is not null) { <span class="tile-image-crop"><img src="@AtlasDragging.Image" style="@CropStyle(AtlasDragging)" alt="" /></span> }
   else if(TrayDragging?.Kind=="tile") { <span class="tile-image-crop"><img src="@TrayDragging.Image" style="@CropStyle(TrayDragging)" alt="" /></span> }
   else if(TileDragging is not null) { <span class="tile-image-crop"><img src="@TileDragging.Image" style="@CropStyle(TileDragging)" alt="" /></span> }
   else if(TrayDragging?.Kind=="pin" || PieceDragging?.Kind=="pin") { <span class="gps-pin"></span> }
   else { <span class="token-preview">token</span> }
  </div>
 }
</main>
