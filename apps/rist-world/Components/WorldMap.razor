@using Microsoft.AspNetCore.Components.Forms
<main class="table-workspace" @onpointermove="DragMove" @onpointerup="DragEnd" @onpointercancel="DragCancel">
 <CardLibrary />
 @if(Session.TileBrowserOpen)
 {
  <section class="tile-browser library-deck-browser" aria-label="Tile library">
   <header>
    <div class="tile-browser-title"><strong>Asset library</strong><small>Open a deck to draw its contents to the right. Drag assets to the pallet.</small></div>
    <label class="tileset-upload" title="@(Session.IsLoggedIn?"Upload and split a tileset":"Log in to upload tilesets")" aria-label="Upload tileset"><span aria-hidden="true">+</span><InputFile OnChange="ImportTileset" accept="image/png,image/webp,image/jpeg" disabled="@(!Session.IsLoggedIn||ImportingTileset)" /></label>
   </header>
   @if(!string.IsNullOrWhiteSpace(ImportStatus)){<div class="tileset-import-status" role="status">@ImportStatus</div>}

   <div class="library-deck-toolbar">
    <button @onclick="@(()=>{BrowserLayer="";BrowserDirectory="";BrowserFolder="";})">Home</button>
    @if(!string.IsNullOrWhiteSpace(BrowserLayer)){<button @onclick="@(()=>{BrowserDirectory="";BrowserFolder="";})">Back</button>}
    <label>Saved<select value="@SelectedSavedFilter" @onchange="ApplySavedFilter"><option value="">Saved filters</option>@foreach(var filter in SavedFilters){<option value="@filter.Key">@filter.Label</option>}</select></label>
    <button @onclick="SaveCurrentFilter" disabled="@string.IsNullOrWhiteSpace(BrowserFolder)">Save current</button>
    <label>Tool<select value="@SelectedTileTool" @onchange="TileToolChanged" aria-label="Tile tool type"><option value="draw">Draw</option><option value="brush">Brush</option><option value="fill">Fill</option><option value="line">Line</option><option value="square">Square</option><option value="circle">Circle</option><option value="erase">Erase</option></select></label>
   </div>

   <div id="tile-library-slider" class="tile-browser-slider" aria-label="Asset deck rail">
    <div class="tile-browser-grid">
     <div class="library-deck-rail">
      @if(!string.IsNullOrWhiteSpace(BrowserLayer))
      {
       <button class="library-deck-folder active" @onclick="@(()=>{BrowserDirectory="";BrowserFolder="";})" aria-label="Open layer choices">
        <span class="deck-stack"><span class="hand-toggle-card-back" aria-hidden="true"></span></span><strong>@Pretty(BrowserLayer)</strong><small>Layer</small>
       </button>
      }
      @if(!string.IsNullOrWhiteSpace(BrowserDirectory))
      {
       <button class="library-deck-folder active" @onclick="@(()=>BrowserFolder="")" aria-label="Open directories">
        <span class="deck-stack"><span class="hand-toggle-card-back" aria-hidden="true"></span></span><strong>@BrowserDirectory</strong><small>Directory</small>
       </button>
      }
      @if(!string.IsNullOrWhiteSpace(BrowserFolder))
      {
       <button class="library-deck-folder active" aria-label="Current folder @BrowserFolder">
        <span class="deck-stack"><span class="hand-toggle-card-back" aria-hidden="true"></span></span><strong>@BrowserFolder</strong><small>Folder</small>
       </button>
      }
      @if(!string.IsNullOrWhiteSpace(BrowserLayer)||!string.IsNullOrWhiteSpace(BrowserDirectory)||!string.IsNullOrWhiteSpace(BrowserFolder)){<span class="library-deck-divider" aria-hidden="true"></span>}

      @if(string.IsNullOrWhiteSpace(BrowserLayer))
      {
       @foreach(var layer in BrowserLayers)
       {
        <button class="library-deck-folder" @onclick="@(()=>{BrowserLayer=layer;BrowserDirectory="";BrowserFolder="";})" aria-label="Open @Pretty(layer) layer">
         <span class="deck-stack"><span class="hand-toggle-card-back" aria-hidden="true"></span></span><strong>@Pretty(layer)</strong><small>Layer</small>
        </button>
       }
      }
      else if(string.IsNullOrWhiteSpace(BrowserDirectory))
      {
       @foreach(var directory in BrowserDirectories)
       {
        <button class="library-deck-folder" @onclick="@(()=>{BrowserDirectory=directory;BrowserFolder="";})" aria-label="Open @directory directory">
         <span class="deck-stack"><span class="hand-toggle-card-back" aria-hidden="true"></span></span><strong>@directory</strong><small>Directory</small>
        </button>
       }
      }
      else if(string.IsNullOrWhiteSpace(BrowserFolder))
      {
       @foreach(var folder in BrowserFolders)
       {
        <button class="library-deck-folder" @onclick="@(()=>BrowserFolder=folder)" aria-label="Open @folder folder">
         <span class="deck-stack"><span class="hand-toggle-card-back" aria-hidden="true"></span></span><strong>@folder</strong><small>Folder</small>
        </button>
       }
       @if(!BrowserFolders.Any()){<p class="library-deck-empty">No folders are available here.</p>}
      }
      else
      {
       @foreach(var tile in BrowserTiles)
       {
        <button class="library-tile" title="@tile.Name — @tile.Author. Drag its image to the pallet.">
         <span class="tile-drag-source tile-image-crop" @onpointerdown="e=>BeginAtlasDrag(tile,e)" @onpointerdown:stopPropagation="true"><img src="@tile.Image" style="@CropStyle(tile)" alt="" draggable="false"/></span><span>@tile.Name</span>
        </button>
       }
       @if(!BrowserTiles.Any()){<p class="library-deck-empty">This folder is empty.</p>}
      }
     </div>
    </div>
   </div>
  </section>
 }
 @if(Session.PlayActive)
 {
  <aside id="initiative-slider" class="staging-tray encounter-control-rail desktop-arrow-slider desktop-arrow-adaptive" aria-label="Initiative tracker and encounter timer">
   <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#initiative-slider',-1)" aria-label="Scroll initiative backward"><span class="arrow-horizontal">‹</span><span class="arrow-vertical">↑</span></button>
   <div class="initiative-heading"><strong>Initiative</strong><span>@Session.Pieces.Count piece@(Session.Pieces.Count==1?"":"s")</span></div>
   <ol class="initiative-strip">@for(var index=0;index<Session.Pieces.Count;index++){var piece=Session.Pieces[index];<li><span>@(index+1)</span><strong>@Pretty(piece.Kind)</strong></li>}@if(Session.Pieces.Count==0){<li class="initiative-empty">Place tokens to begin.</li>}</ol>
   <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#initiative-slider',1)" aria-label="Scroll initiative forward"><span class="arrow-horizontal">›</span><span class="arrow-vertical">↓</span></button>
   <div class="encounter-timer"><time datetime="@Session.EncounterElapsedIso">@Session.EncounterElapsedText</time><button @onclick="Session.ToggleEncounterTimer">@(Session.EncounterTimerRunning?"Pause":"Start")</button><button @onclick="Session.ResetEncounterTimer">Reset</button></div>
  </aside>
 }
 else
 {
  <aside id="pallet-slider" class="staging-tray pallet desktop-arrow-slider desktop-arrow-adaptive" aria-label="Tile pallet">
   <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#pallet-slider',-1)" aria-label="Scroll pallet backward"><span class="arrow-horizontal">‹</span><span class="arrow-vertical">↑</span></button>
   @if(Session.StagedAssets.Count==0){<div class="tray-hint"><strong>PALLET</strong><span>Drag tiles here.</span></div>}
   @if(Session.CanEditTiles)
   {
    <div class="zone-editor" aria-label="Terrain zone editor"><button class="zone-mode-button map-lock-button @(!Session.MapLocked?"active":"")" @onclick="Session.ToggleMapLock" aria-pressed="@(!Session.MapLocked)" title="@(Session.MapLocked?"Unlock map":"Lock map")"><span class="map-lock-glyph @(Session.MapLocked?"locked":"unlocked")" aria-hidden="true"></span></button>@if(Session.HasSelectedZone){<strong>@Session.SelectedZoneTerrain zone</strong><button @onclick="Session.ToggleSelectedZoneLock">@(Session.SelectedZoneLocked?"Unlock zone":"Lock zone")</button><label><span>Zone label</span><input value="@Session.SelectedZoneLabel" @onchange="e=>Session.SetSelectedZoneLabel(e.Value?.ToString()??string.Empty)" placeholder="Add label" /></label>}</div>
   }
   @foreach(var staged in Session.StagedAssets)
   {
    <button class="tray-item @staged.Kind" title="Drag onto map. Double-click to remove from tray." @onpointerdown="e=>BeginTrayDrag(staged,e)" @onpointerdown:stopPropagation="true" @ondblclick="()=>Session.RemoveStaged(staged.Key)">@if(staged.Kind=="tile"){<span class="tile-image-crop" style="@CropBoxStyle(staged)"><img src="@staged.Image" style="@CropStyle(staged)" alt="@staged.Name" /></span>}else if(staged.Kind=="mini"){<span class="token-preview"><img src="@(Session.Layer=="WORLD"?"/Game/assets/shaelvien/runtime/main-world-coin.png":"/Game/assets/shaelvien/runtime/main-token.png")" alt="" draggable="false" style="width:100%;height:100%;object-fit:contain;display:block" /></span>}else{<span class="token-preview">@staged.Name</span>}<small>@staged.Name</small></button>
   }
   <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#pallet-slider',1)" aria-label="Scroll pallet forward"><span class="arrow-horizontal">›</span><span class="arrow-vertical">↓</span></button>
  </aside>
 }

 <section class="map-shell">
  <div class="map" data-pan-x="@G.PanX" data-pan-y="@G.PanY" data-zoom="@G.Zoom" @ref="MapElement" tabindex="0" role="application" aria-label="Interactive Shaelvien map" aria-keyshortcuts="ArrowUp ArrowDown ArrowLeft ArrowRight W A S D + - 0 Escape" @onpointerdown="Down" @onpointermove="Move" @onpointerup="Up" @onpointercancel="Cancel" @onwheel="Wheel" @onwheel:preventDefault="true" @onkeydown="KeyDown" @ondragover:preventDefault="true" @ondrop="DropHeaderPin">
   <div class="desktop-map-zoom" role="group" aria-label="Map zoom controls" @onpointerdown:stopPropagation="true"><button type="button" @onclick="ZoomOut">−</button><button type="button" @onclick="ZoomIn">+</button></div>
   @if(Session.LockedTileMenuOpen)
   {
    <div class="locked-tile-menu" role="menu" aria-label="Pinned region actions" @onpointerdown:stopPropagation="true"><strong>Pinned region</strong><label class="pin-label-editor"><span>Label call-out</span><input value="@Session.SelectedPin?.Label" @onchange="e=>Session.SetSelectedPinLabel(e.Value?.ToString()??string.Empty)" placeholder="Name this location" /></label><div role="group" aria-label="Plane and tier navigation"><button type="button" @onclick="()=>Session.MovePlane(-1)">Plane−</button><button type="button" @onclick="()=>Session.MovePlane(1)">Plane+</button><button type="button" @onclick="()=>Session.MoveTier(-1)">Tier−</button><button type="button" @onclick="()=>Session.MoveTier(1)">Tier+</button></div><small>@Session.WorldCoordinateLabel</small><button role="menuitem" @onclick="Session.BeginRecursiveRegionSelection">Select tiles for local region</button><button role="menuitem" @onclick="Session.OpenSendPlayersToRegion" disabled="@(!Session.CanEnterHeldRegion)">Send Players to Region</button><button role="menuitem" @onclick="Session.EnterHeldRegion" disabled="@(!Session.CanEnterHeldRegion)">Enter Region</button><button class="danger" role="menuitem" @onclick="Session.RemoveSelectedPin">Remove Pin</button><button role="menuitem" @onclick="()=>Session.CloseLockedTileMenu()">Cancel</button></div>
   }
   @if(Session.RegionPlayerPickerOpen)
   {
    <div class="region-player-picker" role="dialog" aria-label="Send players to region" @onpointerdown:stopPropagation="true"><strong>Send Players to Region</strong>@foreach(var player in Session.RegionPlayerChoices){<label><input type="checkbox" checked="@Session.AssignedRegionPlayers.Contains(player)" @onchange="()=>Session.TogglePlayerInHeldRegion(player)" /> <span>@player</span></label>}<button @onclick="Session.CloseRegionPlayerPicker">Done</button></div>
   }
   @if(Session.RecursiveRegionSelectionMode)
   {
    <div class="recursive-region-actions" role="toolbar" aria-label="Local region selection" @onpointerdown:stopPropagation="true"><strong>@Session.RecursiveRegionSelectionCount tile@(Session.RecursiveRegionSelectionCount==1?"":"s") selected</strong><button @onclick="Session.CommitRecursiveRegion" disabled="@(!Session.HasRecursiveRegionSelection)">Commit to @Session.NextRecursiveLayer</button><button @onclick="Session.CancelRecursiveRegionSelection">Cancel</button></div>
   }
   <div class="world-stage" style="transform:@StageTransform" aria-label="Shaelvien world map">
    <div class="base ocean-world" aria-label="Shaelvien ocean world"></div>
    @if(!Session.HasBaseMapTilemap){<img src="@Session.WorldMapUrl" alt="Naeja world map" draggable="false" style="position:absolute;inset:0;width:100%;height:100%;object-fit:fill;pointer-events:none;user-select:none" />}
    <div class="grid @Session.GridStyle"></div>
    @foreach(var t in Session.PlacedTiles)
    {
     <div class="tile-cell @(t.Locked?"locked":"unlocked") @Session.ZoneBoundaryClasses(t) @Session.RecursiveRegionBoundaryClasses(t)" style="@TileStyle(t)" @onpointerdown="e=>BeginTileDrag(t,e)" @onpointerdown:stopPropagation="@(!Session.MapLocked)" @oncontextmenu:preventDefault="true" data-zone="@t.ZoneId" aria-label="@t.Name"><span class="tile-image-crop"><img src="@t.Image" style="@CropStyle(t)" alt="@t.Name" draggable="false" /></span></div>
    }
    @foreach(var zone in Session.MapZoneLabels){<div class="map-zone-label @(zone.Locked?"locked":"")" style="left:@Pct(zone.X);top:@Pct(zone.Y)">@zone.Label</div>}
    @foreach(var roll in Session.Rolls){var die=Session.Dice(roll.Key);if(die is not null){<div class="rolled-die die-@die.Key" style="@RollStyle(roll,die)" title="@roll.Label @(roll.Value==0?"rolling":roll.Value.ToString())"></div>}}
    @foreach(var p in Session.Pieces)
    {
     @if(p.Kind=="pin")
     {
      <button class="piece pin zoom-pin placed-pin" style="@PinStyle(p)" aria-label="Open map pin menu" @onclick="()=>PinTap(p)" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @oncontextmenu:preventDefault="true"><span class="header-icon icon-pin map-pin-icon" aria-hidden="true"></span></button>
      @if(!string.IsNullOrWhiteSpace(p.Label)){<span class="pin-label-callout" style="left:@Pct(p.X);top:@Pct(p.Y)">@p.Label</span>}
     }
     else if(p.Kind=="mini")
     {
      <div class="piece mini" style="@PieceStyle(p)" @onpointerdown="e=>BeginPieceDrag(p,e)" @onpointerdown:stopPropagation="true"><img src="@(Session.Layer=="WORLD"?"/Game/assets/shaelvien/runtime/main-world-coin.png":"/Game/assets/shaelvien/runtime/main-token.png")" alt="Miniature" draggable="false" style="width:100%;height:100%;object-fit:contain;display:block;pointer-events:none" /></div>
     }
     else
     {
      <div class="piece @p.Kind" style="@PieceStyle(p)" @onpointerdown="e=>BeginPieceDrag(p,e)" @onpointerdown:stopPropagation="true">@p.Kind</div>
     }
    }
   </div>
   <div class="status">@Session.MapName • @StatusText • @Session.WorldCoordinateLabel • drag • pinch • @($"{G.Zoom:0.0}x")</div>
  </div>
 </section>
 @if(Dragging)
 {
  <div class="drag-ghost" style="@DragPreviewStyle">@if(AtlasDragging is not null){<span class="tile-image-crop"><img src="@AtlasDragging.Image" style="@CropStyle(AtlasDragging)" alt="" /></span>}else if(TrayDragging?.Kind=="tile"){<span class="tile-image-crop"><img src="@TrayDragging.Image" style="@CropStyle(TrayDragging)" alt="" /></span>}else if(TileDragging is not null){<span class="tile-image-crop"><img src="@TileDragging.Image" style="@CropStyle(TileDragging)" alt="" /></span>}else if(TrayDragging?.Kind=="pin" || PieceDragging?.Kind=="pin"){<span class="header-icon icon-pin map-pin-icon" aria-hidden="true"></span>}else if(TrayDragging?.Kind=="mini" || PieceDragging?.Kind=="mini"){<span class="token-preview"><img src="@(Session.Layer=="WORLD"?"/Game/assets/shaelvien/runtime/main-world-coin.png":"/Game/assets/shaelvien/runtime/main-token.png")" alt="" draggable="false" style="width:100%;height:100%;object-fit:contain;display:block" /></span>}else{<span class="token-preview">token</span>}</div>
 }
</main>