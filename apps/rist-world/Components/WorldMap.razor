<main class="map-shell"><div class="map" @onpointerdown="Down" @onpointermove="Move" @onpointerup="Up" @onpointercancel="Cancel"><div class="world-stage" style="transform:@StageTransform"><img class="base" src="assets/naeja.jpg" alt="World of Naeja" /><div class="grid @Session.GridStyle" style="--cell:@($"{Session.GridDiameter}px")"></div>@foreach(var t in Session.PlacedTiles){<img class="tile" src="@t.Image" style="left:@Pct(t.X);top:@Pct(t.Y)" alt="@t.Name" />}@foreach(var p in Session.Pieces){if(p.Kind=="pin"){<button class="piece pin" style="left:@Pct(p.X);top:@Pct(p.Y)" @onclick="()=>PinTap(p)" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true"></button>}else{<div class="piece @p.Kind" style="left:@Pct(p.X);top:@Pct(p.Y)">@p.Kind</div>}}@if(Session.SelectedPin is not null){<aside class="pin-callout" style="left:@Pct(Session.SelectedPin.X);top:@Pct(Session.SelectedPin.Y)"><strong>Location detail</strong><small>Tap pin again to recurse.</small></aside>}</div><div class="status">@Session.Layer • drag • pinch • @($"{G.Zoom:0.0}x")</div></div></main>