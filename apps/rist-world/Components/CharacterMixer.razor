@implements IDisposable
@inject WorldSession Session
@if(Session.MixerOpen)
{
 <div class="mixer-modal" @onclick="Session.CloseMixer">
  <section class="character-mixer character-console" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @ontouchstart:stopPropagation="true">
   <button class="console-close" @onclick="Session.CloseMixer" aria-label="Close character sheet">×</button>
   <header class="console-identity">
    <div class="character-portrait"><span>PORTRAIT</span></div>
    <label>NAME<input @bind="Session.CharacterName" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" /></label>
    <label>SPECIES<input @bind="Session.CharacterSpecies" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" /></label>
    <label>AGE<input @bind="Session.CharacterAge" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" /></label>
    <label>ALIGNMENT<input @bind="Session.CharacterAlignment" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" /></label>
   </header>

   <section class="console-bank pools-bank">
    <div class="bank-title"><strong>POOLS</strong><span>current / maximum</span></div>
    <div class="pool-strip">
     @foreach(var field in Session.CharacterFields.Where(x=>x.Group=="Pools"))
     {
      <article class="pool-channel">
       <button class="remove-field" @onclick="()=>Session.RemoveCharacterField(field)">×</button>
       <div class="pool-scale"><span>100</span><span>80</span><span>60</span><span>40</span><span>20</span><span>0</span></div>
       <input class="pool-slider" type="range" min="0" max="@Math.Max(field.Max,1)" value="@field.Current" @oninput="e=>SetFieldCurrent(field,e)" />
       <output>@field.Current</output>
       <input class="pool-max" type="number" min="1" max="999" value="@field.Max" @onchange="e=>SetFieldMax(field,e)" />
       <strong class="field-label">@field.Name</strong>
      </article>
     }
     <button class="console-add" @onclick="()=>BeginAdd("Pools")">+</button>
    </div>
   </section>

   <section class="console-bank skills-bank">
    <div class="bank-title"><strong>SKILLS</strong><span>tap a dial to expose its card</span></div>
    <div class="skill-strip">
     @foreach(var field in Session.CharacterFields.Where(x=>x.Group=="Skills"))
     {
      <article class="skill-channel">
       <button class="remove-field" @onclick="()=>Session.RemoveCharacterField(field)">×</button>
       <input class="skill-max" type="number" min="0" max="999" value="@field.Max" @onchange="e=>SetFieldMax(field,e)" aria-label="Maximum" />
       <button class="skill-dial" @onclick="()=>Session.ShowHand(field)" title="Show @field.Name card"><span>@field.Current</span></button>
       <input class="skill-value" type="number" min="0" max="999" value="@field.Current" @onchange="e=>SetFieldCurrent(field,e)" />
       <strong class="field-label">@field.Name</strong>
       <button class="show-hand" @onclick="()=>Session.ShowHand(field)">Show Hand</button>
      </article>
     }
     <button class="console-add round-add" @onclick="()=>BeginAdd("Skills")">+</button>
    </div>
   </section>

   @if(AddingGroup is not null)
   {
    <section class="field-builder console-builder" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @ontouchstart:stopPropagation="true">
     <div><strong>Add @AddingGroup</strong><button @onclick="CloseBuilder">×</button></div>
     <input value="@Session.FieldSearch" @oninput="SearchChanged" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @ontouchstart:stopPropagation="true" placeholder="Start typing a name…" autocomplete="off" inputmode="text" />
     @if(!string.IsNullOrWhiteSpace(Session.FieldSearch))
     {
      <div class="field-suggestions" @onclick:stopPropagation="true">
       @foreach(var option in Session.FilteredFieldVocabulary.Where(x=>x.Group==AddingGroup)){<button @onclick="()=>AddField(option)"><strong>@option.Name</strong><small>@option.Kind</small></button>}
       <button class="custom-field" @onclick="AddCustom"><strong>Custom: @Session.FieldSearch</strong><small>Create new</small></button>
      </div>
     }
    </section>
   }

   <section class="console-notebook">
    <nav class="notebook-tabs">
     @foreach(var tab in new[]{"Description","Background","Feats"}){<button class="@(Session.CharacterTab==tab?"active":"")" @onclick="()=>Session.SetCharacterTab(tab)">@tab</button>}
    </nav>
    @if(Session.CharacterTab=="Description")
    {<textarea aria-label="Public Description" @bind="Session.CharacterDescription" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" placeholder="Public description…"></textarea>}
    else if(Session.CharacterTab=="Background")
    {<textarea aria-label="Background" @bind="Session.CharacterBackground" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" placeholder="Background…"></textarea>}
    else
    {
     <div class="feat-workspace">
      <div class="feat-list">
       @foreach(var field in Session.CharacterFields.Where(x=>x.Group=="Feats"))
       {<article><strong>@field.Name</strong><button @onclick="()=>Session.ShowHand(field)">Show Hand</button><button @onclick="()=>Session.RemoveCharacterField(field)">×</button></article>}
      </div>
      <button class="console-add feat-add" @onclick="()=>BeginAdd("Feats")">+</button>
     </div>
    }
   </section>
  </section>
 </div>
}
@code{
 string? AddingGroup;
 protected override void OnInitialized()=>Session.Changed+=SessionChanged;
 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose()=>Session.Changed-=SessionChanged;
 void BeginAdd(string group){AddingGroup=group;Session.SetCharacterTab(group);Session.SetFieldSearch("");}
 void CloseBuilder(){AddingGroup=null;Session.SetFieldSearch("");}
 void SearchChanged(ChangeEventArgs e)=>Session.SetFieldSearch(e.Value?.ToString()??"");
 void AddField(CharacterFieldOption option){Session.AddCharacterField(option);AddingGroup=null;}
 void AddCustom(){Session.AddCustomCharacterField();AddingGroup=null;}
 void SetFieldCurrent(CharacterField field,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetCharacterField(field,v);}
 void SetFieldMax(CharacterField field,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetCharacterField(field,field.Current,v);}
}
