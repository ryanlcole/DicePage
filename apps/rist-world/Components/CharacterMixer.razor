@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorldSession Session
@if(Session.MixerOpen)
{
<div class="mixer-modal" @onclick="CloseSheet">
<section class="character-mixer character-console" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @ontouchstart:stopPropagation="true">
 <div class="character-console-tools"><span>CHAR @Session.ActiveCharacterNumber / @Session.CharacterCount</span>@if(Session.CharacterEditMode){<button @onclick="Session.NewCharacter">+ Character</button><button @onclick="Session.SaveCharacter">Save</button>}else{<button @onclick="Session.EditCharacter">Edit</button>}<button @onclick="CloseSheet">×</button></div>
 <header class="console-identity">
  <div class="character-portrait">@if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="Character portrait"/>}else{<span>PORTRAIT</span>}@if(Session.CharacterEditMode){<label class="portrait-upload">Upload<InputFile OnChange="UploadPortrait" accept="image/*"/></label>}</div>
  <label>NAME<input @bind="Session.CharacterName" readonly="@(!Session.CharacterEditMode)"/></label><label>SPECIES<input @bind="Session.CharacterSpecies" readonly="@(!Session.CharacterEditMode)"/></label><label>AGE<input @bind="Session.CharacterAge" readonly="@(!Session.CharacterEditMode)"/></label><label>ALIGNMENT<input @bind="Session.CharacterAlignment" readonly="@(!Session.CharacterEditMode)"/></label>
 </header>

 <section class="console-bank attributes-bank"><div class="bank-title"><strong>ATTRIBUTES</strong><span>Signed values from −10 to +10</span></div><div class="character-finite-rail finite-rail"><div class="finite-set character-control-set">
 @foreach(var field in Session.CharacterFields.Where(WorldSession.IsAttributeField)){
  <article class="attribute-channel color-@field.Color" style="@ControlWidth(field.Name)">@if(Session.CharacterEditMode){<button class="remove-field" @onclick="()=>Session.RemoveCharacterField(field)">×</button>}<div class="attribute-scale"><span>+10</span><span>+5</span><span class="zero">0</span><span>−5</span><span>−10</span></div><input class="attribute-slider scarab-slider" type="range" min="-10" max="10" value="@Math.Clamp(field.Current,-10,10)" disabled="@(!Session.CharacterEditMode)" @oninput="e=>SetAttribute(field,e)"/><strong class="attribute-value">@(field.Current>0?"+":"")@field.Current</strong>@Plate(field)@EditControls(field)<button class="show-hand" disabled="@InHand(field)" @onclick="()=>Session.ShowFieldHand(field)">@(InHand(field)?"In Hand":"Card")</button></article>}
 @if(Session.CharacterEditMode){<button class="console-add physical-add" @onclick="()=>Session.AddCharacterControl("Attributes")">+</button>}
 </div></div></section>

 <section class="console-bank trackers-bank"><div class="bank-title"><strong>TRACKERS</strong><span>Current / Maximum • health • XP • durability • resources • saves • resistances</span></div><div class="character-finite-rail finite-rail"><div class="finite-set character-control-set">
 @foreach(var field in Session.CharacterFields.Where(WorldSession.IsTrackerField)){
  <article class="tracker-channel physical-channel color-@field.Color" style="@ControlWidth(field.Name)">@if(Session.CharacterEditMode){<button class="remove-field" @onclick="()=>Session.RemoveCharacterField(field)">×</button>}<div class="pool-scale">@foreach(var mark in ScaleLabels(field.Max)){<span>@mark</span>}</div><input class="pool-slider scarab-slider" type="range" min="0" max="@Math.Max(field.Max,1)" value="@field.Current" @oninput="e=>SetTrackerCurrent(field,e)"/><div class="track-values"><label><small>CURRENT</small><strong>@field.Current</strong></label><label><small>MAX</small>@if(Session.CharacterEditMode){<input type="number" min="1" max="999999" value="@field.Max" @onchange="e=>SetTrackerMax(field,e)"/>}else{<strong>@field.Max</strong>}</label></div>@Plate(field)@EditControls(field)<button class="show-hand" disabled="@InHand(field)" @onclick="()=>Session.ShowFieldHand(field)">@(InHand(field)?"In Hand":"Card")</button></article>}
 @if(Session.CharacterEditMode){<button class="console-add physical-add" @onclick="()=>Session.AddCharacterControl("Trackers")">+</button>}
 </div></div></section>

 <section class="console-bank limits-bank"><div class="bank-title"><strong>LIMITS</strong><span>Maximum bonus / cap knobs</span></div><div class="character-finite-rail finite-rail"><div class="finite-set character-control-set">
 @foreach(var field in Session.CharacterFields.Where(WorldSession.IsLimitField)){
  <article class="limit-channel physical-dial-card color-@field.Color" style="@DialWidth(field.Name)">@if(Session.CharacterEditMode){<button class="remove-field" @onclick="()=>Session.RemoveCharacterField(field)">×</button>}<div class="rotary-dial clean-dial"><button class="dial-step dial-minus" disabled="@(!Session.CharacterEditMode)" @onclick="()=>Session.SetLimitValue(field,field.Current-1)">−</button><div class="dial-center"><strong>@field.Current</strong></div><button class="dial-step dial-plus" disabled="@(!Session.CharacterEditMode)" @onclick="()=>Session.SetLimitValue(field,field.Current+1)">+</button></div><label class="limit-max"><small>MAX</small>@if(Session.CharacterEditMode){<input type="number" min="0" max="999999" value="@field.Max" @onchange="e=>SetLimitMax(field,e)"/>}else{<strong>@field.Max</strong>}</label>@Plate(field)@EditControls(field)<button class="show-hand" disabled="@InHand(field)" @onclick="()=>Session.ShowFieldHand(field)">@(InHand(field)?"In Hand":"Card")</button></article>}
 @if(Session.CharacterEditMode){<button class="console-add round-add physical-add" @onclick="()=>Session.AddCharacterControl("Limits")">+</button>}
 </div></div></section>

 <section class="console-bank skills-bank"><div class="bank-title"><strong>SKILLS</strong><button class="description-toggle" @onclick="()=>Session.ToggleSectionDescriptions("Skills")">Descriptions @(Session.ShowSkillDescriptions?"On":"Off")</button></div><div class="character-finite-rail finite-rail"><div class="finite-set character-control-set">
 @foreach(var field in Session.CharacterFields.Where(x=>x.Group=="Skills")){
  <article class="dial-channel physical-dial-card color-@field.Color" style="@DialWidth(field.Name)">@if(Session.CharacterEditMode){<button class="remove-field" @onclick="()=>Session.RemoveCharacterField(field)">×</button>}<div class="rotary-dial clean-dial">@if(Session.CharacterEditMode){<button class="dial-step dial-minus" @onclick="()=>Session.TurnCharacterDial(field,-1)">−</button>}<div class="dial-center">@if(Session.CharacterEditMode){<input type="number" value="@field.Current" @onchange="e=>SetCurrent(field,e)"/>}else{<span>@field.Current</span>}</div>@if(Session.CharacterEditMode){<button class="dial-step dial-plus" @onclick="()=>Session.TurnCharacterDial(field,1)">+</button>}</div>@Plate(field)@DescriptionEditor(field,Session.ShowSkillDescriptions)@EditControls(field)<button class="show-hand" disabled="@InHand(field)" @onclick="()=>Session.ShowFieldHand(field)">@(InHand(field)?"In Hand":"Card")</button></article>}
 @if(Session.CharacterEditMode){<button class="console-add round-add physical-add" @onclick="()=>Session.AddCharacterControl("Skills")">+</button>}
 </div></div></section>

 <section class="console-bank flare-bank"><div class="bank-title"><strong>FLARE</strong><span>Descriptive abilities, feats, boons, traits, powers, features</span><button class="description-toggle" @onclick="()=>Session.ToggleSectionDescriptions("Flare")">Descriptions @(Session.ShowFeatDescriptions?"On":"Off")</button></div><div class="character-finite-rail finite-rail"><div class="finite-set character-control-set feat-card-set">
 @foreach(var field in Session.CharacterFields.Where(WorldSession.IsFlareField)){
  <article class="sheet-card-frame color-@field.Color" style="@CardWidth(field.Name)">@if(Session.CharacterEditMode){<button class="remove-field" @onclick="()=>Session.RemoveCharacterField(field)">×</button>}<div class="sheet-card-name name-plate">@NameEditor(field)</div><div class="sheet-card-body"><div class="sheet-card-image">@if(!string.IsNullOrWhiteSpace(field.ImageDataUrl)){<img src="@field.ImageDataUrl" alt="@field.Name"/>}else{<span>+</span>}@if(Session.CharacterEditMode){<label><InputFile OnChange="e=>UploadFieldImage(field,e)" accept="image/*"/></label>}</div>@if(Session.ShowFeatDescriptions&&field.DescriptionEnabled){@if(Session.CharacterEditMode){<textarea class="sheet-card-description" value="@field.Description" @onchange="e=>SetDescription(field,e)" placeholder="Description…"></textarea>}else{<div class="sheet-card-description read-only">@field.Description</div>}}</div>@if(Session.CharacterEditMode){<label class="field-desc-toggle"><input type="checkbox" checked="@field.DescriptionEnabled" @onchange="e=>SetDescriptionEnabled(field,e)"/> Description</label>}<div class="sheet-card-footer"><button class="mini-bag card-bag" @onclick="()=>Session.EditFieldDiceBag(field)"><img src="assets/ui/custom_dicebag.png" alt="Dice bag"/><b>@field.DiceBag.Sum(x=>x.Count)</b></button><button class="show-hand" disabled="@InHand(field)" @onclick="()=>Session.ShowFieldHand(field)">@(InHand(field)?"In Hand":"Card")</button></div>@ColorControls(field)</article>}
 @if(Session.CharacterEditMode){<button class="console-add physical-add feat-add" @onclick="()=>Session.AddCharacterControl("Flare")">+</button>}
 </div></div></section>

 <section class="console-notebook"><nav class="notebook-tabs"><button class="@(Session.CharacterTab=="Description"?"active":"")" @onclick="()=>Session.SetCharacterTab("Description")">Description</button><button class="@(Session.CharacterTab=="Background"?"active":"")" @onclick="()=>Session.SetCharacterTab("Background")">Background</button></nav>@if(Session.CharacterTab=="Background"){<textarea @bind="Session.CharacterBackground" readonly="@(!Session.CharacterEditMode)" placeholder="Background…"></textarea>}else{<textarea @bind="Session.CharacterDescription" readonly="@(!Session.CharacterEditMode)" placeholder="Public description…"></textarea>}</section>
</section></div>
@if(Session.EditingDiceField is not null){var bagField=Session.EditingDiceField;<div class="dicebag-modal sheet-bag-modal" @onclick="Session.CloseFieldDiceBag"><section class="dicebag-workspace dicebag-form" @onclick:stopPropagation="true"><header class="dicebag-title"><div><strong>@bagField.Name</strong><span>Dice bag</span></div><button @onclick="Session.CloseFieldDiceBag">Close</button></header><div class="dicebag-form-grid">@foreach(var die in Session.DiceSet){<div class="dicebag-form-row"><strong>@die.Label</strong><button disabled="@(!Session.CharacterEditMode)" @onclick="()=>Session.AdjustDiceBag(bagField,die.Key,-1)">−</button><span>@Session.DiceBagCount(bagField,die.Key)</span><button disabled="@(!Session.CharacterEditMode)" @onclick="()=>Session.AdjustDiceBag(bagField,die.Key,1)">+</button>@if(die.Key is "d5-bonus" or "d5-penalty"){<select disabled="@(!Session.CharacterEditMode)" value="@Session.DiceBagMagnitude(bagField,die.Key)" @onchange="e=>SetBagMagnitude(bagField,die.Key,e)">@for(var i=1;i<=5;i++){<option value="@i">@(die.Key=="d5-bonus"?"+":"-")@i</option>}</select>}</div>}</div><footer class="dicebag-example"><button @onclick="()=>Session.ExampleDiceBagRoll(bagField)">Example Roll</button><output>@(Session.DiceBagExampleTotal?.ToString()??"—")</output></footer></section></div>}
}
@code{
 static readonly string[] Colors=["red","orange","gold","green","teal","blue","purple"];
 protected override void OnInitialized()=>Session.Changed+=SessionChanged; void SessionChanged()=>_ = InvokeAsync(StateHasChanged); public void Dispose()=>Session.Changed-=SessionChanged;
 void CloseSheet(){Session.CloseFieldDiceBag();Session.CloseMixer();} bool InHand(CharacterField f)=>Session.HandCards.Any(x=>ReferenceEquals(x.Field,f));
 RenderFragment NameEditor(CharacterField f)=>b=>{if(Session.CharacterEditMode){b.OpenElement(0,"input");b.AddAttribute(1,"size",InputSize(f.Name));b.AddAttribute(2,"value",f.Name);b.AddAttribute(3,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>Rename(f,e)));b.CloseElement();}else b.AddContent(4,f.Name);};
 RenderFragment Plate(CharacterField f)=>b=>{b.OpenElement(0,"div");b.AddAttribute(1,"class","plate-with-bag");b.OpenElement(2,"div");b.AddAttribute(3,"class","name-plate");b.AddContent(4,NameEditor(f));b.CloseElement();b.OpenElement(5,"button");b.AddAttribute(6,"class","mini-bag");b.AddAttribute(7,"onclick",EventCallback.Factory.Create(this,()=>Session.EditFieldDiceBag(f)));b.AddMarkupContent(8,$"<img src='assets/ui/custom_dicebag.png' alt='Dice bag'/><b>{f.DiceBag.Sum(x=>x.Count)}</b>");b.CloseElement();b.CloseElement();};
 RenderFragment ColorControls(CharacterField f)=>b=>{if(!Session.CharacterEditMode)return;b.OpenElement(0,"div");b.AddAttribute(1,"class","color-swatches");var i=2;foreach(var c in Colors){var color=c;b.OpenElement(i++,"button");b.AddAttribute(i++,"class",$"swatch swatch-{color} {(f.Color==color?"active":"")}");b.AddAttribute(i++,"onclick",EventCallback.Factory.Create(this,()=>Session.SetCharacterFieldColor(f,color)));b.CloseElement();}b.CloseElement();};
 RenderFragment EditControls(CharacterField f)=>b=>b.AddContent(0,ColorControls(f));
 RenderFragment DescriptionEditor(CharacterField f,bool visible)=>b=>{if(visible&&f.DescriptionEnabled){if(Session.CharacterEditMode){b.OpenElement(0,"textarea");b.AddAttribute(1,"class","field-description");b.AddAttribute(2,"value",f.Description);b.AddAttribute(3,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>SetDescription(f,e)));b.CloseElement();}else if(!string.IsNullOrWhiteSpace(f.Description)){b.OpenElement(4,"p");b.AddAttribute(5,"class","field-description-read");b.AddContent(6,f.Description);b.CloseElement();}}if(Session.CharacterEditMode){b.OpenElement(7,"label");b.AddAttribute(8,"class","field-desc-toggle");b.AddContent(9,"Description ");b.OpenElement(10,"input");b.AddAttribute(11,"type","checkbox");b.AddAttribute(12,"checked",f.DescriptionEnabled);b.AddAttribute(13,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>SetDescriptionEnabled(f,e)));b.CloseElement();b.CloseElement();}};
 void SetAttribute(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetAttribute(f,v);} void SetTrackerCurrent(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetTrackerCurrent(f,v);} void SetTrackerMax(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetTrackerMaximum(f,v);} void SetLimitMax(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetLimitMaximum(f,v);} void SetCurrent(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetCharacterField(f,v);} void Rename(CharacterField f,ChangeEventArgs e)=>Session.RenameCharacterField(f,e.Value?.ToString()??f.Name); void SetDescription(CharacterField f,ChangeEventArgs e)=>Session.SetFieldDescription(f,e.Value?.ToString()??""); void SetDescriptionEnabled(CharacterField f,ChangeEventArgs e)=>Session.SetFieldDescriptionEnabled(f,e.Value is bool b?b:string.Equals(e.Value?.ToString(),"true",StringComparison.OrdinalIgnoreCase)); void SetBagMagnitude(CharacterField f,string k,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetFieldDiceMagnitude(f,k,v);}
 int InputSize(string n)=>Math.Clamp((n?.Length??0)+2,6,28); string ControlWidth(string n)=>$"--control-width:{Math.Clamp(150+(n?.Length??0)*6,170,300)}px"; string DialWidth(string n)=>$"--control-width:{Math.Clamp(165+(n?.Length??0)*7,180,330)}px"; string CardWidth(string n)=>$"--card-width:{Math.Clamp(220+(n?.Length??0)*6,240,390)}px"; IEnumerable<int> ScaleLabels(int max){max=Math.Max(max,1);yield return max;yield return (int)Math.Round(max*.8);yield return (int)Math.Round(max*.6);yield return (int)Math.Round(max*.4);yield return (int)Math.Round(max*.2);yield return 0;}
 async Task UploadPortrait(InputFileChangeEventArgs e){var f=e.File;if(f is null)return;await using var s=f.OpenReadStream(5*1024*1024);using var m=new MemoryStream();await s.CopyToAsync(m);Session.SetCharacterPortrait($"data:{(string.IsNullOrWhiteSpace(f.ContentType)?"image/png":f.ContentType)};base64,{Convert.ToBase64String(m.ToArray())}");}
 async Task UploadFieldImage(CharacterField field,InputFileChangeEventArgs e){var f=e.File;if(f is null)return;await using var s=f.OpenReadStream(3*1024*1024);using var m=new MemoryStream();await s.CopyToAsync(m);Session.SetCharacterFieldImage(field,$"data:{(string.IsNullOrWhiteSpace(f.ContentType)?"image/png":f.ContentType)};base64,{Convert.ToBase64String(m.ToArray())}");}
}
