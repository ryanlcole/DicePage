@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IDisposable
@inject WorldSession Session
@inject IJSRuntime JS
@if(Session.MixerOpen)
{
<div class="mixer-modal" @onclick="CloseSheet">
<section class="character-mixer universal-sheet" data-board-static="true" @onclick:stopPropagation="true">
 <div class="exact-sheet-toolbar"><span>CHAR @Session.ActiveCharacterNumber / @Session.CharacterCount</span>@if(Session.CharacterEditMode){<button @onclick="Session.NewCharacter">New</button><button @onclick="Session.SaveCharacter">Save</button>}else{<button @onclick="Session.EditCharacter">Edit</button>}<button @onclick="CloseSheet">Close</button></div>
 <div class="exact-sheet-screen exact-@_sheetView.ToLowerInvariant()">
 <section class="identity-badge">
  <div class="exact-portrait character-portrait">@if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="Character portrait"/>}else{<span>Portrait</span>}@if(Session.CharacterEditMode){<label class="portrait-upload" aria-label="Edit portrait"><img src="assets/ui/character-sheet/portrait-edit-pencil.png" alt=""/><InputFile OnChange="LoadPortraitEditor" accept="image/*"/></label>}</div>
  <div class="identity-badge-fields"><input class="exact-name" aria-label="Character name" placeholder="Character name" @bind="Session.CharacterName" readonly="@(!Session.CharacterEditMode)"/><div class="identity-fields"><input aria-label="Species" placeholder="Species / ancestry" @bind="Session.CharacterSpecies" readonly="@(!Session.CharacterEditMode)"/><input aria-label="Age" placeholder="Age" @bind="Session.CharacterAge" readonly="@(!Session.CharacterEditMode)"/><input aria-label="Alignment" placeholder="Alignment / role" @bind="Session.CharacterAlignment" readonly="@(!Session.CharacterEditMode)"/></div></div>
 </section>
 @if(_sheetView=="Profile")
 {
  <section class='sheet-pane values-pane @PaneClass("values")'><header><button class="pane-toggle" @onclick='()=>TogglePane("values")'><h2>Values</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button>@if(Session.CharacterEditMode){<button @onclick="AddAttribute" aria-label="Add value">+</button>}</header><div class="pane-content exact-profile-values">@foreach(var field in Session.CharacterFields.Where(WorldSession.IsAttributeField).Take(6)){<button class="exact-value-card" @onclick="()=>OpenCardEditor(field)"><strong>@field.Name</strong><output>@field.Current</output><small>@field.Description</small></button>}</div></section>
  <section class='sheet-pane trackers-pane @PaneClass("trackers")'><header><button class="pane-toggle" @onclick='()=>TogglePane("trackers")'><h2>Trackers</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button>@if(Session.CharacterEditMode){<button @onclick="AddTracker" aria-label="Add tracker">+</button>}</header><div class="pane-content exact-profile-trackers">@foreach(var field in Session.CharacterFields.Where(WorldSession.IsTrackerField).Take(4)){<div><strong>@field.Name</strong><button disabled="@(!Session.CharacterEditMode)" @onclick="()=>Session.SetTrackerCurrent(field,field.Current-1)" aria-label="Decrease @field.Name">−</button><input aria-label="@field.Name" value="@field.Current" @onchange="e=>SetTrackerCurrent(field,e)"/><span>/ @field.Max</span><button disabled="@(!Session.CharacterEditMode)" @onclick="()=>Session.SetTrackerCurrent(field,field.Current+1)" aria-label="Increase @field.Name">+</button></div>}</div></section>
  <section class='sheet-pane profile-notes-pane @PaneClass("profile-notes")'><header><button class="pane-toggle" @onclick='()=>TogglePane("profile-notes")'><h2>Profile notes</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></header><textarea class="pane-content" aria-label="Character notes" placeholder="Campaign, ruleset, concept, biography, and reminders…" @bind="Session.CharacterDescription" readonly="@(!Session.CharacterEditMode)"></textarea></section>
 }
 else if(_sheetView is "Rules" or "Entries")
 {
  <section class='sheet-pane entries-pane @PaneClass("entries")'><header><button class="pane-toggle" @onclick='()=>TogglePane("entries")'><h2>Entries</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button>@if(Session.CharacterEditMode){<button @onclick="AddSkill">+</button>}</header><div class="pane-content exact-entry-scroll">@foreach(var field in Session.CharacterFields.Where(x=>x.Group=="Skills")){<button @onclick="()=>OpenCardEditor(field)"><strong>@field.Name</strong><small>@field.Description</small><output>@field.Current</output></button>}@if(Session.CharacterEditMode){<button class="exact-add-entry" @onclick="AddSkill">Add entry</button>}</div></section>
  <section class='sheet-pane notes-pane @PaneClass("notes")'><header><button class="pane-toggle" @onclick='()=>TogglePane("notes")'><h2>Notes &amp; records</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></header><textarea class="pane-content" @bind="Session.CharacterDescription" readonly="@(!Session.CharacterEditMode)" placeholder="Biography, journal, objectives, relationships, rules reminders…"></textarea></section>
  <section class='sheet-pane growth-pane @PaneClass("growth")'><header><button class="pane-toggle" @onclick='()=>TogglePane("growth")'><h2>Growth</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></header><textarea class="pane-content" @bind="Session.CharacterBackground" readonly="@(!Session.CharacterEditMode)" placeholder="Tier, milestones, advancement points, and growth history…"></textarea></section>
 }
 else if(_sheetView=="Equipment")
 {
  <section class='sheet-pane equipment-pane @PaneClass("equipment")'><header><button class="pane-toggle" @onclick='()=>TogglePane("equipment")'><h2>Equipment</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button>@if(Session.CharacterEditMode){<button @onclick="AddFlare">+</button>}</header><div class="pane-content exact-equipment-grid">@foreach(var field in Session.CharacterFields.Where(x=>x.Group is "Flare" or "Skills").Take(6)){<button @onclick="()=>OpenCardEditor(field)">@if(!string.IsNullOrWhiteSpace(field.ImageDataUrl)){<img src="@field.ImageDataUrl" alt=""/>}<strong>@field.Name</strong><small>@field.Subtitle</small></button>}</div></section>
  <section class='sheet-pane containers-pane @PaneClass("containers")'><header><button class="pane-toggle" @onclick='()=>TogglePane("containers")'><h2>Containers</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></header><div class="pane-content exact-container-rows">@foreach(var field in Session.CharacterFields.Where(x=>x.Group is "Flare" or "Skills").Skip(6).Take(5)){<button @onclick="()=>OpenCardEditor(field)"><strong>@field.Name</strong><small>@field.Subtitle</small></button>}@if(Session.CharacterEditMode){<button @onclick="AddFlare">Add container</button>}</div></section>
  <section class='sheet-pane equipment-notes-pane @PaneClass("equipment-notes")'><header><button class="pane-toggle" @onclick='()=>TogglePane("equipment-notes")'><h2>Inventory notes</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></header><textarea class="pane-content exact-equipment-notes" @bind="Session.CharacterBackground" readonly="@(!Session.CharacterEditMode)" aria-label="Equipment notes"></textarea></section>
 }
 else if(_sheetView=="Linked")
 {
  <section class='sheet-pane linked-pane @PaneClass("linked")'><header><button class="pane-toggle" @onclick='()=>TogglePane("linked")'><h2>Linked asset</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></header><div class="pane-content exact-linked-nodes">@foreach(var field in Session.CharacterFields.Where(WorldSession.IsTrackerField).Take(5)){<button @onclick="()=>OpenCardEditor(field)"><strong>@field.Name</strong><output>@field.Current / @field.Max</output></button>}</div></section>
  <section class='sheet-pane locations-pane @PaneClass("locations")'><header><button class="pane-toggle" @onclick='()=>TogglePane("locations")'><h2>Locations</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button>@if(Session.CharacterEditMode){<button @onclick="AddLimit">+</button>}</header><div class="pane-content exact-location-grid">@foreach(var field in Session.CharacterFields.Where(WorldSession.IsLimitField).Take(6)){<button @onclick="()=>OpenCardEditor(field)"><strong>@field.Name</strong><output>@field.Current</output></button>}</div></section>
  <section class='sheet-pane asset-notes-pane @PaneClass("asset-notes")'><header><button class="pane-toggle" @onclick='()=>TogglePane("asset-notes")'><h2>Damage &amp; conditions</h2><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></header><textarea class="pane-content" @bind="Session.CharacterBackground" readonly="@(!Session.CharacterEditMode)" placeholder="Components, damage, repair notes, transfer rules…"></textarea></section>
 }
 else
 {
  <textarea class="exact-notes-page" @bind="Session.CharacterDescription" readonly="@(!Session.CharacterEditMode)" aria-label="Character notes"></textarea>
 }
 <nav class="exact-page-arrows" aria-label="Character sheet pages"><button class="back" @onclick="PreviousSheet" aria-label="Previous character sheet page"><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button><button class="next" @onclick="NextSheet" aria-label="Next character sheet page"><img src="assets/ui/character-sheet/page-arrow.png" alt=""/></button></nav>
 </div>
</section></div>

@if(_nameplateField is not null)
{
 <div class="field-editor-modal" @onclick="CancelNameplate"><section class="field-editor nameplate-editor" style="@AccentStyle(_nameplateField)" @onclick:stopPropagation="true"><header><strong>Nameplate</strong><button @onclick="CancelNameplate">×</button></header><label>Full name<input class="keyboard-input" @bind="_nameplateName" readonly="@(!Session.CharacterEditMode)"/></label><label>3-letter code<div class="code-editor-row"><input class="keyboard-input short-code-input" maxlength="3" @bind="_nameplateCode" readonly="@(!Session.CharacterEditMode)"/><button disabled="@(!Session.CharacterEditMode)" @onclick="ResetNameplateCode">Auto</button></div></label><label>Description<textarea class="keyboard-input" @bind="_nameplateDescription" readonly="@(!Session.CharacterEditMode)" placeholder="Only shown in this popout…"></textarea></label><footer><button @onclick="CancelNameplate">Cancel</button><button class="primary" disabled="@(!Session.CharacterEditMode)" @onclick="ApplyNameplate">Apply</button></footer></section></div>
}

@if(_cardField is not null)
{
 <div class="field-editor-modal card-editor-modal" @onclick="CloseCardEditor"><section class="field-editor card-detail-editor" style="@AccentStyle(_cardField)" @onclick:stopPropagation="true"><header><div><strong>@_cardField.Name</strong><small>@_cardField.ShortName</small></div><button @onclick="CloseCardEditor">×</button></header><label>Subtitle<input class="keyboard-input" value="@_cardField.Subtitle" readonly="@(!Session.CharacterEditMode)" @oninput="e=>SetSubtitle(_cardField,e)" placeholder="Subtitle…"/></label><div class="card-editor-image">@if(!string.IsNullOrWhiteSpace(_cardField.ImageDataUrl)){<img src="@_cardField.ImageDataUrl" alt="@_cardField.Name"/>}else{<span>Landscape image</span>}@if(Session.CharacterEditMode){<label class="card-image-upload">+ Image<InputFile OnChange="e=>UploadFieldImage(_cardField,e)" accept="image/*"/></label>}</div><label>Description<textarea class="keyboard-input card-editor-description" value="@_cardField.Description" readonly="@(!Session.CharacterEditMode)" @oninput="e=>SetDescription(_cardField,e)" placeholder="Card description…"></textarea></label>@if(WorldSession.IsAttributeField(_cardField)){<div class="card-attribute-summary"><span class="score-box">Score <b>@_cardField.BaseValue</b></span><div class="mod-dice-preview">@ModDice(_cardField)</div></div>}<footer><button class="dicebag-button" @onclick="()=>OpenDiceBag(_cardField)"><img src="assets/ui/custom_dicebag.png" alt="Dice bag"/><span class="bag-count">@EditableBagCount(_cardField)</span></button><button class="primary" disabled="@InHand(_cardField)" @onclick="()=>AddCardToHand(_cardField)">@(InHand(_cardField)?"In Hand":"Add to Hand")</button></footer></section></div>
}

@if(_portraitEditing)
{
 <div class="portrait-editor-modal" @onclick="CancelPortrait"><section class="portrait-editor" @onclick:stopPropagation="true"><header><strong>Edit portrait</strong><button @onclick="CancelPortrait">×</button></header><div class="portrait-crop"><img src="@_portraitSource" style="transform:translate(calc((@_portraitX - 50)*1%),calc((@_portraitY - 50)*1%)) scale(@_portraitZoom)" alt="Portrait preview"/></div><label>Zoom<input type="range" min="1" max="3" step="0.05" @bind="_portraitZoom" @bind:event="oninput"/></label><label>Horizontal<input type="range" min="0" max="100" step="1" @bind="_portraitX" @bind:event="oninput"/></label><label>Vertical<input type="range" min="0" max="100" step="1" @bind="_portraitY" @bind:event="oninput"/></label><footer><button @onclick="CancelPortrait">Cancel</button><button class="primary" @onclick="ApplyPortrait">Apply</button></footer></section></div>
}

@if(Session.EditingDiceField is not null)
{
 var bagField=Session.EditingDiceField;
 <div class="dicebag-modal sheet-bag-modal" @onclick="Session.CloseFieldDiceBag"><section class="dicebag-workspace dicebag-form" @onclick:stopPropagation="true"><header class="dicebag-title"><div><strong>@bagField.Name</strong><span>Dice bag • modifier dice are locked to the card</span></div><button @onclick="Session.CloseFieldDiceBag">Close</button></header><div class="dicebag-form-grid">@foreach(var die in EditableDiceSet(bagField)){<div class="dicebag-form-row"><strong>@die.Label</strong><button class="tap-safe" @onclick="()=>Session.AdjustDiceBag(bagField,die.Key,-1)">−</button><input class="bag-count-input" type="number" min="0" max="20" value="@Session.DiceBagCount(bagField,die.Key)" @onchange="e=>SetBagCount(bagField,die.Key,e)"/><button class="tap-safe" @onclick="()=>Session.AdjustDiceBag(bagField,die.Key,1)">+</button></div>}</div><footer class="dicebag-example"><button @onclick="()=>Session.ExampleDiceBagRoll(bagField)">Example Roll</button><output>@(Session.DiceBagExampleTotal?.ToString()??"—")</output></footer></section></div>
}
}
@code{
 static readonly (string Name,string Hex)[] Colors=[("red","#c7493a"),("orange","#e9852c"),("gold","#d9a82f"),("yellow","#f0d85c"),("lime","#9bc84a"),("green","#58a765"),("teal","#41aaa4"),("cyan","#55c7dc"),("blue","#4c82d5"),("indigo","#6559c7"),("purple","#9653c9"),("magenta","#cf59ad"),("rose","#d16d7f"),("silver","#b8bdc4"),("white","#eee6d2")];
 static readonly string[] SheetViews=["Profile","Entries","Equipment","Linked"];
 readonly HashSet<string> _collapsedPanes=[];
 string _portraitSource=""; bool _portraitEditing; double _portraitZoom=1; int _portraitX=50; int _portraitY=50; string _sheetView="Profile";
 CharacterField? _nameplateField; CharacterField? _cardField; string _nameplateName=""; string _nameplateCode=""; string _nameplateDescription="";
 protected override void OnInitialized()=>Session.Changed+=SessionChanged; void SessionChanged()=>_ = InvokeAsync(StateHasChanged); public void Dispose()=>Session.Changed-=SessionChanged;
 void CloseSheet(){Session.CloseFieldDiceBag();_nameplateField=null;_cardField=null;Session.CloseMixer();} bool InHand(CharacterField f)=>Session.IsFieldInHand(f);
 void SetView(string view)=>_sheetView=view; string ViewClass(string view)=>_sheetView==view?"active":"";
 void GoProfile()=>SetView("Profile"); void GoRules()=>SetView("Rules"); void GoEntries()=>SetView("Entries"); void GoEquipment()=>SetView("Equipment"); void GoLinked()=>SetView("Linked"); void GoNotes()=>SetView("Notes");
 void StepSheet(int delta){var index=Array.IndexOf(SheetViews,_sheetView);if(index<0)index=0;_sheetView=SheetViews[(index+delta+SheetViews.Length)%SheetViews.Length];}
 void PreviousSheet()=>StepSheet(-1); void NextSheet()=>StepSheet(1);
 void TogglePane(string pane){if(!_collapsedPanes.Add(pane))_collapsedPanes.Remove(pane);} string PaneClass(string pane)=>_collapsedPanes.Contains(pane)?"is-collapsed":"";
 void AddAttribute()=>Session.AddCharacterControl("Attributes"); void AddTracker()=>Session.AddCharacterControl("Trackers"); void AddLimit()=>Session.AddCharacterControl("Limits"); void AddSkill()=>Session.AddCharacterControl("Skills"); void AddFlare()=>Session.AddCharacterControl("Flare"); void ToggleSkillDescriptions()=>Session.ToggleSectionDescriptions("Skills"); void ShowDescription()=>Session.SetCharacterTab("Description"); void ShowBackground()=>Session.SetCharacterTab("Background"); void ShowFeats()=>Session.SetCharacterTab("Feats");
 void OpenNameplate(CharacterField f){_nameplateField=f;_nameplateName=f.Name;_nameplateCode=string.IsNullOrWhiteSpace(f.ShortName)?CharacterField.AutoShortName(f.Name):f.ShortName;_nameplateDescription=f.NameplateDescription;}
 void CancelNameplate()=>_nameplateField=null;
 void ResetNameplateCode(){if(_nameplateField is null)return;_nameplateCode=CharacterField.AutoShortName(_nameplateName);}
 void ApplyNameplate(){if(_nameplateField is null||!Session.CharacterEditMode)return;Session.RenameCharacterField(_nameplateField,_nameplateName);if(string.IsNullOrWhiteSpace(_nameplateCode))Session.ResetFieldShortName(_nameplateField);else Session.SetFieldShortName(_nameplateField,_nameplateCode);Session.SetFieldNameplateDescription(_nameplateField,_nameplateDescription);_nameplateField=null;}
 void OpenCardEditor(CharacterField f)=>_cardField=f; void CloseCardEditor()=>_cardField=null; void AddCardToHand(CharacterField f){Session.ShowFieldHand(f);}
 void OpenDiceBag(CharacterField f){if(WorldSession.IsAttributeField(f))f.DiceBag.RemoveAll(x=>x.DieKey is "d5-bonus" or "d5-penalty");Session.EditFieldDiceBag(f);}
 RenderFragment Plate(CharacterField f,bool attribute)=>b=>{var seq=0;b.OpenElement(seq++,"div");b.AddAttribute(seq++,"class",$"compact-field-control {(attribute?"attribute-compact":"")}");b.OpenElement(seq++,"div");b.AddAttribute(seq++,"class","control-identity-row");if(attribute){b.OpenElement(seq++,"label");b.AddAttribute(seq++,"class","score-box");b.AddMarkupContent(seq++,"<small>SCORE</small>");if(Session.CharacterEditMode){b.OpenElement(seq++,"input");b.AddAttribute(seq++,"type","number");b.AddAttribute(seq++,"value",f.BaseValue);b.AddAttribute(seq++,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>SetAttributeBase(f,e)));b.CloseElement();}else{b.OpenElement(seq++,"b");b.AddContent(seq++,f.BaseValue);b.CloseElement();}b.CloseElement();}b.OpenElement(seq++,"button");b.AddAttribute(seq++,"class","nameplate-code-button");b.AddAttribute(seq++,"title",string.IsNullOrWhiteSpace(f.NameplateDescription)?f.Name:f.NameplateDescription);b.AddAttribute(seq++,"onclick",EventCallback.Factory.Create(this,()=>OpenNameplate(f)));b.AddContent(seq++,string.IsNullOrWhiteSpace(f.ShortName)?CharacterField.AutoShortName(f.Name):f.ShortName);b.CloseElement();if(attribute)b.AddContent(seq++,ModDice(f));b.CloseElement();b.OpenElement(seq++,"div");b.AddAttribute(seq++,"class","control-tools-row");b.AddContent(seq++,DiceBagSummary(f));b.OpenElement(seq++,"button");b.AddAttribute(seq++,"class","mini-bag compact-bag");b.AddAttribute(seq++,"onclick",EventCallback.Factory.Create(this,()=>OpenDiceBag(f)));b.AddMarkupContent(seq++,$"<img src='assets/ui/custom_dicebag.png' alt='Dice bag'/><b>{EditableBagCount(f)}</b>");b.CloseElement();b.OpenElement(seq++,"button");b.AddAttribute(seq++,"class","compact-card-back");b.AddAttribute(seq++,"aria-label","Open card");b.AddAttribute(seq++,"title","Open card");b.AddAttribute(seq++,"onclick",EventCallback.Factory.Create(this,()=>OpenCardEditor(f)));b.CloseElement();b.CloseElement();b.CloseElement();};
 RenderFragment ModDice(CharacterField f)=>b=>{var parts=ModifierDice(f.Current);b.OpenElement(0,"div");b.AddAttribute(1,"class","mod-dice-set");if(parts.Count==0){b.OpenElement(2,"span");b.AddAttribute(3,"class","mod-die-empty");b.AddContent(4,"0");b.CloseElement();}else{var s=5;foreach(var p in parts){var positive=p>0;var die=Session.DiceSet.FirstOrDefault(x=>x.Key==(positive?"d5-bonus":"d5-penalty"));b.OpenElement(s++,"span");b.AddAttribute(s++,"class",$"mod-die-chip {(positive?"bonus":"penalty")}");if(die is not null){b.OpenElement(s++,"span");b.AddAttribute(s++,"class",$"die-sprite die-{die.Key}");b.AddAttribute(s++,"style",DieSpriteStyle(die,die.RestFrame));b.CloseElement();}b.OpenElement(s++,"b");b.AddContent(s++,$"{(p>0?"+":"")}{p}");b.CloseElement();b.CloseElement();}}b.CloseElement();};
 RenderFragment DiceBagSummary(CharacterField f)=>b=>{b.OpenElement(0,"div");b.AddAttribute(1,"class","bag-dice-row");var s=2;foreach(var entry in f.DiceBag.Where(x=>x.DieKey is not "d5-bonus" and not "d5-penalty")){var die=Session.DiceSet.FirstOrDefault(x=>x.Key==entry.DieKey);if(die is null)continue;b.OpenElement(s++,"span");b.AddAttribute(s++,"class","bag-die-token");b.OpenElement(s++,"span");b.AddAttribute(s++,"class",$"die-sprite die-{die.Key}");b.AddAttribute(s++,"style",DieSpriteStyle(die,die.RestFrame));b.CloseElement();b.OpenElement(s++,"small");b.AddContent(s++,$"×{entry.Count}");b.CloseElement();b.CloseElement();}b.CloseElement();};
 RenderFragment ColorControls(CharacterField f)=>b=>{if(!Session.CharacterEditMode)return;b.OpenElement(0,"div");b.AddAttribute(1,"class","color-swatches expanded-colors");var i=2;foreach(var c in Colors){var color=c;b.OpenElement(i++,"button");b.AddAttribute(i++,"class",$"swatch {(f.Color==color.Name?"active":"")}");b.AddAttribute(i++,"style",$"--swatch:{color.Hex}");b.AddAttribute(i++,"title",color.Name);b.AddAttribute(i++,"onclick",EventCallback.Factory.Create(this,()=>Session.SetCharacterFieldColor(f,color.Name)));b.CloseElement();}b.CloseElement();};
 void SetAttribute(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetAttribute(f,v);} void SetAttributeBase(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetAttributeBase(f,v);} void SetTrackerCurrent(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetTrackerCurrent(f,v);} void SetTrackerMax(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetTrackerMaximum(f,v);} void SetLimitMax(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetLimitMaximum(f,v);} void SetLimitValue(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetLimitValue(f,v);} void SetCurrent(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetCharacterField(f,v);} void SetDescription(CharacterField f,ChangeEventArgs e)=>Session.SetFieldDescription(f,e.Value?.ToString()??""); void SetSubtitle(CharacterField f,ChangeEventArgs e)=>Session.SetFieldSubtitle(f,e.Value?.ToString()??""); void SetBagCount(CharacterField f,string k,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetDiceBagCount(f,k,v);}
 double AttributePct(CharacterField f)=>Math.Clamp((f.Current+10)*5.0,0,100); double TrackerPct(CharacterField f)=>Math.Clamp(100.0*f.Current/Math.Max(f.Max,1),0,100);
 string ControlStyle(CharacterField f)=>$"--control-width:{Math.Clamp(190+(f.ShortName?.Length??3)*5,220,340)}px;--field-accent:{AccentHex(f.Color)}"; string AccentStyle(CharacterField f)=>$"--field-accent:{AccentHex(f.Color)}"; string AccentHex(string name)=>Colors.FirstOrDefault(x=>x.Name==name).Hex??"#d9a82f";
 int EditableBagCount(CharacterField f)=>f.DiceBag.Where(x=>x.DieKey is not "d5-bonus" and not "d5-penalty").Sum(x=>x.Count); IEnumerable<DiceSpec> EditableDiceSet(CharacterField f)=>Session.DiceSet.Where(x=>!WorldSession.IsAttributeField(f)||x.Key is not "d5-bonus" and not "d5-penalty");
 List<int> ModifierDice(int modifier){var result=new List<int>();var sign=Math.Sign(modifier);var remaining=Math.Abs(Math.Clamp(modifier,-10,10));while(remaining>0){var value=Math.Min(5,remaining);result.Add(sign*value);remaining-=value;}return result;}
 static string DieSpriteStyle(DiceSpec die,int frame){var col=frame%die.Columns;var row=frame/die.Columns;var x=die.Columns<=1?0:col*100.0/(die.Columns-1);var y=die.Rows<=1?0:row*100.0/(die.Rows-1);return $"--die-aspect:{die.VisualAspect};background-image:url('{die.Image}');background-size:{die.Columns*100}% {die.Rows*100}%;background-position:{x:0.###}% {y:0.###}%";}
 IEnumerable<int> ScaleLabels(int max){max=Math.Max(max,1);yield return max;yield return (int)Math.Round(max*.8);yield return (int)Math.Round(max*.6);yield return (int)Math.Round(max*.4);yield return (int)Math.Round(max*.2);yield return 0;}
 async Task LoadPortraitEditor(InputFileChangeEventArgs e){var f=e.File;if(f is null)return;await using var s=f.OpenReadStream(8*1024*1024);using var m=new MemoryStream();await s.CopyToAsync(m);_portraitSource=$"data:{(string.IsNullOrWhiteSpace(f.ContentType)?"image/png":f.ContentType)};base64,{Convert.ToBase64String(m.ToArray())}";_portraitZoom=1;_portraitX=50;_portraitY=50;_portraitEditing=true;}
 void CancelPortrait(){_portraitEditing=false;_portraitSource="";}
 async Task ApplyPortrait(){if(string.IsNullOrWhiteSpace(_portraitSource))return;var result=await JS.InvokeAsync<string>("ristCropPortrait",_portraitSource,_portraitZoom,_portraitX,_portraitY,512);Session.SetCharacterPortrait(result);CancelPortrait();}
 async Task UploadFieldImage(CharacterField field,InputFileChangeEventArgs e){var f=e.File;if(f is null)return;await using var s=f.OpenReadStream(3*1024*1024);using var m=new MemoryStream();await s.CopyToAsync(m);Session.SetCharacterFieldImage(field,$"data:{(string.IsNullOrWhiteSpace(f.ContentType)?"image/png":f.ContentType)};base64,{Convert.ToBase64String(m.ToArray())}");}
}
