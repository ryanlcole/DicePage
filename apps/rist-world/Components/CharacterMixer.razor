@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IDisposable
@inject WorldSession Session
@inject PrivateCardLibrary Library
@inject IJSRuntime JS

@if (Session.MixerOpen)
{
    <div class="native-character-modal" role="dialog" aria-modal="true" aria-label="Universal character sheet" @onclick="CloseSheet">
        <section class="native-character-sheet reference-character-sheet" @onclick:stopPropagation="true">
            <div class="reference-artboard @PageArtClass()">
                <header class="reference-sheet-controls">
                    <button class="sheet-back" type="button" @onclick="PreviousPage" aria-label="Previous page"></button>
                    <div class="sheet-title-control">
                        <input @bind="Session.CharacterName" readonly="@(!Session.CharacterEditMode)" aria-label="Character name" />
                    </div>
                    @if (_page == 0)
                    {
                        <button class="sheet-appearance" type="button" @onclick="OpenAppearance" aria-label="Card appearance"></button>
                    }
                    else
                    {
                        <button class="sheet-add" type="button" @onclick="AddForPage" aria-label="Add item"></button>
                    }
                    <button class="sheet-close" type="button" @onclick="CloseSheet" aria-label="Close character sheet"></button>
                </header>

                @if (_page == 0)
                {
                    <button type="button" class="reference-portrait" @onclick="OpenPortraitEditor" aria-label="Edit portrait">
                        @if (!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl))
                        {
                            <img src="@Session.CharacterPortraitDataUrl" alt="Character portrait" />
                        }
                        <span class="portrait-pencil" aria-hidden="true"></span>
                    </button>
                    <input class="profile-name" @bind="Session.CharacterName" readonly="@(!Session.CharacterEditMode)" placeholder="Character name" aria-label="Character name" />
                    <input class="profile-concept" @bind="Session.CharacterBackground" readonly="@(!Session.CharacterEditMode)" placeholder="Identity / concept" aria-label="Identity or concept" />
                    <textarea class="profile-description" @bind="Session.CharacterDescription" readonly="@(!Session.CharacterEditMode)" placeholder="Description" aria-label="Description"></textarea>

                    <div class="profile-value-tiles" aria-label="Values">
                        @foreach (var field in Session.CharacterFields.Where(WorldSession.IsAttributeField).Take(6))
                        {
                            <article class="reference-value-tile">
                                <input class="tile-label" value="@field.Name" readonly="@(!Session.CharacterEditMode)" @onchange="e => RenameValueField(field,e)" placeholder="Name" aria-label="Value name" />
                                <input class="tile-number" type="number" value="@field.Current" readonly="@(!Session.CharacterEditMode)" @onchange="e => SetAttribute(field,e)" placeholder="Value" aria-label="@field.Name value" />
                                <div class="tile-circle-row" aria-label="@field.Name details">
                                    <input class="tile-circle-text" type="number" value="@field.BaseValue" readonly="@(!Session.CharacterEditMode)" @onchange="e => SetAttributeBase(field,e)" placeholder="Base" title="Base value" aria-label="@field.Name base value" />
                                    <input class="tile-circle-text" type="text" value="@field.ShortName" readonly="@(!Session.CharacterEditMode)" @onchange="e => SetShortName(field,e)" maxlength="3" placeholder="ID" title="Short name" aria-label="@field.Name short name" />
                                    <input class="tile-circle-text" type="number" value="@field.Max" readonly="@(!Session.CharacterEditMode)" @onchange="e => SetAttributeMax(field,e)" placeholder="Max" title="Maximum" aria-label="@field.Name maximum" />
                                </div>
                            </article>
                        }
                    </div>
                    <div class="profile-trackers" aria-label="Trackers">
                        @foreach (var field in Session.CharacterFields.Where(WorldSession.IsTrackerField).Take(2))
                        {
                            <div class="reference-tracker">
                                <button type="button" @onclick="() => StepTracker(field,-1)" aria-label="Decrease @field.Name"></button>
                                <output>@field.Name · @field.Current / @field.Max</output>
                                <button type="button" @onclick="() => StepTracker(field,1)" aria-label="Increase @field.Name"></button>
                            </div>
                        }
                    </div>
                }
                else if (_page is 1 or 2)
                {
                    <input class="entries-title" value="@(_page == 1 ? "Values & Trackers" : "Entries")" readonly aria-label="Page title" />
                    <div class="entries-overlay">
                        @if (_page == 1)
                        {
                            @foreach (var field in Session.CharacterFields.Where(f => WorldSession.IsAttributeField(f) || WorldSession.IsTrackerField(f)).Take(8))
                            {
                                <article class="reference-entry-tile">
                                    <strong>@field.Name</strong>
                                    @if (WorldSession.IsTrackerField(field))
                                    {
                                        <input type="number" value="@field.Current" readonly="@(!Session.CharacterEditMode)" @onchange="e => SetTracker(field,e)" />
                                    }
                                    else
                                    {
                                        <input type="number" value="@field.Current" readonly="@(!Session.CharacterEditMode)" @onchange="e => SetAttribute(field,e)" />
                                    }
                                </article>
                            }
                        }
                        else
                        {
                            @foreach (var field in Session.CharacterFields.Where(WorldSession.IsFlareField).Take(8))
                            {
                                <article class="reference-entry-tile">
                                    <strong>@field.Name</strong><p>@field.Description</p>
                                </article>
                            }
                        }
                    </div>
                    <textarea class="entries-notes" @bind="Session.CharacterNotes" readonly="@(!Session.CharacterEditMode)" placeholder="Rules, abilities, languages, feats, records, and notes" aria-label="Page notes"></textarea>
                }
                else if (_page == 3)
                {
                    <input class="equipment-title" value="Equipment & Anatomy" readonly aria-label="Page title" />
                    <textarea class="equipment-slots-text" @bind="Session.CharacterEquipment" readonly="@(!Session.CharacterEditMode)" placeholder="Equipment, armor, weapons, carried items and containers" aria-label="Equipment"></textarea>
                    <textarea class="equipment-anatomy" @bind="Session.CharacterAnatomy" readonly="@(!Session.CharacterEditMode)" placeholder="Anatomy, body configuration, adaptations and movement" aria-label="Anatomy"></textarea>
                    <textarea class="equipment-notes" @bind="Session.CharacterConditions" readonly="@(!Session.CharacterEditMode)" placeholder="Conditions, damage and notes" aria-label="Conditions"></textarea>
                }
                else
                {
                    <input class="linked-title" value="Linked Cards & Assets" readonly aria-label="Page title" />
                    <section class="linked-card-overlay" @ondragover:preventDefault="true" @ondrop="Library.DropOnSpellbookAsync">
                        @foreach (var card in Library.SpellbookCards.Take(6))
                        {
                            <article><strong>@card.Name</strong><small>@card.Type</small></article>
                        }
                    </section>
                    <textarea class="linked-notes" @bind="Session.CharacterLinkedNotes" readonly="@(!Session.CharacterEditMode)" placeholder="Linked locations, companions, vehicles, cards and campaign references" aria-label="Linked notes"></textarea>
                }

                <nav class="reference-bottom-nav" aria-label="Character sheet pages">
                    @for (var i=0;i<PageLabels.Length;i++)
                    {
                        var index=i;
                        <button type="button" class="@(index==_page?"active":"")" @onclick="() => SelectPage(index)" aria-label="@PageLabels[index]" title="@PageLabels[index]"></button>
                    }
                </nav>
            </div>
        </section>
    </div>
}

@if (_portraitEditing)
{
    <div class="portrait-editor-modal" role="dialog" aria-modal="true" @onclick="CancelPortrait">
        <section class="portrait-editor" @onclick:stopPropagation="true">
            <header><strong>Edit portrait</strong><button @onclick="CancelPortrait" aria-label="Close">×</button></header>
            <div id="portrait-art-target" class="portrait-upload-area portrait-icon-actions">
                <label class="portrait-attachment-icon" title="Attach portrait image" aria-label="Attach portrait image">
                    <span aria-hidden="true">📎</span>
                    <InputFile OnChange="LoadPortraitEditor" accept="image/png,image/jpeg,image/webp" />
                </label>
                <button type="button" class="portrait-draw portrait-paint-icon" @onclick="OpenDrawPaint" title="Draw or paint portrait" aria-label="Draw or paint portrait"><span aria-hidden="true">🎨</span></button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_portraitSource))
            {
                <div class="portrait-editor-controls">
                    <div class="portrait-crop"><img src="@_portraitSource" alt="Portrait preview" style="transform:scale(@_portraitZoom);object-position:@_portraitX% @_portraitY%;" /></div>
                    <div class="portrait-adjustments">
                        <label>Zoom <input type="range" min="1" max="3" step="0.05" @bind="_portraitZoom" /></label>
                        <label>Left / right <input type="range" min="0" max="100" @bind="_portraitX" /></label>
                        <label>Up / down <input type="range" min="0" max="100" @bind="_portraitY" /></label>
                    </div>
                </div>
            }
            <footer>
                <button @onclick="CancelPortrait">Cancel</button>
                @if (!string.IsNullOrWhiteSpace(_portraitSource)) { <button class="primary" @onclick="ApplyPortrait">Apply</button> }
            </footer>
        </section>
    </div>
}

@code {
    static readonly string[] PageLabels=["Profile","Values","Entries","Equipment","Linked"];
    int _page;
    bool _portraitEditing;
    string _portraitSource="";
    double _portraitZoom=1;
    int _portraitX=50;
    int _portraitY=50;

    protected override void OnInitialized(){Session.EnsureCharacterSheetFields();Session.Changed+=SessionChanged;}
    protected override async Task OnParametersSetAsync(){if(Session.MixerOpen&&Session.IsLoggedIn)await Library.EnsureLoadedAsync();}
    void SessionChanged()=>_=InvokeAsync(StateHasChanged);
    public void Dispose()=>Session.Changed-=SessionChanged;
    void CloseSheet(){Session.CloseFieldDiceBag();Session.CloseMixer();}
    void SelectPage(int index)=>_page=Math.Clamp(index,0,PageLabels.Length-1);
    void PreviousPage()=>SelectPage((_page+PageLabels.Length-1)%PageLabels.Length);
    string PageArtClass()=>_page switch{0=>"profile-reference-art",1 or 2=>"entries-reference-art",3=>"equipment-reference-art",_=>"linked-reference-art"};
    void AddForPage(){if(!Session.CharacterEditMode)return;if(_page==1){Session.AddCharacterControl("Attributes");return;}if(_page==2){Session.AddCharacterControl("Flare");return;}}
    async Task OpenAppearance()=>await JS.InvokeVoidAsync("RistCardAppearance.open");
    async Task OpenDrawPaint()=>await JS.InvokeVoidAsync("ristOpenPortraitArtStudio");
    void OpenPortraitEditor(){if(!Session.CharacterEditMode)return;_portraitSource="";_portraitZoom=1;_portraitX=50;_portraitY=50;_portraitEditing=true;}
    async Task LoadPortraitEditor(InputFileChangeEventArgs e){var f=e.File;if(f is null)return;await using var s=f.OpenReadStream(8*1024*1024);using var m=new MemoryStream();await s.CopyToAsync(m);_portraitSource=$"data:{f.ContentType};base64,{Convert.ToBase64String(m.ToArray())}";}
    void CancelPortrait(){_portraitEditing=false;_portraitSource="";}
    async Task ApplyPortrait(){if(string.IsNullOrWhiteSpace(_portraitSource))return;var result=await JS.InvokeAsync<string>("ristCropPortrait",_portraitSource,_portraitZoom,_portraitX,_portraitY,512);Session.SetCharacterPortrait(result);CancelPortrait();}
    void RenameValueField(CharacterField f,ChangeEventArgs e)=>Session.RenameCharacterField(f,e.Value?.ToString()??"");
    void SetAttribute(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetAttribute(f,v);}
    void SetAttributeBase(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetAttributeBase(f,v);}
    void SetAttributeMax(CharacterField f,ChangeEventArgs e){if(!Session.CharacterEditMode)return;if(int.TryParse(e.Value?.ToString(),out var v)){f.Max=Math.Clamp(v,0,999999);Session.Notify();}}
    void SetShortName(CharacterField f,ChangeEventArgs e)=>Session.SetFieldShortName(f,e.Value?.ToString()??"");
    void SetTracker(CharacterField f,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var v))Session.SetTrackerCurrent(f,v);}
    void StepTracker(CharacterField f,int delta)=>Session.SetTrackerCurrent(f,Math.Clamp(f.Current+delta,0,Math.Max(f.Max,0)));
}
