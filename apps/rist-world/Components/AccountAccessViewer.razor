@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth

@if(Session.AccountViewerOpen && !Session.IsLoggedIn)
{
 <section class="map-account-viewer" role="dialog" aria-modal="false" aria-label="Sign up or log in">
  <header class="map-viewer-header"><strong>RIST Account</strong><button type="button" class="map-viewer-close" @onclick="Session.CloseAccountViewer" aria-label="Close account viewer">×</button></header>
  <div class="map-account-body">
   <section class="map-account-card">
    <nav class="map-auth-tabs" role="tablist" aria-label="Account access">
     <button type="button" class="@(_mode=="signup"?"active":"")" @onclick="ShowSignup">Sign Up</button>
     <button type="button" class="@(_mode=="login"?"active":"")" @onclick="ShowLogin">Log In</button>
    </nav>
    @if(!string.IsNullOrWhiteSpace(Auth.LastError))
    {
     <p class="storage-status" role="alert">@Auth.LastError</p>
    }
    @if(_mode=="signup")
    {
     <div class="map-auth-form">
      <h2>Create your RIST account</h2>
      <label><span>Player alias</span><input maxlength="32" autocomplete="nickname" @bind="Session.PendingPlayerAlias" placeholder="Name other players will see" /></label>
      <fieldset class="map-plan-picker"><legend>Choose your intended plan</legend>
       <button type="button" class="@(Session.PendingPlan=="player"?"selected":"")" @onclick="SelectPlayerPlan"><strong>Player</strong><span>$5 / month</span></button>
       <button type="button" class="@(Session.PendingPlan=="gm-player"?"selected":"")" @onclick="SelectGmPlayerPlan"><strong>GM + Player</strong><span>$15 / month</span></button>
      </fieldset>
      <p class="map-chat-empty">Discord verifies and reconnects your RIST account. Membership payment is not collected during sign-up.</p>
      <label class="map-terms"><input type="checkbox" @bind="Session.PendingTermsAccepted" /><span>I agree to the <a href="terms.html" target="_blank" rel="noopener">Terms</a> and <a href="privacy.html" target="_blank" rel="noopener">Privacy Policy</a>.</span></label>
      <button class="discord-login-primary" @onclick="Session.BeginAccountSignupAsync" disabled="@(!CanSignup)">Sign up with Discord</button>
     </div>
    }
    else
    {
     <div class="map-auth-form map-login-form">
      <h2>Welcome back</h2>
      <p>Use the Discord account already connected to your RIST profile.</p>
      <button class="discord-login-primary" @onclick="Session.BeginAccountLoginAsync">Log in with Discord</button>
     </div>
    }
    <div class="map-auth-form">
     <p class="map-chat-empty">Want to support RIST development separately? PayPal donations are voluntary and do not activate or renew a membership plan.</p>
     <a class="discord-login-primary" href="https://www.paypal.com/donate/?hosted_button_id=J7TNXEDSK9WYN" target="_blank" rel="noopener noreferrer">Support RIST with PayPal</a>
    </div>
   </section>

   <section class="map-chat-output" aria-label="Chat output" aria-live="polite">
    <header><strong>Chat</strong><div class="chat-playback-controls"><button type="button" @onclick="Next">Next</button><button type="button" class="@(_auto?"active":"")" @onclick="ToggleAuto">Auto</button><label><span>Delay</span><select value="@_delaySeconds" @onchange="DelayChanged"><option value="2">2 sec</option><option value="3">3 sec</option><option value="5">5 sec</option><option value="8">8 sec</option><option value="10">10 sec</option></select></label></div></header>
    <div class="map-chat-slide">
     @if(Session.DialogueOpen || !string.IsNullOrWhiteSpace(Session.DialogueText))
     {
      <article><strong>@Session.DialogueSpeaker</strong><p>@Session.DialogueText</p></article>
     }
     else
     {
      <p class="map-chat-empty">Chat output will appear here.</p>
     }
    </div>
   </section>
  </div>
 </section>
}

@code{
 string _mode="signup";
 bool _auto;
 int _delaySeconds=5;
 CancellationTokenSource? _autoCts;
 bool CanSignup=>!string.IsNullOrWhiteSpace(Session.PendingPlayerAlias)&&Session.PendingTermsAccepted;
 protected override void OnInitialized(){if(!Session.IsLoggedIn&&!string.IsNullOrWhiteSpace(Auth.LastError))Session.OpenAccountViewer();}
 void ShowSignup()=>_mode="signup";
 void ShowLogin()=>_mode="login";
 void SelectPlayerPlan(){Session.PendingPlan="player";Session.Notify();}
 void SelectGmPlayerPlan(){Session.PendingPlan="gm-player";Session.Notify();}
 void Next()=>Session.AdvanceDialogue();
 void ToggleAuto(){_auto=!_auto;if(_auto)StartAuto();else StopAuto();}
 void DelayChanged(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var delay))_delaySeconds=Math.Clamp(delay,2,10);if(_auto)StartAuto();}
 void StartAuto(){StopAuto();_auto=true;_autoCts=new();_ = AutoLoop(_autoCts.Token);}
 void StopAuto(){_autoCts?.Cancel();_autoCts?.Dispose();_autoCts=null;}
 async Task AutoLoop(CancellationToken token){try{while(!token.IsCancellationRequested){await Task.Delay(TimeSpan.FromSeconds(_delaySeconds),token);if(Session.DialogueOpen||!string.IsNullOrWhiteSpace(Session.DialogueText))await InvokeAsync(Session.AdvanceDialogue);}}catch(OperationCanceledException){}}
 public void Dispose()=>StopAuto();
}
