@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth

@if(Session.AccountViewerOpen && !Session.IsLoggedIn)
{
 <section class="map-account-viewer signup-profile-viewer" role="dialog" aria-modal="false" aria-label="Create RIST profile">
  <header class="map-viewer-header"><strong>Create Profile</strong><button type="button" class="map-viewer-close" @onclick="Session.CloseAccountViewer" aria-label="Close profile">×</button></header>
  <div class="map-account-body signup-profile-body">
   <section class="map-account-card signup-profile-card">
    @if(!string.IsNullOrWhiteSpace(Auth.LastError))
    {
     <p class="storage-status" role="alert">@Auth.LastError</p>
    }
    <div class="map-auth-form signup-profile-form">
     <h2>RIST profile</h2>
     <p class="map-chat-empty">Set the profile details other players will see. Discord is the next step and is used only to verify and reconnect the account.</p>
     <label><span>Display name</span><input maxlength="48" autocomplete="name" @bind="Session.PendingDisplayName" placeholder="Your profile name" /></label>
     <label><span>Player alias</span><input maxlength="32" autocomplete="nickname" @bind="Session.PendingPlayerAlias" placeholder="Name shown at the table" /></label>
     <label><span>Profile note <small>(optional)</small></span><textarea maxlength="240" @bind="Session.PendingProfileNote" placeholder="A short introduction, play style, or GM note"></textarea></label>
     <fieldset class="map-plan-picker"><legend>Intended plan</legend>
      <button type="button" class="@(Session.PendingPlan=="player"?"selected":"")" @onclick="SelectPlayerPlan"><strong>Player</strong><span>$5 / month</span></button>
      <button type="button" class="@(Session.PendingPlan=="gm-player"?"selected":"")" @onclick="SelectGmPlayerPlan"><strong>GM + Player</strong><span>$15 / month</span></button>
     </fieldset>
     <label class="map-terms"><input type="checkbox" @bind="Session.PendingTermsAccepted" /><span>I agree to the <a href="terms.html" target="_blank" rel="noopener">Terms</a> and <a href="privacy.html" target="_blank" rel="noopener">Privacy Policy</a>.</span></label>
     <button class="discord-login-primary" @onclick="Session.BeginAccountSignupAsync" disabled="@(!CanSignup)">Continue to Discord login</button>
     <small class="signup-discord-note">Your profile is kept in this RIST flow first; Discord authorization follows after Continue.</small>
    </div>
   </section>
  </div>
 </section>
}

<style>
.signup-profile-viewer .signup-profile-body{display:block!important;max-width:720px!important;margin:0 auto!important;width:100%!important}
.signup-profile-viewer .signup-profile-card{width:100%!important;max-width:none!important}
.signup-profile-form textarea{box-sizing:border-box;width:100%;min-height:72px;resize:vertical}
.signup-profile-form label>span{display:block;margin-bottom:4px}
.signup-profile-form label small,.signup-discord-note{color:#9e9278;font-size:10px}
.signup-discord-note{display:block;text-align:center;margin-top:6px}
</style>

@code{
 bool CanSignup=>!string.IsNullOrWhiteSpace(Session.PendingDisplayName)&&!string.IsNullOrWhiteSpace(Session.PendingPlayerAlias)&&Session.PendingTermsAccepted;
 protected override void OnInitialized(){if(!Session.IsLoggedIn&&!string.IsNullOrWhiteSpace(Auth.LastError))Session.OpenAccountViewer();}
 void SelectPlayerPlan(){Session.PendingPlan="player";Session.Notify();}
 void SelectGmPlayerPlan(){Session.PendingPlan="gm-player";Session.Notify();}
 public void Dispose(){}
}
