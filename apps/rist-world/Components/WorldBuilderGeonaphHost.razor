@inject WorldSession Session

<div class="geonaph-worldbuilder-host" data-world-id="@Session.WorldId" data-world-name="@Session.WorldDisplayName" aria-label="World Builder">
 <iframe
  class="geonaph-worldbuilder-frame"
  src="@BuilderSrc"
  title="World Builder"
  loading="eager"
  allow="fullscreen"
 ></iframe>
</div>

<style>
 .geonaph-worldbuilder-host{
  position:fixed;
  inset:0;
  z-index:2147481000;
  width:100dvw;
  height:100dvh;
  min-width:0;
  min-height:0;
  overflow:hidden;
  background:#05090c;
 }
 .geonaph-worldbuilder-frame{
  display:block;
  width:100%;
  height:100%;
  border:0;
  margin:0;
  padding:0;
  background:#05090c;
 }
</style>

@code {
 [Parameter] public EventCallback OnStartMenu { get; set; }

 string BuilderSrc
 {
  get
  {
   var worldId=Uri.EscapeDataString(Session.WorldId??"");
   var worldName=Uri.EscapeDataString(Session.WorldDisplayName??"");
   var seed=Session.IsGeonaphWorld?"geonaph":"empty";
   var surfacePixels=Session.SurfaceWorldPixelLimit ?? WorldSession.IncludedSurfaceWorldPixels;
   var surfacePolicy=Session.IsGeonaphWorld&&Session.HasPlatformCommercialOverride?"developer-controlled":"entitled";
   var access=Session.HasTrustedWorldBuilderAuthority?"edit":"view";
   return $"/Game/prototype/index.html?live-worldbuilder=1&worldId={worldId}&worldName={worldName}&seed={seed}&surfacePixels={surfacePixels}&surfacePolicy={surfacePolicy}&access={access}";
  }
 }
}
