@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Text.Json.Nodes
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorldSession Session
@inject DiscordAuthClient Auth

<section class="experiments-shell"
         tabindex="0"
         @ref="_shell"
         @onkeydown="HandleKeyDown"
         data-spatial-scope="@CurrentBuilderScope"
         data-world-id="@Session.WorldId"
         aria-label="RIST universal GameMaster Suite experiment">
 <button type="button"
         class="experiments-browser-back"
         data-browser-back="experiments"
         tabindex="-1"
         aria-hidden="true"
         hidden
         @onclick="HandleBrowserBack"></button>

 <button type="button" hidden data-experiment-start-save @onclick="SaveExperimentFromStartAsync"></button>
 <button type="button" hidden data-experiment-start-load @onclick="LoadExperimentFromStartAsync"></button>
 <button type="button" hidden data-experiment-start-exit @onclick="ExitExperimentFromStartAsync"></button>

 <main class="experiments-viewer experiments-worldbuilder-viewer" aria-label="Shaelvien World Builder viewer">
  <div class="experiments-worldbuilder-surface">
   <iframe @ref="_worldBuilderFrame"
           class="experiments-worldbuilder-frame"
           src="@WorldBuilderViewerSrc"
           title="Shaelvien World Builder viewer"
           loading="eager"
           allow="fullscreen"></iframe>
  </div>

  @if(_stage==Stage.Environment)
  {
   <section class="experiment-start-screen" aria-label="Experiment start screen">
    <img src="assets/branding/shaelvien-dragon-creation-startup-screen.png" alt="" aria-hidden="true" />
    <div class="experiment-start-shade" aria-hidden="true"></div>
    <strong>CHOOSE ENVIRONMENT</strong>
   </section>
  }
  @if(CursorMode)
  {
   <div class="viewer-reticle" data-cursor-role="pointer" style="@ReticleStyle" aria-hidden="true"><span></span></div>
  }

  @if(IsBuilderStage)
  {
   <aside class="depth-pip" aria-label="@CurrentBuilderScope tier and layer portrayal">
    <header>
     <strong>@CurrentBuilderScope</strong>
     <span>TIER @_tier · LAYER @_layer</span>
    </header>
    <div class="depth-pip-stage" aria-hidden="true">
     @for(var sheet=0;sheet<DepthPipSheetCount;sheet++)
     {
      <span class="depth-pip-sheet" style="@DepthPipSheetStyle(sheet)"></span>
     }
    </div>
    <footer><span>T@_tier</span><span>L@_layer</span></footer>
   </aside>
  }

  @if(IsBuilderStage)
  {
   <aside class="viewer-compass" aria-label="Map compass">
    <span class="compass-n">N</span>
    <span class="compass-e">E</span>
    <span class="compass-s">S</span>
    <span class="compass-w">W</span>
    <i class="compass-needle" aria-hidden="true"></i>
   </aside>

   <aside class="viewer-legend" aria-label="Map legend">
    <header>LEGEND</header>
    <span><i class="legend-swatch terrain"></i>TERRAIN</span>
    <span><i class="legend-swatch scope"></i>@CurrentBuilderScope</span>
    @if(HasIndividualAssetContext)
    {
     <span><i class="legend-swatch selected"></i>SELECTED ASSET</span>
    }
    <span><i class="legend-swatch context"></i>CONTEXT</span>
   </aside>

   <aside class="asset-context-pip @(_assetContextExpanded?"expanded":"minimized")"
          aria-label="@AssetContextTitle context">
    <header>
     <div>
      <small>ASSET CONTEXT</small>
      <strong>@AssetContextTitle</strong>
     </div>
     @if(_assetContextExpanded)
     {
      <button type="button" @onclick="MinimizeAssetContext" aria-label="Minimize asset context">—</button>
     }
    </header>

    @if(_assetContextExpanded)
    {
     <div class="asset-context-fields">
      <label>NAME<input @bind="_contextName" /></label>
      <label>LORE<textarea @bind="_contextLore"></textarea></label>
      <label>HISTORY<textarea @bind="_contextHistory"></textarea></label>
      <label>NPCS<textarea @bind="_contextNpcs"></textarea></label>
      <label>ENCOUNTERS<textarea @bind="_contextEncounters"></textarea></label>
      <label>NOTES<textarea @bind="_contextNotes"></textarea></label>
     </div>
     <footer>
      <span role="status">@_contextStatus</span>
      <button type="button" @onclick="SaveAssetContextAsync">SAVE CONTEXT</button>
     </footer>
    }
    else
    {
     <p>@AssetContextSummary</p>
    }
   </aside>
  }

  @if(IsAssetTransformStage)
  {
   <div class="asset-preview @(_assetKind=="SPRITE"?"sprite":"image")"
        style="@AssetPreviewStyle"
        aria-hidden="true">
    @if(!string.IsNullOrWhiteSpace(SelectedAssetUrl))
    {
     <img src="@SelectedAssetUrl" alt="" />
    }
    else
    {
     <span>@_assetKind</span>
    }
   </div>
  }

  @if(_stage==Stage.BrowsePlace)
  {
   <section class="asset-source-explorer" aria-label="@_assetSource explorer">
    <header><strong>@_assetSource</strong><span>@_assetScope · @_assetKind</span></header>

    @if(_assetSource=="UPLOAD")
    {
     <div class="asset-upload-pane">
      <strong>ADD @_assetScope TO MY @(_assetKind=="SPRITE"?"SPRITES":"IMAGES")</strong>
      <span>Choose an image from this device. It is stored in your private RIST library under @_assetScope and becomes available under My @(_assetKind=="SPRITE"?"Sprites":"Images").</span>
      <InputFile OnChange="HandleAssetUpload"
                 accept="image/png,image/jpeg,image/webp,image/gif,image/bmp"
                 aria-label="Choose an image to add to your private library" />
      @if(!string.IsNullOrWhiteSpace(_assetLoadError))
      {
       <small role="alert">@_assetLoadError</small>
      }
     </div>
    }
    else if(IsMyAssetSource)
    {
     @if(_assetsLoading)
     {
      <div class="asset-library-state" role="status">LOADING MY @(_assetKind=="SPRITE"?"SPRITES":"IMAGES")…</div>
     }
     else if(!string.IsNullOrWhiteSpace(_assetLoadError))
     {
      <div class="asset-library-state error" role="alert">@_assetLoadError</div>
     }
     else if(_myAssets.Count==0)
     {
      <div class="asset-library-state">NO SAVED @_assetScope @(_assetKind=="SPRITE"?"SPRITES":"IMAGES") YET · CHOOSE UPLOAD</div>
     }
     else
     {
      <div class="asset-source-explorer-grid linked-assets">
       @foreach(var asset in _myAssets)
       {
        <button type="button"
                class="linked-asset @(asset.Key==_selectedAssetKey?"selected":"")"
                @onclick="()=>SelectMyAsset(asset.Key)"
                aria-label="Select @asset.Name">
         <img src="@asset.Url" alt="" loading="lazy" />
         <span>@asset.Name</span>
        </button>
       }
      </div>
     }
    }
    else if(IsGameAssetSource)
    {
     @if(_gameAssets.Count==0)
     {
      <div class="asset-library-state">NO DEPLOYED @_assetScope @(_assetKind=="SPRITE"?"SPRITES":"IMAGES") FOUND</div>
     }
     else
     {
      <div class="asset-source-explorer-grid linked-assets">
       @foreach(var asset in _gameAssets)
       {
        <button type="button"
                class="linked-asset @(asset.Key==_selectedAssetKey?"selected":"")"
                @onclick="()=>SelectGameAsset(asset.Key)"
                aria-label="Select @asset.Name">
         <img src="@asset.Url" alt="" loading="lazy" />
         <span>@asset.Name</span>
        </button>
       }
      </div>
     }
    }
    else
    {
     <div class="asset-source-explorer-grid" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
     </div>
    }

    <footer>TOUCH / CURSOR · ONCE SELECTS · AGAIN PLACES</footer>
   </section>
  }

  @if(_stage!=Stage.Environment)
  {
   <nav class="viewer-menu-bar" role="toolbar" aria-label="Viewer editing and navigation">
    <button type="button" @onclick='()=>HandleViewerMenuCommandAsync("back")' aria-label="Back">BACK</button>
    <button type="button" @onclick='()=>HandleViewerMenuCommandAsync("undo")' aria-label="Undo">UNDO</button>
    <button type="button" @onclick='()=>HandleViewerMenuCommandAsync("cut")' aria-label="Cut selected item">CUT</button>
    <button type="button" @onclick='()=>HandleViewerMenuCommandAsync("copy")' aria-label="Copy selected item">COPY</button>
    <button type="button" @onclick='()=>HandleViewerMenuCommandAsync("redo")' aria-label="Redo">REDO</button>
    <button type="button" @onclick='()=>HandleViewerMenuCommandAsync("paste")' aria-label="Paste copied item">PASTE</button>
    <button type="button" @onclick='()=>HandleViewerMenuCommandAsync("forward")' aria-label="Forward">FORWARD</button>
   </nav>
  }

  <div class="viewer-status" role="status" aria-live="polite">
   <strong>@ViewerTitle</strong>
   <span>@_message</span>
  </div>

  @if(_stage!=Stage.Environment)
  {
   <footer class="viewer-readout">
    <span>X @_xPulse</span>
    <span>Y @_yPulse</span>
    <span>@StagePath</span>
   </footer>
  }
 </main>

 <section class="experiments-controller single-analog-deck @AnalogPlacementClass"
          aria-label="Universal analog and display controls">
  <div class="@LeftSliderClass"
       @ref="_leftSlider"
       role="group"
       aria-label="Left display. Slide up or down to change its selection, then touch the display to activate it.">
   @if(LeftDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-up" aria-hidden="true"></span>
   }
   <button type="button"
           class="control-display-button control-display-left @(_stage==Stage.Environment?"environment-choice-button":"") @(_experimentStartFlashing&&_stage==Stage.Environment?"environment-head-flash":"")"
           @onclick="PressLeft"
           disabled="@(_stage==Stage.Environment&&!_experimentStartRevealed)"
           aria-disabled="@(_stage==Stage.Environment&&!_experimentStartRevealed)"
           aria-label="@(_stage==Stage.Environment&&!_experimentStartRevealed?"Dark dragon":$"Left display button: {LeftDisplayValue}")">
    @if(_stage==Stage.Environment)
    {
     @if(!_experimentStartRevealed)
     {
      <span class="experiment-dragon-head dark-dragon" aria-hidden="true"></span>
     }
     else
     {
      <strong class="@LeftDisplayTextClass environment-choice-label">SHAELVIEN</strong>
     }
    }
    else
    {
     <small>@LeftEyebrow</small>
     <strong class="@LeftDisplayTextClass">@LeftDisplayValue</strong>
     <span>@LeftDisplayPrompt</span>
    }
   </button>
   @if(LeftDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-down" aria-hidden="true"></span>
   }
  </div>

  <div class="analog-control analog-control-xy @(CursorMode?"cursor-mode":"paging-mode")"
       @ref="_analog"
       role="button"
       tabindex="0"
       data-analog-select="true"
       aria-label="Universal analog control. Move the stick to navigate button choices or the viewer cursor. Press the centered stick to select the current primary action.">
   <button type="button"
           class="analog-mode-button"
           aria-pressed="@CursorMode"
           @onclick="ToggleAnalogMode"
           disabled="@(_stage==Stage.Environment&&!_experimentStartRevealed)"
           aria-disabled="@(_stage==Stage.Environment&&!_experimentStartRevealed)"
           aria-label="@(_stage==Stage.Environment&&_experimentStartRevealed?"Open Legacy GM archive import":"Switch analog between cursor and button controls")">@AnalogModeLabel</button>
   <span class="analog-direction analog-up" aria-hidden="true">UP</span>
   <span class="analog-direction analog-down" aria-hidden="true">DOWN</span>
   <span class="analog-direction analog-left" aria-hidden="true">LEFT</span>
   <span class="analog-direction analog-right" aria-hidden="true">RIGHT</span>
   <div class="analog-pad" aria-hidden="true">
    <span class="analog-crosshair"></span>
    <span class="analog-knob"></span>
   </div>
   <button type="button"
           class="analog-start-button"
           @onclick="HandleStartButtonAsync"
           aria-label="@(_stage==Stage.Environment&&!_experimentStartRevealed?"Reveal environments":"Open Start menu")">START</button>
  </div>

  <div class="@RightSliderClass"
       @ref="_rightSlider"
       role="group"
       aria-label="Right display. Slide left or right to change its selection, then touch the display to activate it.">
   @if(RightDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-left" aria-hidden="true"></span>
   }
   <button type="button"
           class="control-display-button control-display-right @(_stage==Stage.Environment?"environment-choice-button":"") @(_experimentStartFlashing&&_stage==Stage.Environment?"environment-head-flash":"")"
           @onclick="PressRight"
           disabled="@(_stage==Stage.Environment&&!_experimentStartRevealed)"
           aria-disabled="@(_stage==Stage.Environment&&!_experimentStartRevealed)"
           aria-label="@(_stage==Stage.Environment&&!_experimentStartRevealed?"Light dragon":$"Right display button: {RightDisplayValue}")">
    @if(_stage==Stage.Environment)
    {
     @if(!_experimentStartRevealed)
     {
      <span class="experiment-dragon-head light-dragon" aria-hidden="true"></span>
     }
     else
     {
      <strong class="@RightDisplayTextClass environment-choice-label">RIST</strong>
     }
    }
    else
    {
     <small>@RightDisplayEyebrow</small>
     <strong class="@RightDisplayTextClass">@RightDisplayValue</strong>
     <span>@RightDisplayPrompt</span>
    }
   </button>
   @if(RightDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-right" aria-hidden="true"></span>
   }
  </div>
 </section></section>

<LegacyWorldGate Open="@_legacyGateOpen"
                 OnClose="CloseLegacyGate"
                 OnContinue="ContinueLegacyIntoRistAsync" />

@if(Session.IsServerVerifiedPlatformOwner&&_stage==Stage.Environment)
{
 <nav class="experiments-owner-links experiments-owner-first-screen" aria-label="Owner-only experiment links">
  <a href="/relic/#capabilities" target="_blank" rel="noopener noreferrer">
   <strong>R.e.L.i.C. CAPABILITIES</strong>
   <span>Public AI surface and tested capability map</span>
  </a>
  <a href="/owner/" target="_blank" rel="noopener noreferrer">
   <strong>OWNER DASHBOARD</strong>
   <span>Private whole-project operations view</span>
  </a>
 </nav>
}

@code {
 [Parameter] public EventCallback OnExit { get; set; }
 [Parameter] public IReadOnlyList<AccountWorldReference> Worlds { get; set; } = Array.Empty<AccountWorldReference>();

 enum Stage
 {
  Environment,
  Role,
  PathSelect,
  GameMasterHub,
  GameMasterScope,
  SoftwareHub,
  ControlSettings,
  WorldBuilderTier,
  WorldBuilderLayer,
  ArtMethod,
  ArtPhase,
  ArtWork,
  KnowledgeNode,
  AssetKind,
  AssetMode,
  BrowsePlace,
  Scale,
  Rotate,
  Move,
  SaveCancel,
  FullMapReview
 }

 const string AnalogPlacementStorageKey="rist.experiments.analogPlacement.v1";
 ElementReference _shell;
 ElementReference _worldBuilderFrame;
 ElementReference _analog;
 ElementReference _leftSlider;
 ElementReference _rightSlider;
 DotNetObjectReference<ExperimentsWorkspace>? _selfRef;
 IJSObjectReference? _worldBuilderSourceModule;
 bool _worldBuilderSourceAttached;
 Stage _stage=Stage.Environment;
 int _worldIndex;
 int _settingIndex;
 int _scopeIndex;
 int _softwareIndex;
 int _pathIndex;
 int _pathMenuIndex;
 int _artMethodIndex;
 int _artPhaseIndex;
 int _artToolIndex;
 int _assetKindIndex;
 int _assetSourceIndex;
 int _builderChainIndex;
 int _tier;
 int _layer;
 int _xPulse;
 int _yPulse;
 int _xControl;
 int _yControl;
 double _cursorX;
 double _cursorY;
 string _analogPlacement="center";
 int _analogPlacementDraft=1;
 double _assetScale=1;
 int _assetRotation;
 int _assetX;
 int _assetY;
 string _assetKind="IMAGE";
 string _assetScope="WORLD";
 string _activeKnowledgeNode="";
 bool _assetContextExpanded;
 bool _browseCursorActive;
 bool _analogButtonMode;
 bool _experimentStartRevealed=true;
 bool _experimentStartFlashing;
 bool _legacyGateOpen;
 string _selectedEnvironment="SHAELVIEN";
 string _contextLoadedIdentity="";
 string _contextName="";
 string _contextLore="";
 string _contextHistory="";
 string _contextNpcs="";
 string _contextEncounters="";
 string _contextNotes="";
 string _contextStatus="";
 string _assetSource="GAME IMAGES";
 string _assetMode="ADD";
 bool _assetsLoading;
 string _assetLoadError="";
 string _selectedAssetKey="";
 bool _assetSavePending;
 string _worldBuilderSelectionId="";
 string _worldBuilderSelectionName="";
 string _worldBuilderSelectionAssetId="";
 string _worldBuilderSelectionKind="";
 int _worldBuilderSelectionTier;
 int _worldBuilderSelectionLayer;
 double _worldBuilderSelectionX;
 double _worldBuilderSelectionY;
 List<UserAssetEntry> _myAssets=[];
 List<UserAssetEntry> _gameAssets=[];
 List<SavedViewerAsset> _savedAssets=[];
 Stack<string> _pathHistory=new();
 Stack<ViewerNavState> _viewerForwardHistory=new();
 string _message="Slide the left display vertically and the right display horizontally. The analog snaps those displays one page at a time; when neither display has multiple choices it becomes the viewer cursor.";

 static readonly string[] Settings=["GRAPHICS","LANGUAGE","ACCESSIBILITY","CONTROLS","AUDIO","DISPLAY","NETWORK","ACCOUNT","HELP"];
 static readonly string[] Scopes=["WORLD BUILDER","REGION DEFINER","LOCAL","INSTANCE","TABLETOP","SOFTWARE"];
 static readonly string[] SoftwareCapabilities=["IMAGE EDITOR","STREAM / RECORD","NOTES / DATABASE","AUDIO","BROWSER","COMMUNICATION","AUTOMATION"];
 static readonly string[] AnalogPlacements=["LEFT","CENTER","RIGHT"];
 static readonly string[] AssetKinds=["IMAGE","SPRITE"];
 static readonly string[] ImageSources=["GAME IMAGES","MY IMAGES","UPLOAD"];
 static readonly string[] SpriteSources=["GAME SPRITES","MY SPRITES","UPLOAD"];
 static readonly string[] GameMasterPaths=["WORLD BUILDER","CAMPAIGN BUILDER","ADVANCED"];
 static readonly string[] ArtMethods=["DRAW","CAD","IMAGES","SPRITE","AUDIO","VIDEO"];
 static readonly string[] DrawPhases=["PENCIL","COLOR","EFFECTS"];
 static readonly string[] CadPhases=["SKETCH","GEOMETRY","MATERIAL","EFFECTS"];
 static readonly string[] AudioPhases=["RECORD","EDIT","EFFECTS"];
 static readonly string[] VideoPhases=["IMPORT","EDIT","EFFECTS"];
 static readonly string[] ColorTools=["BRUSH","FILL","AIRBRUSH","PALETTE","IMPORT TEXTURE"];
 static readonly string[] EffectTools=["LIGHT","SHADOW","GLOW","WEATHER","FILTER","MASK"];
 static readonly string[] CadSketchTools=["LINE","ARC","POLYLINE"];
 static readonly string[] CadGeometryTools=["RECTANGLE","CIRCLE","POLYGON","EXTRUDE"];
 static readonly string[] CadMaterialTools=["WOOD","METAL","STONE","GLASS","CUSTOM"];
 static readonly string[] AudioRecordTools=["MIC","IMPORT"];
 static readonly string[] AudioEditTools=["TRIM","MIX","LOOP"];
 static readonly string[] AudioEffectTools=["REVERB","EQ","FILTER"];
 static readonly string[] VideoImportTools=["CAMERA","FILE"];
 static readonly string[] VideoEditTools=["TRIM","LAYER","SPEED"];
 static readonly string[] VideoEffectTools=["LIGHT","FILTER","OVERLAY"];
 static readonly string[] WorldBuilderPath=["WORLD","REGION","LOCAL","INSTANCE","LORE","HISTORY","COSMOLOGY","CALENDAR","CULTURES","FACTIONS","ECONOMY","TECHNOLOGY","MAGIC / POWERS","CREATURES","NPCS","RELATIONSHIPS","SECRETS","THREATS","FRONTS / CLOCKS","ENCOUNTERS","QUESTS","CAMPAIGN","SESSION"];
 static readonly string[] CampaignBuilderPath=["LOCAL","INSTANCE","LOCAL HISTORY","NPCS","RELATIONSHIPS","SECRETS","CLUES","ENCOUNTERS","QUESTS","SCENES","DOWNTIME","REGION","REGIONAL HISTORY","FACTIONS","FRONTS / CLOCKS","ECONOMY","WORLD","WORLD LORE","CAMPAIGN","SESSION"];
 static readonly string[] AdvancedPath=["WORLD","REGION","LOCAL","INSTANCE","ROOM / SCENE","OBJECT","CONTAINER","CONTENTS","COSMOLOGY","CALENDAR","ERAS","HISTORY","EVENTS","LORE","RUMORS","SECRETS","CLUES","LANGUAGES","RELIGIONS","CULTURES","FACTIONS","ORGANIZATIONS","ECONOMY","POLITICS","TECHNOLOGY","MAGIC / POWERS","CREATURES","NPCS","RELATIONSHIPS","THREATS","FRONTS / CLOCKS","ENCOUNTERS","COMBAT","SOCIAL","EXPLORATION","INVESTIGATION","CHASE","PUZZLE","HAZARD","DOWNTIME","TRAVEL","CRAFTING","MASS CONFLICT","QUESTS","MISSIONS","ARCS","CAMPAIGN","SESSION","RULES","CHARACTERS","EQUIPMENT","REWARDS"];
 static readonly string[] BuilderChain=["WORLD","REGION","LOCAL","INSTANCE"];
 static readonly string[] BuilderSuiteNames=["WORLD BUILDER","REGION DEFINER","LOCAL","INSTANCE"];

 string[] WorldChoices
 {
  get
  {
   var names=Worlds
    .Where(world=>!string.IsNullOrWhiteSpace(world.DisplayName))
    .OrderByDescending(world=>world.UpdatedAtUtc)
    .Select(world=>world.DisplayName.Trim().ToUpperInvariant())
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();

   if(Session.HasActiveWorld&&!names.Any(name=>string.Equals(name,Session.WorldDisplayName,StringComparison.OrdinalIgnoreCase)))
    names.Insert(0,Session.WorldDisplayName.ToUpperInvariant());

   names.Add("NEW WORLD");
   return names.ToArray();
  }
 }

 int WorldIndex=>Math.Clamp(_worldIndex,0,WorldChoices.Length-1);
 string CurrentWorld=>WorldChoices[WorldIndex];
 string PreviousWorld=>WorldChoices[(WorldIndex-1+WorldChoices.Length)%WorldChoices.Length];
 string NextWorld=>WorldChoices[(WorldIndex+1)%WorldChoices.Length];
 string CurrentSetting=>Settings[_settingIndex];
 string PreviousSetting=>Settings[(_settingIndex-1+Settings.Length)%Settings.Length];
 string NextSetting=>Settings[(_settingIndex+1)%Settings.Length];
 string CurrentScope=>Scopes[_scopeIndex];
 string CurrentSoftware=>SoftwareCapabilities[_softwareIndex];
 string PreviousSoftware=>SoftwareCapabilities[(_softwareIndex-1+SoftwareCapabilities.Length)%SoftwareCapabilities.Length];
 string NextSoftware=>SoftwareCapabilities[(_softwareIndex+1)%SoftwareCapabilities.Length];

 string CurrentGameMasterPath=>GameMasterPaths[Math.Clamp(_pathIndex,0,GameMasterPaths.Length-1)];
 string[] CurrentGuidedPath=>CurrentGameMasterPath switch
 {
  "CAMPAIGN BUILDER"=>CampaignBuilderPath,
  "ADVANCED"=>AdvancedPath,
  _=>WorldBuilderPath
 };
 string[] CurrentPathMenu=>CurrentGuidedPath.Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
 string CurrentPathTarget=>CurrentPathMenu[Math.Clamp(_pathMenuIndex,0,CurrentPathMenu.Length-1)];
 string CurrentArtMethod=>ArtMethods[Math.Clamp(_artMethodIndex,0,ArtMethods.Length-1)];
 string[] CurrentArtPhases=>CurrentArtMethod switch
 {
  "DRAW"=>DrawPhases,
  "CAD"=>CadPhases,
  "AUDIO"=>AudioPhases,
  "VIDEO"=>VideoPhases,
  _=>["SOURCE"]
 };
 string CurrentArtPhase=>CurrentArtPhases[Math.Clamp(_artPhaseIndex,0,CurrentArtPhases.Length-1)];
 string[] CurrentArtTools=>CurrentArtMethod switch
 {
  "DRAW" when CurrentArtPhase=="PENCIL"=>["PENCIL"],
  "DRAW" when CurrentArtPhase=="COLOR"=>ColorTools,
  "DRAW" when CurrentArtPhase=="EFFECTS"=>EffectTools,
  "CAD" when CurrentArtPhase=="SKETCH"=>CadSketchTools,
  "CAD" when CurrentArtPhase=="GEOMETRY"=>CadGeometryTools,
  "CAD" when CurrentArtPhase=="MATERIAL"=>CadMaterialTools,
  "CAD" when CurrentArtPhase=="EFFECTS"=>EffectTools,
  "AUDIO" when CurrentArtPhase=="RECORD"=>AudioRecordTools,
  "AUDIO" when CurrentArtPhase=="EDIT"=>AudioEditTools,
  "AUDIO" when CurrentArtPhase=="EFFECTS"=>AudioEffectTools,
  "VIDEO" when CurrentArtPhase=="IMPORT"=>VideoImportTools,
  "VIDEO" when CurrentArtPhase=="EDIT"=>VideoEditTools,
  "VIDEO" when CurrentArtPhase=="EFFECTS"=>VideoEffectTools,
  _=>[CurrentArtPhase]
 };
 string CurrentArtTool=>CurrentArtTools[Math.Clamp(_artToolIndex,0,CurrentArtTools.Length-1)];

 string CurrentAnalogPlacementDraft=>AnalogPlacements[Math.Clamp(_analogPlacementDraft,0,AnalogPlacements.Length-1)];
 string AnalogPlacementClass=>$"analog-{_analogPlacement}";
 string[] AssetSources=>_assetKind=="SPRITE"?SpriteSources:ImageSources;
 string CurrentAssetSource=>AssetSources[Math.Clamp(_assetSourceIndex,0,AssetSources.Length-1)];
 string CurrentBuilderScope=>BuilderChain[Math.Clamp(_builderChainIndex,0,BuilderChain.Length-1)];
 string CurrentBuilderSuite=>BuilderSuiteNames[Math.Clamp(_builderChainIndex,0,BuilderSuiteNames.Length-1)];
 bool HasWorldBuilderSelection=>!string.IsNullOrWhiteSpace(_worldBuilderSelectionId);
 bool HasIndividualAssetContext=>HasWorldBuilderSelection||!string.IsNullOrWhiteSpace(_selectedAssetKey);
 string ActiveContextAssetKey=>HasWorldBuilderSelection?_worldBuilderSelectionAssetId:_selectedAssetKey;
 int AssetContextTier=>HasWorldBuilderSelection?_worldBuilderSelectionTier:_tier;
 int AssetContextLayer=>HasWorldBuilderSelection?_worldBuilderSelectionLayer:_layer;
 string AssetContextIdentity=>HasWorldBuilderSelection
  ?$"placement:{_worldBuilderSelectionId}"
  :!string.IsNullOrWhiteSpace(_selectedAssetKey)
   ?_selectedAssetKey
   :$"scope:{CurrentBuilderScope.ToLowerInvariant()}:tier:{_tier}:layer:{_layer}";
 string AssetContextTitle=>HasWorldBuilderSelection
  ?FirstNonEmpty(_worldBuilderSelectionName,_worldBuilderSelectionAssetId,"PLACED ASSET")
