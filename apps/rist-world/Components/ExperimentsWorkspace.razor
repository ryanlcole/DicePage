 async Task HandleViewerMenuCommandAsync(string command)
 {
  command=(command??"").Trim().ToLowerInvariant();
  if(command=="back"){await NavigateViewerBackAsync();return;}
  if(command=="forward"){await NavigateViewerForwardAsync();return;}

  if(_worldBuilderSourceModule is null)
  {
   _message="Viewer editing tools are still loading.";
   await InvokeAsync(StateHasChanged);
   return;
  }

  try
  {
   var result=await _worldBuilderSourceModule.InvokeAsync<string>("editCommand",_worldBuilderFrame,command);
   _message=string.IsNullOrWhiteSpace(result)?$"{command.ToUpperInvariant()} completed.":result;
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Viewer menu command {command} failed: {ex}");
   _message=$"{command.ToUpperInvariant()} could not be completed.";
  }
  await InvokeAsync(StateHasChanged);
 }

 async Task HandleBrowserBack()
 {
  if(_stage==Stage.Environment)
  {
   if(OnExit.HasDelegate)await OnExit.InvokeAsync();
   return;
  }

  await NavigateViewerBackAsync();
 }

 async Task HandleKeyDown(KeyboardEventArgs e)
 {
  if(e.Key=="Escape")
  {
   if(OnExit.HasDelegate)await OnExit.InvokeAsync();
   return;
  }

  switch(e.Key)
  {
   case "ArrowLeft":
   case "a":
   case "A": StepX(-1); break;
   case "ArrowRight":
   case "d":
   case "D": StepX(1); break;
   case "ArrowUp":
   case "w":
   case "W": StepY(1); break;
   case "ArrowDown":
   case "s":
   case "S": StepY(-1); break;
   case "q":
   case "Q": await PressLeft(); break;
   case "e":
   case "E": await PressRight(); break;
  }
 }

