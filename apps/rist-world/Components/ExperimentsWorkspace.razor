 async Task LoadMyAssetsAsync()
 {
  _assetsLoading=true;
  _assetLoadError="";
  _myAssets.Clear();
  await InvokeAsync(StateHasChanged);

  try
  {
   if(Auth.Profile is null)
   {
    _assetLoadError="Sign in to use My Images.";
    return;
   }

   var listing=await Auth.ListAsync(PrivateAssetPrefix);

   if(_assetKind=="IMAGE"&&_assetScope=="WORLD")
   {
    var hasEndemarSeed=(listing?.Items??[])
     .Any(item=>item.Key.StartsWith(EndemarSeedPrefix,StringComparison.OrdinalIgnoreCase));

    if(!hasEndemarSeed)
    {
     _message="Copying the existing Endemar world artwork into My Images…";
     await InvokeAsync(StateHasChanged);
     var imported=await Auth.ImportGameAssetsAsync("endomar","world");
     if(imported?.Ok==true)
     {
      _message=$"Endemar world artwork linked to My Images: {imported.Imported.Count} copied, {imported.Skipped.Count} already present.";
     }
     else
     {
      _assetLoadError="Endemar world artwork was not found in the deployed Game Images yet.";
     }
     listing=await Auth.ListAsync(PrivateAssetPrefix);
    }
   }

   var items=(listing?.Items??[])
    .Where(item=>IsSupportedImageKey(item.Key))
    .OrderByDescending(item=>item.LastModified)
    .Take(48)
    .ToList();

   var tasks=items.Select(async item =>
   {
    var url=await Auth.DownloadUrlAsync(item.Key);
    return string.IsNullOrWhiteSpace(url)
     ?null
     :new UserAssetEntry(item.Key,url,FileLabel(item.Key),item.LastModified);
   });

   var resolved=await Task.WhenAll(tasks);
   _myAssets=resolved.Where(item=>item is not null).Cast<UserAssetEntry>().ToList();

   if(_assetKind=="IMAGE"&&_assetScope=="WORLD"&&_myAssets.Count>0)
    _assetLoadError="";
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"My Images load failed: {ex}");
   _assetLoadError="My Images are temporarily unavailable. Go Back and reopen My Images to retry.";
  }
  finally
  {
   _assetsLoading=false;
   await InvokeAsync(StateHasChanged);
  }
 }

 void SelectMyAsset(string key)
 {
  _selectedAssetKey=key;
  _message=$"{SelectedAssetName} selected. Touch the left display to use it.";
 }

 async Task HandleAssetUpload(InputFileChangeEventArgs e)
 {
  var file=e.File;
  _assetLoadError="";

  var extension=file.ContentType.ToLowerInvariant() switch
  {
   "image/png"=>".png",
   "image/jpeg"=>".jpg",
   "image/webp"=>".webp",
   "image/gif"=>".gif",
   _=>""
  };

  if(string.IsNullOrEmpty(extension))
  {
   _assetLoadError="Use PNG, JPEG, WebP, or GIF.";
   return;
  }

  const long maxBytes=25L*1024*1024;
  if(file.Size>maxBytes)
  {
   _assetLoadError="That image is larger than 25 MB.";
   return;
  }

  try
  {
   _assetsLoading=true;
   await InvokeAsync(StateHasChanged);

   await using var stream=file.OpenReadStream(maxBytes);
   using var buffer=new MemoryStream();
   await stream.CopyToAsync(buffer);

   var key=PrivateAssetPrefix+DateTimeOffset.UtcNow.ToString("yyyyMMdd-HHmmss")+"-"+Guid.NewGuid().ToString("N")+extension;
   await Auth.UploadBytesAsync(key,buffer.ToArray(),file.ContentType);

   _assetSource=_assetKind=="SPRITE"?"MY SPRITES":"MY IMAGES";
   _assetSourceIndex=Array.IndexOf(AssetSources,_assetSource);
   if(_assetSourceIndex<0)_assetSourceIndex=0;
   _selectedAssetKey=key;
   _message=$"{file.Name} added to {_assetScope} {_assetSource}. It will stay linked to this account as Shaelvien grows.";

   await LoadMyAssetsAsync();
   if(_myAssets.Any(asset=>asset.Key==key))_selectedAssetKey=key;
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Asset upload failed: {ex}");
   _assetLoadError="Upload failed. Please try again.";
  }
  finally
  {
   _assetsLoading=false;
   await InvokeAsync(StateHasChanged);
  }
 }

 static bool IsSupportedImageKey(string key)
 {
  var lower=key.ToLowerInvariant();
  return lower.EndsWith(".png")||lower.EndsWith(".jpg")||lower.EndsWith(".jpeg")||
         lower.EndsWith(".webp")||lower.EndsWith(".gif");
 }

 static string FileLabel(string key)
 {
  if(string.IsNullOrWhiteSpace(key))return "IMAGE";
  var name=key.Replace("\\","/").Split('/').LastOrDefault()??"IMAGE";
  return name.Length<=28?name:name[..25]+"…";
 }

