 [JSInvokable]
 public Task ReceiveUniversalInput(string control,int direction)
 {
  return InvokeAsync(async () =>
  {
   switch(control)
   {
    case "x": StepX(direction); break;
    case "y": StepY(direction); break;
    case "select":
     if(_stage==Stage.BrowsePlace&&CursorMode)await ActivateBrowseCursorTargetAsync();
     else await PressLeft();
     break;
    case "left": await PressLeft(); break;
    case "right": await PressRight(); break;
   }
   StateHasChanged();
  });
 }

