 async Task LoadAssetContextAsync()
 {
  var identity=AssetContextIdentity;
  var title=AssetContextTitle;
  if(_contextLoadedIdentity==identity)
  {
   _contextStatus="Context ready.";
   await InvokeAsync(StateHasChanged);
   return;
  }

  try
  {
   var source=await Session.LoadWorldBuilderSourceAsync();
   if(identity!=AssetContextIdentity)return;

   JsonObject? root=null;
   if(source is not null)
   {
    try{if(source.State is JsonElement state)root=JsonNode.Parse(state.GetRawText()) as JsonObject;}catch{}
   }

   var contexts=root?["assetContexts"] as JsonObject;
   var context=contexts?[identity] as JsonObject;
   if(context is null)
   {
    _contextName=title;
    _contextLore="";
    _contextHistory="";
    _contextNpcs="";
    _contextEncounters="";
    _contextNotes="";
    _contextStatus="New context.";
   }
   else
   {
    _contextName=NodeText(context,"name",title);
    _contextLore=NodeText(context,"lore");
    _contextHistory=NodeText(context,"history");
    _contextNpcs=NodeText(context,"npcs");
    _contextEncounters=NodeText(context,"encounters");
    _contextNotes=NodeText(context,"notes");
    _contextStatus="Context loaded.";
   }

   _contextLoadedIdentity=identity;
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Asset context load failed: {ex}");
   if(identity==AssetContextIdentity)_contextStatus="Context could not be loaded.";
  }

  await InvokeAsync(StateHasChanged);
 }

 async Task SaveAssetContextAsync()
 {
  if(!Session.HasActiveWorld)
  {
   _contextStatus="Choose a world before saving context.";
   return;
  }

  var identity=AssetContextIdentity;
  var title=AssetContextTitle;
  var scope=CurrentBuilderScope;
  var tier=AssetContextTier;
  var layer=AssetContextLayer;
  var hasPlacement=HasWorldBuilderSelection;
  var placementId=hasPlacement?_worldBuilderSelectionId:"";
  var assetKey=ActiveContextAssetKey;
  var assetKind=hasPlacement?_worldBuilderSelectionKind:_assetKind;
  var positionX=_worldBuilderSelectionX;
  var positionY=_worldBuilderSelectionY;
  var name=string.IsNullOrWhiteSpace(_contextName)?title:_contextName.Trim();
  var lore=_contextLore.Trim();
  var history=_contextHistory.Trim();
  var npcs=_contextNpcs.Trim();
  var encounters=_contextEncounters.Trim();
  var notes=_contextNotes.Trim();

  _contextStatus="Saving…";
  await InvokeAsync(StateHasChanged);

  try
  {
   var source=await Session.LoadWorldBuilderSourceAsync();
   JsonObject root;
   try
   {
    root=source is null
     ?new JsonObject()
     :(source.State is JsonElement state?JsonNode.Parse(state.GetRawText()) as JsonObject??new JsonObject():new JsonObject());
   }
   catch
   {
    root=new JsonObject();
   }

   if(root["worldId"] is null)root["worldId"]=Session.WorldId;

   var contexts=root["assetContexts"] as JsonObject;
   if(contexts is null)
   {
    contexts=new JsonObject();
    root["assetContexts"]=contexts;
   }

   var entry=new JsonObject
   {
    ["name"]=name,
    ["lore"]=lore,
    ["history"]=history,
    ["npcs"]=npcs,
    ["encounters"]=encounters,
    ["notes"]=notes,
    ["assetKey"]=assetKey,
    ["scope"]=scope,
    ["tier"]=tier,
    ["layer"]=layer,
    ["updatedAtUtc"]=DateTimeOffset.UtcNow.ToString("O")
   };
   if(hasPlacement)
   {
    entry["placementId"]=placementId;
    entry["assetKind"]=assetKind;
    entry["x"]=positionX;
    entry["y"]=positionY;
   }
   contexts[identity]=entry;

   using var document=JsonDocument.Parse(root.ToJsonString());
   await Session.SaveWorldBuilderSourceAsync(document.RootElement.Clone());

   if(identity==AssetContextIdentity)
   {
    _contextLoadedIdentity=identity;
    _contextStatus="Context saved.";
   }
   _message=$"{title} context saved to the world source.";
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Asset context save failed: {ex}");
   if(identity==AssetContextIdentity)_contextStatus="Context save failed.";
  }

  await InvokeAsync(StateHasChanged);
 }

 static string NodeText(JsonObject node,string key,string fallback="")
  =>node[key]?.ToString()??fallback;

 static string FirstNonEmpty(params string[] values)
  =>values.FirstOrDefault(value=>!string.IsNullOrWhiteSpace(value))??"";

 static string Shorten(string value,int max)
 {
  var clean=value.Trim().Replace("\r"," ").Replace("\n"," ");
  return clean.Length<=max?clean:clean[..Math.Max(1,max-1)]+"…";
 }

