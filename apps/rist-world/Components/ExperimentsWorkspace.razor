 [JSInvokable]
 public async Task<object?> GetWorldBuilderSourceForPrototypeAsync()
 {
  var source=await Session.LoadWorldBuilderSourceAsync();
  if(source is null||source.State is null)return null;
  return new
  {
   worldId=source.WorldId,
   state=source.State,
   updatedAtUtc=source.UpdatedAtUtc,
   source="database"
  };
 }

 [JSInvokable]
 public async Task<object> SaveWorldBuilderSourceFromPrototypeAsync(System.Text.Json.JsonElement state)
 {
  // The embedded map editor owns map representation fields, not Asset Context.
  // Preserve the latest canonical contexts so a later map save cannot erase them.
  var mergedState=state.Clone();
  var current=await Session.LoadWorldBuilderSourceAsync();
  if(state.ValueKind==JsonValueKind.Object
     &&current?.State is JsonElement currentState
     &&currentState.ValueKind==JsonValueKind.Object
     &&currentState.TryGetProperty("assetContexts",out var currentContexts))
  {
   try
   {
    var root=JsonNode.Parse(state.GetRawText()) as JsonObject??new JsonObject();
    root["assetContexts"]=JsonNode.Parse(currentContexts.GetRawText());
    using var mergedDocument=JsonDocument.Parse(root.ToJsonString());
    mergedState=mergedDocument.RootElement.Clone();
   }
   catch(Exception ex)
   {
    Console.Error.WriteLine($"World source context preservation failed: {ex}");
    throw;
   }
  }

  var source=await Session.SaveWorldBuilderSourceAsync(mergedState);
  return new
  {
   success=source is not null,
   worldId=source?.WorldId??Session.WorldId,
   updatedAtUtc=source?.UpdatedAtUtc??""
  };
 }

 [JSInvokable]
 public async Task ReceiveWorldBuilderSelectionContextAsync(
  string placementId,
  string name,
  string assetId,
  string kind,
  int tier,
  int layer,
  double x,
  double y)
 {
  var shouldLoad=false;
  await InvokeAsync(() =>
  {
   var nextId=(placementId??"").Trim();
   var identityChanged=!string.Equals(_worldBuilderSelectionId,nextId,StringComparison.Ordinal);

   _worldBuilderSelectionId=nextId;
   _worldBuilderSelectionName=(name??"").Trim();
   _worldBuilderSelectionAssetId=(assetId??"").Trim();
   _worldBuilderSelectionKind=(kind??"").Trim();
   _worldBuilderSelectionTier=Math.Max(0,tier);
   _worldBuilderSelectionLayer=Math.Max(0,layer);
   _worldBuilderSelectionX=Math.Clamp(x,0,1);
   _worldBuilderSelectionY=Math.Clamp(y,0,1);

   if(identityChanged)
   {
    _contextLoadedIdentity="";
    _contextName="";
    _contextLore="";
    _contextHistory="";
    _contextNpcs="";
    _contextEncounters="";
    _contextNotes="";
    _contextStatus=_assetContextExpanded?"Loading context…":"";
    shouldLoad=_assetContextExpanded;
   }

   StateHasChanged();
  });

  if(shouldLoad)await LoadAssetContextAsync();
 }

