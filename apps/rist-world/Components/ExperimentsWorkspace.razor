 Task PressRight()
 {
  if(IsBuilderStage)
  {
   ToggleAssetContext();
   return Task.CompletedTask;
  }

  if(IsPathDrivenStage)
  {
   OpenPathTarget(CurrentPathTarget);
   return Task.CompletedTask;
  }

  if(RightActsAsBack)
  {
   GoBack();
   return Task.CompletedTask;
