 int DepthPipSheetCount=>Math.Clamp(Math.Min(_layer+1,6),1,6);

 string DepthPipSheetStyle(int sheet)
 {
  var tierLift=Math.Clamp(_tier,0,9)*3;
  var layerLift=sheet*5;
  var opacity=Math.Max(.32,1-(sheet*.11));
  return $"transform:translate3d({sheet*2}px,{-tierLift-layerLift}px,{sheet}px) rotateX(58deg);opacity:{opacity:0.00};";
 }

  string ReticleStyle=>$"left:{50+(_cursorX*.45):0.##}%;top:{50-(_cursorY*.45):0.##}%;";
 string AssetPreviewStyle=>$"left:calc(50% + {_assetX}px);top:calc(50% + {_assetY}px);transform:translate(-50%,-50%) scale({_assetScale:0.00}) rotate({_assetRotation}deg);";

 string GlassSheetStyle(int sheet)
 {
  var tierGap=_tier*44;
  var layerGap=sheet*11;
  var y=-(_tier*7+sheet*5);
  return $"transform:translateY({y}px) translateZ({tierGap+layerGap}px) rotateX(58deg);opacity:{Math.Max(.28,1-sheet*.07):0.00};";
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _selfRef=DotNetObjectReference.Create(this);
  try
  {
   await JS.InvokeVoidAsync("ristExperimentsUniversalInput.start",_selfRef,_analog,_leftSlider,_rightSlider);
   if(!_worldBuilderSourceAttached)
   {
    try
    {
     _worldBuilderSourceModule=await JS.InvokeAsync<IJSObjectReference>("import","./worldbuilder-source-host.js?v=20260928-canonical-spatial-1");
     await _worldBuilderSourceModule.InvokeVoidAsync("attach",_worldBuilderFrame,_selfRef);
     _worldBuilderSourceAttached=true;
    }
    catch(JSException){}
   }
   try
   {
    var stored=await JS.InvokeAsync<string?>("localStorage.getItem",AnalogPlacementStorageKey);
    if(stored is "left" or "center" or "right")
    {
     _analogPlacement=stored;
     _analogPlacementDraft=Array.IndexOf(AnalogPlacements,stored.ToUpperInvariant());
    }
   }
   catch{}
   await _shell.FocusAsync();
   await InvokeAsync(StateHasChanged);
  }
  catch(JSException)
  {
   _message="Universal keyboard, pointer and touch controls are ready. Gamepad adapter could not start.";
   StateHasChanged();
  }
 }

 void StepY(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _yControl=Math.Clamp(direction*100,-100,100);
  if(CursorMode)
  {
   _yPulse=Math.Clamp(_yPulse+direction,-99,99);
   _cursorY=Math.Clamp(_cursorY+(direction*7),-100,100);
   if(_stage==Stage.Move)
   {
    _assetY=Math.Clamp(_assetY-(direction*8),-160,160);
    _message=$"Cursor {_cursorX},{_cursorY}. Preview position {_assetX},{_assetY}.";
   }
   else _message=$"Cursor {_cursorX},{_cursorY}.";
   return;
  }
  ApplyY(direction);
 }

 void StepX(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _xControl=Math.Clamp(direction*100,-100,100);
  if(CursorMode)
  {
   _xPulse=Math.Clamp(_xPulse+direction,-99,99);
   _cursorX=Math.Clamp(_cursorX+(direction*7),-100,100);
   if(_stage==Stage.Move)
   {
    _assetX=Math.Clamp(_assetX+(direction*8),-200,200);
    _message=$"Cursor {_cursorX},{_cursorY}. Preview position {_assetX},{_assetY}.";
   }
   else _message=$"Cursor {_cursorX},{_cursorY}.";
   return;
  }
  ApplyX(direction);
 }

 void ApplyY(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _yPulse=Math.Clamp(_yPulse+direction,-99,99);

  switch(_stage)
  {
   case Stage.DeedSelect:
    _message="Shaelvien is fixed on the left. Use X or the right display to choose a deed or access action.";
    break;
   case Stage.PathSelect:
    if(IsShaelvienDeedHome)
     _message="World Builder is on the left and Context is on the right.";
    else
    {
     _pathIndex=Wrap(_pathIndex+direction,GameMasterPaths.Length);
     _message=$"GameMaster path: {CurrentGameMasterPath}.";
    }
    break;
   case Stage.ContextSelect:
    _message="Use X or the right display to choose History, Lore, or Truth.";
    break;
   case Stage.GameMasterHub:
    _worldIndex=Wrap(_worldIndex+direction,WorldChoices.Length);
    _message=$"World selector: {CurrentWorld}.";
    break;
   case Stage.GameMasterScope:
    _scopeIndex=Wrap(_scopeIndex+direction,Scopes.Length);
    _message=$"GameMaster suite: {CurrentScope}.";
    break;
   case Stage.SpatialSelect:
    _spatialSelectIndex=Wrap(_spatialSelectIndex+direction,SpatialOptionCount);
    _message=$"{CurrentBuilderScope}: {CurrentSpatialSelectionLabel}.";
    break;
   case Stage.SoftwareHub:
    _softwareIndex=Wrap(_softwareIndex+direction,SoftwareCapabilities.Length);
    _message=$"Capability adapter: {CurrentSoftware}.";
    break;
   case Stage.ControlSettings:
    _analogPlacementDraft=Wrap(_analogPlacementDraft+direction,AnalogPlacements.Length);
    _message=$"Analog placement: {CurrentAnalogPlacementDraft}.";
    break;
   case Stage.ArtMethod:
    _artMethodIndex=Wrap(_artMethodIndex+direction,ArtMethods.Length);
    _artPhaseIndex=0;
    _message=$"A/V method: {CurrentArtMethod}.";
    break;
   case Stage.ArtPhase:
    _message=$"{CurrentArtMethod} · {CurrentArtPhase}. Touch the left display to open the workbench.";
    break;
   case Stage.AssetKind:
    _assetSourceIndex=Wrap(_assetSourceIndex+direction,AssetSources.Length);
    _message=$"{_assetKind} source: {CurrentAssetSource}.";
    break;
   case Stage.WorldBuilderTier:
    _tier=Math.Clamp(_tier+direction,0,9);
    _=SyncWorldBuilderDepthAsync();
    _message=$"Tier {_tier}. The embedded canonical viewer is following this tier.";
    break;
   case Stage.WorldBuilderLayer:
    _layer=Math.Clamp(_layer+direction,0,99);
    _=SyncWorldBuilderDepthAsync();
    _message=$"Layer {_layer}. The embedded canonical viewer is following this layer.";
    break;
   case Stage.Scale:
    _assetScale=Math.Clamp(_assetScale+(direction*.1),.25,4);
    _message=$"Preview scale {_assetScale:0.00}×.";
    break;
   case Stage.Move:
    _assetY=Math.Clamp(_assetY-(direction*8),-160,160);
    _message=$"Preview position {_assetX},{_assetY}.";
    break;
   default:
    _message="Y is available; this Shaep does not currently bind it to another action.";
    break;
  }
 }

 void ApplyX(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _xPulse=Math.Clamp(_xPulse+direction,-99,99);

  if(IsPathDrivenStage&&!IsBuilderStage)
  {
   _pathMenuIndex=Wrap(_pathMenuIndex+direction,CurrentPathMenu.Length);
   _message=$"Path / journal: {CurrentPathTarget}.";
   return;
  }

  switch(_stage)
  {
   case Stage.DeedSelect:
    if(PathWorldCount>1)_worldIndex=Wrap(_worldIndex+direction,PathWorldCount);
    _message=$"Shaelvien GameMaster: {PathWorldLabel}.";
    break;
   case Stage.PathSelect:
    if(IsShaelvienDeedHome)
     _message="Context is the fixed right-side action for the selected deed.";
    else if(PathWorldCount>1)
    {
     _worldIndex=Wrap(_worldIndex+direction,PathWorldCount);
     _message=$"World: {PathWorldLabel}.";
    }
    else _message=HasPathWorlds?$"World: {PathWorldLabel}.":"Claim a deed to create your first world.";
    break;
   case Stage.ContextSelect:
    _pathMenuIndex=Wrap(_pathMenuIndex+direction,ContextPath.Length);
    _message=$"Context: {CurrentContextSelection}.";
    break;
   case Stage.GameMasterHub:
    _settingIndex=Wrap(_settingIndex+direction,Settings.Length);
    _message=$"Option: {CurrentSetting}.";
    break;
   case Stage.Rotate:
    _assetRotation=NormalizeDegrees(_assetRotation+(direction*5));
    _message=$"Preview rotation {_assetRotation}°.";
    break;
   case Stage.Move:
    _assetX=Math.Clamp(_assetX+(direction*8),-200,200);
    _message=$"Preview position {_assetX},{_assetY}.";
    break;
   default:
    _message="X is available; this Shaep does not currently bind it to another action.";
    break;
  }
 }

 async Task PressLeft()
 {
  switch(_stage)
  {
   case Stage.Environment:
     if(!_experimentStartRevealed)
     {
      _message="Press START first.";
      break;
     }
     _selectedEnvironment="SHAELVIEN";
     _analogButtonMode=false;
     _stage=Stage.Role;
     _message="Shaelvien selected. Choose Roleplayer or GameMaster.";
     break;
   case Stage.Role:
    _message="Roleplayer is reserved for the player-facing branch of this experiment.";
    break;
   case Stage.DeedSelect:
    _message="Shaelvien selected. Use the right display to choose a deed, Inspect, or Claim Deed.";
    break;
   case Stage.PathSelect:
    if(IsShaelvienDeedHome)
    {
     _pathIndex=0;
     BeginGameMasterPath();
     break;
    }
    if(!HasPathWorlds)
    {
     _message="Use the right display to Claim Deed before opening GameMaster tools.";
     break;
    }
    if(await ActivateCurrentPathWorldAsync())BeginGameMasterPath();
    break;
   case Stage.ContextSelect:
    GoBack();
    break;
   case Stage.GameMasterHub:
    _stage=Stage.GameMasterScope;
    _scopeIndex=0;
    _message=CurrentWorld=="NEW WORLD"
     ?"New World selected. Choose the GameMaster suite that will define it."
     :$"{CurrentWorld} selected. Choose a GameMaster suite.";
    break;
   case Stage.GameMasterScope:
    EnterScope();
    break;
   case Stage.SpatialSelect:
    await ActivateSpatialSelectionAsync();
    break;
   case Stage.SoftwareHub:
    _message=$"{CurrentSoftware} selected. Adapter contract placeholder only; no third-party UI or copied design is embedded.";
    break;
   case Stage.ControlSettings:
    _analogPlacement=CurrentAnalogPlacementDraft.ToLowerInvariant();
    _=PersistAnalogPlacementAsync();
    _stage=Stage.GameMasterHub;
    _message=$"Analog placement saved: {CurrentAnalogPlacementDraft}.";
    break;
   case Stage.ArtMethod:
    SelectArtMethod();
    break;
   case Stage.ArtPhase:
    _stage=Stage.ArtWork;
    _message=$"{CurrentArtMethod} · {CurrentArtPhase} workbench opened in the Viewer. Use the editor there; touch the left display to save this pass.";
    break;
   case Stage.ArtWork:
    SaveArtPass();
    break;
   case Stage.KnowledgeNode:
    _message=$"{_activeKnowledgeNode} is active in the journal/lore rail. Entry controls will be added here without leaving the persistent viewer.";
    break;
   case Stage.AssetKind:
    OpenSelectedAssetSource();
    break;
   case Stage.AssetMode:
    _assetMode="EDIT";
    _browseCursorActive=false;
    _stage=Stage.BrowsePlace;
    _message="Edit selected. Browse requests a source through the future image-tool adapter.";
    break;
   case Stage.BrowsePlace:
    _browseCursorActive=true;
    _analogButtonMode=false;
    _message=string.IsNullOrWhiteSpace(_selectedAssetKey)
     ?"Cursor active. Tap or press the analog over an asset once to select it, then again to place it."
     :$"{SelectedAssetName} is selected. Tap or press that asset again to place it.";
    break;
   case Stage.SaveCancel:
    {
     if(_assetSavePending)break;
     var savedScope=CurrentBuilderScope;
     var savedTier=_tier;
     var savedLayer=_layer;

     _assetSavePending=true;
     _message=$"Saving {_assetKind.ToLowerInvariant()}…";
     await InvokeAsync(StateHasChanged);

     var committed=await CommitCurrentAssetToCanonicalViewerAsync();
     _assetSavePending=false;
     if(!committed)
     {
      await InvokeAsync(StateHasChanged);
      break;
     }

     ResetAssetTransform();
     SetPathMenuToNext(savedScope);
     _stage=Stage.PathSelect;
     _pathIndex=0;
     _message=$"Saved {_assetKind.ToLowerInvariant()} at {savedScope} Tier {savedTier}, Layer {savedLayer}. Returned to {_selectedDeedName} GameMaster home.";
     await InvokeAsync(StateHasChanged);
     break;
    }
   case Stage.FullMapReview:
    _stage=Stage.GameMasterScope;
    _scopeIndex=Math.Clamp(_builderChainIndex,0,Math.Min(3,Scopes.Length-1));
    _message="Returned to the GameMaster Suite. Choose World Builder, Region Definer, Local, or Instance.";
    break;
   case Stage.WorldBuilderTier:
    _stage=Stage.WorldBuilderLayer;
    await SyncWorldBuilderDepthAsync();
    _message=$"Tier {_tier} selected. Choose Layer.";
    break;
   case Stage.WorldBuilderLayer:
    _stage=Stage.ArtMethod;
    _artMethodIndex=0;
    _artPhaseIndex=0;
    SetPathMenuToNext(CurrentBuilderScope);
    await SyncWorldBuilderDepthAsync();
    _message=$"Tier {_tier}, Layer {_layer}. Select an art method on the left. The right rail can jump to history, lore, regions, NPCs, encounters, or another path node.";
    break;
   case Stage.Scale:
    _stage=Stage.Rotate;
    _message=$"Scale {_assetScale:0.00}× selected. Use X to rotate; touch the left display to continue.";
    break;
   case Stage.Rotate:
    _stage=Stage.Move;
    _message=$"Rotation {_assetRotation}° set. Use X/Y to move; touch the left display to continue.";
    break;
   case Stage.Move:
    _stage=Stage.SaveCancel;
    _message="Position set. Touch the left display to save; Browser Back cancels.";
    break;
  }
  return;
 }

 void GoBack()
 {
  switch(_stage)
  {
   case Stage.Role:
    _stage=Stage.Environment;
    _message="Returned to environment selection.";
    break;
   case Stage.DeedSelect:
    _stage=Stage.Role;
    _message="Returned to Shaelvien role selection.";
    break;
   case Stage.PathSelect:
    if(IsShaelvienDeedHome)
    {
     _stage=Stage.DeedSelect;
     _worldIndex=0;
     _message="Returned to Shaelvien deeds and access.";
    }
    else
    {
     _stage=Stage.Role;
     _message="Returned to role selection.";
    }
    break;
   case Stage.ContextSelect:
    _stage=Stage.PathSelect;
    _pathIndex=0;
    _message=$"Returned to {_selectedDeedName}.";
    break;
   case Stage.GameMasterHub:
    _stage=Stage.Role;
    _message="Returned to Shaelvien role selection.";
    break;
   case Stage.GameMasterScope:
    if(string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase)&&!string.IsNullOrWhiteSpace(_selectedDeedName))
    {
     _stage=Stage.PathSelect;
     _pathIndex=0;
     _message=$"Returned to {_selectedDeedName}.";
    }
    else
    {
     _stage=Stage.GameMasterHub;
     _message="Returned to worlds and GameMaster options.";
    }
    break;
   case Stage.SpatialSelect:
    BackFromSpatialSelection();
    break;
   case Stage.SoftwareHub:
    _stage=Stage.GameMasterScope;
    _message="Returned to the GameMaster suite selector.";
    break;
   case Stage.ControlSettings:
    _analogPlacementDraft=Array.IndexOf(AnalogPlacements,_analogPlacement.ToUpperInvariant());
    if(_analogPlacementDraft<0)_analogPlacementDraft=1;
    _stage=Stage.GameMasterHub;
    _message="Analog placement unchanged.";
    break;
   case Stage.WorldBuilderTier:
    if(CurrentBuilderScope=="WORLD")
    {
     _stage=Stage.GameMasterScope;
     _message="Returned to the GameMaster suite selector.";
    }
    else
    {
     _stage=Stage.SpatialSelect;
     SelectActiveSpatialOption();
     _message=$"Returned to {CurrentBuilderScope} selection. {CurrentSpatialSelectionLabel}.";
    }
    break;
   case Stage.WorldBuilderLayer:
    _stage=Stage.WorldBuilderTier;
    _message=$"Returned to Tier {_tier}.";
    break;
   case Stage.ArtMethod:
    _stage=Stage.WorldBuilderLayer;
    _message=$"Returned to {CurrentBuilderScope} Layer {_layer}.";
    break;
   case Stage.ArtPhase:
    _stage=Stage.ArtMethod;
    _message="Returned to art-method selection.";
    break;
   case Stage.ArtWork:
    _stage=Stage.ArtPhase;
    _message=$"Returned to {CurrentArtMethod} · {CurrentArtPhase} tool selection.";
    break;
   case Stage.KnowledgeNode:
    if(IsDeedContextNode)
    {
     _stage=Stage.ContextSelect;
     _pathMenuIndex=Math.Max(0,Array.FindIndex(ContextPath,node=>string.Equals(node,_activeKnowledgeNode,StringComparison.OrdinalIgnoreCase)));
     _message=$"Returned to context for {_selectedDeedName}.";
    }
    else
    {
     _stage=Stage.FullMapReview;
     SetPathMenuToNode(_activeKnowledgeNode);
     _message=$"Returned to the recursive viewer from {_activeKnowledgeNode}.";
    }
    break;
   case Stage.AssetKind:
    _stage=Stage.ArtMethod;
    _message="Returned to art-method selection.";
    break;
   case Stage.AssetMode:
    _stage=Stage.AssetKind;
    _message="Returned to asset type and source.";
    break;
   case Stage.BrowsePlace:
    _browseCursorActive=false;
    _stage=Stage.AssetKind;
    _message=$"Returned from {_assetSource} to {_assetKind} source selection.";
    break;
   case Stage.Scale:
    _browseCursorActive=true;
    _stage=Stage.BrowsePlace;
    _message=$"Returned to {_assetSource} explorer. Cursor restored.";
    break;
   case Stage.Rotate:
    _stage=Stage.Scale;
    _message=$"Returned to scale {_assetScale:0.00}×.";
    break;
   case Stage.Move:
    _stage=Stage.Rotate;
    _message=$"Returned to rotation {_assetRotation}°.";
    break;
   case Stage.SaveCancel:
    _stage=Stage.Move;
    _message="Returned to placement.";
    break;
   case Stage.FullMapReview:
    _stage=Stage.GameMasterScope;
    _scopeIndex=Math.Clamp(_builderChainIndex,0,Math.Min(3,Scopes.Length-1));
    _message="Returned to the GameMaster Suite. The recursive viewer remains intact.";
    break;
  }
 }

 async Task PressRight()
 {
  if(IsDeedContextNode)
  {
   GoBack();
   return;
  }

  if(IsBuilderStage)
  {
   ToggleAssetContext();
   return;
  }

  if(IsPathDrivenStage)
  {
   OpenPathTarget(CurrentPathTarget);
   return;
  }

  if(RightActsAsBack)
  {
   GoBack();
   return;
  }

  switch(_stage)
  {
   case Stage.DeedSelect:
    {
     var selected=CurrentPathWorld;
     if(selected is null)break;
     if(await ActivateCurrentPathWorldAsync())
     {
      SetSelectedDeed(selected);
      _stage=Stage.PathSelect;
      _pathIndex=0;
      _pathMenuIndex=0;
      _message=$"{_selectedDeedName} selected. World Builder is on the left; Context is on the right.";
     }
     break;
    }
   case Stage.PathSelect:
    if(IsShaelvienDeedHome)
    {
     _pathIndex=1;
     _pathMenuIndex=0;
     _stage=Stage.ContextSelect;
     _message=$"Context for {_selectedDeedName}. Choose History, Lore, or Truth.";
    }
    else if(HasPathWorlds)
    {
     if(await ActivateCurrentPathWorldAsync())
      _message=$"{PathWorldLabel} selected. Touch the left display to open {CurrentGameMasterPath}.";
    }
    else await OpenControllerDeedAsync();
    break;
   case Stage.ContextSelect:
    _pathIndex=1;
    _activeKnowledgeNode=CurrentContextSelection;
    _stage=Stage.KnowledgeNode;
    _message=$"{CurrentContextSelection} opened for {_selectedDeedName}. Context does not change the selected spatial edit object.";
    break;
   case Stage.Environment:
     if(!_experimentStartRevealed)
     {
      _message="Press START first.";
      break;
     }
     _selectedEnvironment="RIST";
     _analogButtonMode=false;
     _stage=Stage.Role;
     _message="RIST selected. Choose Roleplayer or GameMaster.";
     break;
   case Stage.Role:
    await RefreshControllerWorldDirectoryAsync();
    if(string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase))
     await EnsureShaelvienEnvironmentAsync();
    _pathIndex=0;
    _pathMenuIndex=0;
    _worldIndex=0;
    _selectedDeedId="";
    _selectedDeedName="";
    _selectedDeedKind="";
    _stage=string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase)
     ?Stage.DeedSelect
     :Stage.PathSelect;
    _message=string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase)
     ?"GameMaster selected. Shaelvien is on the left; choose a deed, Inspect, or Claim Deed on the right."
     :"GameMaster selected. Choose World Builder or Context and a RIST world.";
    break;
   case Stage.GameMasterHub:
    if(CurrentSetting=="CONTROLS")
    {
     _analogPlacementDraft=Array.IndexOf(AnalogPlacements,_analogPlacement.ToUpperInvariant());
     if(_analogPlacementDraft<0)_analogPlacementDraft=1;
     _stage=Stage.ControlSettings;
     _message="Controls. Move the analog up or down to choose LEFT, CENTER, or RIGHT placement. Center is the default.";
    }
    else _message=$"{CurrentSetting} selected. Settings will use the same contextual-control pattern.";
    break;
   case Stage.ControlSettings:
    _analogPlacementDraft=Array.IndexOf(AnalogPlacements,_analogPlacement.ToUpperInvariant());
    if(_analogPlacementDraft<0)_analogPlacementDraft=1;
    _stage=Stage.GameMasterHub;
    _message="Analog placement unchanged.";
    break;
   case Stage.GameMasterScope:
    _stage=Stage.GameMasterHub;
    _message="Returned to worlds and GameMaster options.";
    break;
   case Stage.SpatialSelect:
    BackFromSpatialSelection();
    break;
   case Stage.SoftwareHub:
    _stage=Stage.GameMasterScope;
    _message="Returned to the GameMaster suite selector.";
    break;
   case Stage.WorldBuilderTier:
   case Stage.WorldBuilderLayer:
    GoBack();
    break;
   case Stage.AssetMode:
    _assetMode="ADD";
    _stage=Stage.BrowsePlace;
    _message=$"Add {_assetKind.ToLowerInvariant()} selected. Browse or Place.";
    break;
   case Stage.BrowsePlace:
    GoBack();
    break;
   case Stage.Scale:
    GoBack();
    break;
   case Stage.Rotate:
    _stage=Stage.Move;
    _message="Rotation set. Use X/Y to move.";
    break;
   case Stage.Move:
    _stage=Stage.SaveCancel;
    _message="Position set. Save or Cancel.";
    break;
   case Stage.SaveCancel:
    ResetAssetTransform();
    _stage=Stage.WorldBuilderTier;
    _message=$"Preview cancelled. Returned to {CurrentBuilderSuite} Tier.";
    break;
   case Stage.FullMapReview:
    OpenPathTarget(CurrentPathTarget);
    break;
  }
  return;
 }

 void BeginGameMasterPath()
 {
  _pathHistory.Clear();
  if(CurrentGameMasterPath=="CONTEXT")
  {
   _activeKnowledgeNode=ContextPath[0];
   _pathMenuIndex=0;
   _stage=Stage.KnowledgeNode;
   SetPathMenuToNext(_activeKnowledgeNode);
   _message="Context is separate from representation: History → Lore → Truth. Choose a context node without changing the selected world depth.";
   return;
  }

  _stage=Stage.GameMasterScope;
  _scopeIndex=0;
  _message="World Builder is selection-first: World → Region → Local → Instance → Campaign. Region, Local, and Instance must be selected before Tier or Layer editing unlocks.";
 }

 void SelectArtMethod()
 {
  _artPhaseIndex=0;
  _artToolIndex=0;

  switch(CurrentArtMethod)
  {
   case "IMAGES":
    PrepareAssetSource("IMAGE");
    _message=$"{CurrentBuilderScope} images. Choose from Game Images, My Images, or Upload; existing images and new uploads use the same image path.";
    break;
   case "SPRITE":
    PrepareAssetSource("SPRITE");
    _message=$"{CurrentBuilderScope} sprite. Slide the left display through Game Sprites, My Sprites, or Upload; the right rail still jumps through the GameMaster path.";
    break;
   case "DRAW":
   case "CAD":
   case "AUDIO":
   case "VIDEO":
    _stage=Stage.ArtPhase;
    _message=$"{CurrentArtMethod} begins with {CurrentArtPhase}. Save each pass before moving to the next phase; the tool-specific controls will be added here as each adapter is wired.";
    break;
  }
 }

 void SaveArtPass()
 {
  var savedPhase=CurrentArtPhase;
  var savedTool=CurrentArtPhase;

  if(_artPhaseIndex+1<CurrentArtPhases.Length)
  {
   _artPhaseIndex++;
   _artToolIndex=0;
   _stage=Stage.ArtPhase;
   _message=$"{savedPhase} saved. Next: {CurrentArtPhase}. Open the next workbench pass on the left; the path/journal rail remains on the right.";
   return;
  }

  SetPathMenuToNext(CurrentBuilderScope);
  _stage=Stage.FullMapReview;
  _message=$"{CurrentArtMethod} {savedPhase.ToLowerInvariant()} pass saved. Full-map review is active; continue here or jump along the GameMaster path.";
 }

 void PrepareAssetSource(string kind)
 {
  _browseCursorActive=false;
  _assetKind=kind;
  _assetKindIndex=Array.IndexOf(AssetKinds,kind);
  if(_assetKindIndex<0)_assetKindIndex=0;
  _assetSourceIndex=0;
  _assetSource=CurrentAssetSource;
  _selectedAssetKey="";
  _assetLoadError="";
  _stage=Stage.AssetKind;
 }

 void OpenSelectedAssetSource()
 {
  _browseCursorActive=false;
  _assetSource=CurrentAssetSource;
  _selectedAssetKey="";
  _assetLoadError="";
  _stage=Stage.BrowsePlace;

  if(IsMyAssetSource)_=LoadMyAssetsAsync();
  else if(IsGameAssetSource)LoadGameAssets();

  _message=_assetSource=="UPLOAD"
   ?$"Upload explorer opened for {_assetKind.ToLowerInvariant()} assets. Choose from this device; uploads are added to My {_assetKind.ToLowerInvariant()}s."
   :$"{_assetSource} explorer opened. Use the cursor or touch; left display selects and right display returns.";
 }

 static int BuilderIndexForNode(string node)=>node switch
 {
  "WORLD"=>0,
  "REGION"=>1,
  "LOCAL"=>2,
  "INSTANCE"=>3,
  _=>-1
 };

 string CurrentPathNode=>_stage==Stage.KnowledgeNode&&!string.IsNullOrWhiteSpace(_activeKnowledgeNode)
  ?_activeKnowledgeNode
  :CurrentBuilderScope;

 void OpenPathTarget(string target)
 {
  if(string.Equals(target,"BACK",StringComparison.OrdinalIgnoreCase))
  {
   NavigatePathBack();
   return;
  }

  var current=CurrentPathNode;
  if(!string.IsNullOrWhiteSpace(current)&&!string.Equals(current,target,StringComparison.OrdinalIgnoreCase))
   _pathHistory.Push(current);

  OpenPathNode(target);
 }

 void NavigatePathBack()
 {
  switch(_stage)
  {
   case Stage.ArtWork:
    _stage=Stage.ArtPhase;
    _message=$"Back to {CurrentArtMethod} · {CurrentArtPhase} tool selection.";
    return;
   case Stage.ArtPhase:
   case Stage.AssetKind:
    _stage=Stage.ArtMethod;
    _message="Back to art-method selection.";
    return;
   case Stage.ArtMethod:
    _stage=Stage.WorldBuilderLayer;
    _message=$"Back to {CurrentBuilderScope} Layer {_layer}.";
    return;
   case Stage.WorldBuilderLayer:
    _stage=Stage.WorldBuilderTier;
    _message=$"Back to {CurrentBuilderScope} Tier {_tier}.";
    return;
   case Stage.WorldBuilderTier:
    if(CurrentBuilderScope=="WORLD")
    {
     _stage=Stage.PathSelect;
     _message="Returned to GameMaster path selection.";
    }
    else
    {
     _stage=Stage.SpatialSelect;
     SelectActiveSpatialOption();
     _message=$"Returned to {CurrentBuilderScope} selection.";
    }
    return;
   case Stage.SpatialSelect:
    BackFromSpatialSelection();
    return;
  }

  if(_pathHistory.Count>0)
  {
   var previous=_pathHistory.Pop();
   OpenPathNode(previous);
   return;
  }

  _stage=Stage.PathSelect;
  _message="Returned to GameMaster path selection.";
 }

 void OpenPathNode(string target)
 {
  var builderIndex=BuilderIndexForNode(target);
  if(builderIndex>=0)
  {
   BeginBuilderScope(builderIndex);
   SetPathMenuToNext(target);
   _message=$"{CurrentBuilderSuite} opened from the {CurrentGameMasterPath} path. The recursive viewer remains visible.";
   return;
  }

  _activeKnowledgeNode=target;
  _stage=Stage.KnowledgeNode;
  SetPathMenuToNext(target);
  _message=$"{target} opened in the journal/lore rail. The map remains visible behind it; entry controls will be added without breaking the path.";
 }

 void SetPathMenuToNode(string node)
 {
  var menu=CurrentPathMenu;
  var index=Array.FindIndex(menu,item=>string.Equals(item,node,StringComparison.OrdinalIgnoreCase));
  _pathMenuIndex=index>=0?index:0;
 }

 void SetPathMenuToNext(string node)
 {
  var path=CurrentGuidedPath;
  var index=Array.FindIndex(path,item=>string.Equals(item,node,StringComparison.OrdinalIgnoreCase));
  if(index>=0&&index+1<path.Length)SetPathMenuToNode(path[index+1]);
  else if(index>=0)SetPathMenuToNode(path[index]);
  else _pathMenuIndex=0;
 }

 void EnterScope()
 {
  var builderIndex=Array.IndexOf(BuilderSuiteNames,CurrentScope);
  if(builderIndex>=0)
  {
   BeginBuilderScope(builderIndex);
   return;
  }

  if(CurrentScope=="CAMPAIGN")
  {
   _activeKnowledgeNode="CAMPAIGN";
   _stage=Stage.KnowledgeNode;
   _message="Campaign context opened for the currently selected world hierarchy.";
   return;
  }

  _message=$"{CurrentScope} is registered in the GameMaster flowchart.";
 }

 void BeginBuilderScope(int index)
 {
  index=Math.Clamp(index,0,BuilderChain.Length-1);

  // Selection-first hierarchy: a Local cannot be edited until a Region is
  // selected, and an Instance cannot be edited until its Local is selected.
  if(index>=2&&Session.ActiveSpatialRegion is null)index=1;
  if(index>=3&&Session.ActiveLocal is null)index=2;

  _builderChainIndex=index;
  _assetScope=CurrentBuilderScope;
  _tier=0;
  _layer=0;
  _assetKind="IMAGE";
  _assetKindIndex=0;
  _artMethodIndex=0;
  _artPhaseIndex=0;
  _artToolIndex=0;
  _assetSourceIndex=0;
  _assetSource="GAME IMAGES";
  _selectedAssetKey="";
  _assetLoadError="";
  _gameAssets.Clear();
  _myAssets.Clear();

  if(CurrentBuilderScope=="WORLD")
  {
   _stage=Stage.WorldBuilderTier;
   _message="World selected. Choose Tier, then Layer.";
   _=SyncWorldBuilderDepthAsync();
   return;
  }

  _stage=Stage.SpatialSelect;
  SelectActiveSpatialOption();
  _message=CurrentBuilderScope switch
  {
   "REGION"=>"Select a Region before editing its Tier or Layer.",
   "LOCAL"=>"Select a Local inside the active Region before editing its Tier or Layer.",
   "INSTANCE"=>"Select an Instance inside the active Local before editing its Tier or Layer.",
   _=>$"Select {CurrentBuilderScope} before editing."
  };
 }

 void SelectActiveSpatialOption()
 {
  var activeId=CurrentBuilderScope switch
  {
   "REGION"=>Session.ActiveSpatialRegion?.NodeId??"",
   "LOCAL"=>Session.ActiveLocal?.NodeId??"",
   "INSTANCE"=>Session.ActiveInstance?.NodeId??"",
   _=>""
  };
  if(string.IsNullOrWhiteSpace(activeId))
  {
   _spatialSelectIndex=Math.Max(0,CurrentSpatialOptions.Count);
   return;
  }
  var index=CurrentSpatialOptions.ToList().FindIndex(node=>string.Equals(node.NodeId,activeId,StringComparison.Ordinal));
  _spatialSelectIndex=index>=0?index:Math.Max(0,CurrentSpatialOptions.Count);
 }

 async Task ActivateSpatialSelectionAsync()
 {
  if(CurrentBuilderScope is not ("REGION" or "LOCAL" or "INSTANCE"))
  {
   _stage=Stage.WorldBuilderTier;
   await SyncWorldBuilderDepthAsync();
   return;
  }

  if(CurrentBuilderScope=="LOCAL"&&Session.ActiveSpatialRegion is null)
  {
   BeginBuilderScope(1);
   _message="Select a Region first. Local editing remains locked until then.";
   return;
  }
  if(CurrentBuilderScope=="INSTANCE"&&Session.ActiveLocal is null)
  {
   BeginBuilderScope(2);
   _message="Select a Local first. Instance editing remains locked until then.";
   return;
  }

  try
  {
   WorldSpatialNode? node=CurrentSpatialOption;
   if(SpatialOptionIsNew)
   {
    var suggested=CurrentBuilderScope switch
    {
     "REGION"=>"New Region",
     "LOCAL"=>"New Local",
     "INSTANCE"=>"New Instance",
     _=>"New"
    };
    var name=await JS.InvokeAsync<string?>("prompt",$"Name this {CurrentBuilderScope.ToLowerInvariant()}",suggested);
    name=(name??"").Trim();
    if(name.Length==0)
    {
     _message=$"{CurrentBuilderScope} creation cancelled.";
     return;
    }
    node=await Session.CreateSpatialNodeAsync(CurrentBuilderScope,name);
   }
   else if(node is not null)
   {
    switch(CurrentBuilderScope)
    {
     case "REGION":Session.SetActiveSpatialRegion(node.NodeId);break;
     case "LOCAL":Session.SetActiveLocal(node.NodeId);break;
     case "INSTANCE":Session.SetActiveInstance(node.NodeId);break;
    }
   }

   if(node is null)return;
   _spatialSelectIndex=CurrentSpatialOptions.ToList().FindIndex(item=>string.Equals(item.NodeId,node.NodeId,StringComparison.Ordinal));
   if(_spatialSelectIndex<0)_spatialSelectIndex=0;
   _stage=Stage.WorldBuilderTier;
   await SyncWorldBuilderDepthAsync();
   _message=$"{CurrentBuilderScope} selected: {node.Name}. Choose Tier, then Layer.";
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Spatial selection failed: {ex}");
   _message=ex.Message;
  }
 }

 void BackFromSpatialSelection()
 {
  if(CurrentBuilderScope=="INSTANCE")
  {
   BeginBuilderScope(2);
   return;
  }
  if(CurrentBuilderScope=="LOCAL")
  {
   BeginBuilderScope(1);
   return;
  }
  _stage=Stage.GameMasterScope;
  _scopeIndex=Math.Clamp(_builderChainIndex,0,Math.Min(3,Scopes.Length-1));
  _message="Returned to the GameMaster suite selector.";
 }

