@using Microsoft.AspNetCore.Components.Web

<section class="experiments-shell"
         tabindex="0"
         @onkeydown="HandleKeyDown"
         aria-label="Shaelvien experiments">
 <section class="experiments-viewer" aria-label="Viewer">
  <div class="experiments-viewer-world" aria-hidden="true"></div>
  <div class="experiments-viewer-shade" aria-hidden="true"></div>
  <div class="experiments-viewer-label">VIEWER</div>
  <div class="experiments-reticle @(_selected ? "selected" : "")" style="@ReticleStyle" aria-hidden="true">
   <span></span>
  </div>
 </section>

 <section class="experiments-controller" aria-label="Controller">
  <div class="experiments-axis experiments-axis-y">
   <div class="experiments-axis-copy">
    <strong>Y AXIS</strong>
    <small>UP ↕ DOWN</small>
   </div>
   <button type="button"
           class="experiments-action"
           aria-pressed="@_selected"
           @onclick="ToggleSelect">SELECT</button>
   <div class="experiments-y-slider-wrap">
    <input class="experiments-slider experiments-slider-y"
           type="range"
           min="-100"
           max="100"
           step="1"
           aria-label="Y axis, up and down"
           @bind="_y"
           @bind:event="oninput" />
   </div>
  </div>

  <div class="experiments-tool-display" role="status" aria-live="polite">
   <div class="experiments-tool-grid" aria-hidden="true"></div>
   <div class="experiments-tool-content">
    <small>DISPLAY</small>
    <strong>@(_running ? "RUNNING" : _selected ? "SELECTED" : "READY")</strong>
    <div class="experiments-coordinates">
     <span>X @_x</span>
     <span>Y @_y</span>
    </div>
    <p>@ToolMessage</p>
   </div>
  </div>

  <div class="experiments-axis experiments-axis-x">
   <div class="experiments-axis-copy">
    <strong>X AXIS</strong>
    <small>LEFT ↔ RIGHT</small>
   </div>
   <button type="button"
           class="experiments-action experiments-start"
           aria-pressed="@_running"
           @onclick="ToggleStart">START</button>
   <div class="experiments-x-slider-wrap">
    <input class="experiments-slider experiments-slider-x"
           type="range"
           min="-100"
           max="100"
           step="1"
           aria-label="X axis, left and right"
           @bind="_x"
           @bind:event="oninput" />
   </div>
  </div>
 </section>
</section>

<style>
 .experiments-shell{
  position:fixed;
  inset:0;
  z-index:2147483200;
  box-sizing:border-box;
  width:100vw;
  height:100dvh;
  padding:2.5dvh 2.5vw;
  display:grid;
  grid-template-rows:75dvh 20dvh;
  background:
   radial-gradient(circle at 18% 8%,rgba(26,83,151,.20),transparent 32%),
   radial-gradient(circle at 82% 9%,rgba(176,119,34,.18),transparent 31%),
   #02070d;
  color:#efe6cf;
  overflow:hidden;
  outline:none;
 }
 .experiments-viewer,
 .experiments-controller{
  position:relative;
  box-sizing:border-box;
  min-width:0;
  min-height:0;
  border:1px solid #c99f48;
  background:#050d14;
  box-shadow:inset 0 0 0 1px rgba(255,223,150,.08),0 12px 34px #0008;
 }
 .experiments-viewer{
  overflow:hidden;
  border-radius:18px 18px 8px 8px;
 }
 .experiments-viewer-world{
  position:absolute;
  inset:0;
  background:
   linear-gradient(180deg,rgba(1,5,12,.02),rgba(1,5,12,.18)),
   url('assets/branding/shaelvien-dragon-creation-startup-screen.png') center/cover no-repeat;
  transform:scale(1.015);
 }
 .experiments-viewer-shade{
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
   linear-gradient(180deg,rgba(0,0,0,.15),transparent 12%,transparent 84%,rgba(0,0,0,.24)),
   radial-gradient(circle at center,transparent 54%,rgba(1,6,12,.25) 100%);
 }
 .experiments-viewer-label{
  position:absolute;
  top:10px;
  left:50%;
  transform:translateX(-50%);
  padding:5px 18px 6px;
  border:1px solid rgba(211,172,91,.72);
  border-radius:999px;
  background:rgba(4,12,19,.78);
  color:#f1dc9f;
  font:800 clamp(9px,1vw,13px)/1 system-ui,-apple-system,sans-serif;
  letter-spacing:.28em;
  pointer-events:none;
 }
 .experiments-reticle{
  position:absolute;
  width:clamp(38px,4vw,62px);
  aspect-ratio:1;
  border:1px solid rgba(112,211,255,.84);
  border-radius:50%;
  transform:translate(-50%,-50%);
  box-shadow:0 0 22px rgba(59,167,255,.42);
  pointer-events:none;
  transition:left .08s linear,top .08s linear;
 }
 .experiments-reticle:before,
 .experiments-reticle:after{
  content:"";
  position:absolute;
  background:rgba(112,211,255,.8);
 }
 .experiments-reticle:before{left:50%;top:-12px;bottom:-12px;width:1px}
 .experiments-reticle:after{top:50%;left:-12px;right:-12px;height:1px}
 .experiments-reticle span{
  position:absolute;
  inset:36%;
  border-radius:50%;
  background:#73dcff;
  box-shadow:0 0 14px #2aa9ff;
 }
 .experiments-reticle.selected{
  border-color:#f4d784;
  box-shadow:0 0 0 2px rgba(244,215,132,.16),0 0 28px rgba(244,215,132,.55);
 }
 .experiments-controller{
  border-top:0;
  border-radius:8px 8px 18px 18px;
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(180px,1.15fr) minmax(0,1fr);
  align-items:stretch;
  overflow:hidden;
 }
 .experiments-axis,
 .experiments-tool-display{
  min-width:0;
  min-height:0;
 }
 .experiments-axis{
  position:relative;
  display:grid;
  align-items:center;
  justify-items:center;
  gap:4px;
  padding:7px 10px;
  background:
   radial-gradient(circle at center,rgba(19,84,137,.16),transparent 64%),
   rgba(3,10,16,.92);
 }
 .experiments-axis-y{
  grid-template-columns:minmax(88px,1fr) minmax(46px,.48fr);
  grid-template-rows:auto 1fr;
  border-right:1px solid rgba(201,159,72,.48);
 }
 .experiments-axis-x{
  grid-template-columns:1fr;
  grid-template-rows:auto auto 1fr;
  border-left:1px solid rgba(201,159,72,.48);
 }
 .experiments-axis-copy{
  display:grid;
  justify-items:center;
  gap:2px;
  color:#f0d99d;
  text-align:center;
 }
 .experiments-axis-y .experiments-axis-copy{grid-column:1;grid-row:1}
 .experiments-axis-copy strong{
  font:700 clamp(10px,1.15vw,16px)/1 Georgia,serif;
  letter-spacing:.14em;
 }
 .experiments-axis-copy small{
  color:#d9b655;
  font:800 clamp(7px,.8vw,10px)/1 system-ui,-apple-system,sans-serif;
  letter-spacing:.11em;
 }
 .experiments-action{
  width:min(100%,150px);
  min-height:30px;
  padding:5px 10px;
  border:1px solid #d0aa59;
  border-radius:8px;
  background:linear-gradient(180deg,#1c3454,#0a1730);
  color:#f1d98d;
  font:900 clamp(9px,.95vw,13px)/1 system-ui,-apple-system,sans-serif;
  letter-spacing:.11em;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);
  touch-action:manipulation;
 }
 .experiments-action[aria-pressed="true"]{
  color:#8fe7ff;
  border-color:#6ddcff;
  box-shadow:0 0 18px rgba(75,194,255,.35),inset 0 0 0 1px rgba(255,255,255,.08);
 }
 .experiments-axis-y .experiments-action{grid-column:1;grid-row:2;align-self:start}
 .experiments-y-slider-wrap{
  grid-column:2;
  grid-row:1/3;
  width:100%;
  height:100%;
  display:grid;
  place-items:center;
 }
 .experiments-x-slider-wrap{
  width:100%;
  display:grid;
  place-items:center;
  align-self:center;
 }
 .experiments-slider{
  accent-color:#45c6ff;
  touch-action:none;
 }
 .experiments-slider-y{
  width:12dvh;
  min-width:80px;
  max-width:150px;
  transform:rotate(-90deg);
  transform-origin:center;
 }
 .experiments-slider-x{
  width:min(88%,240px);
 }
 .experiments-slider:focus-visible{
  outline:2px solid #ffe7a9;
  outline-offset:4px;
 }
 .experiments-tool-display{
  position:relative;
  margin:7px;
  border:1px solid #3da9e8;
  border-radius:10px;
  overflow:hidden;
  display:grid;
  place-items:center;
  background:linear-gradient(180deg,#071932,#03111f);
  box-shadow:inset 0 0 22px rgba(29,117,181,.24),0 0 16px rgba(17,105,173,.15);
 }
 .experiments-tool-grid{
  position:absolute;
  inset:0;
  opacity:.32;
  background-image:
   linear-gradient(rgba(72,183,255,.18) 1px,transparent 1px),
   linear-gradient(90deg,rgba(72,183,255,.18) 1px,transparent 1px);
  background-size:18px 18px;
 }
 .experiments-tool-content{
  position:relative;
  z-index:1;
  width:100%;
  height:100%;
  box-sizing:border-box;
  display:grid;
  place-content:center;
  justify-items:center;
  gap:3px;
  padding:8px;
  text-align:center;
 }
 .experiments-tool-content>small{
  color:#72ccff;
  font:800 8px/1 system-ui,-apple-system,sans-serif;
  letter-spacing:.2em;
 }
 .experiments-tool-content>strong{
  color:#e7d18d;
  font:800 clamp(11px,1.2vw,16px)/1 system-ui,-apple-system,sans-serif;
  letter-spacing:.12em;
 }
 .experiments-coordinates{
  display:flex;
  gap:12px;
  color:#95dbff;
  font:800 clamp(8px,.85vw,11px)/1 ui-monospace,SFMono-Regular,Menlo,monospace;
 }
 .experiments-tool-content p{
  margin:0;
  color:#a8bac5;
  font:700 clamp(7px,.75vw,9px)/1.25 system-ui,-apple-system,sans-serif;
 }
 @media(max-width:700px){
  .experiments-shell{padding:2.5dvh 2.5vw}
  .experiments-controller{grid-template-columns:minmax(0,.95fr) minmax(112px,1.1fr) minmax(0,.95fr)}
  .experiments-axis{padding:6px 5px}
  .experiments-axis-y{grid-template-columns:1fr 40px}
  .experiments-action{min-height:34px;padding:5px 6px}
  .experiments-slider-y{min-width:68px;width:10dvh}
  .experiments-tool-content p{display:none}
 }
 @media(max-width:430px){
  .experiments-controller{grid-template-columns:minmax(0,.92fr) minmax(92px,1fr) minmax(0,.92fr)}
  .experiments-axis-copy strong{font-size:9px}
  .experiments-axis-copy small{font-size:6px;letter-spacing:.04em}
  .experiments-action{font-size:8px;letter-spacing:.05em}
  .experiments-coordinates{flex-direction:column;gap:2px}
  .experiments-tool-content>small{font-size:6px}
  .experiments-tool-content>strong{font-size:9px}
 }
 @media(orientation:landscape) and (max-height:560px){
  .experiments-viewer-label{top:5px;padding:3px 12px;font-size:8px}
  .experiments-action{min-height:24px}
  .experiments-axis{padding:3px 6px}
  .experiments-tool-display{margin:3px}
 }
 @media(prefers-reduced-motion:reduce){
  .experiments-reticle{transition:none}
 }
</style>

@code {
 [Parameter] public EventCallback OnExit { get; set; }

 int _x;
 int _y;
 bool _selected;
 bool _running;

 string ReticleStyle => $"left:{50 + (_x * 0.35):0.##}%;top:{50 - (_y * 0.35):0.##}%;";
 string ToolMessage => _running
  ? "Controller output active."
  : _selected
   ? "Selection held for tool input."
   : "Tools ready.";

 void ToggleSelect() => _selected = !_selected;
 void ToggleStart() => _running = !_running;

 async Task HandleKeyDown(KeyboardEventArgs e)
 {
  if (e.Key == "Escape" && OnExit.HasDelegate)
  {
   await OnExit.InvokeAsync();
   return;
  }

  switch(e.Key)
  {
   case "ArrowLeft": _x = Math.Max(-100, _x - 1); break;
   case "ArrowRight": _x = Math.Min(100, _x + 1); break;
   case "ArrowUp": _y = Math.Min(100, _y + 1); break;
   case "ArrowDown": _y = Math.Max(-100, _y - 1); break;
  }
 }
}
