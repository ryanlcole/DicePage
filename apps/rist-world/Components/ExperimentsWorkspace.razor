@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorldSession Session

<section class="experiments-shell"
         tabindex="0"
         @ref="_shell"
         @onkeydown="HandleKeyDown"
         aria-label="RIST universal GameMaster Suite experiment">

 <main class="experiments-viewer" aria-label="Viewer">
  <div class="viewer-world @ViewerClass" aria-hidden="true"></div>
  <div class="viewer-shade" aria-hidden="true"></div>

  @if(IsDepthStage)
  {
   <div class="glass-stage" aria-hidden="true">
    @for(var sheet=0;sheet<VisibleGlassSheets;sheet++)
    {
     <span class="glass-sheet" style="@GlassSheetStyle(sheet)"></span>
    }
   </div>
  }

  @if(IsAssetTransformStage)
  {
   <div class="asset-preview @(_assetKind=="SPRITE"?"sprite":"image")"
        style="@AssetPreviewStyle"
        aria-hidden="true">
    <span>@_assetKind</span>
   </div>
  }

  @if(_savedAsset)
  {
   <div class="ironed-asset" aria-hidden="true"><span>@_assetKind</span></div>
  }

  <header class="viewer-title">
   <span>VIEWER</span>
  </header>

  <div class="viewer-status" role="status" aria-live="polite">
   <strong>@ViewerTitle</strong>
   <span>@_message</span>
  </div>

  <footer class="viewer-readout">
   <span>X @_xPulse</span>
   <span>Y @_yPulse</span>
   <span>@StagePath</span>
  </footer>
 </main>

 <section class="experiments-controller" aria-label="Controller">
  <section class="experiments-controls experiments-axis experiments-axis-y left-controls" aria-label="Left universal controls">
   <div class="experiments-axis-copy">
    <strong>Y AXIS</strong>
    <small>@LeftAxisHint</small>
   </div>
   <button type="button"
           class="experiments-action"
           @onclick="PressLeft">@LeftButtonLabel</button>
   <div class="experiments-y-slider-wrap">
    <input class="experiments-slider experiments-slider-y"
           type="range"
           min="-100"
           max="100"
           step="1"
           value="@_yControl"
           @oninput="HandleYSlider"
           aria-label="Y axis, up and down" />
   </div>
  </section>

  <section class="experiments-center-display" aria-label="Context display" role="status" aria-live="polite">
   <div class="display-grid" aria-hidden="true"></div>
   <div class="center-display-content">
    <small>DISPLAY</small>
    @if(_stage==Stage.GameMasterHub)
    {
     <strong>@CurrentWorld</strong>
     <span>@CurrentSetting</span>
    }
    else if(_stage==Stage.SoftwareHub)
    {
     <strong>@CurrentSoftware</strong>
     <span>CAPABILITY ADAPTER</span>
    }
    else
    {
     <strong>@ViewerTitle</strong>
     <span>@LeftLabel · @RightLabel</span>
    }
    <div class="display-coordinates">
     <b>X @_xPulse</b>
     <b>Y @_yPulse</b>
    </div>
   </div>
  </section>

  <section class="experiments-controls experiments-axis experiments-axis-x right-controls" aria-label="Right universal controls">
   <div class="experiments-axis-copy">
    <strong>X AXIS</strong>
    <small>@RightAxisHint</small>
   </div>
   <button type="button"
           class="experiments-action experiments-start"
           @onclick="PressRight">@RightButtonLabel</button>
   <div class="experiments-x-slider-wrap">
    <input class="experiments-slider experiments-slider-x"
           type="range"
           min="-100"
           max="100"
           step="1"
           value="@_xControl"
           @oninput="HandleXSlider"
           aria-label="X axis, left and right" />
   </div>
  </section>
 </section>
</section>

@code {
 [Parameter] public EventCallback OnExit { get; set; }
 [Parameter] public IReadOnlyList<AccountWorldReference> Worlds { get; set; } = Array.Empty<AccountWorldReference>();

 enum Stage
 {
  Environment,
  Role,
  GameMasterHub,
  GameMasterScope,
  SoftwareHub,
  WorldBuilderTier,
  WorldBuilderLayer,
  AssetKind,
  AssetMode,
  BrowsePlace,
  Scale,
  Rotate,
  Move,
  SaveCancel
 }

 ElementReference _shell;
 DotNetObjectReference<ExperimentsWorkspace>? _selfRef;
 Stage _stage=Stage.Environment;
 int _worldIndex;
 int _settingIndex;
 int _scopeIndex;
 int _softwareIndex;
 int _tier;
 int _layer;
 int _xPulse;
 int _yPulse;
 int _xControl;
 int _yControl;
 double _assetScale=1;
 int _assetRotation;
 int _assetX;
 int _assetY;
 string _assetKind="IMAGE";
 string _assetMode="ADD";
 bool _savedAsset;
 string _message="Choose an environment. Hardware translates into the same X, Y, left and right semantic controls.";

 static readonly string[] Settings=["GRAPHICS","LANGUAGE","ACCESSIBILITY","CONTROLS","AUDIO","DISPLAY","NETWORK","ACCOUNT","HELP"];
 static readonly string[] Scopes=["WORLD BUILDER","REGION DEFINER","LOCAL","INSTANCE","TABLETOP","SOFTWARE"];
 static readonly string[] SoftwareCapabilities=["IMAGE EDITOR","STREAM / RECORD","NOTES / DATABASE","AUDIO","BROWSER","COMMUNICATION","AUTOMATION"];

 string[] WorldChoices
 {
  get
  {
   var names=Worlds
    .Where(world=>!string.IsNullOrWhiteSpace(world.DisplayName))
    .OrderByDescending(world=>world.UpdatedAtUtc)
    .Select(world=>world.DisplayName.Trim().ToUpperInvariant())
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();

   if(Session.HasActiveWorld&&!names.Any(name=>string.Equals(name,Session.WorldDisplayName,StringComparison.OrdinalIgnoreCase)))
    names.Insert(0,Session.WorldDisplayName.ToUpperInvariant());

   names.Add("NEW WORLD");
   return names.ToArray();
  }
 }

 int WorldIndex=>Math.Clamp(_worldIndex,0,WorldChoices.Length-1);
 string CurrentWorld=>WorldChoices[WorldIndex];
 string PreviousWorld=>WorldChoices[(WorldIndex-1+WorldChoices.Length)%WorldChoices.Length];
 string NextWorld=>WorldChoices[(WorldIndex+1)%WorldChoices.Length];
 string CurrentSetting=>Settings[_settingIndex];
 string PreviousSetting=>Settings[(_settingIndex-1+Settings.Length)%Settings.Length];
 string NextSetting=>Settings[(_settingIndex+1)%Settings.Length];
 string CurrentScope=>Scopes[_scopeIndex];
 string CurrentSoftware=>SoftwareCapabilities[_softwareIndex];
 string PreviousSoftware=>SoftwareCapabilities[(_softwareIndex-1+SoftwareCapabilities.Length)%SoftwareCapabilities.Length];
 string NextSoftware=>SoftwareCapabilities[(_softwareIndex+1)%SoftwareCapabilities.Length];

 bool IsDepthStage=>_stage is Stage.WorldBuilderTier or Stage.WorldBuilderLayer;
 bool IsAssetTransformStage=>_stage is Stage.BrowsePlace or Stage.Scale or Stage.Rotate or Stage.Move or Stage.SaveCancel;
 int VisibleGlassSheets=>Math.Clamp(_layer+1,1,8);
 string ViewerClass=>IsDepthStage||_stage is Stage.AssetKind or Stage.AssetMode or Stage.BrowsePlace or Stage.Scale or Stage.Rotate or Stage.Move or Stage.SaveCancel?"builder":"";

 string LeftAxisHint=>_stage switch
 {
  Stage.GameMasterHub=>"Y · WORLDS",
  Stage.GameMasterScope=>"Y · SUITES",
  Stage.SoftwareHub=>"Y · CAPABILITIES",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"Y · DEPTH",
  Stage.Scale=>"Y · SCALE",
  Stage.Move=>"Y · MOVE",
  _=>"Y · NAVIGATE"
 };

 string RightAxisHint=>_stage switch
 {
  Stage.GameMasterHub=>"X · OPTIONS",
  Stage.Rotate=>"X · ROTATE",
  Stage.Move=>"X · MOVE",
  _=>"X · NAVIGATE"
 };

 string LeftEyebrow=>_stage switch
 {
  Stage.Environment=>"ENVIRONMENT",
  Stage.Role=>"SHAELVIEN",
  Stage.GameMasterScope=>"GAMEMASTER SUITE",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"DEPTH",
  Stage.AssetKind=>"ASSET TYPE",
  Stage.AssetMode=>"ASSET ACTION",
  Stage.BrowsePlace=>"SOURCE",
  Stage.Scale or Stage.Rotate or Stage.Move=>"TRANSFORM",
  Stage.SaveCancel=>"COMMIT",
  _=>"LEFT"
 };

 string LeftLabel=>_stage switch
 {
  Stage.Environment=>"SHAELVIEN",
  Stage.Role=>"ROLEPLAYER",
  Stage.GameMasterScope=>CurrentScope,
  Stage.WorldBuilderTier=>$"TIER {_tier}",
  Stage.WorldBuilderLayer=>$"LAYER {_layer}",
  Stage.AssetKind=>"IMAGE",
  Stage.AssetMode=>"EDIT",
  Stage.BrowsePlace=>"BROWSE",
  Stage.Scale=>"ENLARGE / REDUCE",
  Stage.Rotate=>"ROTATE",
  Stage.Move=>"MOVE",
  Stage.SaveCancel=>"SAVE",
  _=>""
 };

 string RightEyebrow=>_stage switch
 {
  Stage.Environment=>"ENVIRONMENT",
  Stage.Role=>"SHAELVIEN",
  Stage.GameMasterScope=>"NAVIGATION",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"CONFIRM",
  Stage.AssetKind=>"ASSET TYPE",
  Stage.AssetMode=>"ASSET ACTION",
  Stage.BrowsePlace=>"PLACEMENT",
  Stage.Scale or Stage.Rotate or Stage.Move=>"CONFIRM",
  Stage.SaveCancel=>"COMMIT",
  _=>"RIGHT"
 };

 string RightLabel=>_stage switch
 {
  Stage.Environment=>"RIST",
  Stage.Role=>"GAMEMASTER",
  Stage.GameMasterScope=>"BACK",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"ENTER",
  Stage.AssetKind=>"SPRITE",
  Stage.AssetMode=>"ADD",
  Stage.BrowsePlace=>"PLACE",
  Stage.Scale or Stage.Rotate or Stage.Move=>"SET",
  Stage.SaveCancel=>"CANCEL",
  _=>""
 };

 string LeftDetail=>_stage switch
 {
  Stage.Environment=>"Shared Shaelvien MMO environment.",
  Stage.Role=>"Player-facing role.",
  Stage.GameMasterScope=>"Y cycles GameMaster applications and capability groups.",
  Stage.WorldBuilderTier=>"Y raises or lowers the tier. Tier changes create a visible depth gap.",
  Stage.WorldBuilderLayer=>"Y adds or removes closely stacked glass layers.",
  Stage.AssetKind=>"Static visual asset.",
  Stage.AssetMode=>"Choose an existing asset to transform.",
  Stage.BrowsePlace=>"Browse is an adapter request; no external editor is embedded here.",
  Stage.Scale=>"Y changes preview size without changing asset identity.",
  Stage.Rotate=>"X changes preview rotation.",
  Stage.Move=>"X/Y move the preview representation.",
  Stage.SaveCancel=>"Save irons the preview into this experiment and returns to depth.",
  _=>""
 };

 string RightDetail=>_stage switch
 {
  Stage.Environment=>"Private/universal RIST environment.",
  Stage.Role=>"Enter the GameMaster Suite.",
  Stage.GameMasterScope=>"Return to world and settings selection.",
  Stage.WorldBuilderTier=>"Confirm the tier and continue to Layer.",
  Stage.WorldBuilderLayer=>"Confirm the layer and continue to asset type.",
  Stage.AssetKind=>"Animated visual asset using the same placement pipeline.",
  Stage.AssetMode=>"Add a new asset.",
  Stage.BrowsePlace=>"Place the current representation on the selected Tier/Layer.",
  Stage.Scale=>"Accept current scale.",
  Stage.Rotate=>"Accept current rotation.",
  Stage.Move=>"Accept current position.",
  Stage.SaveCancel=>"Discard preview and return to World Builder depth.",
  _=>""
 };

 string LeftButtonLabel=>_stage switch
 {
  Stage.GameMasterHub=>"SELECT WORLD",
  Stage.SoftwareHub=>"SELECT TOOL",
  _=>LeftLabel
 };

 string RightButtonLabel=>_stage switch
 {
  Stage.GameMasterHub=>"OPEN OPTION",
  Stage.SoftwareHub=>"BACK",
  _=>RightLabel
 };

 string ViewerTitle=>_stage switch
 {
  Stage.Environment=>"RIST UNIVERSAL VIEWER",
  Stage.Role=>"SHAELVIEN",
  Stage.GameMasterHub=>"GAMEMASTER · WORLD SELECTOR",
  Stage.GameMasterScope=>"GAMEMASTER SUITE",
  Stage.SoftwareHub=>"SOFTWARE CAPABILITY ADAPTERS",
  Stage.WorldBuilderTier=>"WORLD BUILDER · TIER",
  Stage.WorldBuilderLayer=>"WORLD BUILDER · LAYER",
  Stage.AssetKind=>"WORLD BUILDER · ASSET TYPE",
  Stage.AssetMode=>$"WORLD BUILDER · {_assetKind}",
  Stage.BrowsePlace=>$"{_assetKind} · {_assetMode}",
  Stage.Scale=>$"{_assetKind} · SCALE {_assetScale:0.00}×",
  Stage.Rotate=>$"{_assetKind} · ROTATE {_assetRotation}°",
  Stage.Move=>$"{_assetKind} · MOVE {_assetX},{_assetY}",
  Stage.SaveCancel=>$"{_assetKind} · READY",
  _=>"VIEWER"
 };

 string StagePath=>_stage switch
 {
  Stage.Environment=>"START",
  Stage.Role=>"SHAELVIEN → ROLE",
  Stage.GameMasterHub=>"SHAELVIEN → GAMEMASTER",
  Stage.GameMasterScope=>"GAMEMASTER → SUITE",
  Stage.SoftwareHub=>"GAMEMASTER → SOFTWARE",
  Stage.WorldBuilderTier=>"WORLD BUILDER → TIER",
  Stage.WorldBuilderLayer=>"WORLD BUILDER → LAYER",
  Stage.AssetKind=>"WORLD BUILDER → ASSET",
  Stage.AssetMode=>$"WORLD BUILDER → {_assetKind}",
  Stage.BrowsePlace=>$"{_assetKind} → {_assetMode}",
  Stage.Scale=>$"{_assetKind} → SCALE",
  Stage.Rotate=>$"{_assetKind} → ROTATE",
  Stage.Move=>$"{_assetKind} → MOVE",
  Stage.SaveCancel=>$"{_assetKind} → SAVE",
  _=>""
 };

 string AssetPreviewStyle=>$"left:calc(50% + {_assetX}px);top:calc(50% + {_assetY}px);transform:translate(-50%,-50%) scale({_assetScale:0.00}) rotate({_assetRotation}deg);";

 string GlassSheetStyle(int sheet)
 {
  var tierGap=_tier*44;
  var layerGap=sheet*11;
  var y=-(_tier*7+sheet*5);
  return $"transform:translateY({y}px) translateZ({tierGap+layerGap}px) rotateX(58deg);opacity:{Math.Max(.28,1-sheet*.07):0.00};";
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _selfRef=DotNetObjectReference.Create(this);
  try
  {
   await JS.InvokeVoidAsync("ristExperimentsUniversalInput.start",_selfRef);
   await _shell.FocusAsync();
  }
  catch(JSException)
  {
   _message="Universal keyboard, pointer and touch controls are ready. Gamepad adapter could not start.";
   StateHasChanged();
  }
 }

 void HandleYSlider(ChangeEventArgs e)
 {
  if(!int.TryParse(e.Value?.ToString(),out var next))return;
  next=Math.Clamp(next,-100,100);
  var direction=Math.Sign(next-_yControl);
  _yControl=next;
  if(direction!=0)ApplyY(direction);
 }

 void HandleXSlider(ChangeEventArgs e)
 {
  if(!int.TryParse(e.Value?.ToString(),out var next))return;
  next=Math.Clamp(next,-100,100);
  var direction=Math.Sign(next-_xControl);
  _xControl=next;
  if(direction!=0)ApplyX(direction);
 }

 void ApplyY(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _yPulse=Math.Clamp(_yPulse+direction,-99,99);

  switch(_stage)
  {
   case Stage.GameMasterHub:
    _worldIndex=Wrap(_worldIndex+direction,WorldChoices.Length);
    _message=$"World selector: {CurrentWorld}.";
    break;
   case Stage.GameMasterScope:
    _scopeIndex=Wrap(_scopeIndex+direction,Scopes.Length);
    _message=$"GameMaster suite: {CurrentScope}.";
    break;
   case Stage.SoftwareHub:
    _softwareIndex=Wrap(_softwareIndex+direction,SoftwareCapabilities.Length);
    _message=$"Capability adapter: {CurrentSoftware}.";
    break;
   case Stage.WorldBuilderTier:
    _tier=Math.Clamp(_tier+direction,0,9);
    _message=$"Tier {_tier}. The glass stack is separated by a tier gap.";
    break;
   case Stage.WorldBuilderLayer:
    _layer=Math.Clamp(_layer+direction,0,99);
    _message=$"Layer {_layer}. Nearby layers stack as glass sheets.";
    break;
   case Stage.Scale:
    _assetScale=Math.Clamp(_assetScale+(direction*.1),.25,4);
    _message=$"Preview scale {_assetScale:0.00}×.";
    break;
   case Stage.Move:
    _assetY=Math.Clamp(_assetY-(direction*8),-160,160);
    _message=$"Preview position {_assetX},{_assetY}.";
    break;
   default:
    _message="Y is available; this Shaep does not currently bind it to another action.";
    break;
  }
 }

 void ApplyX(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _xPulse=Math.Clamp(_xPulse+direction,-99,99);

  switch(_stage)
  {
   case Stage.GameMasterHub:
    _settingIndex=Wrap(_settingIndex+direction,Settings.Length);
    _message=$"Option: {CurrentSetting}.";
    break;
   case Stage.Rotate:
    _assetRotation=NormalizeDegrees(_assetRotation+(direction*5));
    _message=$"Preview rotation {_assetRotation}°.";
    break;
   case Stage.Move:
    _assetX=Math.Clamp(_assetX+(direction*8),-200,200);
    _message=$"Preview position {_assetX},{_assetY}.";
    break;
   default:
    _message="X is available; this Shaep does not currently bind it to another action.";
    break;
  }
 }

 Task PressLeft()
 {
  switch(_stage)
  {
   case Stage.Environment:
    _stage=Stage.Role;
    _message="Shaelvien selected. Choose Roleplayer or GameMaster.";
    break;
   case Stage.Role:
    _message="Roleplayer is reserved for the player-facing branch of this experiment.";
    break;
   case Stage.GameMasterHub:
    _stage=Stage.GameMasterScope;
    _scopeIndex=0;
    _message=CurrentWorld=="NEW WORLD"
     ?"New World selected. Choose the GameMaster suite that will define it."
     :$"{CurrentWorld} selected. Choose a GameMaster suite.";
    break;
   case Stage.GameMasterScope:
    EnterScope();
    break;
   case Stage.SoftwareHub:
    _message=$"{CurrentSoftware} selected. Adapter contract placeholder only; no third-party UI or copied design is embedded.";
    break;
   case Stage.AssetKind:
    _assetKind="IMAGE";
    _stage=Stage.AssetMode;
    _message="Image selected. Choose Edit or Add.";
    break;
   case Stage.AssetMode:
    _assetMode="EDIT";
    _stage=Stage.BrowsePlace;
    _message="Edit selected. Browse requests a source through the future image-tool adapter.";
    break;
   case Stage.BrowsePlace:
    _message="Browse requested. This prototype deliberately does not embed or imitate an external editor.";
    break;
   case Stage.SaveCancel:
    _savedAsset=true;
    ResetAssetTransform();
    _stage=Stage.WorldBuilderTier;
    _message="Asset ironed into the experimental viewer. Returned to World Builder Tier.";
    break;
   case Stage.WorldBuilderTier:
    _message="Y changes Tier; Right/Enter confirms it.";
    break;
   case Stage.WorldBuilderLayer:
    _message="Y changes Layer; Right/Enter confirms it.";
    break;
   case Stage.Scale:
    _message="Y enlarges or reduces; Right/Set confirms.";
    break;
   case Stage.Rotate:
    _message="X rotates; Right/Set confirms.";
    break;
   case Stage.Move:
    _message="X/Y move; Right/Set confirms.";
    break;
  }
  return Task.CompletedTask;
 }

 Task PressRight()
 {
  switch(_stage)
  {
   case Stage.Environment:
    _message="RIST selected. The universal/private environment branch is reserved for the next experiment.";
    break;
   case Stage.Role:
    _stage=Stage.GameMasterHub;
    _message="GameMaster selected. Y cycles worlds; X cycles options.";
    break;
   case Stage.GameMasterHub:
    _message=$"{CurrentSetting} selected. Settings will use the same contextual-control pattern.";
    break;
   case Stage.GameMasterScope:
    _stage=Stage.GameMasterHub;
    _message="Returned to worlds and GameMaster options.";
    break;
   case Stage.SoftwareHub:
    _stage=Stage.GameMasterScope;
    _message="Returned to the GameMaster suite selector.";
    break;
   case Stage.WorldBuilderTier:
    _stage=Stage.WorldBuilderLayer;
    _message=$"Tier {_tier} set for this experiment. Choose Layer.";
    break;
   case Stage.WorldBuilderLayer:
    _stage=Stage.AssetKind;
    _message=$"Tier {_tier}, Layer {_layer}. Choose Image or Sprite.";
    break;
   case Stage.AssetKind:
    _assetKind="SPRITE";
    _stage=Stage.AssetMode;
    _message="Sprite selected. Static images and animated sprites stay distinct but share placement controls.";
    break;
   case Stage.AssetMode:
    _assetMode="ADD";
    _stage=Stage.BrowsePlace;
    _message=$"Add {_assetKind.ToLowerInvariant()} selected. Browse or Place.";
    break;
   case Stage.BrowsePlace:
    _stage=Stage.Scale;
    _message="Representation placed in preview. Use Y to enlarge or reduce.";
    break;
   case Stage.Scale:
    _stage=Stage.Rotate;
    _message="Scale set. Use X to rotate.";
    break;
   case Stage.Rotate:
    _stage=Stage.Move;
    _message="Rotation set. Use X/Y to move.";
    break;
   case Stage.Move:
    _stage=Stage.SaveCancel;
    _message="Position set. Save or Cancel.";
    break;
   case Stage.SaveCancel:
    ResetAssetTransform();
    _stage=Stage.WorldBuilderTier;
    _message="Preview cancelled. Returned to World Builder Tier.";
    break;
  }
  return Task.CompletedTask;
 }

 void EnterScope()
 {
  switch(CurrentScope)
  {
   case "WORLD BUILDER":
    _stage=Stage.WorldBuilderTier;
    _message="World Builder. Y changes Tier; Right confirms and advances to Layer.";
    break;
   case "SOFTWARE":
    _stage=Stage.SoftwareHub;
    _softwareIndex=0;
    _message="Software capability adapters. RIST controls stay consistent while engines remain replaceable.";
    break;
   default:
    _message=$"{CurrentScope} is registered in the GameMaster flowchart; its beginner Shaeps are not wired in this experiment yet.";
    break;
  }
 }

 void ResetAssetTransform()
 {
  _assetScale=1;
  _assetRotation=0;
  _assetX=0;
  _assetY=0;
 }

 static int Wrap(int value,int length)
 {
  if(length<=0)return 0;
  var result=value%length;
  return result<0?result+length:result;
 }

 static int NormalizeDegrees(int value)
 {
  var result=value%360;
  return result<0?result+360:result;
 }

 async Task HandleKeyDown(KeyboardEventArgs e)
 {
  if(e.Key=="Escape")
  {
   if(OnExit.HasDelegate)await OnExit.InvokeAsync();
   return;
  }

  switch(e.Key)
  {
   case "ArrowLeft":
   case "a":
   case "A": ApplyX(-1); break;
   case "ArrowRight":
   case "d":
   case "D": ApplyX(1); break;
   case "ArrowUp":
   case "w":
   case "W": ApplyY(1); break;
   case "ArrowDown":
   case "s":
   case "S": ApplyY(-1); break;
   case "q":
   case "Q": await PressLeft(); break;
   case "e":
   case "E": await PressRight(); break;
  }
 }

 [JSInvokable]
 public Task ReceiveUniversalInput(string control,int direction)
 {
  return InvokeAsync(async () =>
  {
   switch(control)
   {
    case "x": ApplyX(direction); break;
    case "y": ApplyY(direction); break;
    case "left": await PressLeft(); break;
    case "right": await PressRight(); break;
   }
   StateHasChanged();
  });
 }

 public async ValueTask DisposeAsync()
 {
  try{await JS.InvokeVoidAsync("ristExperimentsUniversalInput.stop");}catch(JSException){}
  _selfRef?.Dispose();
 }
}
