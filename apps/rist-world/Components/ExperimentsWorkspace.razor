@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorldSession Session
@inject DiscordAuthClient Auth

<section class="experiments-shell"
         tabindex="0"
         @ref="_shell"
         @onkeydown="HandleKeyDown"
         aria-label="RIST universal GameMaster Suite experiment">

 <main class="experiments-viewer" aria-label="Viewer">
  <div class="viewer-world @ViewerClass" aria-hidden="true"></div>
  <div class="viewer-shade" aria-hidden="true"></div>
  @if(CursorMode)
  {
   <div class="viewer-reticle" style="@ReticleStyle" aria-hidden="true"><span></span></div>
  }

  @if(IsDepthStage)
  {
   <div class="glass-stage" aria-hidden="true">
    @for(var sheet=0;sheet<VisibleGlassSheets;sheet++)
    {
     <span class="glass-sheet" style="@GlassSheetStyle(sheet)"></span>
    }
   </div>
  }

  @if(IsAssetTransformStage)
  {
   <div class="asset-preview @(_assetKind=="SPRITE"?"sprite":"image")"
        style="@AssetPreviewStyle"
        aria-hidden="true">
    @if(!string.IsNullOrWhiteSpace(SelectedAssetUrl))
    {
     <img src="@SelectedAssetUrl" alt="" />
    }
    else
    {
     <span>@_assetKind</span>
    }
   </div>
  }

  @if(_savedAssets.Count>0)
  {
   <div class="saved-viewer-stack" aria-hidden="true">
    @foreach(var saved in _savedAssets.OrderBy(asset=>asset.Tier).ThenBy(asset=>asset.Layer).ThenBy(asset=>asset.SavedAtUtc))
    {
     <div class="saved-viewer-asset @SavedViewerAssetClass(saved)" style="@SavedViewerAssetStyle(saved)">
      @if(!string.IsNullOrWhiteSpace(saved.Url))
      {
       <img src="@saved.Url" alt="" />
      }
      else
      {
       <span>@saved.Kind</span>
      }
     </div>
    }
   </div>
  }

  @if(_stage==Stage.BrowsePlace)
  {
   <section class="asset-source-explorer" aria-label="@_assetSource explorer">
    <header><strong>@_assetSource</strong><span>@_assetScope · @_assetKind</span></header>

    @if(_assetSource=="UPLOAD")
    {
     <div class="asset-upload-pane">
      <strong>ADD @_assetScope TO MY @(_assetKind=="SPRITE"?"SPRITES":"IMAGES")</strong>
      <span>Choose an image from this device. It is stored in your private RIST library under @_assetScope and becomes available under My @(_assetKind=="SPRITE"?"Sprites":"Images").</span>
      <InputFile OnChange="HandleAssetUpload"
                 accept="image/png,image/jpeg,image/webp,image/gif"
                 aria-label="Choose an image to add to your private library" />
      @if(!string.IsNullOrWhiteSpace(_assetLoadError))
      {
       <small role="alert">@_assetLoadError</small>
      }
     </div>
    }
    else if(IsMyAssetSource)
    {
     @if(_assetsLoading)
     {
      <div class="asset-library-state" role="status">LOADING MY @(_assetKind=="SPRITE"?"SPRITES":"IMAGES")…</div>
     }
     else if(!string.IsNullOrWhiteSpace(_assetLoadError))
     {
      <div class="asset-library-state error" role="alert">@_assetLoadError</div>
     }
     else if(_myAssets.Count==0)
     {
      <div class="asset-library-state">NO SAVED @_assetScope @(_assetKind=="SPRITE"?"SPRITES":"IMAGES") YET · CHOOSE UPLOAD</div>
     }
     else
     {
      <div class="asset-source-explorer-grid linked-assets">
       @foreach(var asset in _myAssets)
       {
        <button type="button"
                class="linked-asset @(asset.Key==_selectedAssetKey?"selected":"")"
                @onclick="()=>SelectMyAsset(asset.Key)"
                aria-label="Select @asset.Name">
         <img src="@asset.Url" alt="" loading="lazy" />
         <span>@asset.Name</span>
        </button>
       }
      </div>
     }
    }
    else if(IsGameAssetSource)
    {
     @if(_gameAssets.Count==0)
     {
      <div class="asset-library-state">NO DEPLOYED @_assetScope @(_assetKind=="SPRITE"?"SPRITES":"IMAGES") FOUND</div>
     }
     else
     {
      <div class="asset-source-explorer-grid linked-assets">
       @foreach(var asset in _gameAssets)
       {
        <button type="button"
                class="linked-asset @(asset.Key==_selectedAssetKey?"selected":"")"
                @onclick="()=>SelectGameAsset(asset.Key)"
                aria-label="Select @asset.Name">
         <img src="@asset.Url" alt="" loading="lazy" />
         <span>@asset.Name</span>
        </button>
       }
      </div>
     }
    }
    else
    {
     <div class="asset-source-explorer-grid" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
     </div>
    }

    <footer>@(IsMyAssetSource?"ANALOG CURSOR · TOUCH THUMBNAIL · LEFT DISPLAY SELECTS":"ANALOG CURSOR · TOUCH · LEFT DISPLAY SELECTS")</footer>
   </section>
  }

  <header class="viewer-title">
   <span>VIEWER</span>
  </header>

  @if(Session.IsServerVerifiedPlatformOwner)
  {
   <nav class="experiments-owner-links" aria-label="Owner-only experiment links">
    <a href="/relic/#capabilities" target="_blank" rel="noopener noreferrer">
     <strong>R.e.L.i.C. CAPABILITIES</strong>
     <span>Public AI surface and tested capability map</span>
    </a>
    <a href="/owner/" target="_blank" rel="noopener noreferrer">
     <strong>OWNER DASHBOARD</strong>
     <span>Private whole-project operations view</span>
    </a>
   </nav>
  }

  <div class="viewer-status" role="status" aria-live="polite">
   <strong>@ViewerTitle</strong>
   <span>@_message</span>
  </div>

  <footer class="viewer-readout">
   <span>X @_xPulse</span>
   <span>Y @_yPulse</span>
   <span>@StagePath</span>
  </footer>
 </main>

 <section class="experiments-controller single-analog-deck @AnalogPlacementClass"
          aria-label="Universal analog and display controls">
  <div class="@LeftSliderClass"
       @ref="_leftSlider"
       role="group"
       aria-label="Left display. Slide up or down to change its selection, then touch the display to activate it.">
   @if(LeftDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-up" aria-hidden="true"></span>
   }
   <button type="button"
           class="control-display-button control-display-left"
           @onclick="PressLeft"
           aria-label="Left display button: @LeftDisplayValue">
    <small>@LeftEyebrow</small>
    <strong class="@LeftDisplayTextClass">@LeftDisplayValue</strong>
    <span>@LeftDisplayPrompt</span>
   </button>
   @if(LeftDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-down" aria-hidden="true"></span>
   }
  </div>

  <div class="analog-control analog-control-xy @(CursorMode?"cursor-mode":"paging-mode")"
       @ref="_analog"
       role="group"
       aria-label="Universal analog paging control. Up and down snap the left display. Left and right snap the right display. When neither display has multiple selections it becomes the viewer cursor.">
   <span class="analog-direction analog-up" aria-hidden="true">UP</span>
   <span class="analog-direction analog-down" aria-hidden="true">DOWN</span>
   <span class="analog-direction analog-left" aria-hidden="true">LEFT</span>
   <span class="analog-direction analog-right" aria-hidden="true">RIGHT</span>
   <div class="analog-pad" aria-hidden="true">
    <span class="analog-crosshair"></span>
    <span class="analog-knob"></span>
   </div>
  </div>

  <div class="@RightSliderClass"
       @ref="_rightSlider"
       role="group"
       aria-label="Right display. Slide left or right to change its selection, then touch the display to activate it.">
   @if(RightDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-left" aria-hidden="true"></span>
   }
   <button type="button"
           class="control-display-button control-display-right"
           @onclick="PressRight"
           aria-label="Right display button: @RightDisplayValue">
    <small>@RightDisplayEyebrow</small>
    <strong class="@RightDisplayTextClass">@RightDisplayValue</strong>
    <span>@RightDisplayPrompt</span>
   </button>
   @if(RightDisplayOptionCount>1)
   {
    <span class="display-slider-cue cue-right" aria-hidden="true"></span>
   }
  </div>
 </section></section>

@code {
 [Parameter] public EventCallback OnExit { get; set; }
 [Parameter] public IReadOnlyList<AccountWorldReference> Worlds { get; set; } = Array.Empty<AccountWorldReference>();

 enum Stage
 {
  Environment,
  Role,
  PathSelect,
  GameMasterHub,
  GameMasterScope,
  SoftwareHub,
  ControlSettings,
  WorldBuilderTier,
  WorldBuilderLayer,
  ArtMethod,
  ArtPhase,
  KnowledgeNode,
  AssetKind,
  AssetMode,
  BrowsePlace,
  Scale,
  Rotate,
  Move,
  SaveCancel,
  FullMapReview
 }

 const string AnalogPlacementStorageKey="rist.experiments.analogPlacement.v1";
 ElementReference _shell;
 ElementReference _analog;
 ElementReference _leftSlider;
 ElementReference _rightSlider;
 DotNetObjectReference<ExperimentsWorkspace>? _selfRef;
 Stage _stage=Stage.Environment;
 int _worldIndex;
 int _settingIndex;
 int _scopeIndex;
 int _softwareIndex;
 int _pathIndex;
 int _pathMenuIndex;
 int _artMethodIndex;
 int _artPhaseIndex;
 int _assetKindIndex;
 int _assetSourceIndex;
 int _builderChainIndex;
 int _tier;
 int _layer;
 int _xPulse;
 int _yPulse;
 int _xControl;
 int _yControl;
 double _cursorX;
 double _cursorY;
 string _analogPlacement="center";
 int _analogPlacementDraft=1;
 double _assetScale=1;
 int _assetRotation;
 int _assetX;
 int _assetY;
 string _assetKind="IMAGE";
 string _assetScope="WORLD";
 string _activeKnowledgeNode="";
 string _assetSource="GAME IMAGES";
 string _assetMode="ADD";
 bool _assetsLoading;
 string _assetLoadError="";
 string _selectedAssetKey="";
 List<UserAssetEntry> _myAssets=[];
 List<UserAssetEntry> _gameAssets=[];
 List<SavedViewerAsset> _savedAssets=[];
 string _message="Slide the left display vertically and the right display horizontally. The analog snaps those displays one page at a time; when neither display has multiple choices it becomes the viewer cursor.";

 static readonly string[] Settings=["GRAPHICS","LANGUAGE","ACCESSIBILITY","CONTROLS","AUDIO","DISPLAY","NETWORK","ACCOUNT","HELP"];
 static readonly string[] Scopes=["WORLD BUILDER","REGION DEFINER","LOCAL","INSTANCE","TABLETOP","SOFTWARE"];
 static readonly string[] SoftwareCapabilities=["IMAGE EDITOR","STREAM / RECORD","NOTES / DATABASE","AUDIO","BROWSER","COMMUNICATION","AUTOMATION"];
 static readonly string[] AnalogPlacements=["LEFT","CENTER","RIGHT"];
 static readonly string[] AssetKinds=["IMAGE","SPRITE"];
 static readonly string[] ImageSources=["GAME IMAGES","MY IMAGES","UPLOAD"];
 static readonly string[] SpriteSources=["GAME SPRITES","MY SPRITES","UPLOAD"];
 static readonly string[] GameMasterPaths=["WORLD BUILDER","CAMPAIGN BUILDER","ADVANCED"];
 static readonly string[] ArtMethods=["DRAW","CAD","IMPORT IMAGE","SPRITE","AUDIO","VIDEO"];
 static readonly string[] DrawPhases=["PENCIL","COLOR","EFFECTS"];
 static readonly string[] CadPhases=["SKETCH","GEOMETRY","MATERIAL","EFFECTS"];
 static readonly string[] AudioPhases=["RECORD","EDIT","EFFECTS"];
 static readonly string[] VideoPhases=["IMPORT","EDIT","EFFECTS"];
 static readonly string[] WorldBuilderPath=["WORLD","REGION","LOCAL","INSTANCE","LORE","HISTORY","CULTURES","FACTIONS","NPCS","SECRETS","THREATS","ENCOUNTERS","QUESTS","CAMPAIGN","SESSION"];
 static readonly string[] CampaignBuilderPath=["LOCAL","INSTANCE","HISTORY","NPCS","RELATIONSHIPS","SECRETS","ENCOUNTERS","QUESTS","REGION","FACTIONS","WORLD","LORE","CAMPAIGN","SESSION"];
 static readonly string[] AdvancedPath=["WORLD","REGION","LOCAL","INSTANCE","LORE","HISTORY","CULTURES","FACTIONS","NPCS","RELATIONSHIPS","SECRETS","THREATS","ENCOUNTERS","QUESTS","CAMPAIGN","SESSION"];
 static readonly string[] BuilderChain=["WORLD","REGION","LOCAL","INSTANCE"];
 static readonly string[] BuilderSuiteNames=["WORLD BUILDER","REGION DEFINER","LOCAL","INSTANCE"];

 string[] WorldChoices
 {
  get
  {
   var names=Worlds
    .Where(world=>!string.IsNullOrWhiteSpace(world.DisplayName))
    .OrderByDescending(world=>world.UpdatedAtUtc)
    .Select(world=>world.DisplayName.Trim().ToUpperInvariant())
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();

   if(Session.HasActiveWorld&&!names.Any(name=>string.Equals(name,Session.WorldDisplayName,StringComparison.OrdinalIgnoreCase)))
    names.Insert(0,Session.WorldDisplayName.ToUpperInvariant());

   names.Add("NEW WORLD");
   return names.ToArray();
  }
 }

 int WorldIndex=>Math.Clamp(_worldIndex,0,WorldChoices.Length-1);
 string CurrentWorld=>WorldChoices[WorldIndex];
 string PreviousWorld=>WorldChoices[(WorldIndex-1+WorldChoices.Length)%WorldChoices.Length];
 string NextWorld=>WorldChoices[(WorldIndex+1)%WorldChoices.Length];
 string CurrentSetting=>Settings[_settingIndex];
 string PreviousSetting=>Settings[(_settingIndex-1+Settings.Length)%Settings.Length];
 string NextSetting=>Settings[(_settingIndex+1)%Settings.Length];
 string CurrentScope=>Scopes[_scopeIndex];
 string CurrentSoftware=>SoftwareCapabilities[_softwareIndex];
 string PreviousSoftware=>SoftwareCapabilities[(_softwareIndex-1+SoftwareCapabilities.Length)%SoftwareCapabilities.Length];
 string NextSoftware=>SoftwareCapabilities[(_softwareIndex+1)%SoftwareCapabilities.Length];

 string CurrentGameMasterPath=>GameMasterPaths[Math.Clamp(_pathIndex,0,GameMasterPaths.Length-1)];
 string[] CurrentGuidedPath=>CurrentGameMasterPath switch
 {
  "CAMPAIGN BUILDER"=>CampaignBuilderPath,
  "ADVANCED"=>AdvancedPath,
  _=>WorldBuilderPath
 };
 string[] CurrentPathMenu=>["BACK",..CurrentGuidedPath.Distinct(StringComparer.OrdinalIgnoreCase)];
 string CurrentPathTarget=>CurrentPathMenu[Math.Clamp(_pathMenuIndex,0,CurrentPathMenu.Length-1)];
 string CurrentArtMethod=>ArtMethods[Math.Clamp(_artMethodIndex,0,ArtMethods.Length-1)];
 string[] CurrentArtPhases=>CurrentArtMethod switch
 {
  "DRAW"=>DrawPhases,
  "CAD"=>CadPhases,
  "AUDIO"=>AudioPhases,
  "VIDEO"=>VideoPhases,
  _=>["SOURCE"]
 };
 string CurrentArtPhase=>CurrentArtPhases[Math.Clamp(_artPhaseIndex,0,CurrentArtPhases.Length-1)];

 string CurrentAnalogPlacementDraft=>AnalogPlacements[Math.Clamp(_analogPlacementDraft,0,AnalogPlacements.Length-1)];
 string AnalogPlacementClass=>$"analog-{_analogPlacement}";
 string[] AssetSources=>_assetKind=="SPRITE"?SpriteSources:ImageSources;
 string CurrentAssetSource=>AssetSources[Math.Clamp(_assetSourceIndex,0,AssetSources.Length-1)];
 string CurrentBuilderScope=>BuilderChain[Math.Clamp(_builderChainIndex,0,BuilderChain.Length-1)];
 string CurrentBuilderSuite=>BuilderSuiteNames[Math.Clamp(_builderChainIndex,0,BuilderSuiteNames.Length-1)];
 bool IsPathDrivenStage=>_stage is Stage.WorldBuilderTier or Stage.WorldBuilderLayer or Stage.ArtMethod or Stage.ArtPhase or Stage.KnowledgeNode or Stage.AssetKind or Stage.FullMapReview;
 bool IsMyAssetSource=>_assetSource is "MY IMAGES" or "MY SPRITES";
 bool IsGameAssetSource=>_assetSource is "GAME IMAGES" or "GAME SPRITES";
 const string EndemarCanonicalAssetRoot="https://d2d6rnm6fnsp89.cloudfront.net/library/terrains/standard/world/whole_maps/geonaph/";
 string PrivateAssetPrefix=>_assetKind=="SPRITE"
  ?$"assets/sprites/{_assetScope.ToLowerInvariant()}/"
  :$"assets/images/{_assetScope.ToLowerInvariant()}/";
 string EndemarSeedPrefix=>"assets/images/world/endomar/";
 string LeftSliderClass=>$"display-slider display-slider-left {(LeftDisplayOptionCount>1?"is-scrollable":"is-static")}";
 string RightSliderClass=>$"display-slider display-slider-right {(RightDisplayOptionCount>1?"is-scrollable":"is-static")}";
 string LeftDisplayTextClass=>DisplayTextClass(LeftDisplayValue);
 string RightDisplayTextClass=>DisplayTextClass(RightDisplayValue);

 int LeftDisplayOptionCount=>_stage switch
 {
  Stage.PathSelect=>GameMasterPaths.Length,
  Stage.GameMasterHub=>WorldChoices.Length,
  Stage.GameMasterScope=>Scopes.Length,
  Stage.SoftwareHub=>SoftwareCapabilities.Length,
  Stage.ControlSettings=>AnalogPlacements.Length,
  Stage.WorldBuilderTier=>10,
  Stage.WorldBuilderLayer=>100,
  Stage.ArtMethod=>ArtMethods.Length,
  Stage.ArtPhase=>CurrentArtPhases.Length,
  Stage.AssetKind=>AssetSources.Length,
  Stage.Scale=>38,
  _=>1
 };

 int RightDisplayOptionCount=>IsPathDrivenStage
  ?CurrentPathMenu.Length
  :_stage switch
  {
   Stage.GameMasterHub=>Settings.Length,
   Stage.Rotate=>72,
   _=>1
  };

 bool RightActsAsBack=>!IsPathDrivenStage&&LeftDisplayOptionCount>1&&RightDisplayOptionCount<=1;
 bool CursorMode=>!IsPathDrivenStage&&LeftDisplayOptionCount<=1&&RightDisplayOptionCount<=1;

 bool IsDepthStage=>_stage is Stage.WorldBuilderTier or Stage.WorldBuilderLayer;
 bool IsAssetTransformStage=>_stage is Stage.Scale or Stage.Rotate or Stage.Move or Stage.SaveCancel;
 bool IsBuilderStage=>IsDepthStage||_stage is Stage.ArtMethod or Stage.ArtPhase or Stage.KnowledgeNode or Stage.AssetKind or Stage.AssetMode or Stage.BrowsePlace or Stage.Scale or Stage.Rotate or Stage.Move or Stage.SaveCancel or Stage.FullMapReview;
 bool HasSavedViewer=>_savedAssets.Count>0;
 int VisibleGlassSheets=>Math.Clamp(_layer+1,1,8);
 string ViewerClass=>IsBuilderStage&&!HasSavedViewer?"builder":HasSavedViewer?"recursive":"";

 string LeftAxisHint=>_stage switch
 {
  Stage.GameMasterHub=>"Y · WORLDS",
  Stage.GameMasterScope=>"Y · SUITES",
  Stage.SoftwareHub=>"Y · CAPABILITIES",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"Y · DEPTH",
  Stage.Scale=>"Y · SCALE",
  Stage.Move=>"Y · MOVE",
  _=>"Y · NAVIGATE"
 };

 string RightAxisHint=>_stage switch
 {
  Stage.GameMasterHub=>"X · OPTIONS",
  Stage.Rotate=>"X · ROTATE",
  Stage.Move=>"X · MOVE",
  _=>"X · NAVIGATE"
 };

 string LeftEyebrow=>_stage switch
 {
  Stage.Environment=>"ENVIRONMENT",
  Stage.Role=>"SHAELVIEN",
  Stage.GameMasterScope=>"GAMEMASTER SUITE",
  Stage.ControlSettings=>"CONTROLS",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"DEPTH",
  Stage.AssetKind=>"ASSET TYPE",
  Stage.AssetMode=>"ASSET ACTION",
  Stage.BrowsePlace=>"SOURCE",
  Stage.Scale or Stage.Rotate or Stage.Move=>"TRANSFORM",
  Stage.SaveCancel=>"COMMIT",
  Stage.FullMapReview=>CurrentBuilderSuite,
  _=>"LEFT"
 };

 string LeftLabel=>_stage switch
 {
  Stage.Environment=>"SHAELVIEN",
  Stage.Role=>"ROLEPLAYER",
  Stage.GameMasterScope=>CurrentScope,
  Stage.ControlSettings=>$"ANALOG {CurrentAnalogPlacementDraft}",
  Stage.WorldBuilderTier=>$"TIER {_tier}",
  Stage.WorldBuilderLayer=>$"LAYER {_layer}",
  Stage.AssetKind=>_assetKind,
  Stage.AssetMode=>"EDIT",
  Stage.BrowsePlace=>"SELECT",
  Stage.Scale=>"ENLARGE / REDUCE",
  Stage.Rotate=>"ROTATE",
  Stage.Move=>"MOVE",
  Stage.SaveCancel=>"SAVE",
  Stage.FullMapReview=>$"CONTINUE {CurrentBuilderScope}",
  _=>""
 };

 string RightEyebrow=>_stage switch
 {
  Stage.Environment=>"ENVIRONMENT",
  Stage.Role=>"SHAELVIEN",
  Stage.GameMasterScope=>"NAVIGATION",
  Stage.ControlSettings=>"SETTINGS",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"NAVIGATION",
  Stage.AssetKind=>"SOURCE",
  Stage.AssetMode=>"ASSET ACTION",
  Stage.BrowsePlace=>"NAVIGATION",
  Stage.Scale or Stage.Rotate or Stage.Move=>"CONFIRM",
  Stage.SaveCancel=>"COMMIT",
  Stage.FullMapReview=>"GAMEMASTER CHAIN",
  _=>"RIGHT"
 };

 string RightLabel=>_stage switch
 {
  Stage.Environment=>"RIST",
  Stage.Role=>"GAMEMASTER",
  Stage.GameMasterScope=>"BACK",
  Stage.ControlSettings=>"BACK",
  Stage.WorldBuilderTier or Stage.WorldBuilderLayer=>"BACK",
  Stage.AssetKind=>CurrentAssetSource,
  Stage.AssetMode=>"ADD",
  Stage.BrowsePlace=>"BACK",
  Stage.Scale or Stage.Rotate or Stage.Move=>"SET",
  Stage.SaveCancel=>"CANCEL",
  Stage.FullMapReview=>HasNextBuilderScope?NextBuilderSuite:"REVIEW",
  _=>""
 };

 string LeftDetail=>_stage switch
 {
  Stage.Environment=>"Shared Shaelvien MMO environment.",
  Stage.Role=>"Player-facing role.",
  Stage.GameMasterScope=>"Y cycles GameMaster applications and capability groups.",
  Stage.ControlSettings=>"Move the analog left, center, or right of the two display buttons.",
  Stage.WorldBuilderTier=>"Y pages through tiers. Touch the left display to select the shown tier.",
  Stage.WorldBuilderLayer=>"Y pages through layers. Touch the left display to select the shown layer.",
  Stage.AssetKind=>"Y switches asset type. X switches the source shown on the right display.",
  Stage.AssetMode=>"Choose an existing asset to transform.",
  Stage.BrowsePlace=>"Use the analog cursor or touch. The left display selects the current explorer item.",
  Stage.Scale=>"Y changes preview size without changing asset identity.",
  Stage.Rotate=>"X changes preview rotation.",
  Stage.Move=>"X/Y move the preview representation.",
  Stage.SaveCancel=>"Save commits the representation and opens the full-map recursive review.",
  Stage.FullMapReview=>$"Inspect the complete {CurrentBuilderScope.ToLowerInvariant()} view or continue building this scope.",
  _=>""
 };

 string RightDetail=>_stage switch
 {
  Stage.Environment=>"Private/universal RIST environment.",
  Stage.Role=>"Enter the GameMaster Suite.",
  Stage.GameMasterScope=>"Return to world and settings selection.",
  Stage.ControlSettings=>"Cancel and return to GameMaster settings.",
  Stage.WorldBuilderTier=>"Back to the GameMaster suite selector.",
  Stage.WorldBuilderLayer=>"Back to Tier.",
  Stage.AssetKind=>"Choose Game, My, or Upload source for the selected asset type.",
  Stage.AssetMode=>"Add a new asset.",
  Stage.BrowsePlace=>"Back to Image/Sprite and source selection.",
  Stage.Scale=>"Back to the current source explorer.",
  Stage.Rotate=>"Accept current rotation.",
  Stage.Move=>"Accept current position.",
  Stage.SaveCancel=>"Discard preview and return to the current builder depth.",
  Stage.FullMapReview=>HasNextBuilderScope
   ?$"Advance directly to {NextBuilderSuite} without leaving the viewer."
   :"Keep the completed recursive viewer open.",
  _=>""
 };

 string LeftButtonLabel=>_stage switch
 {
  Stage.GameMasterHub=>"SELECT WORLD",
  Stage.SoftwareHub=>"SELECT TOOL",
  _=>LeftLabel
 };

 string RightButtonLabel=>_stage switch
 {
  Stage.GameMasterHub=>"OPEN OPTION",
  Stage.SoftwareHub=>"BACK",
  _=>RightLabel
 };

 string LeftDisplayValue=>_stage switch
 {
  Stage.GameMasterHub=>CurrentWorld,
  Stage.SoftwareHub=>CurrentSoftware,
  Stage.ControlSettings=>$"ANALOG {CurrentAnalogPlacementDraft}",
  Stage.AssetKind=>_assetKind,
  Stage.Scale=>$"{_assetScale:0.00}×",
  _=>LeftLabel
 };

 string RightDisplayEyebrow=>RightActsAsBack?"NAVIGATION":RightEyebrow;

 string RightDisplayValue=>RightActsAsBack
  ?"BACK"
  :_stage switch
  {
   Stage.GameMasterHub=>CurrentSetting,
   Stage.ControlSettings=>"BACK",
   Stage.AssetKind=>CurrentAssetSource,
   Stage.Rotate=>$"{_assetRotation}°",
   _=>RightLabel
  };

 string LeftDisplayPrompt=>_stage switch
 {
  Stage.GameMasterHub=>"TOUCH · SELECT WORLD",
  Stage.SoftwareHub=>"TOUCH · SELECT TOOL",
  Stage.ControlSettings=>"TOUCH · SAVE",
  Stage.AssetKind=>"SLIDE ↑↓ · TOUCH TYPE",
  Stage.BrowsePlace=>"TOUCH · SELECT",
  Stage.Scale=>"SLIDE ↑↓ · TOUCH SET",
  Stage.FullMapReview=>"TOUCH · BUILD MORE",
  _=>"TOUCH · ACTIVATE"
 };

 string RightDisplayPrompt=>RightActsAsBack
  ?"TOUCH · BACK"
  :_stage switch
  {
   Stage.GameMasterHub=>"TOUCH · OPEN OPTION",
   Stage.SoftwareHub=>"TOUCH · BACK",
   Stage.ControlSettings=>"TOUCH · CANCEL",
   Stage.AssetKind=>"SLIDE ↔ · TOUCH OPEN",
   Stage.BrowsePlace=>"TOUCH · BACK",
   Stage.Rotate=>"SLIDE ↔ · TOUCH SET",
   Stage.FullMapReview=>HasNextBuilderScope?"TOUCH · NEXT":"TOUCH · REVIEW",
   _=>"TOUCH · ACTIVATE"
  };

 string ViewerTitle=>_stage switch
 {
  Stage.Environment=>"RIST UNIVERSAL VIEWER",
  Stage.Role=>"SHAELVIEN",
  Stage.GameMasterHub=>"GAMEMASTER · WORLD SELECTOR",
  Stage.GameMasterScope=>"GAMEMASTER SUITE",
  Stage.SoftwareHub=>"SOFTWARE CAPABILITY ADAPTERS",
  Stage.ControlSettings=>"CONTROLS · ANALOG PLACEMENT",
  Stage.WorldBuilderTier=>$"{CurrentBuilderSuite} · TIER",
  Stage.WorldBuilderLayer=>$"{CurrentBuilderSuite} · LAYER",
  Stage.AssetKind=>$"{CurrentBuilderSuite} · ASSET SOURCE",
  Stage.AssetMode=>$"{CurrentBuilderSuite} · {_assetKind}",
  Stage.BrowsePlace=>$"{_assetSource} · {_assetKind}",
