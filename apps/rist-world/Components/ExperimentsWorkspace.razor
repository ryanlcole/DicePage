 void BeginGameMasterPath()
 {
  _pathHistory.Clear();
  var startNode=CurrentGameMasterPath=="CAMPAIGN BUILDER"?"LOCAL":"WORLD";
  var builderIndex=BuilderIndexForNode(startNode);
  if(builderIndex<0)builderIndex=0;

  BeginBuilderScope(builderIndex);
  SetPathMenuToNext(startNode);
  _message=CurrentGameMasterPath switch
  {
   "CAMPAIGN BUILDER"=>"Campaign Builder starts local and builds outward. Choose Tier, Layer, then an A/V method; the right rail carries history, NPCs, encounters, region, world, lore, and the rest of the campaign path.",
   "ADVANCED"=>"Advanced exposes the complete path graph on the right rail so you can jump anywhere. The left rail remains the current A/V or creation method.",
   _=>"World Builder starts outside and works inward: World → Region → Local → Instance, then lore, history, NPCs, encounters, quests, campaign, and session."
  };
 }

 void SelectArtMethod()
 {
  _artPhaseIndex=0;
  _artToolIndex=0;

  switch(CurrentArtMethod)
  {
   case "IMAGES":
    PrepareAssetSource("IMAGE");
    _message=$"{CurrentBuilderScope} images. Choose from Game Images, My Images, or Upload; existing images and new uploads use the same image path.";
    break;
   case "SPRITE":
    PrepareAssetSource("SPRITE");
    _message=$"{CurrentBuilderScope} sprite. Slide the left display through Game Sprites, My Sprites, or Upload; the right rail still jumps through the GameMaster path.";
    break;
   case "DRAW":
   case "CAD":
   case "AUDIO":
   case "VIDEO":
    _stage=Stage.ArtPhase;
    _message=$"{CurrentArtMethod} begins with {CurrentArtPhase}. Save each pass before moving to the next phase; the tool-specific controls will be added here as each adapter is wired.";
    break;
  }
 }

 void SaveArtPass()
 {
  var savedPhase=CurrentArtPhase;
  var savedTool=CurrentArtPhase;

  if(_artPhaseIndex+1<CurrentArtPhases.Length)
  {
   _artPhaseIndex++;
   _artToolIndex=0;
   _stage=Stage.ArtPhase;
   _message=$"{savedPhase} saved. Next: {CurrentArtPhase}. Open the next workbench pass on the left; the path/journal rail remains on the right.";
