 IReadOnlyList<ControllerWorldOption> PathWorldOptions
 {
  get
  {
   if(string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase))
   {
    var userId=Auth.Profile?.UserId?.Trim()??"";
    var options=Session.MmoParcels
     .Where(parcel=>
      string.Equals(parcel.OwnerUserId,userId,StringComparison.Ordinal)
      ||(!Auth.IsOwnerDiscordAccount&&Session.CanAccessMmoParcel(parcel)))
     .Select(parcel=>new ControllerWorldOption(
      parcel.ParcelId,
      parcel.DisplayName,
      "SHAELVIEN",
      null,
      parcel))
     .OrderBy(option=>option.Name,StringComparer.OrdinalIgnoreCase)
     .ThenBy(option=>option.Id,StringComparer.Ordinal)
     .ToList();

    if(Auth.IsOwnerDiscordAccount)
    {
     options.Insert(0,new ControllerWorldOption(
      "__endemar__",
      WorldSession.EndemarStartingPointDisplayName,
      "SHAELVIEN_ORIGIN",
      null,
      null));
     options.Add(new ControllerWorldOption(
      "__inspect__",
      "Inspect",
      "SHAELVIEN_INSPECT",
      null,
      null));
    }

    options.Add(new ControllerWorldOption(
     "__claim__",
     "Claim Deed",
     "SHAELVIEN_CLAIM",
     null,
     null));
    return options;
   }

   var options=Worlds
    .Concat(_controllerDirectoryWorlds)
    .GroupBy(world=>world.WorldId,StringComparer.Ordinal)
    .Select(group=>group.First())
    .Where(WorldSession.IsSandboxWorldReference)
    .Where(world=>!string.IsNullOrWhiteSpace(world.DisplayName))
    .Select(world=>new ControllerWorldOption(
     world.WorldId,
     world.DisplayName.Trim(),
     "RIST",
     world,
     null))
    .ToList();

   if(Session.HasActiveWorld&&!Session.IsGeonaphWorld
      &&!options.Any(option=>string.Equals(option.Id,Session.WorldId,StringComparison.Ordinal)))
   {
    options.Add(new ControllerWorldOption(
     Session.WorldId,
     Session.WorldDisplayName,
     "RIST",
     null,
     null));
   }

   return options
    .OrderBy(option=>option.Name,StringComparer.OrdinalIgnoreCase)
    .ThenBy(option=>option.Id,StringComparer.Ordinal)
    .ToList();
  }
 }


 bool IsShaelvienDeedHome=>_stage==Stage.PathSelect
  &&string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase)
  &&!string.IsNullOrWhiteSpace(_selectedDeedName);

 bool IsDeedContextNode=>_stage==Stage.KnowledgeNode
  &&string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase)
  &&_pathIndex==1
  &&ContextPath.Contains(_activeKnowledgeNode,StringComparer.OrdinalIgnoreCase)
  &&!string.IsNullOrWhiteSpace(_selectedDeedName);

 string CurrentContextSelection=>ContextPath[Math.Clamp(_pathMenuIndex,0,ContextPath.Length-1)];

 string SelectedDeedRegionId
 {
  get
  {
   if(string.IsNullOrWhiteSpace(_selectedDeedId)||_selectedDeedKind=="SHAELVIEN_ORIGIN")return "";
   return Session.MmoParcels.FirstOrDefault(parcel=>string.Equals(parcel.ParcelId,_selectedDeedId,StringComparison.Ordinal))?.RegionId?.Trim()??"";
  }
 }

 string SelectedDeedZoneId
 {
  get
  {
   if(string.IsNullOrWhiteSpace(SelectedDeedRegionId)||string.IsNullOrWhiteSpace(_selectedDeedName))return "";
   var value=_selectedDeedName.Trim().ToLowerInvariant();
   var chars=value.Select(ch=>char.IsLetterOrDigit(ch)?ch:'-').ToArray();
   var slug=new string(chars);
   while(slug.Contains("--",StringComparison.Ordinal))slug=slug.Replace("--","-",StringComparison.Ordinal);
   slug=slug.Trim('-');
   if(slug.StartsWith("the-",StringComparison.Ordinal))slug=slug[4..];
   return slug;
  }
 }

 void SetSelectedDeed(ControllerWorldOption option)
 {
  _selectedDeedId=option.Id;
  _selectedDeedName=option.Name?.Trim()??"";
  _selectedDeedKind=option.Environment;
  _pathIndex=0;
  _pathMenuIndex=0;
  _scopeIndex=0;
  _spatialSelectIndex=0;
 }

 int PathWorldCount=>PathWorldOptions.Count;
 bool HasPathWorlds=>PathWorldCount>0;
 int PathWorldIndex=>PathWorldCount==0?0:Math.Clamp(_worldIndex,0,PathWorldCount-1);
 ControllerWorldOption? CurrentPathWorld=>PathWorldCount==0?null:PathWorldOptions[PathWorldIndex];
 string PathWorldLabel=>CurrentPathWorld?.Name?.Trim().ToUpperInvariant()??"CLAIM DEED";
 string PathWorldEyebrow=>HasPathWorlds
  ?(string.Equals(_selectedEnvironment,"SHAELVIEN",StringComparison.OrdinalIgnoreCase)?"SHAELVIEN WORLDS":"RIST WORLDS")
  :"PROPERTY";
 string PathWorldPrompt
 {
  get
  {
