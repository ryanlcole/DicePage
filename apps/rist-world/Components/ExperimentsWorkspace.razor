 static string DisplayTextClass(string? value)
 {
  var length=(value??string.Empty).Trim().Length;
  if(length>=18)return "display-text display-text-xs";
  if(length>=14)return "display-text display-text-sm";
  if(length>=11)return "display-text display-text-md";
  return "display-text display-text-lg";
 }

 static int Wrap(int value,int length)
 {
  if(length<=0)return 0;
  var result=value%length;
  return result<0?result+length:result;
 }

 static int NormalizeDegrees(int value)
 {
  var result=value%360;
  return result<0?result+360:result;
 }

