 async Task EnsureShaelvienEnvironmentAsync()
 {
  try
  {
   var mmo=Worlds
    .Concat(_controllerDirectoryWorlds)
    .FirstOrDefault(WorldSession.IsMmoWorldReference);
   if(mmo is null&&!Session.IsGeonaphWorld)
   {
    await RefreshControllerWorldDirectoryAsync();
    mmo=Worlds
     .Concat(_controllerDirectoryWorlds)
     .FirstOrDefault(WorldSession.IsMmoWorldReference);
   }
   if(mmo is not null
      &&(!Session.HasActiveWorld||!string.Equals(Session.WorldId,mmo.WorldId,StringComparison.Ordinal)))
    await Session.LoadWorldAsync(mmo);

   await Session.RefreshMmoLandAsync();
   await Session.LoadRegionsAsync();
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Shaelvien environment refresh failed: {ex}");
   _message="Shaelvien property authority could not be refreshed.";
  }
 }

 async Task<bool> ActivateCurrentPathWorldAsync()
 {
  var option=CurrentPathWorld;
  if(option is null)return false;

  try
  {
   if(option.Environment.StartsWith("SHAELVIEN",StringComparison.OrdinalIgnoreCase))
   {
    await EnsureShaelvienEnvironmentAsync();

    if(option.Environment=="SHAELVIEN_CLAIM")
    {
     await OpenControllerDeedAsync();
     return false;
    }

    if(option.Environment=="SHAELVIEN_INSPECT")
    {
     _shaelvienInspectGateOpen=true;
     _message="Inspect opened. Review claimed Shaelvien realms without changing their ownership.";
     await InvokeAsync(StateHasChanged);
     return false;
    }

    if(option.Environment=="SHAELVIEN_ORIGIN")
    {
     Session.SetActiveRegion("");
     _message=$"{WorldSession.EndemarStartingPointDisplayName} selected.";
     return true;
    }

    var parcel=Session.MmoParcels.FirstOrDefault(item=>string.Equals(item.ParcelId,option.Id,StringComparison.Ordinal));
    if(parcel is null||!Session.CanAccessMmoParcel(parcel))
    {
     _message="That Shaelvien world is no longer available to this account.";
     return false;
    }
    await Session.LoadRegionsAsync();
    Session.SetActiveRegion(parcel.RegionId);
    _message=$"{parcel.DisplayName} selected.";
    return true;
   }

   var world=option.WorldReference;
   if(world is not null
      &&(!Session.HasActiveWorld||!string.Equals(Session.WorldId,world.WorldId,StringComparison.Ordinal)))
    await Session.LoadWorldAsync(world);

   if(!Session.HasActiveWorld||Session.IsGeonaphWorld)
   {
    _message="That RIST world could not be activated.";
    return false;
   }

   await Session.RefreshTrustedWorldAuthorityAsync();
   _message=$"{Session.WorldDisplayName} selected.";
   return true;
  }
  catch(Exception ex)
  {
   Console.Error.WriteLine($"Controller world selection failed: {ex}");
   _message="That world could not be opened.";
   return false;
  }
 }

