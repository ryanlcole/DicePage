 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _selfRef=DotNetObjectReference.Create(this);
  try
  {
   await JS.InvokeVoidAsync("ristExperimentsUniversalInput.start",_selfRef,_analog,_leftSlider,_rightSlider);
   try
   {
    var stored=await JS.InvokeAsync<string?>("localStorage.getItem",AnalogPlacementStorageKey);
    if(stored is "left" or "center" or "right")
    {
     _analogPlacement=stored;
     _analogPlacementDraft=Array.IndexOf(AnalogPlacements,stored.ToUpperInvariant());
    }
   }
   catch{}
   await _shell.FocusAsync();
   await InvokeAsync(StateHasChanged);
  }
  catch(JSException)
  {
   _message="Universal keyboard, pointer and touch controls are ready. Gamepad adapter could not start.";
   StateHasChanged();
  }
 }

 void StepY(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _yControl=Math.Clamp(direction*100,-100,100);
  if(CursorMode)
  {
   _yPulse=Math.Clamp(_yPulse+direction,-99,99);
   _cursorY=Math.Clamp(_cursorY+(direction*7),-100,100);
   if(_stage==Stage.Move)
   {
    _assetY=Math.Clamp(_assetY-(direction*8),-160,160);
    _message=$"Cursor {_cursorX},{_cursorY}. Preview position {_assetX},{_assetY}.";
   }
   else _message=$"Cursor {_cursorX},{_cursorY}.";
   return;
  }
  ApplyY(direction);
 }

 void StepX(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _xControl=Math.Clamp(direction*100,-100,100);
  if(CursorMode)
  {
   _xPulse=Math.Clamp(_xPulse+direction,-99,99);
   _cursorX=Math.Clamp(_cursorX+(direction*7),-100,100);
   if(_stage==Stage.Move)
   {
    _assetX=Math.Clamp(_assetX+(direction*8),-200,200);
    _message=$"Cursor {_cursorX},{_cursorY}. Preview position {_assetX},{_assetY}.";
   }
   else _message=$"Cursor {_cursorX},{_cursorY}.";
   return;
  }
  ApplyX(direction);
 }

 void ApplyY(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _yPulse=Math.Clamp(_yPulse+direction,-99,99);

  switch(_stage)
  {
   case Stage.GameMasterHub:
    _worldIndex=Wrap(_worldIndex+direction,WorldChoices.Length);
    _message=$"World selector: {CurrentWorld}.";
    break;
   case Stage.GameMasterScope:
    _scopeIndex=Wrap(_scopeIndex+direction,Scopes.Length);
    _message=$"GameMaster suite: {CurrentScope}.";
    break;
   case Stage.SoftwareHub:
    _softwareIndex=Wrap(_softwareIndex+direction,SoftwareCapabilities.Length);
    _message=$"Capability adapter: {CurrentSoftware}.";
    break;
   case Stage.ControlSettings:
    _analogPlacementDraft=Wrap(_analogPlacementDraft+direction,AnalogPlacements.Length);
    _message=$"Analog placement: {CurrentAnalogPlacementDraft}.";
    break;
   case Stage.AssetKind:
    _assetKindIndex=Wrap(_assetKindIndex+direction,AssetKinds.Length);
    _assetKind=AssetKinds[_assetKindIndex];
    _assetSourceIndex=0;
    _message=$"{_assetKind}. Right source: {CurrentAssetSource}.";
    break;
   case Stage.WorldBuilderTier:
    _tier=Math.Clamp(_tier+direction,0,9);
    _message=$"Tier {_tier}. The glass stack is separated by a tier gap.";
    break;
   case Stage.WorldBuilderLayer:
    _layer=Math.Clamp(_layer+direction,0,99);
    _message=$"Layer {_layer}. Nearby layers stack as glass sheets.";
    break;
   case Stage.Scale:
    _assetScale=Math.Clamp(_assetScale+(direction*.1),.25,4);
    _message=$"Preview scale {_assetScale:0.00}×.";
    break;
   case Stage.Move:
    _assetY=Math.Clamp(_assetY-(direction*8),-160,160);
    _message=$"Preview position {_assetX},{_assetY}.";
    break;
   default:
    _message="Y is available; this Shaep does not currently bind it to another action.";
    break;
  }
 }

 void ApplyX(int direction)
 {
  direction=Math.Sign(direction);
  if(direction==0)return;
  _xPulse=Math.Clamp(_xPulse+direction,-99,99);

  switch(_stage)
  {
   case Stage.GameMasterHub:
    _settingIndex=Wrap(_settingIndex+direction,Settings.Length);
    _message=$"Option: {CurrentSetting}.";
    break;
   case Stage.AssetKind:
    _assetSourceIndex=Wrap(_assetSourceIndex+direction,AssetSources.Length);
    _message=$"{_assetKind} source: {CurrentAssetSource}.";
    break;
   case Stage.Rotate:
    _assetRotation=NormalizeDegrees(_assetRotation+(direction*5));
    _message=$"Preview rotation {_assetRotation}°.";
    break;
   case Stage.Move:
    _assetX=Math.Clamp(_assetX+(direction*8),-200,200);
    _message=$"Preview position {_assetX},{_assetY}.";
    break;
   default:
    _message="X is available; this Shaep does not currently bind it to another action.";
    break;
  }
 }

 Task PressLeft()
 {
  switch(_stage)
  {
   case Stage.Environment:
    _stage=Stage.Role;
    _message="Shaelvien selected. Choose Roleplayer or GameMaster.";
    break;
   case Stage.Role:
    _message="Roleplayer is reserved for the player-facing branch of this experiment.";
    break;
   case Stage.GameMasterHub:
    _stage=Stage.GameMasterScope;
    _scopeIndex=0;
    _message=CurrentWorld=="NEW WORLD"
     ?"New World selected. Choose the GameMaster suite that will define it."
     :$"{CurrentWorld} selected. Choose a GameMaster suite.";
    break;
   case Stage.GameMasterScope:
    EnterScope();
    break;
   case Stage.SoftwareHub:
    _message=$"{CurrentSoftware} selected. Adapter contract placeholder only; no third-party UI or copied design is embedded.";
    break;
   case Stage.ControlSettings:
    _analogPlacement=CurrentAnalogPlacementDraft.ToLowerInvariant();
    _=PersistAnalogPlacementAsync();
    _stage=Stage.GameMasterHub;
    _message=$"Analog placement saved: {CurrentAnalogPlacementDraft}.";
    break;
   case Stage.AssetKind:
    _message=$"{_assetKind} selected. Slide the right display left or right for {CurrentAssetSource}, then touch the right display to open it.";
    break;
   case Stage.AssetMode:
    _assetMode="EDIT";
    _stage=Stage.BrowsePlace;
    _message="Edit selected. Browse requests a source through the future image-tool adapter.";
    break;
   case Stage.BrowsePlace:
    if((IsMyAssetSource||IsGameAssetSource)&&string.IsNullOrWhiteSpace(_selectedAssetKey))
    {
     _message=$"Choose a {_assetKind.ToLowerInvariant()} first, then touch the left display to select it.";
     break;
    }
    _stage=Stage.Scale;
    _message=(IsMyAssetSource||IsGameAssetSource)
     ?$"{SelectedAssetName} selected from {_assetSource}. Use Y or slide the left display to set scale."
     :$"{_assetSource} {_assetKind.ToLowerInvariant()} selected. Use Y or slide the left display to set scale.";
    break;
   case Stage.SaveCancel:
    SaveCurrentAssetToViewer();
    ResetAssetTransform();
    _stage=Stage.FullMapReview;
    _message=$"Saved {_assetKind.ToLowerInvariant()} at {CurrentBuilderScope} Tier {_tier}, Layer {_layer}. Review the full recursive map, continue this scope, or advance the GameMaster chain.";
    break;
   case Stage.FullMapReview:
    BeginBuilderScope(_builderChainIndex);
    _message=$"Continuing {CurrentBuilderSuite}. The previous full-map viewer remains visible while you choose Tier and Layer.";
    break;
   case Stage.WorldBuilderTier:
    _stage=Stage.WorldBuilderLayer;
    _message=$"Tier {_tier} selected. Choose Layer.";
    break;
   case Stage.WorldBuilderLayer:
    _stage=Stage.AssetKind;
    _assetKindIndex=Array.IndexOf(AssetKinds,_assetKind);
    if(_assetKindIndex<0)_assetKindIndex=0;
    _assetSourceIndex=0;
    _message=$"Tier {_tier}, Layer {_layer}. Slide the left display for Image or Sprite; slide the right display for its source.";
    break;
   case Stage.Scale:
    _stage=Stage.Rotate;
    _message=$"Scale {_assetScale:0.00}× selected. Use X or slide the right display to rotate.";
    break;
   case Stage.Rotate:
    _message="X rotates; Right/Set confirms.";
    break;
   case Stage.Move:
    _message="X/Y move; Right/Set confirms.";
    break;
  }
  return Task.CompletedTask;
 }

