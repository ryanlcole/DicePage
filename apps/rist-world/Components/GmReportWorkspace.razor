@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorldSession Session

<div class="gm-report-workspace" @ondragover:preventDefault="true" @ondrop="DropField">
 @if(!IsGameMaster)
 {
  <section class="gmr-locked">
   <strong>GAMEMASTER TRACKER</strong>
   <p>Shared campaign reports are available to the GameMaster.</p>
  </section>
 }
 else
 {
  <header class="gmr-header">
   <div>
    <small>SHARED JOINS · DISTINCT SOURCES · EFFECTIVE VALUES</small>
    <h2>TRACKER</h2>
    <p>Drag a shared field onto the report. Characters and encounters that expose the same join become directly comparable.</p>
   </div>
   <div class="gmr-actions">
    <button type="button" @onclick="ReloadAsync">REFRESH</button>
    <button type="button" @onclick="SaveReportAsync">@(_saved?"SAVED":"SAVE REPORT")</button>
   </div>
  </header>

  <div class="gmr-layout">
   <aside class="gmr-field-bank">
    <section>
     <header><b>CHARACTER FIELDS</b><small>@_requirements.Count</small></header>
     @if(_requirements.Count==0)
     {
      <p>No required joins yet. Choose them in Character Card Designer.</p>
     }
     @foreach(var field in _requirements)
     {
      <button type="button"
              draggable="true"
              @ondragstart="()=>StartDrag(field.SharedJoin,field.Name)"
              @onclick="()=>AddColumn(field.SharedJoin,field.Name)">
       <b>@field.Name</b>
       <small>@field.SharedJoin · @FriendlyKind(field.Kind)</small>
      </button>
     }
    </section>

    <section>
     <header><b>ENCOUNTER FIELDS</b><small>@EncounterJoins.Count</small></header>
     @if(EncounterJoins.Count==0)
     {
      <p>Encounter joins will appear here when encounters publish report rows.</p>
     }
     @foreach(var join in EncounterJoins)
     {
      <button type="button"
              draggable="true"
              @ondragstart="()=>StartDrag(join,join)"
              @onclick="()=>AddColumn(join,join)">
       <b>@join</b><small>Encounter shared join</small>
      </button>
     }
    </section>
   </aside>

   <main class="gmr-report">
    <div class="gmr-toolbar">
     <label><span>FILTER</span><input @bind="_filter" @bind:event="oninput" placeholder="Player, character, encounter…" /></label>
     <label><span>SOURCE</span><select @bind="_sourceFilter"><option>All</option><option>Character</option><option>Encounter</option></select></label>
     <span>@VisibleRows.Count row@(VisibleRows.Count==1?"":"s")</span>
    </div>

    @if(_columns.Count==0)
    {
     <section class="gmr-drop-empty">
      <strong>DROP SHARED FIELDS HERE</strong>
      <p>Each join creates one report column across every distinct source row that supplies it.</p>
     </section>
    }
    else
    {
     <div class="gmr-table-wrap">
      <table>
       <thead>
        <tr>
         <th>SOURCE</th>
         <th><button type="button" @onclick="SortSubject">SUBJECT @SortMark("__SUBJECT__")</button></th>
         @foreach(var column in _columns)
         {
          <th>
           <div class="gmr-column-head">
            <button type="button" @onclick="()=>SortBy(column.Join)">@column.Label @SortMark(column.Join)</button>
            <button type="button" class="remove" @onclick="()=>RemoveColumn(column.Join)">×</button>
           </div>
           <select value="@column.Aggregate" @onchange="e=>SetAggregate(column,e)">
            <option>None</option><option>Sum</option><option>Average</option><option>Min</option><option>Max</option>
           </select>
          </th>
         }
        </tr>
       </thead>
       <tbody>
        @foreach(var row in VisibleRows)
        {
         <tr>
          <td><span class="gmr-source @row.SourceType.ToLowerInvariant()">@row.SourceType</span></td>
          <td><b>@Subject(row)</b><small>@Secondary(row)</small></td>
          @foreach(var column in _columns)
          {
           var cell=Cell(row,column.Join);
           <td class="@(cell?.ModifierCount>0?"modified":"")">
            <strong>@(cell?.Text??"—")</strong>
            @if(cell?.ModifierCount>0)
            {
             <small>@cell.ModifierCount active effect@(cell.ModifierCount==1?"":"s") · base @FormatNumber(cell.Current)</small>
            }
           </td>
          }
         </tr>
        }
       </tbody>
       <tfoot>
        <tr>
         <td colspan="2">AGGREGATES</td>
         @foreach(var column in _columns)
         {
          <td><strong>@AggregateText(column)</strong><small>@column.Aggregate</small></td>
         }
        </tr>
       </tfoot>
      </table>
     </div>
    }
   </main>
  </div>
 }
</div>

<style>
 .gm-report-workspace{box-sizing:border-box;width:100%;height:100%;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);background:#050a0e;color:#e2dccb;font-family:Inter,system-ui,-apple-system,sans-serif}.gmr-locked{margin:auto;padding:24px;text-align:center;color:#91a4ad}.gmr-header{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 14px;border-bottom:1px solid #705b30;background:linear-gradient(90deg,#08131a,#151109)}.gmr-header small{color:#7da1b2;font-size:7px;font-weight:900;letter-spacing:.12em}.gmr-header h2{margin:2px 0;color:#efd392;font:600 20px Georgia,serif}.gmr-header p{margin:2px 0;color:#9aabb2;font-size:9px}.gmr-actions{display:flex;gap:6px}.gmr-actions button{min-height:34px;border:1px solid #5c7079;border-radius:7px;background:#0c1820;color:#e3d7b7;padding:0 9px;font:900 8px system-ui}.gmr-layout{min-height:0;display:grid;grid-template-columns:220px minmax(0,1fr)}.gmr-field-bank{min-height:0;overflow:auto;padding:9px;border-right:1px solid #334852;background:#081117}.gmr-field-bank section{display:grid;gap:5px;margin-bottom:14px}.gmr-field-bank header{display:flex;justify-content:space-between;color:#d7bc76;font-size:8px}.gmr-field-bank p{margin:0;color:#7f939c;font-size:8px;line-height:1.4}.gmr-field-bank button{min-height:43px;padding:6px 7px;border:1px solid #344a54;border-radius:7px;background:#0b171e;color:#dce2dd;display:grid;text-align:left}.gmr-field-bank button b{font-size:9px}.gmr-field-bank button small{color:#78909b;font-size:7px}.gmr-report{min-width:0;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden}.gmr-toolbar{display:flex;gap:7px;align-items:end;padding:7px;border-bottom:1px solid #2f4149;background:#081219}.gmr-toolbar label{display:grid;gap:3px}.gmr-toolbar label span{color:#8297a1;font-size:6px;font-weight:900}.gmr-toolbar input,.gmr-toolbar select{min-height:32px;border:1px solid #465b65;border-radius:6px;background:#0b161c;color:#e4dac0;padding:4px 6px}.gmr-toolbar>span{margin-left:auto;color:#78909b;font-size:8px}.gmr-drop-empty{margin:auto;padding:30px;border:1px dashed #647984;border-radius:12px;text-align:center;color:#8197a2}.gmr-drop-empty strong{display:block;color:#e0c576;font-size:12px}.gmr-table-wrap{min-height:0;overflow:auto}.gmr-table-wrap table{border-collapse:separate;border-spacing:0;min-width:100%;font-size:9px}.gmr-table-wrap th,.gmr-table-wrap td{min-width:120px;padding:7px;border-right:1px solid #263940;border-bottom:1px solid #263940;background:#091219;text-align:left;vertical-align:top}.gmr-table-wrap th{position:sticky;top:0;z-index:2;background:#101b21;color:#d9c181}.gmr-table-wrap th>button,.gmr-column-head button{border:0;background:transparent;color:inherit;font:900 8px system-ui}.gmr-column-head{display:grid;grid-template-columns:1fr 24px}.gmr-column-head .remove{color:#d29f91}.gmr-table-wrap th select{width:100%;margin-top:4px;border:1px solid #455a63;border-radius:5px;background:#091318;color:#d7d7cd;font-size:7px}.gmr-table-wrap td b,.gmr-table-wrap td strong{display:block;color:#e5dec9}.gmr-table-wrap td small{display:block;color:#7e939c;font-size:7px;margin-top:2px}.gmr-table-wrap td.modified{box-shadow:inset 3px 0 #caa64d}.gmr-source{display:inline-block;padding:3px 5px;border:1px solid #526670;border-radius:999px;color:#a8c2ce;font:900 6px system-ui}.gmr-source.encounter{border-color:#795144;color:#deb6a8}.gmr-table-wrap tfoot td{position:sticky;bottom:0;background:#15170f;color:#e0c16f}.gmr-table-wrap tfoot small{color:#968b68}
 @@media(max-width:760px){.gmr-header p{display:none}.gmr-layout{grid-template-columns:104px minmax(0,1fr)}.gmr-field-bank{padding:5px}.gmr-field-bank button{padding:4px;min-height:38px}.gmr-field-bank button small{display:none}.gmr-toolbar{flex-wrap:wrap}.gmr-toolbar input{max-width:160px}.gmr-table-wrap th,.gmr-table-wrap td{min-width:92px;padding:5px}}
</style>

@code {
 IJSObjectReference? _module;
 readonly List<Requirement> _requirements=[];
 readonly List<ReportRow> _rows=[];
 readonly List<ReportColumn> _columns=[];
 string _filter="",_sourceFilter="All",_sortJoin="__SUBJECT__",_dragJoin="",_dragLabel="";
 bool _sortAscending=true,_saved;

 bool IsGameMaster=>string.Equals(Session.Role,"GM",StringComparison.OrdinalIgnoreCase);
 string RequirementKey=>$"rist.character-card-requirements.v1.{Session.WorldId}";
 string ReportKey=>$"rist.gm-report.v1.{Session.WorldId}";
 string CharacterPrefix=>$"rist.character-report-row.v1.{Session.WorldId}.";
 string EncounterPrefix=>$"rist.encounter-report-row.v1.{Session.WorldId}.";
 List<string> EncounterJoins=>_rows.Where(x=>x.SourceType=="Encounter").SelectMany(x=>x.Values.Keys).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x=>x).ToList();

 IReadOnlyList<ReportRow> VisibleRows
 {
  get
  {
   IEnumerable<ReportRow> rows=_rows
    .GroupBy(x=>$"{x.SourceType}:{x.RowId}",StringComparer.OrdinalIgnoreCase)
    .Select(g=>g.Last());
   if(_sourceFilter!="All")rows=rows.Where(x=>string.Equals(x.SourceType,_sourceFilter,StringComparison.OrdinalIgnoreCase));
   if(!string.IsNullOrWhiteSpace(_filter))
   {
    var term=_filter.Trim();
    rows=rows.Where(x=>Subject(x).Contains(term,StringComparison.OrdinalIgnoreCase)||Secondary(x).Contains(term,StringComparison.OrdinalIgnoreCase));
   }
   rows=_sortJoin=="__SUBJECT__"
    ?(_sortAscending?rows.OrderBy(Subject,StringComparer.OrdinalIgnoreCase):rows.OrderByDescending(Subject,StringComparer.OrdinalIgnoreCase))
    :(_sortAscending?rows.OrderBy(x=>SortValue(x,_sortJoin)):rows.OrderByDescending(x=>SortValue(x,_sortJoin)));
   return rows.ToList();
  }
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _module=await JS.InvokeAsync<IJSObjectReference>("import","./gm-report-builder.js?v=20260924-shared-joins-1");
  await ReloadAsync();
  await LoadReportAsync();
  await InvokeAsync(StateHasChanged);
 }

 async Task ReloadAsync()
 {
  if(_module is null)return;
  _requirements.Clear();_rows.Clear();
  var requirements=await _module.InvokeAsync<List<Requirement>?>("readJsonValue",RequirementKey);
  if(requirements is not null)_requirements.AddRange(requirements.Where(x=>!string.IsNullOrWhiteSpace(x.SharedJoin)));
  var rows=await _module.InvokeAsync<List<ReportRow>?>("readJsonRows",new[]{CharacterPrefix,EncounterPrefix});
  if(rows is not null)_rows.AddRange(rows);
  _saved=false;await InvokeAsync(StateHasChanged);
 }

 async Task LoadReportAsync()
 {
  if(_module is null)return;
  var saved=await _module.InvokeAsync<ReportState?>("readJsonValue",ReportKey);
  if(saved?.Columns is {Count:>0}){_columns.Clear();_columns.AddRange(saved.Columns);}
 }

 void StartDrag(string join,string label){_dragJoin=join;_dragLabel=label;}
 void DropField(){if(!string.IsNullOrWhiteSpace(_dragJoin))AddColumn(_dragJoin,_dragLabel);_dragJoin="";_dragLabel="";}
 void AddColumn(string join,string label){if(string.IsNullOrWhiteSpace(join)||_columns.Any(x=>x.Join==join))return;_columns.Add(new(){Join=join,Label=string.IsNullOrWhiteSpace(label)?join:label});_saved=false;}
 void RemoveColumn(string join){_columns.RemoveAll(x=>x.Join==join);_saved=false;}
 void SortSubject()=>SortBy("__SUBJECT__");
  void SortBy(string join){if(_sortJoin==join)_sortAscending=!_sortAscending;else{_sortJoin=join;_sortAscending=true;}}
 string SortMark(string join)=>_sortJoin==join?(_sortAscending?"▲":"▼"):"";
 object SortValue(ReportRow row,string join){var cell=Cell(row,join);return cell?.Effective??cell?.Number??double.MinValue;}
 static ReportCell? Cell(ReportRow row,string join)=>row.Values.TryGetValue(join,out var value)?value:null;
 static string Subject(ReportRow row)=>row.SourceType=="Encounter"?(string.IsNullOrWhiteSpace(row.Encounter)?row.RowId:row.Encounter):(string.IsNullOrWhiteSpace(row.Character)?row.RowId:row.Character);
 static string Secondary(ReportRow row)=>row.SourceType=="Encounter"?"Encounter":row.Player;
 static string FormatNumber(double? value)=>value?.ToString("0.##")??"—";
 void SetAggregate(ReportColumn column,ChangeEventArgs e){column.Aggregate=e.Value?.ToString()??"None";_saved=false;}

 string AggregateText(ReportColumn column)
 {
  var values=VisibleRows.Select(row=>Cell(row,column.Join)?.Effective??Cell(row,column.Join)?.Number).Where(x=>x.HasValue).Select(x=>x!.Value).ToList();
  if(values.Count==0||column.Aggregate=="None")return "—";
  return column.Aggregate switch{
   "Sum"=>values.Sum().ToString("0.##"),
   "Average"=>values.Average().ToString("0.##"),
   "Min"=>values.Min().ToString("0.##"),
   "Max"=>values.Max().ToString("0.##"),
   _=>"—"
  };
 }

 async Task SaveReportAsync()
 {
  if(_module is null)return;
  await _module.InvokeVoidAsync("writeJsonValue",ReportKey,new ReportState{Columns=_columns});
  _saved=true;
 }

 static string FriendlyKind(string kind)=>kind switch{"ATTRIBUTE"=>"Attribute","TRACKER"=>"Tracker / Pool","LIMIT"=>"Limit","VALUE"=>"Skill / Value","FLARE"=>"Flare / Ability","MAGIC"=>"Spell / Magic","LANGUAGE"=>"Language",_=>kind};

 public async ValueTask DisposeAsync(){if(_module is not null)await _module.DisposeAsync();}

 sealed class Requirement{public string Name{get;set;}="";public string SharedJoin{get;set;}="";public string Kind{get;set;}="TEXT";}
 sealed class ReportState{public List<ReportColumn> Columns{get;set;}=[];}
 sealed class ReportColumn{public string Join{get;set;}="";public string Label{get;set;}="";public string Aggregate{get;set;}="None";}
 sealed class ReportRow{
  public string RowId{get;set;}="";
  public string SourceType{get;set;}="Character";
  public string Player{get;set;}="";
  public string Character{get;set;}="";
  public string Encounter{get;set;}="";
  public Dictionary<string,ReportCell> Values{get;set;}=new(StringComparer.OrdinalIgnoreCase);
 }
 sealed class ReportCell{
  public string Kind{get;set;}="TEXT";
  public string Text{get;set;}="";
  public double? Number{get;set;}
  public double? Effective{get;set;}
  public double? Base{get;set;}
  public double? Current{get;set;}
  public double? Max{get;set;}
  public int ModifierCount{get;set;}
 }
}
