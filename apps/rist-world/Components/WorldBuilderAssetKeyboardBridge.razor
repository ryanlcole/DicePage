@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
 DotNetObjectReference<WorldBuilderAssetKeyboardBridge>? _self;

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _self=DotNetObjectReference.Create(this);
  try{await JS.InvokeVoidAsync("RistWorldBuilderAssetKeyboardBridge.attach",_self);}catch{}
 }

 [JSInvokable]
 public Task<WorldBuilderAssetKeyboardItem[]> GetAssetKeyboardCatalog()
  => WorldBuilderStudio.ActiveAssetKeyboardInstance?.GetAssetKeyboardCatalog()
     ?? Task.FromResult(Array.Empty<WorldBuilderAssetKeyboardItem>());

 [JSInvokable]
 public Task<WorldBuilderAssetKeyboardFootprint[]> GetAssetKeyboardFootprints()
  => WorldBuilderStudio.ActiveAssetKeyboardInstance?.GetAssetKeyboardFootprints()
     ?? Task.FromResult(Array.Empty<WorldBuilderAssetKeyboardFootprint>());

 [JSInvokable]
 public Task<int> PlaceAssetKeyboardItemFromJs(string assetId,double worldX,double worldY,int widthCells,int heightCells)
  => WorldBuilderStudio.ActiveAssetKeyboardInstance?.PlaceAssetKeyboardItemFromJs(assetId,worldX,worldY,widthCells,heightCells)
     ?? Task.FromResult(-1);

 public async ValueTask DisposeAsync()
 {
  if(_self is not null)try{await JS.InvokeVoidAsync("RistWorldBuilderAssetKeyboardBridge.detach",_self);}catch{}
  _self?.Dispose();
 }
}
