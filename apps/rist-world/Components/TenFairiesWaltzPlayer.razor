<aside class="ten-fairies-player" aria-label="The Ten Fairies modern Suno realization">
 <div class="ten-fairies-dock">
  <div class="ten-fairies-dock-title">
   <strong>THE TEN FAIRIES</strong>
   <small>PART @(_part == 1 ? "I" : "II") · SUNO</small>
  </div>

  <div class="ten-fairies-parts" aria-label="Choose The Ten Fairies part">
   <button type="button" class="ten-fairies-part" disabled="@(_part == 1)" @onclick="() => SelectPart(1)" aria-label="Select Part 1">I</button>
   <button type="button" class="ten-fairies-part" disabled="@(_part == 2)" @onclick="() => SelectPart(2)" aria-label="Select Part 2">II</button>
  </div>

  <audio @key="_part" class="ten-fairies-audio" controls preload="metadata" playsinline aria-label="@($"Play The Ten Fairies Part {_part} modern Suno realization")">
   <source src="@CurrentSource" type="audio/mpeg" />
   Your browser does not support audio playback.
  </audio>

  <div class="ten-fairies-ticker" role="note" aria-label="The Ten Fairies provenance and attribution">
   <span>Inspired by and dedicated to “Winthrop,” the printed composer credit on the historical <em>The Ten Fairies</em> · Historical source: Library of Congress, <em>Music for the Nation: American Sheet Music, ca. 1870–1885</em> · Modern audio realization: Suno · Not a historical recording · Attribution research associates J. R. Winthrop with James Ramsey Murray (1841–1905), but that identification is not yet conclusively tied to this score.</span>
  </div>
 </div>
</aside>

@code {
 private int _part = 1;
 private const string Part1 = "https://d2d6rnm6fnsp89.cloudfront.net/music/ten-fairies/Ten_Fairies_Part_1.mp3";
 private const string Part2 = "https://d2d6rnm6fnsp89.cloudfront.net/music/ten-fairies/Ten_Fairies_Part_2.mp3";
 private string CurrentSource => _part == 1 ? Part1 : Part2;
 private void SelectPart(int part) => _part = part is 1 or 2 ? part : 1;
}

<style>
 .ten-fairies-player{display:none;position:fixed;z-index:2147483550;bottom:max(7px,env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:min(820px,calc(100vw - 14px));box-sizing:border-box;color:#eee6d2;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;text-align:left}
 body:has(.rist-auth-start) .ten-fairies-player,
 body:has(.launcher-hub) .ten-fairies-player{display:block}
 .ten-fairies-dock{display:grid;grid-template-columns:minmax(118px,.42fr) auto minmax(280px,1.58fr);grid-template-areas:"title parts audio" "ticker ticker ticker";gap:5px 8px;align-items:center;overflow:hidden;padding:6px 8px 5px;border:1px solid rgba(183,150,75,.78);border-radius:11px;background:rgba(4,10,14,.91);box-shadow:0 10px 28px rgba(0,0,0,.42);backdrop-filter:blur(8px)}
 .ten-fairies-dock-title{grid-area:title;min-width:0;display:grid;gap:2px}.ten-fairies-dock-title strong{color:#f0d68e;font:900 9px/1.05 system-ui;letter-spacing:.11em}.ten-fairies-dock-title small{color:#9fb0b7;font:750 7px/1.1 system-ui;letter-spacing:.07em}
 .ten-fairies-parts{grid-area:parts;display:flex;gap:4px}.ten-fairies-part{min-width:30px;height:29px;border:1px solid rgba(183,150,75,.58);border-radius:6px;background:#101820;color:#d9c78f;font:900 10px/1 system-ui;padding:0}.ten-fairies-part:disabled{opacity:1;background:#5a421d;color:#fff0b8;border-color:#d0a853}.ten-fairies-part:not(:disabled){cursor:pointer}
 .ten-fairies-audio{grid-area:audio;display:block;width:100%;min-width:0;height:29px;margin:0}
 .ten-fairies-ticker{grid-area:ticker;min-width:0;overflow:hidden;white-space:nowrap;border-top:1px solid rgba(183,150,75,.22);padding-top:3px;color:#b9c4c8;font:650 8px/1.2 Georgia,"Times New Roman",serif}
 .ten-fairies-ticker>span{display:inline-block;min-width:max-content;padding-left:100%;animation:ten-fairies-scroll 60s linear infinite}.ten-fairies-ticker em{color:#dbc98f}
 @@keyframes ten-fairies-scroll{from{transform:translateX(0)}to{transform:translateX(-100%)}}
 @@media(max-width:620px){
  .ten-fairies-player{width:calc(100vw - 10px);bottom:max(5px,env(safe-area-inset-bottom))}
  .ten-fairies-dock{grid-template-columns:1fr auto minmax(180px,2fr);grid-template-areas:"title parts audio" "ticker ticker ticker";gap:3px;padding:5px 6px 4px}
  .ten-fairies-dock-title small{display:none}
  .ten-fairies-part{min-width:27px;height:28px}.ten-fairies-audio{height:28px}
  .ten-fairies-ticker{font-size:7.5px;padding-top:2px}
 }
 @@media(prefers-reduced-motion:reduce){.ten-fairies-ticker{overflow-x:auto}.ten-fairies-ticker>span{padding-left:0;animation:none}}
 @@media(prefers-reduced-transparency:reduce){.ten-fairies-dock{background:#040a0e;backdrop-filter:none}}
</style>