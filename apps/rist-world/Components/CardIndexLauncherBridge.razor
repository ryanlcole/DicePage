@implements IAsyncDisposable
@inject IJSRuntime JS

@if(_open)
{
 <section class="card-index-overlay" role="dialog" aria-modal="true" aria-label="Card Index">
  <header><button type="button" @onclick="Close">← BACK</button><strong>CARD INDEX</strong></header>
  <CardIndexWorkspace />
 </section>
}

<style>
 .card-index-overlay{position:fixed;inset:0;z-index:2147482400;display:grid;grid-template-rows:34px minmax(0,1fr);background:#03080c}.card-index-overlay>header{display:flex;align-items:center;gap:12px;padding:0 10px;border-bottom:1px solid #715b2d;background:#081017;color:#e8dec5}.card-index-overlay>header button{height:26px;border:1px solid #53636b;border-radius:6px;background:#0d171e;color:#e4c97d;font-weight:900}.card-index-overlay>header strong{font-size:10px;letter-spacing:.12em;color:#e5c878}
</style>

@code {
 bool _open;
 IJSObjectReference? _module;
 IJSObjectReference? _binding;
 DotNetObjectReference<CardIndexLauncherBridge>? _self;

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _self=DotNetObjectReference.Create(this);
  _module=await JS.InvokeAsync<IJSObjectReference>("import","./card-index-launcher.js?v=20260910-card-index-1");
  _binding=await _module.InvokeAsync<IJSObjectReference>("attach",_self);
 }

 [JSInvokable]
 public Task OpenCardIndexFromJs()
 {
  _open=true;
  return InvokeAsync(StateHasChanged);
 }

 void Close()=>_open=false;

 public async ValueTask DisposeAsync()
 {
  if(_binding is not null)try{await _binding.InvokeVoidAsync("dispose");}catch{}
  if(_binding is not null)await _binding.DisposeAsync();
  if(_module is not null)await _module.DisposeAsync();
  _self?.Dispose();
 }
}
