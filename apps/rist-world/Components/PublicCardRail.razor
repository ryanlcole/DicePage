@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject WorldSession Session
<section id="public-card-slider" class="public-assets-rail" aria-label="Public assets" @ondragover:preventDefault="true" @ondrop="Session.PublishDraggedHandCard">
 <header class="asset-rail-header public-assets-header">
  <strong>Public Assets</strong>
  <nav class="asset-type-tabs public-asset-tabs" aria-label="Public asset type">
   @foreach(var type in AssetTypes)
   {
    <button type="button" class="@(Session.PublicAssetType==type.Key?"active":"")" @onclick="()=>Session.SetPublicAssetType(type.Key)" aria-pressed="@(Session.PublicAssetType==type.Key)">@type.Label</button>
   }
  </nav>
 </header>
 <div id="public-assets-slider" class="public-assets-strip desktop-arrow-slider">
  <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#public-assets-slider',-1)" aria-label="Scroll public assets left">‹</button>
  <div class="public-assets-items">
   <button class="token-pin-source public-pin-source" @onpointerdown="BeginPinDrag" @onpointerup="EndPinDrag" @onpointercancel="CancelPinDrag" @oncontextmenu:preventDefault aria-label="Drag public map pin onto map" title="Map pin"><span class="map-pin-icon" aria-hidden="true"></span></button>
   <div class="z-axis-controls" aria-label="Z axis navigation">
    <label class="z-axis-select" title="Navigate to an available tier or add one">
     <span>Tier</span>
     <select value="@Session.TierIndex" @onchange="ChangeTier" aria-label="Tier">
      @foreach(var tier in Session.AvailableTierIndices)
      {
       <option value="@tier">@tier · z@(tier*WorldSession.LayersPerTier)</option>
      }
      <option value="__add" disabled="@(!Session.CanAddTier)">＋ Add Tier</option>
     </select>
    </label>
    <label class="z-axis-select" title="Select an available layer or add one">
     <span>Layer</span>
     <select value="@Session.LayerOffset" @onchange="ChangeLayer" aria-label="Layer">
      @foreach(var layer in Session.AvailableLayerOffsets)
      {
       <option value="@layer">@layer · z@(Session.TierIndex*WorldSession.LayersPerTier+layer)</option>
      }
      <option value="__add" disabled="@(!Session.CanAddLayer)">＋ Add Layer</option>
     </select>
    </label>
   </div>
   @if(Session.PublicAssetType is "all" or "cards")
   {
    @if(Session.PublicCards.Count==0)
    {
     <span class="public-assets-empty rail-drop-prompt">Drag public assets here</span>
    }
    else
    {
     @foreach(var card in Session.PublicCards)
     {
      <button class="public-asset-card" style="@CardStyle(card)" title="@card.Name" @onclick="()=>Session.RollHandCardWithHistoryAsync(card)">
       @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
       else{<span>@Glyph(card)</span>}
       <small>@card.Name</small>
      </button>
     }
    }
   }
   else
   {
    <span class="public-assets-empty rail-drop-prompt">Drag public assets here</span>
   }
  </div>
  <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#public-assets-slider',1)" aria-label="Scroll public assets right">›</button>
 </div>
</section>

<style>
.release-world .public-assets-items>.z-axis-controls{display:flex!important;align-items:stretch!important;gap:4px!important;flex:0 0 auto!important;width:auto!important;min-width:0!important;height:36px!important}
.release-world .z-axis-select{box-sizing:border-box!important;display:grid!important;grid-template-rows:11px 1fr!important;width:78px!important;min-width:78px!important;height:36px!important;padding:2px 4px!important;border:1px solid #5f4d29!important;border-radius:6px!important;background:#10181d!important;color:#c6b88d!important;overflow:hidden!important}
.release-world .z-axis-select>span{font:800 7px/9px system-ui!important;letter-spacing:.08em!important;text-transform:uppercase!important;color:#d7be80!important;text-align:center!important}
.release-world .z-axis-select>select{box-sizing:border-box!important;width:100%!important;height:19px!important;min-height:19px!important;margin:0!important;padding:0 2px!important;border:0!important;outline:0!important;background:#172229!important;color:#fff0bd!important;font:800 9px/19px system-ui!important;text-align:center!important;cursor:pointer!important}
</style>

@code{
 static readonly (string Key,string Label)[] AssetTypes=[("all","All"),("cards","Cards"),("tokens","Tokens / Chits"),("minis","Minis"),("rolling-stock","Rolling Stock"),("pawns","Pawns / Meeples"),("tiles","Tiles"),("terrain","Terrain"),("bits","Bits")];
 string AssetTypeLabel=>AssetTypes.First(x=>x.Key==Session.PublicAssetType).Label;
 void ChangeTier(ChangeEventArgs e){var value=e.Value?.ToString();if(value=="__add")Session.AddTier();else if(int.TryParse(value,out var tier))Session.NavigateToTier(tier);}
 void ChangeLayer(ChangeEventArgs e){var value=e.Value?.ToString();if(value=="__add")Session.AddLayer();else if(int.TryParse(value,out var layer))Session.NavigateToLayer(layer);}
 async Task BeginPinDrag(PointerEventArgs e){Session.BeginHeaderPinDrag();await JS.InvokeVoidAsync("ristWorld.capturePointer",e.PointerId,e.ClientX,e.ClientY);}
 async Task EndPinDrag(PointerEventArgs e){var p=await JS.InvokeAsync<double[]>("ristWorld.railPinDrop",e.ClientX,e.ClientY);if(p.Length>=3&&p[0]>.5)Session.PlaceHeaderPin(p[1],p[2]);else Session.EndHeaderPinDrag();}
 void CancelPinDrag(PointerEventArgs e)=>Session.EndHeaderPinDrag();
 string CardStyle(HandCard card)=>$"--field-accent:{AccentHex(card.Field.Color)}";
 static string Glyph(HandCard card)=>WorldSession.IsTrackerField(card.Field)?"◉":WorldSession.IsFlareField(card.Field)?"✦":"•";
 static string AccentHex(string c)=>c switch{"red"=>"#c7493a","orange"=>"#e9852c","gold"=>"#d9a82f","green"=>"#58a765","teal"=>"#41aaa4","blue"=>"#4c82d5","purple"=>"#9653c9",_=>"#d9a82f"};
}