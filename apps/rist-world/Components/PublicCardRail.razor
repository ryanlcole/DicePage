@inject WorldSession Session
<section id="public-card-slider" class="public-assets-rail desktop-arrow-slider" aria-label="Public assets" @ondragover:preventDefault="true" @ondrop="Session.PublishDraggedHandCard">
 <strong class="public-assets-title">Public Assets</strong>
 <nav class="asset-type-tabs public-asset-tabs" aria-label="Public asset type">
  @foreach(var type in AssetTypes)
  {
   <button type="button" class="@(Session.PublicAssetType==type.Key?"active":"")" @onclick="()=>Session.SetPublicAssetType(type.Key)" aria-pressed="@(Session.PublicAssetType==type.Key)">@type.Label</button>
  }
 </nav>
 @if(Session.PublicAssetType is "all" or "cards")
 {
  <div class="public-card-strip public-assets-card-strip">
   @if(Session.PublicCards.Count==0)
   {
    <span class="public-assets-empty">@(Session.IsLoggedIn?"No public cards.":"Log in for additional features.")</span>
   }
   else
   {
    @foreach(var card in Session.PublicCards)
    {
     <button class="public-asset-card" style="@CardStyle(card)" title="@card.Name" @onclick="()=>Session.RollHandCardWithHistoryAsync(card)">
      @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
      else{<span>@Glyph(card)</span>}
      <small>@card.Name</small>
     </button>
    }
   }
  </div>
 }
</section>

<style>
.public-assets-rail{box-sizing:border-box;min-width:0;display:flex;align-items:center;gap:6px;padding:3px 6px;background:#0d1319;border-block:1px solid #6e592c;color:#eee6d3;overflow:hidden}.public-assets-title{flex:0 0 auto;color:#d7be80;font:800 9px/1 system-ui;letter-spacing:.13em;text-transform:uppercase}.public-asset-tabs{flex:0 1 auto;max-width:56%;}.public-assets-card-strip{min-width:0;flex:1;display:flex;align-items:center;gap:4px;overflow-x:auto;scrollbar-width:none}.public-assets-card-strip::-webkit-scrollbar{display:none}.public-asset-card{flex:0 0 34px;width:34px;height:34px;display:grid;place-items:center;padding:2px;border:1px solid #6e592c;border-radius:6px;background:#111920;color:#e5d7b6;overflow:hidden}.public-asset-card img{width:100%;height:100%;object-fit:cover}.public-asset-card small{display:none}.public-assets-empty{color:#8f8879;font-size:9px;white-space:nowrap}
</style>

@code{
 static readonly (string Key,string Label)[] AssetTypes=[("all","All"),("cards","Cards"),("tokens","Tokens"),("minis","Minis"),("tiles","Tiles"),("terrain","Terrain"),("bits","Bits")];
 string CardStyle(HandCard card)=>$"--field-accent:{AccentHex(card.Field.Color)}";
 static string Glyph(HandCard card)=>WorldSession.IsTrackerField(card.Field)?"◉":WorldSession.IsFlareField(card.Field)?"✦":"•";
 static string AccentHex(string c)=>c switch{"red"=>"#c7493a","orange"=>"#e9852c","gold"=>"#d9a82f","green"=>"#58a765","teal"=>"#41aaa4","blue"=>"#4c82d5","purple"=>"#9653c9",_=>"#d9a82f"};
}
