@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject WorldSession Session
<section id="public-card-slider" class="public-assets-rail" aria-label="Public assets" @ondragover:preventDefault="true" @ondrop="Session.PublishDraggedHandCard">
 <header class="asset-rail-header public-assets-header">
  <strong>Public Assets</strong>
  <nav class="asset-type-tabs public-asset-tabs" aria-label="Public asset type">
   @foreach(var type in AssetTypes)
   {
    <button type="button" class="@(Session.PublicAssetType==type.Key?"active":"")" @onclick="()=>Session.SetPublicAssetType(type.Key)" aria-pressed="@(Session.PublicAssetType==type.Key)">@type.Label</button>
   }
  </nav>
 </header>
 <div id="public-assets-slider" class="public-assets-strip desktop-arrow-slider">
  <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#public-assets-slider',-1)" aria-label="Scroll public assets left">‹</button>
  <div class="public-assets-items">
   <div class="public-assets-lead">
    <button class="token-pin-source public-pin-source" @onpointerdown="BeginPinDrag" @onpointerup="EndPinDrag" @onpointercancel="CancelPinDrag" @oncontextmenu:preventDefault aria-label="Drag public map pin onto map" title="Map pin"><span class="map-pin-icon" aria-hidden="true"></span></button>
    <div class="z-axis-controls" aria-label="Z axis navigation">
     <div class="z-axis-picker @(_tierOpen?"open":"")">
      <button type="button" class="z-axis-trigger" @onclick="ToggleTierOptions" aria-expanded="@_tierOpen" aria-label="Tier @Session.TierIndex. Tap to choose tier.">
       <span>Tier</span><strong>@Session.TierIndex · z@(Session.TierIndex*WorldSession.LayersPerTier)</strong>
      </button>
      @if(_tierOpen)
      {
       <div class="z-axis-options" role="listbox" aria-label="Tier options">
        @foreach(var tier in Session.AvailableTierIndices)
        {
         <button type="button" class="@(Session.TierIndex==tier?"selected":"")" @onclick="()=>SelectTier(tier)" aria-selected="@(Session.TierIndex==tier)">@tier <small>z@(tier*WorldSession.LayersPerTier)</small></button>
        }
        @if(Session.CanAddTier){<button type="button" class="add-axis" @onclick="AddTier">＋ Tier</button>}
       </div>
      }
     </div>
     <div class="z-axis-picker @(_layerOpen?"open":"")">
      <button type="button" class="z-axis-trigger" @onclick="ToggleLayerOptions" aria-expanded="@_layerOpen" aria-label="Layer @Session.LayerOffset. Tap to choose layer.">
       <span>Layer</span><strong>@Session.LayerOffset · z@(Session.TierIndex*WorldSession.LayersPerTier+Session.LayerOffset)</strong>
      </button>
      @if(_layerOpen)
      {
       <div class="z-axis-options" role="listbox" aria-label="Layer options">
        @foreach(var layer in Session.AvailableLayerOffsets)
        {
         <button type="button" class="@(Session.LayerOffset==layer?"selected":"")" @onclick="()=>SelectLayer(layer)" aria-selected="@(Session.LayerOffset==layer)">@layer <small>z@(Session.TierIndex*WorldSession.LayersPerTier+layer)</small></button>
        }
        @if(Session.CanAddLayer){<button type="button" class="add-axis" @onclick="AddLayer">＋ Layer</button>}
       </div>
      }
     </div>
    </div>
   </div>
   @if(Session.PublicAssetType is "all" or "cards")
   {
    @if(Session.PublicCards.Count==0)
    {
     <span class="public-assets-empty rail-drop-prompt">Drag public assets here</span>
    }
    else
    {
     @foreach(var card in Session.PublicCards)
     {
      <button class="public-asset-card" style="@CardStyle(card)" title="@card.Name" @onclick="()=>Session.RollHandCardWithHistoryAsync(card)">
       @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
       else{<span>@Glyph(card)</span>}
       <small>@card.Name</small>
      </button>
     }
    }
   }
   else
   {
    <span class="public-assets-empty rail-drop-prompt">Drag public assets here</span>
   }
  </div>
  <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#public-assets-slider',1)" aria-label="Scroll public assets right">›</button>
 </div>
</section>

<style>
/* Each asset section is two context rows total: one menu row + one slider row. */
.rist.release-world{--rw-public:calc(var(--rw-context)*2)!important;--rw-private:calc(var(--rw-context)*2)!important}
.release-world .release-public-region>.public-assets-rail,.release-world .release-private-region>.private-assets-rail{grid-template-rows:var(--rw-context) var(--rw-context)!important}
.release-world .asset-rail-header{height:var(--rw-context)!important;min-height:var(--rw-context)!important;max-height:var(--rw-context)!important;padding:2px 6px!important}
.release-world .asset-type-tabs{height:calc(var(--rw-context) - 4px)!important}
.release-world .asset-type-tabs button{height:calc(var(--rw-context) - 6px)!important;min-height:calc(var(--rw-context) - 6px)!important;line-height:calc(var(--rw-context) - 8px)!important}

/* Slider height determines artwork height. Artwork aspect ratio determines border width. */
.release-world .public-assets-items,.release-world .private-assets-items{--asset-gap:3px!important;align-items:center!important;padding-block:var(--asset-gap)!important}
.release-world .public-assets-items>button,.release-world .private-assets-items>button,.release-world .private-assets-items .hand-card-wrap{box-sizing:border-box!important;flex:0 0 auto!important;width:auto!important;min-width:0!important;max-width:none!important;height:calc(100% - (var(--asset-gap) * 2))!important;min-height:calc(100% - (var(--asset-gap) * 2))!important;max-height:calc(100% - (var(--asset-gap) * 2))!important;margin:0!important;padding:2px!important}
.release-world .public-assets-items .public-asset-card,.release-world .private-assets-items .compact-hand-card,.release-world .private-assets-items .standard-hand-card,.release-world .public-assets-rail .token-pin-source,.release-world .private-assets-rail .token-pin-source{box-sizing:border-box!important;flex:0 0 auto!important;width:auto!important;min-width:0!important;max-width:none!important;height:calc(100% - (var(--asset-gap) * 2))!important;min-height:calc(100% - (var(--asset-gap) * 2))!important;max-height:calc(100% - (var(--asset-gap) * 2))!important;padding:2px!important}
.release-world .public-assets-items .public-asset-card>img,.release-world .private-assets-items .compact-hand-card>img,.release-world .private-assets-items .standard-hand-card>img{display:block!important;width:auto!important;min-width:0!important;max-width:none!important;height:100%!important;max-height:100%!important;object-fit:contain!important;object-position:center!important;margin:0!important}
.release-world .public-assets-rail .token-pin-source,.release-world .private-assets-rail .token-pin-source{aspect-ratio:5 / 6!important}
/* Keep pin + Tier + Layer anchored at the start while the actual assets scroll behind them. */
.release-world .public-assets-items>.public-assets-lead{box-sizing:border-box!important;position:sticky!important;left:0!important;z-index:20!important;display:flex!important;align-items:center!important;gap:4px!important;flex:0 0 auto!important;height:100%!important;padding:3px 4px 3px 0!important;margin:0!important;background:#0b141b!important}
.release-world .public-assets-lead>.token-pin-source{height:calc(100% - 6px)!important;min-height:calc(100% - 6px)!important;max-height:calc(100% - 6px)!important;margin:0!important;padding:2px!important}
/* Map pin uses the normalized IMG_7741 UI sheet: bottom-right cell is the pin artwork. */
.release-world .public-assets-rail .map-pin-icon,.release-world .private-assets-rail .map-pin-icon{display:block!important;height:100%!important;width:auto!important;max-height:100%!important;aspect-ratio:5 / 6!important;background-image:url('assets/normalized/chat-imports/2026-08-30/uploaded-references/IMG_7741.png')!important;background-size:400% 300%!important;background-position:100% 100%!important;background-repeat:no-repeat!important;background-color:transparent!important}

.release-world .public-assets-lead>.z-axis-controls{display:flex!important;align-items:stretch!important;gap:4px!important;flex:0 0 auto!important;width:auto!important;min-width:0!important;height:calc(100% - 6px)!important}
.release-world .z-axis-picker{box-sizing:border-box!important;display:flex!important;align-items:stretch!important;gap:4px!important;flex:0 0 auto!important;width:max-content!important;min-width:0!important;height:100%!important}
.release-world .z-axis-trigger{box-sizing:border-box!important;display:grid!important;grid-template-rows:11px 1fr!important;width:max-content!important;min-width:0!important;max-width:none!important;height:100%!important;padding:2px 7px!important;border:1px solid #5f4d29!important;border-radius:6px!important;background:#10181d!important;color:#c6b88d!important;overflow:hidden!important;touch-action:manipulation!important}
.release-world .z-axis-trigger>span{font:800 7px/9px system-ui!important;letter-spacing:.08em!important;text-transform:uppercase!important;color:#d7be80!important;text-align:center!important}
.release-world .z-axis-trigger>strong{align-self:center!important;color:#fff0bd!important;font:800 9px/1 system-ui!important;text-align:center!important;white-space:nowrap!important}
.release-world .z-axis-picker.open>.z-axis-trigger{border-color:#a57c2f!important;background:#172229!important}
.release-world .z-axis-options{display:flex!important;align-items:stretch!important;gap:3px!important;height:100%!important;max-width:min(56vw,390px)!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none!important;-webkit-overflow-scrolling:touch!important}
.release-world .z-axis-options::-webkit-scrollbar{display:none!important}
.release-world .z-axis-options>button{box-sizing:border-box!important;flex:0 0 auto!important;min-width:54px!important;height:100%!important;padding:2px 7px!important;border:1px solid #5f4d29!important;border-radius:6px!important;background:#10181d!important;color:#fff0bd!important;font:800 9px/1 system-ui!important;touch-action:manipulation!important}
.release-world .z-axis-options>button small{display:block!important;margin-top:2px!important;color:#8ebeed!important;font:700 7px/1 system-ui!important}
.release-world .z-axis-options>button.selected{border-color:#d0aa4f!important;background:#1b2a32!important;color:#fff3c5!important}
.release-world .z-axis-options>button.add-axis{color:#d7be80!important}
</style>

@code{
 static readonly (string Key,string Label)[] AssetTypes=[("all","All"),("cards","Cards"),("tokens","Tokens / Chits"),("minis","Minis"),("rolling-stock","Rolling Stock"),("pawns","Pawns / Meeples"),("tiles","Tiles"),("terrain","Terrain"),("bits","Bits")];
 bool _tierOpen;
 bool _layerOpen;
 string AssetTypeLabel=>AssetTypes.First(x=>x.Key==Session.PublicAssetType).Label;
 void ToggleTierOptions(){_tierOpen=!_tierOpen;_layerOpen=false;}
 void ToggleLayerOptions(){_layerOpen=!_layerOpen;_tierOpen=false;}
 void SelectTier(int tier){Session.NavigateToTier(tier);_tierOpen=false;}
 void SelectLayer(int layer){Session.NavigateToLayer(layer);_layerOpen=false;}
 void AddTier(){Session.AddTier();_tierOpen=false;}
 void AddLayer(){Session.AddLayer();_layerOpen=false;}
 async Task BeginPinDrag(PointerEventArgs e){Session.BeginHeaderPinDrag();await JS.InvokeVoidAsync("ristWorld.capturePointer",e.PointerId,e.ClientX,e.ClientY);}
 async Task EndPinDrag(PointerEventArgs e){var p=await JS.InvokeAsync<double[]>("ristWorld.railPinDrop",e.ClientX,e.ClientY);if(p.Length>=3&&p[0]>.5)Session.PlaceHeaderPin(p[1],p[2]);else Session.EndHeaderPinDrag();}
 void CancelPinDrag(PointerEventArgs e)=>Session.EndHeaderPinDrag();
 string CardStyle(HandCard card)=>$"--field-accent:{AccentHex(card.Field.Color)}";
 static string Glyph(HandCard card)=>WorldSession.IsTrackerField(card.Field)?"◉":WorldSession.IsFlareField(card.Field)?"✦":"•";
 static string AccentHex(string c)=>c switch{"red"=>"#c7493a","orange"=>"#e9852c","gold"=>"#d9a82f","green"=>"#58a765","teal"=>"#41aaa4","blue"=>"#4c82d5","purple"=>"#9653c9",_=>"#d9a82f"};
}