@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject WorldSession Session
<section class="player-tools-rail" aria-label="Player hand and token placement">
 <div class="player-hand-pane" aria-label="Player card hand">
  <span class="player-tools-label">Hand</span>
  <div class="player-hand-strip">
   <button class="compact-hand-card hand-deck-card" @onclick="Session.StandardDeckClick" aria-expanded="@Session.HandOpen" aria-label="Open deck or draw a random card"><span class="hand-toggle-card-back" aria-hidden="true"></span></button>
   <button class="compact-hand-card character-hand-card approved" @onclick="Session.OpenMixer" aria-label="Open active character sheet">
    @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
    else{<span class="drawer-glyph">CHAR</span>}
   </button>
   @foreach(var card in Session.HandCards)
   {
    <div class="hand-card-wrap @card.ApprovalStatus">
     <button class="compact-hand-card @card.ApprovalStatus" style="@CardStyle(card)" @onclick="()=>HandCardClick(card)" aria-label="@($"{card.Name}, {card.ApprovalStatus}")">
      @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
      else{<span class="drawer-glyph">@Glyph(card)</span>}
      @if(card.ApprovalStatus==HandCard.Pending){<span class="pending-mark" aria-hidden="true">?</span>}
     </button>
     @if(Session.Role=="GM"&&card.ApprovalStatus==HandCard.Pending)
     {
      <span class="approval-actions"><button @onclick="()=>Session.ApproveHandCard(card)" aria-label="Approve @card.Name">✓</button><button @onclick="()=>Session.DenyHandCard(card)" aria-label="Deny @card.Name">×</button></span>
     }
    </div>
   }
   @foreach(var card in Session.StandardHandCards)
   {
    <button class="compact-hand-card standard-hand-card approved" @onclick="()=>Session.ShowCard(card)" aria-label="@card.Name">
     <span class="standard-card-face"><small>@card.Type</small><strong>@card.Name</strong></span>
    </button>
   }
  </div>
 </div>
 <div class="token-placement-pane" aria-label="Token placement">
  <span class="player-tools-label">Tokens</span>
  <div class="token-choice-strip">
   <button @onclick='()=>Session.StagePiece("mini")' aria-label="Add miniature to pallet"><span class="token-choice mini-choice">mini</span></button>
   <button @onclick='()=>Session.StagePiece("pawn")' aria-label="Add pawn to pallet"><span class="token-choice pawn-choice">pawn</span></button>
   @foreach(var asset in Session.StagedAssets.Where(x=>x.Kind!="tile"&&x.Kind!="pin"))
   {
    <div class="token-approval-chip @asset.ApprovalStatus">
     @if(asset.Kind=="pin"){<span class="header-icon icon-pin token-pin-icon" aria-hidden="true"></span>}
     else{<span class="token-choice">@asset.Kind</span>}
     @if(Session.Role=="GM"&&asset.ApprovalStatus==HandCard.Pending){<span class="approval-actions"><button @onclick="()=>Session.ApproveStaged(asset.Key)" aria-label="Approve @asset.Name">✓</button><button @onclick="()=>Session.DenyStaged(asset.Key)" aria-label="Deny @asset.Name">×</button></span>}
    </div>
   }
  </div>
 </div>
</section>
@if(Session.HandOpen)
{
<section class="card-triple-drawer card-quad-drawer" aria-label="Character and card drawer">
 <div class="card-drawer-row character-row" aria-label="Characters and companions">
  <button class="drawer-category-card" @onclick="Session.OpenMixer"><span class="category-card-back"></span><strong>Character</strong></button>
  <button class="drawer-front character-front" @onclick="Session.OpenMixer" aria-label="Open active character">
   @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
   else{<span class="drawer-glyph">CHAR</span>}
   <strong>@(string.IsNullOrWhiteSpace(Session.CharacterName)?"Character":Session.CharacterName)</strong>
  </button>
 </div>
 <div class="card-drawer-row action-row" aria-label="Action cards">
  <div class="drawer-category-card" aria-hidden="true"><span class="category-card-back"></span><strong>Action</strong></div>
  @foreach(var field in AvailableActionFields)
  {
   <button class="drawer-front deck-available-card" draggable="true" style="@FieldStyle(field)" @onclick="()=>Session.ShowFieldHand(field)" @ondragend="()=>Session.ShowFieldHand(field)" aria-label="Add @field.Name to hand">
    @if(!string.IsNullOrWhiteSpace(field.ImageDataUrl)){<img src="@field.ImageDataUrl" alt="" />}
    else{<span class="drawer-glyph">@FieldGlyph(field)</span>}
    <strong>@field.Name</strong>
   </button>
  }
  @foreach(var card in ActionCards)
  {
   <button class="drawer-front" style="@CardStyle(card)" @onclick="()=>Session.RollHandCardAsync(card)" aria-label="@card.Name action card">
    @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
    else{<span class="drawer-glyph">@Glyph(card)</span>}
    <strong>@card.Name</strong>
   </button>
  }
 </div>
 <div class="card-drawer-row intel-row" aria-label="Lore handouts and notes">
  <div class="drawer-category-card" aria-hidden="true"><span class="category-card-back"></span><strong>Intel</strong></div>
  @foreach(var field in AvailableIntelFields)
  {
   <button class="drawer-front deck-available-card" draggable="true" style="@FieldStyle(field)" @onclick="()=>Session.ShowFieldHand(field)" @ondragend="()=>Session.ShowFieldHand(field)" aria-label="Add @field.Name to hand">
    @if(!string.IsNullOrWhiteSpace(field.ImageDataUrl)){<img src="@field.ImageDataUrl" alt="" />}
    else{<span class="drawer-glyph">@FieldGlyph(field)</span>}
    <strong>@field.Name</strong>
   </button>
  }
  @foreach(var card in IntelCards)
  {
   <button class="drawer-front" style="@CardStyle(card)" aria-label="@card.Name intel card">
    @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
    else{<span class="drawer-glyph">@Glyph(card)</span>}
    <strong>@card.Name</strong>
   </button>
  }
 </div>
 <div class="card-drawer-row standard-row" aria-label="Standard card game controls">
  <div class="drawer-category-card" aria-hidden="true"><span class="category-card-back"></span><strong>Standard</strong></div>
  <div class="standard-game-controls">
   <div class="standard-counts" aria-label="Card counts by type">
    @foreach(var type in Session.StandardCardTypes)
    {
     <label><span>@type</span><input type="number" min="0" max="120" value="@Session.StandardTypeCount(type)" @onchange="e=>SetStandardCount(type,e)" /></label>
    }
   </div>
   <label class="draw-only-setting"><input type="checkbox" checked="@Session.StandardDrawOnly" @onchange="e=>Session.SetStandardDrawOnly(e.Value is bool value&&value)" /><span>Draw only</span></label>
   <button class="standard-save-icon" @onclick="SaveStandardDeck" aria-label="Save standard deck" title="Save standard deck"><span class="header-icon icon-save" aria-hidden="true"></span></button>
   <label class="standard-load standard-load-icon" aria-label="Load standard deck" title="Load standard deck"><span class="header-icon icon-load" aria-hidden="true"></span><InputFile OnChange="LoadStandardDeck" accept=".ristdeck,.json,application/json" /></label>
   <button class="standard-drawer-exit" @onclick="Session.CloseHand" aria-label="Close card sliders" title="Close card sliders"><span class="header-icon icon-exit" aria-hidden="true"></span></button>
  </div>
 </div>
</section>
}
@code{
 void SetStandardCount(string type,ChangeEventArgs e)=>Session.SetStandardTypeCount(type,int.TryParse(e.Value?.ToString(),out var count)?count:0);
 async Task SaveStandardDeck()=>await JS.InvokeVoidAsync("ristWorld.downloadText","standard-deck.ristdeck",Session.SaveStandardDeckJson(),"application/json");
 async Task LoadStandardDeck(InputFileChangeEventArgs e)
 {
  using var stream=e.File.OpenReadStream(5*1024*1024);
  using var reader=new StreamReader(stream);
  Session.LoadStandardDeckJson(await reader.ReadToEndAsync());
 }
 async Task HandCardClick(HandCard card)
 {
  if(Session.Role=="GM"&&card.ApprovalStatus==HandCard.Pending){Session.ApproveHandCard(card);return;}
  await Session.RollHandCardAsync(card);
 }
 IEnumerable<CharacterField> AvailableFields=>Session.CharacterFields.Where(x=>!Session.IsFieldInHand(x));
 IEnumerable<CharacterField> AvailableActionFields=>AvailableFields.Where(x=>x.DiceBag.Count>0||x.Group is "Skills" or "Feats" or "Flare");
 IEnumerable<CharacterField> AvailableIntelFields=>AvailableFields.Except(AvailableActionFields);
 IEnumerable<HandCard> ActionCards=>Session.HandCards.Where(x=>x.DiceBag.Count>0||x.Field.Group is "Skills" or "Feats");
 IEnumerable<HandCard> IntelCards=>Session.HandCards.Except(ActionCards);
 string FieldStyle(CharacterField field)=>$"--field-accent:{AccentHex(field.Color)}";
 static string FieldGlyph(CharacterField field)=>WorldSession.IsTrackerField(field)?"◉":WorldSession.IsFlareField(field)?"✦":"•";
 string CardStyle(HandCard card)=>$"--field-accent:{AccentHex(card.Field.Color)}";
 static string Glyph(HandCard card)=>WorldSession.IsTrackerField(card.Field)?"◉":WorldSession.IsFlareField(card.Field)?"✦":"•";
 static string AccentHex(string c)=>c switch{"red"=>"#c7493a","orange"=>"#e9852c","gold"=>"#d9a82f","green"=>"#58a765","teal"=>"#41aaa4","blue"=>"#4c82d5","purple"=>"#9653c9",_=>"#d9a82f"};
}