@inject WorldSession Session
@if(Session.HandOpen)
{
<section class="card-triple-drawer" aria-label="Character and card drawer">
 <div class="card-drawer-row character-row" aria-label="Characters and companions">
  <button class="drawer-category-card" @onclick="Session.OpenMixer"><span class="category-card-back"></span><strong>Character</strong></button>
  <button class="drawer-front character-front" @onclick="Session.OpenMixer" aria-label="Open active character">
   @if(!string.IsNullOrWhiteSpace(Session.CharacterPortraitDataUrl)){<img src="@Session.CharacterPortraitDataUrl" alt="" />}
   else{<span class="drawer-glyph">CHAR</span>}
   <strong>@(string.IsNullOrWhiteSpace(Session.CharacterName)?"Character":Session.CharacterName)</strong>
  </button>
 </div>
 <div class="card-drawer-row action-row" aria-label="Action cards">
  <div class="drawer-category-card" aria-hidden="true"><span class="category-card-back"></span><strong>Action</strong></div>
  @foreach(var card in ActionCards)
  {
   <button class="drawer-front" style="@CardStyle(card)" @onclick="()=>Session.RollHandCardAsync(card)" aria-label="@card.Name action card">
    @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
    else{<span class="drawer-glyph">@Glyph(card)</span>}
    <strong>@card.Name</strong>
   </button>
  }
 </div>
 <div class="card-drawer-row intel-row" aria-label="Lore handouts and notes">
  <div class="drawer-category-card" aria-hidden="true"><span class="category-card-back"></span><strong>Intel</strong></div>
  @foreach(var card in IntelCards)
  {
   <button class="drawer-front" style="@CardStyle(card)" aria-label="@card.Name intel card">
    @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="" />}
    else{<span class="drawer-glyph">@Glyph(card)</span>}
    <strong>@card.Name</strong>
   </button>
  }
 </div>
</section>
}
@code{
 IEnumerable<HandCard> ActionCards=>Session.HandCards.Where(x=>x.DiceBag.Count>0||x.Field.Group is "Skills" or "Feats");
 IEnumerable<HandCard> IntelCards=>Session.HandCards.Except(ActionCards);
 string CardStyle(HandCard card)=>$"--field-accent:{AccentHex(card.Field.Color)}";
 static string Glyph(HandCard card)=>WorldSession.IsTrackerField(card.Field)?"◉":WorldSession.IsFlareField(card.Field)?"✦":"•";
 static string AccentHex(string c)=>c switch{"red"=>"#c7493a","orange"=>"#e9852c","gold"=>"#d9a82f","green"=>"#58a765","teal"=>"#41aaa4","blue"=>"#4c82d5","purple"=>"#9653c9",_=>"#d9a82f"};
}
