@inject WorldSession Session
<section class="hand-rail tabletop-dial-rail finite-rail" aria-label="Player hand">
 <div class="finite-set hand-card-set">
  @if(Session.HandCards.Count==0)
  {
   <div class="hand-rail-empty" aria-live="polite">HAND • Show a skill or feat to place its card here.</div>
  }
  else
  {
   @foreach(var card in Session.HandCards)
   {
    <article class="map-hand-card color-@card.Field.Color" style="@CardWidth(card.Name)">
     <div class="map-card-name">@card.Name</div>
     <div class="map-card-body">
      <div class="map-card-image">
       @if(!string.IsNullOrWhiteSpace(card.Field.ImageDataUrl)){<img src="@card.Field.ImageDataUrl" alt="@card.Name"/>}
       else{<span>+</span>}
      </div>
      @if(CardDescriptionVisible(card) && !string.IsNullOrWhiteSpace(card.Field.Description))
      {<div class="map-card-description">@card.Field.Description</div>}
     </div>
     <div class="map-card-footer">
      <button class="dicebag-button map-card-bag" title="@(Session.MixerOpen?"Open dice bag":"Roll dice bag")" aria-label="@card.Name dice bag" @onclick="()=>BagClick(card)">
       <img src="assets/ui/custom_dicebag.png" alt="Dice bag"/><span class="bag-count">@card.DiceBag.Sum(x=>x.Count)</span>
      </button>
      <strong class="map-card-value">@card.Value</strong>
     </div>
     <div class="hand-card-tools">
      <button title="Move left" @onclick="()=>Session.MoveHandCard(card,-1)">◀</button>
      <button title="Move right" @onclick="()=>Session.MoveHandCard(card,1)">▶</button>
      <button title="Remove from hand" @onclick="()=>Session.HideHand(card)">×</button>
     </div>
    </article>
   }
  }
 </div>
</section>
@code{
 string CardWidth(string name)=>$"--hand-card-width:{Math.Clamp(190+(name?.Length??0)*7,220,390)}px";
 bool CardDescriptionVisible(HandCard card)=>card.Field.DescriptionEnabled&&(card.Field.Group=="Skills"?Session.ShowSkillDescriptions:Session.ShowFeatDescriptions);
 async Task BagClick(HandCard card){if(Session.MixerOpen)Session.EditFieldDiceBag(card.Field);else await Session.RollHandCardAsync(card);}
}
