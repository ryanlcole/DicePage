 .rune-viewer{min-width:0;min-height:0;overflow:hidden}.rune-viewer-canvas{position:relative;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden;container-type:size;touch-action:none;--viewer-frame:24px;background:#03090d}.rune-viewer-canvas>.table-workspace,.rune-viewer-canvas>.map-shell{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;max-width:none!important;max-height:none!important;overflow:hidden!important}.rune-viewer-canvas .table-workspace>.staging-tray,.rune-viewer-canvas .table-workspace>.tile-browser,.rune-viewer-canvas .table-workspace>.card-browser{display:none!important}.rune-viewer-canvas .map{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;max-width:none!important;max-height:none!important;aspect-ratio:auto!important;transform:none!important;margin:0!important}.rune-viewer-canvas .world-stage{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;aspect-ratio:auto!important;transform:none!important}.rune-viewer-canvas .world-stage>.grid{display:none!important;background:none!important}.rune-viewer-canvas .base.ocean-world{background-size:calc((100cqw - (2 * var(--viewer-frame))) / 30) calc((100cqw - (2 * var(--viewer-frame))) / 30)!important;background-repeat:repeat!important;background-position:var(--viewer-frame) var(--viewer-frame)!important}.rune-viewer-canvas .status,.rune-viewer-canvas .coordinate-system,.rune-viewer-canvas .grid-coordinates{display:none!important}.rune-viewer-canvas .rist-coordinate-frame{z-index:35!important;pointer-events:none!important}
