@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<div class="worldbuilder-rune-test" @ref="_rootElement">
 <header class="rune-header" aria-label="World Builder Rune Test header">
  <button type="button" class="rune-home" @onclick="OpenStartMenu" aria-label="Back to Shaelvien start menu">←</button>
  <div class="rune-title"><strong>WORLDBUILDER · RUNE TEST</strong><small>WORLD TRUTH → RUNES → DECODER → BROWSER</small></div>
  <WorldCoordinateNavigator />
 </header>

 <main class="rune-viewer" aria-label="Rune driven World Builder viewer">
  <div class="rune-viewer-canvas">
   @if(!Session.CanEditTiles)
   {
    <div class="rune-edit-mode" role="status"><span>Viewing world</span>@if(Session.IsLoggedIn){<button type="button" @onclick='()=>Session.SetRole("GM")'>Enter build mode</button>}</div>
   }
   <WorldMap />
   <AssetLibrary />
   <div class="rune-viewer-grid @(_viewerGrid?"on":"off")" aria-hidden="true"></div>

   @if(_layerOpen)
   {
    <section class="rune-mini-panel" role="dialog" aria-label="Rune layer controls">
     <button type="button" disabled="@_zLocked" @onclick="()=>ExecuteRuneAsync(RuneOp.Layer,-1)">Layer −</button>
     <span>L @Session.LayerOffset · Z @Session.SceneZ</span>
     <button type="button" disabled="@_zLocked" @onclick="()=>ExecuteRuneAsync(RuneOp.Layer,1)">Layer +</button>
    </section>
   }
   @if(_tierOpen)
   {
    <section class="rune-mini-panel tier-panel" role="dialog" aria-label="Rune tier controls">
     <button type="button" disabled="@_zLocked" @onclick="()=>ExecuteRuneAsync(RuneOp.Tier,-1)">Tier −</button>
     <span>T @Session.TierIndex</span>
     <button type="button" disabled="@_zLocked" @onclick="()=>ExecuteRuneAsync(RuneOp.Tier,1)">Tier +</button>
    </section>
   }
   @if(_publishMode){<div class="rune-publish-banner" role="status">REGION PUBLISH TEST MODE</div>}

   <aside class="rune-diagnostics" aria-label="Rune decoder diagnostics">
    <div class="diag-heading"><strong>RUNE BUS</strong><span class="@(_decoderReady?"ready":"pending")">@(_decoderReady?"DECODER READY":"DECODER…")</span></div>
    <div class="diag-grid">
     <span>Last</span><b>@_lastRune</b>
     <span>Decoded</span><b>@_decodedRunes</b>
     <span>Interop calls</span><b>@_interopCalls</b>
     <span>Decode</span><b>@_decodeMs.ToString("0.000") ms</b>
     <span>Logical packet</span><b>@_logicalBytes B</b>
     <span>Interop JSON</span><b>@_interopJsonBytes B</b>
     <span>Verbose JSON</span><b>@_verboseJsonBytes B</b>
     <span>JSON saved</span><b>@PayloadSavingText</b>
    </div>
    <p data-rune-trace>@_traceText</p>
    @if(_benchmarkRunes>0)
    {
     <div class="diag-bench"><strong>10K decoder loop</strong><span>@_benchmarkMs.ToString("0.00") ms · @BenchmarkRateText runes/ms</span><span>batch JSON @_benchmarkPackedJson B vs @_benchmarkVerboseJson B verbose</span></div>
    }
    <button type="button" class="bench-button" @onclick="RunBenchmarkAsync" disabled="@(!_decoderReady)">BENCH 10K</button>
   </aside>

   @if(_libraryOpen)
   {
    <section class="rune-library" aria-label="Rune asset library">
     <WorldAssetFolderRail AnimatedOnly="false" OnExit="CloseLibraryRuneAsync" OnAssetPin="StageAssetRuneAsync" />
    </section>
   }
  </div>
 </main>

 <section class="rune-keyboard" aria-label="World Builder rune keyboard">
  <button type="button" class="@(_libraryOpen?"active":"")" @onclick="ToggleLibraryRuneAsync"><strong>LIB</strong><small>assets</small></button>
  <button type="button" @onclick="CycleFootprintRuneAsync"><strong>@_tileFootprint²</strong><small>tile</small></button>
  <button type="button" class="@(_zLocked?"active":"")" @onclick="ToggleZLockRuneAsync"><strong>Z</strong><small>@(_zLocked?"locked":"free")</small></button>
  <button type="button" class="@(_layerOpen?"active":"")" @onclick="ToggleLayerPanelRuneAsync"><strong>L</strong><small>@Session.LayerOffset</small></button>
  <button type="button" class="@(_tierOpen?"active":"")" @onclick="ToggleTierPanelRuneAsync"><strong>T</strong><small>@Session.TierIndex</small></button>
  <button type="button" class="@(_viewerGrid?"active":"")" @onclick="ToggleViewRuneAsync"><strong>#</strong><small>grid</small></button>
  <button type="button" @onclick="()=>ExecuteRuneAsync(RuneOp.Save)"><strong>⌁</strong><small>save</small></button>
  <button type="button" @onclick="()=>ExecuteRuneAsync(RuneOp.LoadLocal)"><strong>↥</strong><small>load</small></button>
  @if(Session.IsLoggedIn){<button type="button" @onclick="()=>ExecuteRuneAsync(RuneOp.LoadPrivate)"><strong>☁</strong><small>private</small></button>}
  <button type="button" class="@(_publishMode?"active":"")" @onclick="TogglePublishRuneAsync"><strong>◎</strong><small>publish</small></button>
 </section>
</div>

<style>
