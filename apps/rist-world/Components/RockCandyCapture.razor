@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth
@inject AssetRatingClient Ratings
@inject IJSRuntime JS

<section class="rock-candy-capture" aria-label="Rock Candy Capture">
 <header>
  <div>
   <p>ROCK CANDY</p>
   <h2>Capture a real miniature as a glass polyhedron.</h2>
  </div>
  <span>@CapturedCount/6 VIEWS</span>
 </header>

 <div class="rock-candy-intro">
  <p>Photograph the same miniature from six directions. Rock Candy removes only the chosen background color that is connected to the outside edge, then packs the cleaned perspectives onto the inner faces of a transparent d6 shell.</p>
  <small>The original photos stay on this device in this version. Only the finished transparent Rock Candy atlas is uploaded.</small>
 </div>

 <div class="rock-candy-settings">
  <label><span>NAME</span><input maxlength="64" placeholder="My miniature" @bind="_name" @bind:event="oninput" /></label>
  <label><span>OUTSIDE COLOR</span><input class="rock-candy-color" type="color" @bind="_keyColor" /></label>
  <label><span>COLOR TOLERANCE</span><input type="range" min="0" max="100" step="1" @bind="_tolerance" /><output>@_tolerance%</output></label>
 </div>

 <div class="rock-candy-faces" aria-label="Six capture directions">
  @foreach(var face in FaceOrder)
  {
   <article class="rock-candy-face-card @(_faces.ContainsKey(face.Key)?"captured":"")">
    <div class="rock-candy-face-preview">
     @if(_faces.TryGetValue(face.Key,out var image))
     {
      <img src="@image" alt="@face.Label captured view" />
     }
     else
     {
      <strong>@face.Glyph</strong>
     }
    </div>
    <div><strong>@face.Label</strong><small>@face.Help</small></div>
    @if(face.Key=="front") { <InputFile OnChange="LoadFront" accept="image/*" capture="environment" disabled="@_working" /> }
    else if(face.Key=="right") { <InputFile OnChange="LoadRight" accept="image/*" capture="environment" disabled="@_working" /> }
    else if(face.Key=="back") { <InputFile OnChange="LoadBack" accept="image/*" capture="environment" disabled="@_working" /> }
    else if(face.Key=="left") { <InputFile OnChange="LoadLeft" accept="image/*" capture="environment" disabled="@_working" /> }
    else if(face.Key=="top") { <InputFile OnChange="LoadTop" accept="image/*" capture="environment" disabled="@_working" /> }
    else { <InputFile OnChange="LoadBottom" accept="image/*" capture="environment" disabled="@_working" /> }
   </article>
  }
 </div>

 @if(AllFacesCaptured)
 {
  <div class="rock-candy-live-preview" aria-label="Rock Candy preview">
   <strong>GLASS SHELL PREVIEW</strong>
   <div class="rock-candy-preview-stage">
    <div class="rock-candy-preview-cube">
     @foreach(var face in FaceOrder)
     {
      <span class="rc-preview-face rc-@face.Key" style="@PreviewFaceStyle(face.Key)"></span>
     }
    </div>
   </div>
  </div>
 }

 <fieldset class="rock-candy-rating">
  <legend>CONTENT RATING</legend>
  <p>The finished Rock Candy asset uses the same provider rating boundary as every uploaded asset.</p>
  <label class="rock-candy-rating-choice general"><input type="checkbox" checked="@_providerGeneral" @onchange="e=>SetProviderGeneral(e.Value as bool?==true)" /><span><strong>General / none of these</strong><small>No mature-content descriptor applies.</small></span></label>
  <div class="rock-candy-rating-grid">
   @foreach(var descriptor in ContentAllowancePolicy.Descriptors)
   {
    <label class="rock-candy-rating-choice"><input type="checkbox" checked="@_providerDescriptors.Contains(descriptor.Id)" @onchange="e=>ToggleProviderDescriptor(descriptor.Id,e.Value as bool?==true)" /><span><strong>@descriptor.Label</strong><small>@descriptor.Reason</small></span></label>
   }
  </div>
 </fieldset>

 <div class="rock-candy-actions">
  <button type="button" class="primary" disabled="@(!CanSave)" @onclick="SaveRockCandyAsync">@(_working?"MAKING ROCK CANDY…":"SAVE ROCK CANDY")</button>
  <button type="button" disabled="@(_working||CapturedCount==0)" @onclick="Reset">CLEAR CAPTURE</button>
 </div>
 @if(!Session.IsLoggedIn)
 {
  <p class="rock-candy-status">Log in to save Rock Candy to your private Miniatures library.</p>
 }
 @if(!string.IsNullOrWhiteSpace(_status))
 {
  <p class="rock-candy-status" role="status">@_status</p>
 }
</section>

<style>
