@code {
 [Parameter] public EventCallback OnHome { get; set; }
 [Parameter] public EventCallback OnStartMenu { get; set; }

 static readonly HashSet<string> AllowedExtensions=new(StringComparer.OrdinalIgnoreCase)
 {
  ".txt",".md",".json",".csv",".cs",".razor",".py",".js",".ts",".html",".css",".sql",".xml",".yaml",".yml"
 };

 string _query="";
 string _evidenceFilter="all";
 string _pasteTitle="";
 string _pasteText="";
 string _importStatus="";
 string _copyStatus="";
 bool _importBusy;
 ObserverAnswer? _answer;

 protected override async Task OnInitializedAsync()
 {
  Observer.Changed+=ObserverChanged;
  await Observer.InitializeAsync();
 }

 void ObserverChanged()=>_ = InvokeAsync(StateHasChanged);

 Task RunQueryAsync()
 {
  _copyStatus="";
  _answer=Observer.Query(_query,evidenceFilter:_evidenceFilter);
  return Task.CompletedTask;
 }

 void EvidenceFilterChanged(ChangeEventArgs args)
 {
  _evidenceFilter=(args.Value?.ToString()??"all").Trim().ToLowerInvariant();
  Observer.ClearConversationContext();
  _answer=null;
  _copyStatus="Evidence scope changed; follow-up context cleared.";
 }

 void ClearContext()
 {
  Observer.ClearConversationContext();
  _copyStatus="Follow-up context cleared.";
 }

 async Task CopyEvidencePacketAsync()
 {
  if(_answer is null||_answer.Hits.Count==0)return;
  try
  {
   await JS.InvokeVoidAsync("navigator.clipboard.writeText",Observer.BuildEvidencePacket(_answer));
   _copyStatus="Evidence packet copied.";
  }
  catch
  {
   _copyStatus="Clipboard unavailable in this browser.";
  }
 }

 async Task ImportFilesAsync(InputFileChangeEventArgs args)
 {
  _importBusy=true;
  _importStatus="";
  var imported=0;
  var rejected=new List<string>();
  try
  {
   foreach(var file in args.GetMultipleFiles(12))
   {
    var extension=Path.GetExtension(file.Name);
    if(!AllowedExtensions.Contains(extension))
    {
     rejected.Add($"{file.Name} (unsupported type)");
     continue;
    }
    try
    {
     await using var stream=file.OpenReadStream(2_100_000);
     using var reader=new StreamReader(stream,Encoding.UTF8,detectEncodingFromByteOrderMarks:true);
     var text=await reader.ReadToEndAsync();
     await Observer.ImportPrivateTextAsync(Path.GetFileNameWithoutExtension(file.Name),text,file.Name);
     imported++;
    }
    catch(Exception ex)
    {
     rejected.Add($"{file.Name} ({ex.Message})");
    }
   }
   _importStatus=$"Imported {imported} private source{(imported==1?"":"s")}.";
   if(rejected.Count>0)_importStatus+=" Rejected: "+string.Join("; ",rejected);
  }
  finally
  {
   _importBusy=false;
  }
 }

 async Task ImportPasteAsync()
 {
  if(string.IsNullOrWhiteSpace(_pasteTitle)||string.IsNullOrWhiteSpace(_pasteText))
  {
   _importStatus="Add both a source title and source text.";
   return;
  }
  _importBusy=true;
  try
  {
   await Observer.ImportPrivateTextAsync(_pasteTitle,_pasteText);
   _importStatus=$"Imported privately: {_pasteTitle.Trim()}";
   _pasteTitle="";
   _pasteText="";
  }
  catch(Exception ex)
  {
   _importStatus=ex.Message;
  }
  finally
  {
   _importBusy=false;
  }
 }

 async Task RemovePrivateAsync(string id)
 {
  _importBusy=true;
  try{await Observer.RemovePrivateDocumentAsync(id);}
  catch(Exception ex){_importStatus=ex.Message;}
  finally{_importBusy=false;}
 }

 static string? SafeUri(string? value)
 {
  if(string.IsNullOrWhiteSpace(value))return null;
  if(!Uri.TryCreate(value,UriKind.Absolute,out var uri))return null;
  return uri.Scheme is "https" or "http"?uri.ToString():null;
 }

 public void Dispose()=>Observer.Changed-=ObserverChanged;
}
