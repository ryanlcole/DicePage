@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@implements IDisposable
@inject ReLiCObserverService Observer
@inject IJSRuntime JS

<div class="observer-shell">
 <header class="observer-header">
  <div class="observer-nav">
   <button type="button" @onclick="OnHome" aria-label="Home">⌂ HOME</button>
   <button type="button" @onclick="OnStartMenu" aria-label="Open Start Menu">☰ MENU</button>
  </div>
  <div class="observer-title">
   <p>ReLiC · OBSERVER</p>
   <h1>Project Intelligence</h1>
   <span>Source-grounded retrieval without a required paid model.</span>
  </div>
  <div class="observer-state" aria-live="polite">
   <strong>@(Observer.Loaded?"READY":"LOADING")</strong>
   <span>@Observer.Status</span>
  </div>
 </header>

 <main class="observer-main">
  <section class="observer-query-panel" aria-labelledby="observer-query-heading">
   <div class="observer-section-head">
    <div>
     <p class="observer-eyebrow">QUERY</p>
     <h2 id="observer-query-heading">Ask the work, not a blank model</h2>
    </div>
    <div class="observer-ledger" aria-label="Loaded evidence">
     <span><strong>@Observer.PublicSourceCount</strong> public sources</span>
     <span><strong>@Observer.PublicRecordCount</strong> project records</span>
     <span><strong>@Observer.RepositoryOverlayRecordCount</strong> live repo overlays</span>
     <span><strong>@Observer.PrivateDocuments.Count</strong> private imports</span>
     <span><strong>@Observer.IndexedEvidenceCount</strong> indexed units</span>
     <span><strong>@Observer.AssociationEdgeCount</strong> sparse associations</span>
    </div>
   </div>

   <form class="observer-query-form" @onsubmit="RunQueryAsync" @onsubmit:preventDefault="true">
    <div class="observer-query-options">
     <label for="observer-filter">Evidence scope
      <select id="observer-filter" value="@_evidenceFilter" @onchange="EvidenceFilterChanged">
       <option value="all">All loaded evidence</option>
       <option value="current">Current / non-historical</option>
       <option value="historical">Historical only</option>
       <option value="public">Public only</option>
       <option value="private">Private only</option>
      </select>
     </label>
    </div>
    <label for="observer-query">Question or search</label>
    <div class="observer-query-row">
     <input id="observer-query" type="search" @bind="_query" placeholder="Example: What is authoritative about SHAEP provenance?" autocomplete="off" disabled="@(!Observer.Loaded)" />
     <button type="submit" disabled="@(!Observer.Loaded||string.IsNullOrWhiteSpace(_query))">QUERY</button>
    </div>
   </form>

   @if(Observer.ConversationContextAvailable)
   {
    <div class="observer-context-bar">
     <span><strong>@Observer.ConversationTurnCount</strong> bounded conversation turn@(Observer.ConversationTurnCount==1?"":"s") retained for explicit follow-ups.</span>
     <button type="button" @onclick="ClearContext">CLEAR CONTEXT</button>
    </div>
   }

   <div class="observer-principle">
    <strong>Observer rule</strong>
    <span>Evidence is not permission. Retrieval does not promote UNKNOWN, HYPOTHESIS, or FICTION into FACT, and this engine does not repurpose Rune, Glyph, CHID, or SHAEP identities.</span>
   </div>
  </section>

  @if(_answer is not null)
  {
   <section class="observer-answer" aria-labelledby="observer-answer-heading" aria-live="polite">
    <div class="observer-answer-head">
     <div>
      <p class="observer-eyebrow">RESPONSE · @_answer.Intent</p>
      <h2 id="observer-answer-heading">@_answer.TruthSummary</h2>
      @if(_answer.ExplicitConflict){<span class="observer-conflict">UNRESOLVED SOURCE CONFLICT PRESENT</span>}
     </div>
     <div class="observer-trace" aria-label="Query trace">
      <span>RETRIEVE</span><b>→</b><span>RANK</span><b>→</b><span>ASSOCIATE</span><b>→</b><span>BOUND EVIDENCE</span><b>→</b><span>OBSERVE</span>
     </div>
    </div>
    <div class="observer-answer-text">@_answer.Answer</div>
    @if(!string.IsNullOrWhiteSpace(_answer.RetrievalTrace))
    {
     <p class="observer-retrieval-summary">@_answer.RetrievalTrace · @_answer.AssociationEdgeCount sparse graph edges available</p>
    }
    <div class="observer-answer-actions">
     <button type="button" @onclick="CopyEvidencePacketAsync" disabled="@(_answer.Hits.Count==0)">COPY EVIDENCE PACKET</button>
     @if(!string.IsNullOrWhiteSpace(_copyStatus)){<span role="status">@_copyStatus</span>}
    </div>

    @if(_answer.Hits.Count>0)
    {
     <details class="observer-evidence" open>
      <summary>Evidence trace · @_answer.Hits.Count ranked records</summary>
      <div class="observer-hit-list">
       @foreach(var hit in _answer.Hits)
       {
        <article class="observer-hit">
         <div class="observer-hit-head">
          <div class="observer-hit-badges">
           <span class="observer-truth" data-domain="@hit.TruthDomain">@hit.TruthDomain</span>
           <span class="observer-path" data-kind="@hit.RetrievalKind">@hit.RetrievalKind</span>
          </div>
          <span class="observer-score">score @hit.Score.ToString("0.000")</span>
         </div>
         <h3>@hit.Title</h3>
         <p class="observer-retrieval-path">@hit.RetrievalPath · @hit.RetrievalReason</p>
         <p class="observer-hit-meta">@hit.Category · @hit.Status · @hit.Scope</p>
         <p class="observer-excerpt">@hit.Excerpt</p>
         <div class="observer-source-row">
          @foreach(var source in hit.Sources)
          {
           var safe=SafeUri(source.Uri);
           if(safe is not null)
           {
            <a href="@safe" target="_blank" rel="noopener noreferrer">@source.Title</a>
           }
           else
           {
            <span>@source.Title</span>
           }
          }
         </div>
         <p class="observer-provenance">@hit.Provenance</p>
        </article>
       }
      </div>
     </details>
    }
   </section>
  }

  <section class="observer-import" aria-labelledby="observer-import-heading">
   <div class="observer-section-head">
    <div>
     <p class="observer-eyebrow">PRIVATE MEMORY</p>
     <h2 id="observer-import-heading">Add material without publishing it</h2>
    </div>
    <span class="observer-private-badge">AUTHENTICATED ACCOUNT STORAGE</span>
   </div>
   <p class="observer-copy">Imported text is stored through the existing private account-storage path. It is never copied into the public project seed. Code is indexed as text and is never executed. A Shaelvien Project Knowledge JSON export is recognized and its record truth domains and source links are preserved.</p>

   <div class="observer-import-grid">
    <div class="observer-file-import">
     <label>Import text/code/project corpus</label>
     <InputFile OnChange="ImportFilesAsync" multiple accept=".txt,.md,.json,.csv,.cs,.razor,.py,.js,.ts,.html,.css,.sql,.xml,.yaml,.yml,text/plain,application/json" />
     <small>Up to 12 files per selection · 2 MB each · private corpus capped at 5 million characters.</small>
    </div>

    <form class="observer-paste" @onsubmit="ImportPasteAsync" @onsubmit:preventDefault="true">
     <label for="observer-source-title">Source title</label>
     <input id="observer-source-title" @bind="_pasteTitle" placeholder="Example: Design notebook September 2026" />
     <label for="observer-source-text">Paste source text</label>
     <textarea id="observer-source-text" @bind="_pasteText" rows="6" placeholder="Paste notes, requirements, lore, code, or another text source…"></textarea>
     <button type="submit" disabled="@_importBusy">ADD PRIVATE SOURCE</button>
    </form>
   </div>

   @if(!string.IsNullOrWhiteSpace(_importStatus))
   {
    <p class="observer-import-status" role="status">@_importStatus</p>
   }

   @if(Observer.PrivateDocuments.Count>0)
   {
    <div class="observer-private-list" aria-label="Private imported sources">
     @foreach(var document in Observer.PrivateDocuments.OrderByDescending(x=>x.ImportedAtUtc))
     {
      <div class="observer-private-item">
       <div>
        <strong>@document.Title</strong>
        <span>@document.Content.Length.ToString("N0") chars · @document.ImportedAtUtc.ToLocalTime().ToString("g")</span>
        <small>Source origin @document.SourceOrigin · handling @document.ProvenanceHandling</small>
       </div>
       <button type="button" @onclick="()=>RemovePrivateAsync(document.Id)" disabled="@_importBusy" aria-label="@($"Remove {document.Title} from ReLiC Observer")">REMOVE</button>
      </div>
     }
    </div>
   }
  </section>

  <footer class="observer-footer">
   <span>PUBLIC SEED @(!string.IsNullOrWhiteSpace(Observer.SnapshotDate)?Observer.SnapshotDate:"UNAVAILABLE")</span>
   <span>PRIVATE DATA STAYS OUT OF THE PUBLIC REPOSITORY</span>
   <span>REPRESENTATION ≠ TRUTH</span>
  </footer>
 </main>
</div>

