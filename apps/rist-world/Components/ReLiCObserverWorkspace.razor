erver-source-row{display:flex;gap:5px;flex-wrap:wrap}.observer-source-row a,.observer-source-row span{max-width:100%;overflow:hidden;text-overflow:ellipsis;padding:3px 5px;border-radius:4px;background:#0d222b;color:#9fd3e0;font-size:7px;white-space:nowrap}.observer-provenance{margin-top:7px}
