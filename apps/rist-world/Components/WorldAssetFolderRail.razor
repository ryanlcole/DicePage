@inject WorldSession Session
@inject IJSRuntime JS

<div class="world-asset-rail-shell">
 <button type="button" class="rail-scroll rail-scroll-prev" onclick="ristWorld.scrollRail('#worldbuilder-asset-rail',-1)" aria-label="Scroll library backward">‹</button>
<nav id="worldbuilder-asset-rail" class="world-asset-rail" aria-label="@(AnimatedOnly ? "Sprite Library terrain browser" : "World building Library")">
 <button type="button" class="rail-back" @onclick="Back" aria-label="Back one level">‹</button>
 <button type="button" class="rail-location library-root" @onclick="GoLibraryRoot" title="@(AnimatedOnly ? "Sprite Library root" : "Library root")" aria-label="@(AnimatedOnly ? "Return to Sprite Library" : "Return to Library")">
  <small>@(AnimatedOnly ? "Animated Assets" : "Asset")</small><strong>@(AnimatedOnly ? "Sprite Library" : "Library")</strong>
 </button>

 @if(_family is not null)
 {
  <button type="button" class="rail-location" @onclick="OpenFamilyRoot" title="Current library family"><small>Library</small><strong>@_family</strong></button>
 }
 @if(_kind is not null)
 {
  <button type="button" class="rail-location" @onclick="OpenKindRoot" title="Current terrain type"><small>Terrain Type</small><strong>@_kind</strong></button>
 }
 @if(_spriteStyle is not null)
 {
  <button type="button" class="rail-location" @onclick="OpenSpriteStyleRoot" title="Current sprite type"><small>Sprite Type</small><strong>@_spriteStyle</strong></button>
 }
 @if(_scale is not null)
 {
  <button type="button" class="rail-location" @onclick="OpenScaleRoot" title="Current map scale"><small>Scale</small><strong>@_scale</strong></button>
 }
 @if(_category is not null)
 {
  <button type="button" class="rail-location" @onclick="OpenCategoryRoot" title="Current category"><small>Folder</small><strong>@_category</strong></button>
 }
 @if(_subcategory is not null)
 {
  <button type="button" class="rail-location" title="Current subfolder"><small>Subfolder</small><strong>@_subcategory</strong></button>
 }

 @if(_family is null)
 {
  <button type="button" class="folder-card" @onclick="()=>OpenFamily(TerrainsFamily)" aria-label="Open Terrains"><span>▰</span><strong>Terrains</strong><small>Library</small></button>
 }
 else if(_kind is null)
 {
  <button type="button" class="folder-card" @onclick="()=>OpenKind(StandardKind)" aria-label="Open Standard terrains"><span>▰</span><strong>Standard</strong><small>Normal Tilesets</small></button>
  <button type="button" class="folder-card" @onclick="()=>OpenKind(SpritesKind)" aria-label="Open Sprite terrains"><span>▰</span><strong>Sprites</strong><small>Animated Tilesets</small></button>
 }
 else if(IsSprites && _spriteStyle is null)
 {
  <button type="button" class="folder-card" @onclick="()=>OpenSpriteStyle(NormalSpriteStyle)" aria-label="Open normal sprites"><span>▰</span><strong>Normal</strong><small>Sprites</small></button>
  <button type="button" class="folder-card" @onclick="()=>OpenSpriteStyle(ParallaxSpriteStyle)" aria-label="Open parallax sprites"><span>▰</span><strong>Parallax</strong><small>Sprites</small></button>
 }
 else if(_scale is null)
 {
  @foreach(var scale in AvailableScales)
  {
   <button type="button" class="folder-card" @onclick="()=>OpenScale(scale)" aria-label="Open @scale terrain assets"><span>▰</span><strong>@scale</strong><small>Scale</small></button>
  }
 }
 else if(_category is null)
 {
  @foreach(var category in Categories)
  {
   <button type="button" class="folder-card" @onclick="()=>OpenCategory(category)" aria-label="Open @category folder"><span>▰</span><strong>@category</strong><small>Folder</small></button>
  }
  @if(Categories.Count==0)
  {
   <span class="rail-empty">No @_scale terrain folders are currently registered.</span>
  }
 }
 else if(_subcategory is null && Subcategories.Count>0)
 {
  @foreach(var subcategory in Subcategories)
  {
   <button type="button" class="folder-card" @onclick="()=>OpenSubcategory(subcategory)" aria-label="Open @subcategory subfolder"><span>▰</span><strong>@subcategory</strong><small>Subfolder</small></button>
  }
  @foreach(var tile in DirectTiles)
  {
   <button type="button" class="asset-card @(_preview?.Id==tile.Id?"previewing":"")" draggable="true"
           @ondragstart="()=>BeginDrag(tile)" @ondragend="EndDrag" @onclick="()=>TogglePreview(tile)" title="Tap to preview @tile.Name">
    <img src="@tile.Image" alt="" loading="lazy" draggable="false" /><strong>@tile.Name</strong>
   </button>
  }
 }
 else
 {
  @foreach(var tile in Tiles)
  {
   <button type="button" class="asset-card @(_preview?.Id==tile.Id?"previewing":"")" draggable="true"
           @ondragstart="()=>BeginDrag(tile)" @ondragend="EndDrag" @onclick="()=>TogglePreview(tile)" title="Tap to preview @tile.Name">
    <img src="@tile.Image" alt="" loading="lazy" draggable="false" /><strong>@tile.Name</strong>
   </button>
  }
  @if(Tiles.Count==0)
  {
   <span class="rail-empty">This folder is part of the canonical library structure but has no registered assets yet.</span>
  }
 }
</nav>
 <button type="button" class="rail-scroll rail-scroll-next" onclick="ristWorld.scrollRail('#worldbuilder-asset-rail',1)" aria-label="Scroll library forward">›</button>
</div>

@if(_preview is not null)
{
 <dialog @ref="_previewDialog" class="asset-preview-stage" aria-label="Preview @_preview.Name" @onclick="ClosePreview">
  <button type="button" class="asset-preview-close" @onclick="ClosePreview" @onclick:stopPropagation="true" aria-label="Close asset preview">×</button>
  <button type="button" class="asset-preview-card" @onclick="PinPreview" @onclick:stopPropagation="true" aria-label="Add @_preview.Name to top quick slider">
   <img src="@_preview.Image" alt="@_preview.Name" draggable="false" />
   <span><strong>@_preview.Name</strong><small>Tap image to add to top slider</small></span>
  </button>
 </dialog>
}

<style>
 .world-asset-rail-shell{box-sizing:border-box;width:100%;height:100%;display:grid;grid-template-columns:44px minmax(0,1fr) 44px;align-items:stretch;background:#0a1117}.world-asset-rail-shell>.rail-scroll{box-sizing:border-box;width:44px;height:100%;min-height:44px;padding:0;border:0;border-inline:1px solid #5c4c2c;background:#101a21;color:#efd78f;font:900 28px/1 system-ui;touch-action:manipulation}.world-asset-rail-shell>.rail-scroll:focus-visible{outline:2px solid #efd78f;outline-offset:-3px}.world-asset-rail{box-sizing:border-box;width:100%;height:100%;display:flex;align-items:center;gap:7px;padding:6px;overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;scrollbar-color:#715b2d #071015;scroll-behavior:smooth;background:#0a1117}.world-asset-rail button{box-sizing:border-box;flex:0 0 auto;height:50px;min-width:98px;border:1px solid #6f5a2f;border-radius:9px;background:#0d171e;color:#e1ca87;font:800 10px/1 system-ui;touch-action:manipulation;overflow:hidden}.world-asset-rail .rail-back{min-width:50px;width:50px;font-size:28px}.world-asset-rail .folder-card{display:grid;grid-template-columns:auto auto;grid-template-rows:1fr auto;align-items:center;justify-content:center;column-gap:7px;padding:4px 10px}.world-asset-rail .folder-card span{grid-row:1/3;font-size:14px}.world-asset-rail .folder-card strong{white-space:nowrap}.world-asset-rail .folder-card small,.world-asset-rail .rail-location small{color:#8fb4cb;font:700 8px/1 system-ui;text-transform:uppercase;letter-spacing:.08em}.world-asset-rail .rail-location{display:grid;place-items:center;gap:2px;min-width:90px;padding:4px 9px;border-color:#536b78;background:#101a21}.world-asset-rail .rail-location strong{white-space:nowrap;color:#f2dfac}.world-asset-rail .library-root{border-color:#8d6a28;background:#17180f;min-width:114px}.world-asset-rail .library-root strong{color:#f0d58b}.world-asset-rail .asset-card{position:relative;padding:0}.world-asset-rail .asset-card.previewing{border-color:#e2bd63;box-shadow:inset 0 0 0 1px #e2bd63}.world-asset-rail .asset-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.68}.world-asset-rail .asset-card strong{position:relative;z-index:2;display:grid;place-items:end center;width:100%;height:100%;padding:0 5px 5px;background:linear-gradient(transparent,#000c);color:#fff1bd;font-size:9px;text-align:center}.world-asset-rail .rail-empty{flex:0 0 auto;padding:0 10px;color:#a4b3ba;font:700 10px/1.3 system-ui;white-space:nowrap}
 .worldbuilder-studio .studio-command-slider{transform:none!important}
 .asset-preview-stage{margin:0;border:0;width:auto;height:auto;position:fixed;left:0;right:0;top:56px;bottom:72px;z-index:88;display:grid;place-items:center;padding:36px;background:rgba(2,7,11,.68);backdrop-filter:blur(4px)}.asset-preview-close{position:absolute;top:16px;right:16px;z-index:2;width:44px;height:44px;border:1px solid #8b7140;border-radius:50%;background:#111b21;color:#f5dfa0;font:900 26px/1 system-ui}.asset-preview-card{position:relative;display:grid;place-items:center;width:min(72vw,72vh,560px);height:min(72vw,72vh,560px);padding:0;overflow:hidden;border:2px solid #d6b45f;border-radius:14px;background:#071015;box-shadow:0 14px 44px #000c;color:#fff1bd;touch-action:manipulation}.asset-preview-card img{width:100%;height:100%;object-fit:contain;display:block}.asset-preview-card span{position:absolute;left:0;right:0;bottom:0;display:grid;gap:3px;padding:18px 12px 11px;background:linear-gradient(transparent,#000 38%);text-align:center}.asset-preview-card strong{font:900 13px/1 system-ui}.asset-preview-card small{font:800 9px/1 system-ui;color:#d6b45f;text-transform:uppercase;letter-spacing:.06em}
 @@media(max-width:760px){.world-asset-rail-shell{grid-template-columns:40px minmax(0,1fr) 40px}.world-asset-rail-shell>.rail-scroll{width:40px}.world-asset-rail{padding:5px}.world-asset-rail button{height:46px;min-width:86px}.world-asset-rail .rail-back{min-width:46px;width:46px}.world-asset-rail .library-root{min-width:108px}.asset-preview-stage{top:64px;bottom:64px;padding:18px}.asset-preview-close{top:10px;right:10px}.asset-preview-card{width:min(82vw,70vh,440px);height:min(82vw,70vh,440px)}}
</style>

@code{
 const string TerrainsFamily="Terrains";
 const string StandardKind="Standard";
 const string SpritesKind="Sprites";
 const string NormalSpriteStyle="Normal";
 const string ParallaxSpriteStyle="Parallax";

 static readonly string[] ScaleFolders={"World","Regional","Local","Instance"};
 static readonly string[] WorldTerrainFolders={
  "Vent Fields","Canyons","Lakes","Rivers","Cliffs","Volcano","Ice","Snow","Mountains","Hills","Desert","Swamp","Jungle","Forest","Plains","Beach","Coast","Ocean"
 };
 static readonly string[] RegionalFolders={"Water","Travel"};
 static readonly string[] RegionalWaterFolders={
  "Streams and Small Watercourses","Riverbanks and Channel Edges","Fords and Natural Crossings","Rapids and Riffles","Pools and Basins","Springs and Water Sources"
 };
 static readonly string[] RegionalTravelFolders={"Paths and Trails"};

 [Parameter] public bool AnimatedOnly { get; set; }
 [Parameter] public EventCallback OnExit { get; set; }
 [Parameter] public EventCallback<AtlasTile> OnAssetDragStart { get; set; }
 [Parameter] public EventCallback OnAssetDragEnd { get; set; }
 [Parameter] public EventCallback<AtlasTile> OnAssetPin { get; set; }

 string? _family;
 string? _kind;
 string? _spriteStyle;
 string? _scale;
 string? _category;
 string? _subcategory;
 AtlasTile? _preview;
 ElementReference _previewDialog;
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(_preview is null)return;
  await using var module=await JS.InvokeAsync<IJSObjectReference>("import","./worldbuilder-asset-preview.js?v=20260915-1");
  await module.InvokeVoidAsync("open",_previewDialog);
 }
 bool _modeInitialized;
 bool _lastAnimatedOnly;

 bool IsSprites=>Same(_kind,SpritesKind);

 protected override void OnParametersSet()
 {
  if(!_modeInitialized||_lastAnimatedOnly!=AnimatedOnly)
  {
   _modeInitialized=true;
   _lastAnimatedOnly=AnimatedOnly;
   ResetEntry();
  }
 }

 IEnumerable<AtlasTile> ModeTiles=>Session.AtlasTiles.Where(IsModeAsset);
 IEnumerable<AtlasTile> ScaleTiles=>ModeTiles.Where(x=>Same(ScaleOf(x),_scale)).Where(x=>IsSprites||IsTerrainForScale(x,_scale));

 IReadOnlyList<string> AvailableScales=>IsSprites
  ? ScaleFolders.Where(scale=>ModeTiles.Any(x=>Same(ScaleOf(x),scale))).ToArray()
  : ScaleFolders;

 IReadOnlyList<string> Categories
 {
  get
  {
   if(IsSprites)
   {
    return ScaleTiles.Select(DynamicCategory).Where(x=>!string.IsNullOrWhiteSpace(x)).Cast<string>()
     .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x=>x,StringComparer.OrdinalIgnoreCase).ToArray();
   }
   if(Same(_scale,"World"))return WorldTerrainFolders;
   if(Same(_scale,"Regional"))return RegionalFolders;
   if(Same(_scale,"Local")||Same(_scale,"Instance"))
   {
    return ScaleTiles.Select(DynamicCategory).Where(x=>!string.IsNullOrWhiteSpace(x)).Cast<string>()
     .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x=>x,StringComparer.OrdinalIgnoreCase).ToArray();
   }
   return Array.Empty<string>();
  }
 }

 IReadOnlyList<string> Subcategories
 {
  get
  {
   if(!Same(_scale,"Regional"))return Array.Empty<string>();
   if(Same(_category,"Water"))return RegionalWaterFolders;
   if(Same(_category,"Travel"))return RegionalTravelFolders;
   return Array.Empty<string>();
  }
 }

 IReadOnlyList<AtlasTile> DirectTiles=>CurrentCategoryTiles.Where(x=>string.IsNullOrWhiteSpace(RegionalSubcategoryFor(x))).OrderBy(x=>x.Name,StringComparer.OrdinalIgnoreCase).ToArray();
 IReadOnlyList<AtlasTile> Tiles
 {
  get
  {
   var tiles=CurrentCategoryTiles;
   if(_subcategory is not null)tiles=tiles.Where(x=>MatchesLabel(x,_subcategory));
   return tiles.OrderBy(x=>x.Name,StringComparer.OrdinalIgnoreCase).ToArray();
  }
 }

 IEnumerable<AtlasTile> CurrentCategoryTiles=>_category is null?Enumerable.Empty<AtlasTile>():ScaleTiles.Where(x=>MatchesCategory(x,_category));

 bool IsModeAsset(AtlasTile tile)
 {
  if(tile.Id.StartsWith("naeja-map-",StringComparison.OrdinalIgnoreCase))return false;
  if(IsSprites)
  {
   if(!IsCanonicalSprite(tile))return false;
   if(Same(_spriteStyle,ParallaxSpriteStyle))return IsParallaxSprite(tile);
   if(Same(_spriteStyle,NormalSpriteStyle))return !IsParallaxSprite(tile);
   return true;
  }
  if(Same(_kind,StandardKind))return !string.Equals(tile.AssetKind,"sprite",StringComparison.OrdinalIgnoreCase);
  return false;
 }

 static bool IsAnimatedSprite(AtlasTile tile)=>string.Equals(tile.AssetKind,"sprite",StringComparison.OrdinalIgnoreCase)&&tile.FrameCount>1&&tile.FramesPerSecond>0;
 static bool IsCanonicalSprite(AtlasTile tile)
 {
  if(!IsAnimatedSprite(tile))return false;
  var path=NormalizedAssetPath(tile);
  return path.StartsWith("assets/sprites/",StringComparison.OrdinalIgnoreCase)||path.Contains("/assets/sprites/",StringComparison.OrdinalIgnoreCase)||path.StartsWith("/sprites/",StringComparison.OrdinalIgnoreCase)||path.Contains("/sprites/",StringComparison.OrdinalIgnoreCase);
 }
 static bool IsParallaxSprite(AtlasTile tile)
 {
  var path=NormalizedAssetPath(tile);
  return PathSegments(tile).Any(x=>Same(x,"Parallax"))||path.Contains("/parallax/",StringComparison.OrdinalIgnoreCase)||(tile.Name??string.Empty).Contains("Parallax",StringComparison.OrdinalIgnoreCase)||(tile.Folder??string.Empty).Contains("Parallax",StringComparison.OrdinalIgnoreCase);
 }

 static string? ScaleOf(AtlasTile tile)
 {
  return Slug(tile.Layer) switch
  {
   "world"=>"World",
   "region"=>"Regional",
   "regional"=>"Regional",
   "local"=>"Local",
   "instance"=>"Instance",
   _=>null
  };
 }

 static bool IsTerrainForScale(AtlasTile tile,string? scale)
 {
  if(Same(scale,"World"))return WorldTerrainFolders.Any(x=>MatchesLabel(tile,x));
  if(Same(scale,"Regional"))return RegionalFolders.Any(x=>MatchesLabel(tile,x))||RegionalWaterFolders.Any(x=>MatchesLabel(tile,x))||RegionalTravelFolders.Any(x=>MatchesLabel(tile,x));
  if(Same(scale,"Local")||Same(scale,"Instance"))return Same(tile.Directory,"Terrain")||PathSegments(tile).Any(x=>Same(x,"Terrain"));
  return false;
 }

 static string? DynamicCategory(AtlasTile tile)
 {
  var directory=Normalize(tile.Directory,string.Empty);
  var folder=Normalize(tile.Folder,string.Empty);
  if(directory.Length>0&&!Same(directory,"Terrain")&&!Same(directory,"Tiles")&&!Same(directory,"General"))return directory;
  if(folder.Length>0&&!Same(folder,"General"))return folder;
  return null;
 }

 static bool MatchesCategory(AtlasTile tile,string category)
 {
  if(MatchesLabel(tile,category))return true;
  if(Same(category,"Water"))return RegionalWaterFolders.Any(x=>MatchesLabel(tile,x));
  if(Same(category,"Travel"))return RegionalTravelFolders.Any(x=>MatchesLabel(tile,x));
  return false;
 }

 static string? RegionalSubcategoryFor(AtlasTile tile)
 {
  foreach(var folder in RegionalWaterFolders)if(MatchesLabel(tile,folder))return folder;
  foreach(var folder in RegionalTravelFolders)if(MatchesLabel(tile,folder))return folder;
  return null;
 }

 static bool MatchesLabel(AtlasTile tile,string? label)
 {
  if(string.IsNullOrWhiteSpace(label))return false;
  var target=Slug(label);
  if(target.Length==0)return false;
  if(Slug(tile.Directory)==target||Slug(tile.Folder)==target)return true;
  return PathSegments(tile).Any(x=>Slug(x)==target);
 }

 static IReadOnlyList<string> PathSegments(AtlasTile tile)
 {
  var path=NormalizedAssetPath(tile);
  return path.Split('/',StringSplitOptions.RemoveEmptyEntries).Select(Uri.UnescapeDataString).ToArray();
 }

 static string NormalizedAssetPath(AtlasTile tile)
 {
  var image=(tile.Image??string.Empty).Trim();
  if(image.Length==0)return string.Empty;
  var path=image;
  if(Uri.TryCreate(image,UriKind.Absolute,out var uri))path=uri.AbsolutePath;
  var marker=path.IndexOfAny(new[]{'?','#'});if(marker>=0)path=path[..marker];
  return path.Replace('\\','/');
 }

 static string Normalize(string? value,string fallback)=>string.IsNullOrWhiteSpace(value)?fallback:value.Trim();
 static bool Same(string? a,string? b)=>string.Equals(a,b,StringComparison.OrdinalIgnoreCase);
 static string Slug(string? value)=>new((value??string.Empty).Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant).ToArray());

 void ResetEntry()
 {
  _family=AnimatedOnly?TerrainsFamily:null;
  _kind=AnimatedOnly?SpritesKind:null;
  _spriteStyle=null;
  _scale=null;
  _category=null;
  _subcategory=null;
  _preview=null;
 }
 void GoLibraryRoot()=>ResetEntry();
 void OpenFamilyRoot(){_kind=AnimatedOnly?SpritesKind:null;_spriteStyle=null;_scale=null;_category=null;_subcategory=null;_preview=null;}
 void OpenKindRoot(){_spriteStyle=null;_scale=null;_category=null;_subcategory=null;_preview=null;}
 void OpenSpriteStyleRoot(){_scale=null;_category=null;_subcategory=null;_preview=null;}
 void OpenScaleRoot(){_category=null;_subcategory=null;_preview=null;}
 void OpenCategoryRoot(){_subcategory=null;_preview=null;}
 void OpenFamily(string family){_family=family;_kind=null;_spriteStyle=null;_scale=null;_category=null;_subcategory=null;_preview=null;}
 void OpenKind(string kind){_kind=kind;_spriteStyle=null;_scale=null;_category=null;_subcategory=null;_preview=null;}
 void OpenSpriteStyle(string style){_spriteStyle=style;_scale=null;_category=null;_subcategory=null;_preview=null;}
 void OpenScale(string scale){_scale=scale;_category=null;_subcategory=null;_preview=null;}
 void OpenCategory(string category){_category=category;_subcategory=null;_preview=null;}
 void OpenSubcategory(string subcategory){_subcategory=subcategory;_preview=null;}
 void TogglePreview(AtlasTile tile)=>_preview=_preview?.Id==tile.Id?null:tile;
 void ClosePreview()=>_preview=null;
 async Task PinPreview(){if(_preview is null)return;var tile=_preview;_preview=null;await OnAssetPin.InvokeAsync(tile);}
 async Task Back()
 {
  if(_preview is not null){_preview=null;return;}
  if(_subcategory is not null){_subcategory=null;return;}
  if(_category is not null){_category=null;return;}
  if(_scale is not null){_scale=null;return;}
  if(_spriteStyle is not null){_spriteStyle=null;return;}
  if(_kind is not null)
  {
   if(AnimatedOnly&&Same(_kind,SpritesKind)){await OnExit.InvokeAsync();return;}
   _kind=null;return;
  }
  if(_family is not null){_family=null;return;}
  await OnExit.InvokeAsync();
 }
 Task BeginDrag(AtlasTile tile)=>OnAssetDragStart.InvokeAsync(tile);
 Task EndDrag()=>OnAssetDragEnd.InvokeAsync();
}
