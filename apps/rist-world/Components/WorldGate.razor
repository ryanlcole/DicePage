@using Microsoft.AspNetCore.Components.Forms
@inject WorldSession Session

@if(Open)
{
 <section class="world-gate-backdrop" role="presentation" @onclick="CloseAsync">
  <div class="world-gate" role="dialog" aria-modal="true" aria-label="Choose a world" @onclick:stopPropagation="true">
   <header>
    <span><small>RIST SANDBOX</small><strong>CHOOSE A SANDBOX WORLD</strong></span>
    @if(!RequireSelection){<button type="button" @onclick="CloseAsync" aria-label="Close sandbox world chooser">×</button>}
   </header>

   <section class="world-gate-create">
    <small class="world-gate-create-kind">PRIVATE / SANDBOX WORLD</small>
    <label for="world-name">WORLD NAME</label>
    <input id="world-name" maxlength="80" placeholder="Enter a World Name" @bind="_worldName" @bind:event="oninput" autocomplete="off" />
    <small class="world-gate-commerce">@Session.WorldSlotCommercialLabel · @WorldSession.IncludedSurfaceWorldPixels×@WorldSession.IncludedSurfaceWorldPixels px surface starts included. Larger surfaces and additional worlds use account entitlements.</small>
    <button type="button" class="world-gate-primary" disabled="@(_busy||string.IsNullOrWhiteSpace(_worldName)||!CanCreateWorld)" @onclick="CreateAsync">@(CanCreateWorld?"CREATE NEW WORLD":"ADDITIONAL WORLD SLOT REQUIRED")</button>
   </section>

   <div class="world-gate-divider"><span>SANDBOX WORLDS</span></div>
   <section class="world-gate-worlds" aria-live="polite">
    @if(_loading)
    {
     <p class="world-gate-note">Loading your worlds…</p>
    }
    else if(_worlds.Count==0)
    {
     <p class="world-gate-note">No sandbox worlds yet. Create a new sandbox world or import a RIST world file.</p>
    }
    else
    {
     @foreach(var world in _worlds)
     {
      <article class="world-gate-world">
       <button type="button" class="world-gate-world-load" disabled="@_busy" @onclick="()=>LoadAsync(world)">
        <span><strong>@world.DisplayName</strong><small>@world.Relationship · @world.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</small></span><b>LOAD</b>
       </button>
       @if(Session.CanDeleteWorld(world))
       {
        <button type="button" class="world-gate-world-delete" disabled="@_busy" @onclick="()=>BeginDelete(world)" aria-label="Delete @world.DisplayName">DELETE</button>
       }
      </article>
     }
    }
   </section>

   <div class="world-gate-divider"><span>OR IMPORT</span></div>
   <label class="world-gate-import @((_busy||!CanCreateWorld)?"disabled":"")">
    <strong>IMPORT RIST WORLD</strong>
    <small>@(CanCreateWorld?"Choose a .ristmap file. Importing creates another owned world slot.":"An additional world-slot entitlement is required before importing another world.")</small>
    <InputFile OnChange="ImportAsync" accept=".ristmap,application/json" disabled="@(_busy||!CanCreateWorld)" />
   </label>

   @if(!string.IsNullOrWhiteSpace(_status))
   {
    <p class="world-gate-status" role="status">@_status</p>
   }
  </div>

  @if(_deleteWorld is not null)
  {
   <section class="world-delete-backdrop" role="presentation" @onclick="CancelDelete">
    <div class="world-delete-card" role="alertdialog" aria-modal="true" aria-labelledby="world-delete-title" @onclick:stopPropagation="true">
     <small>PERMANENT WORLD DELETION</small>
     <h2 id="world-delete-title">Delete @_deleteWorld.DisplayName?</h2>
     <p>This permanently deletes this world's private cloud data, all stored versions beneath the world, and this browser's local save.</p>
     <label for="world-delete-approval">Type exactly:</label>
     <code>@WorldSession.WorldDeletionConfirmationPhrase</code>
     <input id="world-delete-approval" autocomplete="off" spellcheck="false" @bind="_deleteApproval" @bind:event="oninput" />
     <div class="world-delete-actions">
      <button type="button" class="world-gate-secondary" disabled="@_busy" @onclick="CancelDelete">CANCEL</button>
      <button type="button" class="world-delete-confirm" disabled="@(_busy||!DeleteApprovalMatches)" @onclick="ConfirmDeleteAsync">@(_busy?"DELETING…":"DELETE WORLD")</button>
     </div>
    </div>
   </section>
  }
 </section>
}

