@code {
 const long MaxImportBytes=10*1024*1024;
 [Parameter] public bool Open{get;set;}
 [Parameter] public EventCallback OnClose{get;set;}
 [Parameter] public EventCallback OnContinue{get;set;}
 [Parameter] public bool RequireSelection{get;set;}
 readonly List<AccountWorldReference> _worlds=[];
 AccountWorldReference? _deleteWorld;
 bool _wasOpen;
 bool _loadRequested;
 bool _loading;
 bool _busy;
 string _worldName="";
 string _status="";
 string _deleteApproval="";
 bool DeleteApprovalMatches=>string.Equals(_deleteApproval,WorldSession.WorldDeletionConfirmationPhrase,StringComparison.Ordinal);
 bool CanCreateWorld=>Session.CanCreateAdditionalOwnedWorld(_worlds);

 protected override void OnParametersSet()
 {
  if(Open&&!_wasOpen)
  {
   _status="";
   _worldName="";
   _deleteWorld=null;
   _deleteApproval="";
   _loading=true;
   _loadRequested=true;
  }
  _wasOpen=Open;
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!_loadRequested)return;
  _loadRequested=false;
  await RefreshWorldsAsync();
  await InvokeAsync(StateHasChanged);
 }

 async Task RefreshWorldsAsync()
 {
  _loading=true;
  try
  {
   var directory=await Session.LoadWorldDirectoryAsync();
   _worlds.Clear();
   _worlds.AddRange(directory.Worlds.Where(WorldSession.IsSandboxWorldReference));
  }
  catch(Exception ex){_status="World list could not be loaded: "+ex.Message;}
  finally{_loading=false;}
 }

 async Task CreateAsync()
 {
  if(_busy||string.IsNullOrWhiteSpace(_worldName))return;
  if(!CanCreateWorld){_status="An additional world-slot entitlement is required to create another world.";return;}
  _busy=true;_status="Creating world…";
  try
  {
   await Session.CreateWorldAsync(_worldName);
   _status=$"{Session.WorldDisplayName} created and loaded.";
   await CompleteSelectionAsync();
  }
  catch(Exception ex){_status="World creation failed: "+ex.Message;}
  finally{_busy=false;}
 }

 async Task LoadAsync(AccountWorldReference world)
 {
  if(_busy)return;
  _busy=true;_status=$"Loading {world.DisplayName}…";
  try
  {
   await Session.LoadWorldAsync(world);
   _status=$"{Session.WorldDisplayName} loaded.";
   await CompleteSelectionAsync();
  }
  catch(Exception ex){_status="World load failed: "+ex.Message;}
  finally{_busy=false;}
 }

 void BeginDelete(AccountWorldReference world)
 {
  if(_busy||!Session.CanDeleteWorld(world))return;
  _deleteWorld=world;
  _deleteApproval="";
  _status="";
 }

 void CancelDelete()
 {
  if(_busy)return;
  _deleteWorld=null;
  _deleteApproval="";
 }

 async Task ConfirmDeleteAsync()
 {
  if(_busy||_deleteWorld is null||!DeleteApprovalMatches)return;
  var world=_deleteWorld;
  _busy=true;
  _status=$"Deleting {world.DisplayName}…";
  try
  {
   await Session.DeleteWorldAsync(world,_deleteApproval);
   _deleteWorld=null;
   _deleteApproval="";
   await RefreshWorldsAsync();
   _status=$"{world.DisplayName} and its world data were permanently deleted.";
  }
  catch(Exception ex){_status="World deletion failed: "+ex.Message;}
  finally{_busy=false;}
 }

 async Task ImportAsync(InputFileChangeEventArgs e)
 {
  if(_busy)return;
  if(!CanCreateWorld){_status="An additional world-slot entitlement is required to import another world.";return;}
  var file=e.File;
  if(file.Size>MaxImportBytes){_status="World import is limited to 10 MB.";return;}
  _busy=true;_status=$"Importing {file.Name}…";
  try
  {
   await using var stream=file.OpenReadStream(MaxImportBytes);
   using var reader=new StreamReader(stream);
   var json=await reader.ReadToEndAsync();
   var preferred=string.IsNullOrWhiteSpace(_worldName)?Path.GetFileNameWithoutExtension(file.Name):_worldName;
   await Session.ImportWorldAsync(json,preferred);
   _status=$"{Session.WorldDisplayName} imported and loaded.";
   await CompleteSelectionAsync();
  }
  catch(Exception ex){_status="World import failed: "+ex.Message;}
  finally{_busy=false;}
 }

 async Task CompleteSelectionAsync()
 {
  if(OnContinue.HasDelegate)await OnContinue.InvokeAsync();
  else await OnClose.InvokeAsync();
 }

 async Task CloseAsync(){if(_busy||_deleteWorld is not null||RequireSelection)return;await OnClose.InvokeAsync();}
}
