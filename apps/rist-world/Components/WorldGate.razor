 .world-delete-backdrop{position:fixed;inset:0;z-index:2147482600;display:grid;place-items:center;padding:16px;background:#020609e8}.world-delete-card{box-sizing:border-box;width:min(92vw,560px);display:grid;gap:10px;padding:20px;border:1px solid #8f4943;border-radius:12px;background:#110b0c;color:#eadbd8;box-shadow:0 20px 70px #000e;font-family:system-ui,-apple-system,sans-serif}.world-delete-card>small{color:#df8379;font-size:8px;font-weight:900;letter-spacing:.14em}.world-delete-card h2{margin:0;color:#ffd0c9;font-size:20px}.world-delete-card p{margin:0 0 5px;color:#c8b1ad;font-size:11px;line-height:1.5}.world-delete-card label{color:#dc958c;font-size:9px;font-weight:900;letter-spacing:.08em}.world-delete-card code{padding:9px;border:1px solid #563a38;border-radius:7px;background:#090708;color:#f0c3bd;font-size:10px;white-space:normal}.world-delete-card input{box-sizing:border-box;width:100%;height:46px;padding:0 11px;border:1px solid #77504c;border-radius:8px;background:#090708;color:#fff;font-size:15px;outline:none}.world-delete-card input:focus{border-color:#df8379;box-shadow:0 0 0 1px #df8379}.world-delete-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}.world-delete-confirm{min-height:46px;border:1px solid #a34d45;border-radius:8px;background:#461c19;color:#ffd6d0;font-weight:900;letter-spacing:.05em}
