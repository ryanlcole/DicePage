@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorldSession Session
@inject AwsAuthorityClient Authority
@inject IJSRuntime JS

<section class="campaign-workspace" aria-label="Campaign">
 <header class="campaign-header">
  <div>
   <small>CAMPAIGN · AUTHORITY · PEOPLE</small>
   <h1>CAMPAIGN</h1>
   <p>Plan the campaign, connect the people in it, then grant only the permissions they need.</p>
  </div>
  <span class="campaign-world">@Session.WorldDisplayName</span>
 </header>

 <nav class="campaign-tabs" aria-label="Campaign sections">
  <button type="button" class="@StoryTabClass" @onclick="OpenStory">STORY ARC</button>
  <button type="button" class="@SessionsTabClass" @onclick="OpenSessions">SESSIONS</button>
  <button type="button" class="@ScenesTabClass" @onclick="OpenScenes">SCENES</button>
  <button type="button" class="@ActorsTabClass" @onclick="OpenActors">ACTORS</button>
  <button type="button" class="@BehaviorsTabClass" @onclick="OpenBehaviorsAsync">BEHAVIORS</button>
  <button type="button" class="@ConnectionTabClass" @onclick="OpenConnections">ALLIES</button>
  <button type="button" class="@NotesTabClass" @onclick="OpenNotes">NOTES</button>
 </nav>

 @if(_tab=="behaviors")
 {
  <div class="campaign-behavior-layout">
   <section class="campaign-behavior-editor">
    <header>
     <div><small>STABLE TARGET → BEHAVIOR</small><h2>BEHAVIORS</h2></div>
     <span>@(_behaviorState?.Rules.Count??0) RULES</span>
    </header>
    <p class="behavior-boundary">Campaign references geometry; it does not own it. X/Y, elevation, Tier, Layer, grid shape, and visual composition remain in their recursive builders.</p>

    @if(_behaviorLoading)
    {
     <div class="connection-empty"><strong>LOADING CAMPAIGN BEHAVIOR…</strong></div>
    }
    else
    {
     <div class="behavior-form">
      <label>
       <span>QUICK TARGET</span>
       <select value="@_behaviorQuickTarget" @onchange="ChooseBehaviorTarget">
        <option value="">Choose stable identity…</option>
        @foreach(var target in _behaviorTargets)
        {
         <option value="@target.Key">@target.Kind · @target.Label</option>
        }
       </select>
      </label>

      <div class="behavior-target-row">
       <label>
        <span>TARGET KIND</span>
        <select @bind="_behaviorTargetKind">
         <option value="WORLD">WORLD</option><option value="REGION">REGION</option><option value="LOCAL">LOCAL</option>
         <option value="INSTANCE">INSTANCE</option><option value="ASSET">ASSET</option><option value="CELL">CELL</option><option value="SURFACE">SURFACE</option>
        </select>
       </label>
       <label><span>TARGET ID</span><input @bind="_behaviorTargetId" placeholder="stable identity" /></label>
      </div>

      <div class="behavior-target-row">
       <label>
        <span>BEHAVIOR</span>
        <select @bind="_behaviorKind">
         @foreach(var kind in WorldSession.CampaignBehaviorKinds){<option value="@kind">@kind.Replace('_',' ')</option>}
        </select>
       </label>
       <label><span>NAME</span><input maxlength="120" @bind="_behaviorName" placeholder="Hidden pressure plate" /></label>
      </div>

      <label><span>THRESHOLD</span><input maxlength="240" @bind="_behaviorThreshold" placeholder="Perception 15, HP &lt; 50%, party size ≥ 4…" /></label>
      <label><span>TRIGGER</span><textarea rows="3" maxlength="1000" @bind="_behaviorTrigger" placeholder="When a character enters this cell…"></textarea></label>
      <label><span>ACTION / RESULT</span><textarea rows="4" maxlength="2000" @bind="_behaviorAction" placeholder="Reveal clue, start encounter, apply trap, present initiative…"></textarea></label>
      <label><span>PAYLOAD REFERENCE</span><input @bind="_behaviorPayloadRefId" placeholder="NPC / encounter / loot / card stable ID" /></label>
      <label><span>NOTES</span><textarea rows="3" maxlength="4000" @bind="_behaviorNotes"></textarea></label>
      <label class="behavior-enabled"><input type="checkbox" @bind="_behaviorEnabled" /><span>ENABLED</span></label>

      <div class="behavior-actions">
       <button type="button" class="primary" disabled="@(!CanSaveBehavior||_behaviorLoading)" @onclick="SaveBehaviorAsync">@(_behaviorEditRuleId.Length>0?"UPDATE RULE":"ADD RULE")</button>
       @if(_behaviorEditRuleId.Length>0){<button type="button" @onclick="ResetBehaviorEditor">CANCEL EDIT</button>}
      </div>
     </div>

     @if(!string.IsNullOrWhiteSpace(_behaviorStatus)){<p class="connection-status" role="status">@_behaviorStatus</p>}

     <section class="behavior-rules">
      @if(_behaviorState is null||_behaviorState.Rules.Count==0)
      {
       <div class="connection-empty"><strong>NO BEHAVIOR RULES YET</strong><span>Attach behavior to a stable identity without changing its geometry.</span></div>
      }
      else
      {
       @foreach(var rule in _behaviorState.Rules.OrderBy(x=>x.Name,StringComparer.OrdinalIgnoreCase).ThenBy(x=>x.RuleId,StringComparer.Ordinal))
       {
        <article class="@(!rule.Enabled?"disabled":"")">
         <header>
          <div><strong>@(string.IsNullOrWhiteSpace(rule.Name)?rule.BehaviorKind.Replace('_',' '):rule.Name)</strong><small>@rule.BehaviorKind.Replace('_',' ') · @rule.TargetKind</small></div>
          <span>@(rule.Enabled?"ENABLED":"DISABLED")</span>
         </header>
         <code>@rule.TargetId</code>
         @if(!string.IsNullOrWhiteSpace(rule.Threshold)){<p><b>THRESHOLD</b> @rule.Threshold</p>}
         @if(!string.IsNullOrWhiteSpace(rule.Trigger)){<p><b>TRIGGER</b> @rule.Trigger</p>}
         @if(!string.IsNullOrWhiteSpace(rule.Action)){<p><b>ACTION</b> @rule.Action</p>}
         @if(!string.IsNullOrWhiteSpace(rule.PayloadRefId)){<p><b>PAYLOAD</b> @rule.PayloadRefId</p>}
         <footer>
          <button type="button" @onclick="()=>EditBehavior(rule)">EDIT</button>
          <button type="button" @onclick="()=>ToggleBehaviorAsync(rule)">@((rule.Enabled)?"DISABLE":"ENABLE")</button>
          <button type="button" class="disconnect" @onclick="()=>DeleteBehaviorAsync(rule)">DELETE</button>
         </footer>
        </article>
       }
      }
     </section>
    }
   </section>
  </div>
 }
 else if(_tab=="connections")
 {
  <div class="campaign-connection-layout">
   <section class="connection-panel">
    <header>
     <div><small>ACCOUNT LINK</small><h2>ALLIES</h2></div>
     <span>@_connections.Count CONNECTED</span>
    </header>
    <p class="connection-intro">Connect authenticated RIST accounts with a one-use code. Connecting an account does not grant access by itself; it adds that identity to the permissions directory.</p>

    @if(!Session.IsLoggedIn)
    {
     <div class="connection-empty"><strong>SIGN IN REQUIRED</strong><span>Account connections are server-authoritative and cannot be created from an anonymous browser session.</span></div>
    }
    else
    {
     <div class="connection-code-grid">
      <section>
       <strong>SEND A CODE</strong>
       <small>Create a one-use connection code and send it to the other person.</small>
       <label><span>NOTE <em>optional</em></span><input maxlength="120" @bind="_inviteLabel" placeholder="Saturday group, co-GM, playtester…" /></label>
       <button type="button" class="primary" disabled="@_busy" @onclick="CreateInviteAsync">@(_busy?"WORKING…":"GENERATE CODE")</button>
       @if(_invite is not null)
       {
        <div class="connection-code">
         <code>@_invite.Code</code>
         <button type="button" @onclick="CopyCodeAsync">COPY</button>
         <small>One use · expires @InviteExpiry</small>
        </div>
       }
      </section>

      <section>
       <strong>HAVE A CODE?</strong>
       <small>Enter a code another authenticated user sent you.</small>
       <label><span>CONNECTION CODE</span><input maxlength="160" autocomplete="off" autocapitalize="off" spellcheck="false" @bind="_redeemCode" placeholder="rcc_…" /></label>
       <button type="button" class="primary" disabled="@(_busy||string.IsNullOrWhiteSpace(_redeemCode))" @onclick="RedeemAsync">@(_busy?"WORKING…":"CONNECT ACCOUNTS")</button>
      </section>
     </div>

     @if(!string.IsNullOrWhiteSpace(_status))
     {
      <p class="connection-status" role="status">@_status</p>
     }
     @if(!string.IsNullOrWhiteSpace(_permissionStatus))
     {
      <p class="connection-status" role="status">@_permissionStatus</p>
     }

     <section class="permission-directory" aria-label="Permissions directory">
      <header>
       <div><strong>PERMISSIONS DIRECTORY</strong><small>These authenticated identities can now be selected when assigning campaign or asset permissions.</small></div>
       <button type="button" disabled="@_busy" @onclick="LoadConnectionsAsync">REFRESH</button>
      </header>

      @if(_loading)
      {
       <div class="connection-empty"><strong>LOADING DIRECTORY…</strong></div>
      }
      else if(_connections.Count==0)
      {
       <div class="connection-empty"><strong>NO ALLIES YET</strong><span>Generate a code or redeem one to connect another account.</span></div>
      }
      else
      {
       <div class="connection-list">
        @foreach(var connection in _connections)
        {
         <article>
          <div class="connection-avatar" aria-hidden="true">@Initial(connection.DisplayName)</div>
          <div class="connection-copy">
           <strong>@connection.DisplayName</strong>
           <small>CONNECTED @ConnectedDate(connection)</small>
          </div>
          <div class="connection-permission">
           <span>DEFAULT ASSET STATE</span>
           <b>@PermissionPresentation.WaitingForGameMaster</b>
          </div>
          <button type="button" class="disconnect" disabled="@_busy" @onclick="()=>DisconnectAsync(connection)">UNLINK</button>
         </article>
        }
       </div>
      }
     </section>

     <section class="asset-permission-panel" aria-label="Asset permissions">
      <header>
       <div><strong>ASSET PERMISSIONS</strong><small>World, Region, Local, and Instance placements use one stable permission identity.</small></div>
       <button type="button" disabled="@(_busy||_assetPermissionsLoading)" @onclick="LoadAssetResourcesAsync">REFRESH ASSETS</button>
      </header>

      @if(_assetPermissionsLoading)
      {
       <div class="connection-empty"><strong>LOADING ASSETS…</strong></div>
      }
      else if(_assetResources.Count==0)
      {
       <div class="connection-empty"><strong>NO SAVED ASSETS YET</strong><span>Save placed content in Worldbuilder, Region Definer, Local, or Instance first.</span></div>
      }
      else
      {
       <div class="asset-permission-form">
        <label>
         <span>ASSET</span>
         <select value="@_selectedResourceId" @onchange="ChangeAssetResourceAsync">
          <option value="">Choose asset…</option>
          @foreach(var asset in _assetResources)
          {
           <option value="@asset.ResourceId">@asset.Scope · @asset.Name · @asset.Kind</option>
          }
         </select>
        </label>

        <label>
         <span>ALLY</span>
         <select @bind="_permissionPrincipal">
          <option value="EVERYONE">EVERYONE · public authority</option>
          @foreach(var connection in _connections)
          {
           <option value="@connection.LinkedUserId">@connection.DisplayName</option>
          }
         </select>
        </label>

        <label>
         <span>PERMISSION</span>
         <select @bind="_permissionGrant">
          <option value="None">Waiting for GM</option>
          <option value="View">View</option>
          <option value="Edit">Edit</option>
          <option value="Public">Public</option>
          <option value="Deny">Deny</option>
         </select>
        </label>

        <button type="button" class="primary" disabled="@(!CanSaveAssetPermission||_busy)" @onclick="SaveAssetPermissionAsync">SAVE ASSET PERMISSION</button>
       </div>

       @if(SelectedAssetResource is { } selectedAsset)
       {
        <div class="selected-asset-permission">
         <strong>@selectedAsset.Name</strong>
         <small>@selectedAsset.Scope · @selectedAsset.Kind</small>
         <code>@selectedAsset.ResourceId</code>
         <span>CURRENT FOR SELECTION · <b>@SelectedPrincipalPermission</b></span>
        </div>
       }

       @if(_resourcePermissions.Count>0)
       {
        <div class="resource-permission-list">
         @foreach(var permission in _resourcePermissions)
         {
          <article>
           <strong>@PrincipalLabel(permission.UserId)</strong>
           <span>@permission.Permission</span>
           <small>@PermissionDate(permission.UpdatedAtUtc)</small>
          </article>
         }
        </div>
       }
       else if(!string.IsNullOrWhiteSpace(_selectedResourceId))
       {
        <div class="connection-empty"><strong>WAITING FOR GM</strong><span>No explicit grants exist for this asset.</span></div>
       }
      }
     </section>

     <aside class="permission-rule">
      <strong>DEFAULT RULE</strong>
      <p>Every asset is permission-bearing. A connected player with no explicit or inherited grant is shown as <b>@PermissionPresentation.WaitingForGameMaster</b>. Connecting an account never silently grants View or Edit.</p>
      <div><span>WAITING FOR GM</span><span>VIEW</span><span>EDIT</span><span>PUBLIC</span><span>DENY</span></div>
     </aside>
    }
   </section>
  </div>
 }
 else
 {
  <section class="campaign-placeholder">
   <small>@_tab.ToUpperInvariant()</small>
   <h2>@TabTitle</h2>
   <p>This Campaign section remains available for the campaign workflow. Allies is active now because it is the identity source for recursive permissions.</p>
  </section>
 }
</section>

