@code {
 string _tab="connections";
 string _inviteLabel="",_redeemCode="",_status="";
 string _selectedResourceId="",_permissionPrincipal="EVERYONE",_permissionGrant="None",_permissionStatus="";
 bool _busy,_loading=true,_assetPermissionsLoading;
 AwsAuthorityClient.CollaborationInvite? _invite;
 readonly List<AwsAuthorityClient.CollaborationConnection> _connections=[];
 readonly List<AssetPermissionResource> _assetResources=[];
 readonly List<AwsAuthorityClient.ResourcePermission> _resourcePermissions=[];

 string TabClass(string tab)=>_tab==tab?"active":"";
 string StoryTabClass=>TabClass("story");
 string SessionsTabClass=>TabClass("sessions");
 string ScenesTabClass=>TabClass("scenes");
 string ActorsTabClass=>TabClass("actors");
 string NotesTabClass=>TabClass("notes");
 string ConnectionTabClass=>TabClass("connections")+" conspirators";
 void OpenStory()=>_tab="story";
 void OpenSessions()=>_tab="sessions";
 void OpenScenes()=>_tab="scenes";
 void OpenActors()=>_tab="actors";
 void OpenConnections()=>_tab="connections";
 void OpenNotes()=>_tab="notes";
 string TabTitle=>_tab switch{"story"=>"Story Arc","sessions"=>"Sessions","scenes"=>"Scenes","actors"=>"Actors","notes"=>"Notes",_=>"Campaign"};
 string InviteExpiry=>_invite is null?"":DateTimeOffset.FromUnixTimeSeconds(_invite.ExpiresAtEpoch).ToLocalTime().ToString("MMM d, h:mm tt");
 static string Initial(string value)=>string.IsNullOrWhiteSpace(value)?"?":value.Trim()[0].ToString().ToUpperInvariant();
 static string ConnectedDate(AwsAuthorityClient.CollaborationConnection value)=>DateTimeOffset.TryParse(value.ConnectedAtUtc,out var date)?date.ToLocalTime().ToString("MMM d, yyyy"):value.ConnectedAtUtc;

 AssetPermissionResource? SelectedAssetResource=>_assetResources.FirstOrDefault(x=>x.ResourceId==_selectedResourceId);
 bool CanSaveAssetPermission=>!string.IsNullOrWhiteSpace(_selectedResourceId)
  &&(_permissionPrincipal=="EVERYONE"
   ?_permissionGrant is "Public" or "None"
   :_permissionGrant!="Public");
 string SelectedPrincipalPermission
 {
  get
  {
   var explicitGrant=_resourcePermissions.FirstOrDefault(x=>string.Equals(x.UserId,_permissionPrincipal,StringComparison.Ordinal));
   return explicitGrant is null?PermissionPresentation.WaitingForGameMaster:PermissionPresentation.Label(ParsePermission(explicitGrant.Permission));
  }
 }
 static PermissionGrant ParsePermission(string value)=>value switch{
  "Public"=>PermissionGrant.Public,"View"=>PermissionGrant.View,"Edit"=>PermissionGrant.Edit,"Deny"=>PermissionGrant.Deny,_=>PermissionGrant.None};
 string PrincipalLabel(string userId)=>userId=="EVERYONE"?"EVERYONE":_connections.FirstOrDefault(x=>x.LinkedUserId==userId)?.DisplayName??userId;
 static string PermissionDate(string value)=>DateTimeOffset.TryParse(value,out var date)?date.ToLocalTime().ToString("MMM d, h:mm tt"):value;

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  await LoadConnectionsAsync();
  await LoadAssetResourcesAsync();
 }

 async Task LoadConnectionsAsync()
 {
  if(!Session.IsLoggedIn){_loading=false;return;}
  _loading=true;
  try{
   var rows=await Authority.GetConnectionsAsync()??[];
   _connections.Clear();_connections.AddRange(rows.OrderBy(x=>x.DisplayName,StringComparer.OrdinalIgnoreCase));
  }
  catch(Exception ex){_status="DIRECTORY ERROR · "+ex.Message;}
  finally{_loading=false;await InvokeAsync(StateHasChanged);}
 }

 async Task LoadAssetResourcesAsync()
 {
  if(!Session.IsLoggedIn)return;
  _assetPermissionsLoading=true;
  try
  {
   _assetResources.Clear();
   try{await Session.LoadRegionsAsync();await Session.LoadLocalsAsync();}catch{}

   var worldSource=await Session.LoadWorldBuilderSourceAsync();
   CollectAssetResources(worldSource?.State,"World",Session.WorldDisplayName);

   foreach(var region in Session.DefinedRegions)
   {
    try
    {
     var source=await Session.LoadRegionSourceAsync(region.RegionId);
     CollectAssetResources(source?.State,"Region",region.Name);
    }
    catch{}
   }

   foreach(var local in Session.DefinedLocals)
   {
    try
    {
     var source=await Session.LoadLocalMapAsync(local.LocalId);
     CollectAssetResources(source?.State,"Local",local.Name);
    }
    catch{}
   }

   var unique=_assetResources
    .GroupBy(x=>x.ResourceId,StringComparer.Ordinal)
    .Select(group=>group.First())
    .OrderBy(x=>x.Scope,StringComparer.OrdinalIgnoreCase)
    .ThenBy(x=>x.Name,StringComparer.OrdinalIgnoreCase)
    .ToList();
   _assetResources.Clear();_assetResources.AddRange(unique);
   if(_selectedResourceId.Length>0&&_assetResources.All(x=>x.ResourceId!=_selectedResourceId))_selectedResourceId="";
   if(_selectedResourceId.Length==0)_selectedResourceId=_assetResources.FirstOrDefault()?.ResourceId??"";
   await LoadSelectedResourcePermissionsAsync();
  }
  catch(Exception ex){_status="ASSET DIRECTORY ERROR · "+ex.Message;}
  finally{_assetPermissionsLoading=false;await InvokeAsync(StateHasChanged);}
 }

 void CollectAssetResources(System.Text.Json.JsonElement? state,string scope,string parentName)
 {
  if(state is not {ValueKind:System.Text.Json.JsonValueKind.Object} root)return;
  if(!root.TryGetProperty("userLayers",out var layers)||layers.ValueKind!=System.Text.Json.JsonValueKind.Array)return;
  foreach(var layer in layers.EnumerateArray())
  {
   if(layer.ValueKind!=System.Text.Json.JsonValueKind.Object)continue;
   var id=layer.TryGetProperty("id",out var idNode)&&idNode.ValueKind==System.Text.Json.JsonValueKind.String?idNode.GetString()??"":"";
   if(string.IsNullOrWhiteSpace(id))continue;
   var resourceId=layer.TryGetProperty("authorityResourceId",out var authorityNode)&&authorityNode.ValueKind==System.Text.Json.JsonValueKind.String
    ?authorityNode.GetString()??"":"";
   if(string.IsNullOrWhiteSpace(resourceId))resourceId="asset:"+id;
   var name=layer.TryGetProperty("name",out var nameNode)&&nameNode.ValueKind==System.Text.Json.JsonValueKind.String?nameNode.GetString()??"":"";
   if(string.IsNullOrWhiteSpace(name)&&layer.TryGetProperty("text",out var textNode)&&textNode.ValueKind==System.Text.Json.JsonValueKind.String)name=textNode.GetString()??"";
   if(string.IsNullOrWhiteSpace(name))name="Unnamed asset";
   var kind=layer.TryGetProperty("kind",out var kindNode)&&kindNode.ValueKind==System.Text.Json.JsonValueKind.String?kindNode.GetString()??"asset":"asset";
   _assetResources.Add(new(resourceId,name,kind,scope,parentName));
  }
 }

 async Task ChangeAssetResourceAsync(ChangeEventArgs e)
 {
  _selectedResourceId=e.Value?.ToString()??"";
  await LoadSelectedResourcePermissionsAsync();
 }

 async Task LoadSelectedResourcePermissionsAsync()
 {
  _resourcePermissions.Clear();
  if(string.IsNullOrWhiteSpace(_selectedResourceId)||!Session.IsLoggedIn)return;
  try
  {
   var rows=await Authority.GetResourcePermissionsAsync(Session.WorldId,_selectedResourceId)??[];
   _resourcePermissions.AddRange(rows);
  }
  catch(Exception ex){_permissionStatus="PERMISSION LOAD ERROR · "+ex.Message;}
 }

 async Task SaveAssetPermissionAsync()
 {
  if(!CanSaveAssetPermission||_busy)return;
  _busy=true;_permissionStatus="";
  try
  {
   var result=await Authority.SetResourcePermissionAsync(Session.WorldId,_selectedResourceId,_permissionPrincipal,_permissionGrant);
   _permissionStatus=result?.Ok==true
    ?(_permissionGrant=="None"?"Explicit permission removed · Waiting for GM applies.":"Asset permission saved.")
    :"Asset permission could not be saved.";
   await LoadSelectedResourcePermissionsAsync();
  }
  catch(Exception ex){_permissionStatus="ASSET PERMISSION ERROR · "+ex.Message;}
  finally{_busy=false;await InvokeAsync(StateHasChanged);}
 }

 async Task CreateInviteAsync()
 {
  if(_busy||!Session.IsLoggedIn)return;_busy=true;_status="";
  try{
   _invite=await Authority.CreateConnectionInviteAsync(_inviteLabel.Trim());
   _status=_invite is null?"CODE CREATION FAILED":"CODE READY · send it to the person you want to connect.";
  }
  catch(Exception ex){_status="CODE ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task CopyCodeAsync()
 {
  if(_invite is null)return;
  try{await JS.InvokeVoidAsync("navigator.clipboard.writeText",_invite.Code);_status="CODE COPIED";}
  catch{_status="COPY NOT AVAILABLE · select the code and copy it manually.";}
 }

 async Task RedeemAsync()
 {
  if(_busy||string.IsNullOrWhiteSpace(_redeemCode)||!Session.IsLoggedIn)return;_busy=true;_status="";
  try{
   var result=await Authority.RedeemConnectionInviteAsync(_redeemCode.Trim());
   if(result?.Ok==true){
    _status=result.AlreadyConnected?"ALREADY CONNECTED":"ACCOUNTS CONNECTED · identity added to the permissions directory.";
    _redeemCode="";
    await LoadConnectionsAsync();
   }else _status="CONNECTION FAILED";
  }
  catch(Exception ex){_status="CONNECTION ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task DisconnectAsync(AwsAuthorityClient.CollaborationConnection connection)
 {
  if(_busy)return;_busy=true;_status="";
  try{
   var ok=await Authority.RevokeConnectionAsync(connection.LinkedUserId);
   _status=ok?"ACCOUNTS UNLINKED":"UNLINK FAILED";
   if(ok)await LoadConnectionsAsync();
  }
  catch(Exception ex){_status="UNLINK ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 sealed record AssetPermissionResource(string ResourceId,string Name,string Kind,string Scope,string ParentName);

  public ValueTask DisposeAsync()=>ValueTask.CompletedTask;
}
