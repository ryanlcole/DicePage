-grid>section{display:grid;align-content:start;gap:7px;padding:11px;border:1px solid #40545d;border-radius:9px;background:#08131a}.connection-code-grid>section>strong{color:#e1c67e;font-size:9px;letter-spacing:.08em}.connection-code-grid>section>small{color:#849aa4;font-size:8px}.connection-code-grid label{display:grid;gap:4px}.connection-code-grid label>span{color:#8197a1;font:900 7px system-ui;letter-spacing:.08em}.connection-code-grid label em{font-weight:500;color:#657a84}.connection-code-grid input{box-sizing:border-box;width:100%;min-height:37px;border:1px solid #465b65;border-radius:7px;background:#0b171e;color:#eadfbe;padding:6px 8px;font:800 10px system-ui;-webkit-user-select:text;user-select:text}.connection-code-grid button,.permission-directory button{min-height:35px;border:1px solid #536873;border-radius:7px;background:#0d1920;color:#dfd7c1;padding:0 9px;font:900 8px system-ui}.connection-code-grid button.primary{border-color:#96763a;background:#211b0d;color:#f2d892}.connection-code{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;align-items:center;padding:8px;border:1px solid #6d5a32;border-radius:7px;background:#16140c}.connection-code code{overflow:auto;color:#f2dc9e;font-size:9px;-webkit-user-select:text;user-select:text}.connection-code small{grid-column:1/-1;color:#8d947c;font-size:7px}.connection-status{margin:0;padding:8px 10px;border:1px solid #476659;border-radius:7px;background:#0a1712;color:#bde1ce;font-size:9px}.permission-directory{display:grid;gap:8px;padding:11px;border:1px solid #4d6069;border-radius:10px;background:#071118}.permission-directory>header{display:flex;align-items:center;justify-content:space-between;gap:10px}.permission-directory>header div{display:grid;gap:2px}.permission-directory>header strong{color:#e0c67d;font-size:9px;letter-spacing:.09em}.permission-directory>header small{color:#8499a2;font-size:8px}.connection-list{display:grid;gap:6px}.connection-list article{display:grid;grid-template-columns:38px minmax(0,1fr) minmax(120px,180px) auto;gap:8px;align-items:center;padding:7px;border:1px solid #31464f;border-radius:8px;background:#0a151c}.connection-avatar{display:grid;place-items:center;width:36px;height:36px;border:1px solid #806a3c;border-radius:50%;background:#171a14;color:#e8cc83;font:700 14px Georgia,serif}.connection-copy{display:grid;gap:2px;min-width:0}.connection-copy strong{color:#e7dfca;font-size:10px;overflow:hidden;text-overflow:ellipsis}.connection-copy small{color:#768c96;font-size:7px}.connection-permission{display:grid;gap:2px}.connection-permission span{color:#768b94;font:900 6px system-ui;letter-spacing:.07em}.connection-permission b{color:#e0be69;font-size:8px}.disconnect{border-color:#70493f!important;color:#dda99b!important;background:#1a100e!important}.permission-rule{display:grid;gap:6px;padding:10px;border:1px dashed #665630;border-radius:8px;background:#11120d}.permission-rule>strong{color:#d7bb70;font-size:8px;letter-spacing:.1em}.permission-rule p{margin:0;color:#9ca7a5;font-size:8px;line-height:1.45}.permission-rule p b{color:#e2c46f}.permission-rule>div{display:flex;flex-wrap:wrap;gap:5px}.permission-rule>div span{padding:4px 6px;border:1px solid #48585c;border-radius:999px;color:#8ea0a5;font:900 6px system-ui}.connection-empty,.campaign-placeholder{display:grid;gap:5px;padding:20px;border:1px dashed #526671;border-radius:10px;text-align:center;color:#8398a2}.connection-empty strong,.campaign-placeholder h2{color:#d9c17e}.connection-empty span,.campaign-placeholder p{color:#879aa3;font-size:9px}.campaign-placeholder{margin:20px;place-self:start stretch}.campaign-placeholder small{color:#7896a5;font:900 7px system-ui;letter-spacing:.12em}.campaign-placeholder h2{margin:0;font:600 18px Georgia,serif}.campaign-placeholder p{margin:0}
 @@media(max-width:720px){.campaign-header p{display:none}.campaign-header h1{font-size:16px}.campaign-connection-layout{padding:7px}.connection-code-grid{grid-template-columns:1fr}.connection-list article{grid-template-columns:34px minmax(0,1fr) auto}.connection-permission{grid-column:2}.connection-list article .disconnect{grid-column:3;grid-row:1/3}.campaign-tabs{padding:5px}.campaign-tabs button{min-height:32px;padding:0 7px;font-size:6px}}
</style>

@code {
 string _tab="connections";
 string _inviteLabel="",_redeemCode="",_status="";
 bool _busy,_loading=true;
 AwsAuthorityClient.CollaborationInvite? _invite;
 readonly List<AwsAuthorityClient.CollaborationConnection> _connections=[];

 string TabClass(string tab)=>_tab==tab?"active":"";
 string ConnectionTabClass=>TabClass("connections")+" conspirators";
 void OpenStory()=>_tab="story";
 void OpenSessions()=>_tab="sessions";
 void OpenScenes()=>_tab="scenes";
 void OpenActors()=>_tab="actors";
 void OpenConnections()=>_tab="connections";
 void OpenNotes()=>_tab="notes";
 string TabTitle=>_tab switch{"story"=>"Story Arc","sessions"=>"Sessions","scenes"=>"Scenes","actors"=>"Actors","notes"=>"Notes",_=>"Campaign"};
 string InviteExpiry=>_invite is null?"":DateTimeOffset.FromUnixTimeSeconds(_invite.ExpiresAtEpoch).ToLocalTime().ToString("MMM d, h:mm tt");
 static string Initial(string value)=>string.IsNullOrWhiteSpace(value)?"?":value.Trim()[0].ToString().ToUpperInvariant();
 static string ConnectedDate(AwsAuthorityClient.CollaborationConnection value)=>DateTimeOffset.TryParse(value.ConnectedAtUtc,out var date)?date.ToLocalTime().ToString("MMM d, yyyy"):value.ConnectedAtUtc;

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  await LoadConnectionsAsync();
 }

 async Task LoadConnectionsAsync()
 {
  if(!Session.IsLoggedIn){_loading=false;return;}
  _loading=true;
  try{
   var rows=await Authority.GetConnectionsAsync()??[];
   _connections.Clear();_connections.AddRange(rows.OrderBy(x=>x.DisplayName,StringComparer.OrdinalIgnoreCase));
  }
  catch(Exception ex){_status="DIRECTORY ERROR · "+ex.Message;}
  finally{_loading=false;await InvokeAsync(StateHasChanged);}
 }

 async Task CreateInviteAsync()
 {
  if(_busy||!Session.IsLoggedIn)return;_busy=true;_status="";
  try{
   _invite=await Authority.CreateConnectionInviteAsync(_inviteLabel.Trim());
   _status=_invite is null?"CODE CREATION FAILED":"CODE READY · send it to the person you want to connect.";
  }
  catch(Exception ex){_status="CODE ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task CopyCodeAsync()
 {
  if(_invite is null)return;
  try{await JS.InvokeVoidAsync("navigator.clipboard.writeText",_invite.Code);_status="CODE COPIED";}
  catch{_status="COPY NOT AVAILABLE · select the code and copy it manually.";}
 }

 async Task RedeemAsync()
 {
  if(_busy||string.IsNullOrWhiteSpace(_redeemCode)||!Session.IsLoggedIn)return;_busy=true;_status="";
  try{
   var result=await Authority.RedeemConnectionInviteAsync(_redeemCode.Trim());
   if(result?.Ok==true){
    _status=result.AlreadyConnected?"ALREADY CONNECTED":"ACCOUNTS CONNECTED · identity added to the permissions directory.";
    _redeemCode="";
    await LoadConnectionsAsync();
   }else _status="CONNECTION FAILED";
  }
  catch(Exception ex){_status="CONNECTION ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 async Task DisconnectAsync(AwsAuthorityClient.CollaborationConnection connection)
 {
  if(_busy)return;_busy=true;_status="";
  try{
   var ok=await Authority.RevokeConnectionAsync(connection.LinkedUserId);
   _status=ok?"ACCOUNTS UNLINKED":"UNLINK FAILED";
   if(ok)await LoadConnectionsAsync();
  }
  catch(Exception ex){_status="UNLINK ERROR · "+ex.Message;}
  finally{_busy=false;}
 }

 public ValueTask DisposeAsync()=>ValueTask.CompletedTask;
}
