@using System.Text.Json
@inject HttpClient Http

<section class="geonaph-history-campaign" aria-label="Geonaph historical campaign">
 @if(_loading)
 {
  <div class="gh-loading">Loading canonical history…</div>
 }
 else if(!string.IsNullOrWhiteSpace(_error))
 {
  <div class="gh-error" role="alert">@_error</div>
 }
 else if(_root is not null)
 {
  <header class="gh-header">
   <div>
    <small>@(OpeningComplete?"GEONAPH · EVIDENCE-BOUNDED HISTORY":"GEONAPH · ACT 1 · SCENE 1")</small>
    <strong>@(OpeningComplete?DepthTitle:SceneTitle)</strong>
    <span>@(OpeningComplete?DepthSubtitle:SceneSubtitle)</span>
   </div>
   <div class="gh-badges">
    <b>FACT-FIRST</b><b>SHARED EXPERIENCE</b><b>RATING ≠ PROVENANCE</b>
   </div>
  </header>

  @if(!OpeningComplete)
  {
   <section class="gh-scene-one" aria-label="Act 1 Scene 1 arrival">
    <article class="gh-arrival-card">
     <small>@CurrentOpeningClassification</small>
     <h2>@CurrentOpeningLabel</h2>
     <p>@CurrentOpeningText</p>
     <div class="gh-arrival-progress" aria-label="Arrival progress">
      @for(var i=0;i<OpeningSteps.Count;i++)
      {
       <span class="@(i==SafeOpeningStep?"active":i<SafeOpeningStep?"done":"")">@(i+1)</span>
      }
     </div>
     <footer>
      <b>LEFT</b><span>Continue</span>
      <b>RIGHT</b><span>Character sheet</span>
     </footer>
    </article>
    <aside class="gh-arrival-rules">
     <h3>TRAVELER BACKBONE</h3>
     <p>@PlayerRule("origin")</p>
     <p>@PlayerRule("timeTravel")</p>
     <p>@PlayerRule("memory")</p>
     <p>@PlayerRule("death")</p>
     <h3>TRUTH FRAME</h3>
     <p>@EpistemicRule</p>
     <h3>AI BOUNDARY</h3>
     <p>@AiRule("requiredPerspective")</p>
     <p>@AiRule("simulationBoundary")</p>
     <p>@AiRule("roboticsBoundary")</p>
    </aside>
   </section>
  }
  else
  {
  <nav class="gh-recursion" aria-label="Recursive history depth">
   @for(var i=0;i<DepthNames.Length;i++)
   {
    <span class="@(i==DepthIndex?"active":i<DepthIndex?"visited":"")">@DepthNames[i]</span>
   }
  </nav>

  @if(ContextOpen)
  {
   <article class="gh-context">
    <header><small>CONTEXT</small><h2>Language & provenance</h2></header>
    <dl>
     <dt>Original language</dt><dd>@Language("originalLanguageStatus")</dd>
     <dt>Original</dt><dd>@Language("original")</dd>
     <dt>Transliteration</dt><dd>@Language("transliteration")</dd>
     <dt>Translation</dt><dd>@Language("translation")</dd>
    </dl>
    <section>
     <b>FICTIONAL GAMEPLAY DIALOGUE</b>
     <p>@FictionalDialogue</p>
    </section>
    <footer>Unknown remains unknown. Fiction may connect facts but cannot become evidence.</footer>
   </article>
  }
  else
  {
   <div class="gh-grid">
    <article class="gh-main">
     <header><small>@DepthBadge</small><h2>@DepthTitle</h2><p>@DepthSummary</p></header>
     <section>
      <h3>FACT / EVIDENCE</h3>
      @foreach(var fact in DepthFacts)
      {
       <p class="gh-entry"><b>@fact.Classification</b><span>@fact.Text</span></p>
      }
     </section>
     <section>
      <h3>RECONSTRUCTION / FICTION</h3>
      @foreach(var lore in DepthLore)
      {
       <p class="gh-entry"><b>@lore.Classification</b><span>@lore.Text</span></p>
      }
     </section>
    </article>

    <aside class="gh-side">
     @if(DepthIndex>=2)
     {
      <h3>TASKS</h3>
      @for(var i=0;i<Tasks.Count;i++)
      {
       var task=Tasks[i];
       <div class="gh-task @(i==TaskIndex?"selected":"") @(CompletedTasks.Contains(i)?"done":"")">
        <span>@(CompletedTasks.Contains(i)?"✓":"○")</span>
        <div><b>@task.Label</b><small>@task.Classification</small><p>@task.Action</p></div>
       </div>
      }
      @if(CompletedTasks.Count>=Tasks.Count)
      {
       <div class="gh-lock">NEXT EASTWARD ARC LOCKED · VERIFY NEXT FACT NODE</div>
      }
     }
     else
     {
      <h3>RECURSION</h3>
      <p>Use the left control to descend from @DepthNames[DepthIndex] to @DepthNames[Math.Min(2,DepthIndex+1)].</p>
      <p>The factual hierarchy is fixed for every player.</p>
     }

     @if(DepthIndex>=2)
     {
      <section class="gh-sprite-set">
       <h3>RECONSTRUCTION SPRITES</h3>
       <img src="assets/geonaph/history/lomekwi3/sprites/lom3-toolmaker-actions.svg"
            alt="Evidence-safe reconstruction sprite strip for Lomekwi 3 activities; taxonomic identity unresolved" />
       <small>RECONSTRUCTION · TAXONOMIC IDENTITY UNRESOLVED · NO UNSUPPORTED EQUIPMENT</small>
      </section>
     }

     <h3>SOURCES</h3>
     @foreach(var source in Sources)
     {
      <a href="@source.Url" target="_blank" rel="noopener">@source.Citation</a>
     }
    </aside>
   </div>
  }

  }

  <footer class="gh-footer">
   <span>ORIGINAL LANGUAGE: UNATTESTED AT THIS NODE</span>
   <span>FACT ≠ RECONSTRUCTION ≠ FICTION</span>
   <span>CONTENT RATING ≠ PROVENANCE</span>
  </footer>
 }
</section>

@code {
 [Parameter] public int OpeningStep { get; set; }
 [Parameter] public bool OpeningComplete { get; set; }
 [Parameter] public int DepthIndex { get; set; }
 [Parameter] public int TaskIndex { get; set; }
 [Parameter] public bool ContextOpen { get; set; }
 [Parameter] public IReadOnlyCollection<int> CompletedTasks { get; set; } = Array.Empty<int>();

 static readonly string[] DepthNames=["REGION","LOCAL","INSTANCE"];
 bool _loading=true;
 string _error="";
 JsonDocument? _doc;
 JsonElement? _root;

 sealed record Entry(string Classification,string Text);
 sealed record TaskEntry(string Label,string Classification,string Action);
 sealed record SourceEntry(string Citation,string Url);
 sealed record OpeningEntry(string Label,string Classification,string Text);

 protected override async Task OnInitializedAsync()
 {
  try
  {
   var json=await Http.GetStringAsync("data/geonaph/history/campaign-v1.json");
   _doc=JsonDocument.Parse(json);
   _root=_doc.RootElement.Clone();
  }
  catch(Exception ex){_error="History campaign data could not be loaded: "+ex.Message;}
  finally{_loading=false;}
 }

 JsonElement Act1=>_root!.Value.GetProperty("act1");
 JsonElement Scene1=>Act1.GetProperty("scene1");
 JsonElement PlayerBackbone=>_root!.Value.GetProperty("playerBackbone");
 JsonElement EpistemicFrame=>_root!.Value.GetProperty("epistemicFrame");
 JsonElement AiRole=>Scene1.GetProperty("aiRole");

 IReadOnlyList<OpeningEntry> OpeningSteps=>Scene1.GetProperty("openingSteps").EnumerateArray()
  .Select(item=>new OpeningEntry(
   item.GetProperty("label").GetString()??"",
   item.GetProperty("classification").GetString()??"FICTION",
   item.GetProperty("text").GetString()??""))
  .ToList();

 int SafeOpeningStep=>OpeningSteps.Count==0?0:Math.Clamp(OpeningStep,0,OpeningSteps.Count-1);
 OpeningEntry CurrentOpening=>OpeningSteps.Count==0?new("ARRIVAL","FICTION","Scene data unavailable."):OpeningSteps[SafeOpeningStep];
 string CurrentOpeningLabel=>CurrentOpening.Label;
 string CurrentOpeningClassification=>CurrentOpening.Classification;
 string CurrentOpeningText=>CurrentOpening.Text;
 string SceneTitle=>Scene1.GetProperty("title").GetString()??"First Breath";
 string SceneSubtitle=>"Future → temporal conformity → memory loss → West Turkana";
 string PlayerRule(string key)=>PlayerBackbone.TryGetProperty(key,out var value)?value.GetString()??"":"";
 string AiRule(string key)=>AiRole.TryGetProperty(key,out var value)?value.GetString()??"":"";
 string EpistemicRule=>EpistemicFrame.GetProperty("rule").GetString()??"";

 JsonElement Zone=>_root!.Value.GetProperty("zone");
 JsonElement Region=>Zone.GetProperty("region");
 JsonElement Local=>Region.GetProperty("local");
 JsonElement Instance=>Local.GetProperty("instance");
 JsonElement Current=>DepthIndex<=0?Region:DepthIndex==1?Local:Instance;

 string DepthBadge=>DepthNames[Math.Clamp(DepthIndex,0,2)];
 string DepthTitle=>Current.TryGetProperty("name",out var n)?n.GetString()??DepthBadge:DepthBadge;
 string DepthSubtitle=>DepthIndex switch
 {
  0=>"West Turkana · Kenya · factual region anchor",
  1=>"Lomekwi 3 · approximately 3.3 Ma",
  _=>"LOM3 · earliest installed playable fact node"
 };
 string DepthSummary=>DepthIndex switch
 {
  0=>"The campaign begins in the real West Turkana archaeological record. No fictional civilization is inserted before the evidence.",
  1=>"Lomekwi 3 preserves a distinctive early stone-working assemblage in a wooded palaeoenvironment.",
  _=>Instance.GetProperty("objective").GetString()??""
 };

 IEnumerable<Entry> DepthFacts
 {
  get
  {
   if(DepthIndex>=2)
   {
    foreach(var item in Instance.GetProperty("facts").EnumerateArray())
     yield return new Entry("FACT",item.GetString()??"");
    yield break;
   }
   if(!Current.TryGetProperty("history",out var entries))yield break;
   foreach(var item in entries.EnumerateArray())
    yield return new Entry(item.GetProperty("classification").GetString()??"FACT",item.GetProperty("text").GetString()??"");
  }
 }

 IEnumerable<Entry> DepthLore
 {
  get
  {
   if(DepthIndex>=2)
   {
    var bridge=Instance.GetProperty("bridge");
    yield return new Entry(bridge.GetProperty("classification").GetString()??"FICTION",bridge.GetProperty("rule").GetString()??"");
    yield break;
   }
   if(!Current.TryGetProperty("lore",out var entries))yield break;
   foreach(var item in entries.EnumerateArray())
    yield return new Entry(item.GetProperty("classification").GetString()??"FICTION",item.GetProperty("text").GetString()??"");
  }
 }

 IReadOnlyList<TaskEntry> Tasks=>Instance.GetProperty("tasks").EnumerateArray()
  .Select(item=>new TaskEntry(
   item.GetProperty("label").GetString()??"",
   item.GetProperty("classification").GetString()??"",
   item.GetProperty("action").GetString()??""))
  .ToList();

 IReadOnlyList<SourceEntry> Sources=>_root!.Value.GetProperty("sources").EnumerateArray()
  .Select(item=>new SourceEntry(item.GetProperty("citation").GetString()??"",item.GetProperty("url").GetString()??""))
  .ToList();

 string Language(string key)
 {
  var language=Instance.GetProperty("languageContext");
  return language.TryGetProperty(key,out var value)?value.GetString()??"": "";
 }
 string FictionalDialogue=>Instance.GetProperty("languageContext").GetProperty("fictionalDialogue").GetProperty("text").GetString()??"";
}

<style>
 .geonaph-history-campaign{position:absolute;z-index:120;inset:0;box-sizing:border-box;display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;gap:8px;padding:12px;background:radial-gradient(circle at 50% 25%,#153847,#061117 70%);color:#e9e5d9;overflow:hidden;font-family:Inter,system-ui,sans-serif}
 .gh-header{display:flex;justify-content:space-between;gap:12px;padding:10px 12px;border:1px solid #9f7b32;border-radius:12px;background:#071117e8}.gh-header>div:first-child{display:grid;gap:2px}.gh-header small{color:#82d8ff;font-size:9px;font-weight:900;letter-spacing:.18em}.gh-header strong{color:#f1d890;font:700 22px/1 Georgia,serif}.gh-header span{color:#9fb4bd;font-size:9px}.gh-badges{display:flex;align-items:center;gap:5px;flex-wrap:wrap;justify-content:flex-end}.gh-badges b{padding:5px 7px;border:1px solid #4d6671;border-radius:999px;color:#cceaf6;font-size:7px;letter-spacing:.08em}
