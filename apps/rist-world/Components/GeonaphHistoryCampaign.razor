 .gh-grid{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(220px,.9fr);gap:8px;min-height:0}.gh-main,.gh-side,.gh-context{min-height:0;border:1px solid #6f5b2e;border-radius:12px;background:#071016e8;overflow:auto}.gh-main{padding:12px}.gh-main header h2,.gh-context h2{margin:3px 0 6px;color:#f0d38a;font:700 24px Georgia,serif}.gh-main header p{margin:0 0 10px;color:#a8bdc5;font-size:10px;line-height:1.45}.gh-main h3,.gh-side h3{margin:12px 0 6px;color:#7edcff;font-size:9px;letter-spacing:.16em}.gh-entry{display:grid;grid-template-columns:110px 1fr;gap:8px;margin:5px 0;padding:7px;border:1px solid #263d48;border-radius:7px;background:#091820}.gh-entry b{color:#f0c96b;font-size:8px;letter-spacing:.08em}.gh-entry span{font-size:10px;line-height:1.45;color:#d5dee2}
 .gh-side{padding:10px}.gh-task{display:grid;grid-template-columns:18px 1fr;gap:6px;padding:7px;margin:5px 0;border:1px solid #2e4550;border-radius:8px}.gh-task.selected{border-color:#e7b944;background:#1d1a0e}.gh-task.done{box-shadow:inset 3px 0 #4bc7a4}.gh-task>span{color:#f1d276}.gh-task b{display:block;color:#e8e0ca;font-size:9px}.gh-task small{color:#8cc6dd;font-size:7px}.gh-task p{margin:3px 0 0;color:#9eafb7;font-size:8px;line-height:1.35}.gh-side>a{display:block;margin:6px 0;color:#a9dff4;font-size:8px;line-height:1.35}.gh-lock{margin-top:8px;padding:8px;border:1px solid #8b6c2b;border-radius:7px;color:#f0d38a;font-size:8px;font-weight:900;text-align:center}
 .gh-sprite-set{margin-top:10px;padding:8px;border:1px solid #38525e;border-radius:8px;background:#071820}.gh-sprite-set img{display:block;width:100%;max-height:88px;object-fit:contain;image-rendering:pixelated;background:#02070a;border-radius:6px}.gh-sprite-set small{display:block;margin-top:5px;color:#88baca;font-size:7px;line-height:1.35}
 .gh-scene-one{min-height:0;display:grid;grid-template-columns:minmax(0,1.55fr) minmax(240px,.8fr);gap:8px;overflow:hidden}
 .gh-arrival-card,.gh-arrival-rules{min-height:0;border:1px solid #6f5b2e;border-radius:12px;background:#071016e8;overflow:auto}
 .gh-arrival-card{display:grid;align-content:center;gap:10px;padding:18px}.gh-arrival-card>small{color:#82d8ff;font-size:9px;font-weight:900;letter-spacing:.16em}.gh-arrival-card h2{margin:0;color:#f0d38a;font:700 32px Georgia,serif}.gh-arrival-card>p{margin:0;max-width:820px;color:#d7e0e2;font-size:14px;line-height:1.6}.gh-arrival-card footer{display:grid;grid-template-columns:auto 1fr auto 1fr;gap:7px;align-items:center;margin-top:6px;padding-top:10px;border-top:1px solid #354b55;color:#9fb5bd;font-size:9px}.gh-arrival-card footer b{color:#f0c96b;font-size:8px;letter-spacing:.1em}
 .gh-arrival-progress{display:flex;gap:7px;margin-top:4px}.gh-arrival-progress span{display:grid;place-items:center;width:25px;height:25px;border:1px solid #37505b;border-radius:50%;color:#6f8792;font-size:8px;font-weight:900}.gh-arrival-progress span.done{border-color:#4a9f88;color:#85d7bf}.gh-arrival-progress span.active{border-color:#e0b650;background:#2a210d;color:#ffe39a}
 .gh-arrival-rules{padding:12px}.gh-arrival-rules h3{margin:10px 0 5px;color:#7edcff;font-size:9px;letter-spacing:.15em}.gh-arrival-rules p{margin:5px 0;padding:7px;border:1px solid #263d48;border-radius:7px;background:#091820;color:#b7c6cc;font-size:9px;line-height:1.45}
 .gh-context{padding:14px}.gh-context dl{display:grid;grid-template-columns:145px 1fr;gap:8px;font-size:10px}.gh-context dt{color:#86bcd0}.gh-context dd{margin:0;color:#e5dfcf}.gh-context section{margin-top:12px;padding:10px;border:1px solid #754d2d;border-radius:8px;background:#1a100a}.gh-context section b{color:#efb26d;font-size:8px}.gh-context section p{font-size:10px;line-height:1.45}.gh-context footer{margin-top:12px;color:#9eb1b8;font-size:8px}
 .gh-footer{display:flex;justify-content:space-between;gap:8px;padding:6px 8px;border-top:1px solid #5f4b27;color:#89aab7;font-size:7px;font-weight:900;letter-spacing:.07em}.gh-loading,.gh-error{display:grid;place-items:center;height:100%;color:#e8d18e}
 @@media(max-width:720px){.geonaph-history-campaign{padding:7px}.gh-scene-one{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) auto}.gh-arrival-rules{max-height:32vh}.gh-arrival-card h2{font-size:25px}.gh-arrival-card>p{font-size:12px}.gh-header{padding:8px}.gh-header strong{font-size:18px}.gh-badges b:nth-child(n+2){display:none}.gh-grid{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) auto}.gh-side{max-height:34vh}.gh-entry{grid-template-columns:86px 1fr}.gh-footer span:nth-child(2){display:none}.gh-context dl{grid-template-columns:110px 1fr}}
</style>
