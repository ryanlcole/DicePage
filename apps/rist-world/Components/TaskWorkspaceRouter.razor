@inject NavigationManager Navigation
@inject WorldSession Session

<div class="task-workspace-router">
 @if (Mode == "worldrunetest" || (Mode == "world" && RuneTestRequested))
 {
  <WorldAnimatedAssetCatalog />
  <WorldBuilderRuneTest OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "world")
 {
  <WorldAnimatedAssetCatalog />
  <WorldBuilderGeonaphHost OnStartMenu="OnStartMenu" OnHome="OnHome" />
 }
 else if (Mode == "accessibility")
 {
  <AccessibilityShell OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "observer")
 {
  <ReLiCObserverWorkspace OnStartMenu="OnStartMenu" OnHome="OnHome" />
 }
 else if (Mode == "perceiver")
 {
  <PerceiverWorkspace OnStartMenu="OnStartMenu" OnHome="OnHome" />
 }
 else if (Mode == "immersion")
 {
  <ImmersionBuilderWorkspace />
 }
 else if (Mode == "viewer")
 {
  <RegionDefinerWorkspace OnStartMenu="OnStartMenu" OnHome="OnHome" />
 }
 else if (Mode == "manage")
 {
  <WorldManagementWorkspace />
 }
 else if (Mode == "cards")
 {
  <CardIndexWorkspace />
 }
 else if (Mode == "tools")
 {
  <DiceToolsWorkspace />
 }
 else if (Mode == "charactercards")
 {
  <CharacterCardDesignerWorkspace />
 }
 else if (Mode == "tracker")
 {
  <GmReportWorkspace />
 }
 else if (Mode == "feedback")
 {
  <FeedbackWorkspace />
 }
 else if (Mode == "roleplay" && Session.IsGeonaphWorld)
 {
  <ShaelvienMmoFront />
 }
 else
 {
  <WorkspaceSurface Mode="@Mode" OnHome="OnHome" OnStartMenu="OnStartMenu" />
 }
</div>

<style>
 .task-workspace-router{box-sizing:border-box;position:relative;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden}.task-workspace-router>.workspace-surface,.task-workspace-router>.worldbuilder-studio,.task-workspace-router>.worldbuilder-rune-test,.task-workspace-router>.accessibility-shell,.task-workspace-router>.observer-shell,.task-workspace-router>.immersion-builder,.task-workspace-router>.perceiver-workspace,.task-workspace-router>.card-index-workspace,.task-workspace-router>.dice-tools-workspace,.task-workspace-router>.character-card-designer,.task-workspace-router>.gm-report-workspace,.task-workspace-router>.region-definer{width:100%!important;height:100%!important;min-width:0!important;min-height:0!important}
</style>

@code {
 [Parameter] public string Mode { get; set; } = "world";
 [Parameter] public EventCallback OnStartMenu { get; set; }
 [Parameter] public EventCallback OnHome { get; set; }
 bool RuneTestRequested
 {
  get
  {
   var uri=new Uri(Navigation.Uri);
   return uri.AbsolutePath.EndsWith("/worldbuilderrunetest",StringComparison.OrdinalIgnoreCase)
    || uri.Query.Contains("worldbuilderrunetest=1",StringComparison.OrdinalIgnoreCase);
  }
 }
}
