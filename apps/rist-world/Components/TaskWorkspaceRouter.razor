<div class="task-workspace-router">
 @if (Mode == "world")
 {
  <WorldBuilderStudio OnStartMenu="OnStartMenu" />
  <WorldBuilderGestureFix />
 }
 else if (Mode == "immersion")
 {
  <ImmersionBuilderWorkspace />
 }
 else if (Mode == "viewer")
 {
  <RegionDefinerWorkspace OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "manage")
 {
  <WorldManagementWorkspace />
 }
 else if (Mode == "cards")
 {
  <CardIndexWorkspace />
 }
 else if (Mode == "feedback")
 {
  <FeedbackWorkspace />
 }
 else
 {
  <WorkspaceSurface Mode="@Mode" />
 }
</div>

<style>
 .task-workspace-router{box-sizing:border-box;height:100%;min-height:0;overflow:hidden}.task-workspace-router>.workspace-surface,.task-workspace-router>.worldbuilder-studio,.task-workspace-router>.immersion-builder,.task-workspace-router>.card-index-workspace,.task-workspace-router>.region-definer{height:100%!important}
</style>

@code {
 [Parameter] public string Mode { get; set; } = "world";
 [Parameter] public EventCallback OnStartMenu { get; set; }
}
