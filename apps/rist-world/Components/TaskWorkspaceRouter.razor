@inject NavigationManager Navigation
@inject WorldSession Session

<div class="task-workspace-router">
 @if (Mode == "worldrunetest" || (Mode == "world" && RuneTestRequested))
 {
  <WorldAnimatedAssetCatalog />
  <WorldBuilderRuneTest OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "world" && Session.CanRequestWorldClaim && !Session.HasTrustedWorldBuilderAuthority)
 {
  <RegionDefinerWorkspace OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "world")
 {
  <WorldAnimatedAssetCatalog />
  <WorldBuilderGeonaphHost OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "accessibility")
 {
  <AccessibilityShell OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "immersion")
 {
  <ImmersionBuilderWorkspace />
 }
 else if (Mode == "viewer")
 {
  <RegionDefinerWorkspace OnStartMenu="OnStartMenu" />
 }
 else if (Mode == "manage")
 {
  <WorldManagementWorkspace />
 }
 else if (Mode == "cards")
 {
  <CardIndexWorkspace />
 }
 else if (Mode == "tools")
 {
  <DiceToolsWorkspace />
 }
 else if (Mode == "feedback")
 {
  <FeedbackWorkspace />
 }
 else
 {
  <WorkspaceSurface Mode="@Mode" />
 }
</div>

<style>
 .task-workspace-router{box-sizing:border-box;height:100%;min-height:0;overflow:hidden}.task-workspace-router>.workspace-surface,.task-workspace-router>.worldbuilder-studio,.task-workspace-router>.worldbuilder-rune-test,.task-workspace-router>.accessibility-shell,.task-workspace-router>.immersion-builder,.task-workspace-router>.card-index-workspace,.task-workspace-router>.dice-tools-workspace,.task-workspace-router>.region-definer{height:100%!important}
</style>

@code {
 [Parameter] public string Mode { get; set; } = "world";
 [Parameter] public EventCallback OnStartMenu { get; set; }
 bool RuneTestRequested
 {
  get
  {
   var uri=new Uri(Navigation.Uri);
   return uri.AbsolutePath.EndsWith("/worldbuilderrunetest",StringComparison.OrdinalIgnoreCase)
    || uri.Query.Contains("worldbuilderrunetest=1",StringComparison.OrdinalIgnoreCase);
  }
 }
}