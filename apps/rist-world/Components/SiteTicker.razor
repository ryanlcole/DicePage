@implements IDisposable
@inject WorldSession Session
@inject IJSRuntime JS
@using System.Text.Json

@if(Session.HasActiveWorld)
{
 <button type="button" class="site-ticker-root" aria-label="Open Start Menu" @onclick="OpenStartMenu">
  <span class="site-ticker-track" aria-hidden="true">
   @for(var repeat=0;repeat<2;repeat++)
   {
    @foreach(var item in _tickerButtons)
    {
     <span class="site-ticker-chip">@item</span>
    }
   }
  </span>
  <span class="site-ticker-accessible">Open Start Menu. Ticker: @string.Join(", ",_tickerButtons)</span>
 </button>
 
}

<style>
 .site-ticker-root{appearance:none;-webkit-appearance:none;box-sizing:border-box;width:100%;height:20px;min-height:20px;padding:0;overflow:hidden;border:0;border-bottom:1px solid rgba(113,91,45,.5);background:transparent;color:#e4c97d;position:relative;z-index:2147482000;text-align:left;cursor:pointer;touch-action:manipulation}
 .site-ticker-root:focus-visible{outline:1px solid #d9bd70;outline-offset:-1px}
 .site-ticker-track{display:flex;align-items:center;gap:8px;width:max-content;min-width:200%;height:100%;padding-left:8px;will-change:transform;animation:rist-site-ticker 30s linear infinite;pointer-events:none}
 .site-ticker-root:active .site-ticker-track,.site-ticker-root:focus .site-ticker-track{animation-play-state:paused}
 .site-ticker-chip{box-sizing:border-box;display:inline-flex;align-items:center;height:16px;padding:0 8px;border:1px solid rgba(111,91,49,.55);border-radius:999px;background:rgba(6,13,17,.34);color:#e4c97d;font:900 7px/14px system-ui,-apple-system,sans-serif;letter-spacing:.08em;white-space:nowrap}
 .site-ticker-accessible{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
 @@keyframes rist-site-ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
 @@media(prefers-reduced-motion:reduce){.site-ticker-track{animation:none;transform:none}}
</style>

@code {
 readonly List<string> _tickerButtons=[];
 string _loadedWorldId="";

 [Parameter] public string Context { get; set; } = "SHAELVIEN";
 [Parameter] public EventCallback OnStartMenu { get; set; }

 string TickerStorageKey => $"rist.worldbuilder.ticker.buttons.v1.{Session.WorldId}";
 IEnumerable<string> DefaultTicker()
 {
  var world=string.IsNullOrWhiteSpace(Session.WorldDisplayName)?"WORLD":Session.WorldDisplayName.Trim().ToUpperInvariant();
  return [world,"BUILD","UPLOAD","WEATHER","METADATA"];
 }

 Task OpenStartMenu()=>OnStartMenu.InvokeAsync();

 protected override void OnInitialized()=>Session.Changed+=Refresh;

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!Session.HasActiveWorld){_loadedWorldId="";return;}
  if(string.Equals(_loadedWorldId,Session.WorldId,StringComparison.Ordinal))return;
  _loadedWorldId=Session.WorldId;
  _tickerButtons.Clear();
  _tickerButtons.AddRange(DefaultTicker());
  try
  {
   var raw=await JS.InvokeAsync<string?>("localStorage.getItem",TickerStorageKey);
   if(!string.IsNullOrWhiteSpace(raw))
   {
    var saved=JsonSerializer.Deserialize<List<string>>(raw);
    if(saved is {Count:>0})
    {
     _tickerButtons.Clear();
     _tickerButtons.AddRange(saved
      .Where(x=>!string.IsNullOrWhiteSpace(x))
      .Select(x=>x.Trim())
      .Select(x=>Session.IsGeonaphWorld&&x.Equals("GEONAPH",StringComparison.OrdinalIgnoreCase)?"ENDEMAR":x)
      .Take(12));
     if(_tickerButtons.Count==0)_tickerButtons.AddRange(DefaultTicker());
     if(Session.IsGeonaphWorld&&_tickerButtons.Any(x=>x.Equals("ENDEMAR",StringComparison.OrdinalIgnoreCase)))
      await JS.InvokeVoidAsync("localStorage.setItem",TickerStorageKey,JsonSerializer.Serialize(_tickerButtons));
    }
   }
  }
  catch{}
  await InvokeAsync(StateHasChanged);
 }

 void Refresh()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose()=>Session.Changed-=Refresh;
}
