@inject WorldSession Session

@code {
    bool _seeded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _seeded) return;
        _seeded = true;

        for (var attempt = 0; attempt < 100; attempt++)
        {
            if (Session.AtlasTiles.Count > 0)
            {
                Session.ReplaceDefaultMapWithRandomOcean30();
                return;
            }
            await Task.Delay(50);
        }
    }
}
