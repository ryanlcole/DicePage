@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth

<header id="header-slider" class="release-root-rail desktop-arrow-slider" aria-label="Main menu">
 <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#header-slider',-1)" aria-label="Scroll main menu left">‹</button>
 <div class="header-circular-set release-root-track">
  <button class="root-menu-button door-button @(Session.IsLoggedIn?"active":"login-pulse")" @onclick="DoorClicked" aria-label="@(Session.IsLoggedIn?"Log out":"Log in")">
   <span class="root-menu-art icon-exit" aria-hidden="true"></span><small>@(Session.IsLoggedIn?"Exit":"Login")</small>
  </button>

  <button type="button" class="root-menu-button @RootActive("mode")" @onclick="()=>ToggleRoot("mode")" aria-expanded="@(_openRoot=="mode")" aria-label="Table mode">
   <span class="root-menu-art icon-encounter" aria-hidden="true"></span><small>Mode</small>
  </button>

  <button type="button" class="root-menu-button @RootActive("assets")" @onclick="()=>ToggleRoot("assets")" aria-expanded="@(_openRoot=="assets")" aria-label="Asset type">
   <span class="root-menu-art icon-assets" aria-hidden="true"></span><small>Assets</small>
  </button>

  <button type="button" class="root-menu-button header-card-deck @(Session.CardBrowserOpen?"active":"")" @onclick="Session.ToggleCardBrowser" aria-expanded="@Session.CardBrowserOpen" aria-controls="card-library" aria-label="Cards">
   <span class="header-card-back" aria-hidden="true"></span><small>Cards</small>
   @if(Session.PendingHandApprovalCount>0&&Session.Role=="GM"){<span class="header-notification-badge">@Session.PendingHandApprovalCount</span>}
  </button>

  <button type="button" class="root-menu-button @(Session.TileBrowserOpen?"active":"")" @onclick="Session.ToggleTileBrowser" aria-expanded="@Session.TileBrowserOpen" aria-label="Browse asset library">
   <span class="root-menu-art icon-browse" aria-hidden="true"></span><small>Browse</small>
  </button>

  <button type="button" class="root-menu-button @RootActive("role")" @onclick="()=>ToggleRoot("role")" aria-expanded="@(_openRoot=="role")" aria-label="Role">
   <span class="root-menu-art icon-role" aria-hidden="true"></span><small>@Session.Role</small>
  </button>

  <button type="button" class="root-menu-button @RootActive("grid")" @onclick="()=>ToggleRoot("grid")" aria-expanded="@(_openRoot=="grid")" aria-label="Grid">
   <span class="root-menu-art icon-grid" aria-hidden="true"></span><small>@GridLabel</small>
  </button>

  <button type="button" class="root-menu-button @RootActive("scale")" @onclick="()=>ToggleRoot("scale")" aria-expanded="@(_openRoot=="scale")" aria-label="Scale">
   <span class="root-menu-art icon-scale" aria-hidden="true"></span><small>Scale</small>
  </button>

  <button class="root-menu-button" @onclick="Session.SaveAndToggleExportAsync" aria-expanded="@Session.SaveMenuOpen" aria-label="Save and export">
   <span class="root-menu-art icon-save" aria-hidden="true"></span><small>Save</small>
  </button>

  <button class="root-menu-button" @onclick="Session.ToggleLoadMenu" aria-expanded="@Session.LoadMenuOpen" aria-label="Load">
   <span class="root-menu-art icon-load" aria-hidden="true"></span><small>Load</small>
  </button>

  <button type="button" class="root-menu-button header-mmo-button" data-shaelvien-ai-authority="@(Auth.IsOwnerDiscordAccount?"true":"false")" onclick="window.RistMMO?.toggle?.()" aria-pressed="false" aria-label="Toggle Sandbox and MMO">
   <span class="mmo-toggle-art" aria-hidden="true"></span><small>World</small>
  </button>

  <button type="button" class="root-menu-button root-menu-text" onclick="window.RistStartMenu?.open?.()" aria-label="Settings"><strong>SET</strong><small>Settings</small></button>
  <a class="root-menu-button root-menu-text" href="info.html" aria-label="Information"><strong>i</strong><small>Info</small></a>
 </div>
 <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#header-slider',1)" aria-label="Scroll main menu right">›</button>

 @if(_openRoot=="mode")
 {
  <section class="root-menu-panel" aria-label="Choose table mode">
   <strong>Table Mode</strong>
   <div class="root-choice-grid">
    @foreach(var mode in Modes){<button class="@(Session.TableMode==mode.Key?"selected":"")" @onclick="()=>SelectMode(mode.Key)">@mode.Label</button>}
   </div>
  </section>
 }
 @if(_openRoot=="assets")
 {
  <section class="root-menu-panel" aria-label="Choose asset type">
   <strong>Asset Type</strong>
   <div class="root-choice-grid">
    @foreach(var kind in AssetKinds){<button class="@(Session.PieceKind==kind.Key?"selected":"")" @onclick="()=>SelectAsset(kind.Key)">@kind.Label</button>}
   </div>
  </section>
 }
 @if(_openRoot=="role")
 {
  <section class="root-menu-panel compact-root-panel" aria-label="Choose role">
   <strong>Role</strong>
   <div class="root-choice-grid two-choice">
    @if(Session.CanManageCurrentMap){<button class="@(Session.Role=="GM"?"selected":"")" @onclick="()=>SelectRole("GM")">GM</button>}
    <button class="@(Session.Role=="PC"?"selected":"")" @onclick="()=>SelectRole("PC")">PC</button>
   </div>
  </section>
 }
 @if(_openRoot=="grid")
 {
  <section class="root-menu-panel compact-root-panel" aria-label="Choose grid">
   <strong>Grid</strong>
   <div class="root-choice-grid">
    <button class="@(Session.GridStyle=="square"?"selected":"")" @onclick="()=>SelectGrid("square")" disabled="@Session.EncounterActive">Square</button>
    <button class="@(Session.GridStyle=="hex"?"selected":"")" @onclick="()=>SelectGrid("hex")" disabled="@Session.EncounterActive">Hex</button>
    <button class="@(Session.GridStyle=="none"?"selected":"")" @onclick="()=>SelectGrid("none")" disabled="@Session.EncounterActive">None</button>
   </div>
  </section>
 }
 @if(_openRoot=="scale")
 {
  <section class="root-menu-panel scale-root-panel" aria-label="Set map scale">
   <strong>Scale</strong>
   <label><span>Distance</span><input type="number" min="0.01" step="0.25" @bind="Session.GridDistance" @bind:after="Session.CalibrateGrid" disabled="@Session.EncounterActive" /></label>
   <div class="root-choice-grid unit-grid">
    @foreach(var unit in Units){<button class="@(Session.DistanceUnit==unit?"selected":"")" @onclick="()=>SelectUnit(unit)" disabled="@Session.EncounterActive">@unit</button>}
   </div>
   <output>@(Session.EncounterActive ? "5 ft/hex" : $"{Session.EffectiveGridDistance:0.##} {Session.EffectiveGridUnit}/sq")</output>
  </section>
 }

 @if(Session.SaveMenuOpen)
 {
  <section class="header-action-menu release-action-menu save-menu" aria-label="Export map options">
   <strong>Save / Export</strong>
   <button @onclick="Session.DownloadMapAsync">Download RIST map</button>
   @if(Session.IsLoggedIn){<button @onclick="Session.SaveRistAsync">Save to private AWS storage</button>}
   <button @onclick="Session.ShareMapAsync">Export to Files / Drive / Share</button>
   @if(!string.IsNullOrWhiteSpace(Session.PrivateStorageStatus)){<output class="storage-status">@Session.PrivateStorageStatus</output>}
   <a href="privacy.html" target="_blank" rel="noopener">Privacy and data use</a>
  </section>
 }
 @if(Session.LoadMenuOpen)
 {
  <section class="header-action-menu release-action-menu load-menu" aria-label="Load map options">
   <strong>Load</strong>
   <label class="map-file-load">Load map file<InputFile OnChange="LoadMapFile" accept=".ristmap,.json,application/json" /></label>
   <button @onclick="Session.LoadAsync">Load browser save</button>
   @if(Session.IsLoggedIn){<button @onclick="Session.ToggleTileBrowser">Custom assets</button><button @onclick="Session.OpenMixer">Characters</button>}
  </section>
 }
</header>

@if(_loginPromptOpen && !Session.IsLoggedIn)
{
 <div class="discord-login-overlay" role="dialog" aria-modal="true" aria-label="Log in with Discord" @onclick="CloseLoginPrompt">
  <section class="discord-login-card" @onclick:stopPropagation="true">
   <button class="discord-login-close" @onclick="CloseLoginPrompt" aria-label="Close login">×</button>
   <div class="discord-brand-mark" aria-hidden="true"><svg viewBox="0 0 127.14 96.36" role="img"><path d="M107.7 8.1A105.2 105.2 0 0 0 81.5 0a72.1 72.1 0 0 0-3.4 7A97.7 97.7 0 0 0 49 7 72.4 72.4 0 0 0 45.5 0 105.9 105.9 0 0 0 19.3 8.2C2.7 32.8-1.8 56.8.4 80.5A105.7 105.7 0 0 0 32.5 96.4a77.7 77.7 0 0 0 6.9-9.4 68.7 68.7 0 0 1-10.8-5.2l2.7-2.1c20.8 9.6 43.4 9.6 63.9 0l2.8 2.1A69.3 69.3 0 0 1 87 87a77 77 0 0 0 6.9 9.4 105.3 105.3 0 0 0 32.1-15.9c2.7-27.5-4.6-51.3-18.3-72.4ZM42.5 65.7c-6.3 0-11.4-5.8-11.4-12.9s5-12.9 11.4-12.9c6.4 0 11.5 5.8 11.4 12.9 0 7.1-5 12.9-11.4 12.9Zm42.1 0c-6.3 0-11.4-5.8-11.4-12.9s5-12.9 11.4-12.9c6.4 0 11.5 5.8 11.4 12.9 0 7.1-5 12.9-11.4 12.9Z"/></svg></div>
   <h2>Enter RIST with Discord</h2>
   <p>Discord identifies your account so RIST can load permissions, private storage, characters, campaigns, and tutorial progress.</p>
   <button class="discord-login-primary" @onclick="ContinueDiscordLogin">Continue with Discord</button>
   <button class="discord-login-cancel" @onclick="CloseLoginPrompt">Cancel</button>
  </section>
 </div>
}

@code{
 static readonly (string Key,string Label)[] Modes=[("worldbuilder","Worldbuilder"),("forge","Forge"),("test","Test"),("encounter","Encounter"),("play","Let's Roll!")];
 static readonly (string Key,string Label)[] AssetKinds=[("mini","Minis"),("rolling-stock","Rolling Stock"),("pawn","Pawns / Meeples"),("pin","Tokens / Chits"),("tile","Tiles"),("terrain","Terrain"),("bit","Bits")];
 static readonly string[] Units=["mi","km","m","yd","ft"];
 bool _loginPromptOpen;
 string _openRoot=string.Empty;
 string GridLabel=>Session.GridStyle switch{"square"=>"Square","hex"=>"Hex",_=>"No Grid"};
 string RootActive(string key)=>_openRoot==key?"active":string.Empty;

 protected override void OnInitialized()=>Session.Changed+=SessionChanged;
 void SessionChanged(){if(Session.IsLoggedIn)_loginPromptOpen=false;_ = InvokeAsync(StateHasChanged);}
 public void Dispose()=>Session.Changed-=SessionChanged;
 void ToggleRoot(string key)=>_openRoot=_openRoot==key?string.Empty:key;
 async Task DoorClicked(){_openRoot=string.Empty;if(Session.IsLoggedIn){await Session.ToggleLoginAsync();return;}_loginPromptOpen=true;}
 void CloseLoginPrompt()=>_loginPromptOpen=false;
 async Task ContinueDiscordLogin(){_loginPromptOpen=false;await Session.ToggleLoginAsync();}
 void SelectMode(string value){Session.SetTableMode(value);_openRoot=string.Empty;}
 void SelectAsset(string value){Session.PieceKind=value;Session.Notify();_openRoot=string.Empty;}
 void SelectRole(string value){Session.SetRole(value);_openRoot=string.Empty;}
 void SelectGrid(string value){Session.GridStyle=value;Session.Notify();_openRoot=string.Empty;}
 void SelectUnit(string value){Session.SetDistanceUnit(value);_openRoot=string.Empty;}
 async Task LoadMapFile(InputFileChangeEventArgs e){using var stream=e.File.OpenReadStream(20*1024*1024);using var reader=new StreamReader(stream);Session.LoadMapJson(await reader.ReadToEndAsync());}
}
