@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth

<header id="header-slider" class="release-root-rail desktop-arrow-slider" aria-label="Main menu">
 <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#header-slider',-1)" aria-label="Scroll main menu left">‹</button>
 <div class="header-circular-set release-root-track">
  <button class="root-menu-button door-button @(Session.IsLoggedIn?"active":"login-pulse")" @onclick="DoorClicked" aria-label="@(Session.IsLoggedIn?"Log out":"Sign up or log in")"><span class="root-menu-art icon-exit" aria-hidden="true"></span><small>@(Session.IsLoggedIn?"Exit":"Login")</small></button>
  <button type="button" class="root-menu-button @ModeRootClass" @onclick="ToggleModeRoot" aria-expanded="@ModeRootOpen" aria-label="Table mode"><span class="root-menu-art icon-encounter" aria-hidden="true"></span><small>Mode</small></button>
  <button type="button" class="root-menu-button @AssetsRootClass" @onclick="ToggleAssetsRoot" aria-expanded="@AssetsRootOpen" aria-label="Assets"><span class="root-menu-art icon-assets" aria-hidden="true"></span><small>Assets</small></button>
  <button type="button" class="root-menu-button @RoleRootClass" @onclick="ToggleRoleRoot" aria-expanded="@RoleRootOpen" aria-label="Role"><span class="root-menu-art icon-role" aria-hidden="true"></span><small>@Session.Role</small></button>
  <button type="button" class="root-menu-button @GridRootClass" @onclick="ToggleGridRoot" aria-expanded="@GridRootOpen" aria-label="Grid"><span class="root-menu-art icon-grid" aria-hidden="true"></span><small>@GridLabel</small></button>
  <button type="button" class="root-menu-button @ScaleRootClass" @onclick="ToggleScaleRoot" aria-expanded="@ScaleRootOpen" aria-label="Scale"><span class="root-menu-art icon-scale" aria-hidden="true"></span><small>Scale</small></button>
  <button class="root-menu-button" @onclick="Session.SaveAndToggleExportAsync" aria-expanded="@Session.SaveMenuOpen" aria-label="Save and export"><span class="root-menu-art icon-save" aria-hidden="true"></span><small>Save</small></button>
  <button class="root-menu-button" @onclick="Session.ToggleLoadMenu" aria-expanded="@Session.LoadMenuOpen" aria-label="Load"><span class="root-menu-art icon-load" aria-hidden="true"></span><small>Load</small></button>
  <button type="button" class="root-menu-button header-mmo-button" data-shaelvien-ai-authority="@(Auth.IsOwnerDiscordAccount?"true":"false")" onclick="window.RistMMO?.toggle?.()" aria-pressed="false" aria-label="Toggle Sandbox and MMO"><span class="mmo-toggle-art" aria-hidden="true"></span><small>World</small></button>
  <button type="button" class="root-menu-button root-menu-text" onclick="window.RistStartMenu?.open?.()" aria-label="Settings"><strong>SET</strong><small>Settings</small></button>
  <a class="root-menu-button root-menu-text" href="info.html" aria-label="Information"><strong>i</strong><small>Info</small></a>
 </div>
 <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#header-slider',1)" aria-label="Scroll main menu right">›</button>

 @if(ModeRootOpen){<section class="root-menu-panel" aria-label="Choose table mode"><strong>Table Mode</strong><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close table mode">×</button><div class="root-choice-grid">@foreach(var mode in Modes){<button class="@(Session.TableMode==mode.Key?"selected":"")" @onclick="()=>SelectMode(mode.Key)">@mode.Label</button>}</div></section>}
 @if(AssetsRootOpen){<section class="root-menu-panel" aria-label="Choose asset type"><strong>Assets</strong><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close assets">×</button><div class="root-choice-grid">@foreach(var kind in AssetKinds){<button class="@AssetChoiceClass(kind.Key)" @onclick="()=>SelectAsset(kind.Key)">@kind.Label</button>}</div></section>}
 @if(RoleRootOpen){<section class="root-menu-panel compact-root-panel" aria-label="Choose role"><strong>Role</strong><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close role">×</button><div class="root-choice-grid two-choice">@if(Session.CanManageCurrentMap){<button class="@GmChoiceClass" @onclick="SelectGm">GM</button>}<button class="@PcChoiceClass" @onclick="SelectPc">PC</button></div></section>}
 @if(GridRootOpen){<section class="root-menu-panel compact-root-panel" aria-label="Choose grid"><strong>Grid</strong><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close grid">×</button><div class="root-choice-grid"><button class="@SquareChoiceClass" @onclick="SelectSquare" disabled="@Session.EncounterActive">Square</button><button class="@HexChoiceClass" @onclick="SelectHex" disabled="@Session.EncounterActive">Hex</button><button class="@NoGridChoiceClass" @onclick="SelectNoGrid" disabled="@Session.EncounterActive">None</button></div></section>}
 @if(ScaleRootOpen){<section class="root-menu-panel scale-root-panel" aria-label="Set map scale"><strong>Scale</strong><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close scale">×</button><label><span>Distance</span><input type="number" min="0.01" step="0.25" @bind="Session.GridDistance" @bind:after="Session.CalibrateGrid" disabled="@Session.EncounterActive" /></label><div class="root-choice-grid unit-grid">@foreach(var unit in Units){<button class="@(Session.DistanceUnit==unit?"selected":"")" @onclick="()=>SelectUnit(unit)" disabled="@Session.EncounterActive">@unit</button>}</div><output>@(Session.EncounterActive ? "5 ft/hex" : $"{Session.EffectiveGridDistance:0.##} {Session.EffectiveGridUnit}/sq")</output></section>}

 @if(Session.SaveMenuOpen){<section class="header-action-menu release-action-menu save-menu" aria-label="Export map options"><strong>Save / Export</strong><button type="button" class="root-panel-close" @onclick="Session.ToggleSaveMenu" aria-label="Close save menu">×</button><button @onclick="Session.DownloadMapAsync">Download RIST map</button>@if(Session.IsLoggedIn){<button @onclick="Session.SaveRistAsync">Save to private AWS storage</button>}<button @onclick="Session.ShareMapAsync">Export to Files / Drive / Share</button>@if(!string.IsNullOrWhiteSpace(Session.PrivateStorageStatus)){<output class="storage-status">@Session.PrivateStorageStatus</output>}<a href="privacy.html" target="_blank" rel="noopener">Privacy and data use</a></section>}
 @if(Session.LoadMenuOpen){<section class="header-action-menu release-action-menu load-menu" aria-label="Load map options"><strong>Load</strong><button type="button" class="root-panel-close" @onclick="Session.ToggleLoadMenu" aria-label="Close load menu">×</button><label class="map-file-load">Load map file<InputFile OnChange="LoadMapFile" accept=".ristmap,.json,application/json" /></label><button @onclick="Session.LoadAsync">Load browser save</button>@if(Session.IsLoggedIn){<button @onclick="OpenAssetLibrary">Custom assets</button><button @onclick="Session.OpenMixer">Characters</button>}</section>}
</header>

@code{
 static readonly (string Key,string Label)[] Modes=[("worldbuilder","Worldbuilder"),("forge","Forge"),("test","Test"),("encounter","Encounter"),("play","Let's Roll!")];
 static readonly (string Key,string Label)[] AssetKinds=[("all","All"),("cards","Cards"),("tokens","Tokens / Chits"),("minis","Minis"),("rolling-stock","Rolling Stock"),("pawns","Pawns / Meeples"),("tiles","Tiles"),("terrain","Terrain"),("bits","Bits")];
 static readonly string[] Units=["mi","km","m","yd","ft"];
 string _openRoot=string.Empty;
 string _assetRootSelection="all";
 bool ModeRootOpen=>_openRoot=="mode"; bool AssetsRootOpen=>_openRoot=="assets"; bool RoleRootOpen=>_openRoot=="role"; bool GridRootOpen=>_openRoot=="grid"; bool ScaleRootOpen=>_openRoot=="scale";
 string ModeRootClass=>ModeRootOpen?"active":string.Empty; string AssetsRootClass=>AssetsRootOpen||Session.CardBrowserOpen||Session.TileBrowserOpen?"active":string.Empty; string RoleRootClass=>RoleRootOpen?"active":string.Empty; string GridRootClass=>GridRootOpen?"active":string.Empty; string ScaleRootClass=>ScaleRootOpen?"active":string.Empty;
 string GridLabel=>Session.GridStyle switch{"square"=>"Square","hex"=>"Hex",_=>"No Grid"};
 string GmChoiceClass=>Session.Role=="GM"?"selected":string.Empty; string PcChoiceClass=>Session.Role=="PC"?"selected":string.Empty;
 string SquareChoiceClass=>Session.GridStyle=="square"?"selected":string.Empty; string HexChoiceClass=>Session.GridStyle=="hex"?"selected":string.Empty; string NoGridChoiceClass=>Session.GridStyle=="none"?"selected":string.Empty;
 string AssetChoiceClass(string key)=>_assetRootSelection==key?"selected":string.Empty;
 protected override void OnInitialized()=>Session.Changed+=SessionChanged;
 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose()=>Session.Changed-=SessionChanged;
 void ToggleRoot(string key)=>_openRoot=_openRoot==key?string.Empty:key;
 void ToggleModeRoot()=>ToggleRoot("mode"); void ToggleAssetsRoot()=>ToggleRoot("assets"); void ToggleRoleRoot()=>ToggleRoot("role"); void ToggleGridRoot()=>ToggleRoot("grid"); void ToggleScaleRoot()=>ToggleRoot("scale");
 void CloseRoot()=>_openRoot=string.Empty;
 async Task DoorClicked(){_openRoot=string.Empty;if(Session.IsLoggedIn){await Session.ToggleLoginAsync();return;}Session.OpenAccountViewer();}
 void SelectMode(string value){Session.SetTableMode(value);_openRoot=string.Empty;}
 void SelectAsset(string value){_assetRootSelection=value;if(value=="cards"){if(!Session.CardBrowserOpen)Session.ToggleCardBrowser();_openRoot=string.Empty;return;}Session.PieceKind=value switch{"tokens"=>"pin","minis"=>"mini","pawns"=>"pawn","tiles"=>"tile","bits"=>"bit",_=>value};if(!Session.TileBrowserOpen)Session.ToggleTileBrowser();Session.Notify();_openRoot=string.Empty;}
 void OpenAssetLibrary(){if(!Session.TileBrowserOpen)Session.ToggleTileBrowser();}
 void SelectRole(string value){Session.SetRole(value);_openRoot=string.Empty;} void SelectGm()=>SelectRole("GM"); void SelectPc()=>SelectRole("PC");
 void SelectGrid(string value){Session.GridStyle=value;Session.Notify();_openRoot=string.Empty;} void SelectSquare()=>SelectGrid("square"); void SelectHex()=>SelectGrid("hex"); void SelectNoGrid()=>SelectGrid("none");
 void SelectUnit(string value){Session.SetDistanceUnit(value);_openRoot=string.Empty;}
 async Task LoadMapFile(InputFileChangeEventArgs e){using var stream=e.File.OpenReadStream(20*1024*1024);using var reader=new StreamReader(stream);Session.LoadMapJson(await reader.ReadToEndAsync());}
}
