@using Microsoft.AspNetCore.Components.Forms
@inject WorldSession Session
<header class="topbar header-rail finite-rail icon-header" aria-label="Tabletop controls">
 <div class="finite-set header-circular-set">
  <div class="control icon-select-control table-mode-control @Session.TableMode" title="@Session.TableModeLabel">
   <span class="header-icon icon-encounter" aria-hidden="true"></span>
   <label class="sr-only" for="table-mode">Table mode</label>
   <select id="table-mode" value="@Session.TableMode" @onchange="ModeChanged" aria-label="Table mode">
    <option value="worldbuilder">Worldbuilder</option>
    <option value="forge">Forge</option>
    <option value="test">Test</option>
    <option value="encounter">Encounter</option>
    <option value="play">Let's Roll!</option>
   </select>
  </div>
  <div class="control asset-type-control icon-select-control"><span class="header-icon icon-assets" aria-hidden="true"></span><label class="sr-only">Asset type</label><select @bind="Session.PieceKind" aria-label="Tabletop asset type"><option value="mini">Miniatures (Minis)</option><option value="rolling-stock">Rolling Stock &amp; Locomotives</option><option value="pawn">Pawns &amp; Meeples</option><option value="pin">Tokens &amp; Chits</option><option value="tile">Tiles</option><option value="terrain">Scenery &amp; Terrain</option><option value="bit">Bits</option></select></div>
  <button class="header-icon-button header-card-deck @(Session.HandOpen?"active":"")" @onclick="Session.StandardDeckClick" aria-expanded="@Session.HandOpen" title="@(Session.StandardGameActive&&Session.StandardDrawOnly?"Draw random card":Session.HandOpen?"Close card deck":"Open card deck")" aria-label="@(Session.HandOpen?"Close card deck":"Open card deck")"><span class="header-card-back" aria-hidden="true"></span>@if(Session.PendingHandApprovalCount>0&&Session.Role=="GM"){<span class="approval-count" aria-label="@Session.PendingHandApprovalCount pending approvals">@Session.PendingHandApprovalCount</span>}</button>
  <button class="header-icon-button tile-library-button @(Session.TileBrowserOpen?"active":"")" @onclick="Session.ToggleTileBrowser" aria-expanded="@Session.TileBrowserOpen" title="Browse assets" aria-label="Browse assets"><span class="header-icon icon-browse" aria-hidden="true"></span></button>
  <button class="header-icon-button header-pin-drag" @onpointerdown="BeginHeaderPinPointer" @oncontextmenu:preventDefault title="Drag pin directly to map" aria-label="Drag pin directly to map"><span class="header-icon icon-pin" aria-hidden="true"></span></button>
  <div class="control icon-select-control compact-select"><span class="header-icon icon-role" aria-hidden="true"></span><label class="sr-only">Role</label><select @bind="Session.Role" @bind:after="Session.Notify" aria-label="Role">@if(Session.CanManageCurrentMap){<option value="GM">GM</option>}<option value="PC">PC</option></select></div>
  <div class="control icon-select-control compact-select"><span class="header-icon icon-grid-@Session.GridStyle" aria-hidden="true"></span><label class="sr-only">Grid</label><select @bind="Session.GridStyle" @bind:after="Session.Notify" disabled="@Session.EncounterActive" aria-label="Grid"><option value="square">Square</option><option value="hex">Hex</option><option value="none">No grid</option></select></div>
  <div class="control unit-control icon-select-control compact-select"><span class="header-icon icon-scale" aria-hidden="true"></span><label class="sr-only">Units per square</label><select value="@Session.DistanceUnit" @onchange="UnitChanged" disabled="@Session.EncounterActive" aria-label="Units per square"><option value="mi">mi</option><option value="km">km</option><option value="m">m</option><option value="yd">yd</option><option value="ft">ft</option></select></div>
  <div class="scale-stack">
   <label class="sr-only" for="grid-distance">Amount per square</label>
   <input id="grid-distance" type="number" min="0.01" step="0.25" @bind="Session.GridDistance" @bind:after="Session.CalibrateGrid" disabled="@Session.EncounterActive" aria-label="Amount per square" />
   <output>@(Session.EncounterActive ? "5 ft/hex" : $"{Session.EffectiveGridDistance:0.##} {Session.EffectiveGridUnit}/sq")</output>
  </div>
  <button class="header-icon-button" @onclick="Session.ToggleSaveMenu" title="Save" aria-label="Save options" aria-expanded="@Session.SaveMenuOpen"><span class="header-icon icon-save" aria-hidden="true"></span></button>
  <button class="header-icon-button" @onclick="Session.ToggleLoadMenu" title="Load" aria-label="Load options" aria-expanded="@Session.LoadMenuOpen"><span class="header-icon icon-load" aria-hidden="true"></span></button>
  <button class="header-icon-button door-button @(Session.IsLoggedIn?"logged-in":"logged-out")" @onclick="Session.ToggleLogin" title="@(Session.IsLoggedIn?"Log out":"Log in")" aria-label="@(Session.IsLoggedIn?"Log out":"Log in")">
   <span class="header-icon icon-exit" aria-hidden="true"></span><span class="door-label" aria-hidden="true">@(Session.IsLoggedIn?"Exit":"Enter")</span>
  </button>
 </div>
 @if(Session.SaveMenuOpen)
 {
  <section class="header-action-menu save-menu" aria-label="Save map options">
   <button @onclick="Session.DownloadMapAsync">Download map</button>
   <button @onclick="Session.ShareMapAsync">Save or share to Files / Drive</button>
   <button @onclick="Session.SaveAsync">Save in this browser</button>
   @if(Session.IsLoggedIn){<button disabled title="Requires signed AWS account API">Save RIST (AWS connection pending)</button>}
  </section>
 }
 @if(Session.LoadMenuOpen)
 {
  <section class="header-action-menu load-menu" aria-label="Load map options">
   <label class="map-file-load">Load map file<InputFile OnChange="LoadMapFile" accept=".ristmap,.json,application/json" /></label>
   <button @onclick="Session.LoadAsync">Load browser save</button>
   <button>Load as Shaelvien Graphics</button>
   @if(Session.IsLoggedIn)
   {
    <button disabled title="Requires signed AWS account API">Campaign maps (AWS connection pending)</button>
    <button @onclick="Session.ToggleTileBrowser">Custom tiles and tilesets</button>
    <button @onclick="Session.OpenMixer">Characters and cards</button>
   }
  </section>
 }
</header>
@code{
 void StageAsset(){if(Session.PieceKind=="tile"){if(!Session.TileBrowserOpen)Session.ToggleTileBrowser();return;}Session.StagePiece(Session.PieceKind);}
 void UnitChanged(ChangeEventArgs e)=>Session.SetDistanceUnit(e.Value?.ToString()??"mi");
 void ModeChanged(ChangeEventArgs e)=>Session.SetTableMode(e.Value?.ToString()??"worldbuilder");
 void BeginHeaderPinPointer(PointerEventArgs e)=>Session.BeginHeaderPinDrag();
 async Task LoadMapFile(InputFileChangeEventArgs e){using var stream=e.File.OpenReadStream(20*1024*1024);using var reader=new StreamReader(stream);Session.LoadMapJson(await reader.ReadToEndAsync());}
}
