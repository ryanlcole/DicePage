@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth

<style>
#header-slider .root-menu-art{display:block!important;width:46px!important;height:46px!important;margin:auto!important;background-position:center!important;background-repeat:no-repeat!important;background-size:contain!important;filter:none!important;transform:none!important}
#header-slider .root-menu-art::before,#header-slider .root-menu-art::after{content:none!important}
#header-slider .root-menu-art.icon-exit{background-image:url('assets/ui/icons/door.svg')!important}
#header-slider .root-menu-art.icon-encounter{background-image:url('assets/ui/icons/mode.svg')!important}
#header-slider .root-menu-art.icon-assets{width:31px!important;height:44px!important;max-width:31px!important;max-height:44px!important;border-radius:3px!important;background-image:url('assets/cards/shaelvien_card_back.jpg')!important;background-size:contain!important;background-position:center!important;background-repeat:no-repeat!important;box-shadow:0 1px 3px #0007!important}
#header-slider .root-menu-art.icon-role{background-image:url('assets/ui/icons/role.svg')!important}
#header-slider .root-menu-art.icon-grid{background-image:url('assets/ui/icons/grid.svg')!important}
#header-slider .root-menu-art.icon-scale{background-image:url('assets/ui/icons/scale.svg')!important}
#header-slider .root-menu-art.icon-save{background-image:url('assets/ui/icons/save.svg')!important}
#header-slider .root-menu-art.icon-load{background-image:url('assets/ui/icons/load.svg')!important}
#header-slider .header-mmo-button .mmo-toggle-art{display:block!important;width:54px!important;height:46px!important;margin:auto!important;background:url('assets/ui/sandbox-toggle.webp') center/contain no-repeat!important}
#header-slider .header-mmo-button.mmo-art-active .mmo-toggle-art{background-image:url('assets/ui/mmo-toggle.webp')!important}
#header-slider .release-root-track>.root-menu-button{position:relative!important}
#header-slider .release-root-track>.root-menu-button>small{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;clip-path:inset(50%)!important;white-space:nowrap!important;border:0!important}
#header-slider .release-root-track>.root-menu-button:hover>small,#header-slider .release-root-track>.root-menu-button:focus-visible>small,#header-slider .release-root-track>.root-menu-button:focus-within>small{left:50%!important;bottom:3px!important;width:max-content!important;max-width:calc(100% - 6px)!important;height:auto!important;margin:0!important;padding:3px 6px!important;overflow:visible!important;clip:auto!important;clip-path:none!important;transform:translateX(-50%)!important;white-space:nowrap!important;border:1px solid #725d30!important;border-radius:5px!important;background:#071015ee!important;color:#e8d49a!important;font:800 9px/1.15 system-ui!important;letter-spacing:.03em!important;text-align:center!important;pointer-events:none!important;z-index:50!important}
#header-slider .root-menu-panel,#header-slider .release-action-menu{padding-top:54px!important}
#header-slider .root-panel-close{position:absolute!important;top:8px!important;right:8px!important;z-index:999!important;width:44px!important;min-width:44px!important;height:44px!important;min-height:44px!important;margin:0!important;padding:0!important;display:grid!important;place-items:center!important;border:1px solid #a57c2f!important;border-radius:10px!important;background:#111b22!important;color:#f1d68f!important;font:900 30px/1 system-ui,-apple-system,sans-serif!important;cursor:pointer!important;pointer-events:auto!important;touch-action:manipulation!important;-webkit-tap-highlight-color:transparent!important}
#header-slider .root-panel-close:active{background:#20313a!important;border-color:#d2aa51!important;transform:scale(.97)}
</style>

<header id="header-slider" class="release-root-rail desktop-arrow-slider" aria-label="Main menu">
 <button type="button" class="rail-scroll-arrow rail-scroll-prev" onclick="ristWorld.scrollRail('#header-slider',-1)" aria-label="Scroll main menu left">‹</button>
 <div class="header-circular-set release-root-track">
  <button class="root-menu-button door-button @AccountRootClass" @onclick="DoorClicked" aria-expanded="@AccountRootOpen" aria-label="@(Session.IsLoggedIn?"Exit RIST":"Login")"><span class="root-menu-art icon-exit" aria-hidden="true"></span><small>@(Session.IsLoggedIn?"Exit":"Login")</small></button>
  <button type="button" class="root-menu-button @ModeRootClass" @onclick="ToggleModeRoot" aria-expanded="@ModeRootOpen" aria-label="Table mode"><span class="root-menu-art icon-encounter" aria-hidden="true"></span><small>Mode</small></button>
  <button type="button" class="root-menu-button @AssetsRootClass" @onclick="ToggleAssetsRoot" aria-expanded="@AssetsRootOpen" aria-label="Assets"><span class="root-menu-art icon-assets" aria-hidden="true"></span><small>Assets</small></button>
  <button type="button" class="root-menu-button @RoleRootClass" @onclick="ToggleRoleRoot" aria-expanded="@RoleRootOpen" aria-label="Role"><span class="root-menu-art icon-role" aria-hidden="true"></span><small>@RoleLabel</small></button>
  <button type="button" class="root-menu-button @GridRootClass" @onclick="ToggleGridRoot" aria-expanded="@GridRootOpen" aria-label="Grid"><span class="root-menu-art icon-grid" aria-hidden="true"></span><small>@GridLabel</small></button>
  <button type="button" class="root-menu-button @ScaleRootClass" @onclick="ToggleScaleRoot" aria-expanded="@ScaleRootOpen" aria-label="Scale"><span class="root-menu-art icon-scale" aria-hidden="true"></span><small>Scale</small></button>
  <button class="root-menu-button" @onclick="Session.SaveAndToggleExportAsync" aria-expanded="@Session.SaveMenuOpen" aria-label="Save and export"><span class="root-menu-art icon-save" aria-hidden="true"></span><small>Save</small></button>
  <button class="root-menu-button" @onclick="Session.ToggleLoadMenu" aria-expanded="@Session.LoadMenuOpen" aria-label="Load"><span class="root-menu-art icon-load" aria-hidden="true"></span><small>Load</small></button>
  <button type="button" class="root-menu-button header-mmo-button" data-shaelvien-ai-authority="@(Auth.IsOwnerDiscordAccount?"true":"false")" onclick="window.RistMMO?.toggle?.()" aria-pressed="false" aria-label="Toggle Sandbox and MMO"><span class="mmo-toggle-art" aria-hidden="true"></span><small>World</small></button>
  <button type="button" class="root-menu-button root-menu-text" onclick="window.RistStartMenu?.open?.()" aria-label="Settings"><strong>SET</strong><small>Settings</small></button>
  <a class="root-menu-button root-menu-text" href="info.html" aria-label="Information"><strong>i</strong><small>Info</small></a>
 </div>
 <button type="button" class="rail-scroll-arrow rail-scroll-next" onclick="ristWorld.scrollRail('#header-slider',1)" aria-label="Scroll main menu right">›</button>

 @if(AccountRootOpen){<section class="root-menu-panel compact-root-panel" aria-label="Account access"><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close account window">×</button><strong>Account</strong><div class="root-choice-grid two-choice"><button @onclick="OpenSignup">Sign Up</button><button @onclick="SignInAsync">Sign In</button></div></section>}
 @if(ModeRootOpen){<section class="root-menu-panel" aria-label="Choose table mode"><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close table mode window">×</button><strong>Table Mode</strong><div class="root-choice-grid">@foreach(var mode in Modes){<button class="@(Session.TableMode==mode.Key?"selected":"")" @onclick="()=>SelectMode(mode.Key)">@mode.Label</button>}</div></section>}
 @if(AssetsRootOpen){<section class="root-menu-panel" aria-label="Choose asset type"><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close assets window">×</button><strong>Assets</strong><div class="root-choice-grid">@foreach(var kind in AssetKinds){<button class="@AssetChoiceClass(kind.Key)" @onclick="()=>SelectAsset(kind.Key)">@kind.Label</button>}</div></section>}
 @if(RoleRootOpen){<section class="root-menu-panel compact-root-panel" aria-label="Choose role"><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close role window">×</button><strong>Role</strong><div class="root-choice-grid two-choice">@if(Session.CanManageCurrentMap){<button class="@GmChoiceClass" @onclick="SelectGm">GameMaster</button>}<button class="@PcChoiceClass" @onclick="SelectPc">RolePlayer</button></div></section>}
 @if(GridRootOpen){<section class="root-menu-panel compact-root-panel" aria-label="Choose grid"><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close grid window">×</button><strong>Grid</strong><div class="root-choice-grid"><button class="@SquareChoiceClass" @onclick="SelectSquare" disabled="@Session.EncounterActive">Square</button><button class="@HexChoiceClass" @onclick="SelectHex" disabled="@Session.EncounterActive">Hex</button><button class="@NoGridChoiceClass" @onclick="SelectNoGrid" disabled="@Session.EncounterActive">None</button></div></section>}
 @if(ScaleRootOpen){<section class="root-menu-panel scale-root-panel" aria-label="Set map scale"><button type="button" class="root-panel-close" @onclick="CloseRoot" aria-label="Close scale window">×</button><strong>Scale</strong><label><span>Distance</span><input type="number" min="0.01" step="0.25" @bind="Session.GridDistance" @bind:after="Session.CalibrateGrid" disabled="@Session.EncounterActive" /></label><div class="root-choice-grid unit-grid">@foreach(var unit in Units){<button class="@(Session.DistanceUnit==unit?"selected":"")" @onclick="()=>SelectUnit(unit)" disabled="@Session.EncounterActive">@unit</button>}</div><output>@(Session.EncounterActive ? "5 ft/hex" : $"{Session.EffectiveGridDistance:0.##} {Session.EffectiveGridUnit}/sq")</output></section>}

 @if(Session.SaveMenuOpen){<section class="header-action-menu release-action-menu save-menu" aria-label="Export map options"><button type="button" class="root-panel-close" @onclick="Session.ToggleSaveMenu" aria-label="Close save window">×</button><strong>Save / Export</strong><button @onclick="Session.DownloadMapAsync">Download RIST map</button>@if(Session.IsLoggedIn){<button @onclick="Session.SaveRistAsync">Save to private AWS storage</button>}<button @onclick="Session.ShareMapAsync">Export to Files / Drive / Share</button>@if(!string.IsNullOrWhiteSpace(Session.PrivateStorageStatus)){<output class="storage-status">@Session.PrivateStorageStatus</output>}<a href="privacy.html" target="_blank" rel="noopener">Privacy and data use</a></section>}
 @if(Session.LoadMenuOpen){<section class="header-action-menu release-action-menu load-menu" aria-label="Load map options"><button type="button" class="root-panel-close" @onclick="Session.ToggleLoadMenu" aria-label="Close load window">×</button><strong>Load</strong><label class="map-file-load">Load map file<InputFile OnChange="LoadMapFile" accept=".ristmap,.json,application/json" /></label><button @onclick="Session.LoadAsync">Load browser save</button>@if(Session.IsLoggedIn){<button @onclick="OpenAssetLibrary">Custom assets</button><button @onclick="Session.OpenMixer">Characters</button>}</section>}
</header>

@code{
 static readonly (string Key,string Label)[] Modes=[("worldbuilder","Worldbuilder"),("forge","Forge"),("test","Test"),("encounter","Encounter"),("play","Let's Roll!")];
 static readonly (string Key,string Label)[] AssetKinds=[("all","All"),("cards","Cards"),("tokens","Tokens / Chits"),("minis","Minis"),("rolling-stock","Rolling Stock"),("pawns","Pawns / Meeples"),("tiles","Tiles"),("terrain","Terrain"),("bits","Bits")];
 static readonly string[] Units=["mi","km","m","yd","ft"];
 string _openRoot=string.Empty;
 string _assetRootSelection="all";
 bool AccountRootOpen=>_openRoot=="account"; bool ModeRootOpen=>_openRoot=="mode"; bool AssetsRootOpen=>_openRoot=="assets"; bool RoleRootOpen=>_openRoot=="role"; bool GridRootOpen=>_openRoot=="grid"; bool ScaleRootOpen=>_openRoot=="scale";
 string AccountRootClass=>AccountRootOpen||Session.AccountViewerOpen?"active":string.Empty; string ModeRootClass=>ModeRootOpen?"active":string.Empty; string AssetsRootClass=>AssetsRootOpen||Session.CardBrowserOpen||Session.TileBrowserOpen?"active":string.Empty; string RoleRootClass=>RoleRootOpen?"active":string.Empty; string GridRootClass=>GridRootOpen?"active":string.Empty; string ScaleRootClass=>ScaleRootOpen?"active":string.Empty;
 string RoleLabel=>Session.Role=="GM"?"GM":"RP";
 string GridLabel=>Session.GridStyle switch{"square"=>"Square","hex"=>"Hex",_=>"No Grid"};
 string GmChoiceClass=>Session.Role=="GM"?"selected":string.Empty; string PcChoiceClass=>Session.Role=="PC"?"selected":string.Empty;
 string SquareChoiceClass=>Session.GridStyle=="square"?"selected":string.Empty; string HexChoiceClass=>Session.GridStyle=="hex"?"selected":string.Empty; string NoGridChoiceClass=>Session.GridStyle=="none"?"selected":string.Empty;
 string AssetChoiceClass(string key)=>_assetRootSelection==key?"selected":string.Empty;
 protected override void OnInitialized()=>Session.Changed+=SessionChanged;
 void SessionChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose()=>Session.Changed-=SessionChanged;
 void ToggleRoot(string key)=>_openRoot=_openRoot==key?string.Empty:key;
 void CloseRoot()=>_openRoot=string.Empty;
 void ToggleModeRoot()=>ToggleRoot("mode"); void ToggleAssetsRoot()=>ToggleRoot("assets"); void ToggleRoleRoot()=>ToggleRoot("role"); void ToggleGridRoot()=>ToggleRoot("grid"); void ToggleScaleRoot()=>ToggleRoot("scale");
 async Task DoorClicked(){if(Session.IsLoggedIn){_openRoot=string.Empty;await Session.ToggleLoginAsync();return;}if(Session.AccountViewerOpen)Session.CloseAccountViewer();ToggleRoot("account");}
 void OpenSignup(){_openRoot=string.Empty;Session.OpenAccountViewer();}
 async Task SignInAsync(){_openRoot=string.Empty;await Session.BeginAccountLoginAsync();}
 void SelectMode(string value){Session.SetTableMode(value);_openRoot=string.Empty;}
 void SelectAsset(string value){_assetRootSelection=value;if(value=="cards"){if(!Session.CardBrowserOpen)Session.ToggleCardBrowser();_openRoot=string.Empty;return;}Session.PieceKind=value switch{"tokens"=>"pin","minis"=>"mini","pawns"=>"pawn","tiles"=>"tile","bits"=>"bit",_=>value};if(!Session.TileBrowserOpen)Session.ToggleTileBrowser();Session.Notify();_openRoot=string.Empty;}
 void OpenAssetLibrary(){if(!Session.TileBrowserOpen)Session.ToggleTileBrowser();}
 void SelectRole(string value){Session.SetRole(value);_openRoot=string.Empty;} void SelectGm()=>SelectRole("GM"); void SelectPc()=>SelectRole("PC");
 void SelectGrid(string value){Session.GridStyle=value;Session.Notify();_openRoot=string.Empty;} void SelectSquare()=>SelectGrid("square"); void SelectHex()=>SelectGrid("hex"); void SelectNoGrid()=>SelectGrid("none");
 void SelectUnit(string value){Session.SetDistanceUnit(value);_openRoot=string.Empty;}
 async Task LoadMapFile(InputFileChangeEventArgs e){using var stream=e.File.OpenReadStream(20*1024*1024);using var reader=new StreamReader(stream);Session.LoadMapJson(await reader.ReadToEndAsync());}
}
