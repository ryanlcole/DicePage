@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorldSession Session
@inject DiscordAuthClient Auth

<header class="table-command-header" aria-label="Tabletop controls">
 <div class="command-wrap">
  <button type="button" class="brand-button" title="ReLiCGameMaster"><span class="brand-relic">ReLiC</span><span class="brand-game">GameMaster</span></button>
  <button class="command-button entrance @(Session.IsLoggedIn?"logged-in":"logged-out")" @onclick="DoorClicked">@(Session.IsLoggedIn?"Exit":"Entrance / Login")</button>
  <button type="button" class="command-button mmo-sandbox" data-shaelvien-ai-authority="@(Auth.IsOwnerDiscordAccount?"true":"false")" onclick="window.RistMMO?.toggle?.()"><span class="mmo-mark">∞</span><span>MMO / Sandbox</span></button>
  <button type="button" class="command-button mode-button" @onclick="Session.CycleUserMode"><small>User Mode</small><strong>@Session.UserMode</strong></button>
  <button type="button" class="command-button game-mode @Session.GameMode.ToLowerInvariant()" @onclick="Session.CycleGameMode"><small>Game Mode</small><strong>@Session.GameMode</strong></button>
  <button type="button" class="command-button presentation-mode" @onclick="Session.CyclePresentationMode"><small>Presentation</small><strong>@Session.PresentationMode</strong></button>
  <span class="command-divider" aria-hidden="true"></span>
  @foreach(var family in AssetFamilies)
  {
   <button type="button" class="command-button asset-launcher @(Session.AssetFamily==family&&Session.TileBrowserOpen?"active":"")" @onclick="()=>Session.OpenAssetFamily(family)">@family</button>
  }
  <span class="command-divider" aria-hidden="true"></span>
  <button type="button" class="command-button" onclick="window.RistStartMenu?.open?.()">Settings</button>
  <a class="command-button command-link" href="info.html">About</a>
  <button type="button" class="command-button" onclick="window.RistStartMenu?.open?.()">Help</button>
  <button type="button" class="command-button compact-icon" @onclick="Session.SaveAndToggleExportAsync" title="Save / Export">⇩</button>
  <button type="button" class="command-button compact-icon" @onclick="Session.ToggleLoadMenu" title="Load">⇧</button>
 </div>
 @if(Session.TileBrowserOpen){<AssetLibrary />}
 @if(Session.SaveMenuOpen){<section class="header-action-menu save-menu" aria-label="Export map options"><strong>Export map</strong><button @onclick="Session.DownloadMapAsync">Download RIST map</button>@if(Session.IsLoggedIn){<button @onclick="Session.SaveRistAsync">Save RIST to private AWS storage</button>}<button @onclick="Session.ShareMapAsync">Export to Files / Drive / Share</button>@if(!string.IsNullOrWhiteSpace(Session.PrivateStorageStatus)){<output class="storage-status">@Session.PrivateStorageStatus</output>}</section>}
 @if(Session.LoadMenuOpen){<section class="header-action-menu load-menu" aria-label="Load map options"><label class="map-file-load">Load map file<InputFile OnChange="LoadMapFile" accept=".ristmap,.json,application/json" /></label><button @onclick="Session.LoadAsync">Load browser save</button>@if(Session.IsLoggedIn){<button title="Private campaign map storage">Campaign maps</button><button @onclick="Session.OpenMixer">Characters and cards</button>}</section>}
</header>

@if(_loginPromptOpen && !Session.IsLoggedIn)
{
 <div class="discord-login-overlay" role="dialog" aria-modal="true" aria-label="Log in with Discord" @onclick="CloseLoginPrompt"><section class="discord-login-card" @onclick:stopPropagation="true"><button class="discord-login-close" @onclick="CloseLoginPrompt" aria-label="Close login">×</button><h2>Enter RIST with Discord</h2><p>Discord identifies your account so RIST can load permissions, private storage, characters and campaigns.</p><button class="discord-login-primary" @onclick="ContinueDiscordLogin">Continue with Discord</button><button class="discord-login-cancel" @onclick="CloseLoginPrompt">Cancel</button></section></div>
}

<style>
.table-command-header{position:relative;z-index:70;background:#081118f3;border-bottom:1px solid #745d28;color:#dfcfaa}
.command-wrap{display:flex;flex-wrap:wrap;align-items:stretch;gap:4px;padding:4px;min-width:0}
.command-button,.brand-button{min-height:36px;border:1px solid #5e4b25;border-radius:7px;background:#111a21;color:#d9c38a;padding:5px 9px;font:700 10px/1.1 system-ui;display:inline-flex;align-items:center;justify-content:center;gap:5px;text-decoration:none;white-space:nowrap}.command-button:active,.command-button.active{border-color:#d0a63f;background:#1a252d}.brand-button{min-width:118px;display:grid;grid-template-columns:auto auto;gap:3px;background:#0a1319}.brand-relic{font:700 15px/1 Georgia,serif;color:#e3c46f}.brand-game{font-size:9px;color:#b7a170}.command-button small{font-size:7px;opacity:.65;text-transform:uppercase;letter-spacing:.05em}.command-button strong{font-size:10px}.mode-button,.game-mode,.presentation-mode{display:grid;gap:1px}.game-mode.build strong{color:#d6b85c}.game-mode.test strong{color:#6ec8ff}.game-mode.live strong{color:#79d78b}.mmo-sandbox{padding-inline:7px}.mmo-mark{display:grid;place-items:center;width:25px;height:25px;border:1px solid #756333;border-radius:50%;font:700 18px/1 Georgia,serif;color:#83dbff;background:#10212a}.asset-launcher{min-width:64px}.command-divider{width:1px;align-self:stretch;background:#6a552a;margin:0 2px}.compact-icon{min-width:36px;font-size:17px;padding-inline:6px}
.table-command-header>.asset-slider-stack{border-top:1px solid #5a4825}.header-action-menu{position:absolute;right:5px;top:calc(100% + 2px);z-index:90;display:grid;gap:6px;min-width:220px;padding:10px;border:1px solid #80662f;border-radius:9px;background:#0c151b;color:#dfcfaa;box-shadow:0 10px 30px #000b}.header-action-menu button,.header-action-menu label{min-height:36px;border:1px solid #5e4b25;border-radius:7px;background:#111a21;color:#ddc88f;padding:8px}.map-file-load{position:relative;overflow:hidden}.map-file-load input{position:absolute;inset:0;opacity:0}
@@media(max-width:800px){.command-wrap{gap:3px;padding:3px}.command-button,.brand-button{min-height:32px;padding:4px 7px;font-size:9px;border-radius:6px}.brand-button{min-width:106px}.brand-relic{font-size:14px}.asset-launcher{min-width:58px}.command-divider{display:none}}
</style>

@code{
 static readonly string[] AssetFamilies=["Miniatures","Caravans","Cards","Pieces","Tiles","Scenery","Weapons","Armor","Clothing","Containers","Misc"];
 bool _loginPromptOpen;
 bool _privateRestoreStarted;
 protected override void OnInitialized(){Session.Changed+=SessionChanged;if(Session.IsLoggedIn&&!_privateRestoreStarted){_privateRestoreStarted=true;_ = RestorePrivateWorldAsync();}}
 void SessionChanged(){if(Session.IsLoggedIn){_loginPromptOpen=false;if(!_privateRestoreStarted){_privateRestoreStarted=true;_ = RestorePrivateWorldAsync();}}else _privateRestoreStarted=false;_ = InvokeAsync(StateHasChanged);}
 async Task RestorePrivateWorldAsync(){await Session.LoadPrivateCheckpointAsync();await InvokeAsync(StateHasChanged);}
 public void Dispose()=>Session.Changed-=SessionChanged;
 async Task DoorClicked(){if(Session.IsLoggedIn){await Session.ToggleLoginAsync();return;}_loginPromptOpen=true;}
 void CloseLoginPrompt()=>_loginPromptOpen=false;
 async Task ContinueDiscordLogin(){_loginPromptOpen=false;await Session.ToggleLoginAsync();}
 async Task LoadMapFile(InputFileChangeEventArgs e){using var stream=e.File.OpenReadStream(20*1024*1024);using var reader=new StreamReader(stream);Session.LoadMapJson(await reader.ReadToEndAsync());}
}
