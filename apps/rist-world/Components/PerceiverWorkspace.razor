@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorldSession Session

<div class="perceiver-workspace" @ref="_root" data-perceiver-source="@_sourceKind" aria-label="Perceiver tiered movie player">
 <header class="perceiver-toolbar">
  <div class="perceiver-toolbar-center">
   <strong>PERCEIVER</strong>
   <small>PARALLAX SPRITE MOVIE PLAYER · VIDEO → SPRITES</small>
  </div>

  <div class="perceiver-toolbar-right" aria-live="polite">
   <span class="perceiver-readout-line"><b data-perceiver-label>Tier 1</b></span>
   <span class="perceiver-readout-line">
    <span data-perceiver-play-state>Starting</span>
    <span aria-hidden="true">·</span>
    <span data-perceiver-motion-state>Pointer</span>
   </span>
   <span class="perceiver-readout-line">ZOOM <b data-perceiver-zoom>100%</b></span>
   <span class="perceiver-readout-line" data-perceiver-video-status>ENDEMAR PROOF</span>
   <span class="perceiver-source">@_sourceBadge</span>
  </div>
 </header>

 <section class="perceiver-stage-shell">
  <div class="perceiver-stage">
   <div class="perceiver-canvas" tabindex="0" aria-label="Reactive three-tier Endemar movie proof. Drag to pan, use the mouse wheel or pinch to zoom, and enable device tilt for depth reaction."></div>
  </div>
 </section>

 <footer class="perceiver-footer">
  <div class="perceiver-control-slider" aria-label="Perceiver controls">
   <div class="perceiver-control-row perceiver-transport" aria-label="Playback controls">
   <button type="button" @onclick="PreviousAsync" aria-label="Previous layer view">◀</button>
   <button type="button" @onclick="PlayAsync">PLAY</button>
   <button type="button" @onclick="PauseAsync">PAUSE</button>
   <button type="button" @onclick="RestartAsync">↺</button>
   <button type="button" @onclick="NextAsync" aria-label="Next layer view">▶</button>
  </div>

  <div class="perceiver-control-row perceiver-view-controls" aria-label="View controls">
   <button type="button" @onclick="ZoomOutAsync" aria-label="Zoom out">−</button>
   <button type="button" @onclick="ZoomInAsync" aria-label="Zoom in">+</button>
   <button type="button" @onclick="FitAsync" aria-label="Fit the current Perceiver scene">FIT</button>
   <button type="button" data-perceiver-fullscreen-button>FULL SCREEN</button>
   <button type="button" data-perceiver-motion-button>TILT</button>
  </div>

  <div class="perceiver-control-row perceiver-source-controls">
   <button type="button" data-perceiver-upload-button>VIDEO → SPRITES</button>
   <button type="button" data-perceiver-sprite-button>OPEN SPRITES</button>
   <button type="button" data-perceiver-save-sprites-button>SAVE SPRITES</button>
   <button type="button" data-perceiver-endemar-button>ENDEMAR</button>
   <div class="perceiver-speed">
    <label for="perceiver-speed-select">Speed</label>
    <select id="perceiver-speed-select" @onchange="SetSpeedAsync" aria-label="Perceiver playback speed">
     <option value="0.5">0.5x</option>
     <option value="1" selected>1x</option>
     <option value="1.5">1.5x</option>
     <option value="2">2x</option>
    </select>
   </div>
   <input type="file" accept="video/*" data-perceiver-video-input hidden aria-label="Choose a video for spectral conversion" />
   <input type="file" accept="image/png,image/webp,image/jpeg" multiple data-perceiver-sprite-input hidden aria-label="Choose one or more sprite sheet images" />
   </div>
  </div>

  <div class="perceiver-sprite-editor" data-perceiver-sprite-editor hidden aria-label="Sprite editing laboratory">
   <label><span>SPRITE</span><select data-perceiver-sprite-select aria-label="Select sprite layer"></select></label>
   <label><span>SIZE ×</span><input data-perceiver-sprite-size type="number" min="0.05" max="8" step="0.01" inputmode="decimal" value="1" /></label>
   <label class="wide"><span>FINE SIZE</span><input data-perceiver-sprite-size-range type="range" min="0.05" max="8" step="0.01" value="1" /></label>
   <label><span>X %</span><input data-perceiver-sprite-x type="number" min="-100" max="100" step="0.1" inputmode="decimal" value="0" /></label>
   <label><span>Y %</span><input data-perceiver-sprite-y type="number" min="-100" max="100" step="0.1" inputmode="decimal" value="0" /></label>
   <label><span>OPACITY %</span><input data-perceiver-sprite-opacity type="number" min="0" max="100" step="1" inputmode="numeric" value="100" /></label>
   <label><span>FPS</span><input data-perceiver-sprite-fps type="number" min="1" max="60" step="1" inputmode="numeric" value="60" /></label>
   <button type="button" data-perceiver-sprite-motion-only aria-pressed="false">MOTION ONLY</button>
   <button type="button" data-perceiver-sprite-reset>RESET SPRITE</button>
  </div>

  <div class="perceiver-layer-strip" data-perceiver-layer-strip hidden aria-label="Spectral video layers">
   <button type="button" data-perceiver-layer="all" aria-pressed="false">ALL</button>
   <button type="button" data-perceiver-layer="1" aria-pressed="false">1 VIO</button>
   <button type="button" data-perceiver-layer="2" aria-pressed="false">2 BLU</button>
   <button type="button" data-perceiver-layer="3" aria-pressed="false">3 CYN</button>
   <button type="button" data-perceiver-layer="4" aria-pressed="false">4 GRN</button>
   <button type="button" data-perceiver-layer="5" aria-pressed="false">5 YLW</button>
   <button type="button" data-perceiver-layer="6" aria-pressed="false">6 ORG</button>
   <button type="button" data-perceiver-layer="7" aria-pressed="false">7 RED</button>
  </div>

  <p class="perceiver-proof-note"><span data-perceiver-mode-note>1 → 2 → 3 → 1+2 → 1+3 → 2+3 → 1+2+3 → repeat</span></p>
 </footer>
</div>

<style>
 .perceiver-workspace{box-sizing:border-box;width:100%;height:100%;min-width:0;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;background:radial-gradient(circle at 18% 14%,rgba(51,122,160,.18),transparent 24rem),radial-gradient(circle at 82% 20%,rgba(201,152,58,.12),transparent 22rem),linear-gradient(180deg,#050b10,#08131a 48%,#04080c);color:#eadfc8;overflow:hidden;font-family:system-ui,-apple-system,sans-serif}
 .perceiver-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;padding:7px 10px;border-bottom:1px solid rgba(170,138,69,.34);background:rgba(4,10,14,.86);backdrop-filter:blur(8px)}
 .perceiver-toolbar-right{display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap}
 .perceiver-toolbar-center{display:grid;justify-items:start;text-align:left;gap:3px}.perceiver-toolbar-center strong{color:#f0d389;font:900 14px/1 system-ui;letter-spacing:.15em}.perceiver-toolbar-center small{color:#8fb6c7;font:800 9px/1 system-ui;letter-spacing:.10em}
 .perceiver-speed select{min-height:34px;border:1px solid #5b6e77;border-radius:8px;background:#0f1a20;color:#ecd9a5;padding:0 8px;font:800 10px/1 system-ui;touch-action:manipulation}
 .perceiver-speed select:focus-visible,.perceiver-canvas:focus-visible{outline:2px solid #e4c369;outline-offset:2px}
 .perceiver-readout-line{display:flex;gap:6px;align-items:center;color:#9fb4bd;font:700 9px/1 system-ui;text-transform:uppercase;letter-spacing:.08em}.perceiver-readout-line b{color:#f0d389}.perceiver-source{color:#7897a4;font:800 8px/1 system-ui;letter-spacing:.08em;text-transform:uppercase}
 .perceiver-stage-shell{min-width:0;min-height:0;padding:10px}.perceiver-stage{position:relative;width:100%;height:100%;min-height:320px;border:1px solid rgba(174,142,73,.38);border-radius:16px;overflow:hidden;background:radial-gradient(circle at 50% 38%,rgba(38,95,128,.14),transparent 36%),linear-gradient(180deg,#04090d,#071118 52%,#03070b);box-shadow:inset 0 0 0 1px rgba(255,255,255,.03),0 14px 42px rgba(0,0,0,.34)}
 .perceiver-canvas{position:absolute;inset:0;display:grid;place-items:center;overflow:hidden;touch-action:none}
 .perceiver-footer{display:grid;grid-template-columns:minmax(0,1fr);align-items:center;gap:5px;padding:7px 10px;border-top:1px solid rgba(170,138,69,.28);background:rgba(4,10,14,.90);min-width:0}
 .perceiver-control-slider{grid-column:1;display:flex;align-items:center;gap:8px;width:100%;min-width:0;overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scrollbar-width:none;scroll-snap-type:x proximity;touch-action:pan-x;padding:1px 0 3px}
 .perceiver-control-slider::-webkit-scrollbar{display:none}
 .perceiver-control-row{display:flex;gap:5px;align-items:center;min-width:max-content;flex:0 0 auto;scroll-snap-align:start}
 .perceiver-control-row button,.perceiver-layer-strip button{min-height:34px;border:1px solid #5b6e77;border-radius:7px;background:#0f1a20;color:#ecd9a5;padding:0 9px;font:800 9px/1 system-ui;touch-action:manipulation;white-space:nowrap}
 .perceiver-control-row button:hover,.perceiver-layer-strip button:hover{border-color:#c6a253}.perceiver-source-controls{justify-self:auto}.perceiver-speed{display:flex;gap:5px;align-items:center;justify-content:center}.perceiver-speed label{color:#8fb6c7;font:800 9px/1 system-ui;letter-spacing:.08em;text-transform:uppercase}
 .perceiver-layer-strip{grid-column:1/-1;display:flex;gap:4px;align-items:center;justify-content:center;overflow-x:auto;padding:1px 0 0;scrollbar-width:none}.perceiver-layer-strip[hidden]{display:none}.perceiver-layer-strip::-webkit-scrollbar{display:none}.perceiver-layer-strip button{min-width:52px;padding:0 7px}.perceiver-layer-strip button.active{border-color:#e2bd61;background:#2a210d;color:#ffe39b}
 .perceiver-sprite-editor{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;padding:6px;border:1px solid rgba(174,142,73,.36);border-radius:9px;background:rgba(4,10,14,.78)}
 .perceiver-sprite-editor[hidden]{display:none!important}
 .perceiver-sprite-editor label{display:grid;gap:3px;min-width:0;color:#8fb6c7;font:800 7px/1 system-ui;letter-spacing:.08em;text-transform:uppercase}
 .perceiver-sprite-editor label.wide{grid-column:span 2}
 .perceiver-sprite-editor input,.perceiver-sprite-editor select,.perceiver-sprite-editor button{box-sizing:border-box;min-width:0;min-height:34px;border:1px solid #5b6e77;border-radius:7px;background:#0f1a20;color:#ecd9a5;padding:4px 7px;font:800 9px/1 system-ui;touch-action:manipulation}
 .perceiver-sprite-editor input[type=range]{padding:0;accent-color:#d9b75e}
 .perceiver-sprite-editor button[aria-pressed=true]{border-color:#d6b45e;background:#2b220e;color:#ffe49b}
  .perceiver-proof-note{grid-column:1/-1;justify-self:center;margin:0;color:#8ea4ae;font:700 9px/1.2 system-ui;text-align:center}
 .perceiver-workspace:fullscreen,.perceiver-workspace.perceiver-pseudo-fullscreen{width:100vw!important;height:100dvh!important;max-width:none!important;max-height:none!important;background:#02070a}
 .perceiver-workspace:fullscreen{padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
 .perceiver-workspace.perceiver-pseudo-fullscreen{position:fixed!important;inset:0!important;z-index:2147483000!important;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
 .perceiver-workspace:fullscreen .perceiver-stage-shell,.perceiver-workspace.perceiver-pseudo-fullscreen .perceiver-stage-shell{padding:3px}
 .perceiver-workspace:fullscreen .perceiver-stage,.perceiver-workspace.perceiver-pseudo-fullscreen .perceiver-stage{border-radius:6px;min-height:0}
 @@media(max-width:900px){.perceiver-toolbar{grid-template-columns:1fr;justify-items:center;text-align:center;padding:5px 6px}.perceiver-toolbar-center{justify-items:center;text-align:center}.perceiver-toolbar-right{justify-content:center}.perceiver-footer{grid-template-columns:minmax(0,1fr);gap:4px;padding:5px 6px}.perceiver-layer-strip,.perceiver-proof-note{grid-column:1}.perceiver-source{display:none}}
 @@media(max-width:560px){
  .perceiver-stage-shell{padding:4px}
  .perceiver-stage{min-height:260px}
  .perceiver-toolbar-center small{font-size:8px}
  .perceiver-readout-line{font-size:8px}
  .perceiver-footer{
   grid-template-columns:minmax(0,1fr);
   gap:3px;
   padding:4px 4px max(8px,env(safe-area-inset-bottom));
   width:100%;
   min-width:0;
   box-sizing:border-box;
   overflow:hidden
  }
  .perceiver-control-slider{
   width:100%;
   min-width:0;
   gap:7px;
   padding:1px 2px 4px;
   scroll-padding-inline:2px
  }
  .perceiver-control-row{
   min-width:max-content;
   width:auto;
   flex:0 0 auto
  }
  .perceiver-control-row button,.perceiver-layer-strip button{
   min-height:36px;
   width:auto;
   min-width:40px;
   padding:0 9px;
   font-size:8px
  }
  .perceiver-speed{
   width:auto;
   min-width:max-content;
   flex:0 0 auto
  }
  .perceiver-speed select{
   min-width:72px;
   width:auto
  }
  .perceiver-sprite-editor{grid-template-columns:1fr 1fr}.perceiver-sprite-editor label.wide{grid-column:1/-1}
  .perceiver-proof-note{font-size:8px}
  .perceiver-layer-strip{
   grid-column:1;
   max-width:100%;
   justify-content:flex-start;
   padding-inline:2px
  }
 }
 @@media(prefers-reduced-motion:reduce){.perceiver-proof-note::after{content:" · reduced motion";}}
</style>

@code {
 [Parameter] public EventCallback OnStartMenu { get; set; }
 [Parameter] public EventCallback OnHome { get; set; }

 static readonly string[] CanonicalFallbackTierImages =
 [
  "https://d2d6rnm6fnsp89.cloudfront.net/library/terrains/standard/world/whole_maps/geonaph/geonaph_full_static_canonical_surface_v001.png",
  "https://d2d6rnm6fnsp89.cloudfront.net/library/terrains/standard/world/whole_maps/geonaph/geonaph_full_static_highlands_rivers_v001.png",
  "https://d2d6rnm6fnsp89.cloudfront.net/library/terrains/standard/world/whole_maps/geonaph/geonaph_full_static_mountain_volcanic_archipelago_v001.png"
 ];

 static readonly string[] CanonicalTierFileNames =
 [
  "geonaph_full_static_canonical_surface_v001.png",
  "geonaph_full_static_highlands_rivers_v001.png",
  "geonaph_full_static_mountain_volcanic_archipelago_v001.png"
 ];

 static readonly string[] CanonicalTransparentTierImages =
 [
  "assets/perceiver/endemar_tier_1_perceiver_v001.png?v=20260920-alpha-1",
  "assets/perceiver/endemar_tier_2_perceiver_v001.png?v=20260920-alpha-1",
  "assets/perceiver/endemar_tier_3_perceiver_v001.png?v=20260920-alpha-1"
 ];

 ElementReference _root;
 IJSObjectReference? _module;
 string[] _sourceTierImages = CanonicalFallbackTierImages;
 string[] _tierImages = CanonicalTransparentTierImages;
 string _sourceBadge = "CANONICAL TRANSPARENT REPRESENTATION";
 string _sourceKind = "fallback-alpha";

 protected override async Task OnInitializedAsync()
 {
  try
  {
   var source = await Session.LoadWorldBuilderSourceAsync();
   if(source?.State is JsonElement state
      && state.ValueKind == JsonValueKind.Object
      && state.TryGetProperty("tierImages", out var tierImagesElement)
      && tierImagesElement.ValueKind == JsonValueKind.Array)
   {
    var found = tierImagesElement.EnumerateArray()
     .Where(item => item.ValueKind == JsonValueKind.String)
     .Select(item => item.GetString()?.Trim() ?? "")
     .Where(value => !string.IsNullOrWhiteSpace(value))
     .Take(3)
     .ToArray();

    if(found.Length == 3)
    {
     _sourceTierImages = found;
     if(IsCanonicalEndemarTierSet(found))
     {
      _tierImages = CanonicalTransparentTierImages;
      _sourceBadge = "DATABASE SOURCE · TRANSPARENT REPRESENTATION";
      _sourceKind = "database-alpha";
     }
     else
     {
      _tierImages = found;
      _sourceBadge = "DATABASE SOURCE";
      _sourceKind = "database";
     }
    }
    else
    {
     _sourceTierImages = CanonicalFallbackTierImages;
     _tierImages = CanonicalTransparentTierImages;
     _sourceBadge = "DATABASE INCOMPLETE · TRANSPARENT FALLBACK";
     _sourceKind = "database-fallback-alpha";
    }
   }
   else
   {
    _sourceTierImages = CanonicalFallbackTierImages;
    _tierImages = CanonicalTransparentTierImages;
    _sourceBadge = "DATABASE EMPTY · TRANSPARENT FALLBACK";
    _sourceKind = "database-fallback-alpha";
   }
  }
  catch
  {
   _sourceTierImages = CanonicalFallbackTierImages;
   _tierImages = CanonicalTransparentTierImages;
   _sourceBadge = "DATABASE UNAVAILABLE · TRANSPARENT FALLBACK";
   _sourceKind = "database-fallback-alpha";
  }
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!firstRender)return;
  _module = await JS.InvokeAsync<IJSObjectReference>("import", "./perceiver-player.js?v=20260924-sprite-editor-1");
  await _module.InvokeVoidAsync("attach", _root, new
  {
   tierImages = _tierImages,
   fallbackTierImages = _sourceTierImages,
   stepDurationMs = 2000,
   sceneTitle = "Endemar Three-Tier Parallax Proof",
   spectralBands = new[]
   {
    new { tier = 1, label = "VIOLET · FASTEST · SHORTEST" },
    new { tier = 2, label = "BLUE" },
    new { tier = 3, label = "CYAN" },
    new { tier = 4, label = "GREEN · STRUCTURAL MID" },
    new { tier = 5, label = "YELLOW" },
    new { tier = 6, label = "ORANGE" },
    new { tier = 7, label = "RED · SLOWEST · LONGEST" }
   }
  });
 }

 static bool IsCanonicalEndemarTierSet(IReadOnlyList<string> values)
 {
  if(values.Count != CanonicalTierFileNames.Length)return false;
  for(var i=0;i<CanonicalTierFileNames.Length;i++)
  {
   if(!values[i].Contains(CanonicalTierFileNames[i], StringComparison.OrdinalIgnoreCase))
    return false;
  }
  return true;
 }

 async Task GoHomeAsync()
 {
  if(OnHome.HasDelegate)await OnHome.InvokeAsync();
 }

 async Task OpenStartMenuAsync()
 {
  if(OnStartMenu.HasDelegate)await OnStartMenu.InvokeAsync();
 }

 async Task PlayAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("play", _root);
 }

 async Task PauseAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("pause", _root);
 }

 async Task RestartAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("restart", _root);
 }

 async Task PreviousAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("previous", _root);
 }

 async Task NextAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("next", _root);
 }

 async Task ZoomInAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("zoomIn", _root);
 }

 async Task ZoomOutAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("zoomOut", _root);
 }

 async Task FitAsync()
 {
  if(_module is not null)await _module.InvokeVoidAsync("fit", _root);
 }

 async Task SetSpeedAsync(ChangeEventArgs e)
 {
  if(_module is null)return;
  var raw = Convert.ToString(e.Value, CultureInfo.InvariantCulture);
  if(double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var speed))
   await _module.InvokeVoidAsync("setSpeed", _root, speed);
 }

 public async ValueTask DisposeAsync()
 {
  if(_module is not null)
  {
   try{await _module.InvokeVoidAsync("detach", _root);}catch{}
   await _module.DisposeAsync();
  }
 }
}
