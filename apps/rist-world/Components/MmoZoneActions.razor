@inject WorldSession Session
<div class="mmo-zone-actions" hidden aria-hidden="true" data-world-mode="@Session.OperatingMode" data-world-role="@Session.Role">
 <button type="button" class="mmo-mode-sandbox-action" @onclick="Session.SetSandboxModeAsync" tabindex="-1">Sandbox mode</button>
 <button type="button" class="mmo-mode-shaelvien-action" @onclick="Session.SetMmoModeAsync" tabindex="-1">MMO mode</button>
 <button type="button" class="mmo-role-gm-action" @onclick="SetGm" tabindex="-1">GameMaster role</button>
 <button type="button" class="mmo-role-player-action" @onclick="SetPlayer" tabindex="-1">Roleplayer role</button>
 <button type="button" class="mmo-personal-zone-action" @onclick="Session.BeginPersonalZone" tabindex="-1">Personal zone</button>
 <button type="button" class="mmo-shaelvien-zone-action" @onclick="Session.ClaimShaelvienZone" tabindex="-1">Shaelvien zone</button>
 <button type="button" class="mmo-pin-delete-action" @onclick="Session.RemoveSelectedPin" tabindex="-1">Delete selected pin</button>
 <button type="button" class="mmo-new-campaign-action" @onclick="Session.BeginNewCampaign" tabindex="-1">New campaign</button>
 <button type="button" class="mmo-load-campaign-action" @onclick="Session.LoadAsync" tabindex="-1">Load local campaign</button>
 <button type="button" class="mmo-save-local-campaign-action" @onclick="Session.SaveAsync" tabindex="-1">Save local campaign</button>
 <button type="button" class="mmo-load-hosted-campaign-action" @onclick="Session.LoadPrivateCheckpointAsync" tabindex="-1">Load hosted campaign</button>
 <button type="button" class="mmo-save-hosted-campaign-action" @onclick="Session.SaveRistAsync" tabindex="-1">Save hosted campaign</button>
</div>

@code{
 void SetGm()=>Session.SetRole("GM");
 void SetPlayer()=>Session.SetRole("PC");
}
