<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <Target Name="PrepareUnifiedRistCss" BeforeTargets="PrepareForBuild">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/prepare_css.py&quot;" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/apply_prototype_shell.py&quot;" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/apply_map_viewer_shell.py&quot;" />
  </Target>
  <Target Name="ValidateShaelvienSemanticBrowserRuntime" BeforeTargets="Publish" Condition="'$(CI)' == 'true'">
    <Exec Command="node --check &quot;$(MSBuildProjectDirectory)/wwwroot/shaelvien-semantic-runtime.js&quot;" />
    <Exec Command="node --check &quot;$(MSBuildProjectDirectory)/wwwroot/shaelvien-wire.js&quot;" />
    <Exec Command="node --check &quot;$(MSBuildProjectDirectory)/wwwroot/shaelvien-perception-runtime.js&quot;" />
    <Exec Command="node --check &quot;$(MSBuildProjectDirectory)/wwwroot/shaelvien-input-runtime.js&quot;" />
    <Exec Command="node --check &quot;$(MSBuildProjectDirectory)/wwwroot/shaelvien-worldbuilder-perception-bridge.js&quot;" />
  </Target>
</Project>
