# Shaelvien Lite local defaults. Copy to your environment, not to a committed secret file.
SHAELVIEN_LITE_ENV=development
SHAELVIEN_ENV=development
SHAELVIEN_LITE_HOST=127.0.0.1
SHAELVIEN_LITE_PORT=8790
SHAELVIEN_LITE_STATE=data/shaelvien_lite_state.json
SHAELVIEN_STORAGE_BACKEND=json
SHAELVIEN_LITE_EXTERNAL_SCHEME=http
SHAELVIEN_LITE_EXTERNAL_HOST=localhost:8790
SHAELVIEN_LITE_TRUST_PROXY_HEADERS=0
SHAELVIEN_LITE_SECURE_COOKIES=0
SHAELVIEN_LITE_MAX_REQUEST_BYTES=128000
SHAELVIEN_LITE_REQUEST_TIMEOUT_SECONDS=30
SHAELVIEN_LITE_STORAGE_BACKEND=json
SHAELVIEN_STORAGE_CONNECT_TIMEOUT_SECONDS=5
SHAELVIEN_STORAGE_RETRY_ATTEMPTS=2
SHAELVIEN_LITE_STAGING_ALLOW_JSON=0
SHAELVIEN_LITE_BACKUP_PATH=backups/staging
SHAELVIEN_LITE_OWNER_BOOTSTRAP_TOKEN=replace-with-owner-approved-secret
SHAELVIEN_OWNER_BOOTSTRAP_TOKEN=replace-with-owner-approved-secret
SHAELVIEN_INVITE_REQUIRED=0
SHAELVIEN_INVITE_CODE=replace-with-private-playtest-code
SHAELVIEN_SESSION_SECRET=replace-with-generated-session-secret
SHAELVIEN_CSRF_SECRET=replace-with-generated-csrf-secret
SHAELVIEN_DEPLOYMENT_VERSION=local
SHAELVIEN_RUN_MIGRATIONS_ON_STARTUP=0
SHAELVIEN_MAX_STAGING_ACCOUNTS=25
SHAELVIEN_MAX_CAMPAIGNS_PER_ACCOUNT=2
SHAELVIEN_MAX_CHARACTERS_PER_ACCOUNT=4
SHAELVIEN_MAX_RETAINED_COMBAT_LOGS=500
SHAELVIEN_MAX_RETAINED_AI_RECORDS=200
DATABASE_URL=postgresql://example.invalid/shaelvien_lite_staging?sslmode=require
SHAELVIEN_LITE_VERBOSE_HTTP=0
