# Code-index governance: stale backups belong in Git history / backup branches,
# never beside authoritative source in the active tree.
*.old
*.old/**
*.bak
*.orig
*.rej
.venv/
.venv.*/
venv/

# Local scratch output from the code indexer; canonical index artifacts remain tracked.
.code-index/tmp/
