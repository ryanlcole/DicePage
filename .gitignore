# Code-index governance: stale backups belong in Git history / backup branches,
# never beside authoritative source in the active tree.
*.old
*.old/**
*.bak
*.orig
*.rej
.venv/
.venv.*/
venv/

# Code-index runtime/query artifacts are deterministic rebuild products. Durable
# identity registries, compact summaries, relationship views, semantic contracts,
# and governance ledgers remain tracked separately.
.code-index/code_index.jsonl
.code-index/code_index.tsv
.code-index/duplicates.json
.code-index/stale_candidates.json
.code-index/code_graph.sqlite3
.code-index/code_graph.sqlite3-*
.code-index/tmp/
